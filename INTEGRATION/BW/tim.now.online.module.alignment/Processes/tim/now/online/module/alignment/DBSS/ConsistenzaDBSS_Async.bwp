  &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;>&#xa;                                    &lt;interno>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Interno&quot;/>&#xa;                                    &lt;/interno>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/dettaglioasset&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;nomeComponente=('ACCESSOSLU', 'ACCESSOULL')&quot;>&#xa;                                            &lt;dettaglioasset>&#xa;                                                &lt;IDAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                &lt;/IDAsset>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                                    &lt;IDDettaglioAssetParent>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetParent>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                                    &lt;IDDettaglioAssetRoot>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetRoot>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;integrationID>&#xa;                                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                                &lt;/integrationID>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                                &lt;/IDRisorsa>&#xa;                                                &lt;nomeComponente>&#xa;                                                    &lt;xsl:value-of select=&quot;$AttributoOfferta/tns2:NOME_COMPONENTE&quot;/>&#xa;                                                &lt;/nomeComponente>&#xa;                                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;nomeAttributo='DESTINAZIONEUSO'&quot;>&#xa;                                                            &lt;attributidettaglioasset>&#xa;                                                                &lt;IDAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                                &lt;/IDAsset>&#xa;                                                                &lt;created>&#xa;                                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                                &lt;/created>&#xa;                                                                &lt;lastUpdate>&#xa;                                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                                &lt;/lastUpdate>&#xa;                                                                &lt;operatore>&#xa;                                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                                &lt;/operatore>&#xa;                                                                &lt;nomeAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                                &lt;/nomeAttributo>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)>0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)=0&quot;>&#xa;                                                                        &lt;valoreAttributo>&#xa;                                                                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso&quot;/>&#xa;                                                                        &lt;/valoreAttributo>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)=0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0&amp;#xD;&amp;#xA;&quot;>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati='4'and $AttributoOfferta/tns2:NOME_OFFERTA='SLULINEANONATTIVA' &quot;>&#xa;                                                                                &lt;valoreAttributo>&#xa;                                                                                    &lt;xsl:value-of select=&quot;'10'&quot;/>&#xa;                                                                                &lt;/valoreAttributo>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;valoreAttributo>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati&quot;/>&#xa;                                                                                &lt;/valoreAttributo>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;xsl:choose>&#xa;                                                                            &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)>0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0 and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati='4'and $AttributoOfferta/tns2:NOME_OFFERTA='SLULINEANONATTIVA' &amp;#xD;&amp;#xA;&quot;>&#xa;                                                                                &lt;valoreAttributo>&#xa;                                                                                    &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso,'|','10')&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                                &lt;/valoreAttributo>&#xa;                                                                            &lt;/xsl:when>&#xa;                                                                            &lt;xsl:otherwise>&#xa;                                                                                &lt;valoreAttributo>&#xa;                                                                                    &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso,'|',$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                                &lt;/valoreAttributo>&#xa;                                                                            &lt;/xsl:otherwise>&#xa;                                                                        &lt;/xsl:choose>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                                &lt;tipologiaDato>&#xa;                                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                                &lt;/tipologiaDato>&#xa;                                                                &lt;IDDettaglioAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                                &lt;/IDDettaglioAsset>&#xa;                                                            &lt;/attributidettaglioasset>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;nomeAttributo='NUMERONATIVOOLO' and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&#xa;                                                            &lt;attributidettaglioasset>&#xa;                                                                &lt;IDAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                                &lt;/IDAsset>&#xa;                                                                &lt;created>&#xa;                                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                                &lt;/created>&#xa;                                                                &lt;lastUpdate>&#xa;                                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                                &lt;/lastUpdate>&#xa;                                                                &lt;operatore>&#xa;                                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                                &lt;/operatore>&#xa;                                                                &lt;nomeAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                                &lt;/nomeAttributo>&#xa;                                                                &lt;valoreAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&#xa;                                                                &lt;/valoreAttributo>&#xa;                                                                &lt;tipologiaDato>&#xa;                                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                                &lt;/tipologiaDato>&#xa;                                                                &lt;IDDettaglioAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                                &lt;/IDDettaglioAsset>&#xa;                                                            &lt;/attributidettaglioasset>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;attributidettaglioasset>&#xa;                                                                &lt;IDAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                                &lt;/IDAsset>&#xa;                                                                &lt;created>&#xa;                                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                                &lt;/created>&#xa;                                                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                                                    &lt;lastUpdate>&#xa;                                                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                                    &lt;/lastUpdate>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;operatore>&#xa;                                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                                &lt;/operatore>&#xa;                                                                &lt;nomeAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                                &lt;/nomeAttributo>&#xa;                                                                &lt;valoreAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                                &lt;/valoreAttributo>&#xa;                                                                &lt;tipologiaDato>&#xa;                                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                                &lt;/tipologiaDato>&#xa;                                                                &lt;IDDettaglioAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                                &lt;/IDDettaglioAsset>&#xa;                                                            &lt;/attributidettaglioasset>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:for-each>&#xa;                                                &lt;xsl:if test=&quot;count(attributidettaglioasset[nomeAttributo='NUMERONATIVOOLO'])=0 and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&#xa;                                                    &lt;attributidettaglioasset>&#xa;                                                        &lt;IDAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;../IDAsset&quot;/>&#xa;                                                        &lt;/IDAsset>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;nomeAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;'NUMERONATIVOOLO'&quot;/>&#xa;                                                        &lt;/nomeAttributo>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                        &lt;tipologiaDato>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                                        &lt;/tipologiaDato>&#xa;                                                        &lt;IDDettaglioAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDDettaglioAsset>&#xa;                                                    &lt;/attributidettaglioasset>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$AttributoOfferta/tns2:NOME_OFFERTA=('ULLLINEANONATTIVA','SLULINEANONATTIVA') and count(attributidettaglioasset[nomeAttributo='DESTINAZIONEUSO']) = 0&quot;>&#xa;                                                    &lt;attributidettaglioasset>&#xa;                                                        &lt;IDAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;../IDAsset&quot;/>&#xa;                                                        &lt;/IDAsset>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;nomeAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;'DESTINAZIONEUSO'&quot;/>&#xa;                                                        &lt;/nomeAttributo>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)>0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)=0&quot;>&#xa;                                                                &lt;valoreAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                &lt;/valoreAttributo>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)=0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0&amp;#xD;&amp;#xA;&quot;>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot; $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati='4'and $AttributoOfferta/tns2:NOME_OFFERTA='SLULINEANONATTIVA' &amp;#xD;&amp;#xA;&quot;>&#xa;                                                                        &lt;valoreAttributo>&#xa;                                                                            &lt;xsl:value-of select=&quot;'10'&quot;/>&#xa;                                                                        &lt;/valoreAttributo>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;valoreAttributo>&#xa;                                                                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                        &lt;/valoreAttributo>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:choose>&#xa;                                                                    &lt;xsl:when test=&quot;string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso)>0 and string-length($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)>0 and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati='4'and $AttributoOfferta/tns2:NOME_OFFERTA='SLULINEANONATTIVA' &amp;#xD;&amp;#xA;&quot;>&#xa;                                                                        &lt;valoreAttributo>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso, '|', '10')&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                        &lt;/valoreAttributo>&#xa;                                                                    &lt;/xsl:when>&#xa;                                                                    &lt;xsl:otherwise>&#xa;                                                                        &lt;valoreAttributo>&#xa;                                                                            &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso, '|', $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Destinazione_Uso_Dati)&amp;#xD;&amp;#xA;&quot;/>&#xa;                                                                        &lt;/valoreAttributo>&#xa;                                                                    &lt;/xsl:otherwise>&#xa;                                                                &lt;/xsl:choose>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                        &lt;tipologiaDato>&#xa;                                                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                                        &lt;/tipologiaDato>&#xa;                                                        &lt;IDDettaglioAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDDettaglioAsset>&#xa;                                                    &lt;/attributidettaglioasset>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;IDRisorsaNOW>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                                &lt;/IDRisorsaNOW>&#xa;                                                &lt;IDDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                &lt;/IDDettaglioAsset>&#xa;                                                &lt;statoDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                                &lt;/statoDettaglioAsset>&#xa;                                                &lt;progressivo>&#xa;                                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                                &lt;/progressivo>&#xa;                                            &lt;/dettaglioasset>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;nomeComponente = 'ACCESSOVULAFTTH'&quot;>&#xa;                                            &lt;dettaglioasset>&#xa;                                                &lt;IDAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                &lt;/IDAsset>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                                    &lt;IDDettaglioAssetParent>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetParent>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                                    &lt;IDDettaglioAssetRoot>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetRoot>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;integrationID>&#xa;                                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                                &lt;/integrationID>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                                &lt;/IDRisorsa>&#xa;                                                &lt;nomeComponente>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                                &lt;/nomeComponente>&#xa;                                                &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;nomeAttributo='NUMERONATIVOOLO' and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&#xa;                                                            &lt;attributidettaglioasset>&#xa;                                                                &lt;IDAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                                &lt;/IDAsset>&#xa;                                                                &lt;created>&#xa;                                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                                &lt;/created>&#xa;                                                                &lt;lastUpdate>&#xa;                                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                                &lt;/lastUpdate>&#xa;                                                                &lt;operatore>&#xa;                                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                                &lt;/operatore>&#xa;                                                                &lt;nomeAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                                &lt;/nomeAttributo>&#xa;                                                                &lt;valoreAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&#xa;                                                                &lt;/valoreAttributo>&#xa;                                                                &lt;tipologiaDato>&#xa;                                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                                &lt;/tipologiaDato>&#xa;                                                                &lt;IDDettaglioAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                                &lt;/IDDettaglioAsset>&#xa;                                                            &lt;/attributidettaglioasset>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;attributidettaglioasset>&#xa;                                                                &lt;IDAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                                &lt;/IDAsset>&#xa;                                                                &lt;created>&#xa;                                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                                &lt;/created>&#xa;                                                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                                                    &lt;lastUpdate>&#xa;                                                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                                    &lt;/lastUpdate>&#xa;                                                                &lt;/xsl:if>&#xa;                                                                &lt;operatore>&#xa;                                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                                &lt;/operatore>&#xa;                                                                &lt;nomeAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                                                &lt;/nomeAttributo>&#xa;                                                                &lt;valoreAttributo>&#xa;                                                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                                                &lt;/valoreAttributo>&#xa;                                                                &lt;tipologiaDato>&#xa;                                                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                                                &lt;/tipologiaDato>&#xa;                                                                &lt;IDDettaglioAsset>&#xa;                                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                                &lt;/IDDettaglioAsset>&#xa;                                                            &lt;/attributidettaglioasset>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:for-each>&#xa;                                                &lt;xsl:if test=&quot;count(attributidettaglioasset[nomeAttributo='NUMERONATIVOOLO'])=0 and $JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_nativo_olo='Y'&quot;>&#xa;                                                    &lt;attributidettaglioasset>&#xa;                                                        &lt;IDAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;../IDAsset&quot;/>&#xa;                                                        &lt;/IDAsset>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;nomeAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;'NUMERONATIVOOLO'&quot;/>&#xa;                                                        &lt;/nomeAttributo>&#xa;                                                        &lt;valoreAttributo>&#xa;                                                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Numero_Telefonico&quot;/>&#xa;                                                        &lt;/valoreAttributo>&#xa;                                                        &lt;tipologiaDato>&#xa;                                                            &lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&#xa;                                                        &lt;/tipologiaDato>&#xa;                                                        &lt;IDDettaglioAsset>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDDettaglioAsset>&#xa;                                                    &lt;/attributidettaglioasset>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;IDRisorsaNOW>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                                &lt;/IDRisorsaNOW>&#xa;                                                &lt;IDDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                &lt;/IDDettaglioAsset>&#xa;                                                &lt;statoDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                                &lt;/statoDettaglioAsset>&#xa;                                                &lt;progressivo>&#xa;                                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                                &lt;/progressivo>&#xa;                                            &lt;/dettaglioasset>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;dettaglioasset>&#xa;                                                &lt;IDAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                                &lt;/IDAsset>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                                    &lt;IDDettaglioAssetParent>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetParent>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                                    &lt;IDDettaglioAssetRoot>&#xa;                                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                                    &lt;/IDDettaglioAssetRoot>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;integrationID>&#xa;                                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                                &lt;/integrationID>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                                    &lt;lastUpdate>&#xa;                                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                                    &lt;/lastUpdate>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;operatore>&#xa;                                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                                &lt;/operatore>&#xa;                                                &lt;IDRisorsa>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                                &lt;/IDRisorsa>&#xa;                                                &lt;nomeComponente>&#xa;                                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                                &lt;/nomeComponente>&#xa;                                                &lt;xsl:copy-of select=&quot;attributidettaglioasset&quot;/>&#xa;                                                &lt;IDRisorsaNOW>&#xa;                                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                                &lt;/IDRisorsaNOW>&#xa;                                                &lt;IDDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                                &lt;/IDDettaglioAsset>&#xa;                                                &lt;statoDettaglioAsset>&#xa;                                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                                &lt;/statoDettaglioAsset>&#xa;                                                &lt;progressivo>&#xa;                                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                                &lt;/progressivo>&#xa;                                            &lt;/dettaglioasset>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/DESPrimoOrdine&quot;>&#xa;                                    &lt;DESPrimoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                                    &lt;/DESPrimoOrdine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/CAP&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/CAP&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceISTATComune>&#xa;                                    &lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia,$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Comune)&quot;/>&#xa;                                &lt;/codiceISTATComune>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;>&#xa;                                    &lt;codiceISTATProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;/>&#xa;                                    &lt;/codiceISTATProvincia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($CodiceToponomastica)>0&quot;>&#xa;                                        &lt;codiceToponomastica>&#xa;                                            &lt;xsl:value-of select=&quot;$CodiceToponomastica&quot;/>&#xa;                                        &lt;/codiceToponomastica>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/codiceToponomastica&quot;>&#xa;                                            &lt;codiceToponomastica>&#xa;                                                &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/codiceToponomastica&quot;/>&#xa;                                            &lt;/codiceToponomastica>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/comune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/comune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;>&#xa;                                    &lt;descrPartToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;/>&#xa;                                    &lt;/descrPartToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;>&#xa;                                    &lt;descrizioneVia>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Indirizzo&quot;/>&#xa;                                    &lt;/descrizioneVia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;>&#xa;                                    &lt;numeroCivico>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Civico&quot;/>&#xa;                                    &lt;/numeroCivico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/provincia&quot;>&#xa;                                    &lt;provincia>&#xa;                                        &lt;xsl:value-of select=&quot;$FindID.part1/tns:Find[tns:Asset/statoAsset='ATTIVO' and tns:Asset/codificaOLOAGCOM='TLC'][1]/tns:Asset/provincia&quot;/>&#xa;                                    &lt;/provincia>&#xa;                                &lt;/xsl:if>&#xa;                           