ressivo>&lt;/dettaglioasset>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/DESPrimoOrdine&quot;>&lt;DESPrimoOrdine>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/DESPrimoOrdine&quot;/>&lt;/DESPrimoOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/CAP&quot;>&lt;CAP>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/CAP&quot;/>&lt;/CAP>&lt;/xsl:if>&lt;codiceISTATComune>&lt;xsl:value-of select=&quot;concat($JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia,$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Comune)&quot;/>&lt;/codiceISTATComune>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;>&lt;codiceISTATProvincia>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Codice_Provincia&quot;/>&lt;/codiceISTATProvincia>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CodiceToponomastica)>0&quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;$CodiceToponomastica&quot;/>&lt;/codiceToponomastica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica&quot;>&lt;codiceToponomastica>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica&quot;/>&lt;/codiceToponomastica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/comune&quot;>&lt;comune>&lt;xsl:value-of select=&quot;$FindID/part1/tns:Output/tns:Find/tns:Asset/comune&quot;/>&lt;/comune>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;>&lt;descrPartToponomastica>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns3:Input/tns3:SEDE/tns3:Particella_Toponomastica&quot;/>&lt;/descrPartToponomastica>&lt;/xsl:if>&lt;xsl:if test=&