select=&quot;concat('***Asset non aggionato - Data_dec   ',  string($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Data_dec), '  &amp;lt; = DES  ', string($FindID/part1/tns2:Output/tns2:Find[1]/tns2:Asset/DES))&quot;/>&lt;/ns:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;xsl:choose>&lt;xsl:when test=&quot;(upper-case($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:Stato_Asset)='ATTIVO' and starts-with($JMSReceiveMessage/Body/tns3:Input/tns3:ACCESSO/tns3:ID_Risorsa,'U6')) or (count($FindID/part1/tns2:Output/tns2:Find)>1 and not(exists($FindID/part1/tns2:Output/tns2:Find[tns2:Asset/codificaOLOAGCOM!='TLC'])))&quot;>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;6&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;5&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($JMSReceiveMessage/Body/tns3:Input/tns3:ID_ESEC_PROCSO_NO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:RETURN_CODE>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:RETURN_CODE>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
