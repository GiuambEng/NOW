                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/CheckJMSBodyDBSS&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/UpdateAsset/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindIDRisorsa_Old_VULA_WXX.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetMultipli2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Data_Dec>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns2:Input/tns2:ACCESSO/tns2:Data_dec&quot;/>&#xa;            &lt;/tns:Data_Dec>&#xa;            &lt;tns:Ora_Dec>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns2:Input/tns2:ACCESSO/tns2:Ora_dec&quot;/>&#xa;            &lt;/tns:Ora_Dec>&#xa;            &lt;tns:SistemaCompetenza>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/tns2:Input/tns2:Sistema_Competenza&quot;/>&#xa;            &lt;/tns:SistemaCompetenza>&#xa;            &lt;xsl:for-each select=&quot;$FindIDRisorsa_Old_VULA_WXX.part1/tns1:Find[tns1:Asset/codificaOLOAGCOM='TLC' and tns1:Asset/statoAsset='ATTIVO']&quot;>&#xa;                &lt;tns:Find>&#xa;                    &lt;xsl:if test=&quot;tns1:CaseReference&quot;>&#xa;                        &lt;tns:CaseReference>&#xa;                            &lt;xsl:value-of select=&quot;tns1:CaseReference&quot;/>&#xa;                        &lt;/tns:CaseReference>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;tns1:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Asset/IDAsset&quot;/>&#xa;                  