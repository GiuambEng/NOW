                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToEsitoData_asset"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="EsitoData_assetToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_OL/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Map_FindCase&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:NOW_HAL_OL_Response>&lt;tns:Esito>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;tns:TIMESTAMP>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[YYYY] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:TIMESTAMP>&lt;/tns:Esito>&lt;tns:Asset>&lt;xsl:if test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/IDRisorsa&quot;>&lt;tns:Linea_Riferimento>&lt;xsl:value-of select=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/IDRisorsa&quot;/>&lt;/tns:Linea_Riferimento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/dettaglioasset[attributidettaglioasset/nomeAttributo='TIPOLINEA']/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo=&amp;#xD;&amp;#xA;('ISDN','LineaNonFonia') and $Map_FindCase/tns1:Find[number($index)]/tns1:Asset/offerta=('EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE', 'BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMSIMMETRICOHL', 'BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMGBESIMMETRICOFLAT',  'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH', 'VULAFTTCAB', 'VULAFTTH', 'SHASENZAMANODOPERA','SHACONMANODOPERA','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH')&quot;>&lt;xsl:if test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/numeroFittizio&quot;>&lt;tns:Numerazione_Fittizia>&lt;xsl:value-of select=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/numeroFittizio&quot;/>&lt;/tns:Numerazione_Fittizia>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/statoAsset&quot;>&lt;tns:STATO_ASSET>&lt;xsl:value-of select=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/statoAsset&quot;/>&lt;/tns:STATO_ASSET>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/offerta=('ULLLINEAATTIVA','ULLLINEAATTIVANP','ULLLINEANONATTIVA','NP','VULL','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP','ULLDATILINEANONATTIVA','WLRLINEANONATTIVA','SLULINEAATTIVA','SLULINEAATTIVANP','SLULINEANONATTIVA','WLRLINEAATTIVA')&quot;>&lt;tns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;F&amp;quot;&quot;/>&lt;/tns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Map_FindCase/tns1:Find[number($index)]/tns1:Asset/offerta=('EASYIPBASEPLUSFLAT', 'EASYIPBASEPLUSLITE', 'EASYIPSPECIALPROFILEFLAT', 'EASYIPSPECIALPROFILELITE', 'BITSTREAMATMASIMMETRICOFLAT', 'BITSTREAMATMASIMMETRICOHL', 'BITSTREAMATMASIMMETRICOLITE', 'BITSTREAMATMSIMMETRICOFLAT', 'BITSTREAMATMSIMMETRICOHL', 'BITSTREAMGBEASIMMETRICOFLAT', 'BITSTREAMGBESIMMETRICOFLAT', 'BITSTREAMNGAFTTCAB', 'BITSTREAMNGAFTTH', 'VULAFTTCAB', 'VULAFTTH', 'SHACONMANODOPERA','SHASENZAMANODOPERA','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIBITSTREAMNGAFTTH','SEMIVULAFTTH','SEMIEASYIPNGAFTTH')&quot;>&lt;tns:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;D&amp;quot;&quot;/>&lt;/tns:TIPO_SERVIZIO>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:Asset>&lt;/tns:NOW_HAL_OL_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="RESPONSE_NP"
                                    name="Response_NP"
