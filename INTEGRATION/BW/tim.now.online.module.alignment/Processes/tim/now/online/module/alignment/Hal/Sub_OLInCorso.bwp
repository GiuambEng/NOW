                                    <bpws:link
                                    name="GroupStartToResponse_NP" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToEsitoData_asset" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToResponse_CPS" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Response_CPSToAccumulate" tibex:linkType="SUCCESS"/>
