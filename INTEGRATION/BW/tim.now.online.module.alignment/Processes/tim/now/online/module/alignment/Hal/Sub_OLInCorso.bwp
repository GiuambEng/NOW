            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EsitoLog-input"
                    name="EsitoLog"
                    tibex:xpdlId="ec9c7a39-c0e6-4add-8c9a-5132838f8464"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EsitoDataToEsitoLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToNOW_HAL_OLOut1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;EsitoLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_OlInCorso'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Response: ',tib:render-xml($Response))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5c895f21-0b65-417f-ac50-e28dd2b23c1e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_OL/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOW_HAL_OLIn&quot;/>&lt;xsl:template name=&quot;SELECT_NUMEROTELEFONICO_ATT_ORDINE-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRISORSA>&lt;xsl:value-of select=&quot;$NOW_HAL_OLIn/parameters/tns1:NOW_HAL_OL_Request/tns1:ID_RISORSA&quot;/>&lt;/IDRISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SELECT_NUMEROTELEFONICO_ATT_ORDINE-input"
                    name="SELECT_NUMEROTELEFONICO_ATT_ORDINE"
                    outputVariable="SELECT_NUMEROTELEFONICO_ATT_ORDINE"
                    tibex:xpdlId="5c895f21-0b65-417f-ac50-e28dd2b23c1e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OrdineToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToOrdineLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5c895f21-0b65-417f-ac50-e28dd2b23c1e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_HAL_OL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOW_HAL_OLIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SELECT_NUMEROTELEFONICO_ATT_ORDINE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$NOW_HAL_OLIn.parameters/tns1:ID_RISORSA&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="&#xa;SELECT ATTR.VALOREATTRIBUTO&#xa;FROM BDS_1_CASEDATA_ORDINE ORD&#xa;  JOIN BDS_1_CASEDATA_DETTAGLIOORDINE DETT ON DETT.ORDINE_DETTAGLIOORDINE_BDSID = ORD.BDS_ID&#xa;  JOIN BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTR ON DETT.BDS_ID = ATTR.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;  JOIN BDS_1_CASEDATA_RICHIESTA RICH ON RICH.IDRICHIESTAOLO = ORD.IDRICHIESTAOLO&#xa;WHERE ATTR.NOMEATTRIBUTO = 'NUMEROTELEFONICO'&#xa;AND RICH.idrisorsa = ?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="ForEach" tibex:group="foreach" tibex:xpdlId="09376ee7-349b-43d7-9d6d-0a13600b5452">
                <bpws:targets>
                    <bpws:target linkName="MapperToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToOrdine"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="foreach">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+abeac584-0721-4659-9f2b-6bc216285c2d" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="forEach"
                        parallel="no" tibex:group="foreach">
                        <tibex:DesignExpression name="final">
