O,'0'))&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;concat('0',$Ordine/Record[1]/DISTRETTO)&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Ordine/Record[1]/DISTRETTO&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Ordine/Record[1]/DISTRETTO&quot;/>&lt;/tns:Distretto>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Ordine/Record[1]/IDRICHIESTAOLO&quot;>&lt;tns:Numero_Ordine>&lt;xsl:value-of select=&quot;$Ordine/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:Numero_Ordine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Ordine/Record[1]/STATO_RICH_NOW_GUI&quot;>&lt;tns:Stato_Ordine>&lt;xsl:value-of select=&quot;$Ordine/Record[1]/STATO_RICH_NOW_GUI&quot;/>&lt;/tns:Stato_Ordine>&lt;/xsl:if>&lt;/tns:OL>&lt;/tns:NOW_HAL_OL_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
