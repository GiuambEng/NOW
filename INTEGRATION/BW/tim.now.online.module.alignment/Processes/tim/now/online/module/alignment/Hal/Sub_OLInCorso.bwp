                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Map_FindCase/tns:Find[number($index)]/tns:Asset/offerta='NP']]></bpws:transitionCondition>
                                    </bpws:source>
