                                expression="count($Map_FindCase/tns:Find)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Map_FindCase/tns:Find)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="EsitoData_assetToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
