                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CheckInsertCluster-input"
                                    name="CheckInsertCluster"
                                    outputVariable="CheckInsertCluster"
                                    tibex:xpdlId="7d4672f5-d1c2-431a-b43f-210ce5881096"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery2ToCheckInsertCluster"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckInsertClusterToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($CheckInsertCluster/ns48:Output_Olo[1]/ns48:COD_ISTAT_COMUNI)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($CheckInsertCluster/ns48:Output_Olo[1]/ns48:COD_ISTAT_COMUNI)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CheckInsertClusterToCheckCluster">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/triggerCluster/&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:param name=&quot;SelectPricing&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:template name=&quot;CheckInsertCluster-input&quot; match=&quot;/&quot;>&lt;tns3:Input>&lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&lt;tns3:ProcessID>&lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&lt;/tns3:ProcessID>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery2/Record[1]/NEXTVAL&quot;>&lt;tns3:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$JDBCQuery2/Record[1]/NEXTVAL&quot;/>&lt;/tns3:ID_TRANSAZIONE>&lt;/xsl:if>&lt;tns3:ID_ESEC_PROCSO_NOFILE>&lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&lt;/tns3:ID_ESEC_PROCSO_NOFILE>&lt;tns3:ID_RICH_JPUB>&lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&lt;/tns3:ID_RICH_JPUB>&lt;xsl:for-each select=&quot;$SelectPricing/Record&quot;>&lt;tns3:Cluster>&lt;tns3:COD_ISTAT_COMUNI>&lt;xsl:value-of select=&quot;CODICEISTATCOMUNE&quot;/>&lt;/tns3:COD_ISTAT_COMUNI>&lt;tns3:COD_CLUSTER>&lt;xsl:value-of select=&quot;CODICEPRICING&quot;/>&lt;/tns3:COD_CLUSTER>&lt;tns3:TIPOLOG_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;TIPOLOGIACLUSTERCOMUNE&quot;/>&lt;/tns3:TIPOLOG_CLUSTER_COMUNE>&lt;tns3:DATAINI_VALID_PRICING>&lt;xsl:value-of select=&quot;DATAINIZIOVALIDITAASSOCIAZIONE&quot;/>&lt;/tns3:DATAINI_VALID_PRICING>&lt;xsl:if test=&quot;DATAFINEVALIDITAASSOCIAZIONE&quot;>&lt;tns3:DATAFIN_VALID_PRICING>&lt;xsl:value-of select=&quot;DATAFINEVALIDITAASSOCIAZIONE&quot;/>&lt;/tns3:DATAFIN_VALID_PRICING>&lt;/xsl:if>&lt;tns3:DESCR_COMUNE>&lt;xsl:value-of select=&quot;DESCRIZIONECOMUNE&quot;/>&lt;/tns3:DESCR_COMUNE>&lt;xsl:if test=&quot;$Offerta/Record[1]/COD_OFFERTA_JPUB&quot;>&lt;tns3:TIPO_CONTR>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/COD_OFFERTA_JPUB&quot;/>&lt;/tns3:TIPO_CONTR>&lt;/xsl:if>&lt;tns3:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;DATAINIZIOMARCAGGIOPREGRESSO&quot;/>&lt;/tns3:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;tns3:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;DATAINIZIOVALIDITAASSOCIAZIONE&quot;/>&lt;/tns3:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:if test=&quot;DATAFINEVALIDITAASSOCIAZIONE&quot;>&lt;tns3:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;xsl:value-of select=&quot;DATAFINEVALIDITAASSOCIAZIONE&quot;/>&lt;/tns3:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;VERSIONING&quot;>&lt;tns3:VERSIONING>&lt;xsl:value-of select=&quot;VERSIONING&quot;/>&lt;/tns3:VERSIONING>&lt;/xsl:if>&lt;/tns3:Cluster>&lt;/xsl:for-each>&lt;/tns3:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.online.module.alignment.Jpub.CheckInsertCluster" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
