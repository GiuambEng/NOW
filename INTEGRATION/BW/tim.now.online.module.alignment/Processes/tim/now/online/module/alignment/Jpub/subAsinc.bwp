            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EndSubAsinc-input"
                    name="EndSubAsinc"
                    tibex:xpdlId="8691a666-6911-4508-8feb-372a8f673d9b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToCallProcess"/>
                        <bpws:target linkName="Empty2ToCallProcess"/>
                        <bpws:target linkName="CallProcess2ToEndSubAsinc"/>
                        <bpws:target linkName="WhileToEndSubAsinc"/>
                        <bpws:target linkName="CallProcess4ToEndSubAsinc"/>
                        <bpws:target linkName="Repeat2ToEndSubAsinc"/>
                        <bpws:target linkName="While1ToEndSubAsinc"/>
                        <bpws:target linkName="While2ToEndSubAsinc"/>
                        <bpws:target linkName="GenericLogger2ToEndSubAsinc"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;EndSubAsinc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'End subAsinc'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Control" tibex:xpdlId="8d36108a-4008-4e3e-97bc-3f650cb69023">
                <bpws:targets>
                    <bpws:target linkName="Ciclo_OLOToEmpty3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ControlToWhile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Accumulate/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Accumulate/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlToCallProcess2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcess2-input"
                    name="CallProcess2"
                    tibex:xpdlId="a7875661-d6c6-49dd-ab2b-d35e75def155"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlToCallProcess2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess2ToEndSubAsinc"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Nessun OLO trovato in OK'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="054fdc1f-80d1-4782-b83d-2b5fbad0a65b">
                <bpws:targets>
                    <bpws:target linkName="ControlToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEndSubAsinc"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Accumulate/ns8:REQUEST)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Accumulate/ns8:REQUEST)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="RepeatOnErrorToInsertStag_OLO" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RepeatOnErrorToAssign" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="CallProcessToRepeatOnError" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Request_OLOToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Request_OLOToAssign" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="Log_OLO_RequestToCall_Jpub_OLO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InsertStag_OLOToLog_OLO_Response" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToInsertStag_OLO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToLog_OLO_Request" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Log_OLO_ResponseToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="25a944e3-1488-423c-9262-79ec879a4e6c">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToLog_OLO_Request"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="334d0e39-2b70-4aa7-bab4-636bca206e26">
                                <bpws:targets>
                                    <bpws:target linkName="Log_OLO_ResponseToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:scope name="RepeatOnError"
                                tibex:group="repeatOnError" tibex:xpdlId="950303b8-7d6e-4517-b0ad-dc5152c88eda">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToRepeatOnError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RepeatOnErrorToInsertStag_OLO"/>
                                    <bpws:source
                                    linkName="RepeatOnErrorToAssign"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil2" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName">
                                    <bpws:if name="if">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1>=$MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1>=$MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
                                    <bpws:flow name="flow5">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart4ToCall_Jpub_OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Call_Jpub_OLOToGroupEnd2" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart4ToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="CallProcess1ToGroupEnd2" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart4"
                                    tibex:group="groupStart" tibex:xpdlId="ab34c6f4-8ab9-4e69-a36a-3dba66a5a58d">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart4ToCall_Jpub_OLO">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1=1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart4ToCallProcess1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:assign
                                    name="GroupEnd2"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="aa81bd89-d8b5-495a-af47-f6f59db736b3" validate="no">
                                    <bpws:targets>
                                    <bpws:target linkName="Call_Jpub_OLOToGroupEnd2"/>
                                    <bpws:target linkName="CallProcess1ToGroupEnd2"/>
                                    </bpws:targets>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:invoke
                                    inputVariable="Call_Jpub_OLO-input"
                                    name="Call_Jpub_OLO"
                                    operation="Operation"
                                    outputVariable="Call_Jpub_OLO"
                                    partnerLink="ProxyJpubOLO"
                                    portType="ns11:ProxyJpubOLO" tibex:xpdlId="8a9b96ca-8e3d-4878-b5da-fe1d2abf4491">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns3="http://www.tim.now.proxyJpubOLOConcrete" xmlns:ns1="www.tim.now.proxyJpub.schema" xmlns:tns2="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input" version="2.0"&gt;
    &lt;xsl:param name="Request_OLO"/&gt;
    &lt;xsl:template name="Call_Jpub_OLO-input" match="/"&gt;
        &lt;ns3:Request&gt;
            &lt;part1&gt;
                &lt;ns1:RequestGestoreProxy&gt;
                    &lt;ns1:ID_TRANSAZIONE&gt;
                        &lt;xsl:value-of select="$Request_OLO/ID_TRANSAZIONE"/&gt;
                    &lt;/ns1:ID_TRANSAZIONE&gt;
                    &lt;xsl:for-each select="$Request_OLO/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_GESTORI"&gt;
                        &lt;ns1:Gestore&gt;
                            &lt;ns1:TIPO_AZIONE&gt;
                                &lt;xsl:value-of select="TIPO_AZIONE"/&gt;
                            &lt;/ns1:TIPO_AZIONE&gt;
                            &lt;ns1:CODE_GEST&gt;
                                &lt;xsl:value-of select="CODE_GEST"/&gt;
                            &lt;/ns1:CODE_GEST&gt;
                            &lt;ns1:NOME_RAG_SOC_GEST&gt;
                                &lt;xsl:value-of select="NOME_RAG_SOC_GEST"/&gt;
                            &lt;/ns1:NOME_RAG_SOC_GEST&gt;
                            &lt;ns1:NOME_GEST_SIGLA&gt;
                                &lt;xsl:value-of select="NOME_GEST_SIGLA"/&gt;
                            &lt;/ns1:NOME_GEST_SIGLA&gt;
                            &lt;ns1:CODE_PARTITA_IVA&gt;
                                &lt;xsl:value-of select="CODE_PARTITA_IVA"/&gt;
                            &lt;/ns1:CODE_PARTITA_IVA&gt;
                            &lt;ns1:CODE_GEST_TIRKS&gt;
                                &lt;xsl:value-of select="CODE_GEST_TIRKS"/&gt;
                            &lt;/ns1:CODE_GEST_TIRKS&gt;
                        &lt;/ns1:Gestore&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/ns1:RequestGestoreProxy&gt;
            &lt;/part1&gt;
        &lt;/ns3:Request&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.now.proxyJpubOLOConcrete&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Request_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_Jpub_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:RequestGestoreProxy>&#xa;            &lt;ns1:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Request_OLO/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ns1:ID_TRANSAZIONE>&#xa;            &lt;xsl:for-each select=&quot;$Request_OLO/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_GESTORI&quot;>&#xa;                &lt;ns1:Gestore>&#xa;                    &lt;ns1:TIPO_AZIONE>&#xa;                        &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                    &lt;/ns1:TIPO_AZIONE>&#xa;                    &lt;ns1:CODE_GEST>&#xa;                        &lt;xsl:value-of select=&quot;CODE_GEST&quot;/>&#xa;                    &lt;/ns1:CODE_GEST>&#xa;                    &lt;ns1:NOME_RAG_SOC_GEST>&#xa;                        &lt;xsl:value-of select=&quot;NOME_RAG_SOC_GEST&quot;/>&#xa;                    &lt;/ns1:NOME_RAG_SOC_GEST>&#xa;                    &lt;ns1:NOME_GEST_SIGLA>&#xa;                        &lt;xsl:value-of select=&quot;NOME_GEST_SIGLA&quot;/>&#xa;                    &lt;/ns1:NOME_GEST_SIGLA>&#xa;                    &lt;ns1:CODE_PARTITA_IVA>&#xa;                        &lt;xsl:value-of select=&quot;CODE_PARTITA_IVA&quot;/>&#xa;                    &lt;/ns1:CODE_PARTITA_IVA>&#xa;                    &lt;ns1:CODE_GEST_TIRKS>&#xa;                        &lt;xsl:value-of select=&quot;CODE_GEST_TIRKS&quot;/>&#xa;                    &lt;/ns1:CODE_GEST_TIRKS>&#xa;                &lt;/ns1: