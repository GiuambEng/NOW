                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Contratti-input"
                                    name="Contratti"
                                    outputVariable="Contratti"
                                    tibex:xpdlId="784b78d2-4db2-475b-8e9b-d9f10f27566d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToContratti"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns3=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interProcess.OnLine.input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Check_Contratto&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;Contratti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:REQUEST>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Check_Contratto/ns3:Output_Contratto)>0&quot;>&#xa;                    &lt;ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery1/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ID_TRANSAZIONE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ID_TRANSAZIONE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:ANAGRAFICHE>&#xa;                &lt;xsl:for-each select=&quot;$Check_Contratto/ns3:Output_Contratto&quot;>&#xa;                    &lt;tns2:CONTRATTI>&#xa;                        &lt;CODE_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns3:CODE_CONTR&quot;/>&#xa;                        &lt;/CODE_CONTR>&#xa;                        &lt;CODE_TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns3:CODE_TIPO_CONTR&quot;/>&#xa;                        &lt;/CODE_TIPO_CONTR>&#xa;                        &lt;CODE_GEST>&#xa;                            &lt;xsl:value-of select=&quot;ns3:CODE_GEST&quot;/>&#xa;                        &lt;/CODE_GEST>&#xa;                        &lt;DESC_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns3:DESC_CONTR&quot;/>&#xa;                        &lt;/DESC_CONTR>&#xa;                        &lt;DATA_SCAD_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns3:DATA_SCAD_CONTR&quot;/>&#xa;                        &lt;/DATA_SCAD_CONTR>&#xa;                        &lt;DATA_STIP_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime(ns3:DATA_STIP_CONTR)&quot;/>&#xa;                        &lt;/DATA_STIP_CONTR>&#xa;                        &lt;DATA_INIZIO_VALID>&#xa;                            &lt;xsl:value-of select=&quot;xsd:dateTime(ns3:DATA_INIZIO_VALID)&quot;/>&#xa;                        &lt;/DATA_INIZIO_VALID>&#xa;                        &lt;DATA_FINE_VALID>&#xa;                            &lt;xsl:value-of select=&quot;ns3:DATA_FINE_VALID&quot;/>&#xa;                        &lt;/DATA_FINE_VALID>&#xa;                        &lt;xsl:if test=&quot;ns3:DATA_COINV&quot;>&#xa;                            &lt;DATA_COINV>&#xa;                                &lt;xsl:value-of select=&quot;ns3:DATA_COINV&quot;/>&#xa;                            &lt;/DATA_COINV>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:CONTRATTI>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns2:ANAGRAFICHE>&#xa;        &lt;/tns2:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AggiornamentoMassiveAnagrafiche_Input="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="AggiornamentoMassiveAnagrafiche_Input:REQUEST" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ExitCicloContratto"
                                    name="CheckContratto"
                                    outputVariable="ExitCicloContratto"
                                    tibex:xpdlId="21db1eae-fba7-4d8f-99d5-788a26c86ee8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
