                                    name="SelectPricing"
                                    outputVariable="SelectPricing"
                                    tibex:xpdlId="f6a4ee8e-9a2a-4a69-ae9c-83613d0e4ff2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart6ToCountPricing"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CountPricingToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f6a4ee8e-9a2a-4a69-ae9c-83613d0e4ff2+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;CountPricing1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;subsetSize>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/subsetSize>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    processInSubsets="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AC.IDENTIFICATIVOCLUSTERCOMUNE, AC.CODICEISTATCOMUNE, AC.TIPOLOGIACLUSTERCOMUNE,&#xa;  AC.DESCRIZIONECOMUNE, AC.IDENTIFICATIVOOFFERTA, AC.DATAINIZIOLIBERALIZZAZIONE,&#xa;  AC.DATAFINELIBERALIZZAZIONE, AC.DATAINIZIOMARCAGGIOPREGRESSO,&#xa;  ASS.DATAINIZIOVALIDITAASSOCIAZIONE, ASS.DATAFINEVALIDITAASSOCIAZIONE,&#xa;  AP.IDENTIFICATIVOPRICINGCOMUNE, AP.CODICEPRICING, AC.VERSIONING&#xa;  FROM APPUSER.ANAGRAFICA_CLUSTER_COMUNE AC,&#xa;       APPUSER.ANAGRAFICA_PRICING_COMUNE AP,&#xa;       APPUSER.ASSOCIA_PRICING_CLUSTE_COMUNE ASS&#xa;  WHERE ASS.IDENTIFICATIVOCLUSTERCOMUNE = AC.IDENTIFICATIVOCLUSTERCOMUNE&#xa;    AND ASS.IDENTIFICATIVOPRICINGCOMUNE = AP.IDENTIFICATIVOPRICINGCOMUNE&#xa;    AND AC.DATAFINELIBERALIZZAZIONE > SYSDATE&#xa;    AND ASS.DATAINIZIOVALIDITAASSOCIAZIONE >= AC.DATAINIZIOLIBERALIZZAZIONE&#xa;    AND ASS.DATAFINEVALIDITAASSOCIAZIONE &lt;= AC.DATAFINELIBERALIZZAZIONE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="IDENTIFICATIVOCLUSTERCOMUNE"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="CODICEISTATCOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="TIPOLOGIACLUSTERCOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="DESCRIZIONECOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="IDENTIFICATIVOOFFERTA"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="DATAINIZIOLIBERALIZZAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="DATAFINELIBERALIZZAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="8"
                                    columnName="DATAINIZIOMARCAGGIOPREGRESSO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="9"
                                    columnName="DATAINIZIOVALIDITAASSOCIAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="10"
                                    columnName="DATAFINEVALIDITAASSOCIAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnIndex="11"
                                    columnName="IDENTIFICATIVOPRICINGCOMUNE"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="12"
                                    columnName="CODICEPRICING"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="13"
                                    columnName="VERSIONING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
