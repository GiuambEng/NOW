                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ExitCicloCluster"
                                    name="CheckCluster"
                                    outputVariable="ExitCicloCluster"
                                    tibex:xpdlId="dc63c842-9a00-46e8-a561-93309a3ea88f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAssign2"/>
                                    <bpws:target linkName="CheckInsertClusterToCheckCluster"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckClusterToAssign2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.example.org/CheckCiclo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectPricing&quot;/>&#xa;    &lt;xsl:template name=&quot;ExitCicloCluster&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$SelectPricing/lastSubset=true()&quot;>&#xa;                &lt;ns3:CicloCluster>&#xa;                    &lt;ns3:ExitCicloCluster>&#xa;                        &lt;xsl:value-of select=&quot;'END'&quot;/>&#xa;                    &lt;/ns3:ExitCicloCluster>&#xa;                &lt;/ns3:CicloCluster>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns3:CicloCluster>&#xa;                    &lt;ns3:ExitCicloCluster>&#xa;                        &lt;xsl:value-of select=&quot;'CONTINUE'&quot;/>&#xa;                    &lt;/ns3:ExitCicloCluster>&#xa;                &lt;/ns3:CicloCluster>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
