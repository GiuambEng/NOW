                    outputVariable="CicloContratto"
                    tibex:xpdlId="364b01a1-6fe9-452e-9230-9e9699a8ad38" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CountContratto_2ToRepeat2"/>
