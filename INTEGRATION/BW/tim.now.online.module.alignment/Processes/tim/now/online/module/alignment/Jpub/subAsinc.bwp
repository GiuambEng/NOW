                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Offerta-input"
                                    name="Offerta"
                                    outputVariable="Offerta"
                                    tibex:xpdlId="eaa0c660-aba5-4056-a36d-01a590ce7309" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CounterPricingToJDBCQuery3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery3ToJDBCQuery2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+eaa0c660-aba5-4056-a36d-01a590ce7309+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectPricing&quot;/>&lt;xsl:template name=&quot;Offerta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_OFFERTA>&lt;xsl:value-of select=&quot;xsd:decimal($SelectPricing/Record[1]/IDENTIFICATIVOOFFERTA)&quot;/>&lt;/ID_OFFERTA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.COD_OFFERTA_JPUB&#xa;FROM OFFERTA O, TRASCODFC_OFFERTA TRO&#xa;WHERE O.ID_OFFERTA = TRO.ID_OFFERTA AND TRO.ID_OFFERTA = ? &#xa;AND TRO.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="COD_OFFERTA_JPUB"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="bb5d5abe-2460-4ee5-b517-c003fd845d05" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckInsertClusterToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAssign2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:param name=&quot;CheckInsertCluster&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:REQUEST>&lt;ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$JDBCQuery2/Record[1]/NEXTVAL&quot;/>&lt;/ID_TRANSAZIONE>&lt;tns2:ANAGRAFICHE>&lt;xsl:for-each select=&quot;$CheckInsertCluster/tns1:Output_Olo&quot;>&lt;tns2:ANAGRAFICA_CLUSTER_COMUNI>&lt;CODICE_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns1:COD_ISTAT_COMUNI&quot;/>&lt;/CODICE_ISTAT_COMUNE>&lt;xsl:if test=&quot;tns1:COD_CLUSTER&quot;>&lt;CODICE_CLUSTER>&lt;xsl:value-of select=&quot;tns1:COD_CLUSTER&quot;/>&lt;/CODICE_CLUSTER>&lt;/xsl:if>&lt;TIPOLOGIA_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;tns1:TIPOLOG_CLUSTER_COMUNE&quot;/>&lt;/TIPOLOGIA_CLUSTER_COMUNE>&lt;xsl:if test=&quot;tns1:DATAINI_VALID_PRICING&quot;>&lt;DATA_INIZIO_VALIDITA_PRICING>&lt;xsl:value-of select=&quot;tns1:DATAINI_VALID_PRICING&quot;/>&lt;/DATA_INIZIO_VALIDITA_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DATAFIN_VALID_PRICING&quot;>&lt;DATA_FINE_VALIDITA_PRICING>&lt;xsl:value-of select=&quot;tns1:DATAFIN_VALID_PRICING&quot;/>&lt;/DATA_FINE_VALIDITA_PRICING>&lt;/xsl:if>&lt;DESCRIZIONE_COMUNE>&lt;xsl:value-of select=&quot;tns1:DESCR_COMUNE&quot;/>&lt;/DESCRIZIONE_COMUNE>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;tns1:TIPO_CONTR&quot;/>&lt;/TIPO_CONTR>&lt;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;tns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;tns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:if test=&quot;tns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&lt;DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;xsl:value-of select=&quot;tns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&lt;/DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:VERSIONING&quot;>&lt;VERSIONING>&lt;xsl:value-of select=&quot;tns1:VERSIONING&quot;/>&lt;/VERSIONING>&lt;/xsl:if>&lt;/tns2:ANAGRAFICA_CLUSTER_COMUNI>&lt;/xsl:for-each>&lt;/tns2:ANAGRAFICHE>&lt;/tns2:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AggiornamentoMassiveAnagrafiche_Input="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
