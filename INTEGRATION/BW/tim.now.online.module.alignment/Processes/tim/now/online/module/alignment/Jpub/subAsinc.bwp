                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Request_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:REQUEST>&#xa;            &lt;ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Accumulate/tns2:REQUEST[number($index)]/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;tns2:ANAGRAFICHE>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate/tns2:REQUEST[number($index)]/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_GESTORI[1]&quot;>&#xa;                    &lt;tns2:ANAGRAFICA_GESTORI>&#xa;                        &lt;TIPO_AZIONE>&#xa;                            &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                        &lt;/TIPO_AZIONE>&#xa;                        &lt;CODE_GEST>&#xa;                            &lt;xsl:value-of select=&quot;CODE_GEST&quot;/>&#xa;                        &lt;/CODE_GEST>&#xa;                        &lt;NOME_RAG_SOC_GEST>&#xa;                            &lt;xsl:value-of select=&quot;NOME_RAG_SOC_GEST&quot;/>&#xa;                        &lt;/NOME_RAG_SOC_GEST>&#xa;                        &lt;NOME_GEST_SIGLA>&#xa;                            &lt;xsl:value-of select=&quot;NOME_GEST_SIGLA&quot;/>&#xa;                        &lt;/NOME_GEST_SIGLA>&#xa;                        &lt;CODE_PARTITA_IVA>&#xa;                            &lt;xsl:value-of select=&quot;CODE_PARTITA_IVA&quot;/>&#xa;                        &lt;/CODE_PARTITA_IVA>&#xa;                        &lt;CODE_GEST_TIRKS>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/CODE_GEST_TIRKS>&#xa;                    &lt;/tns2:ANAGRAFICA_GESTORI>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns2:ANAGRAFICHE>&#xa;        &lt;/tns2:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
