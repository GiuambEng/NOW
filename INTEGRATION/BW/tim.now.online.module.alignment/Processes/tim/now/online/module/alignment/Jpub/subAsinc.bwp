                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_OLO_Request-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'InvioAggiornamentoOLOInCorso'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+962ed587-cde4-4acb-9875-67a8454fc5ed+input&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Request_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;InAttesaNotificaEsitoAggiornamentoOLODaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;KORecord&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_Jpub_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Error&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate/tns2:REQUEST[number($index)]/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_GESTORI)>0&quot;>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Request_OLO)&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;'NessunOloValidoDaInviareJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ID_RICH_JPUB_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_OLO/part1/ns1:Response/ns1:result='OK'&quot;>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$InAttesaNotificaEsitoAggiornamentoOLODaJpub&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$KORecord&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_OLO/part1/ns1:Response/ns1:result='OK'&quot;>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;'InAttesaNotificaEsitoAggiornamentoOLODaJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;concat('RicevutoKOdaJpub',$Error)&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_RICH>&#xa;            &lt;ID_TIPOLG_MESSG>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/ID_TIPOLG_MESSG>&#xa;            &lt;ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Request_OLO/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;ANAG_FULL>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/ANAG_FULL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsertStag_OLO-input"
                                    name="InsertStag_OLO"
                                    outputVariable="InsertStag_OLO"
                                    tibex:xpdlId="962ed587-cde4-4acb-9875-67a8454fc5ed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RepeatOnErrorToInsertStag_OLO"/>
                                    <bpws:target linkName="AssignToInsertStag_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertStag_OLOToLog_OLO_Response"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+962ed587-cde4-4acb-9875-67a8454fc5ed+input&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_Jpub_OLO.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Request_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;InAttesaNotificaEsitoAggiornamentoOLODaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;KORecord&quot;/>&#xa;    &lt;xsl:param name=&quot;Error&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate/tns2:REQUEST[number($index)]/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_GESTORI)>0&quot;>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Request_OLO)&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;'NessunOloValidoDaInviareJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ID_RICH_JPUB_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_OLO.part1/ns1:result='OK'&quot;>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$InAttesaNotificaEsitoAggiornamentoOLODaJpub&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$KORecord&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_OLO.part1/ns1:result='OK'&quot;>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;'InAttesaNotificaEsitoAggiornamentoOLODaJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;concat('RicevutoKOdaJpub',$Error)&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_RICH>&#xa;            &lt;ID_TIPOLG_MESSG>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/ID_TIPOLG_MESSG>&#xa;            &lt;ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Request_OLO/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;ANAG_FULL>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/ANAG_FULL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_JPUB_OUT (CONTENUTO_REQUEST, ID_ESEC_PROCSO_NO_FILE,&#xa;  ID_RICH_JPUB_RICH, ID_STATO_ELAB_STAG, OPERATORE, CONTENUTO_RESPONSE,&#xa;  TIMSTP_RICH,ID_TIPOLG_MESSG,ID_TRANSAZIONE,ANAG_FULL)&#xa;  VALUES (?, ?, ?, ?, 'AUTOMATICO', ?, ?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_REQUEST"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICH_JPUB_RICH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RESPONSE"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RICH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOLG_MESSG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TRANSAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ANAG_FULL"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Log_OLO_Response-input"
                                    name="Log_OLO_Response"
                                    tibex:xpdlId="7184f49b-37b5-4577-9000-2ed73e43a77b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InsertStag_OLOToLog_OLO_Response"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log_OLO_ResponseToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_OLO_Response-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Attesa Notifica OLO Da Jpub'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Error" name="Assign"
                                    outputVariable="Error"
                                    tibex:xpdlId="a47688d6-72dc-4190-96f0-c4391f242270" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Request_OLOToAssign"/>
                                    <bpws:target linkName="RepeatOnErrorToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToInsertStag_OLO"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/FullClass,$_error/Class,$_error/MsgCode)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Error" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:empty name="Empty3" tibex:xpdlId="08c7ca8e-b107-4ec4-9dda-11c2f3b26e98">
                <bpws:targets>
                    <bpws:target linkName="Ciclo_ContrattoToEmpty3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty3ToWhile1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Accumulate1/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Accumulate1/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty3ToCallProcess4">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcess4-input"
                    name="CallProcess4"
                    tibex:xpdlId="9df4b68a-df8b-4065-b8fb-3024a1784ba0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToCallProcess4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess4ToEndSubAsinc"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Nessun Contratto trovato in OK'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="46918814-18c6-46fc-a4e6-0df0fc483e4a">
                <bpws:targets>
                    <bpws:target linkName="Empty3ToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToEndSubAsinc"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index1"
                        sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence3" tibex:group="while">
                    <bpws:empty name="GroupInit3" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index1&lt;=count($Accumulate1/ns8:REQUEST)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Accumulate1/ns8:REQUEST)]]></bpws:condition>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link
                                    name="RepeatOnError1ToInsertStag_Contratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RepeatOnError1ToAssign1" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="CallProcess6ToRepeatOnError1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Request_ContrattoToCallProcess6" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Request_ContrattoToAssign1" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="Log_Contratto_RequestToCallJpub_Contratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Assign1ToInsertStag_Contratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InsertStag_ContrattoToLog_Cont_Response" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart3ToLog_Cont_Request" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Log_Cont_ResponseToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart3"
                                tibex:group="groupStart" tibex:xpdlId="005c5818-e7f3-4425-87ad-4d84a5c44b27">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart3ToLog_Cont_Request"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="1eecf834-07f6-4c05-97b7-44dd7e6712ea">
                                <bpws:targets>
                                    <bpws:target linkName="Log_Cont_ResponseToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:scope name="RepeatOnError1"
                                tibex:group="repeatOnError" tibex:xpdlId="8826c9cb-4395-4772-b87b-0b0116872b87">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess6ToRepeatOnError1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RepeatOnError1ToInsertStag_Contratto"/>
                                    <bpws:source
                                    linkName="RepeatOnError1ToAssign1"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName1"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil3" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope1">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1" tibex:faultNameVar="FaultName1">
                                    <bpws:if name="if1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index>=$MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index>=$MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign1" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
