                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ExitCicloCluster" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat2" tibex:group="repeatUntil" tibex:xpdlId="ce1bcb02-7a6f-443f-a218-7de4e84c99e4">
                <bpws:targets>
                    <bpws:target linkName="SetClusterToRepeat2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Repeat2ToAssign3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Accumulate2/ns8:REQUEST[1]/ns8:ANAGRAFICHE/ns8:ANAGRAFICA_CLUSTER_COMUNI[1]/CODICE_ISTAT_COMUNE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Accumulate2/ns8:REQUEST[1]/ns8:ANAGRAFICHE/ns8:ANAGRAFICA_CLUSTER_COMUNI[1]/CODICE_ISTAT_COMUNE)>0]]></bpws:transitionCondition>
                    </bpws:source>
