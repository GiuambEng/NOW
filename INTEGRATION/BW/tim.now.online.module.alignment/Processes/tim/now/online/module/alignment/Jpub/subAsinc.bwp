                                    inputVariable="StepContratto-input"
                                    name="StepContratto"
                                    tibex:xpdlId="00a56598-b946-421e-a624-2f538ea1738f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
