                                    <bpws:target linkName="GroupStart8ToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd5"/>
                                    </bpws:sources>
                                    </bpws:invoke>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger4-input"
                                    name="GenericLogger4"
                                    tibex:xpdlId="dc8f57ff-289a-4f47-8c4e-b62ecef9f0b2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
