                            <bpws:scope name="RepeatOnError2"
                                tibex:group="repeatOnError" tibex:xpdlId="bf72932d-1525-46ff-9243-dd02a9e1a67f">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger3ToRepeatOnError2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="RepeatOnError2ToAssign3"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RepeatOnError2ToJDBCUpdate"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                    <bpws:variable
                                    name="repeatOnError_success_flag"
                                    sca-bpel:internal="true" type="xsd:boolean"/>
                                    <bpws:variable name="FaultName2"
                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails2" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:repeatUntil name="repeatUntil5" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:scope name="innerScope2">
                                    <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails2" tibex:faultNameVar="FaultName2">
                                    <bpws:if name="if2">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1>=$MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1>=$MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign
                                    name="Assign4" validate="no">
                                    <bpws:copy>

                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                    </bpws:if>
                                    </bpws:catchAll>
                                    </bpws:faultHandlers>
                                    <bpws:flow name="flow9">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart8ToInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="InvokeToGroupEnd5" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart8ToGenericLogger4" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GenericLogger4ToGroupEnd5" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart8"
                                    tibex:group="groupStart" tibex:xpdlId="8e17e4f2-84e6-4e9f-ba87-42d58ada6973">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart8ToInvoke">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$index1=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1=1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart8ToGenericLogger4">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
