            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="b3e180f9-9844-4116-9c2a-56652221f9b7">
                <bpws:targets>
                    <bpws:target linkName="CounterLogToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToRepeat">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns5:TipoRichiesta = 2 or $Start/ns5:TipoRichiesta = 0) and $ExitCicloOLO/ns25:ExitCicloOLO = &quot;CONTINUE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns5:TipoRichiesta = 2 or $Start/ns5:TipoRichiesta = 0) and $ExitCicloOLO/ns25:ExitCicloOLO = "CONTINUE"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToWhile1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($Start/ns5:TipoRichiesta = 1 or $Start/ns5:TipoRichiesta = 0) and $ExitCicloContratto/ns25:ExitCicloContratto = &quot;CONTINUE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns5:TipoRichiesta = 1 or $Start/ns5:TipoRichiesta = 0) and $ExitCicloContratto/ns25:ExitCicloContratto = "CONTINUE"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="Repeat1" tibex:group="repeatUntil" tibex:xpdlId="c8afda22-24e7-413f-9e54-8123a7a8f9c5">
                <bpws:targets>
                    <bpws:target linkName="EmptyToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Repeat1ToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Accumulate1/ns8:REQUEST[1]/ns8:ANAGRAFICHE/ns8:CONTRATTI[1]/CODE_TIPO_CONTR)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Accumulate1/ns8:REQUEST[1]/ns8:ANAGRAFICHE/ns8:CONTRATTI[1]/CODE_TIPO_CONTR)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Repeat1ToEmpty2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="repeatUntil">
                    <bpws:assign name="GroupInit2"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+5774314c-fc67-4fa2-9b0a-f8629b8d9db3" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate1"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:repeatUntil name="repeatUntil1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ExitCicloContratto/ns25:ExitCicloContratto='END'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link
                                    name="SelectContrattoToCallProcess3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CounterContrattiToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToContratti" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CheckContrattoTocall_JpubOLO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Contratti_LavToStepContratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart2ToSelectContratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="StepContrattoToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Check_ContrattoToCheckContratto" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCQuery1ToCheck_Contratto" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess3ToCounterContratti" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="d5eb690c-3097-445d-954f-c2dac231548d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToSelectContratto"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="5774314c-fc67-4fa2-9b0a-f8629b8d9db3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="StepContrattoToGroupEnd2"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Contratti</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SelectContratto-input"
                                    name="SelectContratto"
                                    outputVariable="SelectContratto"
                                    tibex:xpdlId="02633ff0-05e6-407f-ab3f-7029b7d02c96" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToSelectContratto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectContrattoToCallProcess3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+02633ff0-05e6-407f-ab3f-7029b7d02c96+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;SelectContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;subsetSize>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/subsetSize>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    processInSubsets="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_CONTRATTO, COD_OFFERTA_JPUB, CODFC_OLO_AGCOM, IDTPLG_CONTRATTO,&#xd;&#xa;  DATAFI_VALID, DATAINZ_VALID,NOME_CONTRATTO, DATA_INIZIO_COINV_RETE&#xd;&#xa;  FROM TEMP_CONTRATTO&#xd;&#xa;&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="COD_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OFFERTA_JPUB"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="NOME_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_COINV_RETE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CounterContratti"
                                    name="CounterContratti"
                                    outputVariable="CounterContratti"
                                    tibex:xpdlId="a21f277a-8054-4801-96f8-eae9856e8a6f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3ToCounterContratti"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CounterContrattiToJDBCQuery1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="count($SelectContratto/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CounterContratti" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Check_Contratto-input"
                                    name="Check_Contratto"
                                    outputVariable="Check_Contratto"
                                    tibex:xpdlId="bda79d77-a903-428b-b5b8-b73c95224a78"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToCheck_Contratto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToContratti">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($Check_Contratto/ns31:Output_Contratto[1]/ns31:CODE_TIPO_CONTR)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Check_Contratto/ns31:Output_Contratto[1]/ns31:CODE_TIPO_CONTR)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Check_ContrattoToCheckContratto">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;www.telecom.Now.outputtriggerContratto.onLine&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;Check_Contratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                &lt;ns3:ProcessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                &lt;/ns3:ProcessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns3:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery1/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ns3:ID_TRANSAZIONE>&#xa;            &lt;ns3:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ns3:ID_ESEC_PROCSO_NOFILE>&#xa;            &lt;ns3:ID_RICH_JPUB>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ns3:ID_RICH_JPUB>&#xa;            &lt;xsl:for-each select=&quot;$SelectContratto/Record&quot;>&#xa;                &lt;ns3:Contratto>&#xa;                    &lt;xsl:if test=&quot;COD_CONTRATTO&quot;>&#xa;                        &lt;ns3:COD_CONTRATTO>&#xa;                            &lt;xsl:value-of select=&quot;COD_CONTRATTO&quot;/>&#xa;                        &lt;/ns3:COD_CONTRATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;COD_OFFERTA_JPUB&quot;>&#xa;                        &lt;ns3:COD_OFFERTA_JPUB>&#xa;                            &lt;xsl:value-of select=&quot;COD_OFFERTA_JPUB&quot;/>&#xa;                        &lt;/ns3:COD_OFFERTA_JPUB>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                        &lt;ns3:COD_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                        &lt;/ns3:COD_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDTPLG_CONTRATTO&quot;>&#xa;                        &lt;ns3:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;IDTPLG_CONTRATTO&quot;/>&#xa;                        &lt;/ns3:DESCRIZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;NOME_CONTRATTO&quot;>&#xa;                        &lt;ns3:NOME_CONTRATTO>&#xa;                            &lt;xsl:value-of select=&quot;NOME_CONTRATTO&quot;/>&#xa;                        &lt;/ns3:NOME_CONTRATTO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;DATAFI_VALID&quot;>&#xa;                        &lt;ns3:DATAFI_VALID>&#xa;                            &lt;xsl:value-of select=&quot;DATAFI_VALID&quot;/>&#xa;                        &lt;/ns3:DATAFI_VALID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;DATAINZ_VALID&quot;>&#xa;                        &lt;ns3:DATAIN_VALID>&#xa;                            &lt;xsl:value-of select=&quot;DATAINZ_VALID&quot;/>&#xa;                        &lt;/ns3:DATAIN_VALID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns3:DATA_COINV>&#xa;                        &lt;xsl:value-of select=&quot;xsd:string(DATA_INIZIO_COINV_RETE)&quot;/>&#xa;                    &lt;/ns3:DATA_COINV>&#xa;                &lt;/ns3:Contratto>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.online.module.alignment.Jpub.CheckInsertContratto" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
