                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+739a732d-05fb-4927-b7d6-5cce1be188f0+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InAttesaNotificaEsitoAggiornamentoContrattoDaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;KORecord&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate2&quot;/>&#xa;    &lt;xsl:param name=&quot;RequestCluster&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_Jpub_Cluster&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag_Cluster-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate2/tns2:REQUEST[$index]/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_CLUSTER_COMUNI)>0&quot;>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($RequestCluster, true(), true())&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;'NessunClusterComuneValidoDaInviareJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ID_RICH_JPUB_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_Cluster/part1/ns1:Response/ns1:result='OK'&quot;>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$InAttesaNotificaEsitoAggiornamentoContrattoDaJpub&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$KORecord&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_Cluster/part1/ns1:Response/ns1:result='OK'&quot;>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;'InAttesaNotificaEsitoAggiornamentoClusterDaJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;'NessunClusterComuneValidoDaInviareJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_RICH>&#xa;            &lt;ID_TIPOLG_MESSG>&#xa;                &lt;xsl:value-of select=&quot;4&quot;/>&#xa;            &lt;/ID_TIPOLG_MESSG>&#xa;            &lt;ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$RequestCluster/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;ANAG_FULL>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/ANAG_FULL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsertStag_Cluster-input"
                                    name="InsertStag_Cluster"
