to/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;ANAG_FULL>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/ANAG_FULL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsertStag_Contratto-input"
                                    name="InsertStag_Contratto"
                                    outputVariable="InsertStag_Contratto"
                                    tibex:xpdlId="7ab5f3ad-b6ab-4df5-8342-01152aa847c0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RepeatOnError1ToInsertStag_Contratto"/>
                                    <bpws:target linkName="Assign1ToInsertStag_Contratto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertStag_ContrattoToLog_Cont_Response"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7ab5f3ad-b6ab-4df5-8342-01152aa847c0+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_Jpub_Contratto.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Request_Contratto&quot;/>&#xa;    &lt;xsl:param name=&quot;InAttesaNotificaEsitoAggiornamentoContrattoDaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;KORecord&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:param name=&quot;Error&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag_Contratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate1/tns2:REQUEST[number($index1)]/tns2:ANAGRAFICHE/tns2:CONTRATTI)>0&quot;>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Request_Contratto)&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;'NessunContrattoValidoDaInviareJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_REQUEST>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ID_RICH_JPUB_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_Contratto.part1/ns1:result='OK'&quot;>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$InAttesaNotificaEsitoAggiornamentoContrattoDaJpub&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$KORecord&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Jpub_Contratto.part1/ns1:result='OK'&quot;>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;'InAttesaNotificaEsitoAggiornamentoContrattoDaJpub'&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;concat('RicevutoKOdaJpub',$Error)&quot;/>&#xa;                    &lt;/CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_RICH>&#xa;            &lt;ID_TIPOLG_MESSG>&#xa;                &lt;xsl:value-of select=&quot;2&quot;/>&#xa;            &lt;/ID_TIPOLG_MESSG>&#xa;            &lt;ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$Request_Contratto/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ID_TRANSAZIONE>&#xa;            &lt;ANAG_FULL>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/ANAG_FULL>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_JPUB_OUT (CONTENUTO_REQUEST, ID_ESEC_PROCSO_NO_FILE,&#xa;  ID_RICH_JPUB_RICH, ID_STATO_ELAB_STAG, OPERATORE, CONTENUTO_RESPONSE,&#xa;  TIMSTP_RICH,ID_TIPOLG_MESSG,ID_TRANSAZIONE,ANAG_FULL)&#xa;  VALUES (?, ?, ?, ?, 'AUTOMATICO', ?, ?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_REQUEST"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_RICH_JPUB_RICH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RESPONSE"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RICH"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TIPOLG_MESSG"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_TRANSAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ANAG_FULL"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Log_Cont_Response-input"
                                    name="Log_Cont_Response"
                                    tibex:xpdlId="9949c899-ef6d-44e5-8e5b-31bd8d8385ae"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InsertStag_ContrattoToLog_Cont_Response"/>
