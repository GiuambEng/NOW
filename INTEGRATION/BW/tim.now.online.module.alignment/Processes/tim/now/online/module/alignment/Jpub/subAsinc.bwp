            <bpws:empty name="Empty4" tibex:xpdlId="4ad91ff5-9fbf-4e26-9c9e-f8cfdde1257b">
                <bpws:targets>
                    <bpws:target linkName="CountCluster_2ToEmpty4"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty4ToGenericLogger2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty4ToWhile2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Accumulate2/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Accumulate2/ns8:REQUEST[string-length(ID_TRANSAZIONE)>0])>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="While2" tibex:group="while" tibex:xpdlId="eeed119d-9c6a-4902-bc84-4c57d387ae56">
                <bpws:targets>
                    <bpws:target linkName="Empty4ToWhile2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While2ToEndSubAsinc"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence5" tibex:group="while">
                    <bpws:empty name="GroupInit5" tibex:group="groupInit"/>
                    <bpws:while name="while2" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Accumulate2/ns8:REQUEST)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Accumulate2/ns8:REQUEST)]]></bpws:condition>
                        <bpws:flow name="flow8">
                            <bpws:links>
                                <bpws:link name="GroupStart7ToMapper1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RequestClusterToGenericLogger3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RequestClusterToAssign3" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="GenericLogger3ToRepeatOnError2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RepeatOnError2ToAssign3" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="RepeatOnError2ToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InsertStag_ClusterToGenericLogger5" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLogger5ToGroupEnd4" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart7"
                                tibex:group="groupStart" tibex:xpdlId="712ae44c-487c-472b-83ac-ebea1a262d74">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart7ToMapper1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd4"
                                tibex:group="groupEnd" tibex:xpdlId="e161b2fc-3a48-4fcf-b139-f9c03d766288">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger5ToGroupEnd4"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RequestCluster-input"
                                    name="RequestCluster"
                                    outputVariable="RequestCluster"
                                    tibex:xpdlId="0c07dcfc-b7f7-4c17-8f6c-87f0f62cbe9b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart7ToMapper1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RequestClusterToGenericLogger3"/>
                                    <bpws:source
                                    linkName="RequestClusterToAssign3"
                                    tibex:faultDetailsVar="RequestCluster" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:template name=&quot;RequestCluster-input&quot; match=&quot;/&quot;>&lt;tns2:REQUEST>&lt;ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$Accumulate2/tns2:REQUEST[$index]/ID_TRANSAZIONE&quot;/>&lt;/ID_TRANSAZIONE>&lt;tns2:ANAGRAFICHE>&lt;xsl:for-each select=&quot;$Accumulate2/tns2:REQUEST[$index]/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_CLUSTER_COMUNI[1]&quot;>&lt;tns2:ANAGRAFICA_CLUSTER_COMUNI>&lt;CODICE_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;CODICE_ISTAT_COMUNE&quot;/>&lt;/CODICE_ISTAT_COMUNE>&lt;xsl:if test=&quot;CODICE_CLUSTER&quot;>&lt;CODICE_CLUSTER>&lt;xsl:value-of select=&quot;CODICE_CLUSTER&quot;/>&lt;/CODICE_CLUSTER>&lt;/xsl:if>&lt;TIPOLOGIA_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;TIPOLOGIA_CLUSTER_COMUNE&quot;/>&lt;/TIPOLOGIA_CLUSTER_COMUNE>&lt;xsl:if test=&quot;DATA_INIZIO_VALIDITA_PRICING&quot;>&lt;DATA_INIZIO_VALIDITA_PRICING>&lt;xsl:value-of select=&quot;DATA_INIZIO_VALIDITA_PRICING&quot;/>&lt;/DATA_INIZIO_VALIDITA_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;DATA_FINE_VALIDITA_PRICING&quot;>&lt;DATA_FINE_VALIDITA_PRICING>&lt;xsl:value-of select=&quot;DATA_FINE_VALIDITA_PRICING&quot;/>&lt;/DATA_FINE_VALIDITA_PRICING>&lt;/xsl:if>&lt;DESCRIZIONE_COMUNE>&lt;xsl:value-of select=&quot;DESCRIZIONE_COMUNE&quot;/>&lt;/DESCRIZIONE_COMUNE>&lt;TIPO_CONTR>&lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&lt;/TIPO_CONTR>&lt;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:if test=&quot;DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&lt;DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;xsl:value-of select=&quot;DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&lt;/DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;VERSIONING&quot;>&lt;VERSIONING>&lt;xsl:value-of select=&quot;VERSIONING&quot;/>&lt;/VERSIONING>&lt;/xsl:if>&lt;/tns2:ANAGRAFICA_CLUSTER_COMUNI>&lt;/xsl:for-each>&lt;/tns2:ANAGRAFICHE>&lt;/tns2:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:AggiornamentoMassiveAnagrafiche_Input="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="AggiornamentoMassiveAnagrafiche_Input:REQUEST" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="GenericLogger3-input"
                                    name="GenericLogger3"
                                    tibex:xpdlId="3cd6dc15-dfdc-4505-9928-54af2c5c1008"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RequestClusterToGenericLogger3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger3ToRepeatOnError2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RequestCluster&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'subAsinc'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('RequestCluster',tib:render-xml($RequestCluster,true(),true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Error" name="Assign3"
                                    outputVariable="Error"
                                    tibex:xpdlId="72e6eb24-cdb5-4f61-8eca-0b243c37cf09" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RequestClusterToAssign3"/>
                                    <bpws:target linkName="RepeatOnError2ToAssign3"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/FullClass,$_error/Class,$_error/MsgCode)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
