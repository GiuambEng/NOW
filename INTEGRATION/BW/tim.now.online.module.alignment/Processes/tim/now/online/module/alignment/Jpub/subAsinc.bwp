                                    partnerLink="ProxyJpubCluster"
                                    portType="ns52:ProxyJpubCluster" tibex:xpdlId="2256222d-3f61-4f16-a7cd-e8d73e1fe281">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns2="http://www.tim.now.ProxyJpubCluster_concrete/" xmlns:ns1="www.tim.now.proxyJpub.schema" xmlns:tns2="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input" version="2.0"&gt;&lt;xsl:param name="RequestCluster"/&gt;&lt;xsl:template name="Call_Jpub_Cluster-input" match="/"&gt;&lt;ns2:Request&gt;&lt;part1&gt;&lt;ns1:RequestClusterProxy&gt;&lt;ns1:ID_TRANSAZIONE&gt;&lt;xsl:value-of select="$RequestCluster/ID_TRANSAZIONE"/&gt;&lt;/ns1:ID_TRANSAZIONE&gt;&lt;xsl:for-each select="$RequestCluster/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_CLUSTER_COMUNI"&gt;&lt;ns1:cluster&gt;&lt;ns1:CODICE_ISTAT_COMUNE&gt;&lt;xsl:value-of select="CODICE_ISTAT_COMUNE"/&gt;&lt;/ns1:CODICE_ISTAT_COMUNE&gt;&lt;ns1:CODICE_CLUSTER&gt;&lt;xsl:value-of select="CODICE_CLUSTER"/&gt;&lt;/ns1:CODICE_CLUSTER&gt;&lt;ns1:TIPOLOGIA_CLUSTER_COMUNE&gt;&lt;xsl:value-of select="TIPOLOGIA_CLUSTER_COMUNE"/&gt;&lt;/ns1:TIPOLOGIA_CLUSTER_COMUNE&gt;&lt;ns1:DATA_INIZIO_VALIDITA_PRICING&gt;&lt;xsl:value-of select="DATA_INIZIO_VALIDITA_PRICING"/&gt;&lt;/ns1:DATA_INIZIO_VALIDITA_PRICING&gt;&lt;ns1:DATA_FINE_VALIDITA_PRICING&gt;&lt;xsl:value-of select="DATA_FINE_VALIDITA_PRICING"/&gt;&lt;/ns1:DATA_FINE_VALIDITA_PRICING&gt;&lt;ns1:DESCRIZIONE_COMUNE&gt;&lt;xsl:value-of select="DESCRIZIONE_COMUNE"/&gt;&lt;/ns1:DESCRIZIONE_COMUNE&gt;&lt;ns1:TIPO_CONTR&gt;&lt;xsl:value-of select="TIPO_CONTR"/&gt;&lt;/ns1:TIPO_CONTR&gt;&lt;ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:value-of select="DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI"/&gt;&lt;/ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:value-of select="DATA_FINE_MARCAGGIO_NUOVI_ACCESSI"/&gt;&lt;/ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&gt;&lt;xsl:if test="DATA_INIZIO_MARCAGGIO_PREGRESSO"&gt;&lt;ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&gt;&lt;xsl:value-of select="DATA_INIZIO_MARCAGGIO_PREGRESSO"/&gt;&lt;/ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="VERSIONING"&gt;&lt;ns1:VERSIONING&gt;&lt;xsl:value-of select="VERSIONING"/&gt;&lt;/ns1:VERSIONING&gt;&lt;/xsl:if&gt;&lt;/ns1:cluster&gt;&lt;/xsl:for-each&gt;&lt;/ns1:RequestClusterProxy&gt;&lt;/part1&gt;&lt;/ns2:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://www.tim.now.ProxyJpubCluster_concrete/&quot; xmlns:ns1=&quot;www.tim.now.proxyJpub.schema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche_Input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RequestCluster&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_Jpub_Cluster-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:RequestClusterProxy>&#xa;            &lt;ns1:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;$RequestCluster/ID_TRANSAZIONE&quot;/>&#xa;            &lt;/ns1:ID_TRANSAZIONE>&#xa;            &lt;xsl:for-each select=&quot;$RequestCluster/tns2:ANAGRAFICHE/tns2:ANAGRAFICA_CLUSTER_COMUNI&quot;>&#xa;                &lt;ns1:cluster>&#xa;                    &lt;ns1:CODICE_ISTAT_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_ISTAT_COMUNE&quot;/>&#xa;                    &lt;/ns1:CODICE_ISTAT_COMUNE>&#xa;                    &lt;ns1:CODICE_CLUSTER>&#xa;                        &lt;xsl:value-of select=&quot;CODICE_CLUSTER&quot;/>&#xa;                    &lt;/ns1:CODICE_CLUSTER>&#xa;                    &lt;ns1:TIPOLOGIA_CLUSTER_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;TIPOLOGIA_CLUSTER_COMUNE&quot;/>&#xa;                    &lt;/ns1:TIPOLOGIA_CLUSTER_COMUNE>&#xa;                    &lt;ns1:DATA_INIZIO_VALIDITA_PRICING>&#xa;                        &lt;xsl:value-of select=&quot;DATA_INIZIO_VALIDITA_PRICING&quot;/>&#xa;                    &lt;/ns1:DATA_INIZIO_VALIDITA_PRICING>&#xa;                    &lt;ns1:DATA_FINE_VALIDITA_PRICING>&#xa;                        &lt;xsl:value-of select=&quot;DATA_FINE_VALIDITA_PRICING&quot;/>&#xa;                    &lt;/ns1:DATA_FINE_VALIDITA_PRICING>&#xa;                    &lt;ns1:DESCRIZIONE_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;DESCRIZIONE_COMUNE&quot;/>&#xa;                    &lt;/ns1:DESCRIZIONE_COMUNE>&#xa;                    &lt;ns1:TIPO_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;TIPO_CONTR&quot;/>&#xa;                    &lt;/ns1:TIPO_CONTR>&#xa;                    &lt;ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                        &lt;xsl:value-of select=&quot;DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                    &lt;/ns1:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                        &lt;xsl:value-of select=&quot;DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                    &lt;/ns1:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;xsl:if test=&quot;DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&#xa;                        &lt;ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                            &lt;xsl:value-of select=&quot;DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&#xa;                        &lt;/ns1:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;VERSIONING&quot;>&#xa;                        &lt;ns1:VERSIONING>&#xa;                            &lt;xsl:value-of select=&quot;VERSIONING&quot;/>&#xa;                        &lt;/ns1:VERSIONING>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:cluster>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns1:RequestClusterProxy>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
