                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Check_OLO-input"
                                    name="Check_OLO"
                                    outputVariable="Check_OLO"
                                    tibex:xpdlId="bcfafc71-3c49-4679-80ee-5d11f093fadb"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToCheck_OLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToOLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($Check_OLO/ns29:Output_Olo[1]/ns29:CODE_GEST)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Check_OLO/ns29:Output_Olo[1]/ns29:CODE_GEST)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Check_OLOToCheckOLO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;www.telecom.Now.outputtriggerOLO.onLine&quot; xmlns:ns=&quot;www.tim.now.allineamentoMassivoAngarfiche.Olo.Passo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Check_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;xsl:if test=&quot;$Start/ns:ProcessID&quot;>&#xa;                &lt;ns3:ProcessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:ProcessID&quot;/>&#xa;                &lt;/ns3:ProcessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns3:ID_TRANSAZIONE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ns3:ID_TRANSAZIONE>&#xa;            &lt;ns3:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_ESEC_PROC_FILE&quot;/>&#xa;            &lt;/ns3:ID_ESEC_PROCSO_NOFILE>&#xa;            &lt;ns3:ID_RICH_JPUB>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:TransactionId&quot;/>&#xa;            &lt;/ns3:ID_RICH_JPUB>&#xa;            &lt;xsl:for-each select=&quot;$SelectOLO/Record&quot;>&#xa;                &lt;ns3:Olo>&#xa;                    &lt;xsl:if test=&quot;CODFC_OLO_AGCOM&quot;>&#xa;                        &lt;ns3:COD_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;CODFC_OLO_AGCOM&quot;/>&#xa;                        &lt;/ns3:COD_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;NOME&quot;>&#xa;                        &lt;ns3:NOME>&#xa;                            &lt;xsl:value-of select=&quot;NOME&quot;/>&#xa;                        &lt;/ns3:NOME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;PARTITA_IVA&quot;>&#xa;                        &lt;ns3:PARTITA_IVA>&#xa;                            &lt;xsl:value-of select=&quot;PARTITA_IVA&quot;/>&#xa;                        &lt;/ns3:PARTITA_IVA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;RAGIONE_SOCIALE&quot;>&#xa;                        &lt;ns3:RAGIONE_SOCIALE>&#xa;                            &lt;xsl:value-of select=&quot;RAGIONE_SOCIALE&quot;/>&#xa;                        &lt;/ns3:RAGIONE_SOCIALE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns3:Olo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.online.module.alignment.Jpub.CheckInsertOLO" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
