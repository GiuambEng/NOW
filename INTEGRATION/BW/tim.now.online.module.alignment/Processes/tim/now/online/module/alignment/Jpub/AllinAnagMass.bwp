                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche/" xmlns:ns2="www.tim.now.aggiornamentomassivo.Jpub.tim.now.schema.xsd.AsincJpub.xsd" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns4="http://www.tim.now.AllineamentoMAssivoAnagraficheasinc_concrete" version="2.0"&gt;&lt;xsl:param name="AggiornamentoMassivoAnagrafiche"/&gt;&lt;xsl:param name="ProcessID"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:template name="callAsinc-input" match="/"&gt;&lt;ns4:Input&gt;&lt;part1&gt;&lt;ns2:Input&gt;&lt;ns2:Passo&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/ns2:Passo&gt;&lt;ns2:TipoRichiesta&gt;&lt;xsl:value-of select="$AggiornamentoMassivoAnagrafiche/part1/ns:REQUEST/TIPO_RICHIESTA"/&gt;&lt;/ns2:TipoRichiesta&gt;&lt;ns2:CorrelationID&gt;&lt;xsl:value-of select="$ProcessID/part1/ns3:Output/ns3:Esito/ns3:CORRELATION_ID"/&gt;&lt;/ns2:CorrelationID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="contains($ProcessID/part1/ns3:Output/ns3:Esito/ns3:ID_ESEC_PROCSO_NOFILE, '.')"&gt;&lt;ns2:TransactioID&gt;&lt;xsl:value-of select="xsd:int(substring-before($ProcessID/part1/ns3:Output/ns3:Esito/ns3:ID_ESEC_PROCSO_NOFILE,'.'))"/&gt;&lt;/ns2:TransactioID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns2:TransactioID&gt;&lt;xsl:value-of select="xsd:int($ProcessID/part1/ns3:Output/ns3:Esito/ns3:ID_ESEC_PROCSO_NOFILE)"/&gt;&lt;/ns2:TransactioID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns2:ProcessID&gt;&lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;&lt;/ns2:ProcessID&gt;&lt;/ns2:Input&gt;&lt;/part1&gt;&lt;/ns4:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
