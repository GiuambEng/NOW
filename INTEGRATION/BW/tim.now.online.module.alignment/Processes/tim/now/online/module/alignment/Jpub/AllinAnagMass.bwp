                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails2&quot;/>&lt;xsl:param name=&quot;Operation1&quot;/>&lt;xsl:param name=&quot;Operation2&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error_Log-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllinAnagMass'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'AllineamentoMassivoAnagrafiche'&quot;/>&lt;/tns:Service>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Operation1)>0&quot;>&lt;tns:Operation>&lt;xsl:value-of select=&quot;$Operation1&quot;/>&lt;/tns:Operation>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Operation>&lt;xsl:value-of select=&quot;$Operation2&quot;/>&lt;/tns:Operation>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Fault AllinAnagMass',$FaultDetails2/ActivityName,$FaultDetails2/ProcessStack,$FaultDetails2/StackTrace,$FaultDetails2/MsgCode,$FaultDetails2/Msg)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
