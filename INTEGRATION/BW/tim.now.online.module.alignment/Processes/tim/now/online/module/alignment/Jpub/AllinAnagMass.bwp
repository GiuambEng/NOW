                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiAnagrafiche.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContext1&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Start_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllinAnagMass'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllinAnagMass'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'InvioEsitiAnagrafiche'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($InvioEsitiAnagrafiche.part1, true(),true()),'-----',tib:render-xml($GetContext1, true(),true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1a8eea04-a342-4ff6-8db6-6b4091226165+input&quot; xmlns:tns1=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvioEsitiAnagrafiche&quot;/>&lt;xsl:template name=&quot;CorreleationID-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($InvioEsitiAnagrafiche/part1/tns1:ESITI/tns1:TESTATA/@IDTRANSAZIONE)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CorreleationID-input"
                                    name="CorreleationID"
                                    outputVariable="CorreleationID"
                                    tibex:xpdlId="1a8eea04-a342-4ff6-8db6-6b4091226165" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GetLocalIPToCorreleationID"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToUP_Process"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1a8eea04-a342-4ff6-8db6-6b4091226165+input&quot; xmlns:tns1=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvioEsitiAnagrafiche.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;CorreleationID-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($InvioEsitiAnagrafiche.part1/tns1:TESTATA/@IDTRANSAZIONE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CORRELATION_ID, ID_ESEC_PROCSO_NO_FILE&#xd;&#xa;  FROM ESEC_PROCSO_NO_FILE&#xd;&#xa;  WHERE CORRELATION_ID IN (SELECT ESEC_PROCSO_NO_FILE.CORRELATION_ID&#xd;&#xa;                             FROM ESEC_PROCSO_NO_FILE&#xd;&#xa;                             WHERE ESEC_PROCSO_NO_FILE.ID_ESEC_PROCSO_NO_FILE = ?)&#xd;&#xa;  ORDER BY ID_ESEC_PROCSO_NO_FILE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <columnMetadata
                                    columnName="CORRELATION_ID"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_NO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvioEsitiAnagrafiche&quot;/>&lt;xsl:param name=&quot;Ins_Esiti&quot;/>&lt;xsl:param name=&quot;RicevutoEsitoOKdaJpub&quot;/>&lt;xsl:param name=&quot;RicevutoEsitoKOdaJpub&quot;/>&lt;xsl:param name=&quot;ID_RICH&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Insert>&lt;xsl:if test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CODESCARTO&quot;>&lt;ns:Cod_Scarto>&lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CODESCARTO&quot;/>&lt;/ns:Cod_Scarto>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CODEDETTSCARTO&quot;>&lt;ns:Cod_DettScarto>&lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CODEDETTSCARTO&quot;/>&lt;/ns:Cod_DettScarto>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@TAGINERRORE&quot;>&lt;ns:TagInErrore>&lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@TAGINERRORE&quot;/>&lt;/ns:TagInErrore>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@NOMEATTRIBINERRORE&quot;>&lt;ns:NomeAttInErrore>&lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@NOMEATTRIBINERRORE&quot;/>&lt;/ns:NomeAttInErrore>&lt;/xsl:if>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($InvioEsitiAnagrafiche/part1/tns:ESITI)&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Ins_Esiti/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE))>0&quot;>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Ins_Esiti/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ID_RICH/Record)>0&quot;>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;xsd:integer($ID_RICH/Record[1]/ID_RICH_JPUB_RICH)&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CODESCARTO='0'&quot;>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RicevutoEsitoOKdaJpub&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RicevutoEsitoKOdaJpub&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;xsl:if test=&quot;count($ID_RICH/Record)>0 and string-length($ID_RICH/Record[1]/ANAG_FULL)>0 and $ID_RICH/Record[1]/ANAG_FULL='Y'&quot;>&lt;ns:FlagMassivo>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/ns:FlagMassivo>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:TESTATA/@IDTRANSAZIONE&quot;>&lt;ns:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:TESTATA/@IDTRANSAZIONE&quot;/>&lt;/ns:ID_TRANSAZIONE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CATEGORIA='CLUST'&quot;>&lt;ns:ID_TIPOLG_MESS>&lt;xsl:value-of select=&quot;4&quot;/>&lt;/ns:ID_TIPOLG_MESS>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvioEsitiAnagrafiche/part1/tns:ESITI/tns:NOTIFICA/@CATEGORIA='CONT'&quot;>&lt;ns:ID_TIPOLG_MESS>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ns:ID_TIPOLG_MESS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_TIPOLG_MESS>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/ns:ID_TIPOLG_MESS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:Insert>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="InsStaging-input"
                                    name="InsStaging"
                                    tibex:xpdlId="477a4e66-12b1-4e86-8eb3-157148179ebf"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToInsStaging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsStagingToUp_Esiti"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_Esiti.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitiAnagrafiche.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RicevutoEsitoOKdaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;RicevutoEsitoKOdaJpub&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_RICH&quot;/>&#xa;    &lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Insert>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CODESCARTO&quot;>&#xa;                    &lt;ns:Cod_Scarto>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CODESCARTO&quot;/>&#xa;                    &lt;/ns:Cod_Scarto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CODEDETTSCARTO&quot;>&#xa;                    &lt;ns:Cod_DettScarto>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CODEDETTSCARTO&quot;/>&#xa;                    &lt;/ns:Cod_DettScarto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@TAGINERRORE&quot;>&#xa;                    &lt;ns:TagInErrore>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@TAGINERRORE&quot;/>&#xa;                    &lt;/ns:TagInErrore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@NOMEATTRIBINERRORE&quot;>&#xa;                    &lt;ns:NomeAttInErrore>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@NOMEATTRIBINERRORE&quot;/>&#xa;                    &lt;/ns:NomeAttInErrore>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvioEsitiAnagrafiche.part1)&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($Ins_Esiti.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE))>0&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($Ins_Esiti.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ID_RICH/Record)>0&quot;>&#xa;                        &lt;ns:ID_RICH_JPUB_RICH>&#xa;                            &lt;xsl:value-of select=&quot;xsd:integer($ID_RICH/Record[1]/ID_RICH_JPUB_RICH)&quot;/>&#xa;                        &lt;/ns:ID_RICH_JPUB_RICH>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_RICH_JPUB_RICH>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/ns:ID_RICH_JPUB_RICH>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CODESCARTO='0'&quot;>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$RicevutoEsitoOKdaJpub&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$RicevutoEsitoKOdaJpub&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;count($ID_RICH/Record)>0 and string-length($ID_RICH/Record[1]/ANAG_FULL)>0 and $ID_RICH/Record[1]/ANAG_FULL='Y'&quot;>&#xa;                    &lt;ns:FlagMassivo>&#xa;                        &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                    &lt;/ns:FlagMassivo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvioEsitiAnagrafiche.part1/tns:TESTATA/@IDTRANSAZIONE&quot;>&#xa;                    &lt;ns:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$InvioEsitiAnagrafiche.part1/tns:TESTATA/@IDTRANSAZIONE&quot;/>&#xa;                    &lt;/ns:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CATEGORIA='CLUST'&quot;>&#xa;                        &lt;ns:ID_TIPOLG_MESS>&#xa;                            &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                        &lt;/ns:ID_TIPOLG_MESS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$InvioEsitiAnagrafiche.part1/tns:NOTIFICA/@CATEGORIA='CONT'&quot;>&#xa;                        &lt;ns:ID_TIPOLG_MESS>&#xa;                            &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                        &lt;/ns:ID_TIPOLG_MESS>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_TIPOLG_MESS>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/ns:ID_TIPOLG_MESS>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.online.module.alignment.Jpub.subStaging_In" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="End_Log-input"
                                    name="End_Log"
                                    tibex:xpdlId="d79a83cd-de6b-4a38-af3e-4a1fa2855369"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToEnd_Log"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="End_LogToReply1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
