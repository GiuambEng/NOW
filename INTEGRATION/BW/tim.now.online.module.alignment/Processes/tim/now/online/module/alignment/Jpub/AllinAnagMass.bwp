                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_JPUB_Anagrafiche/" xmlns:ns1="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche/" version="2.0"&gt;&lt;xsl:param name="ErrorResponse"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:AggiornamentoMassivoAnagraficheResponse&gt;&lt;part1&gt;&lt;ns1:Esito&gt;&lt;returnCode&gt;&lt;xsl:value-of select="$ErrorResponse/returnCode"/&gt;&lt;/returnCode&gt;&lt;xsl:if test="$ErrorResponse/returnDescription"&gt;&lt;returnDescription&gt;&lt;xsl:value-of select="$ErrorResponse/returnDescription"/&gt;&lt;/returnDescription&gt;&lt;/xsl:if&gt;&lt;/ns1:Esito&gt;&lt;/part1&gt;&lt;/tns:AggiornamentoMassivoAnagraficheResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_JPUB_Anagrafiche/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Esito>&#xa;            &lt;returnCode>&#xa;                &lt;xsl:value-of select=&quot;$ErrorResponse/returnCode&quot;/>&#xa;            &lt;/returnCode>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/returnDescription&quot;>&#xa;                &lt;returnDescription>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/returnDescription&quot;/>&#xa;                &lt;/returnDescription>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns1:Esito>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
