                            partnerLink="GestioneErrore"
                            portType="ns9:GenericError" tibex:xpdlId="bb6e76bb-4d8e-440c-858a-727aa68cf980">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="FaultDetails2"/&gt;&lt;xsl:param name="Operation1"/&gt;&lt;xsl:param name="ProcessID"/&gt;&lt;xsl:param name="TransactionID"/&gt;&lt;xsl:param name="Operation2"/&gt;&lt;xsl:param name="CorrelationID"/&gt;&lt;xsl:param name="Ins_Esiti"/&gt;&lt;xsl:param name="ID_PROCSO_NOFILE"/&gt;&lt;xsl:param name="ID_ESITI"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'"&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'InvioEsitiAnagrafiche'"/&gt;&lt;/ns:ActivityName&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$FaultDetails2/ActivityName='AggiornamentoMassivoAnagrafiche' or $Operation1='AggiornamentoMassivoAnagrafiche'"&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'AggiornamentoMassivoAnagrafiche'"/&gt;&lt;/ns:ActivityName&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails2/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Data&gt;&lt;xsl:copy-of select="$FaultDetails2/Data/ancestor-or-self::*/namespace::node()"/&gt;&lt;xsl:copy-of select="$FaultDetails2/Data/@*"/&gt;&lt;xsl:copy-of select="$FaultDetails2/Data/node()"/&gt;&lt;/ns:Data&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails2/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails2/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails2/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails2/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($Ins_Esiti/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$Ins_Esiti/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$Ins_Esiti/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Operation2)&gt;0"&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="'InvioEsitiAnagrafiche'"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($Operation1)&gt;0"&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="$Operation1"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($TransactionID)&gt;0"&gt;&lt;ns:JpubTransactionID&gt;&lt;xsl:value-of select="xsd:integer($TransactionID)"/&gt;&lt;/ns:JpubTransactionID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:JpubTransactionID&gt;&lt;xsl:value-of select="000"/&gt;&lt;/ns:JpubTransactionID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(string($CorrelationID))&gt;0"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$CorrelationID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_ESITI"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_NOFILE"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_Esiti.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails2&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation1&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation2&quot;/>&#xa;    &lt;xsl:param name=&quot;CorrelationID&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NOFILE&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESITI&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'&quot;>&#xa;                    &lt;ns:ActivityName>&#xa;                        &lt;xsl:value-of select=&quot;'InvioEsitiAnagrafiche'&quot;/>&#xa;                    &lt;/ns:ActivityName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FaultDetails2/ActivityName='AggiornamentoMassivoAnagrafiche' or $Operation1='AggiornamentoMassivoAnagrafiche'&quot;>&#xa;                    &lt;ns:ActivityName>&#xa;                        &lt;xsl:value-of select=&quot;'AggiornamentoMassivoAnagrafiche'&quot;/>&#xa;                    &lt;/ns:ActivityName>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Data>&#xa;                    &lt;xsl:copy-of select=&quot;$FaultDetails2/Data/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$FaultDetails2/Data/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$FaultDetails2/Data/node()&quot;/>&#xa;                &lt;/ns:Data>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails2/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Ins_Esiti.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Ins_Esiti.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Ins_Esiti.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_Esec_Proc>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ns:ID_Esec_Proc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Operation2)>0&quot;>&#xa;                    &lt;ns:ProcessName>&#xa;                        &lt;xsl:value-of select=&quot;'InvioEsitiAnagrafiche'&quot;/>&#xa;                    &lt;/ns:ProcessName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Operation1)>0&quot;>&#xa;                    &lt;ns:ProcessName>&#xa;                        &lt;xsl:value-of select=&quot;$Operation1&quot;/>&#xa;                    &lt;/ns:ProcessName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ProcessName>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ns:ProcessName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($TransactionID)>0&quot;>&#xa;                    &lt;ns:JpubTransactionID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($TransactionID)&quot;/>&#xa;                    &lt;/ns:JpubTransactionID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:JpubTransactionID>&#xa;                        &lt;xsl:value-of select=&quot;000&quot;/>&#xa;                    &lt;/ns:JpubTransactionID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($CorrelationID))>0&quot;>&#xa;                            &lt;ns:CorrelationID>&#xa;                                &lt;xsl:value-of select=&quot;$CorrelationID&quot;/>&#xa;                            &lt;/ns:CorrelationID>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FaultDetails2/ActivityName='InvioEsitiAnagrafiche' or $Operation2='InvioEsitiAnagrafiche'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ESITI&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="Error_LogToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToReply">
                                    <tibex:DesignExpression/>
                                </bpws:source>
                                <bpws:source
                                    linkName="ErrorToCallProcess"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
