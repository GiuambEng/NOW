     &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                    &lt;/tns:ResponseProcess>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($FindCase.part1/tns1:Find[tns1:Asset/statoAsset = 'ATTIVO' and tns1:Asset/codificaOLOAGCOM = 'TLC']) > 1 and $FindCase.part1/tns1:Find[tns1:Asset/statoAsset = 'ATTIVO' and tns1:Asset/codificaOLOAGCOM = 'TLC']/tns1:Response/tns1:Esito = 'OK'&quot;>&#xa;                    &lt;tns:ResponseProcess>&#xa;                        &lt;tns:IDRISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeIn.input/tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:IDRISORSA>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                    &lt;/tns:ResponseProcess>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:ResponseProcess>&#xa;                        &lt;tns:IDRISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeIn.input/tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:IDRISORSA>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                    &lt;/tns:ResponseProcess>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:Header_Output>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.header/h:sourceSystem&quot;>&#xa;                    &lt;h:sourceSystem>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.header/h:sourceSystem&quot;/>&#xa;                    &lt;/h:sourceSystem>&#xa;                &lt;/xsl:if>&#xa;                &lt;h:interactionDate>&#xa;                    &lt;h:Date>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                    &lt;/h:Date>&#xa;                    &lt;h:Time>&#xa;                        &lt;xsl:value-of select=&quot;concat(tib:pad-front(xsd:string(hours-from-dateTime(current-dateTime())),2,'0'),':',tib:pad-front(xsd:string(minutes-from-dateTime(current-dateTime())),2,'0'),':','00')&quot;/>&#xa;                    &lt;/h:Time>&#xa;                &lt;/h:interactionDate>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.header/h:businessID&quot;>&#xa;                    &lt;h:businessID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.header/h:businessID&quot;/>&#xa;                    &lt;/h:businessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.header/h:messageID&quot;>&#xa;                    &lt;h:messageID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.header/h:messageID&quot;/>&#xa;                    &lt;/h:messageID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.header/h:transactionID&quot;>&#xa;                    &lt;h:transactionID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.header/h:transactionID&quot;/>&#xa;                    &lt;/h:transactionID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:Header_Output>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
