                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:ResponseProcess>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($InvokeIn/input/tns:Request/tns:ID_RISORSA)>0&quot;>&lt;tns:IDRISORSA>&lt;xsl:value-of select=&quot;$InvokeIn/input/tns:Request/tns:ID_RISORSA&quot;/>&lt;/tns:IDRISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDRISORSA>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:IDRISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ESITO>&lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&lt;/tns:ESITO>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;tns:DESC_ERRORE>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:DESC_ERRORE>&lt;/tns:ResponseProcess>&lt;tns:Header_Output>&lt;xsl:if test=&quot;$InvokeIn/header/h:Header/h:sourceSystem&quot;>&lt;h:sourceSystem>&lt;xsl:value-of select=&quot;$InvokeIn/header/h:Header/h:sourceSystem&quot;/>&lt;/h:sourceSystem>&lt;/xsl:if>&lt;h:interactionDate>&lt;h:Date>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/h:Date>&lt;h:Time>&lt;xsl:value-of select=&quot;concat(tib:pad-front(xsd:string(hours-from-dateTime(current-dateTime())),2,'0'),':',tib:pad-front(xsd:string(minutes-from-dateTime(current-dateTime())),2,'0'),':','00')&quot;/>&lt;/h:Time>&lt;/h:interactionDate>&lt;xsl:if test=&quot;$InvokeIn/header/h:Header/h:businessID&quot;>&lt;h:businessID>&lt;xsl:value-of select=&quot;$InvokeIn/header/h:Header/h:businessID&quot;/>&lt;/h:businessID>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/header/h:Header/h:messageID&quot;>&lt;h:messageID>&lt;xsl:value-of select=&quot;$InvokeIn/header/h:Header/h:messageID&quot;/>&lt;/h:messageID>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/header/h:Header/h:transactionID&quot;>&lt;h:transactionID>&lt;xsl:value-of select=&quot;$InvokeIn/header/h:Header/h:transactionID&quot;/>&lt;/h:transactionID>&lt;/xsl:if>&lt;/tns:Header_Output>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
