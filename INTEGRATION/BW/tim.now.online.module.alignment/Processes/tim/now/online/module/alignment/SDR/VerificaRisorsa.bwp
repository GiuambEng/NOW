                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Response>&#xa;            &lt;tns:IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$ErrorResponse/tns:ResponseProcess/tns:IDRISORSA&quot;/>&#xa;            &lt;/tns:IDRISORSA>&#xa;            &lt;tns:ESITO>&#xa;                &lt;xsl:value-of select=&quot;$ErrorResponse/tns:ResponseProcess/tns:ESITO&quot;/>&#xa;            &lt;/tns:ESITO>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:ResponseProcess/tns:SERVIZIO&quot;>&#xa;                &lt;tns:SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:ResponseProcess/tns:SERVIZIO&quot;/>&#xa;                &lt;/tns:SERVIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:RETURN_CODE>&#xa;                &lt;xsl:value-of select=&quot;$ErrorResponse/tns:ResponseProcess/tns:RETURN_CODE&quot;/>&#xa;            &lt;/tns:RETURN_CODE>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:ResponseProcess/tns:DESC_ERRORE&quot;>&#xa;                &lt;tns:DESC_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:ResponseProcess/tns:DESC_ERRORE&quot;/>&#xa;                &lt;/tns:DESC_ERRORE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:Header_Output/h:sourceSystem&quot;>&#xa;                &lt;h:sourceSystem>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:sourceSystem&quot;/>&#xa;                &lt;/h:sourceSystem>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:interactionDate/h:Date&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:interactionDate/h:Time&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:Header_Output/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:Header_Output/h:messageID&quot;>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:messageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ErrorResponse/tns:Header_Output/h:transactionID&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorResponse/tns:Header_Output/h:transactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
