                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_SDR/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="RESPONSE"/&gt;&lt;xsl:template name="InvokeOut-input" match="/"&gt;&lt;tns:Response&gt;&lt;output&gt;&lt;tns1:Response&gt;&lt;tns1:IDRISORSA&gt;&lt;xsl:value-of select="$RESPONSE/tns1:ResponseProcess/tns1:IDRISORSA"/&gt;&lt;/tns1:IDRISORSA&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="$RESPONSE/tns1:ResponseProcess/tns1:ESITO"/&gt;&lt;/tns1:ESITO&gt;&lt;xsl:if test="$RESPONSE/tns1:ResponseProcess/tns1:SERVIZIO"&gt;&lt;tns1:SERVIZIO&gt;&lt;xsl:value-of select="$RESPONSE/tns1:ResponseProcess/tns1:SERVIZIO"/&gt;&lt;/tns1:SERVIZIO&gt;&lt;/xsl:if&gt;&lt;tns1:RETURN_CODE&gt;&lt;xsl:value-of select="$RESPONSE/tns1:ResponseProcess/tns1:RETURN_CODE"/&gt;&lt;/tns1:RETURN_CODE&gt;&lt;xsl:if test="$RESPONSE/tns1:ResponseProcess/tns1:DESC_ERRORE"&gt;&lt;tns1:DESC_ERRORE&gt;&lt;xsl:value-of select="$RESPONSE/tns1:ResponseProcess/tns1:DESC_ERRORE"/&gt;&lt;/tns1:DESC_ERRORE&gt;&lt;/xsl:if&gt;&lt;/tns1:Response&gt;&lt;/output&gt;&lt;header&gt;&lt;h:Header&gt;&lt;xsl:if test="$RESPONSE/tns1:Header_Output/h:sourceSystem"&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:sourceSystem"/&gt;&lt;/h:sourceSystem&gt;&lt;/xsl:if&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:interactionDate/h:Date"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:interactionDate/h:Time"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$RESPONSE/tns1:Header_Output/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$RESPONSE/tns1:Header_Output/h:messageID"&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:messageID"/&gt;&lt;/h:messageID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$RESPONSE/tns1:Header_Output/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$RESPONSE/tns1:Header_Output/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;tns1:IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$RESPONSE/tns1:ResponseProcess/tns1:IDRISORSA&quot;/>&#xa;            &lt;/tns1:IDRISORSA>&#xa;            &lt;tns1:ESITO>&#xa;                &lt;xsl:value-of select=&quot;$RESPONSE/tns1:ResponseProcess/tns1:ESITO&quot;/>&#xa;            &lt;/tns1:ESITO>&#xa;            &lt;xsl:if test=&quot;$RESPONSE/tns1:ResponseProcess/tns1:SERVIZIO&quot;>&#xa;                &lt;tns1:SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:ResponseProcess/tns1:SERVIZIO&quot;/>&#xa;                &lt;/tns1:SERVIZIO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:RETURN_CODE>&#xa;                &lt;xsl:value-of select=&quot;$RESPONSE/tns1:ResponseProcess/tns1:RETURN_CODE&quot;/>&#xa;            &lt;/tns1:RETURN_CODE>&#xa;            &lt;xsl:if test=&quot;$RESPONSE/tns1:ResponseProcess/tns1:DESC_ERRORE&quot;>&#xa;                &lt;tns1:DESC_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:ResponseProcess/tns1:DESC_ERRORE&quot;/>&#xa;                &lt;/tns1:DESC_ERRORE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_SDR_VerificaRisorsa&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;xsl:if test=&quot;$RESPONSE/tns1:Header_Output/h:sourceSystem&quot;>&#xa;                &lt;h:sourceSystem>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:Header_Output/h:sourceSystem&quot;/>&#xa;                &lt;/h:sourceSystem>&#xa;            &lt;/xsl:if>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:Header_Output/h:interactionDate/h:Date&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:Header_Output/h:interactionDate/h:Time&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$RESPONSE/tns1:Header_Output/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:Header_Output/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RESPONSE/tns1:Header_Output/h:messageID&quot;>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$RESPONSE/tns1:Header_Output/h:messageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;