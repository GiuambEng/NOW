                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($gestioneError.part1/ns15:ID_ESEC_PROCSO_NOFILE)>0]]></bpws:transitionCondition>
