                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_SDR/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="ProcessName"/&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:param name="ID_Procso_File"/&gt;&lt;xsl:param name="InsProcsNOFILE"/&gt;&lt;xsl:template name="gestioneError-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'VerificaRisorsa_SDR'"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:if test="$InsProcsNOFILE/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$InsProcsNOFILE/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessName)&gt;0"&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="$ProcessName"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ProcessName&gt;&lt;xsl:value-of select="''"/&gt;&lt;/ns:ProcessName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/input/tns1:Request/tns1:ID_RISORSA)&gt;0"&gt;&lt;ns:ID_Risorsa&gt;&lt;xsl:value-of select="$InvokeIn/input/tns1:Request/tns1:ID_RISORSA"/&gt;&lt;/ns:ID_Risorsa&gt;&lt;