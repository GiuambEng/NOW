                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SDR/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeIn.header&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:ResponseProcess>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeIn.input/tns:ID_RISORSA)>0&quot;>&#xa;                        &lt;tns:IDRISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeIn.input/tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:IDRISORSA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:IDRISORSA>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns:IDRISORSA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NO&amp;quot;&quot;/>&#xa;                &lt;/tns:ESITO>&#xa;                &lt;tns:RETURN_CODE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                &lt;/tns:RETURN_CODE>&#xa;                &lt;tns:DESC_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns:DESC_ERRORE>&#xa;            &lt;/tns:ResponseProcess>&#xa;            