                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='Hal_OlInCorso' or $InvokeIn.part1/ns8:ActivityName='Hal_RichDati' or $InvokeIn.part1/ns8:ActivityName= 'HalQuadratura']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToError_DBSS">
