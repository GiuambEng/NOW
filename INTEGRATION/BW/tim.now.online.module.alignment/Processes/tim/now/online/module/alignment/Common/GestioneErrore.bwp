                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns1="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="InvokeIn"/&gt;&lt;xsl:template name="ProcessID-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)&gt;0"&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ProcFile/&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:CorrelationID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(xsd:string($InvokeIn/part1/ns1:Input/ns1:CorrelationID))&gt;0"&gt;&lt;ns:Value&gt;&lt;xsl:value-of select="xsd:int($InvokeIn/part1/ns1:Input/ns1:CorrelationID)"/&gt;&lt;/ns:Value&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(xsd:string($InvokeIn/part1/ns1:Input/ns1:CorrelationID))&gt;0"&gt;&lt;ns:Mode&gt;&lt;xsl:value-of select="&amp;quot;CORRELATE&amp;quot;"/&gt;&lt;/ns:Mode&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/ns:CorrelationID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc)&gt;0 and contains($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc, '.')"&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(substring-before($InvokeIn/part1/ns1:Input/ns1:ID_Esec_Proc, &amp;quot;.&amp;quot;))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_F