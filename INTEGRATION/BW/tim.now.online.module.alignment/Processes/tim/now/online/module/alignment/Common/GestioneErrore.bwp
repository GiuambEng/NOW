                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (contains($InvokeIn.part1/ns8:ID_Esec_Proc, '.')) then xsd:integer(substring-before($InvokeIn.part1/ns8:ID_Esec_Proc,'.')) else $InvokeIn.part1/ns8:ID_Esec_Proc" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
