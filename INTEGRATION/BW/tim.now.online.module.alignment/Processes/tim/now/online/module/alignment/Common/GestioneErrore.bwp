                        subProcessName="tim.now.online.module.alignment.Common.Sub_SDRError_VerificaRisorsa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (contains($InvokeIn/part1/ns8:Input/ns8:ID_Esec_Proc, '.')) then xsd:integer(substring-before($InvokeIn/part1/ns8:Input/ns8:ID_Esec_Proc,'.')) else $InvokeIn/part1/ns8:Input/ns8:ID_Esec_Proc"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="ID_ESEC_start" name="SetIDFromStart"
