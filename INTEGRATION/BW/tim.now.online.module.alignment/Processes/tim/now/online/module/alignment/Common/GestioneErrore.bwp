            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&lt;xsl:template name=&quot;ErrorVerificaRisorsa-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;>&lt;ns:ActivityName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;/>&lt;/ns:ActivityName>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$InvokeIn/part1/ns:Input/ns:Error&quot;/>&lt;ns:ID_Esec_Proc>&lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&lt;/ns:ID_Esec_Proc>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;>&lt;ns:ProcessName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;/>&lt;/ns:ProcessName>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:JpubTransactionID&quot;>&lt;ns:JpubTransactionID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:JpubTransactionID&quot;/>&lt;/ns:JpubTransactionID>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;>&lt;ns:CorrelationID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;/>&lt;/ns:CorrelationID>&lt;/xsl:if>&lt;ns:ID_Esec_FromProcessID>&lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&lt;/ns:ID_Esec_FromProcessID>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ID_Risorsa&quot;>&lt;ns:ID_Risorsa>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ID_Risorsa&quot;/>&lt;/ns:ID_Risorsa>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ErrorVerificaRisorsa-input"
                    name="ErrorVerificaRisorsa"
                    tibex:xpdlId="ec0ff610-3009-4803-a40f-cfcae2e3dc06"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
