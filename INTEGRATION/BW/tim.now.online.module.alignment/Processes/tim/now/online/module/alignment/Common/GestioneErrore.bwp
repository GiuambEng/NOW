                                <tibex:expression
                                    expression="$InvokeIn/part1/ns8:Input/ns8:ActivityName='AllMassJPUB_JMS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='AllMassJPUB_JMS']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToErrorAllineamentoProgetto">
