                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorVerificaRisorsa-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:ActivityName&quot;>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$InvokeIn.part1/ns:Error&quot;/>&#xa;            &lt;ns:ID_Esec_Proc>&#xa;                &lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&#xa;            &lt;/ns:ID_Esec_Proc>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:ProcessName&quot;>&#xa;                &lt;ns:ProcessName>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:ProcessName&quot;/>&#xa;                &lt;/ns:ProcessName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:JpubTransactionID&quot;>&#xa;                &lt;ns:JpubTransactionID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:JpubTransactionID&quot;/>&#xa;                &lt;/ns:JpubTransactionID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:CorrelationID&quot;>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:CorrelationID&quot;/>&#xa;                &lt;/ns:CorrelationID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_Esec_FromProcessID>&#xa;                &lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&#xa;            &lt;/ns:ID_Esec_FromProcessID>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:ID_Risorsa&quot;>&#xa;                &lt;ns:ID_Risorsa>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:ID_Risorsa&quot;/>&#xa;                &lt;/ns:ID_Risorsa>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
