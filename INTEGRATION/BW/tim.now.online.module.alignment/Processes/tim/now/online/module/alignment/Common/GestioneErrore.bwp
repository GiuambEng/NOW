                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Output>&#xa;            &lt;ns:ErrorCode>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/ns:ErrorCode>&#xa;            &lt;ns:ErrorDesc>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/ns:ErrorDesc>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ID_ESEC_FromProcessID)>0&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NOFILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToReply"/>
                    <bpws:target linkName="GenericLogToReply"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&lt;xsl:template name=&quot;ErrorPortale-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;>&lt;ns:ActivityName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;/>&lt;/ns:ActivityName>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$InvokeIn/part1/ns:Input/ns:Error&quot;/>&lt;ns:ID_Esec_Proc>&lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&lt;/ns:ID_Esec_Proc>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;>&lt;ns:ProcessName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;/>&lt;/ns:ProcessName>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:JpubTransactionID&quot;>&lt;ns:JpubTransactionID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:JpubTransactionID&quot;/>&lt;/ns:JpubTransactionID>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;>&lt;ns:CorrelationID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;/>&lt;/ns:CorrelationID>&lt;/xsl:if>&lt;ns:ID_Esec_FromProcessID>&lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&lt;/ns:ID_Esec_FromProcessID>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ErrorPortale-input"
                    name="ErrorPortale"
                    tibex:xpdlId="c4dee0c8-e242-4a55-868d-ca5c46eccdd0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Assign1ToErrorPortale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ErrorPortaleToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorPortale-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:ActivityName&quot;>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$InvokeIn.part1/ns:Error&quot;/>&#xa;            &lt;ns:ID_Esec_Proc>&#xa;                &lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&#xa;            &lt;/ns:ID_Esec_Proc>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:ProcessName&quot;>&#xa;                &lt;ns:ProcessName>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:ProcessName&quot;/>&#xa;                &lt;/ns:ProcessName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:JpubTransactionID&quot;>&#xa;                &lt;ns:JpubTransactionID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:JpubTransactionID&quot;/>&#xa;                &lt;/ns:JpubTransactionID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/ns:CorrelationID&quot;>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:CorrelationID&quot;/>&#xa;                &lt;/ns:CorrelationID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_Esec_FromProcessID>&#xa;                &lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&#xa;            &lt;/ns:ID_Esec_FromProcessID>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
