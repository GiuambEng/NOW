                    tibex:xpdlId="07e235e1-5eac-493a-a337-1992bf88faa1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToErrorPortale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToErrorPortale">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InvokeIn/part1/ns8:Input/ns8:ActivityName='AperturaSegnalazioni' or $InvokeIn/part1/ns8:Input/ns8:ActivityName='CodiceProgetto' or $InvokeIn/part1/ns8:Input/ns8:ActivityName='SollecitoSegnalazione'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='AperturaSegnalazioni' or $InvokeIn.part1/ns8:ActivityName='CodiceProgetto' or $InvokeIn.part1/ns8:ActivityName='SollecitoSegnalazione']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToErrorJPUBAllineamentoMassivo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InvokeIn/part1/ns8:Input/ns8:ActivityName='AggiornamentoMassivoAnagrafiche' or $InvokeIn/part1/ns8:Input/ns8:ActivityName='InvioEsitiAnagrafiche'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='AggiornamentoMassivoAnagrafiche' or $InvokeIn.part1/ns8:ActivityName='InvioEsitiAnagrafiche']]></bpws:transitionCondition>
                        </bpws:source>
