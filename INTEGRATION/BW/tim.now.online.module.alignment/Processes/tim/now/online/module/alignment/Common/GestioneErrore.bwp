                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='ConsistenzaDBSS']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToCallProcess3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InvokeIn/part1/ns8:Input/ns8:ActivityName='AllineamentiRetail'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
