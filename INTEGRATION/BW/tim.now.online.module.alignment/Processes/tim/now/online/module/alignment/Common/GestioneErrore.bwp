                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$InvokeIn.part1/ns8:ActivityName='AllineamentoPatroclo']]></bpws:transitionCondition>
                        </bpws:source>
