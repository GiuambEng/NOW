                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SystemName&quot;/>&lt;xsl:param name=&quot;SourceDirectory&quot;/>&lt;xsl:param name=&quot;DestinationDirectory&quot;/>&lt;xsl:param name=&quot;MaxRowsExtraction&quot;/>&lt;xsl:param name=&quot;TipoProtocolloInvio&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;HOST&quot;/>&lt;xsl:param name=&quot;PORT&quot;/>&lt;xsl:param name=&quot;USERNAME&quot;/>&lt;xsl:param name=&quot;PASSWORD&quot;/>&lt;xsl:template name=&quot;CreaInviaFile-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;$SystemName&quot;/>&lt;/ns:SystemName>&lt;ns:SourceDirectory>&lt;xsl:value-of select=&quot;$SourceDirectory&quot;/>&lt;/ns:SourceDirectory>&lt;ns:DestinationDirectory>&lt;xsl:value-of select=&quot;$DestinationDirectory&quot;/>&lt;/ns:DestinationDirectory>&lt;ns:TypeOfProtocol>&lt;xsl:value-of select=&quot;$TipoProtocolloInvio&quot;/>&lt;/ns:TypeOfProtocol>&lt;ns:MaxRowEstraction>&lt;xsl:value-of select=&quot;$MaxRowsExtraction&quot;/>&lt;/ns:MaxRowEstraction>&lt;ns:LogInfo>&lt;ns:ApplicationName>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/ns:ApplicationName>&lt;ns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/ns:LoggerName>&lt;ns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/ns:LogLevel>&lt;/ns:LogInfo>&lt;ns:SFTP>&lt;ns:HOST>&lt;xsl:value-of select=&quot;$HOST&quot;/>&lt;/ns:HOST>&lt;ns:PORT>&lt;xsl:value-of select=&quot;$PORT&quot;/>&lt;/ns:PORT>&lt;ns:USERNAME>&lt;xsl:value-of select=&quot;$USERNAME&quot;/>&lt;/ns:USERNAME>&lt;ns:PASSOWRD>&lt;xsl:value-of select=&quot;$PASSWORD&quot;/>&lt;/ns:PASSOWRD>&lt;/ns:SFTP>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
