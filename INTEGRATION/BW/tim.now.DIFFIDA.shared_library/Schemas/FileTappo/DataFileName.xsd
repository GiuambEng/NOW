<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/DataFileName" xmlns:tns="http://www.example.org/DataFileName" elementFormDefault="qualified">
 <element name="String">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:String_Input">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="String_Input">
    	<complexType>
    		<sequence>
    			<element name="Date" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>