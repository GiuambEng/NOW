    			<element name="EstensioneTappo" type="string" minOccurs="0"></element>
    			<element name="FormatoDate" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="PictureDate" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="RadiceNome" type="string" maxOccurs="1" minOccurs="0"/>
