    			<element name="Figlio2" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="Figlio3" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="Figlio4" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="Figlio5" type="string" maxOccurs="1" minOccurs="0"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputFileTappo">
    	<complexType>
    		<sequence>

    			<element name="FullName" type="string" minOccurs="0"></element>
    			<element name="Esito" type="string" minOccurs="0"></element>
    			

    		</sequence>
    	</complexType>
    </element>
</schema>

