<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/FileTappoPadreDaElaborare" xmlns:tns="http://www.example.org/FileTappoPadreDaElaborare" elementFormDefault="qualified">
 <element name="InputFileTappoOK">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string"></element>
    			<element name="LogName" type="string"></element>
    			<element name="LogLevel" type="string"></element>
    			<element name="ApplicationName" type="string"></element>
