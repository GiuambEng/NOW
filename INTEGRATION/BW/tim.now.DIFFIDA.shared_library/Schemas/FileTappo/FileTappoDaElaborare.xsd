<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/FileTappoDaElaborare" xmlns:tns="http://www.example.org/FileTappoDaElaborare" elementFormDefault="qualified">


    <element name="InputFileTappoOK">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string"></element>
    			<element name="LogName" type="string"></element>
    			<element name="LogLevel" type="string"></element>
    			<element name="ApplicationName" type="string"></element>
    			<element name="PathFile" type="string" minOccurs="0"></element>
    			<element name="EstensioneTappo" type="string" minOccurs="0"></element>
    			<element name="EstensioneFile" type="string" minOccurs="0"></element>
    			<element name="FormatoDate" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="PictureDate" type="string" maxOccurs="1" minOccurs="0"/>
    			
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputFileTappo">
    	<complexType>
    		<sequence>

    			<element name="FullName" type="string" minOccurs="0"></element>
    			<element name="Esito" type="string" minOccurs="0"></element>
    			

    		</sequence>
    	</complexType>
    </element>
</schema>

