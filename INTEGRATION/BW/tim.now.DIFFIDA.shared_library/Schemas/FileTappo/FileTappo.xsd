<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/FileTappo" elementFormDefault="qualified" targetNamespace="http://www.example.org/FileTappo">

    <element name="InputFileTappo">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string"/>
    			<element name="LogName" type="string"/>
    			<element name="LogLevel" type="string"/>
    			<element name="ApplicationName" type="string"/>
    			<element minOccurs="0" name="ID_PROCSO_FILE" type="string"/>
    			<element minOccurs="0" name="ID_INTRFC" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Estensione" type="string"/>
    				<element minOccurs="0" name="Sistema" type="string"/>
    				<element minOccurs="0" name="Flusso" type="string"/>
                  <element minOccurs="0" name="PathError" type="string"/>
                  <element minOccurs="0" name="PathMovedTappo" type="string"/>
                   <element minOccurs="0" name="Flag_parent" type="boolean"/>
                   <element minOccurs="0" name="Flag_SFTP_Mode" type="boolean"/>
                    <element minOccurs="0" name="SFTPInputData">
                 		 <complexType>
                 			 <sequence>
                  				<element minOccurs="0" name="Host" type="string"/>
                  				<element minOccurs="0" name="Port" type="int"/>
                  				<element minOccurs="0" name="User" type="string"/>
                  				<element minOccurs="0" name="Password" type="string"/>
                  
                 			</sequence>
    					</complexType>
   					 </element>   
    		</sequence>
    	</complexType>
    </element>

    <element name="OutputFileTappo">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" name="FileName" type="string"/>
    			<element minOccurs="0" name="Size" type="string"/>
    			<element minOccurs="0" name="LastModified" type="string"/>
    			<element minOccurs="0" name="FullName" type="string"/>
    			<element maxOccurs="1" name="Esito">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK"/>
    						<enumeration value="KO"/>
    						<enumeration value="ERROR"/>
    					</restriction>
    				</simpleType>
    			</element>
    			<element minOccurs="0" name="DESCR_ERRORE" type="string"/>
    			<element minOccurs="0" name="PathFileTappo" type="string"/>
    		</sequence>
    	</complexType>
    </element>
      <element name="ErrorFileTappo">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" name="FileNameTappo" type="string"/>
    			<element minOccurs="0" name="FileNameFile" type="string"/>
    			<element minOccurs="0" name="FullNameTappo" type="string"/>
    			<element minOccurs="0" name="FullNameFile" type="string"/>
                <element minOccurs="0" name="PathError" type="string"/>
                <element name="LogName" type="string"/>
    			<element name="LogLevel" type="string"/>
    			<element name="ApplicationName" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
