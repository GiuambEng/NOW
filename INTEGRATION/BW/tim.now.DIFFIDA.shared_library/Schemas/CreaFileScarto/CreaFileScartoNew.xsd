<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/CreaFileScarto_New" 
xmlns:tns="http://www.example.org/CreaFileScarto_New" 
elementFormDefault="qualified">
<element name="Input_CreaFileRecordKO_New">
    	<complexType>
    		<sequence>
    			<element name="Subset" type="int"></element>
    			<element name="Id_File" type="string"></element>
    			<element name="PathFile" type="string"></element>
    			<element name="NomeFile" type="string"></element>
    			<element name="Application" type="string"></element>
    			<element name="LogName" type="string"></element>
    			<element name="LogLevel" type="string"></element>
    			<element name="TipoSeparatore" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="Posizionale"></enumeration>
    						<enumeration value="CampoSeparatore"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>