<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Crea_FileScarto" xmlns:tns="http://www.example.org/Crea_FileScarto" elementFormDefault="qualified">



    <element name="Crea_FileScarto">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:Row">
    			</element>
    			<element name="PathFile" type="string"></element>
    			<element name="NameFileScarto" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="Row">
    	<complexType>
    		<sequence>
    			<element minOccurs="0" maxOccurs="unbounded"
    				name="Column">
    				<complexType>
    					<sequence>
    						<element name="name" type="string"></element>
    						<element name="value" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>


    <element name="Input_dataFormat">
    	<complexType>
    	<sequence>
    		<element minOccurs="0" maxOccurs="unbounded"
    				name="Column">
    				<complexType>
    					<sequence>
    						
    						<element name="value" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    			</sequence>
    	</complexType>
    </element>

    <element name="Output_creafilescarto">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>