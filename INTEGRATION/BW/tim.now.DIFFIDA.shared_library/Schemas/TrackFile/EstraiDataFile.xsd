    		<sequence>
    			<element name="SISTEMA" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FLUSSO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="NOME_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="DATA_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_AGGIUNTIVO" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>