<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/InputTrackFile" xmlns:tns="http://www.example.org/InputTrackFile" elementFormDefault="qualified">
    <element name="Input">
		<complexType>
			<choice>
				<element name="INSERT">
					<complexType>
						<sequence>
							<element name="SISTEMA" type="string"
								minOccurs="0" />
							<element name="FLUSSO" type="string"
								minOccurs="0" />
							<element name="NOME_FILE" type="string"
								minOccurs="0" />
							<element name="DATA_FILE" type="string"
								minOccurs="0" />
							<element name="PATH_SORGENTE" type="string"
								minOccurs="0" />
							<element name="STATO" type="string"
								maxOccurs="1" minOccurs="0"/>
								<element name="DESCR_ERRORE" type="string"
								maxOccurs="1" minOccurs="0"/>
								<element name="FILE_SIZE" type="int" minOccurs="0"/>
								<element name="ID_FILE" type="int" minOccurs="0"/>
								<element name="ID_AGGIUNTIVO" type="string" minOccurs="0"/>
							<element name="FLAG_PARENT" type="boolean" minOccurs="0"/>
							<element name="PATH_FILEINNESCO" type="string" minOccurs="0"/>
							<element name="LogElement">
								<complexType>
									<sequence>
										<element name="LoggerName"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="LogLevel"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="FLAG_LAVORAZIONE"
								type="boolean" minOccurs="0" />
							<element name="FOLDER" type="string"
								minOccurs="0" />
							<element name="STATO" type="string"
								maxOccurs="1" minOccurs="0"/>
							<element name="DESCR_ERRORE" type="string"
								maxOccurs="1" minOccurs="0"/>
							<element name="NOME_FILE" type="string"
								maxOccurs="1" minOccurs="0"/>
								<element name="ID_TRACK" type="int"
								maxOccurs="1" minOccurs="0"/>
								<element name="NUM_RETRY" type="boolean"
								maxOccurs="1" minOccurs="0"/>
								<element name="ID_FILE" type="int" minOccurs="0"/>
								<element name="FOLDER_SCARTO" type="string" minOccurs="0"/>
							<element name="LogElement">
								<complexType>
									<sequence>
										<element name="LoggerName"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element name="LogLevel"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>

			</choice>
		</complexType>
	</element>
</schema>