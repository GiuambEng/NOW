<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Storicizzazione" xmlns:tns="http://www.example.org/Storicizzazione" elementFormDefault="qualified">
<element name="Storicizzazione_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="integer"></element>
    			<element maxOccurs="1" minOccurs="0" name="LogName" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="LogLevel" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="ID_TRACK" type="integer"></element>
    			<element maxOccurs="1" minOccurs="0" name="FILE_NAME" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="FolderDestinazioneError" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="NameProcedure" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="FullPathOrigine" type="string"></element>
    	   		</sequence>
    	</complexType>
    </element>  
    <element name="Storicizzazione">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:Storicizzazione_Input"/>
    		</sequence>
    	</complexType>
  </element>
</schema>