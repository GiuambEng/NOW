            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="9060bda6-5df7-44b6-a01f-b81d441e6790">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToCallProcess3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$JDBCQuery/lastSubset=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="JDBCQueryToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1ToCallProcess2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess2ToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
