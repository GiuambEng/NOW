                                    sqlStatement="SELECT CONTENUTO_RECD&#xd;&#xa;  FROM STAG_UNICARA_SLU&#xd;&#xa;  WHERE ID_FILE_PROCSTO_INPUT = ? AND (ID_STATO_ELAB_STAG = 3 OR ID_STATO_ELAB_STAG = 5)&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

