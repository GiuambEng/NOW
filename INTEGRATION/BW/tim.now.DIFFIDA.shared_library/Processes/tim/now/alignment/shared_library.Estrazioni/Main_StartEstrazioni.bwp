            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cfc470d0-b7e5-4fd6-ad5f-1c4cb235cefb+input&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindEstrazione-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;SISTEMA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:InputData/ns:SystemName)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:SystemName&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SISTEMA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FindEstrazione-input"
                    name="FindEstrazione"
                    outputVariable="FindEstrazione"
