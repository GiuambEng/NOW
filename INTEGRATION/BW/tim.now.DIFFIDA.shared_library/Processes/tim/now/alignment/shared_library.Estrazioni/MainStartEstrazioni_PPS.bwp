        <bpws:variable element="ns4:root" name="Mapper" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogStartExtract-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE" name="LogEnd-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:root" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns14:AccumulatedOutput"
            name="Accumulate" sca-bpel:internal="true"/>
