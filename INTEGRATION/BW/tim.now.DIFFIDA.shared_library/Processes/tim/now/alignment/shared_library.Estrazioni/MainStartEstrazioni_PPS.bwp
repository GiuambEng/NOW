    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.alignment.sharedlibrary.DataEstrazioni"/>
    <bpws:partnerLinks>
        <bpws:partnerLink name="Logger"
            partnerLinkType="ns5:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true" sca-bpel:reference="Logger" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceWire dynamic="false" inline="true"
                processConfigurationName=""
                processName="ProcessLogger.Logger" serviceName="ProcessLog"/>
        </bpws:partnerLink>
    </bpws:partnerLinks>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
