                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName='INCONTRA'&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.&amp;quot;), '.OK')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName='RAC'&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.csv&amp;quot;), '.ctr')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;ends-with($Start/ns:InputData/ns:NomeFile,&amp;quot;_NOW.csv&amp;quot;) and not($Start/ns:InputData/ns:SystemName='RAC')&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.csv&amp;quot;), '.tp')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, &amp;quot;.TXT.gz&amp;quot;)&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.gz&amp;quot;), '.OK')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:otherwise>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,$Start/ns:InputData/ns:NomeFile, '.OK')&quot;/>&lt;/fileName>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;textContent>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WriteFile-input" name="WriteFile"
                    outputVariable="WriteFile"
                    tibex:xpdlId="334fc691-d1cc-4508-8e3b-389450bad44b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToWriteFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WriteFileToSendSFTP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName='INCONTRA'&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.&amp;quot;), '.OK')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/ns:InputData/ns:SystemName='RAC'&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.csv&amp;quot;), '.ctr')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;ends-with($Start/ns:InputData/ns:NomeFile,&amp;quot;_NOW.csv&amp;quot;) and not($Start/ns:InputData/ns:SystemName='RAC')&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.csv&amp;quot;), '.tp')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:when test=&quot;contains($Start/ns:InputData/ns:NomeFile, &amp;quot;.TXT.gz&amp;quot;)&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,tib:substring-before-last($Start/ns:InputData/ns:NomeFile,&amp;quot;.gz&amp;quot;), '.OK')&quot;/>&lt;/fileName>&lt;/xsl:when>&lt;xsl:otherwise>&lt;fileName>&lt;xsl:value-of select=&quot;concat($Start/ns:InputData/ns:SourceDirectory ,$Start/ns:InputData/ns:NomeFile, '.OK')&quot;/>&lt;/fileName>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;textContent>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.write"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
