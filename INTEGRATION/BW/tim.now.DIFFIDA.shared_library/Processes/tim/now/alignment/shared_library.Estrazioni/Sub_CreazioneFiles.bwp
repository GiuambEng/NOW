                        <tibex:inputBinding
                            expression="concat($Start/ns0:InputData/ns0:SourceDirectory,$Start/ns0:InputData/ns0:NomeFile)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
