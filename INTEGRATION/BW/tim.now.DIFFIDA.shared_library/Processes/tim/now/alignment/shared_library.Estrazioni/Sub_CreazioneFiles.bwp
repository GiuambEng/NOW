                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FaultDetails1&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:ApplicationName&quot;/>&lt;/tns:Application>&lt;/xsl:if>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_CreazioneFiles'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Errore nella creazione file   ',  $Start/ns:InputData/ns:NomeFile, '    ',   ' ID_FILE= ', string($Start/ns:InputData/ns:IDFile), '      ',  tib:render-xml($FaultDetails1))&quot;/>&lt;/tns:Message>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LoggerName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/ns:InputData/ns:LogInfo/ns:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
