                        <bpws:source linkName="SetPathFileToRepeat">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($Start/ns0:InputData/ns0:NomeFile, &quot;TLC_&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains($Start/ns0:InputData/ns0:NomeFile, "TLC_")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
