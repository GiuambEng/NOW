                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($Start/ns0:PathFile, $Start/ns0:RadiceNome,'*',$Start/ns0:EstensioneTappo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
