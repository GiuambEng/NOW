    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="FindWorkableAlignToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IterateToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="FindWorkableAlignToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToFindWorkableAlign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="1dc42512-68a6-4bd9-a2dc-2021bf5a4815"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindWorkableAlign&quot;/>&lt;xsl:param name=&quot;AccumulateResult&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ChiusuraAllineamenti>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FindWorkableAlign/Record)>0&quot;>&lt;xsl:copy-of select=&quot;$AccumulateResult/tns:ChiusuraAllineamenti/tns:OutputData&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputData/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="c224f7e5-b6e4-443f-8eb9-136d4eefc756" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IterateToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindWorkableAlign&quot;/>&lt;xsl:param name=&quot;AccumulateResult&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ChiusuraAllineamenti>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FindWorkableAlign/Record)>0&quot;>&lt;xsl:copy-of select=&quot;$AccumulateResult/tns:ChiusuraAllineamenti/tns:OutputData&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OutputData/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5a12ef9e-0519-4f68-bfca-f595f0e60387+input&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindWorkableAlign-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;SISTEMA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:InputData/ns1:SISTEMA)&quot;>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:SISTEMA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SISTEMA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FindWorkableAlign-input"
                    name="FindWorkableAlign"
                    outputVariable="FindWorkableAlign"
                    tibex:xpdlId="5a12ef9e-0519-4f68-bfca-f595f0e60387" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToFindWorkableAlign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FindWorkableAlignToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($FindWorkableAlign/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($FindWorkableAlign/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FindWorkableAlignToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5a12ef9e-0519-4f68-bfca-f595f0e60387+input&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;FindWorkableAlign-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;SISTEMA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:InputData/ns1:SISTEMA)&quot;>&lt;xsl:value-of select=&quot;$Start/ns1:InputData/ns1:SISTEMA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SISTEMA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE, ID_ESEC_PROCSO_FILE, SISTEMA, FLUSSO, COD_PROCSO_FILE,&#xa;  DETAILS, RECORD_STG_OK, RECORD_STG_KO, RECORD_TRG_OK, RECORD_TRG_KO&#xa;  FROM STATO_ALLINEAMENTI&#xa;  WHERE STATO = 'OK' AND SISTEMA = ? AND FLAG_LETTURA IS NULL &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SISTEMA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_PROCSO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DETAILS"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="RECORD_STG_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="RECORD_STG_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="RECORD_TRG_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="RECORD_TRG_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="ba6cfb21-0644-4e21-b26c-970842c00745">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+4ab72c87-c1ad-4126-a41d-df80815d6ee0" version="2.0"> <xsl:template name="AccumulateResult" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateResult"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="idx" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$FindWorkableAlign/Record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($FindWorkableAlign/Record)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns3:Iterate_Current_Element_Record4"
                                    name="currentRecord" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCloseAlign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CloseAlignToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="CloseAlignToMapKO" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="JDBCUpdateToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CheckErrorToUpdKOLavorato" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdKOLavoratoToMapOK" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCUpdateToCloseAlign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcess1ToCheckError" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="f32b321a-0e30-4f6f-ba23-a667e5f61bff" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCloseAlign"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($FindWorkableAlign/Record)[number($idx)]]]></bpws:from>
                                    <bpws:to variable="currentRecord"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="AccumulateResult"
                                    outputVariable="AccumulateResult"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="4ab72c87-c1ad-4126-a41d-df80815d6ee0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapResult</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecord&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CloseAlign-input&quot; match=&quot;/&quot;>&lt;ns1:ChiusuraAllineamenti>&lt;ns1:InputData>&lt;ns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_FILE)&quot;/>&lt;/ns1:ID_FILE>&lt;ns1:ID_ESEC_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns1:ID_ESEC_FILE>&lt;xsl:if test=&quot;$currentRecord/SISTEMA&quot;>&lt;ns1:SISTEMA>&lt;xsl:value-of select=&quot;$currentRecord/SISTEMA&quot;/>&lt;/ns1:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentRecord/FLUSSO&quot;>&lt;ns1:FLUSSO>&lt;xsl:value-of select=&quot;$currentRecord/FLUSSO&quot;/>&lt;/ns1:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentRecord/COD_PROCSO_FILE&quot;>&lt;ns1:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$currentRecord/COD_PROCSO_FILE&quot;/>&lt;/ns1:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns1:RECORD_STG_OK>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_STG_OK)&quot;/>&lt;/ns1:RECORD_STG_OK>&lt;ns1:RECORD_STG_KO>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_STG_KO)&quot;/>&lt;/ns1:RECORD_STG_KO>&lt;ns1:RECORD_TRG_OK>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_TRG_OK)&quot;/>&lt;/ns1:RECORD_TRG_OK>&lt;ns1:RECORD_TRG_KO>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_TRG_KO)&quot;/>&lt;/ns1:RECORD_TRG_KO>&lt;xsl:if test=&quot;$currentRecord/DETAILS&quot;>&lt;ns1:DETTAGLI>&lt;xsl:value-of select=&quot;$currentRecord/DETAILS&quot;/>&lt;/ns1:DETTAGLI>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Start/ns1:InputData/ns1:LogInfo&quot;/>&lt;/ns1:InputData>&lt;/ns1:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CloseAlign-input"
                                    name="CloseAlign"
                                    outputVariable="CloseAlign"
                                    tibex:xpdlId="e688bbe6-d3b7-4954-bb15-58ceaccc0850"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToCloseAlign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CloseAlignToGroupEnd"/>
                                    <bpws:source
                                    linkName="CloseAlignToMapKO"
                                    tibex:faultDetailsVar="CloseAlign" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecord&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CloseAlign-input&quot; match=&quot;/&quot;>&lt;ns1:ChiusuraAllineamenti>&lt;ns1:InputData>&lt;ns1:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_FILE)&quot;/>&lt;/ns1:ID_FILE>&lt;ns1:ID_ESEC_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns1:ID_ESEC_FILE>&lt;xsl:if test=&quot;$currentRecord/SISTEMA&quot;>&lt;ns1:SISTEMA>&lt;xsl:value-of select=&quot;$currentRecord/SISTEMA&quot;/>&lt;/ns1:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentRecord/FLUSSO&quot;>&lt;ns1:FLUSSO>&lt;xsl:value-of select=&quot;$currentRecord/FLUSSO&quot;/>&lt;/ns1:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentRecord/COD_PROCSO_FILE&quot;>&lt;ns1:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$currentRecord/COD_PROCSO_FILE&quot;/>&lt;/ns1:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns1:RECORD_STG_OK>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_STG_OK)&quot;/>&lt;/ns1:RECORD_STG_OK>&lt;ns1:RECORD_STG_KO>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_STG_KO)&quot;/>&lt;/ns1:RECORD_STG_KO>&lt;ns1:RECORD_TRG_OK>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_TRG_OK)&quot;/>&lt;/ns1:RECORD_TRG_OK>&lt;ns1:RECORD_TRG_KO>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/RECORD_TRG_KO)&quot;/>&lt;/ns1:RECORD_TRG_KO>&lt;xsl:if test=&quot;$currentRecord/DETAILS&quot;>&lt;ns1:DETTAGLI>&lt;xsl:value-of select=&quot;$currentRecord/DETAILS&quot;/>&lt;/ns1:DETTAGLI>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$Start/ns1:InputData/ns1:LogInfo&quot;/>&lt;/ns1:InputData>&lt;/ns1:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.alignment.shared_library.ChiusuraAllineamenti.Sub_ChiusuraAllineamenti" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecord&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;MapResult-input&quot; match=&quot;/&quot;>&lt;tns:ChiusuraAllineamenti>&lt;tns:OutputData>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;xsl:if test=&quot;$currentRecord/SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$currentRecord/SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentRecord/FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$currentRecord/FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($currentRecord/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;$currentRecord/COD_PROCSO_FILE&quot;>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$currentRecord/COD_PROCSO_FILE&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;tns:Result>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error)&quot;>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Result>&lt;/tns:OutputData>&lt;/tns:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapResult-input"
                                    name="MapResult"
                                    outputVariable="MapResult"
                                    tibex:xpdlId="71af07ed-51ec-4fc6-9621-d7633c6e215b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CloseAlignToGroupEnd"/>
                                    <bpws:target linkName="UpdKOLavoratoToMapOK"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd"/>
                                    </bpws:sources>
