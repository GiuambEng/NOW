    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/InputTrackFile"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/GestioneMovedFile"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:InputFileTappo" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:Input" name="InputTrackFile"/>
        <bpws:variable element="ns0:InputFileTappo"
            name="FindFile_SFTP-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:OutputFileTappo"
            name="FindFile_SFTP" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:InputData" name="Moved-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:OutputData" name="Moved" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:Input" name="StartTrack-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToTrackFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="InputTrackSFTPToStartTrack" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="InputTrackSFTPToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MovedToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToStartTrack" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="2db30c87-3f54-4d9b-af98-eb43af9ed721"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess1">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="8c675c39-26a6-4c9c-94e6-8335254b3bf8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="FindFile_SFTP-input"
                    name="FindFile_SFTP" outputVariable="FindFile_SFTP"
                    tibex:xpdlId="01c9806f-06b9-4ede-aae8-8fbbd5311da2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToTrackFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Start&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.FindFile_SFTP_Mode" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="InputTrackFile"
                    name="InputTrackSFTP"
                    outputVariable="InputTrackFile"
                    tibex:xpdlId="12e2ae4a-7423-47a6-9475-c810e3899086" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToTrackFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InputTrackSFTPToStartTrack">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="InputTrackSFTPToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InputTrackFile/ns1:INSERT/ns1:STATO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InputTrackFile/ns1:INSERT/ns1:STATO='KO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile_SFTP&quot;/>&lt;xsl:template name=&quot;InputTrackFile&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$Start/tns1:Sistema&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$Start/tns1:Sistema&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile_SFTP/tns1:Esito='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;concat($Start/tns1:Flusso,&amp;quot; AND NO_FILE_FOUND&amp;quot;)&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:Flusso&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns1:Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindFile_SFTP/tns1:FileName&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns1:FileName&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile_SFTP/tns1:FullName&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns1:FullName&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') and $FindFile_SFTP/tns1:Esito='OK'&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns1:Esito&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Flusso, 'ERROR') &quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (contains($Start/tns1:Flusso,'ERROR_DATA_FILE'))  then&amp;#xD;&amp;#xA; concat(&amp;quot;***ERRORE: DATA NON VALIDA NEL NOME DEL FILE &amp;quot; , $FindFile_SFTP/tns1:FileName, &amp;quot; &amp;quot;, $FindFile_SFTP/tns1:DESCR_ERRORE)&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;else  concat(&amp;quot;***ERRORE: NAMING CONVENTION DEL FILE NON RISPETTATA  &amp;quot; , $FindFile_SFTP/tns1:FileName, &amp;quot; &amp;quot;, $FindFile_SFTP/tns1:DESCR_ERRORE)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$FindFile_SFTP/tns1:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns1:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($FindFile_SFTP/tns1:Size)>0&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;xsd:int($FindFile_SFTP/tns1:Size)&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:Flag_parent&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$Start/tns1:Flag_parent&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile_SFTP/tns1:PathFileTappo&quot;>&lt;tns:PATH_FILEINNESCO>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns1:PathFileTappo&quot;/>&lt;/tns:PATH_FILEINNESCO>&lt;/xsl:if>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="InputTrackFile" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StartTrack-input"
                    name="StartTrack"
                    tibex:xpdlId="e2ef4d9e-15a1-436c-9f28-2d5f73fc38e3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputTrackSFTPToStartTrack"/>
                        <bpws:target linkName="AssignToStartTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputTrackFile&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:copy-of select=&quot;$InputTrackFile/*&quot;/>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Moved-input"
                    name="Moved" outputVariable="Moved"
                    tibex:xpdlId="9a51411f-0390-4236-9a51-a6ffeceb4def"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputTrackSFTPToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MovedToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FindFile_SFTP&quot;/>&lt;xsl:template name=&quot;Moved-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$FindFile_SFTP/tns:FullName&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns:FullName&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:PathError&quot;>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$Start/tns:PathError&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$FindFile_SFTP/tns:FileName&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$FindFile_SFTP/tns:FileName&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;tns1:SFTP>&lt;xsl:if test=&quot;$Start/tns:SFTPInputData/tns:Host&quot;>&lt;tns1:Host>&lt;xsl:value-of select=&quot;$Start/tns:SFTPInputData/tns:Host&quot;/>&lt;/tns1:Host>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:SFTPInputData/tns:Port&quot;>&lt;tns1:Port>&lt;xsl:value-of select=&quot;$Start/tns:SFTPInputData/tns:Port&quot;/>&lt;/tns1:Port>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:SFTPInputData/tns:User&quot;>&lt;tns1:User>&lt;xsl:value-of select=&quot;$Start/tns:SFTPInputData/tns:User&quot;/>&lt;/tns1:User>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:SFTPInputData/tns:Password&quot;>&lt;tns1:Password>&lt;xsl:value-of select=&quot;$Start/tns:SFTPInputData/tns:Password&quot;/>&lt;/tns1:Password>&lt;/xsl:if>&lt;/tns1:SFTP>&lt;tns1:Log>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/tns1:Log>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.alignment.shared_library.ReadFile_SFTPMode.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="InputTrackFile"
                    name="InputTrackKO" outputVariable="InputTrackFile"
                    tibex:xpdlId="179ff92f-3b76-4195-9bc0-695a31a36ab8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MovedToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToStartTrack"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns2=&quot;http://www.example.org/GestioneMovedFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputTrackFile&quot;/>&lt;xsl:param name=&quot;Moved&quot;/>&lt;xsl:template name=&quot;InputTrackFile&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:INSERT>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:DATA_FILE&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:DATA_FILE&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Moved/tns2:FullPathMovedFile)>0&quot;>&lt;xsl:if test=&quot;$Moved/tns2:FullPathMovedFile&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$Moved/tns2:FullPathMovedFile&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:PATH_SORGENTE&quot;>&lt;tns:PATH_SORGENTE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:PATH_SORGENTE&quot;/>&lt;/tns:PATH_SORGENTE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:DESCR_ERRORE&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:DESCR_ERRORE&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:FILE_SIZE&quot;>&lt;tns:FILE_SIZE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:FILE_SIZE&quot;/>&lt;/tns:FILE_SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:ID_AGGIUNTIVO&quot;>&lt;tns:ID_AGGIUNTIVO>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:ID_AGGIUNTIVO&quot;/>&lt;/tns:ID_AGGIUNTIVO>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:FLAG_PARENT&quot;>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:FLAG_PARENT&quot;/>&lt;/tns:FLAG_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;$InputTrackFile/tns:INSERT/tns:PATH_FILEINNESCO&quot;>&lt;tns:PATH_FILEINNESCO>&lt;xsl:value-of select=&quot;$InputTrackFile/tns:INSERT/tns:PATH_FILEINNESCO&quot;/>&lt;/tns:PATH_FILEINNESCO>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$InputTrackFile/tns:INSERT/tns:LogElement&quot;/>&lt;/tns:INSERT>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="InputTrackFile" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
