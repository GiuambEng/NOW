                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:tns1=&quot;http://www.example.org/Storicizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MoveError-input&quot; match=&quot;/&quot;>&lt;tns:InputData>&lt;xsl:if test=&quot;$Start/tns1:FullPathOrigine&quot;>&lt;tns:FullPathOrigine>&lt;xsl:value-of select=&quot;$Start/tns1:FullPathOrigine&quot;/>&lt;/tns:FullPathOrigine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:FolderDestinazioneError&quot;>&lt;tns:FolderDestinazione>&lt;xsl:value-of select=&quot;$Start/tns1:FolderDestinazioneError&quot;/>&lt;/tns:FolderDestinazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:FILE_NAME&quot;>&lt;tns:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:FILE_NAME&quot;/>&lt;/tns:NomeFile>&lt;/xsl:if>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ID_TRACK)&quot;/>&lt;/tns:ID_TRACK>&lt;tns:LogInput>&lt;xsl:if test=&quot;$Start/tns1:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns1:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:LogName&quot;>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$Start/tns1:LogName&quot;/>&lt;/tns:LogName>&lt;/xsl:if>&lt;/tns:LogInput>&lt;/tns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
