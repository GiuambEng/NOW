                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="TrackKOToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length(string($Start/ns5:ID_FILE))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length(string($Start/ns5:ID_FILE))>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputTrackFile&quot; xmlns:tns1=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.example.org/Storicizzazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;TrackKO-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Update>&lt;tns:FLAG_LAVORAZIONE>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:FLAG_LAVORAZIONE>&lt;tns:STATO>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:STATO>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails,true(),true())&quot;/>&lt;/tns:DESCR_ERRORE>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($Start/tns2:ID_TRACK)&quot;/>&lt;/tns:ID_TRACK>&lt;tns:LogElement>&lt;xsl:if test=&quot;$Start/tns2:LogName&quot;>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns2:LogName&quot;/>&lt;/tns:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:LogLevel&quot;>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns2:LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/xsl:if>&lt;/tns:LogElement>&lt;/tns:Update>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
