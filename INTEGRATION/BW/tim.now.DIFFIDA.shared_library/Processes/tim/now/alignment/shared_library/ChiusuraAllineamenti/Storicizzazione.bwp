                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="ef9fb769-8a2e-4481-9346-581665bdafe7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToJDBCUpdate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToExit"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ef9fb769-8a2e-4481-9346-581665bdafe7+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.example.org/Storicizzazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/DESCR_ERRORE>&lt;STATO>&lt;xsl:value-of select=&quot;'KO-BW'&quot;/>&lt;/STATO>&lt;ID_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_FILE)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE APPUSER.STATO_ALLINEAMENTI&#xa;  SET DESCR_ERRORE = ?, STATO = ?&#xa;  WHERE ID_FILE = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                    </properties>
