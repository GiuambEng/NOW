                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if ($Start/tns:Sistema='CRMWS') then substring-before($Start/tns:FileName, '.ctr') else concat(substring-before($Start/tns:FileName, '.TAPPO'),&quot;.csv&quot;)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="NomeFile" name="RenameEstensione2"
                    outputVariable="NomeFile"
