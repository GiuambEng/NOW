            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/SFTPDirJavaCode/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/"/>
