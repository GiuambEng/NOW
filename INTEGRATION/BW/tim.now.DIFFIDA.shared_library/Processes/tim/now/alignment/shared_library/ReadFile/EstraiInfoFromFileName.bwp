            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="d569b819-1f39-4f59-a6c3-afbb3014c06c"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1_SISTEMAJIVE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:SISTEMA='JIVE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:SISTEMA='JIVE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1_SISTEMACRMWSandFLUSSOCAMBIOSLA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($Start/tns:NOME_FILE, 'SLA_JPUB')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
