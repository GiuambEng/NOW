                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerificaPresenzaTuttiFigli-input"
                    name="VerificaPresenzaTuttiFigli"
                    outputVariable="VerificaPresenzaTuttiFigli"
                    tibex:xpdlId="88ae4a31-8891-4046-abd8-b7903d3d4184" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
