                                    sqlStatement="SELECT COUNT(1)&#xa;FROM ALIGN_FILE_TRACKING &#xa;WHERE FLOW=?&#xa;AND &#xa;STATO in ('IN LAVORAZIONE' , 'LOADING', 'OK_STAGING') &#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
