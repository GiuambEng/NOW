            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+66392923-d0d2-4c61-9e59-9155bab7db12+input&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;VerificaFlusso-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_FLUSSO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_FLOW)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_FLOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FLUSSO>&lt;ID_FLOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_FLOW)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_FLOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FLOW>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerificaFlusso-input"
                    name="VerificaFlusso"
