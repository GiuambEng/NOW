                        </bpws:source>
                        <bpws:source linkName="VerificaPresenzaTuttiFigliToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaFlusso/Record[1]/NUM_RETRY>=$VerificaParentele/Record[1]/MAX_RETRY and count($VerificaPresenzaTuttiFigli/Record)&lt;$Start/tns:NUMERO_CORRELAZIONI" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaFlusso/Record[1]/NUM_RETRY>=$VerificaParentele/Record[1]/MAX_RETRY and count($VerificaPresenzaTuttiFigli/Record)<$Start/tns:NUMERO_CORRELAZIONI]]></bpws:transitionCondition>
                        </bpws:source>
