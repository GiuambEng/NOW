                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_TRACK, CORRELATION_KEY, NUM_RETRY, FLAG_REWORK, FOLDER, FILE_SIZE, DATA_FILE, FILE_NAME, SYSTEM, ID_AGGIUNTIVO, ID_FILE_INPUT&#xd;&#xa;FROM ALIGN_FILE_TRACKING AFT&#xd;&#xa;  JOIN (SELECT MIN(DATA_FILE) MIN_FILE FROM ALIGN_FILE_TRACKING WHERE ID_FLOW = ? AND ((FLAG_LAVORATO = 'N'  AND  STATO  in ('IN ATTESA', 'DA LAVORARE')) OR  FLAG_REWORK='Y') ) MIN_AFT ON AFT.DATA_FILE = MIN_AFT.MIN_FILE&#xd;&#xa;WHERE ID_FLOW = ? AND ((FLAG_LAVORATO = 'N'  AND  STATO  in ('IN ATTESA', 'DA LAVORARE')) OR  FLAG_REWORK='Y')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FLUSSO"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FLOW"/>
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CORRELATION_KEY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUM_RETRY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_REWORK"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FOLDER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FILE_SIZE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="FILE_NAME"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SYSTEM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_AGGIUNTIVO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE_INPUT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
