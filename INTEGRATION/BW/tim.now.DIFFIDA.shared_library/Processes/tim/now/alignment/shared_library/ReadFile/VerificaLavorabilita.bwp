                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($VerificaFlusso/Record[1]/NUM_RETRY&lt;$VerificaParentele/Record[1]/MAX_RETRY or string-length(string($VerificaFlusso/Record[1]/NUM_RETRY))=0) and count($VerificaPresenzaTuttiFigli/Record)&lt;$Start/tns:NUMERO_CORRELAZIONI" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
