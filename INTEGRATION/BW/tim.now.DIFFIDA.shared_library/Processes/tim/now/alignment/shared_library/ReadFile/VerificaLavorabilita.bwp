                    tibex:xpdlId="66392923-d0d2-4c61-9e59-9155bab7db12" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VerificaFlussoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaFlusso/Record[1]/FLAG_REWORK='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaFlusso/Record[1]/FLAG_REWORK='Y']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($VerificaFlusso/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($VerificaFlusso/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaFlussoToSetWait">
                            <tibex:DesignExpression>
