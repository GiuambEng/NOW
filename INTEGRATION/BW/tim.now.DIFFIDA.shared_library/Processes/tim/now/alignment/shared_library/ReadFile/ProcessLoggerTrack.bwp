                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssign_INSERT">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:NOME_FILE)>0 or string-length($Start/ns2:DataIn/ns2:Insert/ns2:OutputFile/ns2:NOME_FILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:NOME_FILE)>0 or string-length($Start/ns2:DataIn/ns2:Insert/ns2:OutputFile/ns2:NOME_FILE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToGetID_ESEC">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))>0 or string-length(string($Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE))>0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))>0 or string-length(string($Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE))>0 ]]></bpws:transitionCondition>
                        </bpws:source>
