            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Input_ProcessLogger"
                    name="UpdateInput"
                    outputVariable="Input_ProcessLogger"
                    tibex:xpdlId="74d27ece-287f-4909-9adb-29f845ebf59c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToUpdateInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateInputToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetID_ESEC&quot;/>&lt;xsl:template name=&quot;Input_ProcessLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:FileProcessato>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:DESCR_STATO_FILE&quot;>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:DESCR_STATO_FILE&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ESITO&quot;>&lt;ns:ESITO>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ESITO&quot;/>&lt;/ns:ESITO>&lt;/xsl:if>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_CHIUSURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;'INPUT'&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:DESCR_STATO_FILE=&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;>&lt;ns:ID_CAUS_SCARTO>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ns:ID_CAUS_SCARTO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:DESCR_STATO_FILE=&amp;quot;CHIUSO&amp;quot; and $Start/tns:DataIn/tns:Update/tns:InputFile/tns:ESITO='KO'&quot;>&lt;ns:ID_CAUS_SCARTO>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/ns:ID_CAUS_SCARTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ID_FILE&quot;>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_KO))>0 and string-length(string($Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_TOTALI))=0&quot;>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_KO&quot;>&lt;ns:QT_RECD_KO>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_KO&quot;/>&lt;/ns:QT_RECD_KO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_OK))>0 and string-length(string($Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_TOTALI))=0&quot;>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_OK&quot;>&lt;ns:QT_RECD_OK>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:RECORD_OK&quot;/>&lt;/ns:QT_RECD_OK>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:STATO_ESEC&quot;>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;$Start/tns:DataIn/tns:Update/tns:InputFile/tns:STATO_ESEC&quot;/>&lt;/ns:STATO_ESEC>&lt;/xsl:if>&lt;ns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_FINE_ELAB>&lt;/ns:EsecuzioneFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Input_ProcessLogger" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdateLogger-input"
                name="UpdateLogger" operation="Insert"
                outputVariable="UpdateLogger" partnerLink="Logger"
                portType="ns4:ProcessLog" tibex:xpdlId="96db30e2-e214-4d7d-9298-874795bee973">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Input_ProcessLogger"/&gt;&lt;xsl:template name="UpdateLogger-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;xsl:copy-of select="$Input_ProcessLogger"/&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Input_ProcessLogger&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToUpdateLogger"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateLoggerToUpdateLog">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="UpdateLoggerToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_OK))>0 or string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_KO))>0 ) and  string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_TOTALI))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_OK))>0 or string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_KO))>0 ) and  string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:RECORD_TOTALI))>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="UpdateLog-input"
                name="UpdateLog" operation="Insert"
                outputVariable="UpdateLog" partnerLink="Logger"
                portType="ns4:ProcessLog" tibex:xpdlId="f2fb4d52-a4c4-425c-b74e-74771e058c3c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns2="http://www.example.org/CreateFileID" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="GetID_ESEC"/&gt;&lt;xsl:template name="UpdateLog-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;LOG&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))&gt;0"&gt;&lt;xsl:if test="$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))&gt;0"&gt;&lt;xsl:if test="$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;http://www.example.org/CreateFileID&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;GetID_ESEC&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($GetID_ESEC/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE&quot;>&#xa;                            &lt;ns:ID_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE&quot;/>&#xa;                            &lt;/ns:ID_FILE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE&quot;>&#xa;                            &lt;ns:ID_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:ID_FILE&quot;/>&#xa;                            &lt;/ns:ID_FILE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:ID_FILE))>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:LOG_MESSAGE&quot;>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:DataIn/ns2:Update/ns2:InputFile/ns2:LOG_MESSAGE&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:LOG_MESSAGE&quot;>&#xa;                            &lt;ns:LOG_MESSAGE>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:DataIn/ns2:Update/ns2:OutputFile/ns2:LOG_MESSAGE&quot;/>&#xa;                            &lt;/ns:LOG_MESSAGE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
