            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ID_PROCSTO"
                    name="SetIDPROCSTO" outputVariable="ID_PROCSTO"
                    tibex:xpdlId="58d3214f-e8ae-409e-8d9d-6895547f101a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FindIDToAssign2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToInputFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:NOME_FILE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:NOME_FILE)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToOutputFile">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="xsd:integer($FindID/Record[1]/ID_PROCSO_FILE)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ID_PROCSTO" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInsLogger-input"
                    name="LogInsLogger"
                    tibex:xpdlId="d615a403-d562-4449-bdf7-3fc91b771829"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InputFileToCallProcess"/>
                        <bpws:target linkName="OutputFileToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToProcessLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInsLogger-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&lt;/tns1:Application>&lt;tns1:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Input_ProcessLogger)&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogUpdLogger-input"
                    name="LogUpdLogger"
                    tibex:xpdlId="a21fa22a-3047-469e-acde-8467b1fcaad0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateInputToCallProcess"/>
                        <bpws:target linkName="UpdateOutputToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToUpdateLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&lt;xsl:template name=&quot;LogUpdLogger-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&lt;/tns1:Application>&lt;tns1:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Input_ProcessLogger)&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogElement/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpdCounter-input"
                name="UpdCounter" operation="Insert"
                outputVariable="UpdCounter" partnerLink="Logger"
                portType="ns4:ProcessLog" tibex:xpdlId="ba0d0674-2765-431f-af98-e141525da766">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="UpdCounter-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:ID_FILE"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:ID_FILE"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdCounter-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_KO&quot;>&#xa;                    &lt;ns:QT_RECD_KO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_KO&quot;/>&#xa;                    &lt;/ns:QT_RECD_KO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_OK&quot;>&#xa;                    &lt;ns:QT_RECD_OK>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_OK&quot;/>&#xa;                    &lt;/ns:QT_RECD_OK>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_TOTALI&quot;>&#xa;                    &lt;ns:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:DataIn/tns1:Update/tns1:InputFile/tns1:RECORD_TOTALI&quot;/>&#xa;                    &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="UpdateLoggerToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToUpdateLog"/>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
