&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="ProcessLogger"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="LogInsert-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;LOG&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato/&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Start/tns1:DataIn/tns1:Insert/tns1:InputFile/tns1:NOME_FILE)&gt;0"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="'INIZIO LAVORAZIONE FILE INPUT'"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="'CREATO FILE OUTPUT DA INVIARE'"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato/>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:DataIn/tns1:Insert/tns1:InputFile/tns1:NOME_FILE)>0&quot;>&#xa;                        &lt;ns:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;'INIZIO LAVORAZIONE FILE INPUT'&quot;/>&#xa;                        &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;'CREATO FILE OUTPUT DA INVIARE'&quot;/>&#xa;                        &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ProcessLoggerToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogInsertToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:ID_TRACK))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($Start/ns2:DataIn/ns2:Insert/ns2:InputFile/ns2:ID_TRACK))>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="LogInsertToTrackIDFileOUT">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($Start/ns2:DataIn/ns2:Insert/ns2:OutputFile/ns2:ID_TRACK))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($Start/ns2:DataIn/ns2:Insert/ns2:OutputFile/ns2:ID_TRACK))>0]]></bpws:transitionCondition>
