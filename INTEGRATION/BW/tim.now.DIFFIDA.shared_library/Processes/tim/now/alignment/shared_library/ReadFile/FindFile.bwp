    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="FileToFileCSV" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToLogListFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogListFileToRemoveFile" tibex:linkType="SUCCESS"/>
