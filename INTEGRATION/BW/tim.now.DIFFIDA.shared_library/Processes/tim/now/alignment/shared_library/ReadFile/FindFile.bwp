                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat(substring-before($Start/tns:FileName, '.'), $Start/tns:Estensione)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="NomeFile" name="RenameEstensione2"
                    outputVariable="NomeFile"
                    tibex:xpdlId="65146542-6e43-4801-bb1e-c9643bcd7c0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FileToFileCSV"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
