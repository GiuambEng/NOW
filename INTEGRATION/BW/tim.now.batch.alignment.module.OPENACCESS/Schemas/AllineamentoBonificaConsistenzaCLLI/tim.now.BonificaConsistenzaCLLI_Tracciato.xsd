<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.example.org/tim.now.BonificaConsistenzaCLLI_Tracciato" 
xmlns:tns="http://www.example.org/tim.now.BonificaConsistenzaCLLI_Tracciato" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="BonificaConsistenzaCLLI">
		<complexType>
			<sequence>
				<element ref="tns:BonificaConsistenzaCLLI_dettaglio" maxOccurs="unbounded" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="BonificaConsistenzaCLLI_dettaglio">
		<complexType>
			<sequence>			
				<element name="ID_RISORSA" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CLLI" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="CLLI_OLD" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="Flag_Validita" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>