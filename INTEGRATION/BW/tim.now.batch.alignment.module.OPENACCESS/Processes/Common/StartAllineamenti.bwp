                                    <bpws:source linkName="VerificaLavorabilitaToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaLavorabilita/tns:STATO=('WAIT','NOFOUND')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
