                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;GetFlowRetail&quot;/>&lt;xsl:template name=&quot;VerificaLavorabilita-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:if test=&quot;$GetFlowRetail/Record[number($index)]/FLOW&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$GetFlowRetail/Record[number($index)]/FLOW&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;tns:ID_FLOW>&lt;xsl:value-of select=&quot;xsd:int($GetFlowRetail/Record[number($index)]/ID_FLOW)&quot;/>&lt;/tns:ID_FLOW>&lt;tns:FLAG_PARENT>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:FLAG_PARENT>&lt;tns:LogElement>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;/tns:LogElement>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VerificaLavorabilita-input"
                                    name="VerificaLavorabilita"
                                    outputVariable="VerificaLavorabilita"
                                    tibex:xpdlId="b0baf701-a64d-4745-a308-a25d7bb5f5a9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
