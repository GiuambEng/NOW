                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:ns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tns1=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;GetFlowRetail&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:contaRecord_Input>&#xa;            &lt;ns1:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&#xa;            &lt;/ns1:in>&#xa;            &lt;ns1:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;'ContaRecord_PipeCancelletto'&quot;/>&#xa;            &lt;/ns1:TipoSeparatore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$GetFlowRetail/Record[number($index)]/ID_FLOW=75&quot;>&#xa;                    &lt;ns1:Flusso>&#xa;                        &lt;xsl:value-of select=&quot;'Aggiornamento Cluster Comuni'&quot;/>&#xa;                    &lt;/ns1:Flusso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:Flusso>&#xa;                        &lt;xsl:value-of select=&quot;'Bonifica Consistenza CLLI'&quot;/>&#xa;                    &lt;/ns1:Flusso>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:ID_FILE&quot;>&#xa;                &lt;ns1:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:ID_FILE&quot;/>&#xa;                &lt;/ns1:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;>&#xa;                &lt;ns1:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:SOURCE_FILE&quot;/>&#xa;                &lt;/ns1:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;>&#xa;                &lt;ns1:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:NOME_FILE&quot;/>&#xa;                &lt;/ns1:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:ID_ESEC&quot;>&#xa;                &lt;ns1:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:ID_ESEC&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns1:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns1:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns1:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns1:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&#xa;                &lt;ns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&#xa;                &lt;/ns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$GetFlowRetail/Record[number($index)]/ID_FLOW=75&quot;>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'aggiornamentoAnagraficaClusterComuni.OPENACCESS'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns1:NomeProcesso>&#xa;                        &lt;xsl:value-of select=&quot;'allineamentoBonificaCLLI.OPENACCESS'&quot;/>&#xa;                    &lt;/ns1:NomeProcesso>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns1:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="InsertLoggerToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    </bpws:sources>
                                </bpws:invoke>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="90b25f57-03ba-474d-97a8-3ee89192e463">
                <bpws:targets>
                    <bpws:target linkName="ForEachToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
