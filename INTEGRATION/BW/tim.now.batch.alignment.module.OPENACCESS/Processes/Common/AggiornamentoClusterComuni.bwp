                        <bpws:target linkName="InsValueTabToJDBCCallProcedure"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="BonificaCLLIToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ae31d794-116b-4099-a89d-c3255416cc71+input&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;AggiornamentoClusterComuni-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:inputs>&#xa;            &lt;inputSet>&#xa;                &lt;PROCEDURE_NAME>&#xa;                    &lt;xsl:value-of select=&quot;'PKG_ALL_CLSTR_COMUNE.Allinea_ANAG_CLUSTER_COMUNI'&quot;/>&#xa;                &lt;/PROCEDURE_NAME>&#xa;                &lt;IDFILE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/IDFILE>&#xa;            &lt;/inputSet>&#xa;        &lt;/tns4:inputs>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCCallProcedure"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCCallProcedureActivity"/>
                                    <value catalogOrPackage="PKG_JOBS"
                                    procedureOrFunctionName="CREATE_JOB(2)"
                                    schema="APPUSER"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:JDBCCallProcedureActivity">
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="PROCEDURE_NAME" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="2"
                                    DataTypeDisplayValue="NUMBER"
                                    ParameterName="IDFILE" ProcedureParamterType="1"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogFine-input"
                    name="LogFine"
                    tibex:xpdlId="1f462a3f-102c-440e-81dd-4087513f7dff"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
