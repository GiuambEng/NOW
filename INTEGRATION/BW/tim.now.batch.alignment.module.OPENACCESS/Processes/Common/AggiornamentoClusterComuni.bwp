                                    <tibex:expression
                                    expression="(($index = ((($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div ($Passo)) + 1)) and ((count($DetailUltimiNoval/Rows/tns1:AggiornamentoClusterComuni_dettaglio)) = 0))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index = ((($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div ($Passo)) + 1)) and ((count($DetailUltimiNoval/Rows/tns1:AggiornamentoClusterComuni_dettaglio)) = 0))]]></bpws:transitionCondition>
