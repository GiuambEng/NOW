                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;PathError&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;GestioneMovedFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:InputData>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&#xa;                &lt;tns4:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&#xa;                &lt;/tns4:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$PathError&quot;/>&#xa;            &lt;/tns4:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&#xa;                &lt;tns4:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&#xa;                &lt;/tns4:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:ID_TRACK>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;            &lt;/tns4:ID_TRACK>&#xa;            &lt;tns4:LogInput>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LogName>&#xa;            &lt;/tns4:LogInput>&#xa;        &lt;/tns4:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:empty name="Empty1" tibex:xpdlId="f733b8ba-a9a2-4658-89c5-7d9207f1cadf">
                            <bpws:targets>
                                <bpws:target linkName="JDBCUpdateToEmpty1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="Empty1ToGestioneMovedFile"/>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="TrackFile-input"
                                name="TrackFile"
                                tibex:xpdlId="f8e1a1d0-a08f-42c3-9c2b-5f1229984f98"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GestioneMovedFileToTrackFile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="TrackFileToProcessLoggerTrack1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:Update>&#xa;                &lt;tns4:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FLAG_LAVORAZIONE>&#xa;                &lt;tns4:STATO>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns4:STATO>&#xa;                &lt;tns4:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;concat('***KO TECNICO ***          ' , tib:render-xml($FaultDetails, true(), true()))&quot;/>&#xa;                &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;tns4:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;                &lt;/tns4:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length(xsd:string($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE))>0&quot;>&#xa;                    &lt;tns4:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                    &lt;/tns4:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:LogElement>&#xa;                    &lt;tns4:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/tns4:LoggerName>&#xa;                    &lt;tns4:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns4:LogLevel>&#xa;                &lt;/tns4:LogElement>&#xa;            &lt;/tns4:Update>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="ProcessLoggerTrack1-input"
                                name="ProcessLoggerTrack1"
                                outputVariable="ProcessLoggerTrack1"
                                tibex:xpdlId="9f825ca7-90cb-4704-8bfb-3fa312e061b0"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="TrackFileToProcessLoggerTrack1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ProcessLoggerTrack1ToExit2"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLoggerTrack1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:DataIn>&#xa;                &lt;tns4:Update>&#xa;                    &lt;tns4:InputFile>&#xa;                        &lt;tns4:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                        &lt;/tns4:ID_FILE>&#xa;                        &lt;tns4:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;'PROCESSO ESEGUITO CON ERRORE'&quot;/>&#xa;                        &lt;/tns4:STATO_ESEC>&#xa;                        &lt;tns4:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns4:ESITO>&#xa;                        &lt;tns4:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                        &lt;/tns4:DESCR_STATO_FILE>&#xa;                        &lt;tns4:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT CORROTTO&amp;quot;&quot;/>&#xa;                        &lt;/tns4:LOG_MESSAGE>&#xa;                    &lt;/tns4:InputFile>&#xa;                &lt;/tns4:Update>&#xa;            &lt;/tns4:DataIn>&#xa;            &lt;tns4:LogElement>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;            &lt;/tns4:LogElement>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit2" tibex:xpdlId="98b02315-d434-4baf-8bb2-e5891d25b577">
                            <bpws:targets>
                                <bpws:target linkName="ProcessLoggerTrack1ToExit2"/>
                            </bpws:targets>
                        </bpws:exit>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="JMSReceiveMessageToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="Output_Log_counterToThrow" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Output_Log_counterToLogger" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="UpCountToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapDetailsToInsValueTab" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsValueTabToJDBCCallProcedure" tibex:linkType="SUCCESS"/>
                <bpws:link name="BonificaCLLIToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogFineToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="Output_Log_counterToGenericLogger" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Log_KO_CounterToGestioneMovedFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="MovedFileToTrackFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="TrackKOFunzToProcessLoggerTrack" tibex:linkType="SUCCESS"/>
                <bpws:link name="ProcessLoggerTrackToExit1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="JMSReceiveMessage"
                    tibex:xpdlId="060dac26-83c8-444a-ab6e-1d50b715c96a"
                    variable="JMSReceiveMessage" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="JMSReceiveMessageToGenericLogger"/>
                    </bpws:sources>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.jms.receive"
                            version="6.0.0.20132205"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jms="http://ns.tibco.com/bw/palette/jms"
                            xmlns:www.tim.now.contarecord_jms.response="www.tim.now.contarecord_jms.response" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="destinationName" processProperty="queue_aggiornamentoClusterComuni"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jms#//JMSReceiverEventSource"/>
                                    <value
                                    bodyTypeQName="www.tim.now.contarecord_jms.response:queueResponse"
                                    connectionReference="jmsConnection"
                                    maxSessions="1"
                                    messageType="XML Text"
                                    messagingStyle="Queue"
                                    receiveTimeout="2" xsi:type="jms:JMSReceiverEventSource"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Output_Log_counter-input"
                    name="Output_Log_counter"
                    tibex:xpdlId="e7631c34-4e22-42ab-87d7-b6087a877b22"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Output_Log_counterToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord=0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Output_Log_counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoBonificaConsistenzaCLLI'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($JMSReceiveMessage/Body/ns:queueResponse, true(), true())&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns0:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="83207a09-507a-4889-9914-00ae8d6c1ad4">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:DefaultFault>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:descrErrore&quot;>&#xa;                &lt;message>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:descrErrore&quot;/>&#xa;                &lt;/message>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:invoke inputVariable="UpCount-input" name="UpCount"
                operation="Insert" outputVariable="UpCount"
                partnerLink="Logger" portType="ns3:ProcessLog" tibex:xpdlId="9c271e51-7ab2-48cf-ad22-1d32083b325f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="www.tim.now.contarecord_jms.response" version="2.0"&gt;
    &lt;xsl:param name="JMSReceiveMessage"/&gt;
    &lt;xsl:template name="UpCount-input" match="/"&gt;
        &lt;tns4:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns3:Input&gt;
                    &lt;ns3:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="'FILE'"/&gt;
                    &lt;/ns3:TipologiaProcesso&gt;
                    &lt;ns3:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="'COUNTER'"/&gt;
                    &lt;/ns3:TipologiaOperazione&gt;
                    &lt;ns3:FileProcessatoInput&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"&gt;
                            &lt;ns3:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"/&gt;
                            &lt;/ns3:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"&gt;
                            &lt;ns3:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"/&gt;
                            &lt;/ns3:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns3:FileProcessatoInput&gt;
                &lt;/ns3:Input&gt;
            &lt;/part1&gt;
        &lt;/tns4:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns3:TipologiaProcesso>&#xa;            &lt;ns3:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'COUNTER'&quot;/>&#xa;            &lt;/ns3:TipologiaOperazione>&#xa;            &lt;ns3:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                    &lt;ns3:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns3:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                    &lt;ns3:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                    &lt;/ns3:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns3:FileProcessatoInput>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToLogger"/>
