                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="InsertStag-input"
                                    name="InsertStag"
                                    outputVariable="InsertStag"
                                    tibex:xpdlId="2ddf0f90-ac3d-4049-ac72-944e6e97a916" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InputStagingToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InsertStagToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2ddf0f90-ac3d-4049-ac72-944e6e97a916+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.AggiornamentoClusterComuni_Staging&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStag&quot;/>&lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStag/tns2:AggiornamentoClusterComuni_dettaglio&quot;>&lt;Record>&lt;COD_ISTAT_COMUNE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:CODICE_ISTAT_COMUNE)&quot;>&lt;xsl:value-of select=&quot;tns2:CODICE_ISTAT_COMUNE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ISTAT_COMUNE>&lt;CODICEPRICING>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:CODICE_PRICING)&quot;>&lt;xsl:value-of select=&quot;tns2:CODICE_PRICING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICEPRICING>&lt;TPLG_CLUSTER_COMUNE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:TIPOLOGIA_CLUSTER_COMUNE)&quot;>&lt;xsl:value-of select=&quot;tns2:TIPOLOGIA_CLUSTER_COMUNE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TPLG_CLUSTER_COMUNE>&lt;DATA_INIZIO_VAL>&lt;xsl:value-of select=&quot;tib:parse-date('ddMMyyyy', tns2:DATA_INIZIO_VALIDITA)&quot;/>&lt;/DATA_INIZIO_VAL>&lt;DATA_FINE_VAL>&lt;xsl:value-of select=&quot;tib:parse-date('ddMMyyyy', tns2:DATA_FINE_VALIDITA)&quot;/>&lt;/DATA_FINE_VAL>&lt;CONTENUTO_RECORD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;tns2:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECORD>&lt;DESCRIZIONE_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns2:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCRIZIONE_ERRORE>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:int(tns2:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:int(tns2:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;NUMERO_RECORD>&lt;xsl:value-of select=&quot;xsd:int(tns2:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECORD>&lt;TIMESTAMP_INS>&lt;xsl:value-of select=&quot;xsd:dateTime(tns2:TMSP_INSMTO)&quot;/>&lt;/TIMESTAMP_INS>&lt;DESCRIZIONECOMUNE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:DESCRIZIONE_COMUNE)&quot;>&lt;xsl:value-of select=&quot;tns2:DESCRIZIONE_COMUNE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCRIZIONECOMUNE>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:OFFERTA)&quot;>&lt;xsl:value-of select=&quot;tns2:OFFERTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;DATAINIZIOMARCAGGIOPREGRESSO>&lt;xsl:value-of select=&quot;tib:parse-date('ddMMyyyy', tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO)&quot;/>&lt;/DATAINIZIOMARCAGGIOPREGRESSO>&lt;DATAINIZIOLIBERALIZZAZIONE>&lt;xsl:value-of select=&quot;tib:parse-date('ddMMyyyy', tns2:DATA_INIZIO_LIBERALIZZAZIONE)&quot;/>&lt;/DATAINIZIOLIBERALIZZAZIONE>&lt;DATAFINELIBERALIZZAZIONE>&lt;xsl:value-of select=&quot;tib:parse-date('ddMMyyyy', tns2:DATA_FINE_LIBERALIZZAZIONE)&quot;/>&lt;/DATAFINELIBERALIZZAZIONE>&lt;VERSIONING>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns2:VERSIONING)&quot;>&lt;xsl:value-of select=&quot;tns2:VERSIONING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VERSIONING>&lt;/Record>&lt;/xsl:for-each>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_CLUSTER_COMUNE_FILE (COD_ISTAT_COMUNE, CODICEPRICING, TPLG_CLUSTER_COMUNE, DATA_INIZIO_VAL, DATA_FINE_VAL, CONTENUTO_RECORD, DESCRIZIONE_ERRORE, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NUMERO_RECORD, TIMESTAMP_INS, DESCRIZIONECOMUNE, OFFERTA, DATAINIZIOMARCAGGIOPREGRESSO, DATAINIZIOLIBERALIZZAZIONE, DATAFINELIBERALIZZAZIONE, VERSIONING) &#xd;&#xa;VALUES (?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
                                    timeout="60" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISTAT_COMUNE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEPRICING"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TPLG_CLUSTER_COMUNE"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_INIZIO_VAL"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_FINE_VAL"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_RECORD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIZIONE_ERRORE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE_PROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="NUMERO_RECORD"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_INS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIZIONECOMUNE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINIZIOMARCAGGIOPREGRESSO"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINIZIOLIBERALIZZAZIONE"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFINELIBERALIZZAZIONE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VERSIONING"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogOKStaging-input"
                                    name="LogOKStaging"
                                    tibex:xpdlId="7223a5e2-06c7-4320-b0de-4ef3603a9202"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InsertStagToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOKStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AggiornamentoClusterComuni'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'OK INSERT STAGING'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
