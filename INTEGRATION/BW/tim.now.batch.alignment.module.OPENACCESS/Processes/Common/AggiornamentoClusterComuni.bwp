                <bpws:sources>
                    <bpws:source linkName="UpCountToWhile"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:scope name="While" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="89aca902-2451-4f4d-a3a6-9c474d3c6388">
                <bpws:targets>
                    <bpws:target linkName="UpCountToWhile"/>
