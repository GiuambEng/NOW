                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_KO_Counter-input"
                    name="Log_KO_Counter"
                    tibex:xpdlId="8b653861-a8e8-4cbf-b791-85d736daa8c3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Output_Log_counterToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_KO_CounterToGestioneMovedFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_KO_Counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AggiornamentoClusterComuni'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Invoke Counter KO'&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="MovedFile-input"
                    name="MovedFile" outputVariable="MovedFile"
                    tibex:xpdlId="1437f408-5c66-434c-81b3-721a83a6b456"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_KO_CounterToGestioneMovedFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MovedFileToTrackFile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tns4=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;PathMove&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;MovedFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:InputData>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&#xa;                &lt;tns4:FullPathOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&#xa;                &lt;/tns4:FullPathOrigine>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:FolderDestinazione>&#xa;                &lt;xsl:value-of select=&quot;$PathMove&quot;/>&#xa;            &lt;/tns4:FolderDestinazione>&#xa;            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&#xa;                &lt;tns4:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&#xa;                &lt;/tns4:NomeFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:ID_TRACK>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;            &lt;/tns4:ID_TRACK>&#xa;            &lt;tns4:LogInput>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LogName>&#xa;            &lt;/tns4:LogInput>&#xa;        &lt;/tns4:InputData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="TrackKOFunz-input"
                    name="TrackKOFunz"
                    tibex:xpdlId="ddda77c0-8e9a-4979-adf6-1c9639ab8ebc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MovedFileToTrackFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TrackKOFunzToProcessLoggerTrack"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;MovedFile&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackKOFunz-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:Update>&#xa;                &lt;tns4:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FLAG_LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns4:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;***ERRORE CONTA NUMERO RECORD***    ESITO CONTEGGIO=  &amp;quot;,$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio,'NUMERO RECORD ATTESI:',xsd:string($JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord))&quot;/>&#xa;                    &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;                &lt;/tns4:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length($MovedFile/tns5:FullPathMovedFile) > 0 and $JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;xsl:if test=&quot;$MovedFile/tns5:FullPathMovedFile&quot;>&#xa;                        &lt;tns4:FOLDER_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;$MovedFile/tns5:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns4:FOLDER_SCARTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:LogElement>&#xa;                    &lt;tns4:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/tns4:LoggerName>&#xa;                    &lt;tns4:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns4:LogLevel>&#xa;                &lt;/tns4:LogElement>&#xa;            &lt;/tns4:Update>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ProcessLoggerTrack-input"
                    name="ProcessLoggerTrack"
                    outputVariable="ProcessLoggerTrack"
                    tibex:xpdlId="b6112a4d-584b-4d53-9705-365b7dcda721"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TrackKOFunzToProcessLoggerTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProcessLoggerTrackToExit1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLoggerTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:DataIn>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns4:Update>&#xa;                            &lt;tns4:InputFile>&#xa;                                &lt;tns4:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns4:ID_FILE>&#xa;                                &lt;tns4:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                                &lt;/tns4:STATO_ESEC>&#xa;                                &lt;tns4:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns4:ESITO>&#xa;                                &lt;tns4:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                                &lt;/tns4:DESCR_STATO_FILE>&#xa;                                &lt;tns4:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns4:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns4:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns4:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns4:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns4:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns4:InputFile>&#xa;                        &lt;/tns4:Update>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Update>&#xa;                            &lt;tns4:InputFile>&#xa;                                &lt;tns4:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns4:ID_FILE>&#xa;                                &lt;tns4:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns4:STATO_ESEC>&#xa;                                &lt;tns4:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns4:ESITO>&#xa;                                &lt;tns4:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns4:DESCR_STATO_FILE>&#xa;                                &lt;tns4:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns4:LOG_MESSAGE>&#xa;                                &lt;tns4:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_OK>&#xa;                                &lt;tns4:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_KO>&#xa;                                &lt;tns4:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_TOTALI>&#xa;                            &lt;/tns4:InputFile>&#xa;                        &lt;/tns4:Update>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns4:DataIn>&#xa;            &lt;tns4:LogElement>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;            &lt;/tns4:LogElement>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit1" tibex:xpdlId="c20e9bb8-c880-4b97-abaf-407ed820f8d6">
                <bpws:targets>
                    <bpws:target linkName="ProcessLoggerTrackToExit1"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
