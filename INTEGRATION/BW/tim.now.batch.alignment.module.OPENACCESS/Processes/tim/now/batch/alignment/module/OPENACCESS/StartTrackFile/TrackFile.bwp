    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/CheckNomeFileBSS"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/FileTappo"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:TimerOutputSchema" name="Timer" sca-bpel:internal="true"/>
        <bpws:variable name="StartTimer" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/StartTime" type="xsd:dateTime"/>
        <bpws:variable name="IntervalloTimer" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/IntervalloMinuti" type="xsd:int"/>
        <bpws:variable name="SourcePath" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/SourcePathInnesco" type="xsd:string"/>
        <bpws:variable element="ns0:ListFilesActivityConfig"
            name="ListFiles-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ListFilesActivityOutput"
            name="ListFiles" sca-bpel:internal="true"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/Application" type="xsd:string"/>
        <bpws:variable name="LogName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="LogListFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Input"
            name="ControlloNomeFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Output" name="ControlloNomeFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:InputFileTappo"
            name="StartTrack-input" sca-bpel:internal="true"/>
        <bpws:variable name="PathMove" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathMoveFile" type="xsd:string"/>
        <bpws:variable name="PathError" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/FilePoller/PathError" type="xsd:string"/>
        <bpws:variable element="ns0:ListFilesActivityConfig"
            name="ListFilesCluster-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:ListFilesActivityOutput"
            name="ListFilesCluster" sca-bpel:internal="true"/>
        <bpws:variable name="SourcePathCluster"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
