                    expression="if(contains($Start/ns0:FILE_NAME, &quot;WLR_MSAN_&quot;)) then 'Bonifica Consistenza CLLI' else if(contains($Start/ns0:FILE_NAME, &quot;COMUNI_EX_DEL_348_19_CONS_&quot;)) then 'Aggiornamento Cluster Comuni'&#xd;&#xa;else 'ERROR'"
