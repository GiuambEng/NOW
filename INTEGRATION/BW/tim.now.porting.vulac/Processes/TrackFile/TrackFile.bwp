                                    <bpws:target linkName="GestioneLetturaTracciamentoToGroupEnd1"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ControlloNomeFile1-input"
                                    name="ControlloNomeFile1"
                                    outputVariable="ControlloNomeFile1"
                                    tibex:xpdlId="fd0dbd1d-4bb0-4bce-adf7-44630ba38dbe"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToControlloNomeFile1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ControlloNomeFile1ToGestioneLetturaTracciamento"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
