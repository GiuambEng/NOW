    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToListFiles" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToGenericLogger" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogListCRMBToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TimerToListFiles1" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesCCCToGenericLogger" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogListCCCToIterate1" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFilesCCCToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="d27667d3-1197-4179-84b7-6f5b453b9099"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToListFiles"/>
                        <bpws:source linkName="TimerToListFiles1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="IntervalloMinuti"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartTime"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2024-12-05T11:16:37.875+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesCRMB-input"
                    name="ListFilesCRMB" outputVariable="ListFilesCRMB"
                    tibex:xpdlId="22d23d4d-ddbc-44e5-a853-4a3901050695" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesCRMB/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesCRMB/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SourcePathCRMB&quot;/>&lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$SourcePathCRMB&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogListCRMB-input"
                    name="LogListCRMB"
                    tibex:xpdlId="9bc0f2b9-a7c3-4282-8782-7fef45057df0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogListCRMBToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListFilesCRMB&quot;/>&#xa;    &lt;xsl:template name=&quot;LogListCRMB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'TrackFile'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;***Trovati nel repository di CRMB i seguenti file : ***&amp;quot;, tib:render-xml($ListFilesCRMB, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate"
                tibex:indexOriginalName="index"
                tibex:indexToGlobal="false" tibex:xpdlId="c583e0d6-1f78-4fe9-a4cc-97765ee3a5fb">
                <bpws:targets>
                    <bpws:target linkName="LogListCRMBToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesCRMB/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesCRMB/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToControlloNomeFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ControlloNomeFileToGestioneLetturaTracciamento" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GestioneLetturaTracciamentoToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="18873b2b-6bab-43db-bcfb-febb01db25c3" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToControlloNomeFile"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesCRMB/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="08f6cbb2-8288-4148-8920-c6bc04a48df1">
                                    <bpws:targets>
                                    <bpws:target linkName="GestioneLetturaTracciamentoToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="ControlloNomeFile-input"
                                    name="ControlloNomeFile"
                                    outputVariable="ControlloNomeFile"
                                    tibex:xpdlId="fa5effcf-a538-4e56-b221-d1fd74175b0e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToControlloNomeFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ControlloNomeFileToGestioneLetturaTracciamento"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFilePortingVulac&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;ControlloNomeFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;tns1:FILE_NAME>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/fileName&quot;/>&#xa;            &lt;/tns1:FILE_NAME>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="TrackFile.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="TrackFile-input"
                                    name="TrackFile"
                                    tibex:xpdlId="e44e7798-c0c3-4c12-ac18-dc98bbc27837"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ControlloNomeFileToGestioneLetturaTracciamento"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GestioneLetturaTracciamentoToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFilePortingVulac&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloNomeFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorPathCRMB&quot;/>&#xa;    &lt;xsl:param name=&quot;MovePathCRMB&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:InputFileTappo>&#xa;            &lt;tns3:FileName>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&#xa;            &lt;/tns3:FileName>&#xa;            &lt;tns3:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;            &lt;/tns3:LogName>&#xa;            &lt;tns3:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;            &lt;/tns3:LogLevel>&#xa;            &lt;tns3:ApplicationName>&#xa;                &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;            &lt;/tns3:ApplicationName>&#xa;            &lt;tns3:Estensione>&#xa;                &lt;xsl:value-of select=&quot;'.csv'&quot;/>&#xa;            &lt;/tns3:Estensione>&#xa;            &lt;tns3:Sistema>&#xa;                &lt;xsl:value-of select=&quot;'CRMB_PORTING_VULAC'&quot;/>&#xa;            &lt;/tns3:Sistema>&#xa;            &lt;tns3:Flusso>&#xa;                &lt;xsl:value-of select=&quot;$ControlloNomeFile/tns1:FLUSSO&quot;/>&#xa;            &lt;/tns3:Flusso>&#xa;            &lt;tns3:PathError>&#xa;                &lt;xsl:value-of select=&quot;$ErrorPathCRMB&quot;/>&#xa;            &lt;/tns3:PathError>&#xa;            &lt;tns3:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$MovePathCRMB&quot;/>&#xa;            &lt;/tns3:PathMovedTappo>&#xa;        &lt;/tns3:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="06bafee9-d91d-40a3-b587-8d95ca1b74ae">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                    <bpws:target linkName="ListFilesToExit"/>
                    <bpws:target linkName="ListFilesCCCToExit"/>
                    <bpws:target linkName="Iterate1ToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ListFilesCCC-input"
                    name="ListFilesCCC" outputVariable="ListFilesCCC"
                    tibex:xpdlId="dd690036-23f6-4ea0-b2a4-de32e8c27ac5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFilesCCCToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFilesCCC/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesCCC/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFilesCCCToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SourcePathCCC&quot;/>&lt;xsl:template name=&quot;ListFilesCCC-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$SourcePathCCC&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogListCCC-input"
                    name="LogListCCC"
                    tibex:xpdlId="ba010051-cf5f-4841-b73a-e0312814c3dc"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListFilesCCCToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogListCCCToIterate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ListFilesCCC&quot;/>&lt;xsl:template name=&quot;LogListCCC-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'TrackFile'&quot;/>&lt;/tns2:Process>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;***Trovati nel repository di CCC i seguenti file : ***&amp;quot;, tib:render-xml($ListFilesCCC, true(), true()))&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate1" tibex:group="iterate"
                tibex:indexOriginalName="index"
                tibex:indexToGlobal="false" tibex:xpdlId="24a3602b-7475-4d03-8b47-ac62457bc18c">
                <bpws:targets>
                    <bpws:target linkName="LogListCCCToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate1ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate1"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesCCC/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesCCC/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope1">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns0:Iterate1_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToControlloNomeFile1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ControlloNomeFile1ToGestioneLetturaTracciamento" tibex:linkType="SUCCESS"/>
