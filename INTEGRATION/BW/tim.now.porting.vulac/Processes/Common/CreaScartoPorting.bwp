                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="COD_PROCSO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="DETAILS"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
