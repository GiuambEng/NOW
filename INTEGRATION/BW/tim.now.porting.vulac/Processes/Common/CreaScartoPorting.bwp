                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE, ID_ESEC_PROCSO_FILE, SISTEMA, FLUSSO, COD_PROCSO_FILE,&#xa;  DETAILS, RECORD_STG_OK, RECORD_STG_KO, RECORD_TRG_OK, RECORD_TRG_KO, ID_TRACK, STATO &#xa;  FROM STATO_ALLINEAMENTI&#xa;  WHERE STATO = 'GENERA_SCARTO' AND SISTEMA IN ('CRMB_PORTING_VULAC','CCC_PORTING_VULAC')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
