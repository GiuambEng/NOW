                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="e5ef6a41-09dd-430e-b4ba-b6ba1e8fa0da">
                <bpws:targets>
                    <bpws:target linkName="LogFineToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
