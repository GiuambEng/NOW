                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.example.org/tim.now.PortingVulaC_Staging&quot; xmlns:tns8=&quot;http://www.example.org/tim.now.PortingVulaC_Tracciato&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:param name=&quot;ContenutoRecdPortingVulaC&quot;/>&lt;xsl:template name=&quot;InputStag&quot; match=&quot;/&quot;>&lt;tns12:PortingVulaC>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns8:PortingVulaC_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns8:PortingVulaC_dettaglio&quot;>&lt;tns12:PortingVulaC_dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME, 'POR_CRMB_')&quot;>&lt;tns12:SISTEMAORIGINE>&lt;xsl:value-of select=&quot;'CRMB'&quot;/>&lt;/tns12:SISTEMAORIGINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns12:SISTEMAORIGINE>&lt;xsl:value-of select=&quot;'CCC'&quot;/>&lt;/tns12:SISTEMAORIGINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns8:IDRISORSA&quot;>&lt;tns12:IDRISORSA>&lt;xsl:value-of select=&quot;tns8:IDRISORSA&quot;/>&lt;/tns12:IDRISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns8:OPZIONEDINAMICA=('Y','y')&quot;>&lt;tns12:OPZIONEDINAMICA>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns12:OPZIONEDINAMICA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns8:PROFILOTECNICOLINEA&quot;>&lt;tns12:PROFILOTECNICOLINEA>&lt;xsl:value-of select=&quot;tns8:PROFILOTECNICOLINEA