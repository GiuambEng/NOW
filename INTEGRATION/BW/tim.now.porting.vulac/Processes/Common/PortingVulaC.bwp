                                name="ProcessLoggerTrack1"
                                outputVariable="ProcessLoggerTrack1"
                                tibex:xpdlId="8cf0d01e-257a-40b0-b4c6-f9d5469d9d7d"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="TrackFileToProcessLoggerTrack1"/>
