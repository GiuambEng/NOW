                 &lt;xsl:if test=&quot;tns8:Flag_Validita&quot;>&#xa;                                &lt;tns7:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns8:Flag_Validita&quot;/>&#xa;                                &lt;/tns7:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns7:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns7:NumeroRecord>&#xa;                        &lt;/tns7:ContenutoRecordPortingVulaC_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns7:InputPortingVulaC_ContenutoRecord>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
