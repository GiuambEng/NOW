                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tns2=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;PathMoveCRMB&quot;/>&lt;xsl:param name=&quot;PAthMoveCCC&quot;/>&lt;xsl:template name=&quot;MovedFile-input&quot; match=&quot;/&quot;>&lt;tns2:InputData>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&lt;tns2:FullPathOrigine>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/tns2:FullPathOrigine>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME, 'POR_CRMB_')&quot;>&lt;tns2:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathMoveCRMB&quot;/>&lt;/tns2:FolderDestinazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:FolderDestinazione>&lt;xsl:value-of select=&quot;$PAthMoveCCC&quot;/>&lt;/tns2:FolderDestinazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&lt;tns2:NomeFile>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/tns2:NomeFile>&lt;/xsl:if>&lt;tns2:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&lt;/tns2:ID_TRACK>&lt;tns2:LogInput>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LogName>&lt;/tns2:LogInput>&lt;/tns2:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="TrackKOFunz-input"
                    name="TrackKOFunz"
                    tibex:xpdlId="b077074b-afb4-4c0c-bb1c-c8f98d4708e1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MovedFileToTrackFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TrackKOFunzToProcessLoggerTrack"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;MovedFile&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackKOFunz-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:Update>&#xa;                &lt;tns4:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns4:FLAG_LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&#xa;                        &lt;/tns4:STATO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns4:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;***ERRORE CONTA NUMERO RECORD***    ESITO CONTEGGIO=  &amp;quot;,$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio,'NUMERO RECORD ATTESI:',xsd:string($JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord))&quot;/>&#xa;                    &lt;/tns4:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;                &lt;/tns4:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length($MovedFile/tns2:FullPathMovedFile) > 0 and $JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;xsl:if test=&quot;$MovedFile/tns2:FullPathMovedFile&quot;>&#xa;                        &lt;tns4:FOLDER_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;$MovedFile/tns2:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns4:FOLDER_SCARTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:LogElement>&#xa;                    &lt;tns4:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/tns4:LoggerName>&#xa;                    &lt;tns4:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns4:LogLevel>&#xa;                &lt;/tns4:LogElement>&#xa;            &lt;/tns4:Update>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="ProcessLoggerTrack-input"
                    name="ProcessLoggerTrack"
                    outputVariable="ProcessLoggerTrack"
                    tibex:xpdlId="aeaa12ab-4420-415f-a59e-f2fdded67456"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TrackKOFunzToProcessLoggerTrack"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProcessLoggerTrackToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLoggerTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns13:Input>&#xa;            &lt;tns13:DataIn>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns13:Update>&#xa;                            &lt;tns13:InputFile>&#xa;                                &lt;tns13:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns13:ID_FILE>&#xa;                                &lt;tns13:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                                &lt;/tns13:STATO_ESEC>&#xa;                                &lt;tns13:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns13:ESITO>&#xa;                                &lt;tns13:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                                &lt;/tns13:DESCR_STATO_FILE>&#xa;                                &lt;tns13:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns13:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns13:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns13:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns13:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns13:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns13:InputFile>&#xa;                        &lt;/tns13:Update>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:Update>&#xa;                            &lt;tns13:InputFile>&#xa;                                &lt;tns13:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns13:ID_FILE>&#xa;                                &lt;tns13:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns13:STATO_ESEC>&#xa;                                &lt;tns13:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns13:ESITO>&#xa;                                &lt;tns13:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns13:DESCR_STATO_FILE>&#xa;                                &lt;tns13:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns13:LOG_MESSAGE>&#xa;                                &lt;tns13:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_OK>&#xa;                                &lt;tns13:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_KO>&#xa;                                &lt;tns13:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_TOTALI>&#xa;                            &lt;/tns13:InputFile>&#xa;                        &lt;/tns13:Update>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns13:DataIn>&#xa;            &lt;tns13:LogElement>&#xa;                &lt;tns13:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns13:LoggerName>&#xa;                &lt;tns13:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns13:LogLevel>&#xa;            &lt;/tns13:LogElement>&#xa;        &lt;/tns13:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="7f3d48a0-6961-4a54-bcd4-24a09cca4f2f">
                <bpws:targets>
                    <bpws:target linkName="ProcessLoggerTrackToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:invoke inputVariable="Logger-input" name="Logger"
                operation="Insert" outputVariable="Logger"
                partnerLink="Logger" portType="ns11:ProcessLog" tibex:xpdlId="8589ed6d-0688-43d4-831e-042692ed9323">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns13="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="www.tim.now.contarecord_jms.response" version="2.0"&gt;
    &lt;xsl:param name="JMSReceiveMessage"/&gt;
    &lt;xsl:template name="Logger-input" match="/"&gt;
        &lt;tns13:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns3:Input&gt;
                    &lt;ns3:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="'FILE'"/&gt;
                    &lt;/ns3:TipologiaProcesso&gt;
                    &lt;ns3:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="'COUNTER'"/&gt;
                    &lt;/ns3:TipologiaOperazione&gt;
                    &lt;ns3:FileProcessatoInput&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"&gt;
                            &lt;ns3:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"/&gt;
                            &lt;/ns3:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"&gt;
                            &lt;ns3:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"/&gt;
                            &lt;/ns3:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns3:FileProcessatoInput&gt;
                &lt;/ns3:Input&gt;
            &lt;/part1&gt;
        &lt;/tns13:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Logger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns3:TipologiaProcesso>&#xa;            &lt;ns3:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'COUNTER'&quot;/>&#xa;            &lt;/ns3:TipologiaOperazione>&#xa;            &lt;ns3:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                    &lt;ns3:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns3:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                    &lt;ns3:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                    &lt;/ns3:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns3:FileProcessatoInput>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_Log_counterToLogger"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LoggerToWhile"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="fcb47fbb-5774-4199-aab9-df9bc7ebb12c">
                <bpws:targets>
                    <bpws:target linkName="LoggerToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToMapper"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable element="ns20:PortingVulaC" name="InputStag"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=((($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div $Passo) +1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=((($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div $Passo) +1)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToParseData" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStartToParseData1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="DetailNovalToGenericLogger1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="DetailUltimiNovalToGenericLogger1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="StartElaborazioneToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToContenutoRecdPortingVulaC" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty1ToGenericLogger1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ContenutoRecdPortingVulaCToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogRecordFinitiToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InputStagToJDBCUpdate1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="4898d137-bb4f-4bfc-873f-3b0211b361a5">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= (($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div$Passo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= (($JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord) div$Passo)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToParseData1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="49d4e164-fd11-43fa-8203-9cbffb97b0d9">
                                <bpws:targets>
                                    <bpws:target linkName="LogRecordFinitiToGroupEnd"/>
                                    <bpws:target linkName="JDBCUpdate1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DetailNoval-input"
                                    name="DetailNoval"
                                    outputVariable="DetailNoval"
                                    tibex:xpdlId="618af1ac-3861-40d3-883f-c45313296824" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DetailNovalToGenericLogger1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
