                                name="GestioneMovedFile"
                                outputVariable="GestioneMovedFile"
                                tibex:xpdlId="0d1c85a1-3269-4456-9cbf-eb7522888704"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToGestioneMovedFile"/>
