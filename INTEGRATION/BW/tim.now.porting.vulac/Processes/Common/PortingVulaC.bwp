                                <bpws:sources>
                                    <bpws:source linkName="GestioneMovedFileToTrackFile"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;PathErrorCRMB&quot;/>&lt;xsl:param name=&quot;PathErrorCCC&quot;/>&lt;xsl:template name=&quot;GestioneMovedFile-input&quot; match=&quot;/&quot;>&lt;tns2:InputData>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&lt;tns2:FullPathOrigine>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/tns2:FullPathOrigine>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME, 'POR_CRMB_')&quot;>&lt;tns2:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathErrorCRMB&quot;/>&lt;/tns2:FolderDestinazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathErrorCCC&quot;/>&lt;/tns2:FolderDestinazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;>&lt;tns2:NomeFile>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FILENAME&quot;/>&lt;/tns2:NomeFile>&lt;/xsl:if>&lt;tns2:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&lt;/tns2:ID_TRACK>&lt;tns2:LogInput>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LogName>&lt;/tns2:LogInput>&lt;/tns2:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneMovedFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
