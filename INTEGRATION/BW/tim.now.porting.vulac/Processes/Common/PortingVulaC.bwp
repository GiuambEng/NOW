#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns8:Flag_Validita&quot;>&#xa;                                &lt;tns7:Flag_Validita>&#xa;                                    &lt;xsl:value-of select=&quot;tns8:Flag_Validita&quot;/>&#xa;                                &lt;/tns7:Flag_Validita>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns7:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns7:NumeroRecord>&#xa;                        &lt;/tns7:ContenutoRecordPortingVulaC_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns8:PortingVulaC_dettaglio&quot;>&#xa;                        &lt;tns7:ContenutoRecordPortingVulaC_input>&#xa;                            &lt;xsl:if test=&quot;tns8:IDRISORSA&quot;>&#xa;                                &lt;tns7:IDRISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;tns8:IDRISORSA&quot;/>&#xa;                                &lt;/tns7:IDRISORSA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns8:OPZIONEDINAMICA&quot;>&#xa;                                &lt;tns7:OPZIONEDINAMICA>&#xa;                                    &lt;xsl:value-of select=&quot;tns8:OPZIONEDINAMICA&quot;/>&#xa;                                &lt;/tns7:OPZIONEDINAMICA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns8:PROFILOTECNICOLINEA&quot;>&#xa;                                &lt;tns7:PROFILOTECNICOLINEA>&#xa;                                    &lt;xsl:value-of select=&quot;tns8:PROFILOTECNICOLINEA&quot;/>&#xa;                                &lt;/tns7:PROFILOTECNICOLINEA>&#xa;          