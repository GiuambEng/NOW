    xmlns:ns1="www.tim.now.contarecord_jms.response"
    xmlns:ns10="http://xmlns.example.com/20241205144929PLT"
    xmlns:ns11="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"
    xmlns:ns12="http://tns.tibco.com/bw/palette/internal/activityerror+8589ed6d-0688-43d4-831e-042692ed9323"
    xmlns:ns13="http://tns.tibco.com/bw/activity/parse/xsd/+618af1ac-3861-40d3-883f-c45313296824+input"
    xmlns:ns14="http://tns.tibco.com/bw/activity/parse/xsd/+618af1ac-3861-40d3-883f-c45313296824+output"
    xmlns:ns15="http://tns.tibco.com/bw/palette/internal/activityerror+bw.parse.parsedata"
    xmlns:ns16="http://tns.tibco.com/bw/activity/parse/xsd/+b5852e9f-51ca-4652-b779-028cb7da686c+input"
    xmlns:ns17="http://tns.tibco.com/bw/activity/parse/xsd/+b5852e9f-51ca-4652-b779-028cb7da686c+output"
    xmlns:ns18="http://www.example.org/ContenutoRecdPortingVulaC"
    xmlns:ns19="www.tim.now.migration.OutputContenutoRecd"
    xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/jms+7c1dbb15-b185-40d5-b0e6-9cc4206eec29+output"
    xmlns:ns20="http://www.example.org/tim.now.PortingVulaC_Staging"
