    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="0e4caa40-fdee-4be6-9bc1-56afdb338764">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="GenericLoggerToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="JDBCUpdateToGestioneMovedFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty" tibex:linkType="ERROR"/>
