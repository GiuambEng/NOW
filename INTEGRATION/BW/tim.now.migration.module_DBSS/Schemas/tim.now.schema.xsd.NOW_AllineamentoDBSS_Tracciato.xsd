<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified"
	targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoDBSS_Tracciato"
	xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoDBSS_Tracciato">

	<element name="AllineamentoDBSS_Dettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="Tipo_record"
					type="string">

				</element>
				<element maxOccurs="1" minOccurs="0" name="Data_Dec"
					type="string">

				</element>
				<element maxOccurs="1" minOccurs="0" name="Ora_Dec"
					type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="ID_Risorsa"
					type="string">

				</element>
				<element maxOccurs="1" minOccurs="0"
					name="Numero_Telefonico" type="string">

				</element>
				<element maxOccurs="1" minOccurs="0" name="Stato_Asset"
					type="string">

				</element>
				<element maxOccurs="1" minOccurs="0" name="Flag_FTTH"
					type="string">

				</element>
				<element name="CognomeRagioneSociale" maxOccurs="1"
					minOccurs="0" type="string">

				</element>
				<element name="Particella_Toponomastica" maxOccurs="1"
					minOccurs="0" type="string">

				</element>
				<element name="Indirizzo" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Civico" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Localita" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Complesso" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Scala" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Piano" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Interno" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Codice_Comune" maxOccurs="1"
					minOccurs="0" type="string">

				</element>
				<element name="Codice_Via" maxOccurs="1" minOccurs="0"
					type="string">

				</element>
				<element name="Codice_Provincia" maxOccurs="1"
					minOccurs="0" type="string">

				</element>
				<element name="Indirizzo_non_certificato" maxOccurs="1"
