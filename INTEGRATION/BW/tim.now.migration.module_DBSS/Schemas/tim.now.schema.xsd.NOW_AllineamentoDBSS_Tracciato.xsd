				</element>
				<element maxOccurs="1" minOccurs="0"
					name="Destinazione_Uso" type="string">

				</element>
				<element maxOccurs="1" minOccurs="0"
					name="Famiglia_Tecnica" type="string">

				</element>
				<element name="Numero_nativo_olo" maxOccurs="1"
					minOccurs="0" type="string">

				</element>
				<element maxOccurs="1" minOccurs="0"
					name="Distretto_Telefonico" type="string">
				</element>


				<element name="Destinazione_Uso_Dati" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="5"></maxLength>
							<enumeration value="4"></enumeration>
							<enumeration value="5"></enumeration>
							<enumeration value="9"></enumeration>
							<enumeration value="10"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="ID_Risorsa_Correlata" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="Nome" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="CF_PIVA" maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="ROW_ID_ORDINE_FONIA" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element name="ROW_ID_ORDINE_DATI" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string" />
            </sequence>
		</complexType>
	</element>

	<element name="AllineamentoDBSS">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"
					ref="tns:AllineamentoDBSS_Dettaglio" />
			</sequence>
		</complexType>
	</element>













</schema>
