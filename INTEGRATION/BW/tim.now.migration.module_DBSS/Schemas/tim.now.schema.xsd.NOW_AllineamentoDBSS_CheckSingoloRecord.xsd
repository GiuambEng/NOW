<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoDBSS_CheckSingoloRecord" elementFormDefault="qualified" targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoDBSS_CheckSingoloRecord">

    <element name="AllineamentoDBSS_Dettaglio">
    	<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="Tipo_record">
					<simpleType>
						<restriction base="string">
							<enumeration value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Data_Dec">

					<simpleType>
						<restriction base="string">

							<pattern
								value="(19|20)[0-9][0-9](0[0-9]|1[0-2])([0-2][0-9]|3[0-1])">
							</pattern>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Ora_Dec">
					<simpleType>
						<restriction base="string">

							<pattern
								value="([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]">
							</pattern>
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="ID_Risorsa">
					<simpleType>
						<restriction base="string">
							<maxLength value="30" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Numero_Telefonico">
					<simpleType>
						<restriction base="string">
							<maxLength value="30" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Stato_Asset">
					<simpleType>
						<restriction base="string">
							<maxLength value="10" />
							<enumeration value="Attivo" />
							<enumeration value="Cessato" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="Flag_FTTH">
					<simpleType>
						<restriction base="string">

							<enumeration value="Y" />
							<enumeration value="N" />
							<length value="1"></length>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="CognomeRagioneSociale">
					<simpleType>
						<restriction base="string">
							<maxLength value="100" />
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Particella_Toponomastica">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Indirizzo">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Civico">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Localita">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Complesso">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Scala">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Piano">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Interno">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Codice_Comune">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Codice_Via">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Codice_Provincia">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Indirizzo_non_certificato">
					<simpleType>
						<restriction base="string">
							<maxLength value="256"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Destinazione_Uso">
					<simpleType>
						<restriction base="string">
							<maxLength value="5"/>
							<enumeration value="1"/>
							<enumeration value="2"/>

							<enumeration value="3"/>
							<enumeration value="4"/>
							<enumeration value="5"/>
							<enumeration value="9"/>
							<enumeration value="10"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Famiglia_Tecnica">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
							<enumeration value="Voce Tradizionale"/>
							<enumeration value="Broadband"/>
							<enumeration value="UltraBroadband"/>
							<enumeration value="UltraBroadbandH"/>
							<enumeration value="Broadband sNaked"/>

						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="Numero_nativo_olo">
					<simpleType>
						<restriction base="string">
							<enumeration value="Y" />
							<enumeration value="N" />

							<length value="1"></length>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="Distretto_Telefonico">
					<simpleType>
						<restriction base="string">
							<maxLength value="10"></maxLength>
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>


				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="NumeroRecord" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>

    		</sequence>
    	</complexType>
    </element>

    <element name="AllineamentoDBSS">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:AllineamentoDBSS_Dettaglio"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
