                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/" xmlns:ns2="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.example.org/VerificaLavorabilita" xmlns:tns2="http://www.example.org/CreateFileID" version="2.0"&gt;&lt;xsl:param name="TipoSeparatore"/&gt;&lt;xsl:param name="VerificaLavorabilita"/&gt;&lt;xsl:param name="InsertLogger"/&gt;&lt;xsl:template name="Invoke_Counter-input" match="/"&gt;&lt;ns1:Conta_Request&gt;&lt;part1&gt;&lt;ns2:contaRecord_Input&gt;&lt;ns2:in&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns2:in&gt;&lt;ns2:TipoSeparatore&gt;&lt;xsl:value-of select="$TipoSeparatore"/&gt;&lt;/ns2:TipoSeparatore&gt;&lt;xsl:if test="$InsertLogger/tns2:ID_FILE"&gt;&lt;ns2:ID_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:ID_FILE"/&gt;&lt;/ns2:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:SOURCE_FILE"&gt;&lt;ns2:FULLNAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:SOURCE_FILE"/&gt;&lt;/ns2:FULLNAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:NOME_FILE"&gt;&lt;ns2:FILENAME&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:NOME_FILE"/&gt;&lt;/ns2:FILENAME&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns2:ID_ESEC"&gt;&lt;ns2:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:ID_ESEC"/&gt;&lt;/ns2:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertLogger/tns2:COD_PROCSO_FILE"&gt;&lt;ns2:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertLogger/tns2:COD_PROCSO_FILE"/&gt;&lt;/ns2:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$VerificaLavorabilita/tns1:ID_TRACK"&gt;&lt;ns2:ID_TRACK&gt;&lt;xsl:value-of select="$VerificaLavorabilita/tns1:ID_TRACK"/&gt;&lt;/ns2:ID_TRACK&gt;&lt;/xsl:if&gt;&lt;ns2:NomeProcesso&gt;&lt;xsl:value-of select="'AllineamentoConsistenze.DBSS'"/&gt;&lt;/ns2:N