                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecordJmsConcrete/&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; xmlns:tns2=&quot;http://www.example.org/CreateFileID&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TipoSeparatore&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_Counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:contaRecord_Input>&#xa;            &lt;ns2:in>&#xa;                &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;            &lt;/ns2:in>&#xa;            &lt;ns2:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;$TipoSeparatore&quot;/>&#xa;            &lt;/ns2:TipoSeparatore>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:ID_FILE&quot;>&#xa;                &lt;ns2:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:ID_FILE&quot;/>&#xa;                &lt;/ns2:ID_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;>&#xa;                &lt;ns2:FULLNAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:SOURCE_FILE&quot;/>&#xa;                &lt;/ns2:FULLNAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&#xa;                &lt;ns2:FILENAME>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&#xa;                &lt;/ns2:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:ID_ESEC&quot;>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:ID_ESEC&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InsertLogger/tns2:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns2:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$InsertLogger/tns2:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns2:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&#xa;                &lt;ns2:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/ns2:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;'AllineamentoConsistenze.DBSS'&quot;/>&#xa;            &lt;/ns2:NomeProcesso>&#xa;        &lt;/ns2:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
