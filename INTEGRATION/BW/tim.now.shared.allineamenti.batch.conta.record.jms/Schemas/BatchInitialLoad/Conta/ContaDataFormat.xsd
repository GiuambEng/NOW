<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" 
targetNamespace="http://www.tim.com/NOW/xsd/Conta_DataFormat" 
xmlns:tns="http://www.tim.com/NOW/xsd/Conta_DataFormat" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
    <element name="Conta">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:ContaR">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="ContaR">
    	<complexType>
    		<sequence>
    			<element name="Record" type="string"/>
    		</sequence>
    	</complexType>
    </element>
</schema>