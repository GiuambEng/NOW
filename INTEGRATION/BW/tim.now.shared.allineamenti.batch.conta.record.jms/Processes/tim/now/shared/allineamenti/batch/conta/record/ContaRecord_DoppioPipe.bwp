                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/Atomic_contaRecord/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentiBatch/DataFormat_CodaTesta&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentiBatch/Conta_CodaTesta_ConNUmRecord&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AtomicIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Check&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseCoda&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseTesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Check='OK'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$AtomicIn.part1/ns:numerorecord=$ParseCoda/Rows/tns1:Coda[1]/tns1:Numero_record and $AtomicIn.part1/ns:numerorecord=$ParseTesta/Rows/tns:Testa[1]/tns:Numero_record&quot;>&#xa;                        &lt;ns:subProcessContaRecord_Output>&#xa;                            &lt;ns:out>&#xa;                                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                            &lt;/ns:out>&#xa;                            &lt;ns:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;$AtomicIn.part1/ns:numerorecord&quot;/>&#xa;                            &lt;/ns:NumeroRecord>&#xa;                        &lt;/ns:subProcessContaRecord_Output>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:subProcessContaRecord_Output>&#xa;                            &lt;ns:out>&#xa;                                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                            &lt;/ns:out>&#xa;                            &lt;ns:NumeroRecord>&#xa;                      