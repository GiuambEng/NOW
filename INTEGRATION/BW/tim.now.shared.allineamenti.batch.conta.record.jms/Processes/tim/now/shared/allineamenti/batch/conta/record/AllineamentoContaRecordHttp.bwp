            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="2800a882-87ce-46f0-8773-4c8d5fefe8b1">
                <bpws:targets>
                    <bpws:target linkName="StartToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToNumeroRecord"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string(true())=string($ParseData/done)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="ParseDataToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToNumeroRecord" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToParseData" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NumeroRecordCicloToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f2eaf6da-b2cf-4a43-ba0d-0d1f9cb81e3f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseData"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="999355f6-5557-493f-b47f-2f9bf32735b4">
                                <bpws:targets>
                                    <bpws:target linkName="NumeroRecordCicloToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+dde1ac98-7b60-41c8-92ad-28cbae8668c1+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContaRecordIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:template name=&quot;ParseData-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;fileName>&lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns:contaRecord_Input/ns:in&quot;/>&lt;/fileName>&lt;startRecord>&lt;xsl:value-of select=&quot;($index - 1) * $Passo +1&quot;/>&lt;/startRecord>&lt;noOfRecords>&lt;xsl:value-of select=&quot;$Passo&quot;/>&lt;/noOfRecords>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ParseData-input"
                                    name="ParseData"
                                    outputVariable="ParseData"
                                    tibex:xpdlId="dde1ac98-7b60-41c8-92ad-28cbae8668c1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseDataToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+dde1ac98-7b60-41c8-92ad-28cbae8668c1+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$ContaRecordIn.part1/ns:in&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index - 1) * $Passo +1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$Passo&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value
                                    continueOnError="true"
                                    dataFormat="dataFormatResource"
                                    encoding="ASCII"
                                    inputType="File"
                                    manuallySpecifiedStartRecord="true"
                                    skipBlankSpaces="true" xsi:type="parse:ParseData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CicloConta-input"
                                    name="CicloConta"
                                    tibex:xpdlId="15a5d98f-566b-4ed7-b9e5-708708342f41" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseDataToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToNumeroRecord"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NumeroRecord&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;CicloConta-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(xsd:string($index),'CICLO I RECORD SONO :  ',xsd:string($NumeroRecord))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="NumeroRecord"
                                    name="NumeroRecordCiclo"
                                    outputVariable="NumeroRecord"
                                    tibex:xpdlId="9ee3a2b6-da9e-4249-a813-4bd2d6f4cb13" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogToNumeroRecord"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NumeroRecordCicloToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="count($ParseData/Rows/tns1:ContaR) + $NumeroRecord" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="NumeroRecord" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string(true())=string($ParseData/done)]]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/model/addressing&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContaRecordIn&quot;/>&lt;xsl:template name=&quot;SetEPR-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$ContaRecordIn/part1/ns:contaRecord_Input/ns:TipoSeparatore='ContaRecord_Virgola'&quot;>&lt;tns:SimpleEndpointReference>&lt;tns:Address>&lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_Virgola&amp;quot;)&quot;/>&lt;/tns:Address>&lt;/tns:SimpleEndpointReference>&lt;/xsl:when>&lt;xsl:when test=&quot;$ContaRecordIn/part1/ns:contaRecord_Input/ns:TipoSeparatore='ContaRecord_DoppioPipe'&quot;>&lt;tns:SimpleEndpointReference>&lt;tns:Address>&lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_DoppioPipe&amp;quot;)&quot;/>&lt;/tns:Address>&lt;/tns:SimpleEndpointReference>&lt;/xsl:when>&lt;xsl:when test=&quot;$ContaRecordIn/part1/ns:contaRecord_Input/ns:TipoSeparatore='ContaRecord_PipeCancelletto'&quot;>&lt;tns:SimpleEndpointReference>&lt;tns:Address>&lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_PipeCancelletto&amp;quot;)&quot;/>&lt;/tns:Address>&lt;/tns:SimpleEndpointReference>&lt;/xsl:when>&lt;xsl:when test=&quot;$ContaRecordIn/part1/ns:contaRecord_Input/ns:TipoSeparatore='ContaRecord_PipeCancelletto_Retail'&quot;>&lt;tns:SimpleEndpointReference>&lt;tns:Address>&lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_PipeCancelletto_Retail&amp;quot;)&quot;/>&lt;/tns:Address>&lt;/tns:SimpleEndpointReference>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SimpleEndpointReference>&lt;tns:Address>&lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;),  &amp;quot;DinamicConta&amp;quot;)&quot;/>&lt;/tns:Address>&lt;/tns:SimpleEndpointReference>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SetEPR-input" name="SetEPR"
                    outputVariable="SetEPR"
                    tibex:xpdlId="d931ea64-25cd-49db-b844-d8d4d9e4c104" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ContaRecordToSetEPR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetEPRToDinamicCount1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/model/addressing&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;SetEPR-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns:TipoSeparatore='ContaRecord_Virgola'&quot;>&#xa;                &lt;tns:SimpleEndpointReference>&#xa;                    &lt;tns:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_Virgola&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Address>&#xa;                &lt;/tns:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns:TipoSeparatore='ContaRecord_DoppioPipe'&quot;>&#xa;                &lt;tns:SimpleEndpointReference>&#xa;                    &lt;tns:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_DoppioPipe&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Address>&#xa;                &lt;/tns:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns:TipoSeparatore='ContaRecord_PipeCancelletto'&quot;>&#xa;                &lt;tns:SimpleEndpointReference>&#xa;                    &lt;tns:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_PipeCancelletto&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Address>&#xa;                &lt;/tns:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns:TipoSeparatore='ContaRecord_PipeCancelletto_Retail'&quot;>&#xa;                &lt;tns:SimpleEndpointReference>&#xa;                    &lt;tns:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_PipeCancelletto_Retail&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Address>&#xa;                &lt;/tns:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:SimpleEndpointReference>&#xa;                    &lt;tns:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;),  &amp;quot;DinamicConta&amp;quot;)&quot;/>&#xa;                    &lt;/tns:Address>&#xa;                &lt;/tns:SimpleEndpointReference>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.setEPR"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//SetEPR"/>
                                    <value referenceName="DinamicConta" xsi:type="internalactivities:SetEPR"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
