            <bpws:receive createInstance="yes" name="ContaRecordIn"
                operation="ContaRecord" partnerLink="ContaHttp"
                portType="ns8:Conta"
                tibex:xpdlId="9ed8b38b-b4e9-4c00-bc7f-bb3ad816908a" variable="ContaRecordIn">
                <bpws:sources>
                    <bpws:source linkName="ContaRecordInToLog"/>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="ContaRecordOut" operation="ContaRecord"
                partnerLink="ContaHttp" portType="ns8:Conta"
                tibex:xpdlId="45017ef6-b8b4-41ae-a072-c81cf213d2fe" variable="ContaRecordOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/AllineamentoBatch/ContaRecord/" xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:tns1="http://www.tibco.com/AllineamentoBatch/ContaRecord_http/" version="2.0"&gt;&lt;xsl:param name="Output"/&gt;&lt;xsl:template name="ContaRecordOut-input" match="/"&gt;&lt;tns1:Conta_Response&gt;&lt;part1&gt;&lt;ns:contaRecord_Output&gt;&lt;xsl:if test="$Output/ns:out"&gt;&lt;ns:out&gt;&lt;xsl:value-of select="$Output/ns:out"/&gt;&lt;/ns:out&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Output/ns:NumeroRecord"&gt;&lt;ns:NumeroRecord&gt;&lt;xsl:value-of select="$Output/ns:NumeroRecord"/&gt;&lt;/ns:NumeroRecord&gt;&lt;/xsl:if&gt;&lt;/ns:contaRecord_Output&gt;&lt;/part1&gt;&lt;/tns1:Conta_Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecord/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:tns1=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecord_http/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Output&quot;/>&#xa;    &lt;xsl:template name=&quot;ContaRecordOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:contaRecord_Output>&#xa;            &lt;xsl:if test=&quot;$Output/ns:out&quot;>&#xa;                &lt;ns:out>&#xa;                    &lt;xsl:value-of select=&quot;$Output/ns:out&quot;/>&#xa;                &lt;/ns:out>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Output/ns:NumeroRecord&quot;>&#xa;                &lt;ns:NumeroRecord>&#xa;                    &lt;xsl:value-of select=&quot;$Output/ns:NumeroRecord&quot;/>&#xa;                &lt;/ns:NumeroRecord>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:contaRecord_Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="EndToContaRecordOut"/>
                    <bpws:target linkName="LogToContaRecordOut"/>
                    <bpws:target linkName="Log1ToContaRecordOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Start-input"
                    name="Start"
                    tibex:xpdlId="f1a47886-b549-406c-ac3b-db4da43bb537" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ContaRecordInToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartToRepeat"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Start-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;'Start ContaRecord '&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if ($ContaRecordIn/part1/ns7:contaRecord_Input/ns7:TipoSeparatore='POSIZIONALE') then $NumeroRecord else  if (  $ContaRecordIn/part1/ns7:contaRecord_Input/ns7:Flusso='RoutingNumber' ) then $NumeroRecord - 1 else $NumeroRecord - 2"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Counter" name="NumeroRecord"
                    outputVariable="Counter"
                    tibex:xpdlId="996ab42a-226c-4241-9714-aa8ae9135e39" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToNumeroRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NumeroRecordToSetEPR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NumeroRecordToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ContaRecordIn/part1/ns7:contaRecord_Input/ns7:TipoSeparatore='POSIZIONALE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$ContaRecordIn.part1/ns7:TipoSeparatore='POSIZIONALE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NumeroRecordToOutput">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Counter=-2) or ($Counter=-1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Counter=-2) or ($Counter=-1)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($ContaRecordIn.part1/ns7:TipoSeparatore='POSIZIONALE') then $NumeroRecord else  if (  $ContaRecordIn.part1/ns7:Flusso='RoutingNumber' ) then $NumeroRecord - 1 else $NumeroRecord - 2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Counter" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogOutputDinamic-input"
                    name="LogOutputDinamic"
                    tibex:xpdlId="97832c6e-f5bb-4a86-94f4-85fec8b9739e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EndToContaRecordOut"/>
                    </bpws:sources>
