            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm1"
                    tibex:xpdlId="d443dde3-8ea9-4996-b52f-d9c49d6e1d58" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOutputDinamicToConfirm11"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Confirm1ToJMSSendMessage"/>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value confirmEvent="ContaRecordIn" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+f5d0dcf1-ac33-48f0-bfdd-968e1aeb3a53+input&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;queue_response&quot;/>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn&quot;/>&#xa;    &lt;xsl:param name=&quot;Output&quot;/>&#xa;    &lt;xsl:template name=&quot;JMSSendMessage-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;destination>&#xa;                &lt;xsl:value-of select=&quot;concat($queue_response, $ContaRecordIn/part1/ns1:contaRecord_Input/ns1:NomeProcesso)&quot;/>&#xa;            &lt;/destination>&#xa;            &lt;Body>&#xa;                &lt;ns2:queueResponse>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_FILE&quot;>&#xa;                        &lt;ns2:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_FILE&quot;/>&#xa;                        &lt;/ns2:ID_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:FULLNAME&quot;>&#xa;                        &lt;ns2:FULLNAME>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:FULLNAME&quot;/>&#xa;                        &lt;/ns2:FULLNAME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:FILENAME&quot;>&#xa;                        &lt;ns2:FILENAME>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:FILENAME&quot;/>&#xa;                        &lt;/ns2:FILENAME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_ESEC_PROCSO_FILE&quot;>&#xa;                        &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:COD_PROCSO_FILE&quot;>&#xa;                        &lt;ns2:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:COD_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns2:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_TRACK&quot;>&#xa;                        &lt;ns2:ID_TRACK>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:ID_TRACK&quot;/>&#xa;                        &lt;/ns2:ID_TRACK>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:NomeProcesso&quot;>&#xa;                        &lt;ns2:NomeProcesso>&#xa;                            &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:NomeProcesso&quot;/>&#xa;                        &lt;/ns2:NomeProcesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Output/ns1:NumeroRecord&quot;>&#xa;                        &lt;ns2:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$Output/ns1:NumeroRecord&quot;/>&#xa;                        &lt;/ns2:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if tes