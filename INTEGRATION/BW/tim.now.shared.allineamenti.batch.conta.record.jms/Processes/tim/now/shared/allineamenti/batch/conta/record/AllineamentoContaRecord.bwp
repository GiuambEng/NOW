                    <bpws:targets>
                        <bpws:target linkName="RepeatToNumeroRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NumeroRecordToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NumeroRecordToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$ContaRecordIn/part1/ns13:contaRecord_Input/ns13:TipoSeparatore='POSIZIONALE' or $ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso=('Bonifica Consistenza CLLI','Aggiornamento Cluster Comuni','Bonifica ISTAT COMUNE da file')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$ContaRecordIn.part1/ns13:TipoSeparatore='POSIZIONALE' or $ContaRecordIn.part1/ns13:Flusso=('Bonifica Consistenza CLLI','Aggiornamento Cluster Comuni','Bonifica ISTAT COMUNE da file')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NumeroRecordToOutput">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Counter=-2) or ($Counter=-1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Counter=-2) or ($Counter=-1)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
