                    expression="if ($ContaRecordIn/part1/ns13:contaRecord_Input/ns13:TipoSeparatore='POSIZIONALE') then (if ($ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso=( 'BonificaGPON','ComuniCoinvestiti') )then $NumeroRecord -1 else $NumeroRecord)&#xd;&#xa;else  if (  $ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso=('RoutingNumber','Bonifica Consistenza CLLI','Aggiornamento Cluster Comuni','Bonifica ISTAT COMUNE da file') ) then $NumeroRecord - 1 else $NumeroRecord - 2"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Counter" name="NumeroRecord"
                    outputVariable="Counter"
