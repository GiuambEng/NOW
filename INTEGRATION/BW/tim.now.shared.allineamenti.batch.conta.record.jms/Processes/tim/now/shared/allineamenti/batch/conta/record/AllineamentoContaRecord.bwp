                &lt;/ns2:subProcessContaRecord_Input&gt;
            &lt;/part1&gt;
        &lt;/tns2:Request&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
