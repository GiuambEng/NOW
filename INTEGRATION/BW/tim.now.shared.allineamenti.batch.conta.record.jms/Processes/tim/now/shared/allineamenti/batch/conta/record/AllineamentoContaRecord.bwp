                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+5176b2bd-dcab-40fd-b043-c23018753d8d+input&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;GetIDTrack&quot;/>&#xa;    &lt;xsl:param name=&quot;queue_response&quot;/>&#xa;    &lt;xsl:template name=&quot;JMSSendMessage1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;destination>&#xa;                &lt;xsl:value-of select=&quot;concat($queue_response, $ContaRecordIn.part1/ns1:NomeProcesso)&quot;/>&#xa;            &lt;/destination>&#xa;            &lt;Body>&#xa;                &lt;ns:queueResponse>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:ID_FILE&quot;>&#xa;                        &lt;ns:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:ID_FILE&quot;/>&#xa;                        &lt;/ns:ID_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:FULLNAME&quot;>&#xa;                        &lt;ns:FULLNAME>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:FULLNAME&quot;/>&#xa;                        &lt;/ns:FULLNAME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:FILENAME&quot;>&#xa;                        &lt;ns:FILENAME>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:FILENAME&quot;/>&#xa;                        &lt;/ns:FILENAME>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                        &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:COD_PROCSO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:COD_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($ContaRecordIn.part1/ns1:ID_TRACK)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$ContaRecordIn.part1/ns1:ID_TRACK&quot;>&#xa;                                &lt;ns:ID_TRACK>&#xa;                                    &lt;xsl:value-of select=&quot;$ContaRecordIn.part1/ns1:ID_TRACK&quot;/>&#xa;                                &lt;/ns:ID_TRACK>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($GetIDTrack/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GetIDTrack/Record[1]/ID_TRACK&quot;>&#xa;                                &lt;ns:ID_TRACK>&#xa;                                    &lt;xsl:value-of select=&quot;$GetIDTrack/Record[1]/ID_TRACK&quot;/>&#xa;                                &lt;/ns:ID_TRACK>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:NomeProcesso&quot;>&#xa;                        &lt;ns:NomeProcesso>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:NomeProcesso&quot;/>&#xa;                        &lt;/ns:NomeProcesso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Input/ns:NumeroRecord&quot;>&#xa;                        &lt;ns:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$Input/ns:NumeroRecord&quot;/>&#xa;                        &lt;/ns:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:EsitoConteggio>&#xa;                        &lt;xsl:value-of select=&quot;'ERROR'&quot;/>&#xa;                    &lt;/ns:EsitoConteggio>&#xa;                    &lt;ns:descrErrore>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&#xa;                    &lt;/ns:descrErrore>&#xa;                &lt;/ns:queueResponse>&#xa;            &lt;/Body>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jms.send"
                                    version="6.0.0.20132205"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
