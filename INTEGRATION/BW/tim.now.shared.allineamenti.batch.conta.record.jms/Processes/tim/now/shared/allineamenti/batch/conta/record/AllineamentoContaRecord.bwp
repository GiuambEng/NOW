                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Counter=-2&quot;>&lt;ns1:contaRecord_Output>&lt;ns1:out>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns1:out>&lt;ns1:NumeroRecord>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/ns1:NumeroRecord>&lt;/ns1:contaRecord_Output>&lt;/xsl:when>&lt;xsl:when test=&quot;$Counter=-1&quot;>&lt;ns1:contaRecord_Output>&lt;ns1:out>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/ns1:out>&lt;/ns1:contaRecord_Output>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Output"
                    name="OutputPosizionale" outputVariable="Output"
                    tibex:xpdlId="abb024d1-33df-4e8c-8979-579ed1f844db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NumeroRecordToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OutputPosizionaleToCallProcess2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&lt;ns1:contaRecord_Output>&lt;ns1:out>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns1:out>&lt;ns1:NumeroRecord>&lt;xsl:value-of select=&quot;$Counter&quot;/>&lt;/ns1:NumeroRecord>&lt;/ns1:contaRecord_Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/Atomic_contaRecord/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DinamicCount&quot;/>&#xa;    &lt;xsl:param name=&quot;ContaPuntoVirgola&quot;/>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:TipoSeparatore = 'ContaRecord_PuntoVirgola'&quot;>&#xa;                &lt;ns1:contaRecord_Output>&#xa;                    &lt;xsl:if test=&quot;$ContaPuntoVirgola/part1/ns:subProcessContaRecord_Output/ns:out&quot;>&#xa;                        &lt;ns1:out>&#xa;                            &lt;xsl:value-of select=&quot;$ContaPuntoVirgola/part1/ns:subProcessContaRecord_Output/ns:out&quot;/>&#xa;                        &lt;/ns1:out>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaPuntoVirgola/part1/ns:subProcessContaRecord_Output/ns:NumeroRecord&quot;>&#xa;                        &lt;ns1:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$ContaPuntoVirgola/part1/ns:subProcessContaRecord_Output/ns:NumeroRecord&quot;/>&#xa;                        &lt;/ns1:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:contaRecord_Output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:contaRecord_Output>&#xa;                    &lt;xsl:if test=&quot;$DinamicCount/part1/ns:subProcessContaRecord_Output/ns:out&quot;>&#xa;                        &lt;ns1:out>&#xa;                            &lt;xsl:value-of select=&quot;$DinamicCount/part1/ns:subProcessContaRecord_Output/ns:out&quot;/>&#xa;                        &lt;/ns1:out>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DinamicCount/part1/ns:subProcessContaRecord_Output/ns:NumeroRecord&quot;>&#xa;                        &lt;ns1:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$DinamicCount/part1/ns:subProcessContaRecord_Output/ns:NumeroRecord&quot;/>&#xa;                        &lt;/ns1:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:contaRecord_Output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Output" name="OutputDinamic"
                    outputVariable="Output"
                    tibex:xpdlId="8787a532-afa1-4730-81a8-427e80715af9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DinamicCountToOutputDinamic"/>
                        <bpws:target linkName="InvokeToOutputDinamic"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OutputDinamicToLogOutputDinamic"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/Atomic_contaRecord/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaPuntoVirgola.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;DinamicCount.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;Output&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns1:TipoSeparatore = 'ContaRecord_PuntoVirgola'&quot;>&#xa;                &lt;ns1:contaRecord_Output>&#xa;                    &lt;xsl:if test=&quot;$ContaPuntoVirgola.part1/ns:out&quot;>&#xa;                        &lt;ns1:out>&#xa;                            &lt;xsl:value-of select=&quot;$ContaPuntoVirgola.part1/ns:out&quot;/>&#xa;                        &lt;/ns1:out>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ContaPuntoVirgola.part1/ns:NumeroRecord&quot;>&#xa;                        &lt;ns1:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$ContaPuntoVirgola.part1/ns:NumeroRecord&quot;/>&#xa;                        &lt;/ns1:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:contaRecord_Output>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:contaRecord_Output>&#xa;                    &lt;xsl:if test=&quot;$DinamicCount.part1/ns:out&quot;>&#xa;                        &lt;ns1:out>&#xa;                            &lt;xsl:value-of select=&quot;$DinamicCount.part1/ns:out&quot;/>&#xa;                        &lt;/ns1:out>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DinamicCount.part1/ns:NumeroRecord&quot;>&#xa;                        &lt;ns1:NumeroRecord>&#xa;                            &lt;xsl:value-of select=&quot;$DinamicCount.part1/ns:NumeroRecord&quot;/>&#xa;                        &lt;/ns1:NumeroRecord>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:contaRecord_Output>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Output" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="2800a882-87ce-46f0-8773-4c8d5fefe8b1">
                <bpws:targets>
                    <bpws:target linkName="MapperToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToNumeroRecord"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string(true())=string($ParseData/done) or string(true())=string($ParseDataWSDP/done) or string(true())=string($ParseDataBonificaGPON/done)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToParseData" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="ParseDataToNumeroRecordCiclo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NumeroRecordCicloToCicloConta" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CicloContaToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToParseData1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ParseDataBonificaGPONToNumeroRecordCiclo" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToParseDataWSDP" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ParseDataWSDPToNumeroRecordCiclo" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f2eaf6da-b2cf-4a43-ba0d-0d1f9cb81e3f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToParseData1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso= ('BonificaGPON', 'AnagraficaFormatContrattuale', 'IncentiviOAO_Switchoff', 'IncentiviOAO_CLLI_OLD_Switchoff', 'IncentiviOAO_CLLI_NEW_Switchoff', 'IncentiviOAO_Switchoff_Elab', 'Risorse_FWA_Decommissioning')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ContaRecordIn.part1/ns13:Flusso= ('BonificaGPON', 'AnagraficaFormatContrattuale', 'IncentiviOAO_Switchoff', 'IncentiviOAO_CLLI_OLD_Switchoff', 'IncentiviOAO_CLLI_NEW_Switchoff', 'IncentiviOAO_Switchoff_Elab', 'Risorse_FWA_Decommissioning')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToParseDataWSDP">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso= 'AnagraficheWSDP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ContaRecordIn.part1/ns13:Flusso= 'AnagraficheWSDP']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="999355f6-5557-493f-b47f-2f9bf32735b4">
                                <bpws:targets>
                                    <bpws:target linkName="CicloContaToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+dde1ac98-7b60-41c8-92ad-28cbae8668c1+input&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:in&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index - 1) * $Passo +1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$Passo&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ParseData-input"
                                    name="ParseData"
                                    outputVariable="ParseData"
                                    tibex:xpdlId="dde1ac98-7b60-41c8-92ad-28cbae8668c1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseDataToNumeroRecordCiclo"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+dde1ac98-7b60-41c8-92ad-28cbae8668c1+input&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseData-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$ContaRecordIn.part1/ns1:in&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index - 1) * $Passo +1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$Passo&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value
                                    continueOnError="true"
                                    dataFormat="dataFormatResource"
                                    encoding="ASCII"
                                    inputType="File"
                                    manuallySpecifiedStartRecord="true"
                                    skipBlankSpaces="true" xsi:type="parse:ParseData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ($ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso= ('BonificaGPON', 'AnagraficaFormatContrattuale', 'IncentiviOAO_Switchoff', 'IncentiviOAO_CLLI_OLD_Switchoff', 'IncentiviOAO_CLLI_NEW_Switchoff', 'IncentiviOAO_Switchoff_Elab', 'Risorse_FWA_Decommissioning')) &#xd;&#xa;then (count($ParseDataBonificaGPON/Rows/tns1:ContaR) + $NumeroRecord) &#xd;&#xa;else if ($ContaRecordIn/part1/ns13:contaRecord_Input/ns13:Flusso= 'AnagraficheWSDP') then (count($ParseDataWSDP/Rows/tns1:ContaR) + $NumeroRecord) &#xd;&#xa;else count($ParseData/Rows/tns1:ContaR) + $NumeroRecord"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="NumeroRecord"
                                    name="NumeroRecordCiclo"
                                    outputVariable="NumeroRecord"
                                    tibex:xpdlId="9ee3a2b6-da9e-4249-a813-4bd2d6f4cb13" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseDataToNumeroRecordCiclo"/>
                                    <bpws:target linkName="ParseDataBonificaGPONToNumeroRecordCiclo"/>
                                    <bpws:target linkName="ParseDataWSDPToNumeroRecordCiclo"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NumeroRecordCicloToCicloConta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if ($ContaRecordIn.part1/ns13:Flusso= ('BonificaGPON', 'AnagraficaFormatContrattuale', 'IncentiviOAO_Switchoff', 'IncentiviOAO_CLLI_OLD_Switchoff', 'IncentiviOAO_CLLI_NEW_Switchoff', 'IncentiviOAO_Switchoff_Elab', 'Risorse_FWA_Decommissioning')) &#xd;&#xa;then (count($ParseDataBonificaGPON/Rows/tns1:ContaR) + $NumeroRecord) &#xd;&#xa;else if ($ContaRecordIn.part1/ns13:Flusso= 'AnagraficheWSDP') then (count($ParseDataWSDP/Rows/tns1:ContaR) + $NumeroRecord) &#xd;&#xa;else count($ParseData/Rows/tns1:ContaR) + $NumeroRecord" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="NumeroRecord" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
