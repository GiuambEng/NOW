                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/model/addressing&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;SetEPR-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns1:TipoSeparatore='ContaRecord_Virgola'&quot;>&#xa;                &lt;tns1:SimpleEndpointReference>&#xa;                    &lt;tns1:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_Virgola&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:Address>&#xa;                &lt;/tns1:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns1:TipoSeparatore='ContaRecord_DoppioPipe'&quot;>&#xa;                &lt;tns1:SimpleEndpointReference>&#xa;                    &lt;tns1:Address>&#xa;                        &lt;xsl:value-of select=&quot;bw:generateEPR(bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.NAME&amp;quot;), bw:getModuleProperty(&amp;quot;BW.DEPLOYMENTUNIT.VERSION&amp;quot;), &amp;quot;ContaRecord_DoppioPipe&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:Address>&#xa;                &lt;/tns1:SimpleEndpointReference>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$ContaRecordIn.part1/ns1:TipoSeparatore='ContaRecord_PipeCancelletto'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ContaRecordIn.part1/n