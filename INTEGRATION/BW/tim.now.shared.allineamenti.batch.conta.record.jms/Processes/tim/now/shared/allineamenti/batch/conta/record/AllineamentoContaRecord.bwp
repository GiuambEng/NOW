                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DinamicCount-input"
                name="DinamicCount" operation="Atomic"
                outputVariable="DinamicCount" partnerLink="DinamicConta"
                portType="ns5:Dinamic_Conta" tibex:xpdlId="692325e4-1440-41a0-af94-ec46c010f2d9">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tibco.com/Atomic_ContaRecord/" xmlns:ns3="http://www.tim.com/NOW/AllineamentiBatch/Atomic_contaRecord/" xmlns:ns1="http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/" version="2.0"&gt;
    &lt;xsl:param name="Counter"/&gt;
    &lt;xsl:param name="ContaRecordIn"/&gt;
    &lt;xsl:template name="DinamicCount-input" match="/"&gt;
        &lt;tns2:Request&gt;
            &lt;part1&gt;
                &lt;ns3:subProcessContaRecord_Input&gt;
                    &lt;ns3:fileName&gt;
                        &lt;xsl:value-of select="$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:in"/&gt;
                    &lt;/ns3:fileName&gt;
                    &lt;ns3:numerorecord&gt;
                        &lt;xsl:value-of select="$Counter"/&gt;
                    &lt;/ns3:numerorecord&gt;
                    &lt;xsl:if test="$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:Flusso"&gt;
                        &lt;ns3:Flusso&gt;
                            &lt;xsl:value-of select="$ContaRecordIn/part1/ns1:contaRecord_Input/ns1:Flusso"/&gt;
                        &lt;/ns3:Flusso&gt;
                    &lt;/xsl:if&gt;
                &lt;/ns3:subProcessContaRecord_Input&gt;
            &lt;/part1&gt;
        &lt;/tns2:Request&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/Atomic_ContaRecord/&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/AllineamentiBatch/Atomic_contaRecord/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord_jms/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ContaRecordIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:template name=&quot;DinamicCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:subProcessContaRecord_Input>&#xa;            &lt;ns3:fileName>&#xa;                &lt;xsl:value-of select=&quot;$ContaRecordIn.part1/ns1:in&quot;/>&#xa;            &lt;/ns3:fileName>&#xa;            &lt;ns3:numerorecord>&#xa;                &lt;xsl:value-of select=&quot;$Counter&quot;/>&#xa;            &lt;/ns3:numerorecord>&#xa;            &lt;xsl:if test=&quot;$ContaRecordIn.part1/ns1:Flusso&quot;>&#xa;                &lt;ns3:Flusso>&#xa;                    &lt;xsl:value-of select=&quot;$ContaRecordIn.part1/ns1:Flusso&quot;/>&#xa;                &lt;/ns3:Flusso>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns3:subProcessContaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
