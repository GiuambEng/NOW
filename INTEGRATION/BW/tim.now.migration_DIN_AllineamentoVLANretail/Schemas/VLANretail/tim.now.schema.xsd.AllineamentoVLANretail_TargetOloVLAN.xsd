<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoVLANretail_TargetOloVLAN" xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoVLANretail_TargetOloVLAN" elementFormDefault="qualified" attributeFormDefault="unqualified">

