                                    sqlStatement="INSERT INTO STAG_ANAG_VLAN_FILE (CLLI, COD_AREA_RACCOLTA,&#xa;  COD_KIT, COD_MACRO_AREA, COD_OLO, COD_OLO_SUB, COD_SUPER_MACRO_AREA,&#xa;  COD_VLAN, CODFC_OLO_AGCOM, CODFC_OLO_AGCOM_SUB, CONTENUTO_RECD,&#xa;  DATA_ATTIVAZIONE_SUB, DATA_CESSAZIONE_SUB, DEC, DEC_ATTIVAZIONE,&#xa;  DESC_AREA_RACCOLTA, DESC_MACRO_AREA, DESC_SUPER_MACRO_AREA,&#xa;  DESCR_ERRORE, DSLAM_TYPE, FLAG_ENCAPSULATION, FLAG_VLAN_TRANSLATION,&#xa;  ID_VLAN_OLO, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NOME,&#xa;  NOME_CENTRALE, NUMERO_RECD, STATO, STATO_SUB, TIPO_BANDA, TIPO_COS,&#xa;  TIPO_TRASPORTO, TIPOLG, TMSP_INSMTO,OPERATORERETE,INTERMEDIATE_AGENT)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,?,?)"
