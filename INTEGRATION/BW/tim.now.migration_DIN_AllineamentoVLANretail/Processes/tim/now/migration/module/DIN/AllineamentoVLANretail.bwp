ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/xsl:if&gt;&lt;/ns:LogFileProcessato&gt;&lt;ns:FileProcessatoOutput&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ESITO_INVIO"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:ID_FILE_PROCSTO_OUTPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_CREZIONE_FILE"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:FileProcessatoOutput/ns:TIMSTP_INVIO"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Input_ProcessLogger/ns:ContenutoFile/ns:FullName"&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$Input_ProcessLogger/ns:ContenutoFile/ns:FullName"/&gt;&lt;/ns:FullName&gt;&lt;/xsl:if&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input_ProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeProcessLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Input_ProcessLogger/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO