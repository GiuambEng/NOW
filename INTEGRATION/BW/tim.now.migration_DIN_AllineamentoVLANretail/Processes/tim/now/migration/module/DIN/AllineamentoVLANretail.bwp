                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoVLANretail_Staging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoVLANretail_Noval&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo_DIN&quot;/>&#xa;    &lt;xsl:param name=&quot;current-dateTime&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecord&quot;/>&#xa;    &lt;xsl:template name=&quot;Input_Staging&quot; match=&quot;/&quot;>&#xa;        &lt;tns:AllineamentoVLANretail>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:AllineamentoVLANretail_Dettaglio_Noval)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:AllineamentoVLANretail_Dettaglio_Noval&quot;>&#xa;                        &lt;tns:AllineamentoVLANretail_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_DIN * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&#xa;                                &lt;tns:COD_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&#xa;                                &lt;/tns:COD_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLAN&quot;>&#xa;                                &lt;tns:COD_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLAN&quot;/>&#xa;                                &lt;/tns:COD_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&#xa;                                &lt;tns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&#xa;                                &lt;/tns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;tns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC&quot;>&#xa;                                &lt;tns:DEC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&#xa;                                &lt;/tns:DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&#xa;                                &lt;tns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/tns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE&quot;>&#xa;                                &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&#xa;                                &lt;tns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&#xa;                                &lt;/tns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INTERMEDIATE_AGENT&quot;>&#xa;                                &lt;tns:INTERMEDIATE_AGENT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INTERMEDIATE_AGENT&quot;/>&#xa;                                &lt;/tns:INTERMEDIATE_AGENT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CUSTOMER_RETE&quot;>&#xa;                                &lt;tns:CUSTOMER_RETE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CUSTOMER_RETE&quot;/>&#xa;                                &lt;/tns:CUSTOMER_RETE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;$current-dateTime&quot;/>&#xa;                            &lt;/tns:TMSP_INSMTO>&#xa;                        &lt;/tns:AllineamentoVLANretail_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:AllineamentoVLANretail_Dettaglio_Noval&quot;>&#xa;                        &lt;tns:AllineamentoVLANretail_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_DIN * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODE&quot;>&#xa;                                &lt;tns:COD_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODE&quot;/>&#xa;                                &lt;/tns:COD_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDVLAN&quot;>&#xa;                                &lt;tns:COD_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDVLAN&quot;/>&#xa;                                &lt;/tns:COD_VLAN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:OLO_CODING&quot;>&#xa;                                &lt;tns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:OLO_CODING&quot;/>&#xa;                                &lt;/tns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;tns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecord/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/tns:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC&quot;>&#xa;                                &lt;tns:DEC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&#xa;                                &lt;/tns:DEC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DEC_ATT&quot;>&#xa;                                &lt;tns:DEC_ATTIVAZIONE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DEC_ATT&quot;/>&#xa;                                &lt;/tns:DEC_ATTIVAZIONE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE&quot;>&#xa;                                &lt;tns:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeProcessLogger.part1/ns:Esito/ns:ID_FILE&quot;/>&#xa;                                &lt;/tns:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&#xa;                            &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns1:NOME_CENTRALE&quot;>&#xa;                                &lt;tns:NOME_CENTRALE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:NOME_CENTRALE&quot;/>&#xa;                                &lt;/tns:NOME_CENTRALE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:INTERMEDIATE_AGENT&quot;>&#xa;                                &lt;tns:INTERMEDIATE_AGENT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:INTERMEDIATE_AGENT&quot;/>&#xa;                                &lt;/tns:INTERMEDIATE_AGENT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CUSTOMER_RETE&quot;>&#xa;                                &lt;tns:CUSTOMER_RETE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CUSTOMER_RETE&quot;/>&#xa;                                &lt;/tns:CUSTOMER_RETE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;$current-dateTime&quot;/>&#xa;                            &lt;/tns:TMSP_INSMTO>&#xa;                        &lt;/tns:AllineamentoVLANretail_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:AllineamentoVLANretail>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
