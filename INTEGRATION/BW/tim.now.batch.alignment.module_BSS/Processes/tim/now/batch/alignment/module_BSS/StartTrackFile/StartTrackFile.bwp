            name="ControlloNomeDBSS-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:Output" name="ControlloNomeDBSS" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:InputFileTappo"
            name="StartTrack_DBSS-input" sca-bpel:internal="true"/>
        <bpws:variable name="FlagAbilitaAllineamentoAccessi"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FlagAbilitaFlussi/AllineamentoAccessi" type="xsd:string"/>
        <bpws:variable name="FlagAbilitaBonificheClienti"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FlagAbilitaFlussi/BonificheClienti" type="xsd:string"/>
        <bpws:variable name="FlagAbilitaQuadraturaDBSS"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FlagAbilitaFlussi/QuadraturaDBSS" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToListFiles" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="TimerToListFiles1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles_CRMRToIterate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles_CRMBWToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Iterate1ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles_CRMRToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ListFiles_CRMBWToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToIterate1" tibex:linkType="SUCCESS"/>
                <bpws:link name="TimerToListFiles2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="ListFiles_BonificheClientiErratiToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="Log_ListFiles_BonificheClientiErratiToForEach" tibex:linkType="SUCCESS"/>
                <bpws:link name="ForEachToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListFiles_BonificheClientiErratiToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="TimerToListFiles_DBSS" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles_DBSSToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ListFiles_DBSSToExit" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogListFiles_DBSSToIterate2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Iterate2ToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="TimerToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="3dd1907d-5d30-4334-b694-3e49103ff2bb"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToListFiles">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagAbilitaAllineamentoAccessi='S'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FlagAbilitaAllineamentoAccessi='S']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TimerToListFiles1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagAbilitaAllineamentoAccessi='S'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FlagAbilitaAllineamentoAccessi='S']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TimerToListFiles2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagAbilitaBonificheClienti='S'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FlagAbilitaBonificheClienti='S']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TimerToListFiles_DBSS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagAbilitaQuadraturaDBSS='S'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FlagAbilitaQuadraturaDBSS='S']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TimerToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartTimer"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="Intervallo"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2017-01-31T17:32:12.993+0100"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFileCRMR&quot;/>&lt;xsl:template name=&quot;ListFiles_CRMR-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFileCRMR&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ListFiles_CRMR-input"
                    name="ListFiles_CRMR"
                    outputVariable="ListFiles_CRMR"
                    tibex:xpdlId="1ab83210-0e9e-44a1-b36f-4da5c1cf1109" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFiles_CRMRToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFiles_CRMR/files/fileInfo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFiles_CRMR/files/fileInfo)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFiles_CRMRToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFileCRMR&quot;/>&lt;xsl:template name=&quot;ListFiles_CRMR-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFileCRMR&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFileCMRBW&quot;/>&lt;xsl:template name=&quot;ListFiles_CRMBW-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFileCMRBW&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ListFiles_CRMBW-input"
                    name="ListFiles_CRMBW"
                    outputVariable="ListFiles_CRMBW"
                    tibex:xpdlId="4c4603f6-e515-486c-8ba4-acf875cdf3d3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToListFiles1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListFiles_CRMBWToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($ListFiles_CRMBW/files/fileInfo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($ListFiles_CRMBW/files/fileInfo)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ListFiles_CRMBWToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFileCMRBW&quot;/>&lt;xsl:template name=&quot;ListFiles_CRMBW-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;$PathFileCMRBW&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//ListFiles"/>
                                    <value mode="files-and-directories" xsi:type="file:ListFiles"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="55873625-51db-4729-8a80-8188db9bcb07">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFiles_CRMR/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFiles_CRMR/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcess1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToStartTrack_CRMR" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="56887432-a4d5-41ea-8a7b-aadc79f285a8" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFiles_CRMR/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="d852da49-0df2-4545-96dd-8f877997c21f">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileBSS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;PathMovedTappo&quot;/>&#xa;    &lt;xsl:param name=&quot;PathError&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckNomeFile&quot;/>&#xa;    &lt;xsl:template name=&quot;StartTrack_CRMR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputFileTappo>&#xa;            &lt;tns:FileName>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&#xa;            &lt;/tns:FileName>&#xa;            &lt;tns:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns:LogName>&#xa;            &lt;tns:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;            &lt;/tns:LogLevel>&#xa;            &lt;tns:ApplicationName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns:ApplicationName>&#xa;            &lt;tns:Estensione>&#xa;                &lt;xsl:value-of select=&quot;'.csv'&quot;/>&#xa;            &lt;/tns:Estensione>&#xa;            &lt;tns:Sistema>&#xa;                &lt;xsl:value-of select=&quot;'CRMR'&quot;/>&#xa;            &lt;/tns:Sistema>&#xa;            &lt;tns:Flusso>&#xa;                &lt;xsl:value-of select=&quot;$CheckNomeFile/tns1:FLUSSO&quot;/>&#xa;            &lt;/tns:Flusso>&#xa;            &lt;tns:PathError>&#xa;                &lt;xsl:value-of select=&quot;$PathError&quot;/>&#xa;            &lt;/tns:PathError>&#xa;            &lt;tns:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$PathMovedTappo&quot;/>&#xa;            &lt;/tns:PathMovedTappo>&#xa;        &lt;/tns:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="StartTrack_CRMR-input"
                                    name="StartTrack_CRMR"
                                    tibex:xpdlId="b81b2cba-16e4-4eb4-b378-a08d41483f10"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToStartTrack_CRMR"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileBSS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;PathMovedTappo&quot;/>&#xa;    &lt;xsl:param name=&quot;PathError&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckNomeFile&quot;/>&#xa;    &lt;xsl:template name=&quot;StartTrack_CRMR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputFileTappo>&#xa;            &lt;tns:FileName>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&#xa;            &lt;/tns:FileName>&#xa;            &lt;tns:LogName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns:LogName>&#xa;            &lt;tns:LogLevel>&#xa;                &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;            &lt;/tns:LogLevel>&#xa;            &lt;tns:ApplicationName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/tns:ApplicationName>&#xa;            &lt;tns:Estensione>&#xa;                &lt;xsl:value-of select=&quot;'.csv'&quot;/>&#xa;            &lt;/tns:Estensione>&#xa;            &lt;tns:Sistema>&#xa;                &lt;xsl:value-of select=&quot;'CRMR'&quot;/>&#xa;            &lt;/tns:Sistema>&#xa;            &lt;tns:Flusso>&#xa;                &lt;xsl:value-of select=&quot;$CheckNomeFile/tns1:FLUSSO&quot;/>&#xa;            &lt;/tns:Flusso>&#xa;            &lt;tns:PathError>&#xa;                &lt;xsl:value-of select=&quot;$PathError&quot;/>&#xa;            &lt;/tns:PathError>&#xa;            &lt;tns:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$PathMovedTappo&quot;/>&#xa;            &lt;/tns:PathMovedTappo>&#xa;        &lt;/tns:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFileBSS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;$currentElement/fileName&quot;/>&lt;/tns:FILE_NAME>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
