:trim(tns1:TIPO_RECORD)&quot;/>&lt;/TIPO_RECD>&lt;NUM_COLL>&lt;xsl:value-of select=&quot;tib:trim(tns1:NUMERO_DI_COLLEGAMENTO)&quot;/>&lt;/NUM_COLL>&lt;DATA_ATTIVAZIONE_COLL>&lt;xsl:value-of select=&quot;tib:trim(tns1:DATA_ATTIVAZIONE_COLLEGAMENTO)&quot;/>&lt;/DATA_ATTIVAZIONE_COLL>&lt;COD_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CLIENTE_ERRATO)&quot;/>&lt;/COD_CLIENTE_ERRATO>&lt;CF_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_FISCALE_CLIENTE_ERRATO)&quot;/>&lt;/CF_CLIENTE_ERRATO>&lt;PIVA_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:PARTITA_IVA_CLIENTE_ERRATO)&quot;/>&lt;/PIVA_CLIENTE_ERRATO>&lt;ROW_ID_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ROW_ID_CLIENTE_ERRATO)&quot;/>&lt;/ROW_ID_CLIENTE_ERRATO>&lt;COD_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_CLIENTE_BONIFICATO)&quot;/>&lt;/COD_CLIENTE_BONIFICATO>&lt;CF_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_FISCALE_CLIENTE_BONIFICATO)&quot;/>&lt;/CF_CLIENTE_BONIFICATO>&lt;PIVA_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:PARTITA_IVA_CLIENTE_BONIFICATO)&quot;/>&lt;/PIVA_CLIENTE_BONIFICATO>&lt;NOME_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:NOME_CLIENTE_BONIFICATO)&quot;/>&lt;/NOME_CLIENTE_BONIFICATO>&lt;COGNOME_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:COGNOME_CLIENTE_BONIFICATO)&quot;/>&lt;/COGNOME_CLIENTE_BONIFICATO>&lt;ROW_ID_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ROW_ID_CLIENTE_BONIFICATO)&quot;/>&lt;/ROW_ID_CLIENTE_BONIFICATO>&lt;ROW_ID_ASSET_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ROW_ID_ASSET_BONIFICATO)&quot;/>&lt;/ROW_ID_ASSET_BONIFICATO>&lt;DATA_BONIFICA>&lt;xsl:value-of select=&quot;tib:trim(tns1:DATA_BONIFICA)&quot;/>&lt;/DATA_BONIFICA>&lt;ANNOTAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:ANNOTAZIONE)&quot;/>&lt;/ANNOTAZIONE>&lt;TIPOLOGIA_BONIFICA>&lt;xsl:value-of select=&quot;ti