                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_BON_CRMR_GPDP_176_FILE (CONTENUTO_RECD,&#xa;  DESCR_ERRORE, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NUMERO_RECD,&#xa;  TMSP_INSMTO, DETT_ESITO, TIPO_RECD, NUM_COLL, DATA_ATTIVAZIONE_COLL,&#xa;  COD_CLIENTE_ERRATO, CF_CLIENTE_ERRATO, PIVA_CLIENTE_ERRATO,&#xa;  ROW_ID_CLIENTE_ERRATO, COD_CLIENTE_BONIFICATO, CF_CLIENTE_BONIFICATO,&#xa;  PIVA_CLIENTE_BONIFICATO, NOME_CLIENTE_BONIFICATO, COGNOME_CLIENTE_BONIFICATO,&#xa;  ROW_ID_CLIENTE_BONIFICATO, ROW_ID_ASSET_BONIFICATO, DATA_BONIFICA,&#xa;  ANNOTAZIONE, TIPOLOGIA_BONIFICA, STATO_SERVIZIO, DISTRETTO_LINEA,&#xa;  NUMERO_LINEA, NOME_CLIENTE_ERRATO, COGNOME_CLIENTE_ERRATO, USERNAME,&#xa;  VIA_NUMERO, CAP, CITTA, PROVINCIA, LINEA_PRESENTE_INSIEME_ORIG,&#xa;  FILLER)&#xa;  VALUES (RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xa;    ?, ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

