                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e3cde315-6cd4-48cb-a9ca-c166731358d9+input&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOW_BonificaClientiErrati_Tracciato&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns1:AllineamentoBonificaClientiErrati_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns1:AllineamentoBonificaClientiErrati_Dettaglio&quot;>&lt;Record>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:TIPO_RECORD,tns1:NUMERO_DI_COLLEGAMENTO,tns1:DATA_ATTIVAZIONE_COLLEGAMENTO,tns1:CODICE_CLIENTE_ERRATO,tns1:CODICE_FISCALE_CLIENTE_ERRATO,tns1:PARTITA_IVA_CLIENTE_ERRATO,tns1:ROW_ID_CLIENTE_ERRATO,tns1:CODICE_CLIENTE_BONIFICATO,tns1:CODICE_FISCALE_CLIENTE_BONIFICATO,tns1:PARTITA_IVA_CLIENTE_BONIFICATO,tns1:NOME_CLIENTE_BONIFICATO,tns1:COGNOME_CLIENTE_BONIFICATO,tns1:ROW_ID_CLIENTE_BONIFICATO,tns1:ROW_ID_ASSET_BONIFICATO,tns1:DATA_BONIFICA,tns1:TIPOLOGIA_BONIFICA,tns1:ANNOTAZIONE,tns1:STATO_SERVIZIO,tns1:DISTRETTO_LINEA,tns1:NUMERO_LINEA,tns1:NOME_CLIENTE_ERRATO,tns1:COGNOME_CLIENTE_ERRATO,tns1:USERNAME,tns1:VIA_E_NUMERO,tns1:CAP,tns1:CITTA,tns1:PROVI