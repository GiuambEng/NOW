NTE_BONIFICATO)&quot;/>&lt;/PIVA_CLIENTE_BONIFICATO>&lt;NOME_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:NOME_CLIENTE_BONIFICATO)&quot;/>&lt;/NOME_CLIENTE_BONIFICATO>&lt;COGNOME_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:COGNOME_CLIENTE_BONIFICATO)&quot;/>&lt;/COGNOME_CLIENTE_BONIFICATO>&lt;ROW_ID_CLIENTE_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ROW_ID_CLIENTE_BONIFICATO)&quot;/>&lt;/ROW_ID_CLIENTE_BONIFICATO>&lt;ROW_ID_ASSET_BONIFICATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ROW_ID_ASSET_BONIFICATO)&quot;/>&lt;/ROW_ID_ASSET_BONIFICATO>&lt;DATA_BONIFICA>&lt;xsl:value-of select=&quot;tib:trim(tns1:DATA_BONIFICA)&quot;/>&lt;/DATA_BONIFICA>&lt;ANNOTAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:ANNOTAZIONE)&quot;/>&lt;/ANNOTAZIONE>&lt;TIPOLOGIA_BONIFICA>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPOLOGIA_BONIFICA)&quot;/>&lt;/TIPOLOGIA_BONIFICA>&lt;STATO_SERVIZIO>&lt;xsl:value-of select=&quot;tib:trim(tns1:STATO_SERVIZIO)&quot;/>&lt;/STATO_SERVIZIO>&lt;DISTRETTO_LINEA>&lt;xsl:value-of select=&quot;tib:trim(tns1:DISTRETTO_LINEA)&quot;/>&lt;/DISTRETTO_LINEA>&lt;NUMERO_LINEA>&lt;xsl:value-of select=&quot;tib:trim(tns1:NUMERO_LINEA)&quot;/>&lt;/NUMERO_LINEA>&lt;NOME_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:NOME_CLIENTE_ERRATO)&quot;/>&lt;/NOME_CLIENTE_ERRATO>&lt;COGNOME_CLIENTE_ERRATO>&lt;xsl:value-of select=&quot;tib:trim(tns1:COGNOME_CLIENTE_ERRATO)&quot;/>&lt;/COGNOME_CLIENTE_ERRATO>&lt;USERNAME>&lt;xsl:value-of select=&quot;tib:trim(tns1:USERNAME)&quot;/>&lt;/USERNAME>&lt;VIA_NUMERO>&lt;xsl:value-of select=&quot;tib:trim(tns1:VIA_E_NUMERO)&quot;/>&lt;/VIA_NUMERO>&lt;CAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&lt;/CAP>&lt;CITTA>&lt;xsl:value-of select=&quot;tib:trim(tns1:CITTA)&quot;/>&lt;/CITTA>&lt;PROVINCIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:PROVINCIA)&quot;/>&lt;/PROVINCIA>&lt;LINEA_PRESENTE_INSIEME_ORIG>&lt;xsl:value-of select=&quot;tib:trim(tns1:LINEA_PRESENTE