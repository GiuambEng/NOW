                                <bpws:link
                                    name="Input_StagingToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToDatetime" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdate_InserToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcess1ToInsStaging" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToStartElaborazione" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty1ToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="LogRecordFinitiToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="afc944e6-2ab0-49fa-872e-addeb429bcd4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToParseData">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= (($JMSReceiveMessage/Body/ns21:queueResponse/ns21:NumeroRecord) div$Passo_AllineamentoConsistenze)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index <= (($JMSReceiveMessage/Body/ns21:queueResponse/ns21:NumeroRecord) div$Passo_AllineamentoConsistenze)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToParseData1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="96d126f4-43eb-4fc9-bcd4-31f7e011362e">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToGroupEnd"/>
                                    <bpws:target linkName="LogRecordFinitiToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DetailNoval-input"
                                    name="DetailNoval"
                                    outputVariable="DetailNoval"
                                    tibex:xpdlId="a9817e1b-260c-476b-b67e-0a284da5edb3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToParseData"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DetailNovalToEmpty1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+a9817e1b-260c-476b-b67e-0a284da5edb3+input&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Passo_AllineamentoConsistenze&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;DetailNoval-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;fileName>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/fileName>&lt;startRecord>&lt;xsl:value-of select=&quot;($index -1) * $Passo_AllineamentoConsistenze +2&quot;/>&lt;/startRecord>&lt;noOfRecords>&lt;xsl:value-of select=&quot;$Passo_AllineamentoConsistenze&quot;/>&lt;/noOfRecords>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:parse="http://ns.tibco.com/bw/palette/parse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/parse#//ParseData"/>
                                    <value
                                    continueOnError="true"
                                    dataFormat="dataFormatResource"
                                    encoding="ASCII"
                                    inputType="File"
                                    manuallySpecifiedStartRecord="true"
                                    skipBlankSpaces="true" xsi:type="parse:ParseData"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
