oRecord/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Data_Dec&quot;>&lt;tns:DATA_DEC>&lt;xsl:value-of select=&quot;tns1:Data_Dec&quot;/>&lt;/tns:DATA_DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Destinazione_Uso&quot;>&lt;tns:DESTINAZIONE_USO>&lt;xsl:value-of select=&quot;tns1:Destinazione_Uso&quot;/>&lt;/tns:DESTINAZIONE_USO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto_Telefonico&quot;>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;tns1:Distretto_Telefonico&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Flag_FTTH&quot;>&lt;tns:FLAG_FTTH>&lt;xsl:value-of select=&quot;tns1:Flag_FTTH&quot;/>&lt;/tns:FLAG_FTTH>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ID_Risorsa&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:ID_Risorsa&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:Numero_nativo_olo&quot;>&lt;tns:NUMERO_NATIVO_OLO>&lt;xsl:value-of select=&quot;tns1:Numero_nativo_olo&quot;/>&lt;/tns:NUMERO_NATIVO_OLO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Numero_Telefonico&quot;>&lt;tns:NUMERO_TELEFONICO>&lt;xsl:value-of select=&quot;tns1:Numero_Telefonico&quot;/>&lt;/tns:NUMERO_TELEFONICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Ora_Dec&quot;>&lt;tns:ORA_DEC>&lt;xsl:value-of select=&quot;tns1:Ora_Dec&quot;/>&lt;/tns:ORA_DEC>&lt;/xsl:if>&lt;tns:SISTEMA_COMPETENZA>&lt;xsl:value-of select=