                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_DBSS_ALMTO_FILE (CONTENUTO_RECD, DATA_DEC,&#xa;  DESTINAZIONE_USO, DESCR_ERRORE, DISTR_TELEFONICO, FAMIG_TECNICA,&#xa;  FLAG_FTTH, ID_RISORSA, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  NUMERO_RECD, NUMERO_NATIVO_OLO, TMSP_INSMTO, NUMERO_TELEFONICO,&#xa;  ORA_DEC, SISTEMA_COMPETENZA, STATO_ASSET)&#xa;  VALUES (RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

