                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="StartElaborazione-input"
                                    name="StartElaborazione"
                                    tibex:xpdlId="b13b3b82-b4ee-4030-9fe5-30c9c63f93c4"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
