                                    <bpws:targets>
                                    <bpws:target linkName="DatetimeToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Input_StagingToJDBCUpdate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.AllineamentoCRMR_Staging&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato&quot; xmlns:ns=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:param name=&quot;Passo_AllineamentoConsistenze&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputStaging&quot; match=&quot;/&quot;>&lt;tns:AllineamentoCRMR>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns1:AllineamentoCRMR_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns1:AllineamentoCRMR_Dettaglio&quot;>&lt;tns:AllineamentoCRMR_Dettaglio>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo_AllineamentoConsistenze * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;$ContenutoRecord/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns:Output_ContenutoRecord[ns:Posizione=$var]/ns:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Data_Dec&quot;>&lt;tns:DATA_DEC>&lt;xsl:value-of select=&quot;tns1:Data_Dec&quot;/>&lt;/tns:DATA_DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Destinazione_Uso&quot;>&lt;tns:DESTINAZIONE_USO>&lt;xsl:value-of select=&quot;tns1:Destinazione_Uso&quot;/>&lt;/tns:DESTINAZIONE_USO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto_Telefonico&quot;>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;tn