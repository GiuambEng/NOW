                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SA.ID_FILE, SA.ID_ESEC_PROCSO_FILE, SA.SISTEMA, SA.FLUSSO,&#xa;  SA.COD_PROCSO_FILE, SA.RECORD_STG_OK, SA.ID_TRACK, AFT.FILE_NAME,&#xa;  AFT.FOLDER, SA.STATO&#xa;  FROM STATO_ALLINEAMENTI SA, ALIGN_FILE_TRACKING AFT&#xa;  WHERE SA.ID_FILE = AFT.ID_FILE_INPUT AND SA.STATO='CHECK_OK' AND SA.FLUSSO = ?&#xa;    AND SA.FLAG_LETTURA IS NULL AND (SA.SISTEMA = 'CRMR' OR SA.SISTEMA = 'CRMBW')&#xa;    AND AFT.FLAG_LAVORATO = 'N'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SISTEMA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_PROCSO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RECORD_STG_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_TRACK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FILE_NAME"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FOLDER"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryStatoAllineamento&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Assettizzazione>&lt;xsl:for-each select=&quot;$QueryStatoAllineamento/Record[STATO='CHECK_OK']&quot;>&lt;tns:Assettizzazione_Input>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;xsl:if test=&quot;FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;ID_ESEC_PROCSO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;COD_PROCSO_FILE&quot;>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;COD_PROCSO_FILE&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;xsl:if test=&quot;ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;FILE_NAME&quot;>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;FILE_NAME&quot;/>&lt;/tns:FILE_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;FOLDER&quot;>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;FOLDER&quot;/>&lt;/tns:FOLDER>&lt;/xsl:if>&lt;/tns:Assettizzazione_Input>&lt;/xsl:for-each>&lt;/tns:Assettizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Mapper-input" name="Mapper"
                    outputVariable="Mapper"
                    tibex:xpdlId="23817a4c-da39-4e35-a1b4-bb97e0ee4e0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryToIterate1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToIterate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryStatoAllineamento&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Assettizzazione>&lt;xsl:for-each select=&quot;$QueryStatoAllineamento/Record[STATO='CHECK_OK']&quot;>&lt;tns:Assettizzazione_Input>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;xsl:if test=&quot;FLUSSO&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;FLUSSO&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;SISTEMA&quot;>&lt;tns:SISTEMA>&lt;xsl:value-of select=&quot;SISTEMA&quot;/>&lt;/tns:SISTEMA>&lt;/xsl:if>&lt;tns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;ID_ESEC_PROCSO_FILE&quot;/>&lt;/tns:ID_ESEC_PROCSO_FILE>&lt;xsl:if test=&quot;COD_PROCSO_FILE&quot;>&lt;tns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;COD_PROCSO_FILE&quot;/>&lt;/tns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;tns:LogName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LogName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;xsl:if test=&quot;ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;ID_TRACK&quot;/>&lt;/tns:ID_TRACK>&lt;/xsl:if>&lt;xsl:if test=&quot;FILE_NAME&quot;>&lt;tns:FILE_NAME>&lt;xsl:value-of select=&quot;FILE_NAME&quot;/>&lt;/tns:FILE_NAME>&lt;/xsl:if>&lt;xsl:if test=&quot;FOLDER&quot;>&lt;tns:FOLDER>&lt;xsl:value-of select=&quot;FOLDER&quot;/>&lt;/tns:FOLDER>&lt;/xsl:if>&lt;/tns:Assettizzazione_Input>&lt;/xsl:for-each>&lt;/tns:Assettizzazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
