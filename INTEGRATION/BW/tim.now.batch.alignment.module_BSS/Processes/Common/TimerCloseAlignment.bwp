            tibex:propertySource="/ConfigurationLog/LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/LogInfo" type="xsd:string"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLog/Application" type="xsd:string"/>
        <bpws:variable name="StartTimer" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/StartTimer" type="xsd:dateTime"/>
        <bpws:variable name="Intervallo" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timer/StartAllineamenti/IntervalloMinuti" type="xsd:int"/>
        <bpws:variable element="ns1:ChiusuraAllineamenti"
            name="CallCloseAlign-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:ListSystem" name="SystemName"/>
        <bpws:variable name="FlagAbilitaAllineamentoAccessi"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FlagAbilitaFlussi/AllineamentoAccessi" type="xsd:string"/>
        <bpws:variable name="FlagAbilitaQuadraturaDBSS"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/FlagAbilitaFlussi/QuadraturaDBSS" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
