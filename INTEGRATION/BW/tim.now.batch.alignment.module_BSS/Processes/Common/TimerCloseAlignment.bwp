        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToCallCloseAlign" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetSysNameToIterate" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="Timer"
                    tibex:xpdlId="57c1bf2a-12b2-4ae3-b2a7-fdb02c0cd967"
                    variable="Timer" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="StartTimer"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="Intervallo"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2016-08-20T16:10:18.356+0200"
                                    intervalUnit="Minute" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Timer&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Timer Verifica Stato Allineamento per Sistema CRMBW   ' ,$Timer/Time )&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStart-input" name="LogStart"
                    tibex:xpdlId="6c9e4623-6c56-4e72-a037-25bc39939a80"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToCallCloseAlign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Timer&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Timer Verifica Stato Allineamento per Sistema CRMBW   ' ,$Timer/Time )&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ListSystemName&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlagAbilitaAllineamentoAccessi&quot;/>&lt;xsl:param name=&quot;FlagAbilitaQuadraturaDBSS&quot;/>&lt;xsl:template name=&quot;SystemName&quot; match=&quot;/&quot;>&lt;tns:ListSystem>&lt;xsl:if test=&quot;$FlagAbilitaAllineamentoAccessi='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'CRMR'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;xsl:if test=&quot;$FlagAbilitaAllineamentoAccessi='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'CRMBW'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;xsl:if test=&quot;$FlagAbilitaQuadraturaDBSS='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'DBSS'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;/tns:ListSystem>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SystemName" name="SetSysName"
                    outputVariable="SystemName"
                    tibex:xpdlId="418c8432-1c32-4c64-b974-fc3067e6fea4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCallCloseAlign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetSysNameToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ListSystemName&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FlagAbilitaAllineamentoAccessi&quot;/>&lt;xsl:param name=&quot;FlagAbilitaQuadraturaDBSS&quot;/>&lt;xsl:template name=&quot;SystemName&quot; match=&quot;/&quot;>&lt;tns:ListSystem>&lt;xsl:if test=&quot;$FlagAbilitaAllineamentoAccessi='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'CRMR'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;xsl:if test=&quot;$FlagAbilitaAllineamentoAccessi='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'CRMBW'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;xsl:if test=&quot;$FlagAbilitaQuadraturaDBSS='S'&quot;>&lt;tns:Name>&lt;xsl:value-of select=&quot;'DBSS'&quot;/>&lt;/tns:Name>&lt;/xsl:if>&lt;/tns:ListSystem>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="SystemName" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="03c52504-1a4d-42ae-bf94-5027e69d8472">
                <bpws:targets>
                    <bpws:target linkName="SetSysNameToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$SystemName/tns:Name" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SystemName/tns:Name)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="tns:Iterate_Current_Element_Name"
                                    name="currentName" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallCloseAlign" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallCloseAlignToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="f02fd425-7770-4d8a-b879-403a984d1842" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallCloseAlign"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SystemName/tns:Name)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentName"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="d00e58a4-2631-4620-908b-9b624d84bdc7">
                                    <bpws:targets>
                                    <bpws:target linkName="CallCloseAlignToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;currentName&quot;/>&#xa;    &lt;xsl:template name=&quot;CallCloseAlign-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:ChiusuraAllineamenti>&#xa;            &lt;ns1:InputData>&#xa;                &lt;ns1:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;$currentName&quot;/>&#xa;                &lt;/ns1:SISTEMA>&#xa;                &lt;ns1:LogInfo>&#xa;                    &lt;ns1:LogInfoLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/ns1:LogInfoLevel>&#xa;                    &lt;ns1:LogName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/ns1:LogName>&#xa;                    &lt;ns1:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                    &lt;/ns1:ApplicationName>&#xa;                &lt;/ns1:LogInfo>&#xa;            &lt;/ns1:InputData>&#xa;        &lt;/ns1:ChiusuraAllineamenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallCloseAlign-input"
                                    name="CallCloseAlign"
                                    tibex:xpdlId="c83e2438-3b51-4b4d-96fe-9831d315e523"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallCloseAlign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallCloseAlignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;currentName&quot;/>&#xa;    &lt;xsl:template name=&quot;CallCloseAlign-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:ChiusuraAllineamenti>&#xa;            &lt;ns1:InputData>&#xa;                &lt;ns1:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;$currentName&quot;/>&#xa;                &lt;/ns1:SISTEMA>&#xa;                &lt;ns1:LogInfo>&#xa;                    &lt;ns1:LogInfoLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/ns1:LogInfoLevel>&#xa;                    &lt;ns1:LogName>&#xa;                        &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                    &lt;/ns1:LogName>&#xa;                    &lt;ns1:ApplicationName>&#xa;                        &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                    &lt;/ns1:ApplicationName>&#xa;                &lt;/ns1:LogInfo>&#xa;            &lt;/ns1:InputData>&#xa;        &lt;/ns1:ChiusuraAllineamenti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ChiusuraAllineamenti.CheckStatoAllineamenti" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="c539016f-51a2-4f7d-825e-81ec8d1aae17">
                <bpws:targets>
                    <bpws:target linkName="IterateToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
