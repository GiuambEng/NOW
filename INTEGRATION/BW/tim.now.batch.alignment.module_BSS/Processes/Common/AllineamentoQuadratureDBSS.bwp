            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="TrackFile-input"
                    name="TrackFile"
                    tibex:xpdlId="062108c1-0819-45d5-a949-6c235d807f02"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="KOLoggerTrackToCallProcess"/>
