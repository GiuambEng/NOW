                <sequence>
                    <element maxOccurs="1" minOccurs="1" name="fileName" type="string"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="startRecord" type="integer"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="noOfRecords" type="integer"/>
                    <element maxOccurs="1" minOccurs="0"
                        name="SkipHeaderCharacters" type="integer"/>
                </sequence>
            </complexType>
            <element name="Input" type="tns:Input"/>
        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+5bdd3850-774e-4067-93e9-d6f2da791391+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+5bdd3850-774e-4067-93e9-d6f2da791391+input">
            <complexType name="Input">
                <sequence>
                    <element maxOccurs="1" minOccurs="1" name="fileName" type="string"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="startRecord" type="integer"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="noOfRecords" type="integer"/>
                    <element maxOccurs="1" minOccurs="0"
                        name="SkipHeaderCharacters" type="integer"/>
                </sequence>
            </complexType>
            <element name="Input" type="tns:Input"/>
        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+7a8e516c-f725-4e38-bb1c-6e664b47fd54+output"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:Q1="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+7a8e516c-f725-4e38-bb1c-6e664b47fd54+output">
            <import namespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato"/>
            <import namespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato"/>
