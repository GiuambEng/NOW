                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Output_LogToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="0de825b7-4fdf-4c56-b663-d03dfaebd558">
                <bpws:targets>
                    <bpws:target linkName="UpCountToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToMapDetails"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
