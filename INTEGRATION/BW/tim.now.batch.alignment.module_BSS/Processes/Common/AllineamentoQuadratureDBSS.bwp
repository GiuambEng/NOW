                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ContenutoRecdAllineamentoConsistenze&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimiNoval&quot;/>&lt;xsl:param name=&quot;DetailNoval&quot;/>&lt;xsl:param name=&quot;PassoAllineamenti&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecord-input&quot; match=&quot;/&quot;>&lt;tns:ContenutoRecdQuadraturaDBSS_ContenutoRecd>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimiNoval/Rows/tns1:QuadraturaDBSS_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoval/Rows/tns1:QuadraturaDBSS_Dettaglio&quot;>&lt;tns:ContenutoRecdQuadraturaDBSS_InputContenutoRecd>&lt;xsl:if test=&quot;tns1:Id_Asset&quot;>&lt;tns:Id_Asset>&lt;xsl:value-of select=&quot;tns1:Id_Asset&quot;/>&lt;/tns:Id_Asset>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Asset_Num&quot;>&lt;tns:Asset_Num>&lt;xsl:value-of select=&quot;tns1:Asset_Num&quot;/>&lt;/tns:Asset_Num>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Data_Dec&quot;>&lt;tns:Data_Dec>&lt;xsl:value-of select=&quot;tns1:Data_Dec&quot;/>&lt;/tns:Data_Dec>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Stato&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;tns1:Stato&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Flag_Ftth&quot;>&lt;tns:Flag_Ftth>&lt;xsl:value-of select=&quot;tns1:Flag_Ftth&quot;/>&lt;/tns:Flag_Ftth>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Id_Risorsa&quot;>&lt;tns:Id_Risorsa>&lt;xsl:value-of select=&quot;tns1:Id_Risorsa&quot;/>&lt;/tns:Id_Risorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DU_Fonia&quot;>&lt;tns:DU_Fonia>&lt;xsl:value-of select=&quot;tns1:DU_Fonia&quot;/>&lt;/tns:DU_Fonia>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DU_Dati&quot;>&lt;tns:DU_Dati>&lt;xsl:value-of select=&quot;tns1:DU_Dati&quot;/>&lt;/tns:DU_Dati>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;(($PassoAllineamenti * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecord>&lt;/tns:ContenutoRecdQuadraturaDBSS_InputContenutoRecd>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns1:QuadraturaDBSS_Dettaglio&quot;>&lt;tns:ContenutoRecdQuadraturaDBSS_InputContenutoRecd>&lt;xsl:if test=&quot;tns1:Id_Asset&quot;>&lt;tns:Id_Asset>&lt;xsl:value-of select=&quot;tns1:Id_Asset&quot;/>&lt;/tns:Id_Asset>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Asset_Num&quot;>&lt;tns:Asset_Num>&lt;xsl:value-of select=&quot;tns1:Asset_Num&quot;/>&lt;/tns:Asset_Num>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Data_Dec&quot;>&lt;tns:Data_Dec>&lt;xsl:value-of select=&quot;tns1:Data_Dec&quot;/>&lt;/tns:Data_Dec>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Stato&quot;>&lt;tns:Stato>&lt;xsl:value-of select=&quot;tns1:Stato&quot;/>&lt;/tns:Stato>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Flag_Ftth&quot;>&lt;tns:Flag_Ftth>&lt;xsl:value-of select=&quot;tns1:Flag_Ftth&quot;/>&lt;/tns:Flag_Ftth>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Id_Risorsa&quot;>&lt;tns:Id_Risorsa>&lt;xsl:value-of select=&quot;tns1:Id_Risorsa&quot;/>&lt;/tns:Id_Risorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DU_Fonia&quot;>&lt;tns:DU_Fonia>&lt;xsl:value-of select=&quot;tns1:DU_Fonia&quot;/>&lt;/tns:DU_Fonia>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DU_Dati&quot;>&lt;tns:DU_Dati>&lt;xsl:value-of select=&quot;tns1:DU_Dati&quot;/>&lt;/tns:DU_Dati>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;(($PassoAllineamenti * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecord>&lt;/tns:ContenutoRecdQuadraturaDBSS_InputContenutoRecd>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ContenutoRecdQuadraturaDBSS_ContenutoRecd>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
