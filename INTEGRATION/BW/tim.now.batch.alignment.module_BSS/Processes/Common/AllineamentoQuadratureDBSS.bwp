                                <bpws:link name="LogOKStagingToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToLogRecordFiniti" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="LogRecordFinitiToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
