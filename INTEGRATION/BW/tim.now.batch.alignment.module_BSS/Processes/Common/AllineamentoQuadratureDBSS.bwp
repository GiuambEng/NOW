        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+5bdd3850-774e-4067-93e9-d6f2da791391+output"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:Q1="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+5bdd3850-774e-4067-93e9-d6f2da791391+output">
            <import namespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato"/>
            <import namespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_Tracciato"/>
