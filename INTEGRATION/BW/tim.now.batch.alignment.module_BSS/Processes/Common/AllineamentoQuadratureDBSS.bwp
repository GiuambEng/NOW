                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathError&quot;/>&lt;xsl:param name=&quot;PathMove&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;Offset&quot;/>&lt;xsl:param name=&quot;PathScarto&quot;/>&lt;xsl:template name=&quot;MapDetails-input&quot; match=&quot;/&quot;>&lt;tns:Details>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathError&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;NomeTabellaScarto&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;'STAG_QUADRATURE_DBSS'&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;DestinationPathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$PathMove&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;SourcePathFile&amp;quot;&quot;/>&lt;/tns:NOME>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;Offset&amp;quot;&quot;/>&lt;/tns:NOME>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$Offset&quot;/>&lt;/tns:VALORE>&lt;/tns:InputDetails>&lt;tns:InputDetails>&lt;tns:NOME>&lt;xsl:value-of select=&quot;&amp;quot;PathFileScarto&amp;quot;&