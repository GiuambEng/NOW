                                    sqlStatement="SELECT ID_RISORSA&#xa;  FROM APPUSER.STAG_DBSS_ALMTO_FILE&#xa;  WHERE ID_FILE_PROCSTO_INPUT = ? AND ID_STATO_ELAB_STAG = 6&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

