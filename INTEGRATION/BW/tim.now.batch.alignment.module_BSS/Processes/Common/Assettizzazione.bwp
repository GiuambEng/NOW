                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ec56958b-1710-44d9-a316-56a16661acf9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectIDRisorsa&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:template name=&quot;TempStoricoAsset-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcUpdateActivityInput>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectIDRisorsa/Record[number($index1)]/ID_RISORSA)&quot;>&lt;xsl:value-of select=&quot;$SelectIDRisorsa/Record[number($index1)]/ID_RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($_error/Msg)>0&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;$_error/Msg&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;'ERRORE CHIAMATA FIND NEL PROCESSO ASSETTIZZAZIONE'&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;STATO>&lt;xsl:value-of select=&quot;'KO_BW'&quot;/>&lt;/STATO>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns:ID_FILE)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
