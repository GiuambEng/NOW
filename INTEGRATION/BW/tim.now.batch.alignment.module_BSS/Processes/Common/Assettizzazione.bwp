                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Assettizzazione&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;xsl:if test=&quot;$Start/tns:Application&quot;>&lt;tns1:Application>&lt;xsl:value-of select=&quot;$Start/tns:Application&quot;/>&lt;/tns1:Application>&lt;/xsl:if>&lt;tns1:Message>&lt;xsl:value-of select=&quot;'Start Assettizzazione'&quot;/>&lt;/tns1:Message>&lt;xsl:if test=&quot;$Start/tns:LogName&quot;>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$Start/tns:LogName&quot;/>&lt;/tns1:LoggerName>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:LogLevel&quot;>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$Start/tns:LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;/xsl:if>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
