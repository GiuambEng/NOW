            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="36d8c34f-d7c0-4b39-951a-dbc32157ac4b">
                <bpws:targets>
                    <bpws:target linkName="JDBCStatoAllToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToLogFine"/>
                </bpws:sources>
                <bpws:sequence name="sequence1" tibex:group="iterate">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$JDBCStatoAll/Record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
