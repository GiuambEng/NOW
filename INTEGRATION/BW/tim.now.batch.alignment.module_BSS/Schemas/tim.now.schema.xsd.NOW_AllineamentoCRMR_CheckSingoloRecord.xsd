<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_CheckSingoloRecord" xmlns:tns="http://www.example.org/tim.now.schema.xsd.NOW_AllineamentoCRMR_CheckSingoloRecord" elementFormDefault="qualified">

    <element name="AllineamentoCRMR_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Data_Dec" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<pattern
    							value="(19|20)[0-9][0-9](0[0-9]|1[0-2])([0-2][0-9]|3[0-1])">
    						</pattern>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Ora_Dec" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<pattern
    							value="([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]">
    						</pattern>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_Risorsa" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Numero_Telefonico" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Stato_Asset" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    						<enumeration value="Cessato"></enumeration>
    						<enumeration value="Attivo"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Flag_FTTH" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="N"></enumeration>
    						<enumeration value="Y"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Destinazione_Uso" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="1"></enumeration>
    						<enumeration value="2"></enumeration>
    						<enumeration value="3"></enumeration>
    						<enumeration value="4"></enumeration>
    						<enumeration value="5"></enumeration>
    						<enumeration value="9"></enumeration>
    						<enumeration value="10"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Numero_nativo_olo" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="Y"></enumeration>
    						<enumeration value="N"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Distretto_Telefonico" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="10"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ID_Risorsa_new" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Numero_Telefonico_new" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="30"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Timestamp" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Numero_Record" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="AllineamentoCRMR">
    	<complexType>
    		<sequence>
    			<element ref="tns:AllineamentoCRMR_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>