<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/Assettizzazione" xmlns:tns="http://www.example.org/Assettizzazione" elementFormDefault="qualified">





    <element name="Assettizzazione_Input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="FLUSSO" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="SISTEMA" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="ID_ESEC_PROCSO_FILE" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="COD_PROCSO_FILE" type="string"></element>
    			<element maxOccurs="1" minOccurs="0"  name="Application" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="LogName" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="LogLevel" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="NumTotRecord" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="ID_TRACK" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="FILE_NAME" type="string"></element>
    			<element maxOccurs="1" minOccurs="0" name="FOLDER" type="string"></element>
    	   		</sequence>
    	</complexType>
    </element>
    
    
    
    <element name="Assettizzazione">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:Assettizzazione_Input"/>
    		</sequence>
    	</complexType>
  </element>
</schema>