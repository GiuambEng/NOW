<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
targetNamespace="www.tim.now.stagingSecoloGetToken"
xmlns="www.tim.now.stagingSecoloGetToken"
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
<xs:element name="Output">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="end" type="xs:string" maxOccurs="1" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
	<xs:element name="Input">
		<xs:complexType>
			<xs:choice>
				<xs:element name="Insert">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IdEsecProcNoFile" type="xs:string" minOccurs="0" />
							<xs:element name="Funzione" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ChiaveRiferimento" minOccurs="0" type="xs:string" />
							<xs:element name="Operatore" minOccurs="0" type="xs:string" />
							<xs:element name="TransactionID" minOccurs="0" type="xs:string" />
							<xs:element name="IP_CLIENT" minOccurs="0" type="xs:string" />
							<xs:element name="CONTENUTO_REQUEST" minOccurs="0" type="xs:string" />
							<xs:element name="ID_STATO_ELAB_STAGING" minOccurs="0" type="xs:string" />
							<xs:element name="TimeReq" type="xs:dateTime" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TimeResp" type="xs:dateTime" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ResponseCode" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="BusinessID" minOccurs="0" type="xs:string" />
							<xs:element name="Servizio" minOccurs="0" type="xs:string" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Update">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IdEsecProcNoFile" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ResponseCode" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="BusinessID" minOccurs="0" type="xs:string" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="UpdateOnError">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ID_STATO_ELAB_STAG"
								type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="IdEsecProcsoNoFile"
								type="xs:integer" />
							<xs:element name="BusinessID" minOccurs="0" type="xs:string" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>
