<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/">
	<element name="RequestVerificaRollout">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="CodificaOLOAGCOM" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodificaOloNumerico" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Offerta" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Lavorazione" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceIstatComune" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagReferente" type="boolean"/>
				<element maxOccurs="1" minOccurs="0" name="FlagClienteFinale" type="boolean"/>
				<element maxOccurs="1" minOccurs="0" name="CodiceOrdineOLO" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="ResponseVerificaRollout">
		<complexType>
			<sequence>
			<element maxOccurs="1" minOccurs="0" name="TOKENIZZAZIONE_RECAPITI">
			<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="SI"/>
							<enumeration value="NO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="TOKENIZZAZIONE">
			<simpleType>
						<restriction base="string">
							<enumeration value="C2PLUS"/>
							<enumeration value="D420"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="ESITO">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<enumeration value="OK"/>
							<enumeration value="KO"/>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
	<element name="Fault">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="RETURN_CODE" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="DESCRIZIONE" type="string"/>
			</sequence>
		</complexType>
	</element>
    <element name="operationRequest">
    <complexType>
      <sequence>
        <element name="in" type="string"/>
      </sequence>
    </complexType>
  </element>
    <element name="operationResponse">
    <complexType>
      <sequence>
        <element name="out" type="string"/>
      </sequence>
    </complexType>
  </element>
</schema>
