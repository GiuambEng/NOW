    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToInsertStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogStartToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogStartToUpdateOnErrorStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="InsertStagingToLogEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateStagingToLogEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateOnErrorStagingToLogEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogEndToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateOnErrorStagingToCallProcess" tibex:linkType="ERROR"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="f5426120-83e2-43f8-9259-ab35f4471f39"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
