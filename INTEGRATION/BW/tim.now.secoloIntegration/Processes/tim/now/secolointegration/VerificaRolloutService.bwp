                <bpws:sources>
                    <bpws:source linkName="Check_ReferenteClienteFinaleToCheckOfferteD2PLUS">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:FlagReferente=true() or $VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:FlagClienteFinale=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaRollout_NOWSecoloIn.Input/ns5:FlagReferente=true() or $VerificaRollout_NOWSecoloIn.Input/ns5:FlagClienteFinale=true()]]></bpws:transitionCondition>
                    </bpws:source>
