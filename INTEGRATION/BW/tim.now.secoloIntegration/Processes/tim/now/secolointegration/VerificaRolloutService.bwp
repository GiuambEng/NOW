            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9bf8dabc-07e5-40ad-8544-aea3076bb8b3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn&quot;/>&lt;xsl:template name=&quot;JDBCQueryRolloutSECOLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;LAVORAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:Lavorazione)&quot;>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:Lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/LAVORAZIONE>&lt;OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:Offerta)&quot;>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OFFERTA>&lt;Codifica_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodificaOLOAGCOM)&quot;>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodificaOLOAGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Codifica_OLO_AGCOM>&lt;CodiceISP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodificaOloNumerico)&quot;>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodificaOloNumerico&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceISP>&lt;CodiceIstatComune>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceIstatComune)&quot;>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceIstatComune&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceIstatComune>&lt;DataRichiesta>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&lt;/DataRichiesta>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="QueryRolloutD420-input"
                    name="QueryRolloutD420"
                    outputVariable="QueryRolloutD420"
                    tibex:xpdlId="9bf8dabc-07e5-40ad-8544-aea3076bb8b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckOfferteD2PLUSToQueryRolloutD2PLUS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryRolloutD2PLUSToCopy_1_OutputQUERY"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9bf8dabc-07e5-40ad-8544-aea3076bb8b3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryRolloutSECOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:Lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:Lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVORAZIONE>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;Codifica_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Codifica_OLO_AGCOM>&#xa;            &lt;CodiceISP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOloNumerico)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOloNumerico&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceISP>&#xa;            &lt;CodiceIstatComune>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodiceIstatComune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodiceIstatComune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceIstatComune>&#xa;            &lt;DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&#xa;            &lt;/DataRichiesta>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select l.tipolg_lavrz as LAVORAZIONE, o.nome_offerta_esterna as OFFERTA, r.CODIFICA_OLO_AGCOM, r.CODICE_ISP, r.CODICE_ISTAT_COMUNE,  r.DATA_INIZIO_VAL as Data_Inizio, r.DATA_FINE_VAL as Data_Fine&#xa;from rollout_secolo_del_420 r, TIPOLG_LAVRZ l, TRASCODFC_OFFERTA o&#xa;WHERE r.IDTPLG_LAVRZ = l.idtplg_lavrz&#xa;and r.ID_TRASCODFC_OFFERTA=o.id_trascodfc_offerta&#xa;and upper(l.tipolg_lavrz) in (?,'ALL') --'LAVORAZIONE'&#xa;and upper(o.nome_offerta_esterna) in (?,'ALL')--'OFFERTA' &#xa;and r.CODIFICA_OLO_AGCOM in (?,'*') &#xa;and r.CODICE_ISP in (?,'*') -- CODIFICA OLO NUMERICO&#xa;and r.CODICE_ISTAT_COMUNE in (?,'*') -- CODICE COMUNE&#xa;and To_Date(?,'yyyymmdd-hh24miss') between r.DATA_INIZIO_VAL and r.DATA_FINE_VAL --DATA RICHIESTA"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVORAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Codifica_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceIstatComune"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DataRichiesta"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICA_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICE_ISP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICE_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckOfferteD420" tibex:xpdlId="e71cd05d-0211-4605-b62f-f2495637d096">
                <bpws:targets>
                    <bpws:target linkName="Check_ReferenteClienteFinaleToCheckOfferteD2PLUS"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckOfferteD2PLUSToQueryRolloutD2PLUS">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;FIXEDWIRELESSACCESS&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;UBBSEMIGPON&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;UBBFULLGPON&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;SEMIGPON1BPNRR&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;FULLGPON1BPNRR&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;NPNG&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;FIBERSTREAM&quot; and&#xd;&#xa;$VerificaRollout_NOWSecoloIn/Input/ns5:RequestVerificaRollout/ns5:Offerta!=&quot;FWAITALIA1GIGASARDEGNA&quot; and&#xd;&#xa;(count($QueryOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO)=0 or $QueryOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO='0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="FIXEDWIRELESSACCESS" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="UBBSEMIGPON" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="UBBFULLGPON" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="SEMIGPON1BPNRR" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="FULLGPON1BPNRR" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="NPNG" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="FIBERSTREAM" and$VerificaRollout_NOWSecoloIn.Input/ns5:Offerta!="FWAITALIA1GIGASARDEGNA" and(count($QueryOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO)=0 or $QueryOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO='0')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckOfferteD2PLUSToCopy_1_LOGINPUT">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
