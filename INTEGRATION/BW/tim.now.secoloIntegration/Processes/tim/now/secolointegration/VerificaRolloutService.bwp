                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+87a5ba5e-ea65-404d-9b57-e576b35eab4e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryRolloutSECOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:Lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:Lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVORAZIONE>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/OFFERTA>&#xa;            &lt;Codifica_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Codifica_OLO_AGCOM>&#xa;            &lt;CodiceISP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOloNumerico)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodificaOloNumerico&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceISP>&#xa;            &lt;CodiceIstatComune>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaRollout_NOWSecoloIn.Input/tns1:CodiceIstatComune)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodiceIstatComune&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceIstatComune>&#xa;            &lt;DataRichiesta>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01]-[H01][m01][s01]&amp;quot;)&quot;/>&#xa;            &lt;/DataRichiesta>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select l.tipolg_lavrz as LAVORAZIONE, o.nome_offerta_esterna as OFFERTA, r.CODIFICA_OLO_AGCOM, r.CODICE_ISP, r.CODICE_ISTAT_COMUNE,  r.DATA_INIZIO_VALIDITA as Data_Inizio, r.DATA_FINE_VALIDITA as Data_Fine&#xa;from rollout_secolo r, TIPOLG_LAVRZ l, TRASCODFC_OFFERTA o&#xa;WHERE r.ID_TIPOLOGIA_LAVORAZIONE = l.idtplg_lavrz&#xa;and r.ID_TRASCODIFICA_OFFERTA =o.id_trascodfc_offerta&#xa;and upper(l.tipolg_lavrz) in (?,'ALL') --'LAVORAZIONE'&#xa;and upper(o.nome_offerta_esterna) in (?,'ALL')--'OFFERTA' &#xa;and r.CODIFICA_OLO_AGCOM in (?,'*') &#xa;and r.CODICE_ISP in (?,'*') -- CODIFICA OLO NUMERICO&#xa;and r.CODICE_ISTAT_COMUNE in (?,'*') -- CODICE COMUNE&#xa;and To_Date(?,'yyyymmdd-hh24miss') between r.DATA_INIZIO_VALIDITA and r.DATA_FINE_VALIDITA --DATA RICHIESTA"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVORAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Codifica_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceISP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceIstatComune"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DataRichiesta"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICA_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICE_ISP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICE_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATA_FINE"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;QueryRolloutC2PLUS&quot;/>&lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn&quot;/>&lt;xsl:template name=&quot;OutputQUERY_C2PLUS-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'VerificaRolloutService'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceOrdineOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceOrdineOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;OutputQuery:&amp;quot;, tib:render-xml($QueryRolloutC2PLUS, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OutputQUERY_C2PLUS-input"
                    name="OutputQUERY_C2PLUS"
                    tibex:xpdlId="c70d7e28-ebef-4aaf-93d8-44cf1f366155"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryRolloutSECOLOToCopy_1_Start_VerificaRollout"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OutputQUERYToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryRolloutC2PLUS/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($QueryRolloutC2PLUS/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OutputQUERY_C2PLUSToCopy_1_LOG_OffertaKO1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryRolloutC2PLUS&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputQUERY_C2PLUS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaRolloutService'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;xsl:if test=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodiceOrdineOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn.Input/tns1:CodiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OutputQuery:&amp;quot;, tib:render-xml($QueryRolloutC2PLUS, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
