            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;VerificaRollout_NOWSecoloIn&quot;/>&lt;xsl:template name=&quot;LOGINPUT-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'VerificaRolloutService'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceOrdineOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceOrdineOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaRollout INPUT:&amp;quot;,$VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout/tns1:CodiceOrdineOLO,&amp;quot; - &amp;quot;, tib:render-xml($VerificaRollout_NOWSecoloIn/Input/tns1:RequestVerificaRollout,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOGINPUT-input" name="LOGINPUT"
