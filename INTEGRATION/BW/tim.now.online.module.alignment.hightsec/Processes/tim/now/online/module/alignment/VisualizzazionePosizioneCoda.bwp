                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+960ef1b9-a85c-4873-8b91-1373f3492c53+input&quot; xmlns:ns1=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoOUT&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://xmlns.example.com/VisualizzazionePosizioneCoda/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;UnicaRA&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_Http_UnicaRA&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoSequence&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagUnicaRA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;CONTENUTO_REQUEST>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($UnicaRA, true(), true())&quot;/>&#xa;            &lt;/CONTENUTO_REQUEST>&#xa;            &lt;CONTENUTO_RESPONSE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Call_Http_UnicaRA, true(), true())&quot;/>&#xa;            &lt;/CONTENUTO_RESPONSE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Call_Http_UnicaRA/ns1:DescrizioneEsito) >0&quot;>&#xa;                    &lt;DESCR_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Call_Http_UnicaRA/ns1:DescrizioneEsito&quot;/>&#xa;                    &lt;/DESCR_ESITO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Call_Http_UnicaRA/ns1:Esito) >0&quot;>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Call_Http_UnicaRA/ns1:Esito&quot;/>&#xa;                    &lt;/ESITO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Call_Http_UnicaRA/ns1:EsitoTelefonico) >0&quot;>&#xa;                    &lt;ESITO_TELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Call_Http_UnicaRA/ns1:EsitoTelefonico)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Call_Http_UnicaRA/ns1:EsitoTelefonico&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ESITO_TELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ESITO_TELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/ESITO_TELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;ID_RICH>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperoSequence/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/ID_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Call_Http_UnicaRA/ns1:Esito=(&amp;quot;202&amp;quot;,&amp;quot;400&amp;quot;,&amp;quot;500&amp;quot;)&quot;>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Call_Http_UnicaRA/ns1:LunghezzaCoda) >0&quot;>&#xa;                    &lt;LUNGHEZZA_CODA>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Call_Http_UnicaRA/ns1:LunghezzaCoda)&quot;/>&#xa;                    &lt;/LUNGHEZZA_CODA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;LUNGHEZZA_CODA>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/LUNGHEZZA_CODA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperoDistretto/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&#xa;                    &lt;NUMERO_TELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;substring(tib:trim(substring($get.parameters/tns2:idRisorsa, 1, 12)), 4)&quot;/>&#xa;                    &lt;/NUMERO_TELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMERO_TELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($get.parameters/tns2:idRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$get.parameters/tns2:idRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMERO_TELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Call_Http_UnicaRA/ns1:PosizioneOrdinativo) >0&quot;>&#xa;                    &lt;POSIZIONE_ORDINATIVO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Call_Http_UnicaRA/ns1:PosizioneOrdinativo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Call_Http_UnicaRA/ns1:PosizioneOrdinativo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/POSIZIONE_ORDINATIVO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;POSIZIONE_ORDINATIVO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/POSIZIONE_ORDINATIVO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_RICH>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_UNICARA(CONTENUTO_REQUEST,CONTENUTO_RESPONSE,DESCR_ESITO,ESITO,ESITO_TELEFONICO,ID_ESEC_PROCSO_NO_FILE,ID_RICH,ID_STATO_ELAB_STAG,LUNGHEZZA_CODA,NUMERO_TELEFONICO,POSIZIONE_ORDINATIVO,TIMSTP_RICH)&#xa;VALUES (?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_REQUEST"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RESPONSE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_ESITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO_TELEFONICO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_RICH"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_STATO_ELAB_STAG"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="LUNGHEZZA_CODA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_TELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="POSIZIONE_ORDINATIVO"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RICH"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
