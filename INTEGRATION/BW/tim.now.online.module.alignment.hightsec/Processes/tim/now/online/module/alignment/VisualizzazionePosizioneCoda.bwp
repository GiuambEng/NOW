                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TA.DESCR, O.DISTRETTO&#xa;FROM TIPOLG_ACCS TA&#xa;LEFT JOIN OFFERTA OFF ON TA.IDTPLG_ACCS = OFF.IDTPLG_ACCS&#xa;LEFT JOIN BDS_1_CASEDATA_RICHIESTA R ON R.IDOFFERTA = OFF.ID_OFFERTA&#xa;LEFT JOIN BDS_1_CASEDATA_ORDINE O ON O.IDRISORSA = R.IDRISORSA&#xa;WHERE O.IDRISORSA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="idRisorsa"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="DISTRETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN&quot; xmlns:tns=&quot;http://xmlns.example.com/VisualizzazionePosizioneCoda/parameters&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;get&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoDistretto&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_Http_UnicaRA-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:SERVIZIO>&#xa;            &lt;xsl:attribute name=&quot;nome&quot;>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;VisualizzaPosizione&amp;quot;&quot;/>&#xa;            &lt;/xsl:attribute>&#xa;            &lt;ns2:Input>&#xa;                &lt;xsl:if test=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;>&#xa;                    &lt;ns2:Distretto>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperoDistretto/Record[1]/DISTRETTO&quot;/>&#xa;                    &lt;/ns2:Distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RecuperoDistretto/Record[1]/DESCR = &amp;quot;DATI&amp;quot;&quot;>&#xa;                        &lt;ns2:IdTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;substring(tib:trim(substring($get/parameters/tns:visualizzazioneposizionecodaGetParameters/tns:idRisorsa, 1, 12)), 4)&quot;/>&#xa;                        &lt;/ns2:IdTelefonico>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns2:IdTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$get/parameters/tns:visualizzazioneposizionecodaGetParameters/tns:idRisorsa&quot;/>&#xa;                        &lt;/ns2:IdTelefonico>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns2:Input>&#xa;        &lt;/ns2:SERVIZIO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
