                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_UNICARA(CONTENUTO_REQUEST,DESCR_ERRORE,ID_ESEC_PROCSO_NO_FILE,ID_RICH,ID_STATO_ELAB_STAG,TIMSTP_RICH)&#xa;VALUES (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

