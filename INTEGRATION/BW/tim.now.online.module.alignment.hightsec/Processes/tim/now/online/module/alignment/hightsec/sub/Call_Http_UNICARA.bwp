                    <bpws:targets>
                        <bpws:target linkName="LogOutputUnicaRAToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoOUT&quot; xmlns:tns1=&quot;http://www.example.org/UnicaRA_PosizioneCoda&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseJSON&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:if test=&quot;$ParseJSON/tns1:esitoTelefonico&quot;>&lt;tns:EsitoTelefonico>&lt;xsl:value-of select=&quot;$ParseJSON/tns1:esitoTelefonico&quot;/>&lt;/tns:EsitoTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseJSON/tns1:posizioneOrdinativo&quot;>&lt;tns:PosizioneOrdinativo>&lt;xsl:value-of select=&quot;$ParseJSON/tns1:posizioneOrdinativo&quot;/>&lt;/tns:PosizioneOrdinativo>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseJSON/tns1:lunghezzaCoda&quot;>&lt;tns:LunghezzaCoda>&lt;xsl:value-of select=&quot;$ParseJSON/tns1:lunghezzaCoda&quot;/>&lt;/tns:LunghezzaCoda>&lt;/xsl:if>&lt;tns:Esito>&lt;xsl:value-of select=&quot;$ParseJSON/tns1:esito&quot;/>&lt;/tns:Esito>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;$ParseJSON/tns1:descrizione_esito&quot;/>&lt;/tns:DescrizioneEsito>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
