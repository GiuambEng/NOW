<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/VisualizzazionePosizioneCoda" xmlns:tns="http://www.example.org/VisualizzazionePosizioneCoda" elementFormDefault="qualified">

    <complexType name="VisualizzazionePosizioneCoda_Output">
    	<sequence>
    		<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="result">
    			<complexType>
    				<sequence>
    					<element name="severity" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    					<element name="details" type="string" maxOccurs="1" minOccurs="0"></element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>

    <element name="VisualizzazionePosizioneCoda_Fault">
    	<complexType>
    		<sequence>
    			<element name="message" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="VisualizzazionePosizioneCoda_Input">
    	<complexType>
    		<sequence>
    			<element name="Id_Risorsa" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Id_Telefonico" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Nome_Servizio" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="VisualizzazionePosizioneCoda_Output"
    	type="tns:VisualizzazionePosizioneCoda_Output">
    </element>
</schema>