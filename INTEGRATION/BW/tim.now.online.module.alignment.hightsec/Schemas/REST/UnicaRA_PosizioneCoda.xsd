<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/UnicaRA_PosizioneCoda" xmlns:tns="http://www.example.org/UnicaRA_PosizioneCoda" elementFormDefault="qualified">

    <element name="posizioneCoda_Input">
    	<complexType>
    		<sequence>
    			<element name="telefonico" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="distretto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="clli" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="posizioneCoda_Output">
    	<complexType>
    		<sequence>
    			<element name="esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="descrizione_esito" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="esitoTelefonico" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="posizioneOrdinativo" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="lunghezzaCoda" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>