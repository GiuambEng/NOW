            tibex:propertySource="/Connection/DB/Timeout" type="xsd:int"/>
        <bpws:variable name="MaxRows" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connection/DB/MaxRows" type="xsd:int"/>
