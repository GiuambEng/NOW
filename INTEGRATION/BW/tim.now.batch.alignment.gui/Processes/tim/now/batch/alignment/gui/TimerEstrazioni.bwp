    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="d4ae2fe9-755c-42ff-9109-410715b6dfb3">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links/>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogError-input"
                                name="LogError"
                                outputVariable="Copy_1_LogStart"
                                tibex:xpdlId="c1496d14-46c2-41e6-887c-0ba228a93287"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets/>
                                <bpws:sources/>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevelError&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'timerStartEstrazioni'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Errore nel processo TimerEstrazioni.' &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevelError&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerStartEstrazioneToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetDayToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartEstrazioniToIterate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartEstrazioniToLogNoRecord" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogNoRecordToLogEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="IterateToLogEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogEndToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="TimerStartEstrazione"
                    tibex:xpdlId="e7e7428e-ad7e-4b97-b559-61fb231c0f80"
                    variable="TimerStartEstrazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerStartEstrazioneToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="DateTime"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="Interval"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2018-05-15T10:04:17.260+0200" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="62585f21-3489-400e-8bdc-f321f80030bd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerStartEstrazioneToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'timerStartEstrazioni'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Start processo estrazioni gui'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Day"
                    name="SetDay" outputVariable="Day"
                    tibex:xpdlId="7b0dda06-b499-4781-8e6e-a305de45b525" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetDayToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="tib:pad-front(string(day-from-date(current-date())), 2, '0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Day" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="StartEstrazioni-input"
                    name="StartEstrazioni"
                    outputVariable="StartEstrazioni"
                    tibex:xpdlId="b6b1a6a7-5c2a-45a1-b71e-f577cc198d93"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetDayToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartEstrazioniToCopy_1_LogStart">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartEstrazioniToIterate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartEstrazioniToLogNoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SystemName&quot;/>&lt;xsl:param name=&quot;IdSystem&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Day&quot;/>&lt;xsl:template name=&quot;StartEstrazioni-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:InputData>&lt;ns:SystemName>&lt;xsl:value-of select=&quot;$SystemName&quot;/>&lt;/ns:SystemName>&lt;ns:IDSystem>&lt;xsl:value-of select=&quot;$IdSystem&quot;/>&lt;/ns:IDSystem>&lt;ns:DayEstrazione>&lt;xsl:value-of select=&quot;$Day&quot;/>&lt;/ns:DayEstrazione>&lt;ns:LogInfo>&lt;ns:ApplicationName>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/ns:ApplicationName>&lt;ns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/ns:LoggerName>&lt;ns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/ns:LogLevel>&lt;/ns:LogInfo>&lt;/ns:InputData>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.Estrazioni.Main_StartEstrazioni_Full_INTFRC" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogNoRecord-input"
                    name="LogNoRecord" outputVariable="Copy_1_LogStart"
                    tibex:xpdlId="70883543-f725-4fa2-846c-f49884946634"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartEstrazioniToCopy_1_LogStart"/>
                        <bpws:target linkName="StartEstrazioniToLogNoRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogNoRecordToLogEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;Copy_1_LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'timerStartEstrazioni'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessun dato estratto per GUI' &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate" tibex:group="iterate" tibex:xpdlId="3f79e49f-d706-4a89-bcd0-fe457311f77d">
                <bpws:targets>
                    <bpws:target linkName="StartEstrazioniToIterate1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IterateToLogEnd"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$StartEstrazioni/ns2:InputData/ns2:DataForProcedure" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns2:Iterate_Current_Element_DataForProcedure"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="2f2f5b3d-c2f6-408b-a569-6d33cf8c4fea" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($StartEstrazioni/ns2:InputData/ns2:DataForProcedure)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="163b9574-1d28-41c6-b218-cb319afa2982">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="55953dec-a3c3-44eb-b59d-624463b61d16"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:ns=&quot;www.tim.now.StarterEstrazioni.DataForProcedure&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;ns:InputData>&lt;xsl:if test=&quot;$currentElement/tns:CODICE_OLO&quot;>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$currentElement/tns:CODICE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:if>&lt;ns:FLUSSO_ESTRAZIONE>&lt;xsl:value-of select=&quot;$currentElement/tns:FLUSSO_DI_ESTRAZIONE&quot;/>&lt;/ns:FLUSSO_ESTRAZIONE>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;ns:COD_INTRFC>&lt;xsl:value-of select=&quot;$currentElement/tns:COD_INTRFC&quot;/>&lt;/ns:COD_INTRFC>&lt;xsl:if test=&quot;$currentElement/tns:DATA_INIZIO&quot;>&lt;ns:DATA_INIZIO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_INIZIO&quot;/>&lt;/ns:DATA_INIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_FINE&quot;>&lt;ns:DATA_FINE>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_FINE&quot;/>&lt;/ns:DATA_FINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;>&lt;ns:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;$currentElement/tns:DATA_ESPLETAMENTO&quot;/>&lt;/ns:DATA_ESPLETAMENTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DESCR_FLUSSO&quot;>&lt;ns:DESCR_FLUSSO>&lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_FLUSSO&quot;/>&lt;/ns:DESCR_FLUSSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:DESCR_PPS&quot;>&lt;ns:DESCR_PPS>&lt;xsl:value-of select=&quot;$currentElement/tns:DESCR_PPS&quot;/>&lt;/ns:DESCR_PPS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns:ID_PPS&quot;>&lt;ns:ID_PPS>&lt;xsl:value-of select=&quot;$currentElement/tns:ID_PPS&quot;/>&lt;/ns:ID_PPS>&lt;/xsl:if>&lt;/ns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.gui.Sub_CallProcedure" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEnd-input"
                    name="LogEnd" outputVariable="Copy_1_LogStart"
                    tibex:xpdlId="7b995e8a-fe3c-44b2-9627-15a070bdfc1e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogNoRecordToLogEnd"/>
                        <bpws:target linkName="IterateToLogEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEndToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'TimerEstrazioni'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Fine processo TiimerEstrazioni GUI' &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="a75c7715-9ce6-415d-b193-dcf0b75e6262">
                <bpws:targets>
                    <bpws:target linkName="LogEndToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
