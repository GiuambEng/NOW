            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryIncentiviOAO-input"
                    name="JDBCQueryIncentiviOAO"
                    outputVariable="JDBCQueryIncentiviOAO"
                    tibex:xpdlId="2e525828-2b6b-40e9-a1ad-5f59d1849068" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToJDBCQueryIncentiviOAO"/>
                        <bpws:target linkName="CreaRichiestaMigrazioneToJDBCQueryIncentiviOAO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryIncentiviOAOToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryIncentiviOAOToCreateElabOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($JDBCQueryIncentiviOAO/Record[1]/STATO='COMPLETATO' and $JDBCQueryIncentiviOAO/Record[1]/FLUSSO = 'IncentiviOAO') or ($JDBCQueryIncentiviOAO/Record[1]/STATO='COMPLETATO' and $JDBCQueryIncentiviOAO/Record[1]/FLUSSO = 'IncentiviOAO_Switchoff_Elab')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($JDBCQueryIncentiviOAO/Record[1]/STATO='COMPLETATO' and $JDBCQueryIncentiviOAO/Record[1]/FLUSSO = 'IncentiviOAO') or ($JDBCQueryIncentiviOAO/Record[1]/STATO='COMPLETATO' and $JDBCQueryIncentiviOAO/Record[1]/FLUSSO = 'IncentiviOAO_Switchoff_Elab')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2e525828-2b6b-40e9-a1ad-5f59d1849068+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQueryIncentiviOAO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/SISTEMA>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLUSSO, STATO, ID_FILE&#xa;  FROM APPUSER.STATO_ALLINEAMENTI&#xa;  WHERE STATO in ('COMPLETATO') AND SISTEMA = ?&#xa;    AND FLUSSO in ('IncentiviOAO', 'IncentiviOAO_Switchoff_Elab')&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="5376eb03-5791-474d-b4c3-07e5712a9d4c">
                <bpws:targets>
                    <bpws:target linkName="CreateElabOKToExit"/>
                    <bpws:target linkName="JDBCQueryIncentiviOAOToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MigrazioneUllSlu-input"
                    name="MigrazioneUllSlu"
                    outputVariable="MigrazioneUllSlu"
                    tibex:xpdlId="e028db5b-4c90-4f0d-b905-baa16b3b885c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallCloseAlignToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToJDBCQueryIncentiviOAO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MigrazioneUllSluToCreaRichiestaMigrazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($MigrazioneUllSlu/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($MigrazioneUllSlu/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e028db5b-4c90-4f0d-b905-baa16b3b885c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  SELECT ID_FILE&#xa;  FROM APPUSER.STATO_ALLINEAMENTI&#xa;  WHERE STATO in ('COMPLETATO') AND FLUSSO ='Migrazione_ULL_SLU'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_FILE"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CreaRichiestaMigrazione-input"
                    name="CreaRichiestaMigrazione"
                    tibex:xpdlId="10bf98cb-d86a-42ec-9621-1a0bd1ebc433"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MigrazioneUllSluToCreaRichiestaMigrazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CreaRichiestaMigrazioneToJDBCQueryIncentiviOAO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MigrazioneUllSlu&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MigrazioneUllSlu&quot;/>&lt;xsl:template name=&quot;CreaRichiestaMigrazione-input&quot; match=&quot;/&quot;>&lt;tns:CreaRichiestaMigrazione_Input>&lt;tns:IDFile>&lt;xsl:value-of select=&quot;xsd:int($MigrazioneUllSlu/Record[1]/ID_FILE)&quot;/>&lt;/tns:IDFile>&lt;/tns:CreaRichiestaMigrazione_Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.batch.alignment.gui.Inbound.CreaRichiestaMigrazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
