                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1617028717590&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIncentiviOAO&quot;/>&#xa;    &lt;xsl:template name=&quot;CreateElabOK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ElabOK_Input>&#xa;            &lt;tns1:IDFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($JDBCQueryIncentiviOAO/Record[1]/ID_FILE)&quot;/>&#xa;            &lt;/tns1:IDFile>&#xa;        &lt;/tns1:ElabOK_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
