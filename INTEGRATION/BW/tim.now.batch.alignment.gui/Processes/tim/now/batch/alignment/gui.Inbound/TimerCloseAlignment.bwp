                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.CloseAlignment&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;CallCloseAlign-input&quot; match=&quot;/&quot;>&lt;ns1:ChiusuraAllineamenti>&lt;ns1:InputData>&lt;ns1:SISTEMA>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ns1:SISTEMA>&lt;ns1:LogInfo>&lt;ns1:LogInfoLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/ns1:LogInfoLevel>&lt;ns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/ns1:LogName>&lt;ns1:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/ns1:ApplicationName>&lt;/ns1:LogInfo>&lt;/ns1:InputData>&lt;/ns1:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
