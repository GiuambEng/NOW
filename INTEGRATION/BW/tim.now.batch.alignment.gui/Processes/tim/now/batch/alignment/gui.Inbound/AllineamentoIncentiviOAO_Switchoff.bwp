                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputStagingIncentiviOAO_Switchoff&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/IncentiviOAOSwitchoff&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ContenutoRecdIncentiviOAO_Switchoff&quot;/>&lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:IncentiviOAOSwitchoff)=0&quot;>&lt;tns:IncentiviOAOStaging_Switchoff>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:IncentiviOAOSwitchoff&quot;>&lt;tns:InputStagingIncentiviOAO_Switchoff>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:IDRisorsaNOW&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:IDRisorsaNOW&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CodiceOAOAGCOM&quot;>&lt;tns:CODIFICA_OAO_AGCOM>&lt;xsl:value-of select=&quot;tns1:CodiceOAOAGCOM&quot;/>&lt;/tns:CODIFICA_OAO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Servizio&quot;>&lt;tns:OFFERTA>&lt;xsl:value-of select=&quot;tns1:Servizio&quot;/>&lt;/tns:OFFERTA>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;tns:TMSP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_AGG>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecdIncentiviOAO_Switchoff/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecdIncentiviOAO_Switchoff/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns:NUMRECORD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns:NUMRECORD>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;/tns:InputStagingIncentiviOAO_Switchoff>&lt;/xsl:for-each>&lt;/tns:IncentiviOAOStaging_Switchoff>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IncentiviOAOStaging_Switchoff>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:IncentiviOAOSwitchoff&quot;>&lt;tns:InputStagingIncentiviOAO_Switchoff>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:IDRisorsaNOW&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns1:IDRisorsaNOW&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CodiceOAOAGCOM&quot;>&lt;tns:CODIFICA_OAO_AGCOM>&lt;xsl:value-of select=&quot;tns1:CodiceOAOAGCOM&quot;/>&lt;/tns:CODIFICA_OAO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Servizio&quot;>&lt;tns:OFFERTA>&lt;xsl:value-of select=&quot;tns1:Servizio&quot;/>&lt;/tns:OFFERTA>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;tns:TMSP_AGG>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_AGG>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPU