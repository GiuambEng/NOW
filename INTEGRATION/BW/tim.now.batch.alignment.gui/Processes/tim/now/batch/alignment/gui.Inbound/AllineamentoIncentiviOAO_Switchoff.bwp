                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= (($JMSReceiveMessage/Body/ns4:queueResponse/ns4:NumeroRecord) div $Passo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index <= (($JMSReceiveMessage/Body/ns4:queueResponse/ns4:NumeroRecord) div $Passo)]]></bpws:transitionCondition>
                                    </bpws:source>
