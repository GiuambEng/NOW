                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputStagingRisorseFWA_Decommissioning&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RisorseFWA_Decommissioning&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ContenutoRecdRisorseFWA_Decommissioning&quot;/>&lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:RisorseFWA_Decommissioning)=0&quot;>&lt;tns:RisorseFWAStaging_Decommissioning>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:RisorseFWA_Decommissioning&quot;>&lt;tns:InputStagingRisorseFWA_Decommissioning>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;>&lt;tns:ID_RISORSA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;/>&lt;/tns:ID_RISORSA_SWITCHOFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;>&lt;tns:DATA_SCADENZA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;/>&lt;/tns:DATA_SCADENZA_SWITCHOFF>&lt;/xsl:if>&lt;tns:TIMESTAMP_INSERIMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_INSERIMENTO>&lt;tns:TIMESTAMP_AGGIORNAMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_AGGIORNAMENTO>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecdRisorseFWA_Decommissioning/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecdRisorseFWA_Decommissioning/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns:OPERATORE_INSERIMENTO>&lt;xsl:value-of select=&quot;&amp;quot;Caricato da File&amp;quot;&quot;/>&lt;/tns:OPERATORE_INSERIMENTO>&lt;tns:OPERATORE_ULTIMA_MODIFICA>&lt;xsl:value-of select=&quot;&amp;quot;Caricato da File&amp;quot;&quot;/>&lt;/tns:OPERATORE_ULTIMA_MODIFICA>&lt;tns:ID_STATO_ELAB_STAGING>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns:ID_STATO_ELAB_STAGING>&lt;tns:NUMRECORD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns:NUMRECORD>&lt;/tns:InputStagingRisorseFWA_Decommissioning>&lt;/xsl:for-each>&lt;/tns:RisorseFWAStaging_Decommissioning>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RisorseFWAStaging_Decommissioning>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:RisorseFWA_Decommissioning&quot;>&lt;tns:InputStagingRisorseFWA_Decommissioning>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;>&lt;tns:ID_RISORSA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;/>&lt;/tns:ID_RISORSA_SWITCHOFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;>&lt;tns:DATA_SCADENZA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;/>&lt;/tns:DATA_SCADENZA_SWITCHOFF>&lt;/xsl:if>&lt;tns:TIMESTAMP_INSERIMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_INSERIMENTO>&lt;tns:TIMESTAMP_AGGIORNAMENTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TIMESTAMP_AGGIORNAMENTO>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecdRisorseFWA_Decommissioning/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecdRisorseFWA_Decommissioning/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns:OPERATORE_INSERIMENTO>&lt;xsl:value-of select=&quot;&amp;quot;Caricato da File&amp;quot;&quot;/>&lt;/tns:OPERATORE_INSERIMENTO>&lt;tns:OPERATORE_ULTIMA_MODIFICA>&lt;xsl:value-of select=&quot;&amp;quot;Caricato da File&amp;quot;&quot;/>&lt;/tns:OPERATORE_ULTIMA_MODIFICA>&lt;tns:ID_STATO_ELAB_STAGING>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns:ID_STATO_ELAB_STAGING>&lt;tns:NUMRECORD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns:NUMRECORD>&lt;/tns:InputStagingRisorseFWA_Decommissioning>&lt;/xsl:for-each>&lt;/tns:RisorseFWAStaging_Decommissioning>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
