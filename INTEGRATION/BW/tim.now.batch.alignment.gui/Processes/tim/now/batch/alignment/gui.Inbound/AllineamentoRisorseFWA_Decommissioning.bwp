                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord=0 and$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='OK')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord=0 and$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='OK')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
