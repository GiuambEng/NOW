                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;Log_InputStaging-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoRisorseFWA_Decommissioning'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input staging RisorseFWA_Decommissioning: &amp;quot;,tib:render-xml($InputStaging, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="InsertStaging-input"
                                    name="InsertStaging"
                                    outputVariable="InsertStaging"
                                    tibex:xpdlId="97eb37bd-2c8d-4581-b0b5-3206e93449dd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log_InputStagingToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputStagingRisorseFWA_Decommissioning&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97eb37bd-2c8d-4581-b0b5-3206e93449dd+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InputStaging&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$InputStaging/tns:InputStagingRisorseFWA_Decommissioning&quot;>&lt;Record>&lt;IDRISSWITCHOFF>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:ID_RISORSA_SWITCHOFF)&quot;>&lt;xsl:value-of select=&quot;tns:ID_RISORSA_SWITCHOFF&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRISSWITCHOFF>&lt;DATASCADENZASWITCHOFF>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:DATA_SCADENZA_SWITCHOFF)&quot;>&lt;xsl:value-of select=&quot;tns:DATA_SCADENZA_SWITCHOFF&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATASCADENZASWITCHOFF>&lt;TMSTMPINS>&lt;xsl:value-of select=&quot;xsd:dateTime(tns:TIMESTAMP_INSERIMENTO)&quot;/>&lt;/TMSTMPINS>&lt;TMSTMPAGG>&lt;xsl:value-of select=&quot;xsd:dateTime(tns:TIMESTAMP_AGGIORNAMENTO)&quot;/>&lt;/TMSTMPAGG>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;CONTENUTORECORD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CONTENUTO_RECORD)&quot;>&lt;xsl:value-of select=&quot;tns:CONTENUTO_RECORD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTORECORD>&lt;NUMERORECORD>&lt;xsl:value-of select=&quot;xsd:decimal(tns:NUMRECORD)&quot;/>&lt;/NUMERORECORD>&lt;OPERATOREINSERIMENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:OPERATORE_INSERIMENTO)&quot;>&lt;xsl:value-of select=&quot;tns:OPERATORE_INSERIMENTO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OPERATOREINSERIMENTO>&lt;OPERATOREULTIMAMODIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:OPERATORE_ULTIMA_MODIFICA)&quot;>&lt;xsl:value-of select=&quot;tns:OPERATORE_ULTIMA_MODIFICA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OPERATOREULTIMAMODIFICA>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns:ID_STATO_ELAB_STAGING)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;DESC_ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:DESCRIZIONE_ESITO)&quot;>&lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ESITO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESC_ESITO>&lt;/Record>&lt;/xsl:for-each>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.AN_FILE_RIS_FWA_DECO (IDRISSWITCHOFF, DATASCADENZASWITCHOFF,&#xa;  TMSTMPINS, TMSTMPAGG, ID_FILE_PROCSTO_INPUT, CONTENUTORECORD,&#xa;  NUMERORECORD, OPERATOREINSERIMENTO, OPERATOREULTIMAMODIFICA,&#xa;  ID_STATO_ELAB_STAG, DESC_ESITO)&#xa;  VALUES (?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?,&#xa;    ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
