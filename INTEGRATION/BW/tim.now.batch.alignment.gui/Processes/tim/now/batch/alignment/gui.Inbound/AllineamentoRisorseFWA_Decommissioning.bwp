                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ContenutoRecdRisorseFWA_Decommissioning&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RisorseFWA_Decommissioning&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecdRisorseFWA_Decommissioning-input&quot; match=&quot;/&quot;>&lt;tns:InputRisorseFWA_Decommissioning_ContenutoRecord>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:RisorseFWA_Decommissioning)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:RisorseFWA_Decommissioning&quot;>&lt;tns:ContenutoRecdRisorseFWA_Decommissioning_input>&lt;xsl:if test=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;>&lt;tns:ID_RISORSA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;/>&lt;/tns:ID_RISORSA_SWITCHOFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;>&lt;tns:DATA_SCADENZA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:DATA_SCADENZA_SWITCHOFF&quot;/>&lt;/tns:DATA_SCADENZA_SWITCHOFF>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:FlagValidita&quot;>&lt;tns:Flag_Validita>&lt;xsl:value-of select=&quot;tns1:FlagValidita&quot;/>&lt;/tns:Flag_Validita>&lt;/xsl:if>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;/tns:NumeroRecord>&lt;/tns:ContenutoRecdRisorseFWA_Decommissioning_input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:RisorseFWA_Decommissioning&quot;>&lt;tns:ContenutoRecdRisorseFWA_Decommissioning_input>&lt;xsl:if test=&quot;tns1:ID_RISORSA_SWITCHOFF&quot;>&lt;tns:ID_RISORSA_SWITCHOFF>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA