            <bendpoints points="[25, 0, -197, 0]$[198, 0, -24, 0]" xsi:type="notation:RelativeBendpoints"/>
        </edges>
        <edges
            source="//@children.0/@children.3/@children.0/@children.0/@children.0/@children.0/@children.0/@children.0/@children.6"
            target="//@children.0/@children.3/@children.0/@children.0/@children.0/@children.0/@children.0/@children.0/@children.1" type="4006">
            <children type="6002">
                <layoutConstraint xsi:type="notation:Location" y="40"/>
            </children>
            <styles lineColor="0" xsi:type="notation:ConnectorStyle"/>
            <styles fontName="Segoe UI" xsi:type="notation:FontStyle"/>
            <element href="//0/@process/@activity/@activity/@links/@children.6"/>
            <bendpoints
                points="[25, 0, -197, -118]$[222, 0, 0, -118]$[222, 94, 0, -24]" xsi:type="notation:RelativeBendpoints"/>
        </edges>
    </notation:Diagram>
    <tibex:NamespaceRegistry enabled="true">
        <tibex:namespaceItem
            namespace="http://www.tim.com/NOW/xsd/GenericLogger" prefix="tns"/>
    </tibex:NamespaceRegistry>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/CheckNomeFileGUI"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable name="DataLength" type="xsd:string"/>
        <bpws:variable element="tns1:ControlDate" name="Date"/>
        <bpws:variable name="Flusso" type="xsd:string"/>
        <bpws:variable element="tns1:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="tns1:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns1:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable name="LogName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/LogConfiguration/LogName" type="xsd:string"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="DataLengthLog-input" sca-bpel:internal="true"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/LogConfiguration/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="FlowError-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="CheckFlowToDateLength" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckFlowToFlowError" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DateLengthToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToCheckFlow" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLogger1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e5cb44b8-7b66-43dc-a07f-82f8462d6989"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="e053a2aa-ae1b-45b1-9923-aba219f360ac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                        <bpws:target linkName="GenericLogger1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFileUNICARA&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileGUI&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DataLength&quot;/>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$DataLength='ERROR' or$Flusso='ERROR'&quot;>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;if($DataLength='ERROR') then 'ERROR_DATA_FILE' else 'ERROR_NOME_FILE'&quot;/>&lt;/tns1:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Flusso&quot;/>&lt;/tns1:FLUSSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DataLength"
                    name="DateLength" outputVariable="DataLength"
                    tibex:xpdlId="cb856310-7b09-4d4b-b4d3-5e7ba87be361" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlowToDateLength"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DateLengthToGenericLogger">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Flusso='IncentiviOAO') then &#xd;&#xa;&#x9;(if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[3])=8)  then 'OK' else 'ERROR') &#xd;&#xa;&#x9;else if ($Flusso = 'ComuniCoinvestiti') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[3])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'RichSediOLT') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[4])=8) then 'OK' else 'ERROR') &#xd;&#xa;&#x9;else if ($Flusso = 'RichCanaleFeerder') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[4])=8) then 'OK' else 'ERROR') &#xd;&#xa;&#x9;else if ($Flusso = 'RichCanaleSedi') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[4])=8) then 'OK' else 'ERROR') &#x9;&#xd;&#xa;&#x9;else if ($Flusso = 'ModificaContratti') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[4])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'IncentiviOAO_Switchoff' and contains($Start/tns1:FILE_NAME, &quot;SWITCHOFF_OPERA&quot;))  then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[6])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'IncentiviOAO_Switchoff') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[5])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'IncentiviOAO_CLLI_OLD_Switchoff') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[7])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'IncentiviOAO_CLLI_NEW_Switchoff') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[7])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'IncentiviOAO_Switchoff_Elab') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[3])=6) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'Risorse_FWA_Decommissioning') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[3])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'Bonifica_MacroArea') then (if(string-length(tokenize((substring-before($Start/tns1:FILE_NAME, &quot;.&quot;)),'_')[4])=8) then 'OK' else 'ERROR')&#xd;&#xa;&#x9;else if ($Flusso = 'AnagraficaEOLO') then (if(string-length(tokenize($Start/tns1:FILE_NAME,'_')[3])=8) then 'OK' else 'ERROR') &#xd;&#xa;&#x9;else if ($Flusso = 'Migrazione_ULL_SLU') then (if(string-length(tokenize($Start/tns1:FILE_NAME,'_')[4])=8) then 'OK' else 'ERROR')&#xd;&#xa;else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="DataLength" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Flusso"
                    name="CheckFlow" outputVariable="Flusso"
                    tibex:xpdlId="5d1136e7-86ac-4f8a-a48c-1bf818155991" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCheckFlow"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckFlowToDateLength">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckFlowToFlowError">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Flusso='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Flusso='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(contains($Start/tns1:FILE_NAME, &quot;DECOMMISSIONING&quot;)) then 'IncentiviOAO' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;SEMIVULA&quot;) or contains($Start/tns1:FILE_NAME, &quot;SEMIBTSNGA&quot;) or contains($Start/tns1:FILE_NAME, &quot;SEMIEIPNGA&quot;)) then 'ComuniCoinvestiti'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;MC_OLT_&quot;)) then 'RichSediOLT' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;MC_CFD_&quot;)) then 'RichCanaleFeerder' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;MC_COLT_&quot;)) then 'RichCanaleSedi' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;MC_CONTRATTO_&quot;)) then 'ModificaContratti' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;NOW_INCENTIVI_&quot;)) then 'IncentiviOAO_Switchoff'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;NOW_CLLI_OLD_&quot;)) then 'IncentiviOAO_CLLI_OLD_Switchoff'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;NOW_CLLI_NEW_&quot;)) then 'IncentiviOAO_CLLI_NEW_Switchoff'&#xd;&#xa;else if(starts-with($Start/tns1:FILE_NAME, &quot;SWITCHOFF_&quot;)) then 'IncentiviOAO_Switchoff_Elab'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;_RISORSEFWADECO_&quot;)) then 'Risorse_FWA_Decommissioning'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;BONIFICA_MACROAREA&quot;)) then 'Bonifica_MacroArea'&#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;ANAGRAFICA_EOLO_&quot;)) then 'AnagraficaEOLO' &#xd;&#xa;else if(contains($Start/tns1:FILE_NAME, &quot;MIGRAZIONE_ULL_SLU_&quot;)) then 'Migrazione_ULL_SLU'&#xd;&#xa;else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Flusso" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="79c2c23c-ac1c-41e6-9b44-2ddc9cb84291" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToCheckFlow"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.example.org/CheckNomeFileGUI&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;loggerName>&#xa;                &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;            &lt;/loggerName>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Input ControlloNomeFile:',$Start/tns1:FILE_NAME)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="DataLengthLog-input"
                    name="DataLengthLog"
                    tibex:xpdlId="759b199e-d8c9-43cf-ad32-7d7ecd2bb93c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DateLengthToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;DataLength&quot;/>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:template name=&quot;DataLengthLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CheckFileName'&quot;/>&lt;/tns:Process>&lt;xsl:choose>&lt;xsl:when test=&quot;$DataLength='ERROR'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Flusso OK: &amp;quot;,  $Flusso, &amp;quot; Data in KO: &amp;quot;, $DataLength)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Flusso OK: &amp;quot;,  $Flusso, &amp;quot; DataLength OK: &amp;quot;, $DataLength)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="FlowError-input"
                    name="FlowError"
                    tibex:xpdlId="7dfa1f5b-21cf-45d9-b4de-5f156fbabec4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlowToFlowError"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:template name=&quot;FlowError-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CheckFileName'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Flusso in Errore: &amp;quot;, $Flusso)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
