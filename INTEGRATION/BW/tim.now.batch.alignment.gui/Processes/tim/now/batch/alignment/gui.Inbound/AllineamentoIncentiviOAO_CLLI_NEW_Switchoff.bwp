                    <bpws:link name="WhileToGroupEnd1" tibex:linkType="SUCCESS"/>
                </bpws:links>
                <bpws:empty name="GroupStart1" tibex:group="groupStart" tibex:xpdlId="27a2e1af-d276-4f4d-b9a5-a72d7c0723ab">
                    <bpws:sources>
                        <bpws:source linkName="GroupStart1ToWhile"/>
                    </bpws:sources>
                </bpws:empty>
                <bpws:empty name="GroupEnd1" tibex:group="groupEnd" tibex:xpdlId="41a1a9bf-b5a7-4896-9816-e27b95c92c40">
                    <bpws:targets>
                        <bpws:target linkName="WhileToGroupEnd1"/>
                    </bpws:targets>
                </bpws:empty>
                <bpws:scope name="While" tibex:group="while" tibex:xpdlId="170d5978-8254-4291-9ef9-9bd0a16e57d1">
                    <bpws:targets>
                        <bpws:target linkName="GroupStart1ToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WhileToGroupEnd1"/>
                    </bpws:sources>
                    <bpws:variables>
                        <bpws:variable name="index"
                            sca-bpel:internal="true" type="xsd:int">
                            <bpws:from>
                                <bpws:literal>1</bpws:literal>
                            </bpws:from>
                        </bpws:variable>
                    </bpws:variables>
                    <bpws:sequence name="sequence" tibex:group="while">
                        <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                        <bpws:while name="while" tibex:counterName="index">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$index &lt;= ((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $Passo) + 1)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= ((($JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord) div $Passo) + 1)]]></bpws:condition>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToParseData" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToParseData1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="DetailNoValToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="DetailUltimi_NoValToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="StartElaborazioneToContenutoRecdIncentiviOAO_CLLI_NEW_Switchoff" tibex:linkType="SUCCESS"/>
                                    <bpws:link
