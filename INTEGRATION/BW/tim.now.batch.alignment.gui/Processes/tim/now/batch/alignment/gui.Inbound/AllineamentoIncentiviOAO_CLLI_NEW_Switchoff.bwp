    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="994a88a5-572f-4fb5-8083-53b859a35594">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="FaultToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty" tibex:linkType="ERROR"/>
                            <bpws:link
                                name="JDBCUpdateToGestioneMovedFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="EmptyToGestioneMovedFile" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="GestioneMovedFileToProcessLoggerTrack" tibex:linkType="SUCCESS"/>
                            <bpws:link
