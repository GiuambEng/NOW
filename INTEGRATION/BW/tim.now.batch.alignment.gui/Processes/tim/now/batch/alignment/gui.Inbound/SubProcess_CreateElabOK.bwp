                            expression="if(( $FlagSSH='Y') and (starts-with($JDBCQuery/Record[1]/FILE_NAME, 'SWITCHOFF_')))&#xd;&#xa;then&#xd;&#xa;concat(&quot;export PATH_ROOT=&quot;, $PathRoot,&quot;; cd &quot;, $PathRoot,&quot;/Sh/; ./lancio_estr_C26M31_OUT.ksh&quot;, &quot; &quot;, xsd:string($Start/ns0:IDFile), &quot; &quot;,$PathRoot,&quot;/Files/&quot;,$FileNameElabOK,&quot; &quot;,$Logger.part1/ns14:Esito/ns14:ID_FILE, &quot; > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else if ( $FlagSSH='Y')&#xd;&#xa;then&#xd;&#xa;concat(&quot;export PATH_ROOT=&quot;, $PathRoot,&quot;; cd &quot;, $PathRoot,&quot;/Sh/; ./lancio_estr_C26M26_OUT.ksh&quot;, &quot; &quot;, xsd:string($Start/ns0:IDFile), &quot; &quot;,$PathRoot,&quot;/Files/&quot;,$FileNameElabOK,&quot; &quot;,$Logger.part1/ns14:Esito/ns14:ID_FILE, &quot; > /dev/null 2>&amp;1 &amp;&quot;)&#xd;&#xa;else if (starts-with($JDBCQuery/Record[1]/FILE_NAME, 'SWITCHOFF_'))&#xd;&#xa;then&#xd;&#xa;concat('./lancio_estr_C26M31_OUT.ksh ', xsd:string($Start/ns0:IDFile), &quot; &quot;,$LocalPath,$FileNameElabOK,&quot; &quot;,$Logger.part1/ns14:Esito/ns14:ID_FILE)&#xd;&#xa;else&#xd;&#xa;concat('./lancio_estr_C26M26_OUT.ksh ', xsd:string($Start/ns0:IDFile), &quot; &quot;,$LocalPath,$FileNameElabOK,&quot; &quot;,$Logger.part1/ns14:Esito/ns14:ID_FILE)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
