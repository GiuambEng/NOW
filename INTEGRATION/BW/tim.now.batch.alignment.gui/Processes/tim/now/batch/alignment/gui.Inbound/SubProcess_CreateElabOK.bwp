&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/" xmlns:tns1="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" version="2.0"&gt;&lt;xsl:param name="SSHHost"/&gt;&lt;xsl:param name="SSHUser"/&gt;&lt;xsl:param name="SSHPort"/&gt;&lt;xsl:param name="SSHPassword"/&gt;&lt;xsl:param name="FileNameElabOK"/&gt;&lt;xsl:param name="PathRoot"/&gt;&lt;xsl:param name="LocalPath"/&gt;&lt;xsl:template name="SpostaFile-input" match="/"&gt;&lt;tns:SftGetJavaCodeOperationRequest&gt;&lt;SftpGetInput&gt;&lt;tns1:SFTP_GetJavaCodeInput&gt;&lt;tns1:RemoteFile&gt;&lt;xsl:value-of select="concat($PathRoot,'/Files/',$FileNameElabOK)"/&gt;&lt;/tns1:RemoteFile&gt;&lt;tns1:LocalFile&gt;&lt;xsl:value-of select="concat($LocalPath,$FileNameElabOK)"/&gt;&lt;/tns1:LocalFile&gt;&lt;tns1:credenziali&gt;&lt;tns1:Host&gt;&lt;xsl:value-of select="$SSHHost"/&gt;&lt;/tns1:Host&gt;&lt;tns1:Port&gt;&lt;xsl:value-of select="$SSHPort"/&gt;&lt;/tns1:Port&gt;&lt;tns1:Password&gt;&lt;xsl:value-of select="$SSHPassword"/&gt;&lt;/tns1:Password&gt;&lt;tns1:User&gt;&lt;xsl:value-of select="$SSHUser"/&gt;&lt;/tns1:User&gt;&lt;/tns1:credenziali&gt;&lt;/tns1:SFTP_GetJavaCodeInput&gt;&lt;/SftpGetInput&gt;&lt;/tns:SftGetJavaCodeOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
