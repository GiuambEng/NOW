                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tns1=&quot;http://www.example.org/ManageMoveFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;PathFileError&quot;/>&lt;xsl:param name=&quot;FilePathMove&quot;/>&lt;xsl:template name=&quot;MoveScarto-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;>&lt;tns1:FullPathOrigine>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FULLNAME&quot;/>&lt;/tns1:FullPathOrigine>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$PathFileError&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FolderDestinazione>&lt;xsl:value-of select=&quot;$FilePathMove&quot;/>&lt;/tns1:FolderDestinazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME&quot;/>&lt;/tns1:NomeFile>&lt;/xsl:if>&lt;tns1:ID_TRACK>&lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_TRACK)&quot;/>&lt;/tns1:ID_TRACK>&lt;tns1:LogInput>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;/tns1:LogInput>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
