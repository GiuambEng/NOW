    xmlns:ns15="http://www.example.org/ContenutoRecdBonificaMacroArea"
    xmlns:ns16="www.tim.now.migration.OutputContenutoRecd"
    xmlns:ns17="http://www.example.org/InputStagingBonificaMacroArea"
    xmlns:ns18="http://www.tibco.com/namespaces/tnt/plugins/jdbc+d5d63786-d7f0-47ce-bca0-8f1842cb7fd9+input"
    xmlns:ns19="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
