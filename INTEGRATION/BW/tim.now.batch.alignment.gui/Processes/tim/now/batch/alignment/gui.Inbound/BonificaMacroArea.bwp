                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns10=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+deb7fccf-0267-4f7d-883c-77c3ea57d2fd+input&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns10:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;'Bonifica_MacroArea'&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:value-of select=&quot;concat(substring-before($JMSReceiveMessage/Body/ns1:queueResponse/ns1:FILENAME, &amp;quot;.ctr&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/DESCR_ERRORE>&lt;FLAG_LETTURA>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAG_LETTURA>&lt;STATO>&lt;xsl:value-of select=&quot;'KO_TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_ESEC_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;