            <bpws:flow name="LocalTransaction" tibex:group="localTX"
                tibex:txGroup="none" tibex:xpdlId="7d751e1d-4008-46fb-b884-26206d058b55">
                <bpws:targets>
                    <bpws:target linkName="UpCountToLocalTransaction"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LocalTransactionToGenericLogger"/>
                </bpws:sources>
                <bpws:links>
                    <bpws:link name="GroupStart1ToWhile" tibex:linkType="SUCCESS"/>
                    <bpws:link name="WhileToGroupEnd1" tibex:linkType="SUCCESS"/>
                </bpws:links>
                <bpws:empty name="GroupStart1" tibex:group="groupStart" tibex:xpdlId="5f107171-46e3-426c-9104-403348d05522">
                    <bpws:sources>
                        <bpws:source linkName="GroupStart1ToWhile"/>
                    </bpws:sources>
                </bpws:empty>
                <bpws:empty name="GroupEnd1" tibex:group="groupEnd" tibex:xpdlId="c5cbef3c-7bc4-4e61-8776-0cfc13a6ade6">
                    <bpws:targets>
                        <bpws:target linkName="WhileToGroupEnd1"/>
                    </bpws:targets>
                </bpws:empty>
                <bpws:scope name="While" tibex:group="while" tibex:xpdlId="f611ab58-f079-4dad-b967-6ebb81e650e6">
                    <bpws:targets>
                        <bpws:target linkName="GroupStart1ToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="WhileToGroupEnd1"/>
                    </bpws:sources>
                    <bpws:variables>
                        <bpws:variable name="index"
                            sca-bpel:internal="true" type="xsd:int">
                            <bpws:from>
                                <bpws:literal>1</bpws:literal>
                            </bpws:from>
                        </bpws:variable>
                    </bpws:variables>
                    <bpws:sequence name="sequence" tibex:group="while">
                        <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                        <bpws:while name="while" tibex:counterName="index">
