            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="c0c1e89e-4478-469e-8a34-5f18230bb5ce" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Copy_1_LogInputToEnd"/>
                        <bpws:target linkName="LogQueryCOMUNIToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RecInfoFromFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryASS_FILE_MULTICAST&quot;/>&lt;xsl:param name=&quot;QueryASS_FILE_COMUNI&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($QueryASS_FILE_COMUNI/Record) >0&quot;>&lt;tns:Output>&lt;xsl:if test=&quot;$QueryASS_FILE_COMUNI/Record[1]/ID_CONTRATTO&quot;>&lt;tns:IdContratto>&lt;xsl:value-of select=&quot;$QueryASS_FILE_COMUNI/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:IdContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$QueryASS_FILE_COMUNI/Record[1]/COD_OLO_AGCOM&quot;>&lt;tns:CodOloAgcom>&lt;xsl:value-of select=&quot;$QueryASS_FILE_COMUNI/Record[1]/COD_OLO_AGCOM&quot;/>&lt;/tns:CodOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;$QueryASS_FILE_COMUNI/Record[1]/CODICE_OLO&quot;>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;$QueryASS_FILE_COMUNI/Record[1]/CODICE_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;/xsl:if>&lt;/tns:Output>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Output>&lt;xsl:if test=&quot;$QueryASS_FILE_MULTICAST/Record[1]/ID_CONTRATTO&quot;>&lt;tns:IdContratto>&lt;xsl:value-of select=&quot;$QueryASS_FILE_MULTICAST/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:IdContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$QueryASS_FILE_MULTICAST/Record[1]/COD_OLO_AGCOM&quot;>&lt;tns:CodOloAgcom>&lt;xsl:value-of select=&quot;$QueryASS_FILE_MULTICAST/Record[1]/COD_OLO_AGCOM&quot;/>&lt;/tns:CodOloAgcom>&lt;/xsl:if>&lt;xsl:if test=&quot;$QueryASS_FILE_MULTICAST/Record[1]/CODICE_OLO&quot;>&lt;tns:CodiceOLO>&lt;xsl:value-of select=&quot;$QueryASS_FILE_MULTICAST/Record[1]/CODICE_OLO&quot;/>&lt;/tns:CodiceOLO>&lt;/xsl:if>&lt;/tns:Output>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="6822befa-80cd-4306-81ef-827597bf9203"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCUpdate1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($Start/ns2:NomeFile, &quot;SEMIVULA&quot;) or contains($Start/ns2:NomeFile, &quot;SEMIBTSNGA&quot;) or contains($Start/ns2:NomeFile, &quot;SEMIEIPNGA&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains($Start/ns2:NomeFile, "SEMIVULA") or contains($Start/ns2:NomeFile, "SEMIBTSNGA") or contains($Start/ns2:NomeFile, "SEMIEIPNGA")]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToJDBCUpdateIDFILE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProcess_RecuperaInfoFile'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Input RecuperaInfoFile: ', tib:render-xml($Start,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryASS_FILE_MULTICAST-input"
                    name="QueryASS_FILE_MULTICAST"
                    outputVariable="QueryASS_FILE_MULTICAST"
                    tibex:xpdlId="62206287-9fea-4f7f-a4e8-942911b780b7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToQueryASS_FILE_MULTICAST"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToCopy_1_LogInput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+62206287-9fea-4f7f-a4e8-942911b780b7+input&quot; xmlns:tns1=&quot;http://www.example.org/RecInfoFromFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryASS_FILE_MULTICAST-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;$Start/tns1:NomeFile&quot;/>&lt;/NOME_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_CONTRATTO, COD_OLO_AGCOM, CODICE_OLO&#xd;&#xa;FROM ASS_FILE_MULTICAST&#xd;&#xa;WHERE NOME_FILE = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICE_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogQuery_MULTICAST-input"
                    name="LogQuery_MULTICAST"
                    tibex:xpdlId="3c00b860-46f7-4a02-835d-6c0985f58cc3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
