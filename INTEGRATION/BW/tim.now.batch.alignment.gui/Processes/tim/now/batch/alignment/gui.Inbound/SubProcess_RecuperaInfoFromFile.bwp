    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogInput" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCUpdate1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCQueryToCopy_1_LogInput" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_LogInputToEnd" tibex:linkType="SUCCESS"/>
