                                    <value
                                    processInSubsets="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CLLI, DISTRETTO_TELEFONO, DETTAGLIO_LINEA_NOW, SEGMENTO_LINEA_NOW,&#xa;  ARMADIO_CLLI_UNICARA, IDRISORSA_NOW, ID, CONTENUTO_RCD&#xa;  FROM APPUSER.ANALITICO_MIGRAZIONI_ULLSLU&#xa;  WHERE ID_STATO_ELAB_STAG = '4' AND ID_FILE_PROCSO_INPUT = ?&#xa;  ORDER BY ID ASC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

