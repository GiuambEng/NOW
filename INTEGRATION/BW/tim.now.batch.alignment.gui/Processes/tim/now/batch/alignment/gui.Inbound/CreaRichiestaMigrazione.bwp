                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;RichOlo&quot;/>&lt;xsl:template name=&quot;LogRichiestaOlo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CreaRichiestaMigrazione'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Creata richiesta olo per ID ',$currentElement/ID)&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($RichOlo)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>

                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/MigrazioneUllSlu&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;DAC&quot;/>&lt;xsl:param name=&quot;ParseRecord&quot;/>&lt;xsl:template name=&quot;RichOlo-input&quot; match=&quot;/&quot;>&lt;Richiesta>&lt;xsl:variable name=&quot;ServizioAtterraggio&quot; select=&quot;if (string-length($currentElement/ARMADIO_CLLI_UNICARA)>0) then 'SLU' else 'ULL'&quot;/>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/CodiceOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='TIM RESIDENZIALI'&quot;>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&lt;/CodiceOrdineOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='ENT'&quot;>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;concat('MVGE-',tib:pad-front($currentElement/ID, 6, '0'))&quot;/>&lt;/CodiceOrdineOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&lt;/CodiceOrdineOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseRecord/Rows/tns1:MigrazioneUllSlu[1]/tns1:CodProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$ParseRecord/Rows/tns1:MigrazioneUllSlu[1]/tns1:CodProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Migrazione>&lt;CodiceRisorsa1>&lt;xsl:value-of select=&quot;$currentElement/IDRISORSA_NOW&quot;/>&lt;/CodiceRisorsa1>&lt;xsl:choose>&lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='TIM RESIDENZIALI'&quot;>&lt;CodiceSessione1>&lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&lt;/CodiceSessione1>&lt;/xsl:when>&lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='ENT'&quot;>&lt;CodiceSessione1>&lt;xsl:value-of select=&quot;concat('MVGE-',tib:pad-front($currentElement/ID, 6, '0'))&quot;/>&lt;/CodiceSessione1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CodiceSessione1>&lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&lt;/CodiceSessione1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CodiceDonating1>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/CodiceDonating1>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServizioAtterraggio='SLU'&quot;>&lt;Servizio>&lt;SLU>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','RTG')&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','ADSL')&quot;>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;'10'&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;'64'&quot;/>&lt;/BitRate>&lt;/dati>&lt;/xsl:if>&lt;/DestinazioneUso>&lt;IdentificativoSLU>&lt;IdSLUCo>&lt;xsl:value-of select=&quot;concat($currentElement/ARMADIO_CLLI_UNICARA,'_TLC')&quot;/>&lt;/IdSLUCo>&lt;PosizioneARLTI1>&lt;xsl:value-of select=&quot;'000001'&quot;/>&lt;/PosizioneARLTI1>&lt;/IdentificativoSLU>&lt;/SLU>&lt;/Servizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Servizio>&lt;Ull>&lt;DestinazioneUso>&lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','RTG')&quot;>&lt;fonia>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/fonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW='RTG+ADSL'&quot;>&lt;dati>&lt;TipoDati>&lt;xsl:value-of select=&quot;'4'&quot;/>&lt;/TipoDati>&lt;BitRate>&lt;xsl:value-of select=&quot;'64'&quot;/>&lt;/BitRate>&lt;/dati>&lt;/xsl:if>&lt;/DestinazioneUso>&lt;IdUllCo>&lt;xsl:value-of select=&quot;concat('TT',$currentElement/CLLI)&quot;/>&lt;/IdUllCo>&lt;PosizionePermutatore1>&lt;xsl:value-of select=&quot;'000000000000001'&quot;/>&lt;/PosizionePermutatore1>&lt;/Ull>&lt;/Servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DataDAC>&lt;xsl:value-of select=&quot;format-date($DAC/parameters/tns5:Response/tns5:outputDate, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/DataDAC>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;'CF'&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;'ReferenteVGW'&quot;/>&lt;/CognomeReferente>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;'111111111'&quot;/>&lt;/TelefonoFissoReferente>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;'111111111'&quot;/>&lt;/TelefonoMobileReferente>&lt;/Referente>&lt;/Migrazione>&lt;/Ordine>&lt;/Richiesta>&lt;/xsl:template>&lt;/xsl:stylesheet>"
