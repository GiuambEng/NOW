'0'))&quot;/>&#xa;                        &lt;/CodiceOrdineOlo>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ParseRecord/Rows/tns1:MigrazioneUllSlu[1]/tns1:CodProgetto&quot;>&#xa;                    &lt;CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$ParseRecord/Rows/tns1:MigrazioneUllSlu[1]/tns1:CodProgetto&quot;/>&#xa;                    &lt;/CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/Testata>&#xa;            &lt;Ordine>&#xa;                &lt;Migrazione>&#xa;                    &lt;CodiceRisorsa1>&#xa;                        &lt;xsl:value-of select=&quot;$currentElement/IDRISORSA_NOW&quot;/>&#xa;                    &lt;/CodiceRisorsa1>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='TIM RESIDENZIALI'&quot;>&#xa;                            &lt;CodiceSessione1>&#xa;                                &lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&#xa;                            &lt;/CodiceSessione1>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$currentElement/SEGMENTO_LINEA_NOW='ENT'&quot;>&#xa;                            &lt;CodiceSessione1>&#xa;                                &lt;xsl:value-of select=&quot;concat('MVGE-',tib:pad-front($currentElement/ID, 6, '0'))&quot;/>&#xa;                            &lt;/CodiceSessione1>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;CodiceSessione1>&#xa;                                &lt;xsl:value-of select=&quot;concat('MVG-',tib:pad-front($currentElement/ID, 7, '0'))&quot;/>&#xa;                            &lt;/CodiceSessione1>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;CodiceDonating1>&#xa;                        &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                    &lt;/CodiceDonating1>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ServizioAtterraggio='SLU'&quot;>&#xa;                            &lt;Servizio>&#xa;                                &lt;SLU>&#xa;                                    &lt;DestinazioneUso>&#xa;                                        &lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','RTG')&quot;>&#xa;                                            &lt;fonia>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/fonia>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','ADSL')&quot;>&#xa;                                            &lt;dati>&#xa;                                                &lt;TipoDati>&#xa;                                                    &lt;xsl:value-of select=&quot;'10'&quot;/>&#xa;                                                &lt;/TipoDati>&#xa;                                                &lt;BitRate>&#xa;                                                    &lt;xsl:value-of select=&quot;'64'&quot;/>&#xa;                                                &lt;/BitRate>&#xa;                                            &lt;/dati>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/DestinazioneUso>&#xa;                                    &lt;IdentificativoSLU>&#xa;                                        &lt;IdSLUCo>&#xa;                                            &lt;xsl:value-of select=&quot;concat($currentElement/ARMADIO_CLLI_UNICARA,'_TLC')&quot;/>&#xa;                                        &lt;/IdSLUCo>&#xa;                                        &lt;PosizioneARLTI1>&#xa;                                            &lt;xsl:value-of select=&quot;'000001'&quot;/>&#xa;                                        &lt;/PosizioneARLTI1>&#xa;                                    &lt;/IdentificativoSLU>&#xa;                                &lt;/SLU>&#xa;                            &lt;/Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;Servizio>&#xa;                                &lt;Ull>&#xa;                                    &lt;DestinazioneUso>&#xa;                                        &lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW=('RTG+ADSL','RTG')&quot;>&#xa;                                            &lt;fonia>&#xa;                                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                            &lt;/fonia>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;$currentElement/DETTAGLIO_LINEA_NOW='RTG+ADSL'&quot;>&#xa;                                            &lt;dati>&#xa;                                                &lt;TipoDati>&#xa;                                                    &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                                &lt;/TipoDati>&#xa;                                                &lt;BitRate>&#xa;                                                    &lt;xsl:value-of select=&quot;'64'&quot;/>&#xa;                                                &lt;/BitRate>&#xa;                                            &lt;/dati>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/DestinazioneUso>&#xa;                                    &lt;IdUllCo>&#xa;                                        &lt;xsl:value-of select=&quot;concat('TT',$currentElement/CLLI)&quot;/>&#xa;                                  