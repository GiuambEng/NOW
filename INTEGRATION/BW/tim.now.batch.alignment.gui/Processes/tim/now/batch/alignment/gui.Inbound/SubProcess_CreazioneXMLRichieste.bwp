                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d0a62001-f4b3-4707-8558-69d0bee44b8c+input&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ContenutoXMLSediOLT&quot;/>&lt;xsl:param name=&quot;ContenutoXMLCanaleSedi&quot;/>&lt;xsl:param name=&quot;ContenutoXMLCanaleFeeder&quot;/>&lt;xsl:param name=&quot;MapperCreateProcessInstance&quot;/>&lt;xsl:template name=&quot;InsAcquisizione_Richieste-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CODICE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodificaOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_OLO>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:double($Start/tns1:IdFile)&quot;/>&lt;/ID_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&lt;PROGR_RICHIESTA_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:InputSediOlt[$index]/tns1:NumeroRecord)&quot;/>&lt;/PROGR_RICHIESTA_FILE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&lt;PROGR_RICHIESTA_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:InputCanaleFeeder[$index]/tns1:NumeroRecord)&quot;/>&lt;/PROGR_RICHIESTA_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PROGR_RICHIESTA_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/tns1:InputCanaleSedi[$index]/tns1:NumeroRecord)&quot;/>&lt;/PROGR_RICHIESTA_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;AMBITO>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/AMBITO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;$ContenutoXMLSediOLT&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;$ContenutoXMLCanaleFeeder&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONTENUTO_XML_OLO>&lt;xsl:value-of select=&quot;$ContenutoXMLCanaleSedi&quot;/>&lt;/CONTENUTO_XML_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;STATO>&lt;xsl:value-of select=&quot;&amp;quot;INSERITO&amp;quot;&quot;/>&lt;/STATO>&lt;NUMERO_RETRY>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/NUMERO_RETRY>&lt;XML_CASEDATA_RICHIESTA>&lt;xsl:value-of select=&quot;tib:render-xml($MapperCreateProcessInstance)&quot;/>&lt;/XML_CASEDATA_RICHIESTA>&lt;TIMESTAMP_CREAZIONE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMESTAMP_CREAZIONE>&lt;STRUTTURARICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/STRUTTURARICHIESTA>&lt;CANALE_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&lt;/CANALE_RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&lt;CODICE_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:InputSediOlt[$index]/tns1:CodiceOrdineOAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodiceOrdineOAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&lt;CODICE_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODICE_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:InputCanaleSedi[$index]/tns1:CodiceOrdineOAO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleSedi[$index]/tns1:CodiceOrdineOAO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ORDINE_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;PARAMETRO>&lt;xsl:value-of select=&quot;'MULTICAST'&quot;/>&lt;/PARAMETRO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ACQUISIZIONE_RICHIESTE (CODICE_OLO,ID_FILE,PROGR_RICHIESTA_FILE,AMBITO,CONTENUTO_XML_OLO,STATO,&#xd;&#xa;NUMERO_RETRY,XML_CASEDATA_RICHIESTA,TIMESTAMP_CREAZIONE,STRUTTURARICHIESTA,CANALE_RICHIESTA,CODICE_ORDINE_OLO,PARAMETRO) &#xd;&#xa;VALUES&#xd;&#xa;(?,?,?,?,?,?,?,?,?,?,?,?,?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO"/>
                                    <PreparedParameters
                                    DataType="8"
                                    DataTypeDisplayValue="DOUBLE" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PROGR_RICHIESTA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AMBITO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_XML_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RETRY"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="XML_CASEDATA_RICHIESTA"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMESTAMP_CREAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STRUTTURARICHIESTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CANALE_RICHIESTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ORDINE_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PARAMETRO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="Log_ContXML-input"
                                name="Log_ContXML"
                                tibex:xpdlId="5c24b62f-4cdd-4052-b3ae-d7db70d211e8"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ContenutoXMLSediOLTToCopy_1_Log_Input"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Log_ContXMLToRichiesta"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXMLSediOLT&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_ContXML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SubProcess_CreazioneXMLRichieste'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto XML SEDEOLT CREATO - RECORD :&amp;quot;,$Start/tns1:InputSediOlt[$index]/tns1:NumeroRecord,' - ',$ContenutoXMLSediOLT)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerName&quot;>&#xa;                    &lt;tns2:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerName&quot;/>&#xa;                    &lt;/tns2:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerLevel&quot;>&#xa;                    &lt;tns2:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerLevel&quot;/>&#xa;                    &lt;/tns2:LogLevel>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="UpdateSTAG_OK-input"
                                name="UpdateSTAG_OK"
                                outputVariable="UpdateSTAG_OK"
                                tibex:xpdlId="8aa74d32-c0f8-4995-8b6f-3a237e13fd41" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="InsAcquisizione_RichiesteToUpdateSTAG_OK"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="UpdateSTAG_OKToLog_End"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
