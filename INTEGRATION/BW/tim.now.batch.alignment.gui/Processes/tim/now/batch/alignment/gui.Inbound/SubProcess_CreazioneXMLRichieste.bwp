                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeNextWorkDate.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeNextWDayByDuration.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;calcoloDRO&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:IdFile)&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GUI&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;lavorazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;            &lt;/lavorazione>&#xa;            &lt;progressivoRichiestaFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:InputCanaleFeeder[$index]/tns1:NumeroRecord)&quot;/>&#xa;            &lt;/progressivoRichiestaFile>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:CodiceOLO&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;xsd:date(substring(xsd:string(current-date()),1,10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;ordine>&#xa;                &lt;offertaCatalogo>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CANALE&amp;quot;&quot;/>&#xa;                &lt;/offertaCatalogo>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery&quot;>&#xa;                    &lt;codiceDelivery>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery&quot;/>&#xa;                    &lt;/codiceDelivery>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:ClliFeeder&quot;>&#xa;                    &lt;CLLI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:ClliFeeder&quot;/>&#xa;                    &lt;/CLLI>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:Co