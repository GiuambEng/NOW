                                tibex:label="SEDEOLT" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link
                                name="Empty1ToContenutoXMLCanaleFeeder_CANALEFEEDER"
                                tibex:label="CANALEFEEDER" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link
                                name="Empty1ToContenutoXMLCanaleSedi_CANALESEDI"
                                tibex:label="CANALESEDI" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link
                                name="ContenutoXMLSediOLTToCopy_1_Log_Input" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Log_ContXMLToRichiesta" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="InsAcquisizione_RichiesteToUpdateSTAG_OK" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="InsAcquisizione_RichiesteToCopy_1_Log_End" tibex:linkType="ERROR"/>
                            <bpws:link name="Log_EndToGroupEnd" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdateSTAG_OKToLog_End" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpdateSTAG_KOToLog_End" tibex:linkType="SUCCESS"/>
