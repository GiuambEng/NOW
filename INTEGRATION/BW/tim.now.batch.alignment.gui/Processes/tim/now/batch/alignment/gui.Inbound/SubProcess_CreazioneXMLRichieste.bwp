                            <bpws:link
                                name="Log_ContXML2ToCopy_1_Richiesta" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Log_ContXML3ToCopy_1_Richiesta1" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Copy_1_Log_EndToUpdateSTAG_KO" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="RichiestaToCopy_1_Log_ContXML" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Copy_1_Log_ContXMLToMapperCreateProcessInstance" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Richiesta1ToCopy_1_LogRichiesta" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Copy_1_LogRichiestaToMapperCreateProcessInstance" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Richiesta2ToCopy_1_LogRichiesta1" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Copy_1_LogRichiesta1ToMapperCreateProcessInstance" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="MapperCreateProcessInstanceToCopy_1_Log_ContXML3" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="Copy_1_Log_ContXML3ToInsAcquisizione_Richieste" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Richiesta2ToLogError" tibex:linkType="ERROR"/>
                            <bpws:link name="Richiesta1ToLogError" tibex:linkType="ERROR"/>
                            <bpws:link name="RichiestaToLogError" tibex:linkType="ERROR"/>
                        </bpws:links>
                        <bpws:assign name="GroupStart"
                            tibex:group="groupStart"
                            tibex:xpdlId="499d6bea-01eb-4827-88a4-8b56af5cabb0" validate="no">
                            <bpws:sources>
