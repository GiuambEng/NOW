                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="570e6eb5-a14c-4c9c-b7d5-591566339928"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="InsAcquisizione_RichiesteToCopy_1_Log_End"/>
                                    <bpws:target linkName="Richiesta2ToLogError"/>
                                    <bpws:target linkName="Richiesta1ToLogError"/>
                                    <bpws:target linkName="RichiestaToLogError"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Copy_1_Log_EndToUpdateSTAG_KO"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'SubProcess_CreazioneXMLRichieste'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore InsAcqRich - RECORD : &amp;quot;,$Start/tns1:InputSediOlt[$index]/tns1:NumeroRecord,' - ',tib:render-xml($_error/StackTrace,true(),true()))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore InsAcqRich - RECORD : &amp;quot;,$Start/tns1:InputCanaleFeeder[$index]/tns1:NumeroRecord,' - ',tib:render-xml($_error/StackTrace,true(),true()))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore InsAcqRich - RECORD : &amp;quot;,$Start/tns1:InputCanaleSedi[$index]/tns1:NumeroRecord,' - ',tib:render-xml($_error/StackTrace,true(),true()))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerName&quot;>&#xa;                    &lt;tns2:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerName&quot;/>&#xa;                    &lt;/tns2:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerLevel&quot;>&#xa;                    &lt;tns2:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerLevel&quot;/>&#xa;                    &lt;/tns2:LogLevel>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
