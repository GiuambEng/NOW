                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="ContenutoXMLSediOLT-input"
                                name="ContenutoXMLSediOLT"
                                outputVariable="ContenutoXMLSediOLT"
                                tibex:xpdlId="97b3a558-d80a-4662-adbd-7a05c1d2bd84" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToContenutoXMLSediOLT_SEDEOLT"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="ContenutoXMLSediOLTToCopy_1_Log_Input"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; xmlns:ns01=&quot;http://multicast.telecomitalia.it/crm/multicast/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoXMLSediOLT-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns01:Richiesta>&#xa;            &lt;ns01:Testata>&#xa;                &lt;ns01:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLO&quot;/>&#xa;                &lt;/ns01:CodiceOlo>&#xa;                &lt;ns01:CodiceOloAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&#xa;                &lt;/ns01:CodiceOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:InputSediOlt[$index]/tns1:CodiceOrdineOAO)>0&quot;>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodiceOrdineOAO&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;'ND'&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodProgetto&quot;>&#xa;                    &lt;ns01:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodProgetto&quot;/>&#xa;                    &lt;/ns01:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns01:Testata>&#xa;            &lt;ns01:TipoRichiesta>&#xa;                &lt;ns01:Attivazione>&#xa;                    &lt;ns01:SedeOLT>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputSediOlt[$index]/tns1:ClliSedeOlt&quot;>&#xa;                            &lt;ns01:CLLICentrale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:ClliSedeOlt&quot;/>&#xa;                            &lt;/ns01:CLLICentrale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputSediOlt[$index]/tns1:BandaOltParDis&quot;>&#xa;                            &lt;ns01:Banda>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:BandaOltParDis&quot;/>&#xa;                            &lt;/ns01:Banda>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodDelivery&quot;>&#xa;                            &lt;ns01:CodiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:CodDelivery&quot;/>&#xa;                            &lt;/ns01:CodiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns01:SedeOLT>&#xa;                &lt;/ns01:Attivazione>&#xa;            &lt;/ns01:TipoRichiesta>&#xa;        &lt;/ns01:Richiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://multicast.telecomitalia.it/crm/multicast/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="order:Richiesta"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
