:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipologiaSottolav>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NORMALE&amp;quot;&quot;/>&#xa;            &lt;/tipologiaSottolav>&#xa;        &lt;/tns3:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
