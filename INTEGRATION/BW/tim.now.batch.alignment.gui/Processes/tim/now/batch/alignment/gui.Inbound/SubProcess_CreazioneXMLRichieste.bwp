                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="ContenutoXMLCanaleSedi-input"
                                name="ContenutoXMLCanaleSedi"
                                outputVariable="ContenutoXMLCanaleSedi"
                                tibex:xpdlId="ed2e2f45-248f-47d3-b2a9-c9bdaf86b717" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToContenutoXMLCanaleSedi_CANALESEDI"/>
