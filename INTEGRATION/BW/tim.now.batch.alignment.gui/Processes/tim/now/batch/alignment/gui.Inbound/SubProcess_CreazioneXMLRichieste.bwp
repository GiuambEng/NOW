         &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $InvokeNextWDayByDuration/parameters/tns2:Response/tns2:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()), &amp;quot;T&amp;quot;), &amp;quot;.&amp;quot;)), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO), &amp;quot;T&amp;quot;), &amp;quot;+&amp;quot;))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeNextWorkDate/parameters/tns2:Response/tns2:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipologiaSottolav>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CANALEESISTENTEOLT&amp;quot;&quot;/>&#xa;            &lt;/tipologiaSottolav>&#xa;        &lt;/tns3:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
