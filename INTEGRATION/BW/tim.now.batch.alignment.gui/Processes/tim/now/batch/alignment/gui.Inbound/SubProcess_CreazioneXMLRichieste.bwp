                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="154357f3-89c9-40ed-94aa-1abf082ebc3e">
                <bpws:targets>
                    <bpws:target linkName="Copy_1_Log_InputToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCopy_1_Log_End"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:while name="while" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="if ($Start/ns2:TipoRichiesta='SEDEOLT') then $index &lt;= count ($Start/ns2:InputSediOlt)&#xd;&#xa;else if ($Start/ns2:TipoRichiesta='CANALEFEEDER') then $index &lt;= count ($Start/ns2:InputCanaleFeeder)&#xd;&#xa;else $index &lt;= count ($Start/ns2:InputCanaleSedi)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if ($Start/ns2:TipoRichiesta='SEDEOLT') then $index <= count ($Start/ns2:InputSediOlt)
else if ($Start/ns2:TipoRichiesta='CANALEFEEDER') then $index <= count ($Start/ns2:InputCanaleFeeder)
else $index <= count ($Start/ns2:InputCanaleSedi)]]></bpws:condition>
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="GroupStartToEmpty1" tibex:linkType="SUCCESS"/>
