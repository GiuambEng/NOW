                           &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'IPSORGENTE'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPSorgente&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IPMulticast)>0&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;'IPMULTICAST'&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPMulticast&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery)>0&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICEDELIVERY&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale)>0&quot;>&#xa;                        &lt;attributiDettaglioOrdine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;nomeAttributo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IDRISORSA&amp;quot;&quot;/>&#xa;                            &lt;/nomeAttributo>&#xa;                            &lt;valoreAttributo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;/>&#xa;                            &lt;/valoreAttributo>&#xa;                            &lt;tipologiaDato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaDato>&#xa;                        &lt;/attributiDettaglioOrdine>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;progressivo>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivo>&#xa;                &lt;/dettaglioordine>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CANALE&amp;quot;&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/ordine>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns1:IdContratto,&amp;quot;.&amp;quot;)&quot;>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(substring-before($Start/tns1:IdContratto, &amp;quot;.&amp;quot;))&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:IdContratto)&quot;/>&#xa;                    &lt;/IDContratto>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CANALE&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;IDOfferta>&#xa;                &lt;xsl:value-of select=&quot;73&quot;/>&#xa;            &lt;/IDOfferta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;tib:compare-date(current-date(), $InvokeNextWDayByDuration.parameters/tns2:outputDate) !=0&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeNextWDayByDuration.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(tib:compare-date(current-date(), $InvokeNextWDayByDuration.parameters/tns2:outputDate) !=0) or (tib:compare-time(xsd:time(substring-before(substring-after(xsd:string(current-dateTime()), &amp;quot;T&amp;quot;), &amp;quot;.&amp;quot;)), xsd:time(substring-before(substring-after(xsd:string($calcoloDRO), &amp;quot;T&amp;quot;), &amp;quot;+&amp;quot;))) = -1)&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()), &amp;quot;+&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeNextWorkDate.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale)>0&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CANALEESISTENTEFEEDER&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CREAZIONECANALEFEEDER&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
