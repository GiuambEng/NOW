               &lt;/tns2:name>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($Richiesta)&quot;/>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($Richiesta1)&quot;/>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($Richiesta2)&quot;/>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns2:parameter>&#xa;                &lt;tns2:parameter>&#xa;                    &lt;tns2:name>&#xa;                        &lt;xsl:value-of select=&quot;'numeroRecordCSV'&quot;/>&#xa;                    &lt;/tns2:name>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='SEDEOLT'&quot;>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:InputSediOlt[$index]/tns1:NumeroRecord)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:InputSediOlt[$index]/tns1:NumeroRecord&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoRichiesta='CANALEFEEDER'&quot;>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:InputCanaleFeeder[$index]/tns1:NumeroRecord)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:NumeroRecord&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:value>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Start/tns1:InputCanaleSedi[$index]/tns1:NumeroRecord)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleSedi[$index]/tns1:NumeroRecord&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:value>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns2:parameter>&#xa;            &lt;/tns2:parameterMap>&#xa;        &lt;/tns2:createProcessInstanceInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
