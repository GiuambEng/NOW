    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;ns:calcNextWorkingDateRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:CalcRequest&gt;
                    &lt;tns2:inputDate&gt;
                        &lt;xsl:value-of select="current-date()"/&gt;
                    &lt;/tns2:inputDate&gt;
                &lt;/tns2:CalcRequest&gt;
            &lt;/parameters&gt;
        &lt;/ns:calcNextWorkingDateRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
