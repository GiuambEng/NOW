                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/CreazioneXMLRichiesta&quot; xmlns:ns01=&quot;http://multicast.telecomitalia.it/crm/multicast/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoXMLCanaleFeeder-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns01:Richiesta>&#xa;            &lt;ns01:Testata>&#xa;                &lt;ns01:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLO&quot;/>&#xa;                &lt;/ns01:CodiceOlo>&#xa;                &lt;ns01:CodiceOloAgcom>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&#xa;                &lt;/ns01:CodiceOloAgcom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO)>0&quot;>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceOrdineOAO&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns01:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;'ND'&quot;/>&#xa;                        &lt;/ns01:CodiceOrdineOlo>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceProgetto&quot;>&#xa;                    &lt;ns01:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceProgetto&quot;/>&#xa;                    &lt;/ns01:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns01:Testata>&#xa;            &lt;ns01:TipoRichiesta>&#xa;                &lt;ns01:Attivazione>&#xa;                    &lt;ns01:CanaleFeeder>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:ClliFeeder&quot;>&#xa;                            &lt;ns01:CLLICentrale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:ClliFeeder&quot;/>&#xa;                            &lt;/ns01:CLLICentrale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:BandaNominale&quot;>&#xa;                            &lt;ns01:Banda>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:BandaNominale&quot;/>&#xa;                            &lt;/ns01:Banda>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPSorgente&quot;>&#xa;                            &lt;ns01:IPSorgente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPSorgente&quot;/>&#xa;                            &lt;/ns01:IPSorgente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPMulticast&quot;>&#xa;                            &lt;ns01:IPMulticast>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IPMulticast&quot;/>&#xa;                            &lt;/ns01:IPMulticast>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;>&#xa;                            &lt;ns01:IDCanale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;/>&#xa;                            &lt;/ns01:IDCanale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery&quot;>&#xa;                            &lt;ns01:CodiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceDelivery&quot;/>&#xa;                            &lt;/ns01:CodiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns01:CanaleFeeder>&#xa;                &lt;/ns01:Attivazione>&#xa;            &lt;/ns01:TipoRichiesta>&#xa;        &lt;/ns01:Richiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
