          &lt;xsl:value-of select=&quot;concat(&amp;quot;Elaborazione record terminata - RECORD : &amp;quot;,$Start/tns1:InputCanaleSedi[$index]/tns1:NumeroRecord)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerName&quot;>&#xa;                    &lt;tns2:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerName&quot;/>&#xa;                    &lt;/tns2:LoggerName>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:LoggerLevel&quot;>&#xa;                    &lt;tns2:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LoggerLevel&quot;/>&#xa;                    &lt;/tns2:LogLevel>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
