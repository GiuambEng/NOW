                  &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:CodiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAgcom&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;tipologiaLavorazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tipologiaLavorazione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:InputCanaleFeeder[$index]/tns1:IDCanale)>0&quot;>&#xa;                        &lt;tipologiaSottolav>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CANALEESISTENTEFEEDER&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaSottolav>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tipologiaSottolav>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CREAZIONECANALEFEEDER&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaSottolav>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choo