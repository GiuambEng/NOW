            <bpws:links>
                <bpws:link name="StartToLog_InputStaging" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToCopy_1_Log_End" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_Log_EndToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Copy_1_Log_InputToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log_InputToInvokeNextDate" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeNextWorkDateToInvokeNextWDayByD" tibex:linkType="SUCCESS"/>
                <bpws:link name="InvokeNextWDayByDToLogInvokeNextDate" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="2a5c791c-8a3d-43d5-936c-26c70b65d708"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog_InputStaging"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
