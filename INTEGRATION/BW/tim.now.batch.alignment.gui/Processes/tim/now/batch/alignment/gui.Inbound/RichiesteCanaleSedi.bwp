FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns1:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns1:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns1:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns1:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns1:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:InputFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:InputFile>&#xa;                                &lt;tns1:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns1:ID_FILE>&#xa;                                &lt;tns1:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns1:STATO_ESEC>&#xa;                                &lt;tns1:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:ESITO>&#xa;                                &lt;tns1:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns1:DESCR_STATO_FILE>&#xa;                                &lt;tns1:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:LOG_MESSAGE>&#xa;                                &lt;tns1:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns1:RECORD_OK>&#xa;                                &lt;tns1:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns1:RECORD_KO>&#xa;                                &lt;tns1:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns1:RECORD_TOTALI>&#xa;                            &lt;/tns1:InputFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:OutputFile>&#xa;                        &lt;tns1:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                        &lt;/tns1:ID_FILE>&#xa;                    &lt;/tns1:OutputFile>&#xa;                &lt;/tns1:Update>&#xa;            &lt;/tns1:DataIn>&#xa;            &lt;tns1:LogElement>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;            &lt;/tns1:LogElement>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
