                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/ContenutoRecdRichCanaleSedi&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RichCanaleSedi&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoRecdCanaleSedi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:InputRichCanaleSedi_ContenutoRecord>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns1:RichCanaleSedi)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns1:RichCanaleSedi&quot;>&#xa;                        &lt;tns4:ContenutoRecordRichCanaleSedi_input>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceOrdineOAO&quot;>&#xa;                                &lt;tns4:CodiceOrdineOAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceOrdineOAO&quot;/>&#xa;                                &lt;/tns4:CodiceOrdineOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Azione&quot;>&#xa;                                &lt;tns4:Azione>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Azione&quot;/>&#xa;                                &lt;/tns4:Azione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ClliSedeOlt&quot;>&#xa;                                &lt;tns4:ClliSedeOlt>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ClliSedeOlt&quot;/>&#xa;                                &lt;/tns4:ClliSedeOlt>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDCanale&quot;>&#xa;                                &lt;tns4:IDCanale>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDCanale&quot;/>&#xa;                                &lt;/tns4:IDCanale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDCanaleOld&quot;>&#xa;                                &lt;tns4:IDCanaleOld>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDCanaleOld&quot;/>&#xa;                                &lt;/tns4:IDCanaleOld>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceProgetto&quot;>&#xa;                                &lt;tns4:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceProgetto&quot;/>&#xa;                                &lt;/tns4:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceDelivery&quot;>&#xa;                                &lt;tns4:CodiceDelivery>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceDelivery&quot;/>&#xa;                                &lt;/tns4:CodiceDelivery>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/tns4:ContenutoRecordRichCanaleSedi_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns1:RichCanaleSedi&quot;>&#xa;                        &lt;tns4:ContenutoRecordRichCanaleSedi_input>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceOrdineOAO&quot;>&#xa;                                &lt;tns4:CodiceOrdineOAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceOrdineOAO&quot;/>&#xa;                                &lt;/tns4:CodiceOrdineOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Azione&quot;>&#xa;                                &lt;tns4:Azione>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Azione&quot;/>&#xa;                                &lt;/tns4:Azione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ClliSedeOlt&quot;>&#xa;                                &lt;tns4:ClliSedeOlt>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ClliSedeOlt&quot;/>&#xa;                                &lt;/tns4:ClliSedeOlt>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDCanale&quot;>&#xa;                                &lt;tns4:IDCanale>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDCanale&quot;/>&#xa;                                &lt;/tns4:IDCanale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:IDCanaleOld&quot;>&#xa;                                &lt;tns4:IDCanaleOld>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:IDCanaleOld&quot;/>&#xa;                                &lt;/tns4:IDCanaleOld>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceProgetto&quot;>&#xa;                                &lt;tns4:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceProgetto&quot;/>&#xa;                                &lt;/tns4:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:CodiceDelivery&quot;>&#xa;                                &lt;tns4:CodiceDelivery>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CodiceDelivery&quot;/>&#xa;                                &lt;/tns4:CodiceDelivery>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns4:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;/tns4:NumeroRecord>&#xa;                        &lt;/tns4:ContenutoRecordRichCanaleSedi_input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns4:InputRichCanaleSedi_ContenutoRecord>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
