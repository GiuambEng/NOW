                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePathMove&quot;/>&#xa;    &lt;xsl:param name=&quot;PathFileError&quot;/>&#xa;    &lt;xsl:template name=&quot;MapDetails-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Details>&#xa;            &lt;tns1:InputDetails>&#xa;                &lt;tns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NomeTabellaScarto&amp;quot;&quot;/>&#xa;                &lt;/tns1:NOME>&#xa;                &lt;tns1:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ST_CANALISEDIOLTMA_OAO_FL&amp;quot;&quot;/>&#xa;                &lt;/tns1:VALORE>&#xa;            &lt;/tns1:InputDetails>&#xa;            &lt;tns1:InputDetails>&#xa;                &lt;tns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PathFileScarto&amp;quot;&quot;/>&#xa;                &lt;/tns1:NOME>&#xa;                &lt;tns1:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;                &lt;/tns1:VALORE>&#xa;            &lt;/tns1:InputDetails>&#xa;            &lt;tns1:InputDetails>&#xa;                &lt;tns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ErrorPathFile&amp;quot;&quot;/>&#xa;                &lt;/tns1:NOME>&#xa;                &lt;tns1:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$PathFileError&quot;/>&#xa;                &lt;/tns1:VALORE>&#xa;            &lt;/tns1:InputDetails>&#xa;            &lt;tns1:InputDetails>&#xa;                &lt;tns1:NOME>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;