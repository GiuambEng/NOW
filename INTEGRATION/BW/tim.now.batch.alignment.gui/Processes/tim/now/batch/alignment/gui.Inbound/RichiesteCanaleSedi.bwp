                                    nillable="true" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="DESCR_ERRORE"
                                    nillable="true" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="COD_ORDINE_OAO"
                                    nillable="true" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="AZIONE" nillable="true" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
