                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/activity/parse/xsd/+9c9219e5-4cf1-4335-8147-efae6dbcd238+input&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:template name=&quot;DetailUltimi_NoVal-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:FULLNAME&quot;/>&#xa;            &lt;/fileName>&#xa;            &lt;startRecord>&#xa;                &lt;xsl:value-of select=&quot;($index - 1) * $Passo + 1&quot;/>&#xa;            &lt;/startRecord>&#xa;            &lt;noOfRecords>&#xa;                &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord mod $Passo&quot;/>&#xa;            &lt;/noOfRecords>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.parse.parsedata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
