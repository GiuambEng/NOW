                    <bpws:sources>
                        <bpws:source linkName="Output_Log_counterToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns32:queueResponse/ns32:NumeroRecord=0 and$JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='OK')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns32:queueResponse/ns32:NumeroRecord=0 and$JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='OK')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToUpCount">
                            <tibex:DesignExpression>
                                <tibex:expression
