                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="InputStag"
                                    name="Input_Staging"
                                    outputVariable="InputStag"
                                    tibex:xpdlId="73599cd2-0419-4253-b63f-43ed865e2adc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ContenutoRecdIncentiviOAOToInput_Staging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Input_StagingToCallProcess1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:tns2=&quot;http://www.example.org/InputStagingRichCanaleSedi&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RichCanaleSedi&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;ContenutoRecdCanaleSedi&quot;/>&lt;xsl:template name=&quot;InputStag&quot; match=&quot;/&quot;>&lt;tns2:RichCanaleSediStaging>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns3:RichCanaleSedi)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns3:RichCanaleSedi&quot;>&lt;tns2:InputStagingRichCanaleSedi>&lt;xsl:variable name=&quot;DESCR_ERRORE&quot; select=&quot;if(tns3:Azione!='A') then concat('Azione ',tns3:Azione,' non ammessa') else ''&quot;/>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns3:CodiceOrdineOAO&quot;>&lt;tns2:CodiceOrdineOAO>&lt;xsl:value-of select=&quot;tns3:CodiceOrdineOAO&quot;/>&lt;/tns2:CodiceOrdineOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:Azione&quot;>&lt;tns2:Azione>&lt;xsl:value-of select=&quot;tns3:Azione&quot;/>&lt;/tns2:Azione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ClliSedeOlt&quot;>&lt;tns2:CllSedeOlt>&lt;xsl:value-of select=&quot;tns3:ClliSedeOlt&quot;/>&lt;/tns2:CllSedeOlt>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:IDCanale&quot;>&lt;tns2:IDCanale>&lt;xsl:value-of select=&quot;tns3:IDCanale&quot;/>&lt;/tns2:IDCanale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:IDCanaleOld&quot;>&lt;tns2:IDCanaleOld>&lt;xsl:value-of select=&quot;tns3:IDCanaleOld&quot;/>&lt;/tns2:IDCanaleOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CodiceProgetto&quot;>&lt;tns2:CodiceProgetto>&lt;xsl:value-of select=&quot;tns3:CodiceProgetto&quot;/>&lt;/tns2:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CodiceDelivery&quot;>&lt;tns2:CodiceDelivery>&lt;xsl:value-of select=&quot;tns3:CodiceDelivery&quot;/>&lt;/tns2:CodiceDelivery>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DESCR_ERRORE)>0&quot;>&lt;tns2:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$DESCR_ERRORE&quot;/>&lt;/tns2:DESCR_ERRORE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns2:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns2:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DESCR_ERRORE)>0&quot;>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:NUMRECORD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns2:NUMRECORD>&lt;xsl:if test=&quot;$ContenutoRecdCanaleSedi/ns1:Output_ContenutoRecord[ns1:Posizione = $var]/ns1:Valore&quot;>&lt;tns2:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecdCanaleSedi/ns1:Output_ContenutoRecord[ns1:Posizione = $var]/ns1:Valore&quot;/>&lt;/tns2:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns2:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TMSP_INSMTO>&lt;/tns2:InputStagingRichCanaleSedi>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns3:RichCanaleSedi&quot;>&lt;tns2:InputStagingRichCanaleSedi>&lt;xsl:variable name=&quot;DESCR_ERRORE1&quot; select=&quot;if(tns3:Azione!='A') then concat('Azione ',tns3:Azione,' non ammessa') else ''&quot;/>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns3:CodiceOrdineOAO&quot;>&lt;tns2:CodiceOrdineOAO>&lt;xsl:value-of select=&quot;tns3:CodiceOrdineOAO&quot;/>&lt;/tns2:CodiceOrdineOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:Azione&quot;>&lt;tns2:Azione>&lt;xsl:value-of select=&quot;tns3:Azione&quot;/>&lt;/tns2:Azione>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ClliSedeOlt&quot;>&lt;tns2:CllSedeOlt>&lt;xsl:value-of select=&quot;tns3:ClliSedeOlt&quot;/>&lt;/tns2:CllSedeOlt>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:IDCanale&quot;>&lt;tns2:IDCanale>&lt;xsl:value-of select=&quot;tns3:IDCanale&quot;/>&lt;/tns2:IDCanale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:IDCanaleOld&quot;>&lt;tns2:IDCanaleOld>&lt;xsl:value-of select=&quot;tns3:IDCanaleOld&quot;/>&lt;/tns2:IDCanaleOld>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CodiceProgetto&quot;>&lt;tns2:CodiceProgetto>&lt;xsl:value-of select=&quot;tns3:CodiceProgetto&quot;/>&lt;/tns2:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CodiceDelivery&quot;>&lt;tns2:CodiceDelivery>&lt;xsl:value-of select=&quot;tns3:CodiceDelivery&quot;/>&lt;/tns2:CodiceDelivery>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DESCR_ERRORE1)>0&quot;>&lt;tns2:DESCR_ERRORE>&lt;xsl:value-of select=&quot;$DESCR_ERRORE1&quot;/>&lt;/tns2:DESCR_ERRORE>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns2:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns2:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($DESCR_ERRORE1)>0&quot;>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:NUMRECORD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns2:NUMRECORD>&lt;xsl:if test=&quot;$ContenutoRecdCanaleSedi/ns1:Output_ContenutoRecord[ns1:Posizione = $var1]/ns1:Valore&quot;>&lt;tns2:CONTENUTO_RECORD>&lt;xsl:value-of select=&quot;$ContenutoRecdCanaleSedi/ns1:Output_ContenutoRecord[ns1:Posizione = $var1]/ns1:Valore&quot;/>&lt;/tns2:CONTENUTO_RECORD>&lt;/xsl:if>&lt;tns2:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TMSP_INSMTO>&lt;/tns2:InputStagingRichCanaleSedi>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:RichCanaleSediStaging>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
