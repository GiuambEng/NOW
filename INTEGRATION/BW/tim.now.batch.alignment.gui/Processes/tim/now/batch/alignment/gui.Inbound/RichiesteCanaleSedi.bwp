                partnerLink="Logger" portType="ns1:ProcessLog" tibex:xpdlId="062b4a71-a6a4-48f0-a42b-d2975640a4bf">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="www.tim.now.contarecord_jms.response" version="2.0"&gt;
    &lt;xsl:param name="JMSReceiveMessage"/&gt;
    &lt;xsl:template name="UpCount-input" match="/"&gt;
        &lt;tns1:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns3:Input&gt;
                    &lt;ns3:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns3:TipologiaProcesso&gt;
                    &lt;ns3:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;COUNTER&amp;quot;"/&gt;
                    &lt;/ns3:TipologiaOperazione&gt;
                    &lt;ns3:FileProcessatoInput&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"&gt;
                            &lt;ns3:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"/&gt;
                            &lt;/ns3:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"&gt;
                            &lt;ns3:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"/&gt;
                            &lt;/ns3:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns3:FileProcessatoInput&gt;
                &lt;/ns3:Input&gt;
            &lt;/part1&gt;
        &lt;/tns1:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;UpCount-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns3:TipologiaProcesso>&#xa;            &lt;ns3:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;COUNTER&amp;quot;&quot;/>&#xa;            &lt;/ns3:TipologiaOperazione>&#xa;            &lt;ns3:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                    &lt;ns3:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns3:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                    &lt;ns3:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                    &lt;/ns3:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns3:FileProcessatoInput>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
