                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_ListFilesModificaContrattoToIterate5"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListFilesModificaContratti&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_ListFilesModificaContratti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'StartTrackFile'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;***Trovati nel repository Modifica Contratti i seguenti file : ***&amp;quot;, tib:render-xml($ListFilesModificaContratti, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate5" tibex:group="iterate" tibex:xpdlId="f82dea3f-3a74-41d6-9221-ef7d45c42c60">
                <bpws:targets>
                    <bpws:target linkName="Log_ListFilesModificaContrattoToIterate5"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate5ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence5" tibex:group="iterate">
                    <bpws:empty name="GroupInit5" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate5"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesModificaContratti/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesModificaContratti/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope5">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate5_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow6">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart5ToCallProcess" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcessToCallProcess11" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CallProcess1ToGroupEnd5" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart5"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="37912194-ebba-460a-a4b5-85fdea7cf644" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart5ToCallProcess"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesModificaContratti/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd5"
                                    tibex:group="groupEnd" tibex:xpdlId="b943cced-e0df-4bbd-a554-256c9fd8a296">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToGroupEnd5"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CheckFileName7-input"
                                    name="CheckFileName7"
                                    outputVariable="CheckFileName7"
                                    tibex:xpdlId="5be1229c-6c8c-4da6-ad00-6baed9d6871c"
