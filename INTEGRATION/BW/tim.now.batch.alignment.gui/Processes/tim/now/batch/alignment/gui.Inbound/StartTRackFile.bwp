                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogFileMigKO-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'StartTrackFile'&quot;/>&lt;/tns2:Process>&lt;tns2:Message>&lt;xsl:value-of select=&quot;&amp;quot;***NON Trovati file nel repository MigrazioneUllSlu***&amp;quot;&quot;/>&lt;/tns2:Message>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate8" tibex:group="iterate"
                tibex:indexOriginalName="index"
                tibex:indexToGlobal="false" tibex:xpdlId="b02a6c10-63b3-4107-998a-ce5bdbd1fc0a">
                <bpws:targets>
                    <bpws:target linkName="LogFileMigOKToIterate8"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate8ToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence9" tibex:group="iterate">
                    <bpws:empty name="GroupInit9" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate9"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$MigrazioneUllSlu/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($MigrazioneUllSlu/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope9">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate8_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow10">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStart9ToControlloNomeFile1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ControlloNomeFile1ToGestioneLetturaTracciamento" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GestioneLetturaTracciamentoToGroupEnd9" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart9"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="5441605f-5218-4649-b6fe-dd7ab0fc3f28" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart9ToControlloNomeFile1"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($MigrazioneUllSlu/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd9"
                                    tibex:group="groupEnd" tibex:xpdlId="75e97b0c-bd2d-4a22-8b3e-10cd338e2f52">
                                    <bpws:targets>
                                    <bpws:target linkName="GestioneLetturaTracciamentoToGroupEnd9"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CheckNomeFile-input"
                                    name="CheckNomeFile"
                                    outputVariable="CheckNomeFile"
                                    tibex:xpdlId="41506232-41b9-4b22-a0fd-deb077f80d9f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart9ToControlloNomeFile1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ControlloNomeFile1ToGestioneLetturaTracciamento"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/CheckNomeFileGUI&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;ControlloNomeFile1-input&quot; match=&quot;/&quot;>&lt;tns3:Input>&lt;tns3:FILE_NAME>&lt;xsl:value-of select=&quot;$currentElement/fileName&quot;/>&lt;/tns3:FILE_NAME>&lt;/tns3:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.alignment.gui.Inbound.ControlloNomeFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Track_Migrazione-input"
                                    name="Track_Migrazione"
                                    tibex:xpdlId="181bb2d1-2ccf-4c8a-98cd-207494480cd9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ControlloNomeFile1ToGestioneLetturaTracciamento"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GestioneLetturaTracciamentoToGroupEnd9"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; xmlns:tns3=&quot;http://www.example.org/CheckNomeFileGUI&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;PathMoveMigrazioneUllSlu&quot;/>&lt;xsl:param name=&quot;PathErrorMigrazioneUllSlu&quot;/>&lt;xsl:param name=&quot;CheckNomeFile&quot;/>&lt;xsl:template name=&quot;Track_Migrazione-input&quot; match=&quot;/&quot;>&lt;tns1:InputFileTappo>&lt;tns1:FileName>&lt;xsl:value-of select=&quot;$currentElement/fullName&quot;/>&lt;/tns1:FileName>&lt;tns1:LogName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LogName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:ApplicationName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:ApplicationName>&lt;tns1:Estensione>&lt;xsl:value-of select=&quot;'.csv'&quot;/>&lt;/tns1:Estensione>&lt;tns1:Sistema>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns1:Sistema>&lt;tns1:Flusso>&lt;xsl:value-of select=&quot;$CheckNomeFile/tns3:FLUSSO&quot;/>&lt;/tns1:Flusso>&lt;tns1:PathError>&lt;xsl:value-of select=&quot;$PathErrorMigrazioneUllSlu&quot;/>&lt;/tns1:PathError>&lt;tns1:PathMovedTappo>&lt;xsl:value-of select=&quot;$PathMoveMigrazioneUllSlu&quot;/>&lt;/tns1:PathMovedTappo>&lt;/tns1:InputFileTappo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
