                    inputVariable="BonificaMacroArea-input"
                    name="BonificaMacroArea"
                    outputVariable="BonificaMacroArea"
                    tibex:xpdlId="0a9909b3-a7ab-4754-b765-1abc5cb96c61" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartTrackFileToBonificaMacroArea"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="BonificaMacroAreaToLog_ListFiles_BonificaMacroarea">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($BonificaMacroArea/files/fileInfo) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($BonificaMacroArea/files/fileInfo) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="BonificaMacroAreaToLog_ListFilesNOFILE_BonificaMacroArea">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PathFileBonificaMacroArea&quot;/>&lt;xsl:template name=&quot;BonificaMacroArea-input&quot; match=&quot;/&quot;>&lt;tns:ListFilesActivityConfig>&lt;fileName>&lt;xsl:value-of select=&quot;concat($PathFileBonificaMacroArea,&amp;quot;*.ctr&amp;quot;)&quot;/>&lt;/fileName>&lt;/tns:ListFilesActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.file.list"
