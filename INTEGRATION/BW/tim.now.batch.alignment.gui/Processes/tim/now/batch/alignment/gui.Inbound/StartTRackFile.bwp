                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart5ToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCallProcess11"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/CheckNomeFileGUI&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckFileName7-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input>&#xa;            &lt;tns3:FILE_NAME>&#xa;                &lt;xsl:value-of select=&quot;$currentElement/fileName&quot;/>&#xa;            &lt;/tns3:FILE_NAME>&#xa;        &lt;/tns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
