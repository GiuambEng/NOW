                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="Iterate_RisorseFWADeco"
                tibex:group="iterate" tibex:xpdlId="486b64c3-2e42-43e9-ac71-c3b6e48f2808">
                <bpws:targets>
                    <bpws:target linkName="Log_ListFiles_RisorseFWADecoToIterate6"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Iterate_RisorseFWADecoToExit"/>
                </bpws:sources>
                <bpws:sequence name="sequence6" tibex:group="iterate">
                    <bpws:empty name="GroupInit6" tibex:group="groupInit"/>
                    <bpws:forEach counterName="index" name="iterate6"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$ListFilesRisorseFWADeco/files/fileInfo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ListFilesRisorseFWADeco/files/fileInfo)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope6">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns1:Iterate_RisorseFWADeco_Current_Element_fileInfo"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow7">
                                <bpws:links>
                                    <bpws:link
                                    name="ControlloNomeFileToGestioneLetturaTracciamento" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart6ToControlloNomeFile" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GestioneLetturaTracciamentoToGroupEnd6" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart6"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="e17ce333-df29-4156-aa32-d3d8fad83ae1" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart6ToControlloNomeFile"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($ListFilesRisorseFWADeco/files/fileInfo)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd6"
                                    tibex:group="groupEnd" tibex:xpdlId="b382be29-257c-444c-9d9a-77cab111e54b">
                                    <bpws:targets>
                                    <bpws:target linkName="GestioneLetturaTracciamentoToGroupEnd6"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CheckFileName_RisorseFWADeco-input"
                                    name="CheckFileName_RisorseFWADeco"
                                    outputVariable="CheckFileName_RisorseFWADeco"
                                    tibex:xpdlId="476c55c2-75da-4fdd-839c-eba92c7fe25b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart6ToControlloNomeFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ControlloNomeFileToGestioneLetturaTracciamento"/>
                                    </bpws:sources>
