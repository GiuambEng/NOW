            &lt;/tns1:PathError>&#xa;            &lt;tns1:PathMovedTappo>&#xa;                &lt;xsl:value-of select=&quot;$PathMovedModificaContratti&quot;/>&#xa;            &lt;/tns1:PathMovedTappo>&#xa;        &lt;/tns1:InputFileTappo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.alignment.shared_library"
                                    subProcessName="tim.now.alignment.shared_library.ReadFile.GestioneLetturaTracciamento" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
