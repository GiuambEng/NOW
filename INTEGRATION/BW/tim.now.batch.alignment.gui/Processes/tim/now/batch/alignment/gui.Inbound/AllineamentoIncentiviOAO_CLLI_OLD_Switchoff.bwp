            </complexType>
            <element name="Input" type="tns:Input"/>
        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+9bd6a901-76b3-40ba-a428-4d3e07766f9c+output"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:Q1="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+9bd6a901-76b3-40ba-a428-4d3e07766f9c+output">
            <import namespace="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff"/>
            <import namespace="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff"/>
            <complexType name="Output">
                <sequence>
                    <element maxOccurs="1" minOccurs="1" name="Rows" type="tns:Rows"/>
                    <element maxOccurs="1" minOccurs="0"
                        name="ErrorRows" type="tns:ErrorRows"/>
                    <element maxOccurs="1" minOccurs="1" name="done" type="boolean"/>
                </sequence>
            </complexType>
            <element name="Output" type="tns:Output"/>
            <complexType name="Rows">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0" ref="Q1:IncentiviOAO_CLLI_OLD_Switchoff"/>
                </sequence>
            </complexType>
            <complexType name="ErrorRows">
                <sequence>
                    <element maxOccurs="unbounded" minOccurs="0"
