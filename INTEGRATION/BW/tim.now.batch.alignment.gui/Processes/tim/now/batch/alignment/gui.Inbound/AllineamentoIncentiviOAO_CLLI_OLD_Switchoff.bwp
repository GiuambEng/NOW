                </sequence>
            </complexType>
        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+6ccc500d-d6cd-463f-b9f2-33aebee3e87f+input"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+6ccc500d-d6cd-463f-b9f2-33aebee3e87f+input">
            <complexType name="Input">
                <sequence>
                    <element maxOccurs="1" minOccurs="1" name="fileName" type="string"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="startRecord" type="integer"/>
                    <element maxOccurs="1" minOccurs="1"
                        name="noOfRecords" type="integer"/>
                    <element maxOccurs="1" minOccurs="0"
                        name="SkipHeaderCharacters" type="integer"/>
                </sequence>
            </complexType>
            <element name="Input" type="tns:Input"/>
        </schema>
        <schema
            targetNamespace="http://tns.tibco.com/bw/activity/parse/xsd/+6ccc500d-d6cd-463f-b9f2-33aebee3e87f+output"
            xmlns="http://www.w3.org/2001/XMLSchema"
            xmlns:Q1="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff" xmlns:tns="http://tns.tibco.com/bw/activity/parse/xsd/+6ccc500d-d6cd-463f-b9f2-33aebee3e87f+output">
            <import namespace="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff"/>
            <import namespace="http://www.tim.com/NOW/xsd/IncentiviOAO_CLLI_OLD_Switchoff"/>
            <complexType name="Output">
                <sequence>
                    <element maxOccurs="1" minOccurs="1" name="Rows" type="tns:Rows"/>
                    <element maxOccurs="1" minOccurs="0"
