                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessLoggerTrack-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;tns4:DataIn>&#xa;                &lt;tns4:Update>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                            &lt;tns4:InputFile>&#xa;                                &lt;tns4:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns4:ID_FILE>&#xa;                                &lt;tns4:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                                &lt;/tns4:STATO_ESEC>&#xa;                                &lt;tns4:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns4:ESITO>&#xa;                                &lt;tns4:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                                &lt;/tns4:DESCR_STATO_FILE>&#xa;                                &lt;tns4:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns4:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns4:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns4:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                                    &lt;tns4:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                                    &lt;/tns4:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns4:InputFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:InputFile>&#xa;                                &lt;tns4:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                                &lt;/tns4:ID_FILE>&#xa;                                &lt;tns4:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns4:STATO_ESEC>&#xa;                                &lt;tns4:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns4:ESITO>&#xa;                                &lt;tns4:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns4:DESCR_STATO_FILE>&#xa;                                &lt;tns4:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns4:LOG_MESSAGE>&#xa;                                &lt;tns4:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_OK>&#xa;                                &lt;tns4:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_KO>&#xa;                                &lt;tns4:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns4:RECORD_TOTALI>&#xa;                            &lt;/tns4:InputFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns4:OutputFile>&#xa;                        &lt;tns4:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE)&quot;/>&#xa;                        &lt;/tns4:ID_FILE>&#xa;                    &lt;/tns4:OutputFile>&#xa;                &lt;/tns4:Update>&#xa;            &lt;/tns4:DataIn>&#xa;            &lt;tns4:LogElement>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;            &lt;/tns4:LogElement>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.ProcessLoggerTrack" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="TrackKOfunct-input"
                    name="TrackKOfunct"
                    tibex:xpdlId="00b7d994-58d6-42b8-bb27-2e32a0350fd5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LoggerKOFunctToTrackFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TrackFileToExit1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.example.org/InputTrackFile&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.example.org/ManageMoveFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;MoveScarto&quot;/>&#xa;    &lt;xsl:template name=&quot;TrackFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Input>&#xa;            &lt;tns5:Update>&#xa;                &lt;tns5:FLAG_LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:FLAG_LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                        &lt;tns5:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'KO_NUMERO_RECORD'&quot;/>&#xa;                        &lt;/tns5:STATO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'COMPLETATO'&quot;/>&#xa;                        &lt;/tns5:STATO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;tns5:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;concat('***ERRORE NUMERO RECORD, RECORD CONTATI= ',string($JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord))&quot;/>&#xa;                    &lt;/tns5:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns:queueResponse/ns:ID_TRACK)&quot;/>&#xa;                &lt;/tns5:ID_TRACK>&#xa;                &lt;xsl:if test=&quot;string-length($MoveScarto/tns4:FullPathMovedFile) > 0 and $JMSReceiveMessage/Body/ns:queueResponse/ns:EsitoConteggio='KO'&quot;>&#xa;                    &lt;xsl:if test=&quot;$MoveScarto/tns4:FullPathMovedFile&quot;>&#xa;                        &lt;tns5:FOLDER_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;$MoveScarto/tns4:FullPathMovedFile&quot;/>&#xa;                        &lt;/tns5:FOLDER_SCARTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:LogElement>&#xa;                    &lt;tns5:LoggerName>&#xa;                        &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                    &lt;/tns5:LoggerName>&#xa;                    &lt;tns5:LogLevel>&#xa;                        &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                    &lt;/tns5:LogLevel>&#xa;                &lt;/tns5:LogElement>&#xa;            &lt;/tns5:Update>&#xa;        &lt;/tns5:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.alignment.shared_library"
                        subProcessName="tim.now.alignment.shared_library.ReadFile.TrackFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit1" tibex:xpdlId="943f5184-2407-40c5-b660-5302e4663443">
                <bpws:targets>
                    <bpws:target linkName="TrackFileToExit1"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
