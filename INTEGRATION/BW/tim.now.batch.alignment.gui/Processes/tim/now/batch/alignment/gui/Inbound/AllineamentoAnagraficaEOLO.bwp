            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Output_Log_counter-input"
                    name="Output_Log_counter"
                    tibex:xpdlId="82c6a962-c39a-42a2-b7e4-7900d484b998"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Output_Log_counterToLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns2:queueResponse/ns2:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$JMSReceiveMessage/Body/ns2:queueResponse/ns2:EsitoConteggio='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
