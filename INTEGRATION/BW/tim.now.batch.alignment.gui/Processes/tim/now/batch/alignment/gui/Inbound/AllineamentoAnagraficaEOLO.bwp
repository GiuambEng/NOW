me&quot;/>&lt;/ns11:LogName>&lt;ns11:ApplicationName>&lt;xsl:value-of select=&quot;'tim.now.batch.alignment.gui.application'&quot;/>&lt;/ns11:ApplicationName>&lt;/ns11:LogInfo>&lt;/ns11:InputData>&lt;xsl:for-each select=&quot;$MapDetails/tns10:InputDetails&quot;>&lt;ns11:InputDetails>&lt;xsl:if test=&quot;tns10:NOME&quot;>&lt;ns11:NOME>&lt;xsl:value-of select=&quot;tns10:NOME&quot;/>&lt;/ns11:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns10:VALORE&quot;>&lt;ns11:VALORE>&lt;xsl:value-of select=&quot;tns10:VALORE&quot;/>&lt;/ns11:VALORE>&lt;/xsl:if>&lt;/ns11:InputDetails>&lt;/xsl:for-each>&lt;/ns11:ChiusuraAllineamenti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
