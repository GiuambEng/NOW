                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.example.org/tim.now.AnagraficaEOLO_Staging&quot; xmlns:tns7=&quot;http://www.example.org/tim.now.AnagraficaEOLO_Tracciato&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;DetailNoVal&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoRecdAnagraficaEOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;InputStaging&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:AnagraficaEOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns7:AnagraficaEOLO_dettaglio)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns7:AnagraficaEOLO_dettaglio&quot;>&#xa;                        &lt;tns8:AnagraficaEOLO_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecdAnagraficaEOLO/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;tns8:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecdAnagraficaEOLO/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &lt;/tns8:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns8:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns8:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns8:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns8:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns8:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns8:NUMERO_RECD>&#xa;                            &lt;tns8:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns8:TMSP_INSMTO>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_PROV&quot;>&#xa;                                &lt;tns8:DESCR_PROV>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_PROV&quot;/>&#xa;                                &lt;/tns8:DESCR_PROV>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_ISTAT_PROV&quot;>&#xa;                                &lt;tns8:COD_ISTAT_PROV>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_ISTAT_PROV&quot;/>&#xa;                                &lt;/tns8:COD_ISTAT_PROV>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_COMUNE&quot;>&#xa;                                &lt;tns8:DESCR_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_COMUNE&quot;/>&#xa;                                &lt;/tns8:DESCR_COMUNE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_ISTAT_COMUNE&quot;>&#xa;                                &lt;tns8:COD_ISTAT_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_ISTAT_COMUNE&quot;/>&#xa;                                &lt;/tns8:COD_ISTAT_COMUNE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;>&#xa;                                &lt;tns8:DESCR_PARTICELLA_TOPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;/>&#xa;                                &lt;/tns8:DESCR_PARTICELLA_TOPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_VIA&quot;>&#xa;                                &lt;tns8:DESCR_VIA>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_VIA&quot;/>&#xa;                                &lt;/tns8:DESCR_VIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_STRADA&quot;>&#xa;                                &lt;tns8:COD_STRADA>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_STRADA&quot;/>&#xa;                                &lt;/tns8:COD_STRADA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:NUMERO_CIVICO&quot;>&#xa;                                &lt;tns8:NUMERO_CIVICO>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:NUMERO_CIVICO&quot;/>&#xa;                                &lt;/tns8:NUMERO_CIVICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_TOPON&quot;>&#xa;                                &lt;tns8:COD_TOPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_TOPON&quot;/>&#xa;                                &lt;/tns8:COD_TOPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:CODICE_EGON&quot;>&#xa;                                &lt;tns8:CODICE_EGON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:CODICE_EGON&quot;/>&#xa;                                &lt;/tns8:CODICE_EGON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns8:AnagraficaEOLO_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns7:AnagraficaEOLO_dettaglio&quot;>&#xa;                        &lt;tns8:AnagraficaEOLO_dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;$ContenutoRecdAnagraficaEOLO/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&#xa;                                &lt;tns8:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$ContenutoRecdAnagraficaEOLO/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&#xa;                                &lt;/tns8:CONTENUTO_RECD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;>&#xa;                                &lt;tns8:ID_FILE_PROCSTO_INPUT>&#xa;                                    &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE&quot;/>&#xa;                                &lt;/tns8:ID_FILE_PROCSTO_INPUT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns8:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                            &lt;/tns8:ID_STATO_ELAB_STAG>&#xa;                            &lt;tns8:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/tns8:NUMERO_RECD>&#xa;                            &lt;tns8:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns8:TMSP_INSMTO>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_PROV&quot;>&#xa;                                &lt;tns8:DESCR_PROV>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_PROV&quot;/>&#xa;                                &lt;/tns8:DESCR_PROV>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_ISTAT_PROV&quot;>&#xa;                                &lt;tns8:COD_ISTAT_PROV>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_ISTAT_PROV&quot;/>&#xa;                                &lt;/tns8:COD_ISTAT_PROV>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_COMUNE&quot;>&#xa;                                &lt;tns8:DESCR_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_COMUNE&quot;/>&#xa;                                &lt;/tns8:DESCR_COMUNE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_ISTAT_COMUNE&quot;>&#xa;                                &lt;tns8:COD_ISTAT_COMUNE>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_ISTAT_COMUNE&quot;/>&#xa;                                &lt;/tns8:COD_ISTAT_COMUNE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;>&#xa;                                &lt;tns8:DESCR_PARTICELLA_TOPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;/>&#xa;                                &lt;/tns8:DESCR_PARTICELLA_TOPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:DESCR_VIA&quot;>&#xa;                                &lt;tns8:DESCR_VIA>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:DESCR_VIA&quot;/>&#xa;                                &lt;/tns8:DESCR_VIA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_STRADA&quot;>&#xa;                                &lt;tns8:COD_STRADA>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_STRADA&quot;/>&#xa;                                &lt;/tns8:COD_STRADA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:NUMERO_CIVICO&quot;>&#xa;                                &lt;tns8:NUMERO_CIVICO>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:NUMERO_CIVICO&quot;/>&#xa;                                &lt;/tns8:NUMERO_CIVICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:COD_TOPON&quot;>&#xa;                                &lt;tns8:COD_TOPON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:COD_TOPON&quot;/>&#xa;                                &lt;/tns8:COD_TOPON>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns7:CODICE_EGON&quot;>&#xa;                                &lt;tns8:CODICE_EGON>&#xa;                                    &lt;xsl:value-of select=&quot;tns7:CODICE_EGON&quot;/>&#xa;                                &lt;/tns8:CODICE_EGON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns8:AnagraficaEOLO_dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns8:AnagraficaEOLO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
