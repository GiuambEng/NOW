    xmlns:ns0="http://xmlns.example.com/20240529150155PLT"
    xmlns:ns1="http://www.tim.com/NOW/wsdl/abstract/ProcessLog"
    xmlns:ns10="http://www.tibco.com/namespaces/tnt/plugins/jdbc+dcf515b7-097a-487f-a85e-98db512a17dd+input"
    xmlns:ns11="http://www.tibco.com/namespaces/tnt/plugins/jdbc"
    xmlns:ns12="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+dcf515b7-097a-487f-a85e-98db512a17dd"
    xmlns:ns13="http://tns.tibco.com/bw/activity/parse/xsd/+4356eadd-8be5-4e74-b899-759a6a686892+input"
    xmlns:ns14="http://tns.tibco.com/bw/activity/parse/xsd/+4356eadd-8be5-4e74-b899-759a6a686892+output"
    xmlns:ns15="http://tns.tibco.com/bw/palette/internal/activityerror+bw.parse.parsedata"
    xmlns:ns16="http://tns.tibco.com/bw/activity/parse/xsd/+bddaf422-3294-4bf4-ae98-f84a20144b4f+input"
    xmlns:ns17="http://tns.tibco.com/bw/activity/parse/xsd/+bddaf422-3294-4bf4-ae98-f84a20144b4f+output"
    xmlns:ns18="http://www.example.org/ContenutoRecdAnagraficaEOLO"
    xmlns:ns19="www.tim.now.migration.OutputContenutoRecd"
    xmlns:ns2="www.tim.now.contarecord_jms.response"
