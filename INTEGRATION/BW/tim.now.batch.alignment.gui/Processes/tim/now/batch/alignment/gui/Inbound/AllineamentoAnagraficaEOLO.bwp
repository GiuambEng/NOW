                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.example.org/ContenutoRecdAnagraficaEOLO&quot; xmlns:tns7=&quot;http://www.example.org/tim.now.AnagraficaEOLO_Tracciato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DetailUltimi_NoVal&quot;/>&lt;xsl:param name=&quot;DetailNoVal&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;ContenutoRecdAnagraficaEOLO-input&quot; match=&quot;/&quot;>&lt;tns6:InputAnagraficaEOLO_ContenutoRecord>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DetailUltimi_NoVal/Rows/tns7:AnagraficaEOLO_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$DetailNoVal/Rows/tns7:AnagraficaEOLO_dettaglio&quot;>&lt;tns6:ContenutoRecordAnagraficaEOLO_input>&lt;xsl:if test=&quot;tns7:DESCR_PROV&quot;>&lt;tns6:DESCR_PROV>&lt;xsl:value-of select=&quot;tns7:DESCR_PROV&quot;/>&lt;/tns6:DESCR_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_ISTAT_PROV&quot;>&lt;tns6:COD_ISTAT_PROV>&lt;xsl:value-of select=&quot;tns7:COD_ISTAT_PROV&quot;/>&lt;/tns6:COD_ISTAT_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_COMUNE&quot;>&lt;tns6:DESCR_COMUNE>&lt;xsl:value-of select=&quot;tns7:DESCR_COMUNE&quot;/>&lt;/tns6:DESCR_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_ISTAT_COMUNE&quot;>&lt;tns6:COD_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns7:COD_ISTAT_COMUNE&quot;/>&lt;/tns6:COD_ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;>&lt;tns6:DESCR_PARTICELLA_TOPON>&lt;xsl:value-of select=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns6:DESCR_PARTICELLA_TOPON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_VIA&quot;>&lt;tns6:DESCR_VIA>&lt;xsl:value-of select=&quot;tns7:DESCR_VIA&quot;/>&lt;/tns6:DESCR_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_STRADA&quot;>&lt;tns6:COD_STRADA>&lt;xsl:value-of select=&quot;tns7:COD_STRADA&quot;/>&lt;/tns6:COD_STRADA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:NUMERO_CIVICO&quot;>&lt;tns6:NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tns7:NUMERO_CIVICO&quot;/>&lt;/tns6:NUMERO_CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_TOPON&quot;>&lt;tns6:COD_TOPON>&lt;xsl:value-of select=&quot;tns7:COD_TOPON&quot;/>&lt;/tns6:COD_TOPON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:CODICE_EGON&quot;>&lt;tns6:CODICE_EGON>&lt;xsl:value-of select=&quot;tns7:CODICE_EGON&quot;/>&lt;/tns6:CODICE_EGON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:Flag_Validita&quot;>&lt;tns6:Flag_Validita>&lt;xsl:value-of select=&quot;tns7:Flag_Validita&quot;/>&lt;/tns6:Flag_Validita>&lt;/xsl:if>&lt;tns6:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;/tns6:NumeroRecord>&lt;/tns6:ContenutoRecordAnagraficaEOLO_input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$DetailUltimi_NoVal/Rows/tns7:AnagraficaEOLO_dettaglio&quot;>&lt;tns6:ContenutoRecordAnagraficaEOLO_input>&lt;xsl:if test=&quot;tns7:DESCR_PROV&quot;>&lt;tns6:DESCR_PROV>&lt;xsl:value-of select=&quot;tns7:DESCR_PROV&quot;/>&lt;/tns6:DESCR_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_ISTAT_PROV&quot;>&lt;tns6:COD_ISTAT_PROV>&lt;xsl:value-of select=&quot;tns7:COD_ISTAT_PROV&quot;/>&lt;/tns6:COD_ISTAT_PROV>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_COMUNE&quot;>&lt;tns6:DESCR_COMUNE>&lt;xsl:value-of select=&quot;tns7:DESCR_COMUNE&quot;/>&lt;/tns6:DESCR_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_ISTAT_COMUNE&quot;>&lt;tns6:COD_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tns7:COD_ISTAT_COMUNE&quot;/>&lt;/tns6:COD_ISTAT_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;>&lt;tns6:DESCR_PARTICELLA_TOPON>&lt;xsl:value-of select=&quot;tns7:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns6:DESCR_PARTICELLA_TOPON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:DESCR_VIA&quot;>&lt;tns6:DESCR_VIA>&lt;xsl:value-of select=&quot;tns7:DESCR_VIA&quot;/>&lt;/tns6:DESCR_VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_STRADA&quot;>&lt;tns6:COD_STRADA>&lt;xsl:value-of select=&quot;tns7:COD_STRADA&quot;/>&lt;/tns6:COD_STRADA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:NUMERO_CIVICO&quot;>&lt;tns6:NUMERO_CIVICO>&lt;xsl:value-of select=&quot;tns7:NUMERO_CIVICO&quot;/>&lt;/tns6:NUMERO_CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:COD_TOPON&quot;>&lt;tns6:COD_TOPON>&lt;xsl:value-of select=&quot;tns7:COD_TOPON&quot;/>&lt;/tns6:COD_TOPON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:CODICE_EGON&quot;>&lt;tns6:CODICE_EGON>&lt;xsl:value-of select=&quot;tns7:CODICE_EGON&quot;/>&lt;/tns6:CODICE_EGON>&lt;/xsl:if>&lt;xsl:if test=&quot;tns7:Flag_Validita&quot;>&lt;tns6:Flag_Validita>&lt;xsl:value-of select=&quot;tns7:Flag_Validita&quot;/>&lt;/tns6:Flag_Validita>&lt;/xsl:if>&lt;tns6:NumeroRecord>&lt;xsl:value-of select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;/tns6:NumeroRecord>&lt;/tns6:ContenutoRecordAnagraficaEOLO_input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns6:InputAnagraficaEOLO_ContenutoRecord>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
