                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.example.org/CreateFileID&quot; xmlns:ns1=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LoggerKOFunct-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns13:Input>&#xa;            &lt;tns13:DataIn>&#xa;                &lt;tns13:Update>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:EsitoConteggio='KO'&quot;>&#xa;                            &lt;tns13:InputFile>&#xa;                                &lt;tns13:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&#xa;                                &lt;/tns13:ID_FILE>&#xa;                                &lt;tns13:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                                &lt;/tns13:STATO_ESEC>&#xa;                                &lt;tns13:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns13:ESITO>&#xa;                                &lt;tns13:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                                &lt;/tns13:DESCR_STATO_FILE>&#xa;                                &lt;tns13:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns13:LOG_MESSAGE>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;>&#xa;                                    &lt;tns13:RECORD_KO>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;/>&#xa;                                    &lt;/tns13:RECORD_KO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;>&#xa;                                    &lt;tns13:RECORD_TOTALI>&#xa;                                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns1:queueResponse/ns1:NumeroRecord&quot;/>&#xa;                                    &lt;/tns13:RECORD_TOTALI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns13:InputFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns13:InputFile>&#xa;                                &lt;tns13:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&#xa;                                &lt;/tns13:ID_FILE>&#xa;                                &lt;tns13:STATO_ESEC>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns13:STATO_ESEC>&#xa;                                &lt;tns13:ESITO>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns13:ESITO>&#xa;                                &lt;tns13:DESCR_STATO_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                                &lt;/tns13:DESCR_STATO_FILE>&#xa;                                &lt;tns13:LOG_MESSAGE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE FILE INPUT ESEGUITA CON SUCCESSO&amp;quot;&quot;/>&#xa;                                &lt;/tns13:LOG_MESSAGE>&#xa;                                &lt;tns13:RECORD_OK>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_OK>&#xa;                                &lt;tns13:RECORD_KO>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_KO>&#xa;                                &lt;tns13:RECORD_TOTALI>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns13:RECORD_TOTALI>&#xa;                            &lt;/tns13:InputFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns13:OutputFile>&#xa;                        &lt;tns13:ID_FILE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JMSReceiveMessage/Body/ns1:queueResponse/ns1:ID_FILE)&quot;/>&#xa;                        &lt;/tns13:ID_FILE>&#xa;                    &lt;/tns13:OutputFile>&#xa;                &lt;/tns13:Update>&#xa;            &lt;/tns13:DataIn>&#xa;            &lt;tns13:LogElement>&#xa;                &lt;tns13:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns13:LoggerName>&#xa;                &lt;tns13:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns13:LogLevel>&#xa;            &lt;/tns13:LogElement>&#xa;        &lt;/tns13:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
