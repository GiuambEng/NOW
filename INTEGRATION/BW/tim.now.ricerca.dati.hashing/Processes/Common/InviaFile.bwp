                <bpws:link name="LoggerToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="SetCommandToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogCommandToCallShell" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallShellToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogShellToJDBCUpdate" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateStatoAllToLogger1" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdLoggerToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="32451dd3-3790-4e9e-a13e-4dac6bf3c58f"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
