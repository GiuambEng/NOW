ATIVO_ASSET&quot;/>&lt;/tns6:ID_ASSET>&lt;/xsl:if>&lt;/tns6:InviaFile_dettaglio>&lt;/tns6:InviaFile>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

