                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.alignment.sharedlibrary.ChisuraAllineamenti.Details&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Logger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:ProcFile>&#xa;                &lt;ns2:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;'319'&quot;/>&#xa;                &lt;/ns2:ID_PROCSO_FILE>&#xa;            &lt;/ns2:ProcFile>&#xa;            &lt;ns2:FileProcessato>&#xa;                &lt;ns2:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/ns2:DATA_FILE>&#xa;                &lt;ns2:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns2:DESCR_STATO_FILE>&#xa;                &lt;ns2:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;470&quot;/>&#xa;                &lt;/ns2:ID_INTRFC>&#xa;                &lt;ns2:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/ns2:IDTPLG_FILE>&#xa;                &lt;ns2:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;concat('ESITO_',$ParseDetails/ns1:InputDetails[ns1:NOME='NameFile']/ns1:VALORE)&quot;/>&#xa;                &lt;/ns2:NOME_FILE>&#xa;                &lt;ns2:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns2:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns2:VERSO_DEL_FILE>&#xa;            &lt;/ns2:FileProcessato>&#xa;            &lt;ns2:EsecuzioneFile>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns2:EsecuzioneFile>&#xa;            &lt;ns2:FileProcessatoOutput>&#xa;                &lt;ns2:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns2:FileProcessatoOutput>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
