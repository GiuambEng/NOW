                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d71e6b16-5842-4f24-9cd1-56fb30140cfa+input&quot; xmlns:tns6=&quot;http://www.example.org/tim.now.RicercaHashing_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UpdStag&quot;/>&lt;xsl:template name=&quot;UpdateStag-input&quot; match=&quot;/&quot;>&lt;tns9:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$UpdStag/tns6:InviaFile_dettaglio&quot;>&lt;Record>&lt;cognomeragionesociale>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns6:COGNOME)&quot;>&lt;xsl:value-of select=&quot;tns6:COGNOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cognomeragionesociale>&lt;nome>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns6:NOME)&quot;>&lt;xsl:value-of select=&quot;tns6:NOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/nome>&lt;partitaiva>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns6:PIVA)&quot;>&lt;xsl:value-of select=&quot;tns6:PIVA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/partitaiva>&lt;codicefiscale>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns6:CF)&quot;>&lt;xsl:value-of select=&quot;tns6:CF&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codicefiscale>&lt;stato_elaborazione_staging>&lt;xsl:value-of select=&quot;xsd:int(tns6:ID_STATO_ELAB_STAG)&quot;/>&lt;/stato_elaborazione_staging>&