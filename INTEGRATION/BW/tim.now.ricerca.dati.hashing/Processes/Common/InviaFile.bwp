                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns12="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Logger"/&gt;
    &lt;xsl:template name="UpdLogger-input" match="/"&gt;
        &lt;tns12:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:FileProcessato&gt;
                        &lt;ns2:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                        &lt;/ns2:DESCR_STATO_FILE&gt;
                        &lt;ns2:ESITO&gt;
                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                        &lt;/ns2:ESITO&gt;
                        &lt;ns2:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns2:ID_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns2:Output/ns2:Esito/ns2:ID_FILE)"/&gt;
                        &lt;/ns2:ID_FILE&gt;
                        &lt;ns2:TIMSTP_CHIUSURA_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;ns2:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;
                        &lt;/ns2:VERSO_DEL_FILE&gt;
                    &lt;/ns2:FileProcessato&gt;
                    &lt;ns2:EsecuzioneFile&gt;
                        &lt;ns2:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns2:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                        &lt;/ns2:STATO_ESEC&gt;
                        &lt;ns2:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TMSP_FINE_ELAB&gt;
                    &lt;/ns2:EsecuzioneFile&gt;
                    &lt;ns2:FileProcessatoOutput&gt;
                        &lt;ns2:ID_FILE_PROCSTO_OUTPUT&gt;
                            &lt;xsl:value-of select="xsd:integer($Logger/part1/ns2:Output/ns2:Esito/ns2:ID_FILE)"/&gt;
                        &lt;/ns2:ID_FILE_PROCSTO_OUTPUT&gt;
                    &lt;/ns2:FileProcessatoOutput&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns12:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:FileProcessato>&#xa;                &lt;ns2:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns2:DESCR_STATO_FILE>&#xa;                &lt;ns2:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns2:ESITO>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns2:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns2:Esito/ns2:ID_FILE)&quot;/>&#xa;                &lt;/ns2:ID_FILE>&#xa;                &lt;ns2:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns2:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns2:VERSO_DEL_FILE>&#xa;            &lt;/ns2:FileProcessato>&#xa;            &lt;ns2:EsecuzioneFile>&#xa;                &lt;ns2:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_FINE_ELAB>&#xa;            &lt;/ns2:EsecuzioneFile>&#xa;            &lt;ns2:FileProcessatoOutput>&#xa;                &lt;ns2:ID_FILE_PROCSTO_OUTPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Logger.part1/ns2:Esito/ns2:ID_FILE)&quot;/>&#xa;                &lt;/ns2:ID_FILE_PROCSTO_OUTPUT>&#xa;            &lt;/ns2:FileProcessatoOutput>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
