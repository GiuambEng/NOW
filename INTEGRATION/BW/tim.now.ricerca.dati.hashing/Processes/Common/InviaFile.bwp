                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_CF"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="CODICEFISCALE"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
