                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICEFISCALE FROM ANALITICO_RICERCA_CF&#xa;WHERE ID_FILE_PROCES_INPUT=? and ID_CF=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
