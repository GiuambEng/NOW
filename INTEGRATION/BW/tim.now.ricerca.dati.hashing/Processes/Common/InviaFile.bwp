                                    partnerLink="NOW_SECOLOPortType"
                                    portType="ns12:NOW_SECOLOPortType" tibex:xpdlId="bfceef8b-e60f-4625-b3d8-373692127762">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/NOW_SECOLO/" xmlns:tns8="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:tns7="http://www.example.com/namespaces/tns/1564740682912" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="GetLocalIP"/&gt;&lt;xsl:param name="currentElement"/&gt;&lt;xsl:template name="Decode-input" match="/"&gt;&lt;ns:Decode_token_NOWSecoloRequest&gt;&lt;Input&gt;&lt;tns8:RequestDecode_token&gt;&lt;tns8:CodiceOrdineOLO&gt;&lt;xsl:value-of select="'XXX'"/&gt;&lt;/tns8:CodiceOrdineOLO&gt;&lt;tns8:Funzione&gt;&lt;xsl:value-of select="'TOOL'"/&gt;&lt;/tns8:Funzione&gt;&lt;tns8:ChiaveRiferimento&gt;&lt;xsl:value-of select="concat('XXX','&amp;amp;' ,string(tib:timestamp()))"/&gt;&lt;/tns8:ChiaveRiferimento&gt;&lt;tns8:Operatore&gt;&lt;xsl:value-of select="'NOW'"/&gt;&lt;/tns8:Operatore&gt;&lt;xsl:if test="$GetLocalIP/tns7:IPAddress"&gt;&lt;tns8:IPClient&gt;&lt;xsl:value-of select="$GetLocalIP/tns7:IPAddress"/&gt;&lt;/tns8:IPClient&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$currentElement/COGNOMERAGIONESOCIALE"&gt;&lt;tns8:Token&gt;&lt;xsl:value-of select="$currentElement/COGNOMERAGIONESOCIALE"/&gt;&lt;/tns8:Token&gt;&lt;/xsl:if&gt;&lt;/tns8:RequestDecode_token&gt;&lt;/Input&gt;&lt;/ns:Decode_token_NOWSecoloRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/NOW_SECOLO/&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns7=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Decode-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:RequestDecode_token>&#xa;            &lt;tns8:CodiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;'XXX'&quot;/>&#xa;            &lt;/tns8:CodiceOrdineOLO>&#xa;            &lt;tns8:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'TOOL'&quot;/>&#xa;            &lt;/tns8:Funzione>&#xa;            &lt;tns8:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat('XXX','&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns8:ChiaveRiferimento>&#xa;            &lt;tns8:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/tns8:Operatore>&#xa;            &lt;xsl:if test=&quot;$GetLocalIP/tns7:IPAddress&quot;>&#xa;                &lt;tns8:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$GetLocalIP/tns7:IPAddress&quot;/>&#xa;                &lt;/tns8:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$currentElement/COGNOMERAGIONESOCIALE&quot;>&#xa;                &lt;tns8:Token>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/COGNOMERAGIONESOCIALE&quot;/>&#xa;                &lt;/tns8:Token>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns8:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
