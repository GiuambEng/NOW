t;/ns1:FILENAME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ProcessLoggerTrack/tns3:ID_ESEC&quot;>&#xa;                &lt;ns1:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ProcessLoggerTrack/tns3:ID_ESEC&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ProcessLoggerTrack/tns3:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns1:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ProcessLoggerTrack/tns3:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns1:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;>&#xa;                &lt;ns1:ID_TRACK>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns:ID_TRACK&quot;/>&#xa;                &lt;/ns1:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns1:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;'ricerca.dati.hashing'&quot;/>&#xa;            &lt;/ns1:NomeProcesso>&#xa;        &lt;/ns1:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
