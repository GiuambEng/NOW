                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.example.org/tim.now.RicercaHashing_Staging&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;InputStag&quot;/>&lt;xsl:param name=&quot;StatoAll&quot;/>&lt;xsl:param name=&quot;ClienteHash&quot;/>&lt;xsl:template name=&quot;InputStag&quot; match=&quot;/&quot;>&lt;tns5:RicercaHashingFase2>&lt;xsl:copy-of select=&quot;$InputStag/tns5:RicercaHashingFase2_dettaglio&quot;/>&lt;tns5:RicercaHashingFase2_dettaglio>&lt;tns5:CF>&lt;xsl:value-of select=&quot;$currentElement/CODICEFISCALE&quot;/>&lt;/tns5:CF>&lt;xsl:if test=&quot;$StatoAll/Record[1]/ID_FILE&quot;>&lt;tns5:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$StatoAll/Record[1]/ID_FILE&quot;/>&lt;/tns5:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns5:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/tns5:ID_STATO_ELAB_STAG>&lt;tns5:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns5:TMSP_INSMTO>&lt;tns5:ID_CF>&lt;xsl:value-of select=&quot;$currentElement/ID_CF&quot;/>&lt;/tns5:ID_CF>&lt;xsl:choose>&lt;xsl:when test=&quot;count($ClienteHash/Record)=0&quot;>&lt;tns5:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'KO RICERCA CLIENTE HASH'&quot;/>&lt;/tns5:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:DESCR_ERRORE>&lt;xsl:value-of select=&quot;'KO SECOLO PER HASHING'&quot;/>&lt;/tns5:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns5:RicercaHashingFase2_dettaglio>&lt;/tns5:RicercaHashingFase2>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

