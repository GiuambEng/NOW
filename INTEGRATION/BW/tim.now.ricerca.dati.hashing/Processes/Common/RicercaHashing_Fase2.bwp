                                    <tibex:inputBindings>

                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:ns1=&quot;http://www.tibco.com/NOW_SECOLO_HASH/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_HASH/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;Hash-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:RequestGet_Multiple_Hash_Secolo>&#xa;            &lt;tns4:CodiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;'XXX'&quot;/>&#xa;            &lt;/tns4:CodiceOrdineOLO>&#xa;            &lt;tns4:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'TOOL'&quot;/>&#xa;            &lt;/tns4:Funzione>&#xa;            &lt;tns4:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat('XXX','&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns4:ChiaveRiferimento>&#xa;            &lt;tns4:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;            &lt;/tns4:Operatore>&#xa;            &lt;xsl:if test=&quot;$GetLocalIP/tns3:IPAddress&quot;>&#xa;                &lt;tns4:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$GetLocalIP/tns3:IPAddress&quot;/>&#xa;                &lt;/tns4:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:HashIN>&#xa;                &lt;tns4:key>&#xa;                    &lt;xsl:value-of select=&quot;'CF'&quot;/>&#xa;                &lt;/tns4:key>&#xa;                &lt;tns4:value>&#xa;                    &lt;xsl:value-of select=&quot;$currentElement/CODICEFISCALE&quot;/>&#xa;                &lt;/tns4:value>&#xa;            &lt;/tns4:HashIN>&#xa;        &lt;/tns4:RequestGet_Multiple_Hash_Secolo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
