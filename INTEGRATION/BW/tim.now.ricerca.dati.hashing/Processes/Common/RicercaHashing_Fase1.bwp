            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOutput-input"
                    name="LogOutput"
                    tibex:xpdlId="027b4548-302a-4c99-ae1c-df364702b5e6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOutputToLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOutputToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOutputToGenericLogger">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='KO' or($JMSReceiveMessage/Body/ns3:queueResponse/ns3:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns3:queueResponse/ns3:NumeroRecord=0)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;LogOutput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'RicercaHashing_Fase1'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($JMSReceiveMessage/Body/ns:queueResponse, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Logger-input" name="Logger"
                operation="Insert" outputVariable="Logger"
                partnerLink="Logger" portType="ns1:ProcessLog" tibex:xpdlId="80a2a77c-23d8-43aa-a633-15b441a3968d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns13="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns3="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="www.tim.now.contarecord_jms.response" version="2.0"&gt;
    &lt;xsl:param name="JMSReceiveMessage"/&gt;
    &lt;xsl:template name="Logger-input" match="/"&gt;
        &lt;tns13:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns3:Input&gt;
                    &lt;ns3:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="'FILE'"/&gt;
                    &lt;/ns3:TipologiaProcesso&gt;
                    &lt;ns3:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="'COUNTER'"/&gt;
                    &lt;/ns3:TipologiaOperazione&gt;
                    &lt;ns3:FileProcessatoInput&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"&gt;
                            &lt;ns3:ID_FILE_PROCSTO_INPUT&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE"/&gt;
                            &lt;/ns3:ID_FILE_PROCSTO_INPUT&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"&gt;
                            &lt;ns3:QT_RECD_TOTALI&gt;
                                &lt;xsl:value-of select="$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord"/&gt;
                            &lt;/ns3:QT_RECD_TOTALI&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns3:FileProcessatoInput&gt;
                &lt;/ns3:Input&gt;
            &lt;/part1&gt;
        &lt;/tns13:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns13=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns3=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:template name=&quot;Logger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;            &lt;/ns3:TipologiaProcesso>&#xa;            &lt;ns3:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'COUNTER'&quot;/>&#xa;            &lt;/ns3:TipologiaOperazione>&#xa;            &lt;ns3:FileProcessatoInput>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&#xa;                    &lt;ns3:ID_FILE_PROCSTO_INPUT>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns3:ID_FILE_PROCSTO_INPUT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;>&#xa;                    &lt;ns3:QT_RECD_TOTALI>&#xa;                        &lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:NumeroRecord&quot;/>&#xa;                    &lt;/ns3:QT_RECD_TOTALI>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns3:FileProcessatoInput>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOutputToLogger"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LoggerToWhile"/>
                </bpws:sources>
            </bpws:invoke>
