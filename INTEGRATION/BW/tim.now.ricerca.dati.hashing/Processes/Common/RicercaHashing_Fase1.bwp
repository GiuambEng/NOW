                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.example.org/tim.now.RicercaHashing_Staging&quot; xmlns:tns8=&quot;http://www.example.org/tim.now.RicercaHashing_Tracciato&quot; xmlns:ns=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UltimiDetail&quot;/>&lt;xsl:param name=&quot;Detail&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;InputStag&quot; match=&quot;/&quot;>&lt;tns7:RicercaHashing>&lt;xsl:choose>&lt;xsl:when test=&quot;count($UltimiDetail/Rows/tns8:RicercaHashing_dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Detail/Rows/tns8:RicercaHashing_dettaglio&quot;>&lt;tns7:RicercaHashing_dettaglio>&lt;xsl:if test=&quot;tns8:CF&quot;>&lt;tns7:CF>&lt;xsl:value-of select=&quot;tns8:CF&quot;/>&lt;/tns7:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns7:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns7:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns7:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns7:ID_STATO_ELAB_STAG>&lt;tns7:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns7:TMSP_INSMTO>&lt;/tns7:RicercaHashing_dettaglio>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$UltimiDetail/Rows/tns8:RicercaHashing_dettaglio&quot;>&lt;tns7:RicercaHashing_dettaglio>&lt;xsl:if test=&quot;tns8:CF&quot;>&lt;tns7:CF>&lt;xsl:value-of select=&quot;tns8:CF&quot;/>&lt;/tns7:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;>&lt;tns7:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns:queueResponse/ns:ID_FILE&quot;/>&lt;/tns7:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns