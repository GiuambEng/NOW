    xmlns:ns6="http://tns.tibco.com/bw/palette/internal/activityerror+80a2a77c-23d8-43aa-a633-15b441a3968d"
    xmlns:ns7="http://www.example.org/ManageMoveFile"
    xmlns:ns8="http://www.example.org/InputTrackFile"
    xmlns:ns9="http://www.example.org/CreateFileID"
