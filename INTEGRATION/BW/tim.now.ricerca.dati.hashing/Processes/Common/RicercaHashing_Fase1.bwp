                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE, CREATED)&#xa;  VALUES (?, ?, ?, ?, ?, 'Y', ?, ?, SYSDATE)" xsi:type="jdbcPalette:JDBCUpdateActivity">
