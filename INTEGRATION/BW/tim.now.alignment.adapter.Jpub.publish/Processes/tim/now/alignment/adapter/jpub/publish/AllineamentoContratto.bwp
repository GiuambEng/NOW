                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns3=&quot;www.telecom.Now.outputtriggerContratto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;Ins_ProcID&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Err_Staging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;ns:ID_TIPOLG_MESSG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ns:ID_TIPOLG_MESSG>&lt;ns:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/ns:ID_TRANSAZIONE>&lt;/ns:UpdateOnError>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
