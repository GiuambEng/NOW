                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interprocess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Update>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/ns1:root[number($Counter)][ns1:Contratto/ns1:Status='OK']&quot;>&#xa;                        &lt;ns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'ContrattoInseritoSuCoda'&quot;/>&#xa;                        &lt;/ns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'ContrattoNonValido'&quot;/>&#xa;                        &lt;/ns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/ns1:root[number($Counter)][ns1:Contratto/ns1:Status='OK']&quot;>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_RICH_JPUB_RICH>&#xa;                &lt;ns:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/ns:ID_TIPOLG_MESSG>&#xa;                &lt;xsl:if test=&quot;$Accumulate/ns1:root[number($Counter)]/ns1:Contratto/ns1:IDTransizione&quot;>&#xa;                    &lt;ns:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/ns1:root[number($Counter)]/ns1:Contratto/ns1:IDTransizione&quot;/>&#xa;                    &lt;/ns:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Update>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.alignment.adapter.jpub.publish.subStaging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Counter"
                                    name="Counter_1"
                                    outputVariable="Counter"
                                    tibex:xpdlId="e4c16e75-8e73-45cc-ac81-40292f5ca71a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Up_StagingToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Counter_1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$Counter+1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Counter" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Counter"
                    name="AzzCounter" outputVariable="Counter"
                    tibex:xpdlId="87a3a61f-74bd-445a-929f-a39dfacf3943" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateP_ContrattoToWhile1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AzzCounterToWhile1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Counter" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Select_P_Contratto-input"
                    name="Select_P_Contratto"
                    outputVariable="Select_P_Contratto"
                    tibex:xpdlId="4c0d84a9-a476-4aad-ab8d-2602d9091b21" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Start_LogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Select_P_Contratto_1ToNoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Select_P_Contratto_1ToP_Contratto">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Select_P_Contratto/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Select_P_Contratto/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c0d84a9-a476-4aad-ab8d-2602d9091b21+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_CONTRATTO,ID_CONTRATTO,ID_COD_CONTRATTO_PADRE, COD_OFFERTA_JPUB, CODFC_OLO_AGCOM, IDTPLG_CONTRATTO,&#xa;  DATAFI_VALID, DATAINZ_VALID, ADB_TRACKING_ID,ADB_OPERAZIONE,NOME_CONTRATTO, DATA_INIZIO_COINV_RETE&#xa;  FROM P_CONTRATTO &#xa;  WHERE ADB_DELIVERYSTATUS = 'I'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="COD_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_OFFERTA_JPUB"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDTPLG_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ADB_TRACKING_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ADB_OPERAZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_CONTRATTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_COINV_RETE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
