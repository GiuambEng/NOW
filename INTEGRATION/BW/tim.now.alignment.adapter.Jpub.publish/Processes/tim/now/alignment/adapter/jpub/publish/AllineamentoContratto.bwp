                                name="ErrorLog"
                                tibex:xpdlId="caea4576-4ce9-49ec-b1a9-b91908385dca"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="ErrorLogToError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;ErrorLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoContratto'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'AllineamentoContratto'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'AllineamentoContratto'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Fault AllineamentoContratto',tib:render-xml($FaultDetails,true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GenericLoggerErr"
                            portType="ns12:GenericError" tibex:xpdlId="11a98b66-ceb3-4a7f-a710-89137c1f1879">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="Ins_ProcID"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'TRIGGER_ALLINEAMENTO_CONTRATTO'"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'TRIGGER_ALLINEAMENTO_CONTRATTO'&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Ins_ProcID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Ins_ProcID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Ins_ProcID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorLogToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToExit1"/>
                                <bpws:source linkName="ErrorToFault"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="Fault-input" name="Fault"
                                tibex:xpdlId="5dc23af7-1580-4751-969a-1e9525de2719"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorToFault"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToExit1"/>
                                </bpws:sources>
