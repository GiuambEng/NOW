                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.telecom.Now.outputtriggerContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:template name=&quot;Validate-input&quot; match=&quot;/&quot;>&lt;ns1:CONTRATTI>&lt;CODE_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:COD_CONTRATTO&quot;/>&lt;/CODE_CONTR>&lt;CODE_TIPO_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:COD_OFFERTA_JPUB&quot;/>&lt;/CODE_TIPO_CONTR>&lt;CODE_GEST>&lt;xsl:value-of select=&quot;$Request/ns2:COD_OLO_AGCOM&quot;/>&lt;/CODE_GEST>&lt;DESC_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:NOME_CONTRATTO&quot;/>&lt;/DESC_CONTR>&lt;DATA_SCAD_CONTR>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/DATA_SCAD_CONTR>&lt;DATA_STIP_CONTR>&lt;xsl:value-of select=&quot;xsd:dateTime($Request/ns2:DATAIN_VALID)&quot;/>&lt;/DATA_STIP_CONTR>&lt;DATA_INIZIO_VALID>&lt;xsl:value-of select=&quot;xsd:dateTime($Request/ns2:DATAIN_VALID)&quot;/>&lt;/DATA_INIZIO_VALID>&lt;DATA_FINE_VALID>&lt;xsl:value-of select=&quot;$Request/ns2:DATAFI_VALID&quot;/>&lt;/DATA_FINE_VALID>&lt;xsl:if test=&quot;$Request/ns2:ADB_TRACKING_ID&quot;>&lt;ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;$Request/ns2:ADB_TRACKING_ID&quot;/>&lt;/ADB_TRACKING_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:TRANSACTION_ID&quot;>&lt;TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Request/ns2:TRANSACTION_ID&quot;/>&lt;/TRANSACTION_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:CORRELATION_ID&quot;>&lt;CORRELATION_ID>&lt;xsl:value-of select=&quot;$Request/ns2:CORRELATION_ID&quot;/>&lt;/CORRELATION_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:ADB_OPERAZIONE&quot;>&lt;ADB_OPERAZIONE>&lt;xsl:value-of select=&quot;$Request/ns2:ADB_