                                    <bpws:sources>
                                    <bpws:source linkName="CurrentToJDBCQuery"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.telecom.Now.outputtriggerContratto&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_P_Contratto&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;Contract&quot;/>&#xa;    &lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:TriggerContratto>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Select_P_Contratto/Record[number($Counter)]/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&#xa;                            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;>&#xa;                                &lt;ns2:COD_CONTRATTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;/>&#xa;                                &lt;/ns2:COD_CONTRATTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;>&#xa;                                &lt;ns2:COD_CONTRATTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&#xa;                                &lt;/ns2:COD_CONTRATTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;>&#xa;                        &lt;ns2:COD_CONTRATTO>&#xa;                            &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;/>&#xa;                        &lt;/ns2:COD_CONTRATTO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_OFFERTA_JPUB&quot;>&#xa;                &lt;ns2:COD_OFFERTA_JPUB>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_OFFERTA_JPUB&quot;/>&#xa;                &lt;/ns2:COD_OFFERTA_JPUB>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;>&#xa;                &lt;ns2:COD_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/ns2:COD_OLO_AGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/IDTPLG_CONTRATTO&quot;>&#xa;                &lt;ns2:DESCRIZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/IDTPLG_CONTRATTO&quot;/>&#xa;                &lt;/ns2:DESCRIZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAFI_VALID&quot;>&#xa;                &lt;ns2:DATAFI_VALID>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAFI_VALID&quot;/>&#xa;                &lt;/ns2:DATAFI_VALID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAINZ_VALID&quot;>&#xa;                &lt;ns2:DATAIN_VALID>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAINZ_VALID&quot;/>&#xa;                &lt;/ns2:DATAIN_VALID>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:ADB_TRACKING_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Select_P_Contratto/Record[number($Counter)]/ADB_TRACKING_ID)&quot;/>&#xa;            &lt;/ns2:ADB_TRACKING_ID>&#xa;            &lt;ns2:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;            &lt;/ns2:TRANSACTION_ID>&#xa;            &lt;xsl:if test=&quot;$Ins_ProcID.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                &lt;ns2:CORRELATION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Ins_ProcID.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                &lt;/ns2:CORRELATION_ID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/ADB_OPERAZIONE&quot;>&#xa;                &lt;ns2:ADB_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/ADB_OPERAZIONE&quot;/>&#xa;                &lt;/ns2:ADB_OPERAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATA_INIZIO_COINV_RETE&quot;>&#xa;                &lt;ns2:DATA_COINV>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATA_INIZIO_COINV_RETE&quot;/>&#xa;                &lt;/ns2:DATA_COINV>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/NOME_CONTRATTO&quot;>&#xa;                &lt;ns2:NOME_CONTRATTO>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/NOME_CONTRATTO&quot;/>&#xa;                &lt;/ns2:NOME_CONTRATTO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns2:TriggerContratto>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
