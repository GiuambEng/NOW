            <bpws:invoke inputVariable="JMS-input" name="JMS"
                operation="SendVariazione"
                partnerLink="AllineamentoContratto"
                portType="ns5:AllineamentoContratto" tibex:xpdlId="07dab782-be07-4102-bb70-fb70a0745ebe">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns1="http://www.tim.now/wsdl/abstract/allineamentoContrattoJpub" xmlns:tns="http://tim.now.alignement.Jpub.adapter.Contratto" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://tim.now.alignement.Jpub.adapter.Contratto.interprocess" version="2.0"&gt;&lt;xsl:param name="Accumulate"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:template name="JMS-input" match="/"&gt;&lt;ns1:AllineamentoContrattoRequest&gt;&lt;part1&gt;&lt;tns:root&gt;&lt;xsl:for-each select="$Accumulate/ns:root[ns:Contratto/ns:Status='OK']"&gt;&lt;tns:Contratto&gt;&lt;xsl:if test="ns:Contratto/ns:CODE_CONTR"&gt;&lt;tns:CODE_CONTR&gt;&lt;xsl:value-of select="ns:Contratto/ns:CODE_CONTR"/&gt;&lt;/tns:CODE_CONTR&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:CODE_TIPO_CONTR"&gt;&lt;tns:CODE_TIPO_CONTR&gt;&lt;xsl:value-of select="ns:Contratto/ns:CODE_TIPO_CONTR"/&gt;&lt;/tns:CODE_TIPO_CONTR&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:CODE_GEST"&gt;&lt;tns:CODE_GEST&gt;&lt;xsl:value-of select="ns:Contratto/ns:CODE_GEST"/&gt;&lt;/tns:CODE_GEST&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:DESC_CONTR"&gt;&lt;tns:DESC_CONTR&gt;&lt;xsl:value-of select="ns:Contratto/ns:DESC_CONTR"/&gt;&lt;/tns:DESC_CONTR&gt;&lt;/xsl:if&gt;&lt;tns:DATA_SCAD_CONTR&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns:DATA_SCAD_CONTR&gt;&lt;xsl:if test="ns:Contratto/ns:DATA_STIP_CONTR"&gt;&lt;tns:DATA_STIP_CONTR&gt;&lt;xsl:value-of select="ns:Contratto/ns:DATA_STIP_CONTR"/&gt;&lt;/tns:DATA_STIP_CONTR&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:DATA_INIZIO_VALID"&gt;&lt;tns:DATA_INIZIO_VALID&gt;&lt;xsl:value-of select="ns:Contratto/ns:DATA_INIZIO_VALID"/&gt;&lt;/tns:DATA_INIZIO_VALID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:DATA_FINE_VALID"&gt;&lt;tns:DATA_FINE_VALID&gt;&lt;xsl:value-of select="ns:Contratto/ns:DATA_FINE_VALID"/&gt;&lt;/tns:DATA_FINE_VALID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:DATA_COINV"&gt;&lt;tns:DATA_COINV&gt;&lt;xsl:value-of select="ns:Contratto/ns:DATA_COINV"/&gt;&lt;/tns:DATA_COINV&gt;&lt;/xsl:if&gt;&lt;tns:ADB_TRACKING_ID&gt;&lt;xsl:value-of select="xsd:int(ns:Contratto/ns:ADB_TRACKING_ID)"/&gt;&lt;/tns:ADB_TRACKING_ID&gt;&lt;tns:TransactionID&gt;&lt;xsl:value-of select="xsd:integer(ns:Contratto/ns:TransactionID)"/&gt;&lt;/tns:TransactionID&gt;&lt;tns:CorrelationID&gt;&lt;xsl:value-of select="xsd:integer(ns:Contratto/ns:CorrelationID)"/&gt;&lt;/tns:CorrelationID&gt;&lt;xsl:if test="ns:Contratto/ns:ADB_OPERAZIONE"&gt;&lt;tns:ADB_OPERAZIONE&gt;&lt;xsl:value-of select="ns:Contratto/ns:ADB_OPERAZIONE"/&gt;&lt;/tns:ADB_OPERAZIONE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:Contratto/ns:IDTransizione"&gt;&lt;tns:ID_TRANSAZIONE&gt;&lt;xsl:value-of select="ns:Contratto/ns:IDTransizione"/&gt;&lt;/tns:ID_TRANSAZIONE&gt;&lt;/xsl:if&gt;&lt;/tns:Contratto&gt;&lt;/xsl:for-each&gt;&lt;tns:ProcessID&gt;&lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;&lt;/tns:ProcessID&gt;&lt;/tns:root&gt;&lt;/part1&gt;&lt;/ns1:AllineamentoContrattoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tim.now/wsdl/abstract/allineamentoContrattoJpub&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interprocess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;JMS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:root>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/ns:root[ns:Contratto/ns:Status='OK']&quot;>&#xa;                &lt;tns:Contratto>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:CODE_CONTR&quot;>&#xa;                        &lt;tns:CODE_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:CODE_CONTR&quot;/>&#xa;                        &lt;/tns:CODE_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:CODE_TIPO_CONTR&quot;>&#xa;                        &lt;tns:CODE_TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:CODE_TIPO_CONTR&quot;/>&#xa;                        &lt;/tns:CODE_TIPO_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:CODE_GEST&quot;>&#xa;                        &lt;tns:CODE_GEST>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:CODE_GEST&quot;/>&#xa;                        &lt;/tns:CODE_GEST>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:DESC_CONTR&quot;>&#xa;                        &lt;tns:DESC_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:DESC_CONTR&quot;/>&#xa;                        &lt;/tns:DESC_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:DATA_SCAD_CONTR>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/tns:DATA_SCAD_CONTR>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:DATA_STIP_CONTR&quot;>&#xa;                        &lt;tns:DATA_STIP_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:DATA_STIP_CONTR&quot;/>&#xa;                        &lt;/tns:DATA_STIP_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:DATA_INIZIO_VALID&quot;>&#xa;                        &lt;tns:DATA_INIZIO_VALID>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:DATA_INIZIO_VALID&quot;/>&#xa;                        &lt;/tns:DATA_INIZIO_VALID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:DATA_FINE_VALID&quot;>&#xa;                        &lt;tns:DATA_FINE_VALID>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:DATA_FINE_VALID&quot;/>&#xa;                        &lt;/tns:DATA_FINE_VALID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:DATA_COINV&quot;>&#xa;                        &lt;tns:DATA_COINV>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:DATA_COINV&quot;/>&#xa;                        &lt;/tns:DATA_COINV>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:ADB_TRACKING_ID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(ns:Contratto/ns:ADB_TRACKING_ID)&quot;/>&#xa;                    &lt;/tns:ADB_TRACKING_ID>&#xa;                    &lt;tns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(ns:Contratto/ns:TransactionID)&quot;/>&#xa;                    &lt;/tns:TransactionID>&#xa;                    &lt;tns:CorrelationID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(ns:Contratto/ns:CorrelationID)&quot;/>&#xa;                    &lt;/tns:CorrelationID>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:ADB_OPERAZIONE&quot;>&#xa;                        &lt;tns:ADB_OPERAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:ADB_OPERAZIONE&quot;/>&#xa;                        &lt;/tns:ADB_OPERAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ns:Contratto/ns:IDTransizione&quot;>&#xa;                        &lt;tns:ID_TRANSAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;ns:Contratto/ns:IDTransizione&quot;/>&#xa;                        &lt;/tns:ID_TRANSAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Contratto>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns:ProcessID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessID>&#xa;        &lt;/tns:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogRequestToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToUpdateP_Contratto"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="51671ba2-e9b3-40f4-b4fd-95fa03ff1afc">
                <bpws:targets>
                    <bpws:target linkName="Ins_ProcIDToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogRequest"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+2d98be25-767d-401c-aaa1-a941cbcb2fc9" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter &lt;= count($Select_P_Contratto/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter <= count($Select_P_Contratto/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="ValidateToInput" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CurrentToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToCheck_Error" tibex:linkType="ERROR"/>
                                <bpws:link name="Ins_StagingToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToCounter" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Check_ErrorToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Ins_StagingToErr_Staging" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Mapper1ToIns_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToInput" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToCurrent" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToContract" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="EmptyToCurrent" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="SetCheckToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToValidate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="36684334-9f27-4460-a544-e60144d3b9fe">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="2d98be25-767d-401c-aaa1-a941cbcb2fc9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetCheckToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
