                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;www.telecom.Now.outputtriggerContratto&quot; xmlns:ns=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interprocess&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;CheckError&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Input-input&quot; match=&quot;/&quot;>&lt;ns:root>&lt;ns:Contratto>&lt;xsl:if test=&quot;$Request/ns2:COD_CONTRATTO&quot;>&lt;ns:CODE_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:COD_CONTRATTO&quot;/>&lt;/ns:CODE_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:COD_OFFERTA_JPUB&quot;>&lt;ns:CODE_TIPO_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:COD_OFFERTA_JPUB&quot;/>&lt;/ns:CODE_TIPO_CONTR>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:COD_OLO_AGCOM&quot;>&lt;ns:CODE_GEST>&lt;xsl:value-of select=&quot;$Request/ns2:COD_OLO_AGCOM&quot;/>&lt;/ns:CODE_GEST>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:NOME_CONTRATTO&quot;>&lt;ns:DESC_CONTR>&lt;xsl:value-of select=&quot;$Request/ns2:NOME_CONTRATTO&quot;/>&lt;/ns:DESC_CONTR>&lt;/xsl:if>&lt;ns:DATA_SCAD_CONTR>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:DATA_SCAD_CONTR>&lt;ns:DATA_STIP_CONTR>&lt;xsl:value-of select=&quot;xsd:dateTime($Request/ns2:DATAIN_VALID)&quot;/>&lt;/ns:DATA_STIP_CONTR>&lt;ns:DATA_INIZIO_VALID>&lt;xsl:value-of select=&quot;xsd:dateTime($Request/ns2:DATAIN_VALID)&quot;/>&lt;/ns:DATA_INIZIO_VALID>&lt;xsl:if test=&quot;$Request/ns2:DATAFI_VALID&quot;>&lt;ns:DATA_FINE_VALID>&lt;xsl:value-of select=&quot;$Request/ns2:DATAFI_VALID&quot;/>&lt;/ns:DATA_FINE_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:DATA_COINV&quot;>&lt;ns:DATA_COINV>&lt;xsl:value-of select=&quot;$Request/ns2:DATA_COINV&quot;/>&lt;/ns:DATA_COINV>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:ADB_TRACKING_ID&quot;>&lt;ns:ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;$Request/ns2:ADB_TRACKING_ID&quot;/>&lt;/ns:ADB_TRACKING_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:TRANSACTION_ID&quot;>&lt;ns:TransactionID>&lt;xsl:value-of select=&quot;$Request/ns2:TRANSACTION_ID&quot;/>&lt;/ns:TransactionID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:CORRELATION_ID&quot;>&lt;ns:CorrelationID>&lt;xsl:value-of select=&quot;$Request/ns2:CORRELATION_ID&quot;/>&lt;/ns:CorrelationID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns2:ADB_OPERAZIONE&quot;>&lt;ns:ADB_OPERAZIONE>&lt;xsl:value-of select=&quot;$Request/ns2:ADB_OPERAZIONE&quot;/>&lt;/ns:ADB_OPERAZIONE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckError='ERRORE'&quot;>&lt;ns:Status>&lt;xsl:value-of select=&quot;'ERRORE'&quot;/>&lt;/ns:Status>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:Status>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:Status>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:IDTransizione>&lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/ns:IDTransizione>&lt;/ns:Contratto>&lt;/ns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
