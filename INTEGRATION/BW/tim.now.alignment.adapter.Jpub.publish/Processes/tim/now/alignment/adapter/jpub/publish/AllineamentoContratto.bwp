                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Ins_ProcID&quot;/>&lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&lt;xsl:param name=&quot;CheckError&quot;/>&lt;xsl:param name=&quot;Input&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&lt;ns1:Input>&lt;ns1:Insert>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckError='ERRORE'&quot;>&lt;ns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($Request)&quot;/>&lt;/ns1:CONTENUTO_REQUEST>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;concat('****Input Trigger: ',tib:render-xml($Request),'****Mapping eseguito****',tib:render-xml($Input))&quot;/>&lt;/ns1:CONTENUTO_REQUEST>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&lt;ns1:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns1:ID_RICH_JPUB_RICH>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckError='ERRORE'&quot;>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ElabStag