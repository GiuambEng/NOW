                                    expression="exists($Accumulate/ns14:root[ns14:Contratto/ns14:Status='OK'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
