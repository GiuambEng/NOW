                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns2=&quot;www.telecom.Now.outputtriggerContratto&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_P_Contratto&quot;/>&lt;xsl:param name=&quot;Ins_ProcID&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;Contract&quot;/>&lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&lt;ns2:TriggerContratto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Select_P_Contratto/Record[number($Counter)]/ID_COD_CONTRATTO_PADRE) and count($Contract/Record)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Contract/Record[1]/CODFC_OLO_AGCOM='TLC'&quot;>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;>&lt;ns2:COD_CONTRATTO>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;/>&lt;/ns2:COD_CONTRATTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;>&lt;ns2:COD_CONTRATTO>&lt;xsl:value-of select=&quot;$Contract/Record[1]/COD_CONTRATTO&quot;/>&lt;/ns2:COD_CONTRATTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;>&lt;ns2:COD_CONTRATTO>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_CONTRATTO&quot;/>&lt;/ns2:COD_CONTRATTO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_OFFERTA_JPUB&quot;>&lt;ns2:COD_OFFERTA_JPUB>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/COD_OFFERTA_JPUB&quot;/>&lt;/ns2:COD_OFFERTA_JPUB>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;>&lt;ns2:COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;/>&lt;/ns2:COD_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/IDTPLG_CONTRATTO&quot;>&lt;ns2:DESCRIZIONE>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/IDTPLG_CONTRATTO&quot;/>&lt;/ns2:DESCRIZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAFI_VALID&quot;>&lt;ns2:DATAFI_VALID>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAFI_VALID&quot;/>&lt;/ns2:DATAFI_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAINZ_VALID&quot;>&lt;ns2:DATAIN_VALID>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATAINZ_VALID&quot;/>&lt;/ns2:DATAIN_VALID>&lt;/xsl:if>&lt;ns2:ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;xsd:int($Select_P_Contratto/Record[number($Counter)]/ADB_TRACKING_ID)&quot;/>&lt;/ns2:ADB_TRACKING_ID>&lt;ns2:TRANSACTION_ID>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns2:TRANSACTION_ID>&lt;xsl:if test=&quot;$Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID&quot;>&lt;ns2:CORRELATION_ID>&lt;xsl:value-of select=&quot;$Ins_ProcID/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID&quot;/>&lt;/ns2:CORRELATION_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/ADB_OPERAZIONE&quot;>&lt;ns2:ADB_OPERAZIONE>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/ADB_OPERAZIONE&quot;/>&lt;/ns2:ADB_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/DATA_INIZIO_COINV_RETE&quot;>&lt;ns2:DATA_COINV>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/DATA_INIZIO_COINV_RETE&quot;/>&lt;/ns2:DATA_COINV>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_Contratto/Record[number($Counter)]/NOME_CONTRATTO&quot;>&lt;ns2:NOME_CONTRATTO>&lt;xsl:value-of select=&quot;$Select_P_Contratto/Record[number($Counter)]/NOME_CONTRATTO&quot;/>&lt;/ns2:NOME_CONTRATTO>&lt;/xsl:if>&lt;/ns2:TriggerContratto>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Request"
                                    name="Current"
                                    outputVariable="Request"
                                    tibex:xpdlId="dbdee546-e9ac-427d-8a4e-04348d9546e3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
