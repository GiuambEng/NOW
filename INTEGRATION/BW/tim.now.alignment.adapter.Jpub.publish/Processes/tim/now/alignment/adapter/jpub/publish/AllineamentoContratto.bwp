                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://tim.now.alignement.Jpub.adapter.Contratto.interprocess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&lt;xsl:param name=&quot;Ins_ProcID&quot;/>&lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Update>&lt;xsl:choose>&lt;xsl:when test=&quot;$Accumulate/ns1:root[number($Counter)][ns1:Contratto/ns1:Status='OK']&quot;>&lt;ns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'ContrattoInseritoSuCoda'&quot;/>&lt;/ns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'ContrattoNonValido'&quot;/>&lt;/ns:CONTENUTO_RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Accumulate/ns1:root[number($Counter)][ns1:Contratto/ns1:Status='OK']&quot;>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;ns:ID_TIPOLG_MESSG>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/ns:ID_TIPOLG_MESSG>&lt;xsl:if test=&quot;$Accumulate/ns1:root[number($Counter)]/ns1:Contratto/ns1:IDTransizione&quot;>&lt;ns:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$Accumulate/ns1:root[number($Counter)]/ns1:Contratto/ns1:IDTransizione&quot;/>&lt;/ns:ID_TRANSAZIONE>&lt;/xsl:if>&lt;/ns:Update>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
