    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="751b297b-bc48-412b-bb97-16a7ea78fd56">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="ErrorToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorToFault" tibex:linkType="ERROR"/>
                            <bpws:link name="CallProcessToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorLogToError" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:exit name="Exit1" tibex:xpdlId="bdd35351-531e-43ed-bc4b-80d28fff2bd9">
                            <bpws:targets>
                                <bpws:target linkName="ErrorToExit1"/>
                                <bpws:target linkName="CallProcessToExit1"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="ErrorLog-input"
                                name="ErrorLog"
                                tibex:xpdlId="caea4576-4ce9-49ec-b1a9-b91908385dca"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="ErrorLogToError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns5:BusinessID>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Fault AllineamentoCluster',tib:render-xml($FaultDetails,true(),true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GenericLoggerErr"
                            portType="ns12:GenericError" tibex:xpdlId="11a98b66-ceb3-4a7f-a710-89137c1f1879">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://xmlns.example.com/1469551322714" xmlns:ns4="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="Ins_ProcID"/&gt;
    &lt;xsl:template name="Error-input" match="/"&gt;
        &lt;tns5:Input&gt;
            &lt;part1&gt;
                &lt;ns4:Input&gt;
                    &lt;ns4:ActivityName&gt;
                        &lt;xsl:value-of select="'TRIGGER_ALLINEAMENTO_CLUSTER'"/&gt;
                    &lt;/ns4:ActivityName&gt;
                    &lt;ns4:Error&gt;
                        &lt;ns4:ActivityName&gt;
                            &lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;
                        &lt;/ns4:ActivityName&gt;
                        &lt;ns4:Msg&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/ns4:Msg&gt;
                        &lt;ns4:MsgCode&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/ns4:MsgCode&gt;
                        &lt;ns4:ProcessStack&gt;
                            &lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;
                        &lt;/ns4:ProcessStack&gt;
                        &lt;ns4:StackTrace&gt;
                            &lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;
                        &lt;/ns4:StackTrace&gt;
                    &lt;/ns4:Error&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;
                            &lt;xsl:if test="$Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE"&gt;
                                &lt;ns4:ID_Esec_Proc&gt;
                                    &lt;xsl:value-of select="$Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE"/&gt;
                                &lt;/ns4:ID_Esec_Proc&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/ns4:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:Input&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns4=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns4:Input>&#xa;            &lt;ns4:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'TRIGGER_ALLINEAMENTO_CLUSTER'&quot;/>&#xa;            &lt;/ns4:ActivityName>&#xa;            &lt;ns4:Error>&#xa;                &lt;ns4:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns4:ActivityName>&#xa;                &lt;ns4:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns4:Msg>&#xa;                &lt;ns4:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns4:MsgCode>&#xa;                &lt;ns4:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns4:ProcessStack>&#xa;                &lt;ns4:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns4:StackTrace>&#xa;            &lt;/ns4:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns4:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns4:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorLogToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToExit1"/>
                                <bpws:source linkName="ErrorToFault"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="Fault-input" name="Fault"
                                tibex:xpdlId="5dc23af7-1580-4751-969a-1e9525de2719"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorToFault"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToExit1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Fault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns5:BusinessID>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Fault subprocess Error',$_error/StackTrace,$_error/Msg,$_error/ProcessStack,$_error/MsgCode,$_error/FullClass,$_error/Class)&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="P_ContrattoToIns_ProcID" tibex:linkType="SUCCESS"/>
                <bpws:link name="Select_P_Contratto_1ToP_Contratto" tibex:linkType="SUCCESSWITHCONDITION"/>
