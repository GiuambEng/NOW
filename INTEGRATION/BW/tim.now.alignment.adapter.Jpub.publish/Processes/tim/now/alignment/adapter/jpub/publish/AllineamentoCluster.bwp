                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Err_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:UpdateOnError>&#xa;                &lt;ns3:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&#xa;                &lt;/ns3:DESCR_ERRORE>&#xa;                &lt;ns3:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns3:TIMSTP_RISPOSTA>&#xa;                &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns3:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_RICH_JPUB_RICH>&#xa;                &lt;ns3:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                &lt;/ns3:ID_TIPOLG_MESSG>&#xa;                &lt;ns3:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ns3:ID_TRANSAZIONE>&#xa;            &lt;/ns3:UpdateOnError>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Err_Staging-input"
                                    name="Err_Staging"
                                    tibex:xpdlId="1256c1f4-eb97-44d5-aa0a-a9d88f49da8f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Ins_StagingToErr_Staging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCounter"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Err_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:UpdateOnError>&#xa;                &lt;ns3:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&#xa;                &lt;/ns3:DESCR_ERRORE>&#xa;                &lt;ns3:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns3:TIMSTP_RISPOSTA>&#xa;                &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns3:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_RICH_JPUB_RICH>&#xa;                &lt;ns3:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                &lt;/ns3:ID_TIPOLG_MESSG>&#xa;                &lt;ns3:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ns3:ID_TRANSAZIONE>&#xa;            &lt;/ns3:UpdateOnError>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
