s2:Esito/ns2:CORRELATION_ID&quot;/>&lt;/ns:CORRELATION_ID>&lt;/xsl:if>&lt;/ns:TriggerClusterComuni>&lt;/xsl:template>&lt;/xsl:stylesheet>"
