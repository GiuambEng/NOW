            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Select_P_ClusterComune-input"
                    name="Select_P_ClusterComune"
                    outputVariable="Select_P_ClusterComune"
                    tibex:xpdlId="4c0d84a9-a476-4aad-ab8d-2602d9091b21" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Start_LogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Select_P_Contratto_1ToNoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Select_P_Contratto_1ToP_Contratto">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Select_P_ClusterComune/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Select_P_ClusterComune/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c0d84a9-a476-4aad-ab8d-2602d9091b21+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT&#xd;&#xa;&#x9;AC.ADB_TRACKING_ID,&#xd;&#xa;&#x9;AC.IDENTIFICATIVOCLUSTERCOMUNE,&#xd;&#xa;&#x9;AC.CODICEISTATCOMUNE,&#xd;&#xa;&#x9;AC.TIPOLOGIACLUSTERCOMUNE,&#xd;&#xa;&#x9;AC.DESCRIZIONECOMUNE,&#xd;&#xa;&#x9;AC.IDENTIFICATIVOOFFERTA,&#xd;&#xa;&#x9;AC.DATAINIZIOLIBERALIZZAZIONE,&#xd;&#xa;&#x9;AC.DATAFINELIBERALIZZAZIONE,&#xd;&#xa;&#x9;AC.DATAINIZIOMARCAGGIOPREGRESSO,&#xd;&#xa;&#x9;AC.&quot;VERSIONING&quot;,&#xd;&#xa;&#x9;Q.DATAINIZIOVALIDITAASSOCIAZIONE,&#xd;&#xa;&#x9;Q.DATAFINEVALIDITAASSOCIAZIONE,&#xd;&#xa;&#x9;Q.IDENTIFICATIVOPRICINGCOMUNE,&#xd;&#xa;&#x9;Q.ADB_TRACKING_ID AS ID&#xd;&#xa;FROM&#xd;&#xa;&#x9;P_ANAGRAFICA_CLUSTER_COMUNE AC,&#xd;&#xa;&#x9;P_ASSOCIA_PRICING_CLST_COMUNE Q&#xd;&#xa;WHERE&#xd;&#xa;&#x9;Q.IDENTIFICATIVOCLUSTERCOMUNE = AC.IDENTIFICATIVOCLUSTERCOMUNE&#xd;&#xa;&#x9;AND AC.DATAFINELIBERALIZZAZIONE>SYSDATE&#xd;&#xa;&#x9;AND Q.DATAINIZIOVALIDITAASSOCIAZIONE >= AC.DATAINIZIOLIBERALIZZAZIONE&#xd;&#xa;&#x9;--AND Q.DATAFINEVALIDITAASSOCIAZIONE &lt;= AC.DATAFINELIBERALIZZAZIONE&#xd;&#xa;&#x9;AND AC.ADB_DELIVERYSTATUS = 'I'&#xd;&#xa;&#x9;AND&#xd;&#xa;Q.ADB_DELIVERYSTATUS = 'I'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="ADB_TRACKING_ID"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="IDENTIFICATIVOCLUSTERCOMUNE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="CODICEISTATCOMUNE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="TIPOLOGIACLUSTERCOMUNE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DESCRIZIONECOMUNE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="IDENTIFICATIVOOFFERTA"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="DATAINIZIOLIBERALIZZAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="DATAFINELIBERALIZZAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="DATAINIZIOMARCAGGIOPREGRESSO"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="10"
                                    columnName="VERSIONING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="11"
                                    columnName="DATAINIZIOVALIDITAASSOCIAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="12"
                                    columnName="DATAFINEVALIDITAASSOCIAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="13"
                                    columnName="IDENTIFICATIVOPRICINGCOMUNE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="14"
                                    columnName="ID"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCUpdate-input" name="JDBCUpdate"
                    outputVariable="JDBCUpdate"
                    tibex:xpdlId="96f3ee38-7de5-4920-8a0a-30ce7ab82303" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateP_CLUSTERToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToAzzCounter"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+96f3ee38-7de5-4920-8a0a-30ce7ab82303+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/tns:root&quot;>&#xa;                &lt;Record>&#xa;                    &lt;ADB_TRACKING_ID>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns:AnagraficaCluster/tns:TRACKING_ID_ASS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:TRACKING_ID_ASS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ADB_TRACKING_ID>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns5:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE P_ASSOCIA_PRICING_CLST_COMUNE&#xa;  SET ADB_DELIVERYSTATUS = 'C'&#xa;  WHERE ADB_TRACKING_ID = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ADB_TRACKING_ID"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="SendVariazione-input"
                name="SendVariazione" operation="SendVariazione"
                partnerLink="AllineamentoCluster"
                portType="ns32:AllineamentoCluster" tibex:xpdlId="cb4b1833-1355-40c5-b888-7b7de7ffcad6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/AllineamentoCluster/" xmlns:tns="http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/" xmlns:tns2="http://tim.now.alignement.adpater.Cluster.Jpub/" version="2.0"&gt;&lt;xsl:param name="Accumulate"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:template name="SendVariazione-input" match="/"&gt;&lt;tns3:SendVariazioneRequest&gt;&lt;part1&gt;&lt;tns2:root&gt;&lt;xsl:for-each select="$Accumulate/tns:root[tns:AnagraficaCluster/tns:Status='OK']"&gt;&lt;tns2:AnagraficaCluster&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:COD_ISTAT_COMUNI"&gt;&lt;tns2:COD_ISTAT_COMUNI&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:COD_ISTAT_COMUNI"/&gt;&lt;/tns2:COD_ISTAT_COMUNI&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:COD_CLUSTER"&gt;&lt;tns2:COD_CLUSTER&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:COD_CLUSTER"/&gt;&lt;/tns2:COD_CLUSTER&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:TIPOLOG_CLUSTER_COMUNE"&gt;&lt;tns2:TIPOLOG_CLUSTER_COMUNE&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:TIPOLOG_CLUSTER_COMUNE"/&gt;&lt;/tns2:TIPOLOG_CLUSTER_COMUNE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:DATAINI_VALID_PRICING"&gt;&lt;tns2:DATAINI_VALID_PRICING&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:DATAINI_VALID_PRICING"/&gt;&lt;/tns2:DATAINI_VALID_PRICING&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:DATAFIN_VALID_PRICING"&gt;&lt;tns2:DATAFIN_VALID_PRICING&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:DATAFIN_VALID_PRICING"/&gt;&lt;/tns2:DATAFIN_VALID_PRICING&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:DESCR_COMUNE"&gt;&lt;tns2:DESCR_COMUNE&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:DESCR_COMUNE"/&gt;&lt;/tns2:DESCR_COMUNE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:AnagraficaCluster/tns:TIPO_CONTR"&gt;&lt;tns2:TIPO_CONTR&gt;&lt;xsl:va