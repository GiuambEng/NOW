:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns3:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$CheckError='ERRORE'&quot;>&#xa;                        &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                        &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&#xa;                        &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns3:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns3:TIMSTP_RICH>&#xa;                &lt;ns3:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                &lt;/ns3:ID_TIPOLG_MESSG>&#xa;                &lt;ns3:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ns3:ID_TRANSAZIONE>&#xa;                &lt;ns3:RecordTecnico>&#xa;                    &lt;xsl:value-of select=&quot;'RECORD_TECNICO'&quot;/>&#xa;                &lt;/ns3:RecordTecnico>&#xa;            &lt;/ns3:Insert>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
