                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/triggerClusterComuni/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Validate&quot;/>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;CheckError&quot;/>&lt;xsl:param name=&quot;Select_P_ClusterComune&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:root>&lt;tns:AnagraficaCluster>&lt;tns:COD_ISTAT_COMUNI>&lt;xsl:value-of select=&quot;$Validate/CODICE_ISTAT_COMUNE&quot;/>&lt;/tns:COD_ISTAT_COMUNI>&lt;xsl:if test=&quot;$Validate/CODICE_CLUSTER&quot;>&lt;tns:COD_CLUSTER>&lt;xsl:value-of select=&quot;$Validate/CODICE_CLUSTER&quot;/>&lt;/tns:COD_CLUSTER>&lt;/xsl:if>&lt;tns:TIPOLOG_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;$Validate/TIPOLOGIA_CLUSTER_COMUNE&quot;/>&lt;/tns:TIPOLOG_CLUSTER_COMUNE>&lt;xsl:if test=&quot;$Validate/DATA_INIZIO_VALIDITA_PRICING&quot;>&lt;tns:DATAINI_VALID_PRICING>&lt;xsl:value-of select=&quot;$Validate/DATA_INIZIO_VALIDITA_PRICING&quot;/>&lt;/tns:DATAINI_VALID_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;$Validate/DATA_FINE_VALIDITA_PRICING&quot;>&lt;tns:DATAFIN_VALID_PRICING>&lt;xsl:value-of select=&quot;$Validate/DATA_FINE_VALIDITA_PRICING&quot;/>&lt;/tns:DATAFIN_VALID_PRICING>&lt;/xsl:if>&lt;tns:DESCR_COMUNE>&lt;xsl:value-of select=&quot;$Validate/DESCRIZIONE_COMUNE&quot;/>&lt;/tns:DESCR_COMUNE>&lt;tns:TIPO_CONTR>&lt;xsl:value-of select=&quot;$Validate/TIPO_CONTR&quot;/>&lt;/tns:TIPO_CONTR>&lt;tns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;$Validate/DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/tns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&lt;tns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:value-of select=&quot;$Validate/DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&lt;/tns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&lt;xsl:if test=&quot;$Validate/DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&lt;tns:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;xsl:value-of select=&quot;$Validate/DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&lt;/tns:DATA_INIZIO_MARCAGGIO_PREGRESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Validate/VERSIONING&quot;>&lt;tns:VERSIONING>&lt;xsl:value-of select=&quot;$Validate/VERSIONING&quot;/>&lt;/tns:VERSIONING>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns:ADB_TRACKING_ID&quot;>&lt;tns:ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;$Request/ns:ADB_TRACKING_ID&quot;/>&lt;/tns:ADB_TRACKING_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns:TRANSACTION_ID&quot;>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$Request/ns:TRANSACTION_ID&quot;/>&lt;/tns:TransactionID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns:CORRELATION_ID&quot;>&lt;tns:CorrelationID>&lt;xsl:value-of select=&quot;$Request/ns:CORRELATION_ID&quot;/>&lt;/tns:CorrelationID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckError='ERRORE'&quot;>&lt;tns:Status>&lt;xsl:value-of select=&quot;'ERRORE'&quot;/>&lt;/tns:Status>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Status>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Status>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ID_Transazione>&lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/tns:ID_Transazione>&lt;tns:TRACKING_ID_ASS>&lt;xsl:value-of select=&quot;xsd:int($Select_P_ClusterComune/Record[$Counter]/ID)&quot;/>&lt;/tns:TRACKING_ID_ASS>&lt;/tns:AnagraficaCluster>&lt;/tns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
