                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/triggerClusterComuni/&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_P_ClusterComune&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;OFFERTA&quot;/>&#xa;    &lt;xsl:param name=&quot;Pricing&quot;/>&#xa;    &lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&#xa;        &lt;ns:TriggerClusterComuni>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/CODICEISTATCOMUNE&quot;>&#xa;                &lt;ns:COD_ISTAT_COMUNI>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/CODICEISTATCOMUNE&quot;/>&#xa;                &lt;/ns:COD_ISTAT_COMUNI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Pricing/Record[1]/CODICEPRICING&quot;>&#xa;                &lt;ns:COD_CLUSTER>&#xa;                    &lt;xsl:value-of select=&quot;$Pricing/Record[1]/CODICEPRICING&quot;/>&#xa;                &lt;/ns:COD_CLUSTER>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/TIPOLOGIACLUSTERCOMUNE&quot;>&#xa;                &lt;ns:TIPOLOG_CLUSTER_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/TIPOLOGIACLUSTERCOMUNE&quot;/>&#xa;                &lt;/ns:TIPOLOG_CLUSTER_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOVALIDITAASSOCIAZIONE&quot;>&#xa;                &lt;ns:DATAINI_VALID_PRICING>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOVALIDITAASSOCIAZIONE&quot;/>&#xa;                &lt;/ns:DATAINI_VALID_PRICING>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINEVALIDITAASSOCIAZIONE&quot;>&#xa;                &lt;ns:DATAFIN_VALID_PRICING>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINEVALIDITAASSOCIAZIONE&quot;/>&#xa;                &lt;/ns:DATAFIN_VALID_PRICING>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DESCRIZIONECOMUNE&quot;>&#xa;                &lt;ns:DESCR_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DESCRIZIONECOMUNE&quot;/>&#xa;                &lt;/ns:DESCR_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$OFFERTA/Record[1]/COD_OFFERTA_JPUB&quot;>&#xa;                &lt;ns:TIPO_CONTR>&#xa;                    &lt;xsl:value-of select=&quot;$OFFERTA/Record[1]/COD_OFFERTA_JPUB&quot;/>&#xa;                &lt;/ns:TIPO_CONTR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOLIBERALIZZAZIONE&quot;>&#xa;                &lt;ns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOLIBERALIZZAZIONE&quot;/>&#xa;                &lt;/ns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINELIBERALIZZAZIONE&quot;>&#xa;                &lt;ns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINELIBERALIZZAZIONE&quot;/>&#xa;                &lt;/ns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOMARCAGGIOPREGRESSO&quot;>&#xa;                &lt;ns:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOMARCAGGIOPREGRESSO&quot;/>&#xa;                &lt;/ns:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/VERSIONING&quot;>&#xa;                &lt;ns:VERSIONING>&#xa;                    &lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/VERSIONING&quot;/>&#xa;                &lt;/ns:VERSIONING>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ADB_TRACKING_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Select_P_ClusterComune/Record[$Counter]/ADB_TRACKING_ID)&quot;/>&#xa;            &lt;/ns:ADB_TRACKING_ID>&#xa;            &lt;ns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;            &lt;/ns:TRANSACTION_ID>&#xa;            &lt;xsl:if test=&quot;$Ins_ProcID.part1/ns2:Esito/ns2:CORRELATION_ID&quot;>&#xa;                &lt;ns:CORRELATION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Ins_ProcID.part1/ns2:Esito/ns2:CORRELATION_ID&quot;/>&#xa;                &lt;/ns:CORRELATION_ID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:TriggerClusterComuni>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
