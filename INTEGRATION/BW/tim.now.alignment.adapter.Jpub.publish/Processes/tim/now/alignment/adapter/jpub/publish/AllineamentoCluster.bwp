            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="End-input" name="End"
                    tibex:xpdlId="34e59cd8-6879-4d6c-8e10-da17b82b15cd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpProcessIdToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EndToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns5:BusinessID>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;'ProcessoTerminatoCorrettamente'&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="UpProcessId-input"
                name="UpProcessId" operation="Insert"
                outputVariable="UpProcessId" partnerLink="Logger"
                portType="ns10:ProcessLog" tibex:xpdlId="d454fc27-bd06-4472-8dec-2668fbd9fa2c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Ins_ProcID"/&gt;
    &lt;xsl:template name="UpProcessId-input" match="/"&gt;
        &lt;tns5:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="'NOFILE'"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="'UPDATE'"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))"/&gt;
                        &lt;/ns2:ID_ESEC_PROCSO_NO_FILE&gt;
                        &lt;ns2:STATO_ESEC&gt;
                            &lt;xsl:value-of select="'CHIUSO'"/&gt;
                        &lt;/ns2:STATO_ESEC&gt;
                        &lt;ns2:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TMSP_FINE_ELAB&gt;
                    &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpProcessId-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, &amp;quot;.&amp;quot;))&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_FINE_ELAB>&#xa;            &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="While1ToUpProcessId"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpProcessIdToEnd"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogRequest-input"
                    name="LogRequest"
                    tibex:xpdlId="2edf318c-65a8-4d29-9e80-19deb9535235"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToLogRequest"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRequestToSendVariazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($Accumulate/ns31:root[ns31:AnagraficaCluster/ns31:Status='OK'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($Accumulate/ns31:root[ns31:AnagraficaCluster/ns31:Status='OK'])]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogRequestToUpdateP_Contratto">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns5:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Accumulate/tns:root)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Accumulate',tib:render-xml($Accumulate,true(),true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record Valido da Inviare a Jpub'&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="51671ba2-e9b3-40f4-b4fd-95fa03ff1afc">
                <bpws:targets>
                    <bpws:target linkName="Ins_ProcIDToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogRequest"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+8963768b-318f-42ec-aea6-291b0beef05e" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter &lt;= count($Select_P_ClusterComune/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter <= count($Select_P_ClusterComune/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="ValidateToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CurrentToValidate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToCheck_Error" tibex:linkType="ERROR"/>
                                <bpws:link name="Ins_StagingToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToCounter" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Check_ErrorToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Ins_StagingToErr_Staging" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Log_ErrorToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SetCheckToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToIns_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link name="OFFERTAToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToCurrent" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="36684334-9f27-4460-a544-e60144d3b9fe">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery1">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
