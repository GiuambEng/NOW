                                <bpws:targets>
                                    <bpws:target linkName="Counter_1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Ins_ProcID&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:Update>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)][tns:AnagraficaCluster/tns:Status='OK']&quot;>&#xa;                        &lt;ns3:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'ClusterComuneInseritoSuCoda'&quot;/>&#xa;                        &lt;/ns3:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns3:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'ClusterComuneNonValido'&quot;/>&#xa;                        &lt;/ns3:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns3:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns3:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)][tns:AnagraficaCluster/tns:Status='OK']&quot;>&#xa;                        &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&#xa;                        &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns3:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                        &lt;/ns3:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns3:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Ins_ProcID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns3:ID_RICH_JPUB_RICH>&#xa;                &lt;ns3:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;4&quot;/>&#xa;                &lt;/ns3:ID_TIPOLG_MESSG>&#xa;                &lt;xsl:if test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaCluster/tns:ID_Transazione&quot;>&#xa;                    &lt;ns3:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaCluster/tns:ID_Transazione&quot;/>&#xa;                    &lt;/ns3:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns3:Update>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Up_Staging-input"
                                    name="Up_Staging"
                                    tibex:xpdlId="a220c5da-076d-4c2b-811e-491e67795035"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
