                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_P_ClusterComune&quot;/>&#xa;    &lt;xsl:template name=&quot;P_ClusterComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoCluster'&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;tns5:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns5:BusinessID>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Select_P_ClusterComune record trovati:&amp;quot;, tib:render-xml($Select_P_ClusterComune, true(), true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Ins_ProcID-input"
                name="Ins_ProcID" operation="Insert"
                outputVariable="Ins_ProcID" partnerLink="Logger"
                portType="ns10:ProcessLog" tibex:xpdlId="b9a67318-cb3c-4195-9c2b-a8c54634736d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns2="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;
    &lt;xsl:param name="Id_Procso_Contratto"/&gt;
    &lt;xsl:template name="Ins_ProcID-input" match="/"&gt;
        &lt;tns5:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns2:Input&gt;
                    &lt;ns2:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaProcesso&gt;
                    &lt;ns2:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns2:TipologiaOperazione&gt;
                    &lt;ns2:ProcFile/&gt;
                    &lt;ns2:EsecuzioneNOFileProcessato&gt;
                        &lt;ns2:CorrelationID&gt;
                            &lt;ns2:Mode&gt;
                                &lt;xsl:value-of select="&amp;quot;CREATE&amp;quot;"/&gt;
                            &lt;/ns2:Mode&gt;
                        &lt;/ns2:CorrelationID&gt;
                        &lt;ns2:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$Id_Procso_Contratto"/&gt;
                        &lt;/ns2:ID_PROCSO_NO_FILE&gt;
                        &lt;ns2:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                        &lt;/ns2:STATO_ESEC&gt;
                        &lt;ns2:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns2:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns2:EsecuzioneNOFileProcessato&gt;
                &lt;/ns2:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Id_Procso_Contratto&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins_ProcID-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Input>&#xa;            &lt;ns2:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaProcesso>&#xa;            &lt;ns2:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns2:TipologiaOperazione>&#xa;            &lt;ns2:ProcFile/>&#xa;            &lt;ns2:EsecuzioneNOFileProcessato>&#xa;                &lt;ns2:CorrelationID>&#xa;                    &lt;ns2:Mode>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CREATE&amp;quot;&quot;/>&#xa;                    &lt;/ns2:Mode>&#xa;                &lt;/ns2:CorrelationID>&#xa;                &lt;ns2:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Id_Procso_Contratto&quot;/>&#xa;                &lt;/ns2:ID_PROCSO_NO_FILE>&#xa;                &lt;ns2:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                &lt;/ns2:STATO_ESEC>&#xa;                &lt;ns2:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns2:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns2:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
