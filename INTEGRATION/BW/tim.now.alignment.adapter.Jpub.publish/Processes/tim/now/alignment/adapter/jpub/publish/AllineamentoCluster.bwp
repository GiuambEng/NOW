                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/triggerClusterComuni/&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_P_ClusterComune&quot;/>&lt;xsl:param name=&quot;Ins_ProcID&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;OFFERTA&quot;/>&lt;xsl:param name=&quot;Pricing&quot;/>&lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&lt;ns:TriggerClusterComuni>&lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/CODICEISTATCOMUNE&quot;>&lt;ns:COD_ISTAT_COMUNI>&lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/CODICEISTATCOMUNE&quot;/>&lt;/ns:COD_ISTAT_COMUNI>&lt;/xsl:if>&lt;xsl:if test=&quot;$Pricing/Record[1]/CODICEPRICING&quot;>&lt;ns:COD_CLUSTER>&lt;xsl:value-of select=&quot;$Pricing/Record[1]/CODICEPRICING&quot;/>&lt;/ns:COD_CLUSTER>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/TIPOLOGIACLUSTERCOMUNE&quot;>&lt;ns:TIPOLOG_CLUSTER_COMUNE>&lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/TIPOLOGIACLUSTERCOMUNE&quot;/>&lt;/ns:TIPOLOG_CLUSTER_COMUNE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOVALIDITAASSOCIAZIONE&quot;>&lt;ns:DATAINI_VALID_PRICING>&lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAINIZIOVALIDITAASSOCIAZIONE&quot;/>&lt;/ns:DATAINI_VALID_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINEVALIDITAASSOCIAZIONE&quot;>&lt;ns:DATAFIN_VALID_PRICING>&lt;xsl:value-of select=&quot;$Select_P_ClusterComune/Record[$Counter]/DATAFINEVALIDITAASSOCIAZIONE&quot;/>&lt;/ns:DATAFIN_VALID_PRICING>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select