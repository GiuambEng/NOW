D_TRANSAZIONE&gt;&lt;xsl:value-of select="tns:AnagraficaCluster/tns:ID_Transazione"/&gt;&lt;/tns2:ID_TRANSAZIONE&gt;&lt;/xsl:if&gt;&lt;/tns2:AnagraficaCluster&gt;&lt;/xsl:for-each&gt;&lt;tns2:ProcessID&gt;&lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;&lt;/tns2:ProcessID&gt;&lt;/tns2:root&gt;&lt;/part1&gt;&lt;/tns3:SendVariazioneRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/AllineamentoCluster/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/tim.now.alignement.adpater.Cluster.Jpub/&quot; xmlns:tns2=&quot;http://tim.now.alignement.adpater.Cluster.Jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;SendVariazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:root>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/tns:root[tns:AnagraficaCluster/tns:Status='OK']&quot;>&#xa;                &lt;tns2:AnagraficaCluster>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:COD_ISTAT_COMUNI&quot;>&#xa;                        &lt;tns2:COD_ISTAT_COMUNI>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:COD_ISTAT_COMUNI&quot;/>&#xa;                        &lt;/tns2:COD_ISTAT_COMUNI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:COD_CLUSTER&quot;>&#xa;                        &lt;tns2:COD_CLUSTER>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:COD_CLUSTER&quot;/>&#xa;                        &lt;/tns2:COD_CLUSTER>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:TIPOLOG_CLUSTER_COMUNE&quot;>&#xa;                        &lt;tns2:TIPOLOG_CLUSTER_COMUNE>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:TIPOLOG_CLUSTER_COMUNE&quot;/>&#xa;                        &lt;/tns2:TIPOLOG_CLUSTER_COMUNE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DATAINI_VALID_PRICING&quot;>&#xa;                        &lt;tns2:DATAINI_VALID_PRICING>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DATAINI_VALID_PRICING&quot;/>&#xa;                        &lt;/tns2:DATAINI_VALID_PRICING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DATAFIN_VALID_PRICING&quot;>&#xa;                        &lt;tns2:DATAFIN_VALID_PRICING>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DATAFIN_VALID_PRICING&quot;/>&#xa;                        &lt;/tns2:DATAFIN_VALID_PRICING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DESCR_COMUNE&quot;>&#xa;                        &lt;tns2:DESCR_COMUNE>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DESCR_COMUNE&quot;/>&#xa;                        &lt;/tns2:DESCR_COMUNE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:TIPO_CONTR&quot;>&#xa;                        &lt;tns2:TIPO_CONTR>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:TIPO_CONTR&quot;/>&#xa;                        &lt;/tns2:TIPO_CONTR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;>&#xa;                        &lt;tns2:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                        &lt;/tns2:DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;>&#xa;                        &lt;tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI&quot;/>&#xa;                        &lt;/tns2:DATA_FINE_MARCAGGIO_NUOVI_ACCESSI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;>&#xa;                        &lt;tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:DATA_INIZIO_MARCAGGIO_PREGRESSO&quot;/>&#xa;                        &lt;/tns2:DATA_INIZIO_MARCAGGIO_PREGRESSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:VERSIONING&quot;>&#xa;                        &lt;tns2:VERSIONING>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:VERSIONING&quot;/>&#xa;                        &lt;/tns2:VERSIONING>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:ADB_OPERAZIONE&quot;>&#xa;                        &lt;tns2:ADB_OPERAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:ADB_OPERAZIONE&quot;/>&#xa;                        &lt;/tns2:ADB_OPERAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:ADB_TRACKING_ID&quot;>&#xa;                        &lt;tns2:ADB_TRACKING_ID>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:ADB_TRACKING_ID&quot;/>&#xa;                        &lt;/tns2:ADB_TRACKING_ID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:TransactionID&quot;>&#xa;                        &lt;tns2:TransactionID>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:TransactionID&quot;/>&#xa;                        &lt;/tns2:TransactionID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:CorrelationID&quot;>&#xa;                        &lt;tns2:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:CorrelationID&quot;/>&#xa;                        &lt;/tns2:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:AnagraficaCluster/tns:ID_Transazione&quot;>&#xa;                        &lt;tns2:ID_TRANSAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tns:AnagraficaCluster/tns:ID_Transazione&quot;/>&#xa;                        &lt;/tns2:ID_TRANSAZIONE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:AnagraficaCluster>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;tns2:ProcessID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ProcessID>&#xa;        &lt;/tns2:root>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
