                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerOLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;SEL_P_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&#xa;        &lt;ns:TriggerContratto>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;>&#xa;                &lt;ns:COD_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/ns:COD_OLO_AGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/NOME&quot;>&#xa;                &lt;ns:NOME>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/NOME&quot;/>&#xa;                &lt;/ns:NOME>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/PARTITA_IVA&quot;>&#xa;                &lt;ns:PARTITA_IVA>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/PARTITA_IVA&quot;/>&#xa;                &lt;/ns:PARTITA_IVA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/RAGIONE_SOCIALE&quot;>&#xa;                &lt;ns:RAGIONE_SOCIALE>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/RAGIONE_SOCIALE&quot;/>&#xa;                &lt;/ns:RAGIONE_SOCIALE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/ADB_OPERAZIONE&quot;>&#xa;                &lt;ns:ADB_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/ADB_OPERAZIONE&quot;/>&#xa;                &lt;/ns:ADB_OPERAZIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/TIMSTP_INSMTO&quot;>&#xa;                &lt;ns:TIMP_INSERIMENTO>&#xa;                    &lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/TIMSTP_INSMTO&quot;/>&#xa;                &lt;/ns:TIMP_INSERIMENTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ADB_TRACKING_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($SEL_P_OLO/Record[number($Counter)]/ADB_TRACKING_ID)&quot;/>&#xa;            &lt;/ns:ADB_TRACKING_ID>&#xa;            &lt;ns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;            &lt;/ns:TransactionID>&#xa;            &lt;xsl:if test=&quot;$ProcessID.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;xsl:value-of select=&quot;$ProcessID.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                &lt;/ns:CorrelationID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:TriggerContratto>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
