            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="3b6091da-042f-4fec-b850-cc6cd6b7d0b4">
                <bpws:targets>
                    <bpws:target linkName="ProcessIDToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileTolog_Request"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+7ab80e65-725f-4589-a27a-15888847b580" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter&lt;=count($SEL_P_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter<=count($SEL_P_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="MapperToIns_Staging" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Ins_StagingTolog_Request" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Ins_StagingToErr_Staging" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CurrentToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToInput" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ValidateToCheckErrore" tibex:linkType="ERROR"/>
                                <bpws:link name="CheckErroreToLog_Error" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log_ErrorToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignTolog_Request" tibex:linkType="SUCCESS"/>
                                <bpws:link name="SetErroreToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToCurrent" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Err_StagingToCounter" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToValidate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="96033b7b-b8d5-4cee-8d15-d8b7e7f61f0a">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCurrent"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="7ab80e65-725f-4589-a27a-15888847b580" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SetErroreToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Input</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Input-input"
                                    name="Input" outputVariable="Input"
                                    tibex:xpdlId="a93b6a13-f27e-4a02-b4c6-51eb98cc3ad5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log_ErrorToMapper"/>
                                    <bpws:target linkName="ValidateToInput"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToIns_Staging"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://tim.now.alignement.Jpub.adapter.OLO.interprocess&quot; xmlns:ns1=&quot;www.telecom.Now.outputtriggerOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;Check&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Input-input&quot; match=&quot;/&quot;>&lt;tns1:root>&lt;tns1:AnagraficaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Request/ns1:ADB_OPERAZIONE='I'&quot;>&lt;tns1:TIPO_AZIONE>&lt;xsl:value-of select=&quot;'ATT'&quot;/>&lt;/tns1:TIPO_AZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Request/ns1:ADB_OPERAZIONE='U'&quot;>&lt;tns1:TIPO_AZIONE>&lt;xsl:value-of select=&quot;'VAR'&quot;/>&lt;/tns1:TIPO_AZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TIPO_AZIONE>&lt;xsl:value-of select=&quot;'DIS'&quot;/>&lt;/tns1:TIPO_AZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:CODE_GEST>&lt;xsl:value-of select=&quot;$Request/ns1:COD_OLO_AGCOM&quot;/>&lt;/tns1:CODE_GEST>&lt;tns1:NOME_RAG_SOC_GEST>&lt;xsl:value-of select=&quot;$Request/ns1:RAGIONE_SOCIALE&quot;/>&lt;/tns1:NOME_RAG_SOC_GEST>&lt;tns1:NOME_GEST_SIGLA>&lt;xsl:value-of select=&quot;$Request/ns1:NOME&quot;/>&lt;/tns1:NOME_GEST_SIGLA>&lt;tns1:CODE_PARTITA_IVA>&lt;xsl:value-of select=&quot;$Request/ns1:PARTITA_IVA&quot;/>&lt;/tns1:CODE_PARTITA_IVA>&lt;tns1:CODE_GEST_TIRKS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:CODE_GEST_TIRKS>&lt;xsl:if test=&quot;$Request/ns1:ADB_TRACKING_ID&quot;>&lt;tns1:ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;$Request/ns1:ADB_TRACKING_ID&quot;/>&lt;/tns1:ADB_TRACKING_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns1:TransactionID&quot;>&lt;tns1:TransactionID>&lt;xsl:value-of select=&quot;$Request/ns1:TransactionID&quot;/>&lt;/tns1:TransactionID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns1:CorrelationID&quot;>&lt;tns1:CorrelationID>&lt;xsl:value-of select=&quot;$Request/ns1:CorrelationID&quot;/>&lt;/tns1:CorrelationID>&lt;/xsl:if>&lt;xsl:if test=&quot;$Request/ns1:ADB_OPERAZIONE&quot;>&lt;tns1:ADB_OPERAZIONE>&lt;xsl:value-of select=&quot;$Request/ns1:ADB_OPERAZIONE&quot;/>&lt;/tns1:ADB_OPERAZIONE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&lt;tns1:Status>&lt;xsl:value-of select=&quot;'ERRORE'&quot;/>&lt;/tns1:Status>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Status>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Status>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:ID_Transazione>&lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&lt;/tns1:ID_Transazione>&lt;/tns1:AnagraficaOLO>&lt;/tns1:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
