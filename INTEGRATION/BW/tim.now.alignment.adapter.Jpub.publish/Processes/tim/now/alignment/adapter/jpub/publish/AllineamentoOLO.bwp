                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SEL_P_OLO/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SEL_P_OLO/Record)>0]]></bpws:transitionCondition>
