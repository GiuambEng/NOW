                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODFC_OLO_AGCOM, NOME, PARTITA_IVA, RAGIONE_SOCIALE, ADB_OPERAZIONE, TIMSTP_INSMTO,ADB_TRACKING_ID&#xa;  FROM P_OLO&#xa;  WHERE ADB_DELIVERYSTATUS = 'I'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
