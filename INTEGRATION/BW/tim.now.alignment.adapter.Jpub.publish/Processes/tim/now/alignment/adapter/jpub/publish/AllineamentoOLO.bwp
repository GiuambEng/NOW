                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.telecom.Now.outputtriggerOLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;SEL_P_OLO&quot;/>&lt;xsl:param name=&quot;ProcessID&quot;/>&lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&lt;ns:TriggerContratto>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;>&lt;ns:COD_OLO_AGCOM>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/CODFC_OLO_AGCOM&quot;/>&lt;/ns:COD_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/PARTITA_IVA&quot;>&lt;ns:PARTITA_IVA>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/PARTITA_IVA&quot;/>&lt;/ns:PARTITA_IVA>&lt;/xsl:if>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/RAGIONE_SOCIALE&quot;>&lt;ns:RAGIONE_SOCIALE>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/RAGIONE_SOCIALE&quot;/>&lt;/ns:RAGIONE_SOCIALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/ADB_OPERAZIONE&quot;>&lt;ns:ADB_OPERAZIONE>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/ADB_OPERAZIONE&quot;/>&lt;/ns:ADB_OPERAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$SEL_P_OLO/Record[number($Counter)]/TIMSTP_INSMTO&quot;>&lt;ns:TIMP_INSERIMENTO>&lt;xsl:value-of select=&quot;$SEL_P_OLO/Record[number($Counter)]/TIMSTP_INSMTO&quot;/>&lt;/ns:TIMP_INSERIMENTO>&lt;/xsl:if>&lt;ns:ADB_TRACKING_ID>&lt;xsl:value-of select=&quot;xsd:int($SEL_P_OLO/Record[number($Counter)]/ADB_TRACKING_ID)&quot;/>&lt;/ns:ADB_TRACKING_ID>&lt;ns:TransactionID>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:TransactionID>&lt;xsl:if test=&quot;$ProcessID/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID&quot;>&lt;ns:CorrelationID>&lt;xsl:value-of select=&quot;$ProcessID/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID&quot;/>&lt;/ns:CorrelationID>&lt;/xsl:if>&lt;/ns:TriggerContratto>&lt;/xsl:template>&lt;/xsl:stylesheet>"
