                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;Check&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:Input>&#xa;            &lt;ns1:Insert>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Check='ERRORE'&quot;>&#xa;                        &lt;ns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Request)&quot;/>&#xa;                        &lt;/ns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns1:CONTENUTO_REQUEST>&#xa;                            &lt;xsl:value-of select=&quot;concat('****Input Trigger: ',tib:render-xml($Request),'****Mapping eseguito****',tib:render-xml($Input))&quot;/>&#xa;                        &lt;/ns1:CONTENUTO_REQUEST>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns1:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns1:ID_RICH_JPUB_RICH>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Check='ERROR'&quot;>&#xa;                        &lt;ns1:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                        &lt;/ns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns1:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&#xa;                        &lt;/ns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns1:TIMSTP_RICH>&#xa;                &lt;ns1:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/ns1:ID_TIPOLG_MESSG>&#xa;                &lt;ns1:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBCQuery/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ns1:ID_TRANSAZIONE>&#xa;                &lt;ns1:RecordTecnico>&#xa;                    &lt;xsl:value-of select=&quot;'RECORD_TECNICO'&quot;/>&#xa;                &lt;/ns1:RecordTecnico>&#xa;            &lt;/ns1:Insert>&#xa;        &lt;/ns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
