                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.OLO.interprocess&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&lt;xsl:param name=&quot;ProcessID&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:Update>&lt;xsl:choose>&lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:Status='OK'&quot;>&lt;ns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'OloInseritoSuCoda'&quot;/>&lt;/ns:CONTENUTO_RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;'OloNonValido'&quot;/>&lt;/ns:CONTENUTO_RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:Status='OK'&quot;>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH_JPUB_RICH>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID/part1/ns2:Output/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&lt;/ns:ID_RICH_JPUB_RICH>&lt;ns:ID_TIPOLG_MESSG>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/ns:ID_TIPOLG_MESSG>&lt;xsl:if test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:ID_Transazione&quot;>&lt;ns:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:ID_Transazione&quot;/>&lt;/ns:ID_TRANSAZIONE>&lt;/xsl:if>&lt;/ns:Update>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="UpStaging-input"
                                    name="UpStaging"
                                    tibex:xpdlId="fab9b61e-e64e-43ed-ab4c-4cc2082853bf"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToUpStaging"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpStagingToUp_ProcessID"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd&quot; xmlns:ns2=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://tim.now.alignement.Jpub.adapter.OLO.interprocess&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ElabStaging&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;KO_ElabStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:Update>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:Status='OK'&quot;>&#xa;                        &lt;ns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'OloInseritoSuCoda'&quot;/>&#xa;                        &lt;/ns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:CONTENUTO_RESPONSE>&#xa;                            &lt;xsl:value-of select=&quot;'OloNonValido'&quot;/>&#xa;                        &lt;/ns:CONTENUTO_RESPONSE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:Status='OK'&quot;>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$OK_ElabStaging&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:value-of select=&quot;$KO_ElabStaging&quot;/>&#xa;                        &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_RICH_JPUB_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessID.part1/ns2:Esito/ns2:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_RICH_JPUB_RICH>&#xa;                &lt;ns:ID_TIPOLG_MESSG>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/ns:ID_TIPOLG_MESSG>&#xa;                &lt;xsl:if test=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:ID_Transazione&quot;>&#xa;                    &lt;ns:ID_TRANSAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns:root[number($Counter)]/tns:AnagraficaOLO/tns:ID_Transazione&quot;/>&#xa;                    &lt;/ns:ID_TRANSAZIONE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Update>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.alignment.adapter.jpub.publish.subStaging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Counter"
                                    name="Counter_1"
                                    outputVariable="Counter"
                                    tibex:xpdlId="08163f42-08aa-4820-889d-fac91b2616a1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpStagingToUp_ProcessID"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Counter_1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$Counter +1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Counter" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
