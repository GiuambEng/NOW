							<xs:element name="ID_TIPOLG_MESSG" type="xs:integer" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_TRANSAZIONE" type="xs:string" maxOccurs="1" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="UpdateOnError">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DESCR_ERRORE" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TIMSTP_RISPOSTA" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer" maxOccurs="1" minOccurs="0"/>
