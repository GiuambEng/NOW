								type="xs:string" maxOccurs="1" minOccurs="0" />
							<xs:element name="ID_ESEC_PROCSO_NO_FILE"
								type="xs:integer" />
							<xs:element name="ID_RICH_JPUB_RICH"
								type="xs:integer" maxOccurs="1" minOccurs="0" />
