<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
targetNamespace="www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd"
xmlns="www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.xsd"
xmlns:xs="http://www.w3.org/2001/XMLSchema" 
