<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
targetNamespace="www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.In.xsd"
xmlns="www.tim.now.aggiornamentomassivo.Jpub.OLO.Staging.In.xsd"
xmlns:xs="http://www.w3.org/2001/XMLSchema" 
elementFormDefault="qualified" 
attributeFormDefault="unqualified">
	<xs:element name="Input">
		<xs:complexType>
			<xs:choice>
				<xs:element name="Insert">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CONTENUTO_REQUEST" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_PROCSO_NO_FILE" type="xs:integer"/>
							<xs:element name="ID_RICH_JPUB_RICH" type="xs:integer" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TIMSTP_RICH" type="xs:string" maxOccurs="1" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Update">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CONTENUTO_RESPONSE" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TIMSTP_RISPOSTA" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_PROCSO_NO_FILE" type="xs:integer"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="UpdateOnError">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DESCR_ERRORE" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="TIMSTP_RISPOSTA" type="xs:string" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_STATO_ELAB_STAG" type="xs:integer" maxOccurs="1" minOccurs="0"/>
							<xs:element name="ID_PROCSO_NO_FILE" type="xs:integer"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>
