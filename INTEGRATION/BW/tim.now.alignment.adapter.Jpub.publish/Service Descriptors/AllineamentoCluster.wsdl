<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/AllineamentoCluster/" xmlns:ns0="http://tim.now.alignement.adpater.Cluster.Jpub/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="AllineamentoCluster" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/AllineamentoCluster/">
	<wsdl:types>
		<xsd:schema xmlns:tns="http://tim.now.alignement.adpater.Cluster.Jpub/" elementFormDefault="qualified" targetNamespace="http://tim.now.alignement.adpater.Cluster.Jpub/">
			<xsd:element name="root">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element maxOccurs="unbounded" minOccurs="0" name="AnagraficaCluster">
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element minOccurs="0" name="COD_ISTAT_COMUNI" type="xsd:string"/>
									<xsd:element minOccurs="0" name="COD_CLUSTER" type="xsd:string"/>
									<xsd:element minOccurs="0" name="TIPOLOG_CLUSTER_COMUNE" type="xsd:string"/>
									
									<xsd:element minOccurs="0" name="DATAINI_VALID_PRICING" type="xsd:string"/>
									<xsd:element minOccurs="0" name="DATAFIN_VALID_PRICING" type="xsd:string"/>
									<xsd:element minOccurs="0" name="DESCR_COMUNE" type="xsd:string"/>
									<xsd:element minOccurs="0" name="TIPO_CONTR" type="xsd:string"/>
									<xsd:element minOccurs="0" name="DATA_INIZIO_MARCAGGIO_NUOVI_ACCESSI" type="xsd:string"/>
									<xsd:element minOccurs="0" name="DATA_FINE_MARCAGGIO_NUOVI_ACCESSI" type="xsd:string"/>
									<xsd:element minOccurs="0" name="DATA_INIZIO_MARCAGGIO_PREGRESSO" type="xsd:string"/>
									<xsd:element minOccurs="0" name="VERSIONING" type="xsd:string"/>
									<xsd:element minOccurs="0" name="ADB_OPERAZIONE" type="xsd:string"/>
									<xsd:element minOccurs="0" name="ADB_TRACKING_ID" type="xsd:string"/>
									<xsd:element minOccurs="0" name="TransactionID" type="xsd:integer"/>
									<xsd:element minOccurs="0" name="CorrelationID" type="xsd:integer"/>
									<xsd:element minOccurs="0" name="ID_TRANSAZIONE" type="xsd:string"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element minOccurs="0" name="ProcessID" type="xsd:string"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:schema>
	</wsdl:types>
	<wsdl:message name="SendVariazioneRequest">
		<wsdl:part name="part1" element="ns0:root"/>
	</wsdl:message>
	<wsdl:portType name="AllineamentoCluster">
		<wsdl:operation name="SendVariazione">
			<wsdl:input message="ns:SendVariazioneRequest"/>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="SOAPServiceBinding" type="ns:AllineamentoCluster">
		<soap:binding style="document" transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"/>
		<jms:binding messageFormat="text"/>
		<wsdl:operation name="SendVariazione">
			<soap:operation soapAction="SendVariazione" style="document"/>
			<wsdl:input>
				<soap:body parts="part1" use="literal"/>
			</wsdl:input>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="AllineamentoCluster">
		<wsdl:port name="AllineamentoClusterSOAP" binding="ns:SOAPServiceBinding">
			<soap:address/>
			<jms:connectionFactory>SSLQueueConnectionFactory</jms:connectionFactory>
			<jms:targetAddress destination="queue">tim.now.alignment.adapter.publish.Jpub.cluster</jms:targetAddress>
		</wsdl:port>
	</wsdl:service>
