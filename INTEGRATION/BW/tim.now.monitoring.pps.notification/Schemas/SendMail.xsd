<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/SendMail" xmlns:tns="http://www.example.org/SendMail" elementFormDefault="qualified">

    <element name="InputEmail">
    	<complexType>
    		<sequence>
    		<element name="ID_MAIL" type="int" maxOccurs="1" minOccurs="0"></element>
    		<element name="ID_REPORT" type="int" maxOccurs="1" minOccurs="0"></element>
    		<element name="ID_MAIL_CON_ALLEGATO" type="int" maxOccurs="1" minOccurs="0"></element>
    			<element name="FROM" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CC" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="USERNAME" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="PASSWORD" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="SUBJECT" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CONTENUTO_EMAIL" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ALLEGATO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="NOME_ALLEGATO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FLUSSO" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>