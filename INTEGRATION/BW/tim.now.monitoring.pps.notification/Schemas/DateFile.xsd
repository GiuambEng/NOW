<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/DateFile" xmlns:tns="http://www.example.org/DateFile" elementFormDefault="qualified">

	<element name="DateFile">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0"
    				ref="tns:Date_input">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Date_input">
		<complexType>
			<sequence>
				<element name="DAL" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="AL" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="MESE" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="ANNO" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>