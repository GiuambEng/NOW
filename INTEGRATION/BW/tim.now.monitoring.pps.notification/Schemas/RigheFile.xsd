<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/RigheFile" xmlns:tns="http://www.example.org/RigheFile" elementFormDefault="qualified">

	<element name="RigheFile">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:RigheFile_input">
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="RigheFile_input">
		<complexType>
			<sequence>
				<element name="ordini" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="dn" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="des" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="olo" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="olo_code" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="routingnumber" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="asset" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="des_asset" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="olo_code_asset" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="olo_asset" type="string" maxOccurs="1" minOccurs="0"/>
				<element name="statoasset" type="string" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
</schema>

