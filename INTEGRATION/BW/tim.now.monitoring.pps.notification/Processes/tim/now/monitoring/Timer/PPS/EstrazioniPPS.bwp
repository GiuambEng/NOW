                                    <bpws:sources>
                                    <bpws:source linkName="CallProcedureToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;tns:InputCallProcedurePPS>&lt;xsl:if test=&quot;$currentElement/ns:DESCR_PPS&quot;>&lt;tns:DESCR_PPS>&lt;xsl:value-of select=&quot;$currentElement/ns:DESCR_PPS&quot;/>&lt;/tns:DESCR_PPS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:ID_PPS&quot;>&lt;tns:ID_PPS>&lt;xsl:value-of select=&quot;$currentElement/ns:ID_PPS&quot;/>&lt;/tns:ID_PPS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATAESECUZIONE&quot;>&lt;tns:DATAESECUZIONE>&lt;xsl:value-of select=&quot;$currentElement/ns:DATAESECUZIONE&quot;/>&lt;/tns:DATAESECUZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATA_INIZIO&quot;>&lt;tns:DATAINIZIO>&lt;xsl:value-of select=&quot;$currentElement/ns:DATA_INIZIO&quot;/>&lt;/tns:DATAINIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATA_FINE&quot;>&lt;tns:DATAFINE>&lt;xsl:value-of select=&quot;$currentElement/ns:DATA_FINE&quot;/>&lt;/tns:DATAFINE>&lt;/xsl:if>&lt;/tns:InputCallProcedurePPS>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.monitoring.Timer.PPS.CallProcedurePPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns1=&quot;http://www.example.org/CheckActiveJob&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:ID_PPS>&lt;xsl:value-of select=&quot;$currentElement/tns:ID_PPS&quot;/>&lt;/tns1:ID_PPS>&lt;/tns1:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CheckJobAttivi-input"
                                    name="CheckJobAttivi"
                                    outputVariable="CheckJobAttivi"
                                    tibex:xpdlId="a1d5844e-1271-4e25-aa2f-75f4c6e05e18"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckJobAttiviToCallProcedure">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CheckJobAttivi/tns:RESULT='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CheckJobAttivi/tns:RESULT='OK']]></bpws:transitionCondition>
