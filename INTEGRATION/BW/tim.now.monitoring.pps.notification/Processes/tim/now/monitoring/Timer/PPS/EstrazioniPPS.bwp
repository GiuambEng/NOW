                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="1607cfe4-fbde-43b4-b307-751fc1f153d6">
                <bpws:targets>
                    <bpws:target linkName="NoExtractionToExit"/>
                    <bpws:target linkName="IterateToExit"/>
                </bpws:targets>
            </bpws:exit>
