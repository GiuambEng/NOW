                                    <bpws:target linkName="CallProcedureToGroupEnd"/>
                                    <bpws:target linkName="CheckJobAttiviToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.alignment.sharedlibrary.DataEstrazioni&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CallProcedure-input&quot; match=&quot;/&quot;>&lt;tns:InputCallProcedurePPS>&lt;xsl:if test=&quot;$currentElement/ns:DESCR_PPS&quot;>&lt;tns:DESCR_PPS>&lt;xsl:value-of select=&quot;$currentElement/ns:DESCR_PPS&quot;/>&lt;/tns:DESCR_PPS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:ID_PPS&quot;>&lt;tns:ID_PPS>&lt;xsl:value-of select=&quot;$currentElement/ns:ID_PPS&quot;/>&lt;/tns:ID_PPS>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATAESECUZIONE&quot;>&lt;tns:DATAESECUZIONE>&lt;xsl:value-of select=&quot;$currentElement/ns:DATAESECUZIONE&quot;/>&lt;/tns:DATAESECUZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATA_INIZIO&quot;>&lt;tns:DATAINIZIO>&lt;xsl:value-of select=&quot;$currentElement/ns:DATA_INIZIO&quot;/>&lt;/tns:DATAINIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ns:DATA_FINE&quot;>&lt;tns:DATAFINE>&lt;xsl:value-of select=&quot;$currentElement/ns:DATA_FINE&quot;/>&lt;/tns:DATAFINE>&lt;/xsl:if>&lt;/tns:InputCallProcedurePPS>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CallProcedure-input"
                                    name="CallProcedure"
                                    tibex:xpdlId="6ce2fb29-cf85-4cd3-b8eb-d58d76efd27e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckJobAttiviToCallProcedure"/>
