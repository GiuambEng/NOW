            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="PrecondizioneDRO-input"
                    name="PrecondizioneDRO"
                    outputVariable="PrecondizioneDRO"
                    tibex:xpdlId="31f613f0-a52c-40ea-b530-2d791d12cef3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToJDBCCallProcedure2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PrecondizioneDROToProcedureDRO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS='C19M03F01'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS='C19M03F01']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioneDROToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioneDROToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($PrecondizioneDRO/Record[STATUS='LOADING'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($PrecondizioneDRO/Record[STATUS='LOADING'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioneDROToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS=('C19M03F051', 'C19M03F052') and $PrecondizioneDRO/Record[1]/TRACCIAMENTO>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS=('C19M03F051', 'C19M03F052') and $PrecondizioneDRO/Record[1]/TRACCIAMENTO>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioneDROToProcedureIncrDecrRD">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioneDRO/Record[1]/DETT > 0  and $Start/ns4:ID_PPS='C19M03F08' and $PrecondizioneDRO/Record[1]/TRACCIAMENTO>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioneDRO/Record[1]/DETT > 0  and $Start/ns4:ID_PPS='C19M03F08' and $PrecondizioneDRO/Record[1]/TRACCIAMENTO>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioneDROToJDBCCallProcedure">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS='C19M03F03'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioneDRO/Record[1]/DETT > 0 and count($PrecondizioneDRO/Record[STATUS='OK'])>0 and $Start/ns4:ID_PPS='C19M03F03']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+31f613f0-a52c-40ea-b530-2d791d12cef3+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;PrecondizioneDRO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATUS, (SELECT COUNT(1) FROM PPS_TEMPI_ATTRV_DETT WHERE ROWNUM &lt;= 1) DETT, (SELECT COUNT(1) FROM RICH_ORDN_COMUNIC_TRACC WHERE ROWNUM &lt;= 1)TRACCIAMENTO&#xd;&#xa;  FROM STATO_PPS &#xd;&#xa;  WHERE TRUNC(CREATED)=TRUNC(SYSDATE)&#xd;&#xa;    AND FLUSSO = 'C19M04F01'&#xd;&#xa;    ORDER BY CREATED DESC"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="STATUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DETT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TRACCIAMENTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsStatoPPSDRO-input"
                    name="InsStatoPPSDRO"
                    tibex:xpdlId="b29b81a0-89dc-4c9e-a540-63aca617df17"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioneDROToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsStatoPPSDROToUpdateFlag"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioneDRO&quot;/>&lt;xsl:template name=&quot;InsStatoPPSDRO-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:ID_PPS=('C19M03F01', 'C19M03F03')&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (count($PrecondizioneDRO/Record[STATUS='OK'] )>0  and $PrecondizioneDRO/Record[1]/DETT=0)  then  &amp;quot;** FLUSSO NON AVVIATO -  MANCATO POPOLAMENTO DI ENTITA NECESSARIA , PPS TEMPI DI ATTRAVERSAMENTO DETTAGLIO&amp;quot; else if (count($PrecondizioneDRO/Record[STATUS='OK'] )=0) then ' FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M04F01 NON AVVIATO O IN KO ' else 'ERRORE'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (count($PrecondizioneDRO/Record[STATUS='OK'] )>0  and ($PrecondizioneDRO/Record[1]/TRACCIAMENTO=0 or $PrecondizioneDRO/Record[1]/DETT=0))  then concat( &amp;quot;** FLUSSO NON AVVIATO -  MANCATO POPOLAMENTO DI ENTITA NECESSARIA , Numero Record PPS TEMPI DI ATTRAVERSAMENTO DETTAGLIO= &amp;quot;,  xsd:string($PrecondizioneDRO/Record[1]/DETT) , &amp;quot; Numero Record RICH_ORD_COMUNIC_TRACC= &amp;quot;,   xsd:string($PrecondizioneDRO/Record[1]/TRACCIAMENTO))  else if (count($PrecondizioneDRO/Record[STATUS='OK'] )=0) then ' FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M04F01 NON AVVIATO O IN KO ' else 'ERRORE'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="db14382a-9ec1-4301-a244-ab8e9475577a">
                <bpws:targets>
                    <bpws:target linkName="PrecondizioneDROToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToProcedureRimRegolatorio">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns4:ID_PPS='C19M03F052'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns4:ID_PPS='C19M03F052']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToProcedureRimXDSL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns4:ID_PPS='C19M03F051'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns4:ID_PPS='C19M03F051']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Waiting_Load-input"
                    name="Waiting_Load"
                    tibex:xpdlId="59eab426-dc65-4870-a29c-eae14df4bd3f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioneDROToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Waiting_LoadToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;Waiting_Load-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'MonitoraggioRimodulazioni'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'***IN ATTESA DEL TERMINE DEL CARICAMENTO REPORT C19M04F01  ***'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RimodulazioneDAC-input"
                    name="RimodulazioneDAC"
                    outputVariable="RimodulazioneDAC"
                    tibex:xpdlId="7facd877-5616-4cd4-a7a8-44f9d2c302fa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioneDROToJDBCCallProcedure"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCCallProcedureToLogProcedure2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7facd877-5616-4cd4-a7a8-44f9d2c302fa+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;RimodulazioneDAC-input&quot; match=&quot;/&quot;>&lt;tns:inputs>&lt;inputSet>&lt;PROCEDURE_NAME>&lt;xsl:value-of select=&quot;'PKG_MONITORAGGIO_RIMODULAZIONI.RUN_REPORT_SOGLIA_RIMOD_DAC'&quot;/>&lt;/PROCEDURE_NAME>&lt;DATAINPUT xsi:nil=&quot;true&quot;/>&lt;/inputSet>&lt;/tns:inputs>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCCallProcedure"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCCallProcedureActivity"/>
                                    <value catalogOrPackage="PKG_JOBS"
                                    procedureOrFunctionName="CREATE_JOB(5)"
                                    sharedResourceProperty="jdbcProperty"
                                    timeout="10" xsi:type="jdbcPalette:JDBCCallProcedureActivity">
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="PROCEDURE_NAME" ProcedureParamterType="1"/>
                                    <preparedParamters DataType="12"
                                    DataTypeDisplayValue="VARCHAR2"
                                    ParameterName="DATAINPUT" ProcedureParamterType="1"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
