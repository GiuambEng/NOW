                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+efbd13d1-8a75-4f27-a1d4-2d9dd3c4e73e+input"
