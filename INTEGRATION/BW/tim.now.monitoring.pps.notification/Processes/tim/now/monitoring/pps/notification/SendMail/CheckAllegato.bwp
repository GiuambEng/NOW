                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AccumulateAllegato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;WriteFile&quot;/>&lt;xsl:param name=&quot;WriteFileCompressed&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:OUTPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($WriteFileCompressed/fileInfo/fileName)>0&quot;>&lt;tns:Accumulate>&lt;tns:fullname>&lt;xsl:value-of select=&quot;$WriteFileCompressed/fileInfo/fullName&quot;/>&lt;/tns:fullname>&lt;tns:filename>&lt;xsl:value-of select=&quot;$WriteFileCompressed/fileInfo/fileName&quot;/>&lt;/tns:filename>&lt;/tns:Accumulate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Accumulate>&lt;tns:fullname>&lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fullName&quot;/>&lt;/tns:fullname>&lt;tns:filename>&lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fileName&quot;/>&lt;/tns:filename>&lt;/tns:Accumulate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:OUTPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
