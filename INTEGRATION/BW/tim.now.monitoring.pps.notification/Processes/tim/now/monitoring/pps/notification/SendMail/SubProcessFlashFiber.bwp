                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RigheFile&quot; xmlns:tns1=&quot;http://www.example.org/RigheFileFlashFiber&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;EstrazioniFlashFiber&quot;/>&lt;xsl:template name=&quot;File-input&quot; match=&quot;/&quot;>&lt;tns1:RigheFileFlashFiber>&lt;xsl:for-each select=&quot;$EstrazioniFlashFiber/Record&quot;>&lt;tns1:RigheFileFlashFiber_input>&lt;xsl:if test=&quot;IDRICHIESTAOLO&quot;>&lt;tns1:idrichiestaolo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns1:idrichiestaolo>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSANOW&quot;>&lt;tns1:idrisorsanow>&lt;xsl:value-of select=&quot;IDRISORSANOW&quot;/>&lt;/tns1:idrisorsanow>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns1:idrisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns1:idrisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;STATORICHIESTAOLO&quot;>&lt;tns1:statorichiestaolo>&lt;xsl:value-of select=&quot;STATORICHIESTAOLO&quot;/>&lt;/tns1:statorichiestaolo>&lt;/xsl:if>&lt;xsl:if test=&quot;DRO&quot;>&lt;tns1:dro>&lt;xsl:value-of select=&quot;DRO&quot;/>&lt;/tns1:dro>&lt;/xsl:if>&lt;xsl:if test=&quot;DES&quot;>&lt;tns1:des>&lt;xsl:value-of select=&quot;DES&quot;/>&lt;/tns1:des>&lt;/xsl:if>&lt;xsl:if test=&quot;LAVORAZIONE&quot;>&lt;tns1:lavorazione>&lt;xsl:value-of select=&quot;LAVORAZIONE&quot;/>&lt;/tns1:lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;COD_ORDINE_FLASHFIBER&quot;>&lt;tns1:cod_ordine_flashfiber>&lt;xsl:value-of select=&quot;COD_ORDINE_FLASHFIBER&quot;/>&lt;/tns1:cod_ordine_flashfiber>&lt;/xsl:if>&lt;/tns1:RigheFileFlashFiber_input>&lt;/xsl:for-each>&lt;/tns1:RigheFileFlashFiber>&lt;/xsl:template>&lt;/xsl:stylesheet>"
