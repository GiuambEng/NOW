ilename) &quot;/>&lt;/content-disposition>&lt;content-type>&lt;xsl:value-of select=&quot;&amp;quot;text/plain&amp;quot;&quot;/>&lt;/content-type>&lt;/mimeHeaders>&lt;fileName>&lt;xsl:value-of select=&quot;tns2:fullname&quot;/>&lt;/fileName>&lt;/mimePart>&lt;/xsl:for-each>&lt;/tns3:mimeEnvelopeElement>&lt;/tns:mailActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
