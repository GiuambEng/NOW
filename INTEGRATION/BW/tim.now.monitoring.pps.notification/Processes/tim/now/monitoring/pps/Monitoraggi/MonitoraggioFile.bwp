    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/InputCallProcedurePPS"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/InsStatoPPS"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="tns:InputCallProcedurePPS" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLogger/Application" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLogger/LoggerNameCreazione" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/ConfigurationLogger/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogStart-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogWaiting-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogCallProcedure-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:inputs"
            name="PPSMonitoraggioFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet"
            name="PPSMonitoraggioFile" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:jdbcQueryActivityInput"
            name="CheckPropedeuticita-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:resultSet"
            name="CheckPropedeuticita" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:inputs"
            name="PPSMonitFileAggregato-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:resultSet"
            name="PPSMonitFileAggregato" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:InputData" name="InsKOStatus-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:SleepInputSchema" name="Sleep-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:jdbcUpdateActivityInput"
            name="JDBCUpdate-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:jdbcUpdateActivityOutput"
            name="JDBCUpdate" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
