                <tibex:activityExtension
                    inputVariable="PrecondizioniGiornalieri-input"
                    name="PrecondizioniGiornalieri"
                    outputVariable="PrecondizioniGiornalieri"
                    tibex:xpdlId="83024ef7-b49f-49eb-ac6b-afd486795ab0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SleepToPrecondizioniGiornalieri"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToProcedure_Giornalieri">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioniGiornalieri/Record[1]/RICH >0 and $PrecondizioniGiornalieri/Record[1]/SOGLIA>0 and $PrecondizioniGiornalieri/Record[1]/STATUS='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioniGiornalieri/Record[1]/RICH >0 and $PrecondizioniGiornalieri/Record[1]/SOGLIA>0 and $PrecondizioniGiornalieri/Record[1]/STATUS='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniGiornalieriToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniGiornalieriToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioniGiornalieri/Record[1]/STATUS='LOADING'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioniGiornalieri/Record[1]/STATUS='LOADING']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+83024ef7-b49f-49eb-ac6b-afd486795ab0+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;PrecondizioniGiornalieri-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATUS, (SELECT COUNT(1) FROM PPS_RICH_OLO_SCARTATA WHERE ROWNUM &lt;= 1) RICH,(SELECT COUNT(1) FROM PPS_SOGLIA_ANALISI WHERE ROWNUM &lt;= 1) SOGLIA&#xa;FROM STATO_PPS &#xa;WHERE FLUSSO = 'C19M07F05'&#xa; AND TRUNC(CREATED) = TRUNC(SYSDATE)&#xa; ORDER BY CREATED DESC &#xa;&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="STATUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="RICH"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="SOGLIA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
