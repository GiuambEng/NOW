                        <bpws:source linkName="Ins_StatoPPSToUpdateFlagY"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioniGiornalieri&quot;/>&lt;xsl:template name=&quot;Ins_StatoPPS-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if ($PrecondizioniGiornalieri/Record[1]/STATUS='OK' and ($PrecondizioniGiornalieri/Record[1]/RICH=0 or $PrecondizioniGiornalieri/Record[1]/SOGLIA=0)) then  concat(&amp;quot;** FLUSSO NON AVVIATO -  MANCATO POPOLAMENTO DI ENTITA NECESSARIE -  Numero Record Presenti in PPS RICHIESTA OLO SCARTATA= &amp;quot;, xsd:string($PrecondizioniGiornalieri/Record[1]/RICH), &amp;quot;Numero Record Presenti In PPS SOGLIA ANALISI  = &amp;quot;,xsd:string($PrecondizioniGiornalieri/Record[1]/SOGLIA), &amp;quot;**&amp;quot;  ) else if ($PrecondizioniGiornalieri/Record[1]/STATUS='KO') then ' FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M07F05 IN KO NELL ULTIMA ESECUZIONE ' else 'FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M07F05 NON ESEGUITO PER L ULTIMA SCHEDULAZIONE'&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
