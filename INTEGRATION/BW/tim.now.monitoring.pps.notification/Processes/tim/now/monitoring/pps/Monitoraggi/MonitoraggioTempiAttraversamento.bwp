                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.example.org/InputCallProcedurePPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogeLevel&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Sub_CallProcedure'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**END AVVIO REPORT - PROCEDURA CHIAMATA CORRETTAMENTE   ', $Start/tns1:ID_PPS, &amp;quot;  &amp;quot;, $Start/tns1:DESCR_PPS, &amp;quot; ***&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogeLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="PrecondizioniDettaglio-input"
                    name="PrecondizioniDettaglio"
                    outputVariable="PrecondizioniDettaglio"
                    tibex:xpdlId="ddceaab1-54e9-48a7-91a2-ae58bf2d3a0a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToPrecondizioniDettaglio1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAttraversamentoDettaglio">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioniDettaglio/Record[1]/CHIUSI > 0 and $PrecondizioniDettaglio/Record[1]/GIACENZE > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioniDettaglio/Record[1]/CHIUSI > 0 and $PrecondizioniDettaglio/Record[1]/GIACENZE > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniDettaglioToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ddceaab1-54e9-48a7-91a2-ae58bf2d3a0a+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;PrecondizioniDettaglio-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT (SELECT COUNT(1) FROM PPS_ORDN_CHIUSI WHERE ROWNUM &lt;= 1) CHIUSI,&#xa;&#x9;&#x9;(SELECT COUNT(1) FROM PPS_GCZ_NOW WHERE ROWNUM &lt;= 1) GIACENZE&#xa;FROM dual"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CHIUSI"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="GIACENZE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsStatoPPS-input"
                    name="InsStatoPPS"
                    tibex:xpdlId="208bfce5-b3b0-4344-bb9d-1a77d377fa11"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioniDettaglioToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsStatoPPSToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioniDettaglio&quot;/>&lt;xsl:template name=&quot;InsStatoPPS-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat(&amp;quot;** FLUSSO NON AVVIATO -  MANCATO POPOLAMENTO DI ENTITA NECESSARIE -  Numero Record Presenti in PPS ORDINI CHIUSI= &amp;quot;, xsd:string($PrecondizioniDettaglio/Record[1]/CHIUSI), &amp;quot;Numero Record Presenti In PPS ORDINI GIACENZA= &amp;quot;,xsd:string($PrecondizioniDettaglio/Record[1]/GIACENZE), &amp;quot;**&amp;quot;  )&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="PrecondizioniAggregatoEGUI-input"
                    name="PrecondizioniAggregatoEGUI"
                    outputVariable="PrecondizioniAggregatoEGUI"
                    tibex:xpdlId="7b43c0de-58fb-4cd9-918b-7d8ba64176ca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SleepToPrecondizioniAggregato"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAttraversamentoAggregato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($PrecondizioniAggregatoEGUI/Record[STATUS = &quot;OK&quot; and FLUSSO = &quot;C19M04F01&quot;]) > 0 and $PrecondizioniAggregatoEGUI/Record[1]/DETT > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($PrecondizioniAggregatoEGUI/Record[STATUS = "OK" and FLUSSO = "C19M04F01"]) > 0 and $PrecondizioniAggregatoEGUI/Record[1]/DETT > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniAggregatoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($PrecondizioniAggregatoEGUI/Record[STATUS = &quot;LOADING&quot;]) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($PrecondizioniAggregatoEGUI/Record[STATUS = "LOADING"]) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniAggregatoToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7b43c0de-58fb-4cd9-918b-7d8ba64176ca+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;PrecondizioniAggregatoEGUI-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATUS, FLUSSO ,(SELECT COUNT(1) FROM PPS_TEMPI_ATTRV_DETT WHERE ROWNUM &lt;= 1) DETT&#xa;  FROM STATO_PPS &#xa;  WHERE TRUNC(CREATED)=TRUNC(SYSDATE)&#xa;    AND FLUSSO = 'C19M04F01'&#xa;    ORDER BY CREATED DESC&#xa;    "
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="STATUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DETT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogLoad-input"
                    name="LogLoad"
                    tibex:xpdlId="e822f3c8-0a04-4e7b-8104-ff805e675f96"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioniAggregatoToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogLoadToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogeLevel&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'MonitoraggioTempiAttraversamento'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'***IN ATTESA DEL TERMINE DEL CARICAMENTO REPORT  C19M04F01***'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogeLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsertStatoPPS-input"
                    name="InsertStatoPPS"
                    tibex:xpdlId="31d8edde-8d46-4bd4-bd02-fe1f8877bce0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioniAggregatoToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertStatoPPSToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:tns1=&quot;http://www.example.org/InputCallProcedurePPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioniAggregatoEGUI&quot;/>&lt;xsl:template name=&quot;InsertStatoPPS-input&quot; match=&quot;/&quot;>&lt;tns:InputData>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns1:ID_PPS&quot;/>&lt;/tns:FLUSSO>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (count($PrecondizioniAggregatoEGUI/Record[STATUS = &amp;quot;OK&amp;quot; and FLUSSO = &amp;quot;C19M04F01&amp;quot;]) > 0 and $PrecondizioniAggregatoEGUI/Record[1]/DETT = 0) then &amp;quot;AVVIATO FLUSSO PROPEDEUTICO 'C19M04F01' MA NON POPOLATA L'ENTITA PPS TEMPI DI ATTRAVERSAMENTO DETTAGLIO&amp;quot; else if (count($PrecondizioniAggregatoEGUI/Record[STATUS = &amp;quot;KO&amp;quot; and FLUSSO = &amp;quot;C19M04F01&amp;quot;]) > 0) then &amp;quot;FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO 'C19M04F01'  IN STATO KO&amp;quot; else &amp;quot;FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO 'C19M04F01' NON AVVIATO NELLA DATA CORRENTE&amp;quot;&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/tns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Sleep-input"
                    name="Sleep"
                    tibex:xpdlId="70bb5b72-47ad-44c8-8870-4f5df42ff069" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAttraversamentoAggregato"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SleepToPrecondizioniAggregato"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;20000&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.sleep"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
