            name="PrecondizioniDettaglio-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns11:resultSet"
            name="PrecondizioniDettaglio" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:InputData" name="InsStatoPPS-input" sca-bpel:internal="true"/>
