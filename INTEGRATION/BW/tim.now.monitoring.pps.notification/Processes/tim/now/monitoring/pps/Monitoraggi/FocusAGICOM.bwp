                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:tns1=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizORDINI_GIAC&quot;/>&lt;xsl:template name=&quot;InsertSTATOPPS-input&quot; match=&quot;/&quot;>&lt;tns:InputData>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns1:ID_PPS&quot;/>&lt;/tns:FLUSSO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ID_PPS='C19M10F01'&quot;>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat(&amp;quot;** POPOLAMENTO PPS_ORDINI_GIACENZE NON AVVIATO IN QUANTO VUOTE  ENTITA NECESSARIE -  Numero Record Presenti in PPS_ORDINI_CHIUSI= &amp;quot;, xsd:string($PrecondizORDINI_GIAC/Record[1]/CHIUSI), &amp;quot; - Numero Record Presenti in PPS_GIACENZA_NOW= &amp;quot;, xsd:string($PrecondizORDINI_GIAC/Record[1]/GIACENZE), &amp;quot; - Numero Record Presenti in PPS_AGCOM_CONF= &amp;quot;, xsd:string($PrecondizORDINI_GIAC/Record[1]/CONF), &amp;quot;  **&amp;quot;)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;(&amp;quot;**NON  PRESENTI O IN STATO KO I REPORT PROPEDEUTICI C19M10F01 E C19M10F02 IN DATA CORRENTE **&amp;quot;)&quot;/>&lt;/tns:DESCR_ERRORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsKOStatoPPS-input"
                    name="InsKOStatoPPS"
                    tibex:xpdlId="82e83cbc-ba5f-4790-bf6e-eb72c1f57242"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrecondizioniAGCOMAGGRToInsKOStatoPPS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsKOStatoPPSToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioniAGCOMAGGR&quot;/>&lt;xsl:template name=&quot;InsKOStatoPPS-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (count($PrecondizioniAGCOMAGGR/Record[STATUS = &amp;quot;OK&amp;quot;]) > 0 and $PrecondizioniAGCOMAGGR/Record[1]/GIAC = 0) then &amp;quot;AVVIATO FLUSSO PROPEDEUTICO 'C19M10F01' MA NON POPOLATA L'ENTITA PPS ORDINI GIACENZA IN DATA CORRENTE&amp;quot; else if (count($PrecondizioniAGCOMAGGR/Record[STATUS = &amp;quot;OK&amp;quot;]) = 0) then &amp;quot;NON AVVIATO FLUSSO PROPEDEUTICO 'C19M10F01' O IN STATO KO' IN DATA CORRENTE &amp;quot; else &amp;quot;errore&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
