                                <tibex:expression
                                    expression="$PrecondizORDINI_GIAC/Record[1]/CHIUSI > 0 and $PrecondizORDINI_GIAC/Record[1]/GIACENZE > 0 and $PrecondizORDINI_GIAC/Record[1]/CONF > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizORDINI_GIAC/Record[1]/CHIUSI > 0 and $PrecondizORDINI_GIAC/Record[1]/GIACENZE > 0 and $PrecondizORDINI_GIAC/Record[1]/CONF > 0]]></bpws:transitionCondition>
