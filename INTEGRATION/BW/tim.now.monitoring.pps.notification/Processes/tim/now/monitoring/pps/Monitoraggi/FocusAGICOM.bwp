                    outputVariable="PrecondizORDINI_GIAC"
                    tibex:xpdlId="d53962fa-b254-4e5b-bdf8-15d6c69bfac3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToPrecondizioni"/>
