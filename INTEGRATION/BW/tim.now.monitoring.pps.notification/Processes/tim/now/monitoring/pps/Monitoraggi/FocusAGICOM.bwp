                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CONF"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
