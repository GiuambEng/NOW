                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT (SELECT COUNT(1) FROM PPS_ORDN_CHIUSI WHERE ROWNUM &lt;= 1) CHIUSI, &#xa;       (SELECT COUNT(1) FROM PPS_GCZ_NOW WHERE ROWNUM &lt;= 1) GIACENZE, &#xa;       (SELECT COUNT(1) FROM PPS_AGCOM_CONF WHERE ROWNUM &lt;= 1) CONF&#xa;FROM DUAL"
