                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SendMail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:param name=&quot;From&quot;/>&lt;xsl:param name=&quot;Username&quot;/>&lt;xsl:param name=&quot;Password&quot;/>&lt;xsl:template name=&quot;SendMail-input&quot; match=&quot;/&quot;>&lt;tns:InputEmail>&lt;tns:ID_REPORT>&lt;xsl:value-of select=&quot;xsd:int($currentElement/ID_REPORT)&quot;/>&lt;/tns:ID_REPORT>&lt;tns:ID_MAIL_CON_ALLEGATO>&lt;xsl:value-of select=&quot;xsd:int($currentElement/ID_EMAIL)&quot;/>&lt;/tns:ID_MAIL_CON_ALLEGATO>&lt;tns:FROM>&lt;xsl:value-of select=&quot;$From&quot;/>&lt;/tns:FROM>&lt;tns:TO>&lt;xsl:value-of select=&quot;$currentElement/DESTINATARIO_A&quot;/>&lt;/tns:TO>&lt;xsl:if test=&quot;$currentElement/DESTINATARIO_CC&quot;>&lt;tns:CC>&lt;xsl:value-of select=&quot;$currentElement/DESTINATARIO_CC&quot;/>&lt;/tns:CC>&lt;/xsl:if>&lt;tns:USERNAME>&lt;xsl:value-of select=&quot;$Username&quot;/>&lt;/tns:USERNAME>&lt;tns:PASSWORD>&lt;xsl:value-of select=&quot;$Password&quot;/>&lt;/tns:PASSWORD>&lt;xsl:if test=&quot;$currentElement/OGGETTO&quot;>&lt;tns:SUBJECT>&lt;xsl:value-of select=&quot;$currentElement/OGGETTO&quot;/>&lt;/tns:SUBJECT>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/CORPO_EMAIL&quot;>&lt;tns:CONTENUTO_EMAIL>&lt;xsl:value-of select=&quot;$currentElement/CORPO_EMAIL&quot;/>&lt;/tns:CONTENUTO_EMAIL>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/ALLEGATO&quot;>&lt;tns:ALLEGATO>&lt;xsl:value-of select=&quot;$currentElement/ALLEGATO&quot;/>&lt;/tns:ALLEGATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/NOME_ALLEGATO&quot;>&lt;tns:NOME_ALLEGATO>&lt;xsl:value-of select=&quot;$currentElement/NOME_ALLEGATO&quot;/>&lt;/tns:NOME_ALLEGATO>&lt;/xsl:if>&lt;/tns: