                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SendMail&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;From&quot;/>&lt;xsl:param name=&quot;Username&quot;/>&lt;xsl:param name=&quot;Password&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;InvioMail-input&quot; match=&quot;/&quot;>&lt;tns:InputEmail>&lt;tns:ID_MAIL>&lt;xsl:value-of select=&quot;xsd:int($currentElement/ID_PPS_MAIL_REPORT)&quot;/>&lt;/tns:ID_MAIL>&lt;tns:ID_REPORT>&lt;xsl:value-of select=&quot;xsd:int($currentElement/ID_REPORT)&quot;/>&lt;/tns:ID_REPORT>&lt;tns:FROM>&lt;xsl:value-of select=&quot;$From&quot;/>&lt;/tns:FROM>&lt;xsl:if test=&quot;$currentElement/DESTNRIO_EMAIL_A&quot;>&lt;tns:TO>&lt;xsl:value-of select=&quot;$currentElement/DESTNRIO_EMAIL_A&quot;/>&lt;/tns:TO>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/DESTNRIO_EMAIL_CC&quot;>&lt;tns:CC>&lt;xsl:value-of select=&quot;$currentElement/DESTNRIO_EMAIL_CC&quot;/>&lt;/tns:CC>&lt;/xsl:if>&lt;tns:USERNAME>&lt;xsl:value-of select=&quot;$Username&quot;/>&lt;/tns:USERNAME>&lt;tns:PASSWORD>&lt;xsl:value-of select=&quot;$Password&quot;/>&lt;/tns:PASSWORD>&lt;xsl:if test=&quot;$currentElement/OGGETTO&quot;>&lt;tns:SUBJECT>&lt;xsl:value-of select=&quot;$currentElement/OGGETTO&quot;/>&lt;/tns:SUBJECT>&lt;/xsl:if>&lt;tns:CONTENUTO_EMAIL>&lt;xsl:value-of select=&quot;$currentElement/CONTENUTO_EMAIL&quot;/>&lt;/tns:CONTENUTO_EMAIL>&lt;/tns:InputEmail>&lt;/xsl:template>&lt;/xsl:stylesheet>"
