                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2ba12d27-7d5d-46a5-b2ef-1d22e6e0620e+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT c.ID_REPORT,&#xd;&#xa;  c.flusso,&#xd;&#xa;  mail.CONTENUTO_EMAIL,&#xd;&#xa;  mail.DESTNRIO_EMAIL_A,&#xd;&#xa;  mail.DESTNRIO_EMAIL_CC,&#xd;&#xa;  mail.ID_PPS_MAIL_REPORT,&#xd;&#xa;  mail.STATO,&#xd;&#xa;  mail.OGGETTO,&#xd;&#xa;  mail.TIMSTP_CREAZIONE,&#xd;&#xa;  d.MAX_RETRY,&#xd;&#xa;  c.NUM_RETRY&#xd;&#xa;FROM  STATO_PPS c&#xd;&#xa;  JOIN CFG_START_PPS_REPORT D ON c.FLUSSO = D.ID_PPS&#xd;&#xa;  JOIN PPS_ASSOCIATIVA_MAIL_REPORT AMR ON AMR.ID_PPS_REPORT = C.ID_REPORT&#xd;&#xa;  JOIN PPS_MAIL_REPORT MAIL ON MAIL.ID_PPS_MAIL_REPORT = AMR.ID_PPS_MAIL_REPORT&#xd;&#xa;WHERE c.status     ='OK'&#xd;&#xa;AND ( mail.stato ='DA INVIARE'&#xd;&#xa;      AND c.NUM_RETRY &lt; d.MAX_RETRY&#xd;&#xa;       OR d.MAX_RETRY  IS NULL OR c.NUM_RETRY is null)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_REPORT"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLUSSO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_EMAIL"
                                    dataType="2005" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="DESTNRIO_EMAIL_A"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESTNRIO_EMAIL_CC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_PPS_MAIL_REPORT"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="OGGETTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="MAX_RETRY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUM_RETRY"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
