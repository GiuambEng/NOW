                                    sqlStatement="UPDATE STATO_PPS SET&#xa;  num_retry =  nvl(num_retry, 0) + 1, STATUS_MAIL='DA INVIARE',&#xa;  LAST_UPD= SYSDATE&#xa;  WHERE ID_REPORT=?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

