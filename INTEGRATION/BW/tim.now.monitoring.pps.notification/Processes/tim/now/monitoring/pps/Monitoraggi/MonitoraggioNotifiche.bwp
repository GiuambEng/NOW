                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="58edaf72-4424-44e4-afe9-3642e5300570"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartToNotificheVersoOLO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:ID_PPS='C19M01F04'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:ID_PPS='C19M01F04']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:ID_PPS=('C19M01F066','C19M01F065','C19M01F067','C19M01F061','C19M01F062','C19M01F064','C19M01F063')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:ID_PPS=('C19M01F066','C19M01F065','C19M01F067','C19M01F061','C19M01F062','C19M01F064','C19M01F063')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
