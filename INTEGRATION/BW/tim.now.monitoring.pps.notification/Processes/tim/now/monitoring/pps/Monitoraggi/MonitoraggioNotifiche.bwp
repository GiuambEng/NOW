            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="PrecondizioniNotificheVersoOLO-input"
                    name="PrecondizioniNotificheVersoOLO"
                    outputVariable="PrecondizioniNotificheVersoOLO"
                    tibex:xpdlId="9b8a74a3-808b-4aad-9832-9ea68494f0ca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToNotificheVersoOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToNotificheVersoOLO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$PrecondizioniNotificheVersoOLO/Record[1]/TRACCIAMENTO>0 and $PrecondizioniNotificheVersoOLO/Record[1]/NOTIFICA>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$PrecondizioniNotificheVersoOLO/Record[1]/TRACCIAMENTO>0 and $PrecondizioniNotificheVersoOLO/Record[1]/NOTIFICA>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="PrecondizioniNotificheVersoOLOToInsStatoPPS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9b8a74a3-808b-4aad-9832-9ea68494f0ca+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT (SELECT COUNT(1) FROM RICH_ORDN_COMUNIC_TRACC WHERE ROWNUM &lt;= 1)TRACCIAMENTO , &#xa;       (SELECT COUNT(1) FROM RICH_ORDN_COMUNIC_NOTF WHERE ROWNUM &lt;= 1) NOTIFICA&#xa;FROM DUAL&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="TRACCIAMENTO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOTIFICA"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsStatoPPS-input"
                    name="InsStatoPPS"
                    tibex:xpdlId="eb25cc90-cf7e-492c-9e5d-a3fa9d3d3e8a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
