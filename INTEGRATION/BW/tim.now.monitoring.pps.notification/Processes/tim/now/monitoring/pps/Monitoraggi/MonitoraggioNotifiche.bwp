                        <bpws:source linkName="InsStatoPPSToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PrecondizioniNotificheVersoOLO&quot;/>&lt;xsl:template name=&quot;InsStatoPPS-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat(&amp;quot;** FLUSSO NON AVVIATO - MANCATO POPOLAMENTO DI ENTITA NECESSARIE -  Numero Record Presenti in RICH_ORDN_COMUNIC_TRACC= &amp;quot;, xsd:string($PrecondizioniNotificheVersoOLO/Record[1]/TRACCIAMENTO), &amp;quot;Numero Record Presenti In RICH_ORDN_COMUNIC_NOTF= &amp;quot;,xsd:string($PrecondizioniNotificheVersoOLO/Record[1]/NOTIFICA), &amp;quot;**&amp;quot;  )&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CheckPropedeuticità-input"
                    name="CheckPropedeuticità"
                    outputVariable="CheckPropedeuticità"
                    tibex:xpdlId="63361e08-6280-4ecb-b35b-40a86c0072c7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SleepToCheckPropedeuticità"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckPropedeuticitàToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckPropedeuticità/Record[1]/STATUS='LOADING'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckPropedeuticità/Record[1]/STATUS='LOADING']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckPropedeuticitàToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckPropedeuticitàToNotificheOloAggregati">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckPropedeuticità/Record[1]/STATUS='OK' and $CheckPropedeuticità/Record[1]/NOTIF>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckPropedeuticità/Record[1]/STATUS='OK' and $CheckPropedeuticità/Record[1]/NOTIF>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+63361e08-6280-4ecb-b35b-40a86c0072c7+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;CheckPropedeuticità-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATUS , (select count (1) from PPS_NOTIFICHE_OLO WHERE ROWNUM &lt;= 1) NOTIF&#xd;&#xa;FROM STATO_PPS &#xd;&#xa;WHERE FLUSSO = 'C19M01F04'&#xd;&#xa;AND TRUNC(CREATED) = TRUNC(SYSDATE)&#xd;&#xa;ORDER BY CREATED DESC"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="STATUS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOTIF"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogWaiting-input"
                    name="LogWaiting"
                    tibex:xpdlId="4e9fdfcc-06b5-4e0b-8dc0-8cd1b016b9a3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckPropedeuticitàToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogWaitingToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:template name=&quot;LogWaiting-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'MonitoraggioNotifiche'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'***IN ATTESA DEL TERMINE DEL CARICAMENTO REPORT C19M01F04  ***'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="InsStato_PPS-input"
                    name="InsStato_PPS"
                    tibex:xpdlId="16470c66-60df-4256-a8b0-ca1f8fe448a3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckPropedeuticitàToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsStato_PPSToUpdateFlagY"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:tns1=&quot;http://www.example.org/InsStatoPPS&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CheckPropedeuticità&quot;/>&lt;xsl:template name=&quot;InsStato_PPS-input&quot; match=&quot;/&quot;>&lt;tns1:InputData>&lt;tns1:FLUSSO>&lt;xsl:value-of select=&quot;$Start/tns:ID_PPS&quot;/>&lt;/tns1:FLUSSO>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;if (  $CheckPropedeuticità/Record[1]/STATUS='OK' and $CheckPropedeuticità/Record[1]/NOTIF=0  ) then &amp;quot;AVVIATO FLUSSO C19M01F04 MA NON POPOLATA ENTITA  NOTIFICHE OLO&amp;quot; else if ($CheckPropedeuticità/Record[1]/STATUS='KO' ) then &amp;quot;FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M01F04 IN KO NELL ULTIMA ESECUZIONE&amp;quot;  else &amp;quot;FLUSSO NON AVVIATO - FLUSSO PROPEDEUTICO C19M01F04  NON ESEGUITO PER L ULTIMA SCHEDULAZIONE&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/tns1:InputData>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.monitoring.pps.Monitoraggi.Sub_InsStatoPPS" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Sleep-input"
                    name="Sleep"
                    tibex:xpdlId="3b5e0f2b-769c-4d7b-a705-d9a68e3bca83" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SleepToCheckPropedeuticità"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;20000&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.sleep"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateFlagY-input" name="UpdateFlagY"
                    outputVariable="UpdateFlagY"
                    tibex:xpdlId="b9f8d050-2ce9-4737-a15f-5a3581cbf0de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsStato_PPSToUpdateFlagY"/>
                        <bpws:target linkName="NotificheOloAggregatiToUpdateFlagY"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdate1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9f8d050-2ce9-4737-a15f-5a3581cbf0de+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.org/InputCallProcedurePPS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateFlagY-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_PPS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_PPS)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_PPS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PPS>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CFG_START_PPS_REPORT&#xa;  SET FLAG_LETTURA = 'Y', LAST_UPD = SYSDATE&#xa;  WHERE ID_PPS = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_PPS"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
