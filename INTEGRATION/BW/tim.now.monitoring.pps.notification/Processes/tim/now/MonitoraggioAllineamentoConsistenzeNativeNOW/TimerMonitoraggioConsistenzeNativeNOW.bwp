                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE, RUN_ID FROM STATO_PPS&#xa;WHERE FLUSSO='M0xM01F03'&#xa;AND STATUS='OK_INFASAMENTO'"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
