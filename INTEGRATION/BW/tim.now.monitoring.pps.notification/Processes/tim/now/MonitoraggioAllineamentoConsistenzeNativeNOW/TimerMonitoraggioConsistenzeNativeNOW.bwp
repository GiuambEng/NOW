                    <bpws:sources>
                        <bpws:source linkName="FindMonitoraggioToLog_OutpuJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($FindMonitoraggio/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($FindMonitoraggio/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FindMonitoraggioToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
