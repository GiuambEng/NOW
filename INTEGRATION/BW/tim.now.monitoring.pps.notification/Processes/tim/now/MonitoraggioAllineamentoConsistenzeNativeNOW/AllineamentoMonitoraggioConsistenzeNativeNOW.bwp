            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5914ddc5-fc4b-4d7f-b13a-2d843f2b7fd3+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&#xa;    &lt;xsl:param name=&quot;S_id&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;RUN_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($S_id/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/RUN_ID>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCUpdate1-input" name="JDBCUpdate1"
                    outputVariable="JDBCUpdate1"
                    tibex:xpdlId="5914ddc5-fc4b-4d7f-b13a-2d843f2b7fd3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetRToJDBCUpdate1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdate1ToInfasaNativiNOW"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5914ddc5-fc4b-4d7f-b13a-2d843f2b7fd3+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;S_id&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;RUN_ID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($S_id/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/RUN_ID>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_PPS (CREATED, LAST_UPD, FLUSSO, STATUS,&#xa;  RUN_ID, ID_FILE)&#xa;  VALUES (SYSDATE, SYSDATE, 'M0xM01F03', 'AVVIO_INFASAMENTO',&#xa;    ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="RUN_ID"/>
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_Counter-input"
                name="Invoke_Counter" operation="ContaRecord"
                outputVariable="Invoke_Counter" partnerLink="Conta"
                portType="ns34:Conta" tibex:xpdlId="36248fa5-8401-4a24-aaa4-d1b34286472b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/AllineamentoBatch/ContaRecord_http_concrete/" xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:tns1="http://www.example.org/FileTappo" version="2.0"&gt;&lt;xsl:param name="TipoSeparatore"/&gt;&lt;xsl:param name="FindFile"/&gt;&lt;xsl:template name="Invoke_Counter-input" match="/"&gt;&lt;tns:Conta_Request&gt;&lt;part1&gt;&lt;ns:contaRecord_Input&gt;&lt;ns:in&gt;&lt;xsl:value-of select="$FindFile/tns1:FullName"/&gt;&lt;/ns:in&gt;&lt;ns:TipoSeparatore&gt;&lt;xsl:value-of select="$TipoSeparatore"/&gt;&lt;/ns:TipoSeparatore&gt;&lt;/ns:contaRecord_Input&gt;&lt;/part1&gt;&lt;/tns:Conta_Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/AllineamentoBatch/ContaRecord_http_concrete/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TipoSeparatore&quot;/>&#xa;    &lt;xsl:param name=&quot;FindFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_Counter-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:contaRecord_Input>&#xa;            &lt;ns:in>&#xa;                &lt;xsl:value-of select=&quot;$FindFile/tns1:FullName&quot;/>&#xa;            &lt;/ns:in>&#xa;            &lt;ns:TipoSeparatore>&#xa;                &lt;xsl:value-of select=&quot;$TipoSeparatore&quot;/>&#xa;            &lt;/ns:TipoSeparatore>&#xa;        &lt;/ns:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Invoke_InsertProcLogToContaRecord"/>
                </bpws:targets>
                <bpws:sources>
