                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:param name=&quot;Desc_Stato_file&quot;/>&lt;xsl:param name=&quot;Verso_Del_File&quot;/>&lt;xsl:param name=&quot;Id_Tipologia_file&quot;/>&lt;xsl:param name=&quot;Stato_Esec&quot;/>&lt;xsl:param name=&quot;Id_Interfaccia&quot;/>&lt;xsl:param name=&quot;Id_Procso_File&quot;/>&lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Id_Procso_File&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:FileProcessato>&lt;xsl:if test=&quot;$FindFile/tns:LastModified&quot;>&lt;ns:DATA_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:LastModified&quot;/>&lt;/ns:DATA_FILE>&lt;/xsl:if>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;$Desc_Stato_file&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;ns:ID_INTRFC>&lt;xsl:value-of select=&quot;xsd:integer($Id_Interfaccia)&quot;/>&lt;/ns:ID_INTRFC>&lt;ns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Id_Tipologia_file)&quot;/>&lt;/ns:IDTPLG_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/ns:NOME_FILE>&lt;/xsl:if>&lt;ns:TIMSTP_APERTURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_APERTURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;$Verso_Del_File&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;ns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/ns:DATA_ARRIVO>&lt;ns:DIMENSIONE_FILE>&lt;xsl:value-of select=&quot;xsd:integer($FindFile/tns:Size)&quot;/>&lt;/ns:DIMENSIONE_FILE>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;$Stato_Esec&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/ns:EsecuzioneFile>&lt;ns:ContenutoFile>&lt;ns:ID_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:ID_CONTENUTO_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;ns:FullName>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/ns:FullName>&lt;/xsl:if>&lt;/ns:ContenutoFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
