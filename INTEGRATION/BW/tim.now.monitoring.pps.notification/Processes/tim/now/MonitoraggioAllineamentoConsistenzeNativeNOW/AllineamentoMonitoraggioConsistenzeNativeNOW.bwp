                partnerLink="Logger" portType="ns4:ProcessLog" tibex:xpdlId="7d7cb890-6b20-4005-9311-b871d6225aeb">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="Invoke_ProcessLogger"/&gt;
    &lt;xsl:template name="End_Proc-input" match="/"&gt;
        &lt;tns:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:FileProcessato&gt;
                        &lt;ns:DESCR_STATO_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;ERRORE NUMERO RECORD&amp;quot;"/&gt;
                        &lt;/ns:DESCR_STATO_FILE&gt;
                        &lt;ns:ESITO&gt;
                            &lt;xsl:value-of select="'KO'"/&gt;
                        &lt;/ns:ESITO&gt;
                        &lt;ns:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns:ID_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;
                        &lt;/ns:ID_FILE&gt;
                        &lt;ns:TIMSTP_CHIUSURA_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TIMSTP_CHIUSURA_FILE&gt;
                        &lt;ns:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;INPUT&amp;quot;"/&gt;
                        &lt;/ns:VERSO_DEL_FILE&gt;
                    &lt;/ns:FileProcessato&gt;
                    &lt;ns:FileProcessatoInput&gt;
                        &lt;ns:ID_CAUS_SCARTO&gt;
                            &lt;xsl:value-of select="2"/&gt;
                        &lt;/ns:ID_CAUS_SCARTO&gt;
                        &lt;ns:ID_FILE_PROCSTO_INPUT&gt;
                            &lt;xsl:value-of select="xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;
                        &lt;/ns:ID_FILE_PROCSTO_INPUT&gt;
                    &lt;/ns:FileProcessatoInput&gt;
                    &lt;ns:EsecuzioneFile&gt;
                        &lt;ns:ID_ESEC_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO_FILE&gt;
                        &lt;ns:STATO_ESEC&gt;
