                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;ns:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE INPUT PER NUMERO RECORD INCONGRUENTE&amp;quot;&quot;/>&#xa;                &lt;/ns:LOG_MESSAGE>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
