STATO_ELAB_STAG>&#xa;                            &lt;tns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/tns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns1:STATO_ASSET&quot;>&#xa;                                &lt;tns:STATO_ASSET>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:STATO_ASSET&quot;/>&#xa;                                &lt;/tns:STATO_ASSET>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:TMSP_INSMTO>&#xa;                        &lt;/tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$DetailUltimiNoval/Rows/tns1:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio&quot;>&#xa;                        &lt;tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo_AllineamentoMonitoraggioNativeNow * ($index - 1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns1:CODICE_OLO_AGCOM&quot;>&#xa;                                &lt;tns:CODFC_OLO_AGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:CODICE_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns:CODFC_OLO_AGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Contenuto/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;>&#xa;                                &lt;tns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$Contenuto/ns:Output_ContenutoRecord[ns:Posizione=$var1]/ns:Valore&quot;/>&#xa;   