                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($PathFileScarto, $NomeFileScarto,format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
