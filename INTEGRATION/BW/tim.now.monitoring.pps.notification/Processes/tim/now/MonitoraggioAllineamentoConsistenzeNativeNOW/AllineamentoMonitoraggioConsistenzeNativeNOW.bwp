    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="306aa846-976c-4343-8e0a-c20376b1e94f">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="CallProcessToJDBCUpdate" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToAssign1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Assign1ToRenameFile1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToCallProcess1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcess1ToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty1" tibex:linkType="ERROR"/>
                            <bpws:link name="Empty1ToAssign1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile1ToEmpty2" tibex:linkType="ERROR"/>
                            <bpws:link name="Empty2ToCallProcess1" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="FAULT-input" name="FAULT"
                                tibex:xpdlId="57d60b1b-0ac6-495a-9cc9-8140eae12382"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToJDBCUpdate"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;FaultName&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;FAULT-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.monitoring.pps.notification.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioConsistenzeNativeNOW'&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultName&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(' AllineamentoMonitoraggioConsistenzeNativeNOW',tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9f2fd3f-e167-41c7-a3b4-61e9d775524f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:param name=&quot;Sistema&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;FilePoller&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;Invoke_InsertProcLog&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ID_FILE>&lt;SISTEMA>&lt;xsl:value-of select=&quot;$Sistema&quot;/>&lt;/SISTEMA>&lt;FLUSSO>&lt;xsl:value-of select=&quot;$Flusso&quot;/>&lt;/FLUSSO>&lt;DETAILS>&lt;xsl:value-of select=&quot;substring-before($FilePoller/fileInfo/fileName, '.')&quot;/>&lt;/DETAILS>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&lt;/DESCR_ERRORE>&lt;FLAG_LETTURA>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAG_LETTURA>&lt;STATO>&lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&lt;/STATO>&lt;ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Invoke_InsertProcLog/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ID_ESEC_PROCSO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="JDBCUpdate-input"
                                name="JDBCUpdate"
                                outputVariable="JDBCUpdate"
                                tibex:xpdlId="b9f2fd3f-e167-41c7-a3b4-61e9d775524f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToJDBCUpdate"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToAssign1"/>
                                    <bpws:source
                                    linkName="JDBCUpdateToEmpty1"
                                    tibex:faultDetailsVar="JDBCUpdate" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b9f2fd3f-e167-41c7-a3b4-61e9d775524f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_InsertProcLog.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Flusso&quot;/>&#xa;    &lt;xsl:param name=&quot;Sistema&quot;/>&#xa;    &lt;xsl:param name=&quot;FilePoller&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;$Sistema&quot;/>&#xa;            &lt;/SISTEMA>&#xa;            &lt;FLUSSO>&#xa;                &lt;xsl:value-of select=&quot;$Flusso&quot;/>&#xa;            &lt;/FLUSSO>&#xa;            &lt;DETAILS>&#xa;                &lt;xsl:value-of select=&quot;substring-before($FilePoller/fileInfo/fileName, '.')&quot;/>&#xa;            &lt;/DETAILS>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(),true())&quot;/>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;FLAG_LETTURA>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/FLAG_LETTURA>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;'KO TECNICO'&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:decimal($Invoke_InsertProcLog.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STATO_ALLINEAMENTI (ID_FILE, SISTEMA, FLUSSO,&#xa;  DETAILS, DESCR_ERRORE, FLAG_LETTURA, STATO, ID_ESEC_PROCSO_FILE,&#xa;  CREATED)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, SYSDATE)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SISTEMA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLUSSO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DETAILS"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_LETTURA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Var_ErrorFile"
                                name="Error_RenameFile"
                                outputVariable="Var_ErrorFile"
                                tibex:xpdlId="99aad269-00ae-4016-881d-b8ec3f63d3b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToAssign1"/>
                                    <bpws:target linkName="Empty1ToAssign1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign1ToRenameFile1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
