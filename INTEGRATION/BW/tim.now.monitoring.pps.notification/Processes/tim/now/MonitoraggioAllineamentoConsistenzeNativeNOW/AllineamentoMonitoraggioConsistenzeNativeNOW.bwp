                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="RenameFile1-input"
                                name="RenameFile1"
                                outputVariable="RenameFile1"
                                tibex:xpdlId="b8c7eb83-3a26-444e-ae7e-55a687348b7c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
