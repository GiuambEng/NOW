                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutput_LoggerProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.monitoring.pps.notification.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'AllineamentoMonitoraggioConsistenzeNativeNOW'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Invoke_ProcessLogger.part1, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;ns:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INIZIO LAVORAZIONE FILE INPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:LOG_MESSAGE>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Var_InputProcessLogger"
                    name="Insert_Log"
                    outputVariable="Var_InputProcessLogger"
                    tibex:xpdlId="87a2e407-3b61-4bf0-a513-e636e2bc48a1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Insert_LogToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_InputProcessLogger&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke_ProcessLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;ns:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INIZIO LAVORAZIONE FILE INPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:LOG_MESSAGE>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_InputProcessLogger" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Invoke_InsertProcLog-input"
                name="Invoke_InsertProcLog" operation="Insert"
                outputVariable="Invoke_InsertProcLog"
                partnerLink="Logger" portType="ns4:ProcessLog" tibex:xpdlId="cd8913eb-841e-4c96-8f3e-a70602029e8a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;
    &lt;xsl:param name="Var_InputProcessLogger"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaProcesso"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="$Var_InputProcessLogger/ns:TipologiaOperazione"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:LogFileProcessato&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"&gt;
                            &lt;ns:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO"/&gt;
                            &lt;/ns:COD_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"&gt;
                            &lt;ns:ID_ESEC_PROCSO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO"/&gt;
                            &lt;/ns:ID_ESEC_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"&gt;
                            &lt;ns:ID_FILE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE"/&gt;
                            &lt;/ns:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"&gt;
                            &lt;ns:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL"/&gt;
                            &lt;/ns:LOG_LEVEL&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"&gt;
                            &lt;ns:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE"/&gt;
                            &lt;/ns:LOG_MESSAGE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"&gt;
                            &lt;ns:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO"/&gt;
                            &lt;/ns:TIMSTP_INSMTO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:LogFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InputProcessLogger&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:COD_PROCSO&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_ESEC_PROCSO&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_LEVEL&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:LOG_MESSAGE&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InputProcessLogger/ns:LogFileProcessato/ns:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
