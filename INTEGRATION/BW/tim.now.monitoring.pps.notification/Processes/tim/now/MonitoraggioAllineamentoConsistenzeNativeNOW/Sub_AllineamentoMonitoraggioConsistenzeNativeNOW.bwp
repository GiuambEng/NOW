                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$Start/ns3:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Start/ns3:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="ns3:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link name="MapperToAssign" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToAssign1" tibex:linkType="ERROR"/>
                                    <bpws:link name="AssignToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Assign1ToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="GroupStartToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="Mapper1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="018648fd-b3b2-45aa-9114-2f8edf77df41" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapper"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns3:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="0c500694-d343-4e13-8fa4-94728320b34c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
