                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.MonitoraggioNATIVINOW_IDRISORSA_Staging&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0a22fa52-c752-4aeb-b461-5b443ccba984+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Accumulate/tns:MonitoraggioNATIVINOW_IDRISORSA/tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio&quot;>&lt;Record>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:DESCR_ERRORE)>0&quot;>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(tns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;/Record>&lt;/xsl:for-each>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
