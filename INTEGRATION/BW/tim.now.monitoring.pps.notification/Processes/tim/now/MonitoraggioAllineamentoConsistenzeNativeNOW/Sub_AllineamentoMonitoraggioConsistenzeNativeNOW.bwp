                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.schema.xsd.MonitoraggioNATIVINOW_IDRISORSA_CheckSingoliRecord&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.MonitoraggioNATIVINOW_IDRISORSA_Subprocess&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;ControlloDettaglio-input&quot; match=&quot;/&quot;>&lt;tns:MonitoraggioNATIVINOW_IDRISORSA>&lt;tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio>&lt;tns:TIPO_RECORD>&lt;xsl:value-of select=&quot;$currentElement/tns1:TIPO_RECORD&quot;/>&lt;/tns:TIPO_RECORD>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:STATO_ASSET>&lt;xsl:value-of select=&quot;$currentElement/tns1:STATO_ASSET&quot;/>&lt;/tns:STATO_ASSET>&lt;tns:DEC>&lt;xsl:value-of select=&quot;xsd:date($currentElement/tns1:DEC)&quot;/>&lt;/tns:DEC>&lt;tns:CODICE_OLO_AGCOM>&lt;xsl:value-of select=&quot;$currentElement/tns1:CODICE_OLO_AGCOM&quot;/>&lt;/tns:CODICE_OLO_AGCOM>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;$currentElement/tns1:CRMWS_SERVICE&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;xsl:if test=&quot;$currentElement/tns1:FlagValidita&quot;>&lt;tns:FlagValidita>&lt;xsl:value-of select=&quot;$currentElement/tns1:FlagValidita&quot;/>&lt;/tns:FlagValidita>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:NumeroRecord&quot;>&lt;tns:NumeroRecord>&lt;xsl:value-of select=&quot;$currentElement/tns1:NumeroRecord&quot;/>&lt;/tns:NumeroRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;$currentElement/tns1:ID_FILE&quot;>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;$currentElement/tns1:ID_FILE&quot;/>&lt;/tns:ID_FILE>&lt;/xsl:if>&lt;/tns:MonitoraggioNATIVINOW_IDRISORSA_Dettaglio>&lt;/tns:MonitoraggioNATIVINOW_IDRISORSA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ControlloDettaglio-input"
                                    name="ControlloDettaglio"
                                    outputVariable="ControlloDettaglio"
                                    tibex:xpdlId="8c57f844-439f-44b3-8033-40d7f7ebc7b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToAssign"/>
                                    <bpws:source
                                    linkName="MapperToAssign1"
                                    tibex:faultDetailsVar="ControlloDettaglio" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
