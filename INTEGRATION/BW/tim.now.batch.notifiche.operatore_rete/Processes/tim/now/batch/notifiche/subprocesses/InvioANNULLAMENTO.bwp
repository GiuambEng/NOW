            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="dbf91904-a60d-4a91-9a38-202752699577">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="Annullamento"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Annullamento/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Annullamento/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo+1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;tns3:CodCausale&gt;&lt;xsl:value-of select="$ParseXml/richiesta/annullamento/codiceCausaleAnnullamento"/&gt;&lt;/tns3:CodCausale&gt;&lt;tns3:CodOrdineFlashfiber&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineFlashFiber"/&gt;&lt;/tns3:CodOrdineFlashfiber&gt;&lt;tns3:DataAnnullamento&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/annullamento/dataAnnullamento)"/&gt;&lt;/tns3:DataAnnullamento&gt;&lt;tns3:DescrCausale&gt;&lt;xsl:value-of select="$ParseXml/richiesta/annullamento/descrizioneCausaleAnnullamento"/&gt;&lt;/tns3:DescrCausale&gt;&lt;xsl:if test="$ParseXml/richiesta/annullamento/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/richiesta/annullamento/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;/tns1:EventoOperatoreRete&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Annullamento/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns1:ContenutoResponse&gt;&lt;tns1:CodiceAckNack&gt;&lt;xsl:value-of select="$Annullamento/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns1:CodiceAckNack&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="concat($ParseXml/richiesta/testata/idNotifica,'-',$ParseXml/richiesta/testata/idMessaggio)"/&gt;&lt;/tns1:TransactionId&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Annullamento.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Annullamento.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:CodCausale>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/annullamento/codiceCausaleAnnullamento&quot;/>&#xa;                &lt;/tns3:CodCausale>&#xa;                &lt;tns3:CodOrdineFlashfiber>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineFlashFiber&quot;/>&#xa;                &lt;/tns3:CodOrdineFlashfiber>&#xa;                &lt;tns3:DataAnnullamento>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/annullamento/dataAnnullamento)&quot;/>&#xa;                &lt;/tns3:DataAnnullamento>&#xa;                &lt;tns3:DescrCausale>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/annullamento/descrizioneCausaleAnnullamento&quot;/>&#xa;                &lt;/tns3:DescrCausale>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/annullamento/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/annullamento/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;