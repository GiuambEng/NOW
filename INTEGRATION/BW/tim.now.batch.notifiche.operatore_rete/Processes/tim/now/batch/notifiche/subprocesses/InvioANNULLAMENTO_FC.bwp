                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;StatoAttivazione&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:annullamento>&lt;richiesta>&lt;testata>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;codiceOutSourcer>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOutSourcer&quot;/>&lt;/codiceOutSourcer>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdMessaggio&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdNotifica&quot;/>&lt;/dataIdNotifica>&lt;dataRiscontro>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataRiscontro&quot;/>&lt;/dataRiscontro>&lt;idMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/tipoOrdine&quot;/>&lt;/tipoOrdine>&lt;tipoRiscontro>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/tipoRiscontro&quot;/>&lt;/tipoRiscontro>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StatoAttivazione/Record[TIPO_RISCONTRO='ATTIVAZIONE'])&quot;>&lt;codiceOrdineFiberCop>&lt;xsl:value-of select=&quot;$StatoAttivazione/Record[TIPO_RISCONTRO='ATTIVAZIONE']/COD_ORDINE_FIBERCOP&quot;/>&lt;/codiceOrdineFiberCop>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codiceOrdineFiberCop>&lt;xsl:value-of select=&quot;$StatoAttivazione/Record[TIPO_RISCONTRO='TRASLOCO']/COD_ORDINE_FIBERCOP&quot;/>&lt;/codiceOrdineFiberCop>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/testata>&lt;xsl:copy-of select=&quot;$ParseXml/richiesta/annullamento&quot;/>&lt;/richiesta>&lt;/tns:annullamento>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
