                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToResponse"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ResponseToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;CallSecoloDecode&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:OutputDetokenizzazioneRecapiti>&lt;xsl:copy-of select=&quot;$Response/tns:Referente&quot;/>&lt;tns:Referente>&lt;tns:Esito>&lt;xsl:value-of select=&quot;$CallSecoloDecode/tns1:ESITO&quot;/>&lt;/tns:Esito>&lt;xsl:if test=&quot;$CallSecoloDecode/tns1:N_Recap_Cliente&quot;>&lt;tns:TelefonoFisso>&lt;xsl:value-of select=&quot;$CallSecoloDecode/tns1:N_Recap_Cliente&quot;/>&lt;/tns:TelefonoFisso>&lt;/xsl:if>&lt;xsl:if test=&quot;$CallSecoloDecode/tns1:N_Recap_Cliente_ALT&quot;>&lt;tns:TelefonoMobile>&lt;xsl:value-of select=&quot;$CallSecoloDecode/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/tns:TelefonoMobile>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Referente[number($index)]/tns:TelefonoFisso) and string-length($Start/tns:Referente[number($index)]/tns:TelefonoFisso)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:Referente[number($index)]/tns:TelefonoFisso&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/tns:Referente[number($index)]/tns:TelefonoFisso&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:Referente[number($index)]/tns:TelefonoMobile&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/tns:Referente[number($index)]/tns:TelefonoMobile&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Referente>&lt;/tns:OutputDetokenizzazioneRecapiti>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogSecoloOutput-input"
                                    name="LogSecoloOutput"
                                    tibex:xpdlId="81b736c4-0ed1-4858-bafb-9de22c94ce68"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
