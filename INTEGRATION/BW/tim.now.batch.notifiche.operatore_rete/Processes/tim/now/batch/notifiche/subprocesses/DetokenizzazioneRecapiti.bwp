                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/tns:Referente)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogSecoloInputToCallSecoloDecode" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallSecoloDecodeToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLoggerToResponse" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ResponseToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="ed455939-d790-4375-bb8e-af5e93c1b846">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToGenericLogger"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="5596fb21-64ea-4bd3-81c2-9be614bb671d">
                                <bpws:targets>
                                    <bpws:target linkName="ResponseToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogSecoloInput-input"
                                    name="LogSecoloInput"
                                    tibex:xpdlId="943c5b55-c4a2-4d01-85f4-01cd2de3b10e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogSecoloInputToCallSecoloDecode"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;LogSecoloInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'DetokenizzazioneRecapiti'&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Chiamata a Secolo per Token: ', $Start/tns1:Referente[number($index)]/tns1:TelefonoFisso)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallSecoloDecode-input"
                                    name="CallSecoloDecode"
                                    outputVariable="CallSecoloDecode"
                                    tibex:xpdlId="1e83910f-54d6-49c7-9ab0-c38ed5fa3685"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogSecoloInputToCallSecoloDecode"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallSecoloDecodeToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;CallSecoloDecode-input&quot; match=&quot;/&quot;>&lt;tns:RequestDecode_token>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns2:CodificaOloAgcom&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns2:CodiceOrdineOlo&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'FFNOTF'&quot;/>&lt;/tns:Funzione>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($Start/tns2:CodiceOrdineOlo,string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns1:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns1:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Referente[number($index)]/tns2:TelefonoFisso) and string-length($Start/tns2:Referente[number($index)]/tns2:TelefonoFisso)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Referente[number($index)]/tns2:TelefonoFisso&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/tns2:Referente[number($index)]/tns2:TelefonoFisso&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:Referente[number($index)]/tns2:TelefonoMobile&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Start/tns2:Referente[number($index)]/tns2:TelefonoMobile&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RequestDecode_token>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
