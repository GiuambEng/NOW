uot;$ParseXml/richiesta/espletamento/posizioneMorsettieraROE&quot;>&#xa;                    &lt;tns3:PosizMorsettieraRoe>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/posizioneMorsettieraROE&quot;/>&#xa;                    &lt;/tns3:PosizMorsettieraRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/posizioneSplitterSecondario&quot;>&#xa;                    &lt;tns3:PosizSplitter>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/posizioneSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:PosizSplitter>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/riprogettato&quot;>&#xa;                    &lt;tns3:Riprogettato>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/riprogettato&quot;/>&#xa;                    &lt;/tns3:Riprogettato>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:StatoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/statoOrdine&quot;/>&#xa;                &lt;/tns3:StatoOrdine>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Espletamento.riscontriOLResponse)&quot;/>&#xa;            &lt;/tns1:ContenutoResponse>&#xa;            &lt;tns1:CodiceAckNack>&#xa;                &l