            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns3:TracciamentoWSTIM2" tibex:xpdlId="6967f475-8c00-4f06-91ff-2a2a3bfd48c4">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="Espletamento"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Espletamento/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Espletamento/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo+1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/causaRiprogettazioneOnField"&gt;&lt;tns3:CausaRiprogtOnField&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/causaRiprogettazioneOnField"/&gt;&lt;/tns3:CausaRiprogtOnField&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/rifiuto/codiceMotivoRifiuto"&gt;&lt;tns3:CodMotivoRifiuto&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/rifiuto/codiceMotivoRifiuto"/&gt;&lt;/tns3:CodMotivoRifiuto&gt;&lt;/xsl:if&gt;&lt;tns3:CodOrdineFlashfiber&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineFlashFiber"/&gt;&lt;/tns3:CodOrdineFlashfiber&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/codiceSplitterPrimario"&gt;&lt;tns3:CodSplitterPrimario&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/codiceSplitterPrimario"/&gt;&lt;/tns3:CodSplitterPrimario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/codiceSplitterSecondario"&gt;&lt;tns3:CodSplitterSecondario&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/codiceSplitterSecondario"/&gt;&lt;/tns3:CodSplitterSecondario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/codiceROE"&gt;&lt;tns3:CodRoe&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/codiceROE"/&gt;&lt;/tns3:CodRoe&gt;&lt;/xsl:if&gt;&lt;tns3:DataEspletamento&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/espletamento/dataEspletamento)"/&gt;&lt;/tns3:DataEspletamento&gt;&lt;tns3:IdGpon&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/idGpon"/&gt;&lt;/tns3:IdGpon&gt;&lt;tns3:IdRisorsa&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/idRisorsa"/&gt;&lt;/tns3:IdRisorsa&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/impresa"&gt;&lt;tns3:ImpresaSystem&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/impresa"/&gt;&lt;/tns3:ImpresaSystem&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/rifiuto/motivoRifiuto"&gt;&lt;tns3:MotivoRifiuto&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/rifiuto/motivoRifiuto"/&gt;&lt;/tns3:MotivoRifiuto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/posizioneMorsettieraROE"&gt;&lt;tns3:PosizMorsettieraRoe&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/posizioneMorsettieraROE"/&gt;&lt;/tns3:PosizMorsettieraRoe&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/posizioneSplitterSecondario"&gt;&lt;tns3:PosizSplitter&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/posizioneSplitterSecondario"/&gt;&lt;/tns3:PosizSplitter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/espletamento/riprogettato"&gt;&lt;tns3:Riprogettato&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/riprogettato"/&gt;&lt;/tns3:Riprogettato&gt;&lt;/xsl:if&gt;&lt;tns3:StatoOrdine&gt;&lt;xsl:value-of select="$ParseXml/richiesta/espletamento/statoOrdine"/&gt;&lt;/tns3:StatoOrdine&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;/tns1:EventoOperatoreRete&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Espletamento/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns1:ContenutoResponse&gt;&lt;tns1:CodiceAckNack&gt;&lt;xsl:value-of select="$Espletamento/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns1:CodiceAckNack&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="concat($ParseXml/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$ParseXml/richiesta/testata/idMessaggio)"/&gt;&lt;/tns1:TransactionId&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Espletamento.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Espletamento.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Espletamento.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/causaRiprogettazioneOnField&quot;>&#xa;                    &lt;tns3:CausaRiprogtOnField>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/causaRiprogettazioneOnField&quot;/>&#xa;                    &lt;/tns3:CausaRiprogtOnField>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/rifiuto/codiceMotivoRifiuto&quot;>&#xa;                    &lt;tns3:CodMotivoRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/rifiuto/codiceMotivoRifiuto&quot;/>&#xa;                    &lt;/tns3:CodMotivoRifiuto>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:CodOrdineFlashfiber>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineFlashFiber&quot;/>&#xa;                &lt;/tns3:CodOrdineFlashfiber>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/codiceSplitterPrimario&quot;>&#xa;                    &lt;tns3:CodSplitterPrimario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/codiceSplitterPrimario&quot;/>&#xa;                    &lt;/tns3:CodSplitterPrimario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/espletamento/codiceSplitterSecondario&quot;>&#xa;                    &lt;tns3:CodSplitterSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/espletamento/codiceSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:CodSplitterSe