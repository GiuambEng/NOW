                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CambioDai.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($CambioDai.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$CambioDai.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:CodMotivoCambioDai>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/cambioDAI/codiceMotivoCambioDAI&quot;/>&#xa;                &lt;/tns3:CodMotivoCambioDai>&#xa;                &lt;tns3:CodOrdineFlashfiber>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineFlashFiber&quot;/>&#xa;                &lt;/tns3:CodOrdineFlashfiber>&#xa;                &lt;tns3:DescrMotivoCambioDai>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/cambioDAI/descrizioneMotivoCambioDAI&quot;/>&#xa;                &lt;/tns3:DescrMotivoCambioDai>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/cambioDAI/nuovaFasciaDAI&quot;>&#xa;                    &lt;tns3:FasciaOrariaDai>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/cambioDAI/nuovaFasciaDAI&quot;/>&#xa;                    &lt;/tns3:FasciaOrariaDai>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/cambioDAI/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/cambioDAI/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:NuovaDai>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/cambioDAI/nuovaDAI)&quot;/>&#xa;                &lt;/tns3:NuovaDai>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($CambioDai.riscontriOLResponse)&quot;/>&#xa;            &lt;/tns1:ContenutoResponse>&#xa;            &lt;tns1:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$CambioDai.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;            &lt;/tns1:CodiceAckNack>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$ParseXml/richiesta/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns1:IdEventoOrdineNowWhls>&#xa;        &lt;/tns1:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogRiscontriToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Update&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvioCAMBIODAI'&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Processo terminato. Update effettuato: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Update/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogUpdate-input" name="LogUpdate"
                    tibex:xpdlId="1c2f6420-40f4-487f-b9c0-a0b4102d2048"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
