&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://ordinicommerciali.service.flashfiber.com/" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="CambioDai-input" match="/"&gt;&lt;tns:cambioDAI&gt;&lt;cambioDAI&gt;&lt;tns:cambioDAI&gt;&lt;xsl:copy-of select="$Mapper/richiesta"/&gt;&lt;/tns:cambioDAI&gt;&lt;/cambioDAI&gt;&lt;/tns:cambioDAI&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
