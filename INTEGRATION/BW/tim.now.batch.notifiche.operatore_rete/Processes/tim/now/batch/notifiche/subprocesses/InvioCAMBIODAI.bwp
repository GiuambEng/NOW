                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="a3202a72-ca4d-4af3-beff-fac46a2f0719">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="CambioDai"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($CambioDai/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$CambioDai/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo+1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;tns3:CodMotivoCambioDai&gt;&lt;xsl:value-of select="$ParseXml/richiesta/cambioDAI/codiceMotivoCambioDAI"/&gt;&lt;/tns3:CodMotivoCambioDai&gt;&lt;tns3:CodOrdineFlashfiber&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineFlashFiber"/&gt;&lt;/tns3:CodOrdineFlashfiber&gt;&lt;tns3:DescrMotivoCambioDai&gt;&lt;xsl:value-of select="$ParseXml/richiesta/cambioDAI/descrizioneMotivoCambioDAI"/&gt;&lt;/tns3:DescrMotivoCambioDai&gt;&lt;xsl:if test="$ParseXml/richiesta/cambioDAI/nuovaFasciaDAI"&gt;&lt;tns3:FasciaOrariaDai&gt;&lt;xsl:value-of select="$ParseXml/richiesta/cambioDAI/nuovaFasciaDAI"/&gt;&lt;/tns3:FasciaOrariaDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/cambioDAI/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/richiesta/cambioDAI/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:NuovaDai&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/cambioDAI/nuovaDAI)"/&gt;&lt;/tns3:NuovaDai&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;/tns1:EventoOperatoreRete&gt;&