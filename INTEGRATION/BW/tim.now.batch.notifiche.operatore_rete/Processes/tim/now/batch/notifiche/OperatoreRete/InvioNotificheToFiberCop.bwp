            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Linearizzatore-input"
                    name="Linearizzatore"
                    outputVariable="Linearizzatore"
                    tibex:xpdlId="4be27557-7f07-4952-93b8-b2f657887c87" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToRecuperaNotifiche">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
