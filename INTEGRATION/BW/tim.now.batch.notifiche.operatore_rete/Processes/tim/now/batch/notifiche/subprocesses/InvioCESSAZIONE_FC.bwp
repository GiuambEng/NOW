                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:cessazione>&lt;request>&lt;xsl:copy-of select=&quot;$ParseXml/request/accessoGpon&quot;/>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatore&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOrdineOperatorePadre&quot;>&lt;codiceOrdineOperatorePadre>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOrdineOperatorePadre&quot;/>&lt;/codiceOrdineOperatorePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/dataIdMessaggio&quot;/>&lt;/dataIdMessaggio>&lt;idMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/idMessaggio&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/dataIdNotifica&quot;/>&lt;/dataIdNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/tipoOrdine&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/servizio&quot;/>&lt;/servizio>&lt;xsl:if test=&quot;$ParseXml/request/testata/Ex_FF&quot;>&lt;Ex_FF>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/Ex_FF&quot;/>&lt;/Ex_FF>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOperatoreOspitato&quot;>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatoreOspitato&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOperatoreOspitante&quot;>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatoreOspitante&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:if>&lt;/testata>&lt;/request>&lt;/tns:cessazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
