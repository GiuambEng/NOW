 &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:IdRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/request/accessoGpon/idRisorsa&quot;/>&#xa;                &lt;/tns3:IdRisorsa>&#xa;                &lt;xsl:if test=&quot;$ParseXml/request/accessoGpon/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/request/accessoGpon/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Cess.cessazioneResponse)&quot;/>&#xa;            &lt;/tns1:ContenutoResponse>&#xa;            &lt;tns1:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$Cess.cessazioneResponse/response/esito/codice&quot;/>&#xa;            &lt;/tns1:CodiceAckNack>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/request/testata/idNotifica,&amp;quot;-&amp;quot;,$ParseXml/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns4:IdEvent