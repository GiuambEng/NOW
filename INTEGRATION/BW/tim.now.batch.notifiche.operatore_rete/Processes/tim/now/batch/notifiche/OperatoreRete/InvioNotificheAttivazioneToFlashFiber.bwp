    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Timer">
            <endingVariables>
                <variable>Timer</variable>
            </endingVariables>
        </task>
        <task name="LogStart">
            <endingVariables>
                <variable>LogStart-input</variable>
            </endingVariables>
        </task>
        <task name="Linearizzatore">
            <endingVariables>
                <variable>Linearizzatore-input</variable>
            </endingVariables>
        </task>
        <task name="RecuperaNotifiche">
            <endingVariables>
                <variable>RecuperaNotifiche-input</variable>
            </endingVariables>
        </task>
        <task name="LogRecuperaNotifiche">
            <endingVariables>
                <variable>LogRecuperaNotifiche-input</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>RecuperaNotifiche</variable>
                <variable>index</variable>
            </endingVariables>
        </task>
        <task name="InvioATTIVAZIONE">
            <endingVariables>
                <variable>InvioATTIVAZIONE-input</variable>
            </endingVariables>
        </task>
        <task name="LogEnd">
            <endingVariables>
                <variable>LogEnd-input</variable>
            </endingVariables>
        </task>
        <task name="Exit">
            <endingVariables>
                <variable>Linearizzatore</variable>
            </endingVariables>
        </task>
        <task name="LogLinChiuso">
            <endingVariables>
                <variable>LogLinChiuso-input</variable>
            </endingVariables>
        </task>
        <task name="LogError">
            <endingVariables>
                <variable>LogError-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
