                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2019-05-15T15:11:37.514+0200"
                                    intervalUnit="Second"
                                    startTime="2019-05-15T12:00:00.000+0200" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="d0ff91fe-65a6-4692-b10e-8176770aa780"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerToLogStart"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToJDBCQuery1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvioNotificheToFlashFiber'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Start processo InvioNotificheToFlashFiber'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperaNotifiche-input"
                    name="RecuperaNotifiche"
                    outputVariable="RecuperaNotifiche"
                    tibex:xpdlId="fff08725-8e0b-4b6b-907c-82b62f291455" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToRecuperaNotifiche"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaNotificheToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fff08725-8e0b-4b6b-907c-82b62f291455+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Linearizzatore&quot;/>&lt;xsl:template name=&quot;RecuperaNotifiche-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;maxRows>&lt;xsl:value-of select=&quot;xsd:int($Linearizzatore/Record[1]/N_MESSAGGI_2FF)&quot;/>&lt;/maxRows>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="maxRows" processProperty="MaxRows"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_REQUEST, TIPO_RISCONTRO, ID_RICH_OLO, NUM_TENTATIVO, ID_EVENTO_ORDN_NOW_WHLS, TOKEN, ID_RISORSA_OPERATORE_RETE FROM STAG_OPER_RETE_OUTPUT_NO_FILE WHERE ID_STATO_ELAB_STAGING='42' AND ID_RISORSA_OPERATORE_RETE='FF' AND TIPO_RISCONTRO&lt;>'ATTIVAZIONE' ORDER BY TIMSTP_RICH ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CONTENUTO_REQUEST"
                                    dataType="2005" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="TIPO_RISCONTRO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUM_TENTATIVO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TOKEN"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RISORSA_OPERATORE_RETE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogRecuperaNotifiche-input"
                    name="LogRecuperaNotifiche"
                    tibex:xpdlId="c56ba020-06ee-4b65-a6c5-f166d84e03e9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaNotificheToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogRecuperaNotificheToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;RecuperaNotifiche&quot;/>&lt;xsl:template name=&quot;LogRecuperaNotifiche-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvioNotificheToFlashFiber'&quot;/>&lt;/tns:Process>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RecuperaNotifiche/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Numero di notifiche da inviare a FF: ', string(count($RecuperaNotifiche/Record)))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessuna notifica da inviare a FF'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e44a1e0c-81ec-4049-957f-6fdffffe7102">
                <bpws:targets>
                    <bpws:target linkName="LogRecuperaNotificheToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($RecuperaNotifiche/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($RecuperaNotifiche/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToInvioAttivazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToInvioAnnullamento" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="InvioAttivazioneToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToInvioCambioDai" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToInvioCessazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToInvioDeSospensione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="InvioAnnullamentoToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvioCambioDaiToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvioCessazioneToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvioDeSospensioneToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToInvioEspletamento" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="InvioEspletamentoToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToInvioSospensione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="InvioSospensioneToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="d1a2b5b8-8a72-4dca-ad78-e534e3e46123">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvioAttivazione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ATTIVAZIONE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioAnnullamento">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ANNULLAMENTO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ANNULLAMENTO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioCambioDai">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='CAMBIO DAI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='CAMBIO DAI']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioCessazione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='CESSAZIONE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioDeSospensione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='DESOSPENSIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='DESOSPENSIONE']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioEspletamento">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ESPLETAMENTO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='ESPLETAMENTO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToInvioSospensione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='SOSPENSIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RecuperaNotifiche/Record[number($index)]/TIPO_RISCONTRO='SOSPENSIONE']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="e2d6f705-a8f8-47a0-bc9b-fc4bf57cde2d">
                                <bpws:targets>
                                    <bpws:target linkName="InvioAttivazioneToGroupEnd"/>
                                    <bpws:target linkName="InvioAnnullamentoToGroupEnd"/>
                                    <bpws:target linkName="InvioCambioDaiToGroupEnd"/>
                                    <bpws:target linkName="InvioCessazioneToGroupEnd"/>
                                    <bpws:target linkName="InvioDeSospensioneToGroupEnd"/>
                                    <bpws:target linkName="InvioEspletamentoToGroupEnd"/>
                                    <bpws:target linkName="InvioSospensioneToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="InvioAttivazione-input"
                                    name="InvioAttivazione"
                                    tibex:xpdlId="b5b53135-773b-4735-9bf2-fd77e3bbcd45"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvioAttivazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="InvioAttivazioneToGroupEnd"/>
                                    </bpws:sources>
