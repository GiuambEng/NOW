                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaNotifiche&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioATTIVAZIONE_FC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:InputAttivazioneFC>&#xa;            &lt;tns:ContenutoRequest>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaNotifiche/Record[number($index)]/CONTENUTO_REQUEST&quot;/>&#xa;            &lt;/tns:ContenutoRequest>&#xa;            &lt;tns:IdRichOlo>&#xa;                &lt;xsl:value-of select=&quot;$RecuperaNotifiche/Record[number($index)]/ID_RICH_OLO&quot;/>&#xa;            &lt;/tns:IdRichOlo>&#xa;            &lt;tns:NumTentativo>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperaNotifiche/Record[number($index)]/NUM_TENTATIVO)&quot;/>&#xa;            &lt;/tns:NumTentativo>&#xa;            &lt;tns:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperaNotifiche/Record[number($index)]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&#xa;            &lt;/tns:IdEventoOrdineNowWhls>&#xa;            &lt;xsl:if test=&quot;$RecuperaNotifiche/Record[number($index)]/TOKEN&quot;>&#xa;                &lt;tns:Token>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperaNotifiche/Record[number($index)]/TOKEN&quot;/>&#xa;                &lt;/tns:Token>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RecuperaNotifiche/Record[number($index)]/ID_RISORSA_OPERATORE_RETE&quot;>&#xa;                &lt;tns:IdRisorsaOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;$RecuperaNotifiche/Record[number($index)]/ID_RISORSA_OPERATORE_RETE&quot;/>&#xa;                &lt;/tns:IdRisorsaOperatoreRete>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:InputAttivazioneFC>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.batch.notifiche.subprocesses.InvioATTIVAZIONE_FC" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
