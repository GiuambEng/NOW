                                    sqlStatement="SELECT CONTENUTO_REQUEST, TIPO_RISCONTRO, ID_RICH_OLO, NUM_TENTATIVO, ID_EVENTO_ORDN_NOW_WHLS, TOKEN, ID_RISORSA_OPERATORE_RETE FROM STAG_OPER_RETE_OUTPUT_NO_FILE WHERE ID_STATO_ELAB_STAGING='42' AND ID_RISORSA_OPERATORE_RETE='FC' AND TIPO_RISCONTRO='ATTIVAZIONE' ORDER BY TIMSTP_RICH ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
