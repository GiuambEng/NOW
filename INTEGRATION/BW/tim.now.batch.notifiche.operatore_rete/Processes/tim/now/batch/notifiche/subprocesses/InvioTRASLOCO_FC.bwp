                portType="ns11:TracciamentoWSTIM2" tibex:xpdlId="49c5bed6-0c84-4d70-bd56-addfd9291179">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:nslt2="urn:PegaRULES:SOAP:OrdiniCommerciali:Services" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="Trasloco"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:param name="MapperUpdIDNOTF"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($MapperUpdIDNOTF)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Trasloco/traslocoResponse/nslt2:traslocoResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/request/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Trasloco/traslocoResponse/nslt2:traslocoResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/request/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo + 1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:CodiceOrdineFiberCop&gt;&lt;xsl:value-of select="$Trasloco/traslocoResponse/nslt2:traslocoResponse/risposta/testata/codiceOrdineFCop"/&gt;&lt;/tns2:CodiceOrdineFiberCop&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/request/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/request/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/cap"&gt;&lt;tns3:Cap&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/cap"/&gt;&lt;/tns3:Cap&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/datiCliente/codiceFiscale"&gt;&lt;tns3:Cf&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/datiCliente/codiceFiscale"/&gt;&lt;/tns3:Cf&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/civico"&gt;&lt;tns3:Civico&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/civico"/&gt;&lt;/tns3:Civico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/codiceComune"&gt;&lt;tns3:CodComune&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/codiceComune"/&gt;&lt;/tns3:CodComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/complesso"&gt;&lt;tns3:Complesso&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/complesso"/&gt;&lt;/tns3:Complesso&gt;&lt;/xsl:if&gt;&lt;tns3:DataDai&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/request/accessoTrasl/outSourcer/dataDAI)"/&gt;&lt;/tns3:DataDai&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/outSourcer/fasciaOrariaDAI"&gt;&lt;tns3:FasciaOrariaDai&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/outSourcer/fasciaOrariaDAI"/&gt;&lt;/tns3:FasciaOrariaDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/interno"&gt;&lt;tns3:Interno&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/interno"/&gt;&lt;/tns3:Interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/localita"&gt;&lt;tns3:Localita&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/localita"/&gt;&lt;/tns3:Localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/datiCliente/nome"&gt;&lt;tns3:Nome&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/datiCliente/nome"/&gt;&lt;/tns3:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/piano"&gt;&lt;tns3:Piano&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/piano"/&gt;&lt;/tns3:Piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/datiCliente/partitaIva"&gt;&lt;tns3:Piva&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/datiCliente/partitaIva"/&gt;&lt;/tns3:Piva&gt;&lt;/xsl:if&gt;&lt;tns3:RecapitoMobileCliente&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/datiCliente/recapitoMobileCliente"/&gt;&lt;/tns3:RecapitoMobileCliente&gt;&lt;tns3:RecapitoFissoCliente&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/datiCliente/recapitoFissoCliente"/&gt;&lt;/tns3:RecapitoFissoCliente&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/scala"&gt;&lt;tns3:Scala&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/scala"/&gt;&lt;/tns3:Scala&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/slaAssurance"&gt;&lt;tns3:SlaAssurance&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/slaAssurance"/&gt;&lt;/tns3:SlaAssurance&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/request/accessoTrasl/sede/via"&gt;&lt;tns3:Via&gt;&lt;xsl:value-of select="$ParseXml/request/accessoTrasl/sede/via"/&gt;&lt;/tns3:Via&gt;&lt;/xsl:if&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="3"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;/tns1:EventoOperatoreRete&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Trasloco/traslocoResponse/nslt2:traslocoResponse)"/&gt;&lt;/tns1:ContenutoResponse&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="concat($ParseXml/request/testata/idNotifica,'-',$ParseXml/request/testata/idMessaggio)"/&gt;&lt;/tns1:TransactionId&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
