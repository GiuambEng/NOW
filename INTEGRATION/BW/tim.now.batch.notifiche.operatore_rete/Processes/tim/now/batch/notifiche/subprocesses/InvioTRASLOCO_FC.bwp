                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;SecoloDecode&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:trasloco>&lt;request>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatore&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOrdineOperatorePadre&quot;>&lt;codiceOrdineOperatorePadre>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOrdineOperatorePadre&quot;/>&lt;/codiceOrdineOperatorePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/dataIdMessaggio&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/dataIdNotifica&quot;/>&lt;/dataIdNotifica>&lt;idMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/idMessaggio&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/tipoOrdine&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/servizio&quot;/>&lt;/servizio>&lt;xsl:if test=&quot;$ParseXml/request/testata/Ex_FF&quot;>&lt;Ex_FF>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/Ex_FF&quot;/>&lt;/Ex_FF>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOperatoreOspitato&quot;>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatoreOspitato&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/testata/codiceOperatoreOspitante&quot;>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOperatoreOspitante&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:if>&lt;/testata>&lt;accessoTrasl>&lt;xsl:if test=&quot;$ParseXml/request/accessoTrasl/note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/note&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/accessoTrasl/slaAssurance&quot;>&lt;slaAssurance>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/slaAssurance&quot;/>&lt;/slaAssurance>&lt;/xsl:if>&lt;datiCliente>&lt;xsl:if test=&quot;$ParseXml/request/accessoTrasl/datiCliente/codiceFiscale&quot;>&lt;codiceFiscale>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/datiCliente/codiceFiscale&quot;/>&lt;/codiceFiscale>&lt;/xsl:if>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/datiCliente/cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;xsl:if test=&quot;$ParseXml/request/accessoTrasl/datiCliente/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/datiCliente/nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/request/accessoTrasl/datiCliente/partitaIva&quot;>&lt;partitaIva>&lt;xsl:value-of select=&quot;$ParseXml/request/accessoTrasl/datiCliente/partitaIva&quot;/>&lt;/partitaIva>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($ParseXml/request/accessoTrasl/datiCliente/recapitoFissoCliente, 'kk') or starts-with($ParseXml/request/accessoTrasl/da