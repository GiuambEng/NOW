                                    sqlStatement="SELECT CODIFICAOLOAGCOM, CODICEORDINEOLO&#xa;FROM BDS_1_CASEDATA_RICHIESTA&#xa;WHERE IDRICHIESTAOLO=?" xsi:type="jdbcPalette:JDBCQueryActivity">
