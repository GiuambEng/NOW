                        <bpws:source linkName="LogDecodeToJDBCQuery1_KO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$SecoloDecode/ns9:ESITO='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
