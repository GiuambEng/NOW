            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SecoloDecode-input"
                    name="SecoloDecode" outputVariable="SecoloDecode"
                    tibex:xpdlId="354f7f57-f869-474d-9576-26ec6b194e09"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToCallSecoloDecode"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SecoloDecodeToGenericLogger"/>
                        <bpws:source linkName="SecoloDecodeToJDBCQuery1"
                            tibex:faultDetailsVar="SecoloDecode" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;OperatoreSecolo&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;SecoloDecode-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RequestDecode_token>&#xa;            &lt;xsl:if test=&quot;$Richiesta/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                &lt;tns:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                &lt;/tns:CodificaOLOAGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/Record[1]/CODICEORDINEOLO&quot;>&#xa;                &lt;tns:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                &lt;/tns:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:Funzione>&#xa;                &lt;xsl:value-of select=&quot;'FFNOTF'&quot;/>&#xa;            &lt;/tns:Funzione>&#xa;            &lt;tns:ChiaveRiferimento>&#xa;                &lt;xsl:value-of select=&quot;concat($Richiesta/Record[1]/CODICEORDINEOLO,string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns:ChiaveRiferimento>&#xa;            &lt;tns:Operatore>&#xa;                &lt;xsl:value-of select=&quot;$OperatoreSecolo&quot;/>&#xa;            &lt;/tns:Operatore>&#xa;            &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                &lt;tns:IPClient>&#xa;                    &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                &lt;/tns:IPClient>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/tns1:Token&quot;>&#xa;                &lt;tns:Token>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Token&quot;/>&#xa;                &lt;/tns:Token>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:RequestDecode_token>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.batch.notifiche.subprocesses.CallSecoloDecode" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
