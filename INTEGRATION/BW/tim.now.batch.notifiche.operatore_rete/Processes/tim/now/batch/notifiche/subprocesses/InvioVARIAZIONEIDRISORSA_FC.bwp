            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns2:TracciamentoWSTIM2" tibex:xpdlId="7e694f27-6dda-4d00-b811-e5a1df0d5fd5">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:nslt3="temp_namespace" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="VarIdRisorsa"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($Mapper)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($VarIdRisorsa/variazioneIDRisorsa/nslt3:variazioneIDRisorsaResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/request/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$VarIdRisorsa/variazioneIDRisorsa/nslt3:variazioneIDRisorsaResponse/response/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/request/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo+1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/request/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/request/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;tns3:IdRisorsa&gt;&lt;xsl:value-of select="$ParseXml/request/accessoGponUpdate/idRisorsa"/&gt;&lt;/tns3:IdRisorsa&gt;&lt;xsl:if test="$ParseXml/request/accessoGponUpdate/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/request/accessoGponUpdate/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="3"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;/tns1:EventoOperatoreRete&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($VarIdRisorsa/variazioneIDRisorsa/nslt3:variazioneIDRisorsaResponse)"/&gt;&lt;/tns1:ContenutoResponse&gt;&lt;tns1:CodiceAckNack&gt;&lt;xsl:value-of select="$VarIdRisorsa/variazioneIDRisorsa/nslt3:variazioneIDRisorsaResponse/response/esito/codice"/&gt;&lt;/tns1:CodiceAckNack&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="concat($ParseXml/request/testata/idNotifica,&amp;quot;-&amp;quot;,$ParseXml/request/testata/idMessaggio)"/&gt;&lt;/tns1:TransactionId&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:nslt3=&quot;temp_namespace&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VarIdRisorsa.variazioneIDRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Mapper)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($VarIdRisorsa.variazioneIDRisorsa)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/request/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$VarIdRisorsa.variazioneIDRisorsa/response/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/request/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/request/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/request/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:IdRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/request/accessoGponUpdate/idRisorsa&quot;/>&#xa;                &lt;/tns3:IdRisorsa>&#xa;                &lt;xsl:if test=&quot;$ParseXml/request/accessoGponUpdate/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/request/accessoGponUpdate/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns1:EventoOperatoreRete>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StatoEsec>&#xa;            &lt;tns1:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($VarIdRisorsa.variazioneIDRisorsa)&quot;/>&#xa;            &lt;/tns1:ContenutoResponse>&#xa;            &lt;tns1:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$VarIdRisorsa.variazioneIDRisorsa/response/esito/codice&quot;/>&#xa;            &lt;/tns1:CodiceAckNack>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/request/testata/idNotifica,&amp;quot;-&amp;quot;,$ParseXml/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns1:IdEventoOrdineNowWhls>&#xa;        &lt;/tns1:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogVarToTracciamentoWSTIM2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Update&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvioVARIAZIONEIDRISORSA_FC'&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Processo terminato. Update effettuato: &amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Update/parameters/tns2:TracciamentoOutput)&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogUpdate-input" name="LogUpdate"
                    tibex:xpdlId="6644864a-20e0-4fd0-8f69-e3c60669ab8d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Update.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioVARIAZIONEIDRISORSA_FC'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Update.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TimstpInvio"
                    name="TimstpInvio" outputVariable="TimstpInvio"
                    tibex:xpdlId="2717e8f2-ffde-4bd8-ac54-33ceb44bc23f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMapToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToScope"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="current-dateTime()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="TimstpInvio" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
