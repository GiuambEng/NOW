                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" version="2.0"&gt;
