                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                    &lt;/tns1:StatoEsec&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="contains($FaultDetails/StackTrace,'TIBCO-BW-BINDING-SOAP-555030')"&gt;
                            &lt;tns1:DescrErrore&gt;
                                &lt;xsl:value-of select="'TIMEOUT'"/&gt;
                            &lt;/tns1:DescrErrore&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:DescrErrore&gt;
                                &lt;xsl:value-of select="'ERRORE INTERNO'"/&gt;
                            &lt;/tns1:DescrErrore&gt;
                        &lt;/xsl:otherwise&gt;
