                    &lt;tns1:IdEventoOrdineNowWhls&gt;
                        &lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;
                    &lt;/tns1:IdEventoOrdineNowWhls&gt;
                    &lt;tns1:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
