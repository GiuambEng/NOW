f select=&quot;'TIMEOUT'&quot;/>&#xa;                    &lt;/tns1:DescrErrore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:DescrErrore>&#xa;                        &lt;xsl:value-of select=&quot;'ERRORE INTERNO'&quot;/>&#xa;                    &lt;/tns1:DescrErrore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/request/testata/idNotifica,'-',$ParseXml/request/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns1:TransactionId>&#xa;            &lt;tns1:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns1:IdEventoOrdineNowWhls>&#xa;            &lt;tns1:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns1:IdProcsoNoFile>&#xa;            &lt;tns1:NumTentativo>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo+1)&quot;/>&#xa;            &lt;/tns1:NumTentativo>&#xa;            &lt;tns1:IdNotf>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/request/testata/idNotifica&quot;/>&#xa;            &lt;/tns1:IdNotf>&#xa;        &lt;/tns1:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
