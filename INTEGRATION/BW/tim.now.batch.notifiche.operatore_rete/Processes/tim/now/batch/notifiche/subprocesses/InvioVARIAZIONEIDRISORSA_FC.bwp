                    &lt;/tns1:NumTentativo&gt;
                    &lt;tns1:IdNotf&gt;
                        &lt;xsl:value-of select="$Mapper/request/testata/idNotifica"/&gt;
                    &lt;/tns1:IdNotf&gt;
                &lt;/tns1:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
