    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:template name="UpdateError-input" match="/"&gt;
        &lt;tns3:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:TracciamentoInput&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:IdEsecProcsoNoFile&gt;
                        &lt;xsl:value-of select="xsd:int($Procso_No_file/Record[1]/ID_ESEC_PROCSO_NO_FILE)"/&gt;
                    &lt;/tns2:IdEsecProcsoNoFile&gt;
                    &lt;xsl:if test="$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE"&gt;
                        &lt;tns2:CodProcsoFIle&gt;
                            &lt;xsl:value-of select="$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE"/&gt;
                        &lt;/tns2:CodProcsoFIle&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:StatoEsec&gt;
                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                    &lt;/tns2:StatoEsec&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="contains($FaultDetails/StackTrace,'TIBCO-BW-BINDING-SOAP-555030')"&gt;
                            &lt;tns2:DescrErrore&gt;
                                &lt;xsl:value-of select="'TIMEOUT'"/&gt;
                            &lt;/tns2:DescrErrore&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns2:DescrErrore&gt;
                                &lt;xsl:value-of select="'ERRORE INTERNO'"/&gt;
                            &lt;/tns2:DescrErrore&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns2:TransactionId&gt;
                        &lt;xsl:value-of select="concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)"/&gt;
                    &lt;/tns2:TransactionId&gt;
                    &lt;tns2:IdEventoOrdineNowWhls&gt;
                        &lt;xsl:value-of select="$Start/tns1:IdEventoOrdineNowWhls"/&gt;
                    &lt;/tns2:IdEventoOrdineNowWhls&gt;
                    &lt;tns2:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                    &lt;/tns2:IdProcsoNoFile&gt;
                    &lt;tns2:NumTentativo&gt;
                        &lt;xsl:value-of select="xsd:int($Start/tns1:NumTentativo+1)"/&gt;
                    &lt;/tns2:NumTentativo&gt;
                    &lt;tns2:IdNotf&gt;
                        &lt;xsl:value-of select="$Mapper/TestataFibercop/IdNotifica"/&gt;
                    &lt;/tns2:IdNotf&gt;
                &lt;/tns2:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns3:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Procso_No_file&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateError-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Procso_No_file/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;            &lt;/tns2:IdEsecProcsoNoFile>&#xa;            &lt;xsl:if test=&quot;$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns2:CodProcsoFIle>&#xa;                    &lt;xsl:value-of select=&quot;$Procso_No_file/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns2:CodProcsoFIle>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($FaultDetails/StackTrace,'TIBCO-BW-BINDING-SOAP-555030')&quot;>&#xa;                    &lt;tns2:DescrErrore>&#xa;                        &lt;xsl:value-of select=&quot;'TIMEOUT'&quot;/>&#xa;                    &lt;/tns2:DescrErrore>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:DescrErrore>&#xa;                        &lt;xsl:value-of select=&quot;'ERRORE INTERNO'&quot;/>&#xa;                    &lt;/tns2:DescrErrore>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns2:IdEventoOrdineNowWhls>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;            &lt;tns2:NumTentativo>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:NumTentativo+1)&quot;/>&#xa;            &lt;/tns2:NumTentativo>&#xa;            &lt;tns2:IdNotf>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/TestataFibercop/IdNotifica&quot;/>&#xa;            &lt;/tns2:IdNotf>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LogErrorToUpdateError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="UpdateErrorToGenericLogger"/>
                                    </bpws:sources>
                                </bpws:invoke>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateError&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogUpdateError-input"
                                    name="LogUpdateError"
                                    tibex:xpdlId="506c2d0b-2a57-4880-ab4a-ad0ad0c9dff5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="UpdateErrorToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogUpdateErrorToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateError.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError.parameters)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
