                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($DetokenizzazioneRecapiti/ns0:Referente[ns0:Esito='KO'])]]></bpws:transitionCondition>
                        </bpws:source>
