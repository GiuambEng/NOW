                        </bpws:targets>
                    </bpws:empty>
                    <bpws:invoke inputVariable="InvokeFC-input"
                        name="InvokeFC" operation="RichiestaFibercop"
                        outputVariable="InvokeFC"
                        partnerLink="OrdiniCommercialiOAOType"
                        portType="ns7:OrdiniCommercialiOAOType" tibex:xpdlId="8b8d6aab-1715-454e-b654-4387b4e83e55">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://ordinicommercialioao.service.fibercop.com/" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="InvokeFC-input" match="/"&gt;&lt;tns:RichiestaFibercop&gt;&lt;RichiestaFibercop&gt;&lt;xsl:copy-of select="$Mapper"/&gt;&lt;/RichiestaFibercop&gt;&lt;/tns:RichiestaFibercop&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommercialioao.service.fibercop.com/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeFC-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$Mapper&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <bpws:targets>
                            <bpws:target linkName="GroupStartToInvoke"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="InvokeToGroupEnd"/>
                        </bpws:sources>
                    </bpws:invoke>
                </bpws:flow>
            </bpws:scope>
            <bpws:invoke inputVariable="UpdateError_2-input"
                name="UpdateError_2" operation="Tracciamento"
                outputVariable="UpdateError_2"
                partnerLink="TracciamentoWSTIM2"
                portType="ns13:TracciamentoWSTIM2" tibex:xpdlId="7e152278-3471-402d-816f-cab7ce7c7c2a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/FFSubProcesses" version="2.0"&gt;
    &lt;xsl:param name="ParseXml"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="Procso_No_file_2"/&gt;
    &lt;xsl:param name="JDBCQuery"/&gt;
    &lt;xsl:template name="UpdateError_2-input" match="/"&gt;
        &lt;tns3:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:TracciamentoInput&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:IdEsecProcsoNoFile&gt;
                        &lt;xsl:value-of select="xsd:int($Procso_No_file_2/Record[1]/ID_ESEC_PROCSO_NO_FILE)"/&gt;
                    &lt;/tns2:IdEsecProcsoNoFile&gt;
                    &lt;xsl:if test="$Procso_No_file_2/Record[1]/COD_PROCSO_NO_FILE"&gt;
                        &lt;tns2:CodProcsoFIle&gt;
                            &lt;xsl:value-of select="$Procso_No_file_2/Record[1]/COD_PROCSO_NO_FILE"/&gt;
                        &lt;/tns2:CodProcsoFIle&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:StatoEsec&gt;
                        &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                    &lt;/tns2:StatoEsec&gt;
                    &lt;tns2:DescrErrore&gt;
                        &lt;xsl:value-of select="'ERRORE SECOLO'"/&gt;
                    &lt;/tns2:DescrErrore&gt;
                    &lt;tns2:TransactionId&gt;
                        &lt;xsl:value-of select="concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)"/&gt;
                    &lt;/tns2:TransactionId&gt;
                    &lt;tns2:IdEventoOrdineNowWhls&gt;
                        &lt;xsl:value-of select="$Start/tns1:IdEventoOrdineNowWhls"/&gt;
                    &lt;/tns2:IdEventoOrdineNowWhls&gt;
                    &lt;tns2:IdProcsoNoFile&gt;
                        &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                    &lt;/tns2:IdProcsoNoFile&gt;
                    &lt;tns2:NumTentativo&gt;
                        &lt;xsl:value-of select="xsd:int($Start/tns1:NumTentativo+1)"/&gt;
                    &lt;/tns2:NumTentativo&gt;
                    &lt;tns2:IdNotf&gt;
                        &lt;xsl:value-of select="xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)"/&gt;
                    &lt;/tns2:IdNotf&gt;
                &lt;/tns2:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns3:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Procso_No_file_2&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateError_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:IdEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Procso_No_file_2/Record[1]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;            &lt;/tns2:IdEsecProcsoNoFile>&#xa;            &lt;xsl:if test=&quot;$Procso_No_file_2/Record[1]/COD_PROCSO_NO_FILE&quot;>&#xa;                &lt;tns2:CodProcsoFIle>&#xa;                    &lt;xsl:value-of select=&quot;$Procso_No_file_2/Record[1]/COD_PROCSO_NO_FILE&quot;/>&#xa;                &lt;/tns2:CodProcsoFIle>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:DescrErrore>&#xa;                &lt;xsl:value-of select=&quot;'ERRORE SECOLO'&quot;/>&#xa;            &lt;/tns2:DescrErrore>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;tns2:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns2:IdEventoOrdineNowWhls>&#xa;            &lt;tns2:IdProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;            &lt;/tns2:IdProcsoNoFile>&#xa;            &lt;tns2:NumTentativo>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:NumTentativo+1)&quot;/>&#xa;            &lt;/tns2:NumTentativo>&#xa;            &lt;tns2:IdNotf>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&#xa;            &lt;/tns2:IdNotf>&#xa;        &lt;/tns2:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Procso_No_file_2ToTracciamentoWSTIM2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateError_2ToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateError_2&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore su SECOLO. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError_2/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogUpdateError_2-input"
                    name="LogUpdateError_2"
                    tibex:xpdlId="d17cdb7b-0f2e-48d8-96ec-fed51bb18d89"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateError_2ToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogUpdateError_2ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateError_2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore su SECOLO. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError_2.parameters)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="3eebf087-8406-4cc9-907e-2315e7672c15">
                <bpws:targets>
                    <bpws:target linkName="ScopeToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEnd">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Variable=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Variable=true()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToGenericLogger">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:nslt21=&quot;urn:PegaRULES:SOAP:OrdiniCommercialiOAO:Services&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeFC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInvokeFC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risposta GPON da FC: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeFC/OrdiniCommercialiResponseOAO/nslt21:responseOAO/risposta)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInvokeFC-input" name="LogInvokeFC"
                    tibex:xpdlId="e501a6ba-8dc4-46dd-95f7-dd65e6505f4f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInvokeFCToTracciamentoWSTIM2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:nslt21=&quot;urn:PegaRULES:SOAP:OrdiniCommercialiOAO:Services&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeFC.OrdiniCommercialiResponseOAO&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInvokeFC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risposta GPON da FC: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeFC.OrdiniCommercialiResponseOAO/risposta)&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns13:TracciamentoWSTIM2" tibex:xpdlId="8923bdf7-8152-4b42-8afb-cb74ddd1dfa5">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns5="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:tns1="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:nslt21="urn:PegaRULES:SOAP:OrdiniCommercialiOAO:Services" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="ParseXml"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:param name="TimstpInvio"/&gt;
    &lt;xsl:param name="InvokeFC"/&gt;
    &lt;xsl:param name="MapperUpdIDNOTF"/&gt;
    &lt;xsl:template name="Update-input" match="/"&gt;
        &lt;tns6:TracciamentoRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:TracciamentoInput&gt;
                    &lt;tns5:InsertUpdateStaging&gt;
                        &lt;tns2:ContenutoRequest&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapperUpdIDNOTF)"/&gt;
                        &lt;/tns2:ContenutoRequest&gt;
                        &lt;tns2:ContenutoResponse&gt;
                            &lt;xsl:value-of select="tib:render-xml($InvokeFC/OrdiniCommercialiResponseOAO/nslt21:responseOAO/risposta)"/&gt;
                        &lt;/tns2:ContenutoResponse&gt;
                        &lt;tns2:IdStatoElabStaging&gt;
                            &lt;xsl:value-of select="47"/&gt;
                        &lt;/tns2:IdStatoElabStaging&gt;
                        &lt;tns2:TimstpRisposta&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns2:TimstpRisposta&gt;
                        &lt;tns2:IdNotf&gt;
                            &lt;xsl:value-of select="$Mapper/TestataFibercop/IdNotifica"/&gt;
                        &lt;/tns2:IdNotf&gt;
                        &lt;tns2:CodiceAckNack&gt;
                            &lt;xsl:value-of select="$InvokeFC/OrdiniCommercialiResponseOAO/nslt21:responseOAO/risposta/esito/codice"/&gt;
                        &lt;/tns2:CodiceAckNack&gt;
                        &lt;tns2:IdEventoOrdnNowWhls&gt;
                            &lt;xsl:value-of select="$Start/tns1:IdEventoOrdineNowWhls"/&gt;
                        &lt;/tns2:IdEventoOrdnNowWhls&gt;
                        &lt;tns2:Transaction_ID&gt;
                            &lt;xsl:value-of select="$Start/tns1:IdRichOlo"/&gt;
                        &lt;/tns2:Transaction_ID&gt;
                        &lt;tns2:Azione&gt;
                            &lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;
                        &lt;/tns2:Azione&gt;
                        &lt;tns2:NumTentativo&gt;
                            &lt;xsl:value-of select="xsd:int($Start/tns1:NumTentativo + 1)"/&gt;
                        &lt;/tns2:NumTentativo&gt;
                        &lt;tns2:TimstpInvio&gt;
                            &lt;xsl:value-of select="$TimstpInvio"/&gt;
                        &lt;/tns2:TimstpInvio&gt;
                    &lt;/tns5:InsertUpdateStaging&gt;
                    &lt;tns5:EventoOperatoreRete&gt;
                        &lt;tns3:IdEventoOrdnNowWhls&gt;
                            &lt;xsl:value-of select="$Start/tns1:IdEventoOrdineNowWhls"/&gt;
                        &lt;/tns3:IdEventoOrdnNowWhls&gt;
                        &lt;tns3:IdNotf&gt;
                            &lt;xsl:value-of select="$Mapper/TestataFibercop/IdNotifica"/&gt;
                        &lt;/tns3:IdNotf&gt;
                        &lt;tns3:IdRichOlo&gt;
                            &lt;xsl:value-of select="$Start/tns1:IdRichOlo"/&gt;
                        &lt;/tns3:IdRichOlo&gt;
                        &lt;tns3:IdMessaggio&gt;
                            &lt;xsl:value-of select="$ParseXml/TestataFibercop/IdMessaggio"/&gt;
                        &lt;/tns3:IdMessaggio&gt;
                        &lt;tns3:TimstpInsmto&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns3:TimstpInsmto&gt;
                        &lt;tns3:IdEventoOperatoreRete&gt;
                            &lt;xsl:value-of select="2"/&gt;
                        &lt;/tns3:IdEventoOperatoreRete&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CAP"&gt;
                            &lt;tns3:Cap&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CAP"/&gt;
                            &lt;/tns3:Cap&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CF"&gt;
                            &lt;tns3:Cf&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CF"/&gt;
                            &lt;/tns3:Cf&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Civico"&gt;
                            &lt;tns3:Civico&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Civico"/&gt;
                            &lt;/tns3:Civico&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CodiceComune"&gt;
                            &lt;tns3:CodComune&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CodiceComune"/&gt;
                            &lt;/tns3:CodComune&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/CODICESPLITTERPRIMARIO"&gt;
                            &lt;tns3:CodSplitterPrimario&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/CODICESPLITTERPRIMARIO"/&gt;
                            &lt;/tns3:CodSplitterPrimario&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/CODICESPLITTERSECONDARIO"&gt;
                            &lt;tns3:CodSplitterSecondario&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/CODICESPLITTERSECONDARIO"/&gt;
                            &lt;/tns3:CodSplitterSecondario&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/CODICEROE"&gt;
                            &lt;tns3:CodRoe&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/CODICEROE"/&gt;
                            &lt;/tns3:CodRoe&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc"&gt;
                            &lt;tns3:CognomeRagSociale&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc"/&gt;
                            &lt;/tns3:CognomeRagSociale&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Complesso"&gt;
                            &lt;tns3:Complesso&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Complesso"/&gt;
                            &lt;/tns3:Complesso&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI) and string-length($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI)&gt;0"&gt;
                            &lt;tns3:DataDai&gt;
                                &lt;xsl:value-of select="tib:parse-date(&amp;quot;dd/mm/yyyy&amp;quot;,$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI)"/&gt;
                            &lt;/tns3:DataDai&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/IDGPON"&gt;
                            &lt;tns3:IdGpon&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/IDGPON"/&gt;
                            &lt;/tns3:IdGpon&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/IDEGON"&gt;
                            &lt;tns3:IdEgon&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/IDEGON"/&gt;
                            &lt;/tns3:IdEgon&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Interno"&gt;
                            &lt;tns3:Interno&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Interno"/&gt;
                            &lt;/tns3:Interno&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Localita"&gt;
                            &lt;tns3:Localita&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Localita"/&gt;
                            &lt;/tns3:Localita&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/Nome"&gt;
                            &lt;tns3:Nome&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/Nome"/&gt;
                            &lt;/tns3:Nome&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/POSIZIONEMORSETTIERAROE"&gt;
                            &lt;tns3:PosizMorsettieraRoe&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/POSIZIONEMORSETTIERAROE"/&gt;
                            &lt;/tns3:PosizMorsettieraRoe&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/DatiRete/POSIZIONESPLITTERSECONDARIO"&gt;
                            &lt;tns3:PosizSplitter&gt;
                                &lt;xsl:value-of select="$ParseXml/DatiRete/POSIZIONESPLITTERSECONDARIO"/&gt;
                            &lt;/tns3:PosizSplitter&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Piano"&gt;
                            &lt;tns3:Piano&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Piano"/&gt;
                            &lt;/tns3:Piano&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA"&gt;
                            &lt;tns3:Piva&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA"/&gt;
                            &lt;/tns3:Piva&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoMobileReferente"&gt;
                            &lt;tns3:RecapitoMobileCliente&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoMobileReferente"/&gt;
                            &lt;/tns3:RecapitoMobileCliente&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoFissoReferente"&gt;
                            &lt;tns3:RecapitoFissoCliente&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoFissoReferente"/&gt;
                            &lt;/tns3:RecapitoFissoCliente&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Scala"&gt;
                            &lt;tns3:Scala&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Scala"/&gt;
                            &lt;/tns3:Scala&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Via"&gt;
                            &lt;tns3:Via&gt;
                                &lt;xsl:value-of select="$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Via"/&gt;
                            &lt;/tns3:Via&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns3:IdOperatoreRete&gt;
                            &lt;xsl:value-of select="3"/&gt;
                        &lt;/tns3:IdOperatoreRete&gt;
                    &lt;/tns5:EventoOperatoreRete&gt;
                    &lt;tns5:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                    &lt;/tns5:Azione&gt;
                    &lt;tns5:StatoEsec&gt;
                        &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                    &lt;/tns5:StatoEsec&gt;
                    &lt;tns5:ContenutoResponse&gt;
                        &lt;xsl:value-of select="tib:render-xml($InvokeFC/OrdiniCommercialiResponseOAO/nslt21:responseOAO/risposta)"/&gt;
                    &lt;/tns5:ContenutoResponse&gt;
                    &lt;tns5:TransactionId&gt;
                        &lt;xsl:value-of select="concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)"/&gt;
                    &lt;/tns5:TransactionId&gt;
                    &lt;tns5:IdEventoOrdineNowWhls&gt;
                        &lt;xsl:value-of select="$Start/tns1:IdEventoOrdineNowWhls"/&gt;
                    &lt;/tns5:IdEventoOrdineNowWhls&gt;
                &lt;/tns5:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns6:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:nslt21=&quot;urn:PegaRULES:SOAP:OrdiniCommercialiOAO:Services&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeFC.OrdiniCommercialiResponseOAO&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperUpdIDNOTF&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:TracciamentoInput>&#xa;            &lt;tns5:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperUpdIDNOTF)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeFC.OrdiniCommercialiResponseOAO/risposta)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/TestataFibercop/IdNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeFC.OrdiniCommercialiResponseOAO/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns1:NumTentativo + 1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns5:InsertUpdateStaging>&#xa;            &lt;tns5:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/TestataFibercop/IdNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/IdMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CAP&quot;>&#xa;                    &lt;tns3:Cap>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CAP&quot;/>&#xa;                    &lt;/tns3:Cap>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CF&quot;>&#xa;                    &lt;tns3:Cf>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CF&quot;/>&#xa;                    &lt;/tns3:Cf>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Civico&quot;>&#xa;                    &lt;tns3:Civico>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Civico&quot;/>&#xa;                    &lt;/tns3:Civico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CodiceComune&quot;>&#xa;                    &lt;tns3:CodComune>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/CodiceComune&quot;/>&#xa;                    &lt;/tns3:CodComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/CODICESPLITTERPRIMARIO&quot;>&#xa;                    &lt;tns3:CodSplitterPrimario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/CODICESPLITTERPRIMARIO&quot;/>&#xa;                    &lt;/tns3:CodSplitterPrimario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/CODICESPLITTERSECONDARIO&quot;>&#xa;                    &lt;tns3:CodSplitterSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/CODICESPLITTERSECONDARIO&quot;/>&#xa;                    &lt;/tns3:CodSplitterSecondario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/CODICEROE&quot;>&#xa;                    &lt;tns3:CodRoe>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/CODICEROE&quot;/>&#xa;                    &lt;/tns3:CodRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc&quot;>&#xa;                    &lt;tns3:CognomeRagSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc&quot;/>&#xa;                    &lt;/tns3:CognomeRagSociale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Complesso&quot;>&#xa;                    &lt;tns3:Complesso>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Complesso&quot;/>&#xa;                    &lt;/tns3:Complesso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI) and string-length($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI)>0&quot;>&#xa;                    &lt;tns3:DataDai>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/mm/yyyy&amp;quot;,$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI)&quot;/>&#xa;                    &lt;/tns3:DataDai>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/IDGPON&quot;>&#xa;                    &lt;tns3:IdGpon>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/IDGPON&quot;/>&#xa;                    &lt;/tns3:IdGpon>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/IDEGON&quot;>&#xa;                    &lt;tns3:IdEgon>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/IDEGON&quot;/>&#xa;                    &lt;/tns3:IdEgon>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Interno&quot;>&#xa;                    &lt;tns3:Interno>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Interno&quot;/>&#xa;                    &lt;/tns3:Interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Localita&quot;>&#xa;                    &lt;tns3:Localita>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Localita&quot;/>&#xa;                    &lt;/tns3:Localita>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/Nome&quot;>&#xa;                    &lt;tns3:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/Nome&quot;/>&#xa;                    &lt;/tns3:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/POSIZIONEMORSETTIERAROE&quot;>&#xa;                    &lt;tns3:PosizMorsettieraRoe>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/POSIZIONEMORSETTIERAROE&quot;/>&#xa;                    &lt;/tns3:PosizMorsettieraRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/DatiRete/POSIZIONESPLITTERSECONDARIO&quot;>&#xa;                    &lt;tns3:PosizSplitter>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/DatiRete/POSIZIONESPLITTERSECONDARIO&quot;/>&#xa;                    &lt;/tns3:PosizSplitter>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Piano&quot;>&#xa;                    &lt;tns3:Piano>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Piano&quot;/>&#xa;                    &lt;/tns3:Piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA&quot;>&#xa;                    &lt;tns3:Piva>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA&quot;/>&#xa;                    &lt;/tns3:Piva>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoMobileReferente&quot;>&#xa;                    &lt;tns3:RecapitoMobileCliente>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoMobileReferente&quot;/>&#xa;                    &lt;/tns3:RecapitoMobileCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoFissoReferente&quot;>&#xa;                    &lt;tns3:RecapitoFissoCliente>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[1]/TelefonoFissoReferente&quot;/>&#xa;                    &lt;/tns3:RecapitoFissoCliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Scala&quot;>&#xa;                    &lt;tns3:Scala>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Scala&quot;/>&#xa;                    &lt;/tns3:Scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Via&quot;>&#xa;                    &lt;tns3:Via>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede/Via&quot;/>&#xa;                    &lt;/tns3:Via>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:IdOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                &lt;/tns3:IdOperatoreRete>&#xa;            &lt;/tns5:EventoOperatoreRete>&#xa;            &lt;tns5:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns5:Azione>&#xa;            &lt;tns5:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns5:StatoEsec>&#xa;            &lt;tns5:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($InvokeFC.OrdiniCommercialiResponseOAO/risposta)&quot;/>&#xa;            &lt;/tns5:ContenutoResponse>&#xa;            &lt;tns5:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($ParseXml/TestataFibercop/IdNotifica,'-',$ParseXml/TestataFibercop/IdMessaggio)&quot;/>&#xa;            &lt;/tns5:TransactionId>&#xa;            &lt;tns5:IdEventoOrdineNowWhls>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdEventoOrdineNowWhls&quot;/>&#xa;            &lt;/tns5:IdEventoOrdineNowWhls>&#xa;        &lt;/tns5:TracciamentoInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Mapper1ToUpdate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Update&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Update/parameters/tns2:TracciamentoOutput)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogUpdate-input" name="LogUpdate"
                    tibex:xpdlId="4e3cf0d4-ab80-4b83-bc16-bce1d06ad54c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Update.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioGPON_FC'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Update.parameters)&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperUpdIDNOTF-input"
                    name="MapperUpdIDNOTF"
                    outputVariable="MapperUpdIDNOTF"
                    tibex:xpdlId="fe40b01d-196f-4bd4-a27f-de47d71683a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInvokeFCToTracciamentoWSTIM2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper1ToUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommercialioao.service.fibercop.com/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;MapperUpdIDNOTF-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaFibercop>&lt;TestataFibercop>&lt;Canale>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/Canale&quot;/>&lt;/Canale>&lt;TipoEvento>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/TipoEvento&quot;/>&lt;/TipoEvento>&lt;IdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/IdMessaggio&quot;/>&lt;/IdMessaggio>&lt;DataMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/DataMessaggio&quot;/>&lt;/DataMessaggio>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/DataNotifica&quot;>&lt;DataNotifica>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/DataNotifica&quot;/>&lt;/DataNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/NomeFileRichiesta&quot;>&lt;NomeFileRichiesta>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/NomeFileRichiesta&quot;/>&lt;/NomeFileRichiesta>&lt;/xsl:if>&lt;IdNotifica>&lt;xsl:value-of select=&quot;$Mapper/TestataFibercop/IdNotifica&quot;/>&lt;/IdNotifica>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/StatoDisaggregazione&quot;>&lt;StatoDisaggregazione>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/StatoDisaggregazione&quot;/>&lt;/StatoDisaggregazione>&lt;/xsl:if>&lt;/TestataFibercop>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/NotificaOAO&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/DatiRete&quot;/>&lt;/tns:RichiestaFibercop>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ordinicommercialioao.service.fibercop.com="http://ordinicommercialioao.service.fibercop.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ordinicommercialioao.service.fibercop.com:RichiestaFibercop" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
