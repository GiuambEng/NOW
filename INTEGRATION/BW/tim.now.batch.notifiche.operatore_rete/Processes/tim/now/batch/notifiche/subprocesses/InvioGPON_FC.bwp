            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="3e213365-f6e6-4ee8-a158-f38e81fed1d5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDetokenToMapper_OK"/>
                        <bpws:target linkName="ParseXmlToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommercialioao.service.fibercop.com/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;DetokenizzazioneRecapiti&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaFibercop>&lt;TestataFibercop>&lt;Canale>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/Canale&quot;/>&lt;/Canale>&lt;TipoEvento>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/TipoEvento&quot;/>&lt;/TipoEvento>&lt;IdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/IdMessaggio&quot;/>&lt;/IdMessaggio>&lt;DataMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/DataMessaggio&quot;/>&lt;/DataMessaggio>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/DataNotifica&quot;>&lt;DataNotifica>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/DataNotifica&quot;/>&lt;/DataNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/NomeFileRichiesta&quot;>&lt;NomeFileRichiesta>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/NomeFileRichiesta&quot;/>&lt;/NomeFileRichiesta>&lt;/xsl:if>&lt;IdNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/IdNotifica>&lt;xsl:if test=&quot;$ParseXml/TestataFibercop/StatoDisaggregazione&quot;>&lt;StatoDisaggregazione>&lt;xsl:value-of select=&quot;$ParseXml/TestataFibercop/StatoDisaggregazione&quot;/>&lt;/StatoDisaggregazione>&lt;/xsl:if>&lt;/TestataFibercop>&lt;xsl:if test=&quot;exists($ParseXml/RichiestaOAO)&quot;>&lt;RichiestaOAO>&lt;Richiesta>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Testata&quot;/>&lt;Ordine>&lt;xsl:if test=&quot;exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione)&quot;>&lt;Attivazione>&lt;AccessoGPON>&lt;DataDAI>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DataDAI&quot;/>&lt;/DataDAI>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/DatiCliente&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Sede&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')])&quot;>&lt;xsl:for-each select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')]&quot;>&lt;Referente>&lt;xsl:variable name=&quot;var&quot; select=&quot;position()&quot;/>&lt;Progressivo>&lt;xsl:value-of select=&quot;Progressivo&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;QualificaRef&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;CognomeReferente&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;NomeReferente&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;NomeReferente&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[$var]/TelefonoFissoReferente]/tns1:TelefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[$var]/TelefonoFissoReferente]/tns1:TelefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[$var]/TelefonoMobileReferente]/tns1:TelefonoMobile&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[$var]/TelefonoMobileReferente]/tns1:TelefonoMobile&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;EmailReferente&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;EmailReferente&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[not(starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk'))]&quot;>&lt;Referente>&lt;Progressivo>&lt;xsl:value-of select=&quot;Progressivo&quot;/>&lt;/Progressivo>&lt;QualificaRef>&lt;xsl:value-of select=&quot;QualificaRef&quot;/>&lt;/QualificaRef>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;CognomeReferente&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;NomeReferente&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;NomeReferente&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoFissoReferente&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;TelefonoFissoReferente&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;EmailReferente&quot;>&lt;EmailReferente>&lt;xsl:value-of select=&quot;EmailReferente&quot;/>&lt;/EmailReferente>&lt;/xsl:if>&lt;/Referente>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente,'kk') or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente,'kk')&quot;>&lt;ReferenteOnField>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/CognomeReferente&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/NomeReferente&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/NomeReferente&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente]/tns1:TelefonoFisso&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente]/tns1:TelefonoFisso&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente]/tns1:TelefonoMobile&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$DetokenizzazioneRecapiti/tns1:Referente[tns1:Token=$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente]/tns1:TelefonoMobile&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/ReferenteOnField>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/CodiceDelivery&quot;>&lt;CodiceDelivery>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/CodiceDelivery&quot;/>&lt;/CodiceDelivery>&lt;/xsl:if>&lt;IdGPON>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/IdGPON&quot;/>&lt;/IdGPON>&lt;Coinvestimento>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Coinvestimento&quot;/>&lt;/Coinvestimento>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ServiziOpzionali&quot;/>&lt;TipologiaAccessoUBB>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/TipologiaAccessoUBB&quot;/>&lt;/TipologiaAccessoUBB>&lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferentiOAOProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferentiOAOProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/AccessoGPON>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/GestioneAutonomaImpresa&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/GestioneAutonomaOperatore&quot;/>&lt;/Attivazione>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Cessazione&quot;/>&lt;/Ordine>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/CancellazioneAccodamento&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Annullamento&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/RimodulazioneAppuntamento&quot;/>&lt;xsl:if test=&quot;exists($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione)&quot;>&lt;InterruzioneSospensione>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/CodiceOrdineFornitore&quot;/>&lt;/CodiceOrdineFornitore>&lt;DataAppuntamentoDesiderata>&lt;xsl:value-of