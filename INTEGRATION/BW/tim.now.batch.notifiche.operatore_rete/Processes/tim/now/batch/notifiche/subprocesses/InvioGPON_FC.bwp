            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ParseXml-input"
                    name="ParseXml" outputVariable="ParseXml"
                    tibex:xpdlId="a51b9b00-9ee5-4a5e-bc3e-dc7e0c3a814c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToParseXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ParseXmlToJDBCQuery1_DE-TOKEN">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') &#xd;&#xa;or starts-with(TelefonoMobileReferente, 'kk')]) &#xd;&#xa;or starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente,'kk') &#xd;&#xa;or starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente,'kk') &#xd;&#xa;or starts-with($ParseXml/NotificaOAO/AccessoGPON/DataAppuntamento/TelefonoReferenteContattato,'kk') &#xd;&#xa;or exists($ParseXml/NotificaOAO/AccessoGPON/TentativiContatto[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')])&#xd;&#xa;or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente,'kk') &#xd;&#xa;or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente,'kk')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') 
or starts-with(TelefonoMobileReferente, 'kk')]) 
or starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente,'kk') 
or starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente,'kk') 
or starts-with($ParseXml/NotificaOAO/AccessoGPON/DataAppuntamento/TelefonoReferenteContattato,'kk') 
or exists($ParseXml/NotificaOAO/AccessoGPON/TentativiContatto[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')])
or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente,'kk') 
or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente,'kk')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ParseXmlToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:xmlString>&#xa;            &lt;xsl:value-of select=&quot;$Start/tns1:ContenutoRequest&quot;/>&#xa;        &lt;/tns2:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.parsexml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:ordinicommercialioao.service.fibercop.com="http://ordinicommercialioao.service.fibercop.com/"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value inputStyle="text"
                                    outputElementQName="ordinicommercialioao.service.fibercop.com:RichiestaFibercop"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Richiesta-input"
                    name="Richiesta" outputVariable="Richiesta"
                    tibex:xpdlId="8919ceaf-9e98-4e7e-b19d-082db03a321b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ParseXmlToJDBCQuery1_DE-TOKEN"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RichiestaToDetokenizzazioneRecapiti"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8919ceaf-9e98-4e7e-b19d-082db03a321b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODIFICAOLOAGCOM, CODICEORDINEOLO&#xa;FROM BDS_1_CASEDATA_RICHIESTA&#xa;WHERE IDRICHIESTAOLO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="DetokenizzazioneRecapiti-input"
                    name="DetokenizzazioneRecapiti"
                    outputVariable="DetokenizzazioneRecapiti"
                    tibex:xpdlId="de16187e-1a67-42c3-a38d-6cdd1d7a183f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RichiestaToDetokenizzazioneRecapiti"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DetokenizzazioneRecapitiToGenericLogger"/>
                        <bpws:source
                            linkName="DetokenizzazioneRecapitiToProcso_No_file_2"
                            tibex:faultDetailsVar="DetokenizzazioneRecapiti" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;DetokenizzazioneRecapiti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputDetokenizzazioneRecapiti>&#xa;            &lt;tns1:IdRichiestaOlo>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;            &lt;/tns1:IdRichiestaOlo>&#xa;            &lt;tns1:CodificaOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;            &lt;/tns1:CodificaOloAgcom>&#xa;            &lt;tns1:CodiceOrdineOlo>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/Record[1]/CODICEORDINEOLO&quot;/>&#xa;            &lt;/tns1:CodiceOrdineOlo>&#xa;            &lt;xsl:if test=&quot;exists($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')])&quot;>&#xa;                &lt;xsl:for-each select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/Referente[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')]&quot;>&#xa;                    &lt;tns1:Referente>&#xa;                        &lt;xsl:if test=&quot;TelefonoFissoReferente&quot;>&#xa;                            &lt;tns1:TelefonoFisso>&#xa;                                &lt;xsl:value-of select=&quot;TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns1:TelefonoFisso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&#xa;                            &lt;tns1:TelefonoMobile>&#xa;                                &lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns1:TelefonoMobile>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:Referente>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente,'kk') or starts-with($ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente,'kk')&quot;>&#xa;                &lt;tns1:Referente>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente&quot;>&#xa;                        &lt;tns1:TelefonoFisso>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoFissoReferente&quot;/>&#xa;                        &lt;/tns1:TelefonoFisso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente&quot;>&#xa;                        &lt;tns1:TelefonoMobile>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/Ordine/Attivazione/AccessoGPON/ReferenteOnField/TelefonoMobileReferente&quot;/>&#xa;                        &lt;/tns1:TelefonoMobile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Referente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente,'kk') or starts-with($ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente,'kk')&quot;>&#xa;                &lt;tns1:Referente>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;>&#xa;                        &lt;tns1:TelefonoFisso>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;/>&#xa;                        &lt;/tns1:TelefonoFisso>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;>&#xa;                        &lt;tns1:TelefonoMobile>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/RichiestaOAO/Richiesta/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&#xa;                        &lt;/tns1:TelefonoMobile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Referente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;starts-with($ParseXml/NotificaOAO/AccessoGPON/DataAppuntamento/TelefonoReferenteContattato,'kk')&quot;>&#xa;                &lt;tns1:Referente>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/NotificaOAO/AccessoGPON/DataAppuntamento/TelefonoReferenteContattato&quot;>&#xa;                        &lt;tns1:TelefonoFisso>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaOAO/AccessoGPON/DataAppuntamento/TelefonoReferenteContattato&quot;/>&#xa;                        &lt;/tns1:TelefonoFisso>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Referente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseXml/NotificaOAO/AccessoGPON/TentativiContatto[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')])&quot;>&#xa;                &lt;xsl:for-each select=&quot;$ParseXml/NotificaOAO/AccessoGPON/TentativiContatto[starts-with(TelefonoFissoReferente, 'kk') or starts-with(TelefonoMobileReferente, 'kk')]&quot;>&#xa;                    &lt;tns1:Referente>&#xa;                        &lt;xsl:if test=&quot;TelefonoFissoReferente&quot;>&#xa;                            &lt;tns1:TelefonoFisso>&#xa;                                &lt;xsl:value-of select=&quot;TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns1:TelefonoFisso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&#xa;                            &lt;tns1:TelefonoMobile>&#xa;                                &lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns1:TelefonoMobile>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:Referente>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:InputDetokenizzazioneRecapiti>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.batch.notifiche.subprocesses.DetokenizzazioneRecapiti" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogDetoken-input"
                    name="LogDetoken"
                    tibex:xpdlId="40719686-da79-43fa-85bb-41148d730787"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DetokenizzazioneRecapitiToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDetokenToMapper_OK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogDetokenToJDBCQuery1_KO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($DetokenizzazioneRecapiti/ns0:Referente[ns0:Esito='KO'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
