                portType="ns3:TracciamentoWSTIM2" tibex:xpdlId="aca7f070-4ef1-4048-b425-4a22b54c83c1">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:nslt2="urn:PegaRULES:SOAP:OrdiniCommerciali:Services" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:tns2="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:tns4="http://www.tim.com/NOW/xsd/FFSubProcesses" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="Att"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="TimstpInvio"/&gt;&lt;xsl:param name="MapperUpdIDNOTF"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:InsertUpdateStaging&gt;&lt;tns2:ContenutoRequest&gt;&lt;xsl:value-of select="tib:render-xml($MapperUpdIDNOTF)"/&gt;&lt;/tns2:ContenutoRequest&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Att/attivazioneResponse/nslt2:attivazioneResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:IdStatoElabStaging&gt;&lt;xsl:value-of select="47"/&gt;&lt;/tns2:IdStatoElabStaging&gt;&lt;tns2:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns2:TimstpRisposta&gt;&lt;tns2:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns2:IdNotf&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Att/attivazioneResponse/nslt2:attivazioneResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns2:IdEventoOrdnNowWhls&gt;&lt;tns2:Transaction_ID&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns2:Transaction_ID&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:NumTentativo&gt;&lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo + 1)"/&gt;&lt;/tns2:NumTentativo&gt;&lt;tns2:CodiceOrdineFiberCop&gt;&lt;xsl:value-of select="$Att/attivazioneResponse/nslt2:attivazioneResponse/risposta/testata/codiceOrdineFCop"/&gt;&lt;/tns2:CodiceOrdineFiberCop&gt;&lt;tns2:TimstpInvio&gt;&lt;xsl:value-of select="$TimstpInvio"/&gt;&lt;/tns2:TimstpInvio&gt;&lt;/tns1:InsertUpdateStaging&gt;&lt;tns1:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/tns4:IdRichOlo"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$ParseXml/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/cap"&gt;&lt;tns3:Cap&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/cap"/&gt;&lt;/tns3:Cap&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale"&gt;&lt;tns3:Cf&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale"/&gt;&lt;/tns3:Cf&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/civico"&gt;&lt;tns3:Civico&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/civico"/&gt;&lt;/tns3:Civico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/codiceComune"&gt;&lt;tns3:CodComune&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/codiceComune"/&gt;&lt;/tns3:CodComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario"&gt;&lt;tns3:CodSplitterPrimario&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario"/&gt;&lt;/tns3:CodSplitterPrimario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario"&gt;&lt;tns3:CodSplitterSecondario&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario"/&gt;&lt;/tns3:CodSplitterSecondario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/codiceROE"&gt;&lt;tns3:CodRoe&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/codiceROE"/&gt;&lt;/tns3:CodRoe&gt;&lt;/xsl:if&gt;&lt;tns3:CognomeRagSociale&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/cognomeRagioneSociale"/&gt;&lt;/tns3:CognomeRagSociale&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/complesso"&gt;&lt;tns3:Complesso&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/complesso"/&gt;&lt;/tns3:Complesso&gt;&lt;/xsl:if&gt;&lt;tns3:DataDai&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/accessoGponLna/outSourcer/dataDAI)"/&gt;&lt;/tns3:DataDai&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI"&gt;&lt;tns3:FasciaOrariaDai&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI"/&gt;&lt;/tns3:FasciaOrariaDai&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/idGpon"&gt;&lt;tns3:IdGpon&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/idGpon"/&gt;&lt;/tns3:IdGpon&gt;&lt;/xsl:if&gt;&lt;tns3:IdEgon&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/codiceEgon"/&gt;&lt;/tns3:IdEgon&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/interno"&gt;&lt;tns3:Interno&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/interno"/&gt;&lt;/tns3:Interno&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/localita"&gt;&lt;tns3:Localita&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/localita"/&gt;&lt;/tns3:Localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/datiCliente/nome"&gt;&lt;tns3:Nome&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/nome"/&gt;&lt;/tns3:Nome&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;tns3:FlagProgettazione&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/progettazione"/&gt;&lt;/tns3:FlagProgettazione&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/posizioneMorsettieraROE"&gt;&lt;tns3:PosizMorsettieraRoe&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/posizioneMorsettieraROE"/&gt;&lt;/tns3:PosizMorsettieraRoe&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/posizioneSplitterSecondario"&gt;&lt;tns3:PosizSplitter&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/posizioneSplitterSecondario"/&gt;&lt;/tns3:PosizSplitter&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/piano"&gt;&lt;tns3:Piano&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/piano"/&gt;&lt;/tns3:Piano&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/datiCliente/partitaIva"&gt;&lt;tns3:Piva&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/partitaIva"/&gt;&lt;/tns3:Piva&gt;&lt;/xsl:if&gt;&lt;tns3:RecapitoMobileCliente&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente"/&gt;&lt;/tns3:RecapitoMobileCliente&gt;&lt;tns3:RecapitoFissoCliente&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente"/&gt;&lt;/tns3:RecapitoFissoCliente&gt;&lt;tns3:Riprogettazione&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/outSourcer/riprogettazione"/&gt;&lt;/tns3:Riprogettazione&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/scala"&gt;&lt;tns3:Scala&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/scala"/&gt;&lt;/tns3:Scala&gt;&lt;/xsl:if&gt;&lt;tns3:SlaAssurance&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/slaAssurance"/&gt;&lt;/tns3:SlaAssurance&gt;&lt;xsl:if test="$ParseXml/richiesta/accessoGponLna/sede/via"&gt;&lt;tns3:Via&gt;&lt;xsl:value-of select="$ParseXml/richiesta/accessoGponLna/sede/via"/&gt;&lt;/tns3:Via&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Att/attivazioneResponse/nslt2:attivazioneResponse/risposta/esito/codice='00'"&gt;&lt;tns3:IdStatoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdStatoOperatoreRete&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns3:IdStatoOperatoreRete&gt;&lt;xsl:value-of select="3"/&gt;&lt;/tns3:IdStatoOperatoreRete&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns3:IdOperatoreRete&gt;&lt;xsl:value-of select="3"/&gt;&lt;/tns3:IdOperatoreRete&gt;&lt;tns3:CodiceOrdineFiberCop&gt;&lt;xsl:value-of select="$Att/attivazioneResponse/nslt2:attivazioneResponse/risposta/testata/codiceOrdineFCop"/&gt;&lt;/tns3:CodiceOrdineFiberCop&gt;&lt;/tns1:EventoOperatoreRete&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Att/attivazioneResponse/nslt2:attivazioneResponse)"/&gt;&lt;/tns1:ContenutoResponse&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="concat($ParseXml/richiesta/testata/idNotifica,'-',$ParseXml/richiesta/testata/idMessaggio)"/&gt;&lt;/tns1:TransactionId&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$Start/tns4:IdEventoOrdineNowWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:OrdiniCommerciali:Services&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Att.attivazioneResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;TimstpInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperUpdIDNOTF&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:TracciamentoInput>&#xa;            &lt;tns1:InsertUpdateStaging>&#xa;                &lt;tns2:ContenutoRequest>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperUpdIDNOTF)&quot;/>&#xa;                &lt;/tns2:ContenutoRequest>&#xa;                &lt;tns2:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Att.attivazioneResponse)&quot;/>&#xa;                &lt;/tns2:ContenutoResponse>&#xa;                &lt;tns2:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;47&quot;/>&#xa;                &lt;/tns2:IdStatoElabStaging>&#xa;                &lt;tns2:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:TimstpRisposta>&#xa;                &lt;tns2:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns2:IdNotf>&#xa;                &lt;tns2:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Att.attivazioneResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns2:CodiceAckNack>&#xa;                &lt;tns2:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns2:IdEventoOrdnNowWhls>&#xa;                &lt;tns2:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns2:Transaction_ID>&#xa;                &lt;tns2:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns2:Azione>&#xa;                &lt;tns2:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/tns4:NumTentativo + 1)&quot;/>&#xa;                &lt;/tns2:NumTentativo>&#xa;                &lt;tns2:CodiceOrdineFiberCop>&#xa;                    &lt;xsl:value-of select=&quot;$Att.attivazioneResponse/risposta/testata/codiceOrdineFCop&quot;/>&#xa;                &lt;/tns2:CodiceOrdineFiberCop>&#xa;                &lt;tns2:TimstpInvio>&#xa;                    &lt;xsl:value-of select=&quot;$TimstpInvio&quot;/>&#xa;                &lt;/tns2:TimstpInvio>&#xa;            &lt;/tns1:InsertUpdateStaging>&#xa;            &lt;tns1:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdEventoOrdineNowWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns4:IdRichOlo&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/cap&quot;>&#xa;                    &lt;tns3:Cap>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/cap&quot;/>&#xa;                    &lt;/tns3:Cap>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;>&#xa;                    &lt;tns3:Cf>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;/>&#xa;                    &lt;/tns3:Cf>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/civico&quot;>&#xa;                    &lt;tns3:Civico>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/civico&quot;/>&#xa;                    &lt;/tns3:Civico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/codiceComune&quot;>&#xa;                    &lt;tns3:CodComune>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/codiceComune&quot;/>&#xa;                    &lt;/tns3:CodComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario&quot;>&#xa;                    &lt;tns3:CodSplitterPrimario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario&quot;/>&#xa;                    &lt;/tns3:CodSplitterPrimario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario&quot;>&#xa;                    &lt;tns3:CodSplitterSecondario>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario&quot;/>&#xa;                    &lt;/tns3:CodSplitterSecondario>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceROE&quot;>&#xa;                    &lt;tns3:CodRoe>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceROE&quot;/>&#xa;                    &lt;/tns3:CodRoe>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:CognomeRagSociale>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/cognomeRagioneSociale&quot;/>&#xa;                &lt;/tns3:CognomeRagSociale>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/sede/complesso&quot;>&#xa;                    &lt;tns3:Complesso>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede/complesso&quot;/>&#xa;                    &lt;/tns3:Complesso>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:DataDai>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$ParseXml/richiesta/accessoGponLna/outSourcer/dataDAI)&quot;/>&#xa;                &lt;/tns3:DataDai>&#xa;                &lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer/fasciaOrariaDAI&quot;>&#xa;                    &lt;tns3:FasciaOrariaDai>&#xa;                        &lt