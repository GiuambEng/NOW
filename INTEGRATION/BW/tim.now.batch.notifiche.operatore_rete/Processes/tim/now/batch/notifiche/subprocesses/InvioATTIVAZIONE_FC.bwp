                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FFSubProcesses&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UpdateError_2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateError_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.batch.notifiche.OperatoreRete.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvioATTIVAZIONE_FC'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IdRichOlo&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Processo terminato con errore su SECOLO. Update effettuato: &amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($UpdateError_2.parameters)&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TimstpInvio"
                    name="TimstpInvio" outputVariable="TimstpInvio"
                    tibex:xpdlId="ce9771ee-d18f-4d2a-847d-9ba58e9a7982" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMapToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToScope"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="current-dateTime()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="TimstpInvio" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperUpdIDNOTF-input"
                    name="MapperUpdIDNOTF"
                    outputVariable="MapperUpdIDNOTF"
                    tibex:xpdlId="e7fd483b-f4f7-46c5-a5ea-e84a04c19e47" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAttToMapper1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper1ToUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;MapperUpdIDNOTF-input&quot; match=&quot;/&quot;>&lt;tns:attivazione>&lt;richiesta>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatore&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatorePadre&quot;>&lt;codiceOrdineOperatorePadre>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatorePadre&quot;/>&lt;/codiceOrdineOperatorePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdMessaggio&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdNotifica&quot;/>&lt;/dataIdNotifica>&lt;idMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/tipoOrdine&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/servizio&quot;/>&lt;/servizio>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/Ex_FF&quot;>&lt;Ex_FF>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/Ex_FF&quot;/>&lt;/Ex_FF>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitato&quot;>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitato&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitante&quot;>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitante&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:if>&lt;/testata>&lt;xsl:copy-of select=&quot;$ParseXml/richiesta/accessoGponLna&quot;/>&lt;/richiesta>&lt;/tns:attivazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:ordinicommerciali.service.fibercop.com="http://ordinicommerciali.service.fibercop.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ordinicommerciali.service.fibercop.com:attivazione" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
