                    &lt;/tns1:StatoEsec&gt;
                    &lt;tns1:DescrErrore&gt;
                        &lt;xsl:value-of select="'ERRORE SECOLO'"/&gt;
                    &lt;/tns1:DescrErrore&gt;
                    &lt;tns1:TransactionId&gt;
                        &lt;xsl:value-of select="concat($ParseXml/richiesta/testata/idNotifica,'-',$ParseXml/richiesta/testata/idMessaggio)"/&gt;
