                    &lt;tns1:NumTentativo&gt;
                        &lt;xsl:value-of select="xsd:int($Start/tns4:NumTentativo+1)"/&gt;
                    &lt;/tns1:NumTentativo&gt;
                    &lt;tns1:IdNotf&gt;
                        &lt;xsl:value-of select="xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)"/&gt;
                    &lt;/tns1:IdNotf&gt;
                &lt;/tns1:TracciamentoInput&gt;
            &lt;/parameters&gt;
        &lt;/tns:TracciamentoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
