                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select COD_PROCSO_NO_FILE, ID_ESEC_PROCSO_NO_FILE from ESEC_PROCSO_NO_FILE where TRANSACTION_ID = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
