                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;SecoloDecode&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:attivazione>&lt;richiesta>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatore&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatorePadre&quot;>&lt;codiceOrdineOperatorePadre>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOrdineOperatorePadre&quot;/>&lt;/codiceOrdineOperatorePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdMessaggio&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/dataIdNotifica&quot;/>&lt;/dataIdNotifica>&lt;idMessaggio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/idMessaggio&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/tipoOrdine&quot;/>&lt;/tipoOrdine>&lt;servizio>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/servizio&quot;/>&lt;/servizio>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/Ex_FF&quot;>&lt;Ex_FF>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/Ex_FF&quot;/>&lt;/Ex_FF>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitato&quot;>&lt;codiceOperatoreOspitato>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitato&quot;/>&lt;/codiceOperatoreOspitato>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitante&quot;>&lt;codiceOperatoreOspitante>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/testata/codiceOperatoreOspitante&quot;/>&lt;/codiceOperatoreOspitante>&lt;/xsl:if>&lt;/testata>&lt;accessoGponLna>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/idGpon&quot;>&lt;idGpon>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/idGpon&quot;/>&lt;/idGpon>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/note&quot;/>&lt;/note>&lt;/xsl:if>&lt;progettazione>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/progettazione&quot;/>&lt;/progettazione>&lt;slaAssurance>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/slaAssurance&quot;/>&lt;/slaAssurance>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceROE&quot;>&lt;codiceROE>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceROE&quot;/>&lt;/codiceROE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario&quot;>&lt;codiceSplitterPrimario>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterPrimario&quot;/>&lt;/codiceSplitterPrimario>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario&quot;>&lt;codiceSplitterSecondario>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/codiceSplitterSecondario&quot;/>&lt;/codiceSplitterSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/posizioneMorsettieraROE&quot;>&lt;posizioneMorsettieraROE>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/posizioneMorsettieraROE&quot;/>&lt;/posizioneMorsettieraROE>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/posizioneSplitterSecondario&quot;>&lt;posizioneSplitterSecondario>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/posizioneSplitterSecondario&quot;/>&lt;/posizioneSplitterSecondario>&lt;/xsl:if>&lt;datiCliente>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;>&lt;codiceFiscale>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/codiceFiscale&quot;/>&lt;/codiceFiscale>&lt;/xsl:if>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/partitaIva&quot;>&lt;partitaIva>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/partitaIva&quot;/>&lt;/partitaIva>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente, 'kk') or starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente, 'kk')&quot;>&lt;recapitoFissoCliente>&lt;xsl:value-of select=&quot;$SecoloDecode/tns1:N_Recap_Cliente&quot;/>&lt;/recapitoFissoCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;recapitoFissoCliente>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente&quot;/>&lt;/recapitoFissoCliente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoFissoCliente, 'kk') or starts-with($ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente, 'kk')&quot;>&lt;recapitoMobileCliente>&lt;xsl:value-of select=&quot;$SecoloDecode/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/recapitoMobileCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;recapitoMobileCliente>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/datiCliente/recapitoMobileCliente&quot;/>&lt;/recapitoMobileCliente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/datiCliente>&lt;xsl:copy-of select=&quot;$ParseXml/richiesta/accessoGponLna/outSourcer&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/richiesta/accessoGponLna/sede&quot;/>&lt;armadioOttico>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/armadioOttico&quot;/>&lt;/armadioOttico>&lt;borchiaOttica>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/borchiaOttica&quot;/>&lt;/borchiaOttica>&lt;PosizioneMorsettieraAO>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/PosizioneMorsettieraAO&quot;/>&lt;/PosizioneMorsettieraAO>&lt;tipoRete>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/tipoRete&quot;/>&lt;/tipoRete>&lt;IdRisorsaTIM>&lt;xsl:value-of select=&quot;$ParseXml/richiesta/accessoGponLna/IdRisorsaTIM&quot;/>&lt;/IdRisorsaTIM>&lt;xsl:copy-of select=&quot;$ParseXml/richiesta/accessoGponLna/secondariaAggiuntiva&quot;/>&lt;/accessoGponLna>&lt;/richiesta>&lt;/tns:attivazione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
