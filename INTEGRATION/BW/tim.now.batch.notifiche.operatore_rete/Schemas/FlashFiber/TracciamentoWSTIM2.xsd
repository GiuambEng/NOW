<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:pref="http://www.tim.com/NOW/xsd/WSTIM2/"
	xmlns:pref1="http://www.tim.com/NOW/xsd/EONOWwhls"
	xmlns:tns="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2"
	elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2"
	xmlns:pref2="http://www.tim.com/NOW/xsd/WSTIM1/"
	xmlns:pref3="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:pref4="http://www.tim.com/NOW/xsd/EventoOperatoreRete">
	<import namespace="http://www.tim.com/NOW/xsd/WSTIM2/"
		schemaLocation="WSTIM2.xsd">
	</import>

	<import namespace="http://www.tim.com/NOW/xsd/EONOWwhls"
		schemaLocation="EONOWwhls.xsd" />
	<import schemaLocation="WSTIM1.xsd"
		namespace="http://www.tim.com/NOW/xsd/WSTIM1/">
	</import>
	<import schemaLocation="EONWStaging.xsd"
		namespace="http://www.tim.com/NOW/xsd/EONWStaging">
	</import>
	<import schemaLocation="EventoOperatoreRete.xsd" namespace="http://www.tim.com/NOW/xsd/EventoOperatoreRete"></import>
	<complexType name="TracciamentoInputType">
		<sequence>
			<element maxOccurs="1" minOccurs="0" ref="pref:OL" />

			<element ref="pref2:NotificaAttivazione_Cessazione"
				minOccurs="0">
			</element>
			<element ref="pref2:Rifiuto" minOccurs="0"></element>
			<element name="InsertUpdateStaging"
				type="pref3:InputInsertUpdate_type" minOccurs="0">
			</element>
			<element name="EventoOperatoreRete"
				type="pref4:InputEOR_Type" minOccurs="0">
			</element>
			<element name="Azione">
				<simpleType>
					<restriction base="string">
						<enumeration value="INSERT" />
						<enumeration value="UPDATE" />
					</restriction>
				</simpleType>
			</element>
			<element maxOccurs="1" minOccurs="0" name="EONW"
				type="pref1:input_type">
			</element>
			<element minOccurs="0" name="IdEsecProcsoNoFile"
				type="int">
			</element>
			<element minOccurs="0" name="CodProcsoFIle" type="string" />
			<element minOccurs="0" name="StatoEsec" type="string" />
			<element name="ContenutoResponse" type="string"
				minOccurs="0">
			</element>
			<element name="CodiceAckNack" type="string" minOccurs="0"></element>
			<element minOccurs="0" name="DescrErrore" type="string" />
			<element maxOccurs="1" minOccurs="0" name="TransactionId"
				type="string" />
			<element name="IdEventoOrdineNowWhls" type="int"
				minOccurs="0">
			</element>
			<element maxOccurs="1" minOccurs="0" name="IdProcsoNoFile"
				type="int" />


			<element name="NumTentativo" type="int" minOccurs="0"></element>
			<element name="IdNotf" type="string" minOccurs="0"></element>
		</sequence>
	</complexType>

	<element name="TracciamentoInput" type="tns:TracciamentoInputType" />

	<complexType name="TracciamentoOutputType">
		<sequence>
			<element name="IdEsecProcsoNoFile" type="string"
				minOccurs="0" maxOccurs="1">
			</element>
			<element name="CodProcsoNoFile" type="string" minOccurs="0"
				maxOccurs="1">
			</element>
			<element name="IdEventoOrdineWhls" type="int"
				minOccurs="0">
			</element>
		</sequence>
	</complexType>

	<element name="TracciamentoOutput"
		type="tns:TracciamentoOutputType" />
</schema>
