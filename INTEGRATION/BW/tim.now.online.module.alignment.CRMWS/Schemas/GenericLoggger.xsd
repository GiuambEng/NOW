<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="www.tim.now.genereciErrorGestioneSegnalazione">
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="ActivityName">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="In_All_Asset"/>
						<xs:enumeration value="Out_All_Asset"/>
						<xs:enumeration value="CheckLavorabilitaVlan"/>
						<xs:enumeration value="VerificaUnivocitaCVLAN"/>
						<xs:enumeration value="CheckOrdineIncorso"/>
						<xs:enumeration value="CheckLavorabilita"/>
						<xs:enumeration value="CheckLavorabilita_Numero"/>
						<xs:enumeration value="AllineamentoIdUllco_Async"/>
						<xs:enumeration value="AllineamentoIdUllco"/>
					</xs:restriction>
				</xs:simpleType>
				</xs:element>
				<xs:element minOccurs="0" name="Error" type="ErrorType"/>
				<xs:element minOccurs="0" name="ID_Esec_Proc" type="xs:string"/>
				<xs:element minOccurs="0" name="ProcessName" type="xs:string"/>
				<xs:element minOccurs="0" name="CorrelationID" type="xs:integer"/>
                <xs:element minOccurs="0"  name="ID_Esec_FromProcessID" type="xs:string"/>
                <xs:element minOccurs="0"  name="CRMTransactionID_Idullco" type="xs:string"/>
                <xs:element minOccurs="0"  name="CRMTransactionID_CheckLav" type="xs:string"/>
                <xs:element minOccurs="0"  name="ID_PROCSO_NOFILE" type="xs:int"/>
                 <xs:element minOccurs="0"  name="PID" type="xs:string"/>
            </xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="ErrorType">
		<xs:sequence>
			<xs:element minOccurs="0" name="ActivityName" type="xs:string"/>
			<xs:element minOccurs="0" name="Data">
				<xs:complexType>
					<xs:sequence>
						<xs:any minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="Msg" type="xs:string"/>
			<xs:element minOccurs="0" name="MsgCode" type="xs:string"/>
			<xs:element minOccurs="0" name="ProcessStack" type="xs:string"/>
			<xs:element minOccurs="0" name="StackTrace" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
		<xs:element name="Output">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="ErrorCode" type="xs:string"/>
				<xs:element minOccurs="0" name="ErrorDesc" type="xs:string"/>
				<xs:element minOccurs="0" name="IdEsecProcsoNoFile" type="xs:string"/>
				<xs:element minOccurs="0" name="CorrelationId" type="xs:integer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>