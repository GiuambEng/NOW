<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xs:schema xmlns="www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd" xmlns:tns3="http://NOW.it.telecomitalia.it/casedata" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd">
<xs:import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd"/>
	<xs:complexType name="AssetCRM_Type">
		<xs:sequence>
			<xs:element minOccurs="1" name="Servizio" type="xs:string"/>
			<xs:element minOccurs="1" name="TipoLinea" type="xs:string"/>
			<xs:element minOccurs="1" name="Modulazione" type="xs:string"/>
			<xs:element minOccurs="1" name="ProfiloTecnicoLinea" type="xs:string"/>
			<xs:element minOccurs="1" name="Tecnologia" type="xs:string"/>
			<xs:element minOccurs="0" name="MaxIdDettaglioAsset" type="xs:integer"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ATMVC_type">
		<xs:sequence>
			<xs:element minOccurs="1" name="VPI" type="xs:string"/>
			<xs:element minOccurs="1" name="VCI" type="xs:string"/>
			<xs:element minOccurs="0" name="VPISP" type="xs:string"/>
