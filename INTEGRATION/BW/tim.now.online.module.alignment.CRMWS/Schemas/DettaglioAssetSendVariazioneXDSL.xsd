	<xs:element name="Input_ATMVC">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" minOccurs="0" name="ATMVC" type="ATMVC_type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Input_GBEVC">
	<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="GBEVC" type="GBEVC_type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
