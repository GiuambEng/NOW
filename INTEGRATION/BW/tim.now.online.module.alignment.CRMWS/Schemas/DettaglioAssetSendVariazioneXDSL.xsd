			<xs:element minOccurs="0" name="IP_KIT" type="xs:string" />
			<xs:element minOccurs="0" name="IP_DSLAM" type="xs:string" />
			<xs:element minOccurs="0" name="DataEpletamentoVC"
				type="xs:string" />
			<xs:element minOccurs="0" name="CVlanId" type="xs:string" />
			<xs:element minOccurs="0" name="Protocollo_Pila"
				type="xs:string" />
			<xs:element minOccurs="0" name="Profilo_BMD"
				type="xs:string" />
            <xs:element name="TRASPORTO" type="xs:string" maxOccurs="1" minOccurs="0"></xs:element>
            <xs:element minOccurs="0" name="CheckFind" type="xs:string" />
		</xs:sequence>
		</xs:complexType>
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="Id_Offerta" type="xs:string" />
				<xs:element maxOccurs="unbounded" minOccurs="0" name="DettaglioAsset" type="tns3:DettaglioAsset"/>
				<xs:element minOccurs="0" name="AssetCRM" type="AssetCRM_Type"/>
				<xs:element maxOccurs="unbounded" minOccurs="0" name="ATMVC" type="ATMVC_type"/>
				<xs:element maxOccurs="6" minOccurs="0" name="GBEVC" type="GBEVC_type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Input_AttributoAsset">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" minOccurs="0" name="AttributiDettaglioAsset" type="tns3:AttributiDettaglioAsset"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Input_DettaglioAsset">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" minOccurs="0" name="DettaglioAsset" type="tns3:DettaglioAsset"/>
			</xs:sequence>
		</xs:complexType>
