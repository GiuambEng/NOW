			<xs:element minOccurs="0" name="CODICE_TD" type="xs:string"/>

            <xs:element maxOccurs="1" minOccurs="0" name="TRASPORTO" type="xs:string"/>
            <xs:element minOccurs="1" name="ID_RISORSA_VC" type="xs:string"/>
			<xs:element minOccurs="1" name="Stato" type="xs:string"/>
			<xs:element name="ProfiloVC">
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="Flag_ProfiloVC" type="xs:string"/>
						<xs:element minOccurs="1" name="TIPOPROFILOVC" type="xs:string"/>
						<xs:element minOccurs="0" name="MCR_DOWN" type="xs:string"/>
						<xs:element minOccurs="0" name="MCR_UP" type="xs:string"/>
						<xs:element minOccurs="0" name="PCR_DOWN" type="xs:string"/>
						<xs:element minOccurs="0" name="PCR_UP" type="xs:string"/>
						<xs:element minOccurs="0" name="SCR_DOWN" type="xs:string"/>
						<xs:element minOccurs="0" name="SCR_UP" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>

		</xs:sequence>
	</xs:complexType>
		<xs:complexType name="GBEVC_type">
		<xs:sequence>
			<xs:element minOccurs="1" name="Stato" type="xs:string" />
			<xs:element minOccurs="1" name="VPI" type="xs:string" />
			<xs:element minOccurs="1" name="VCI" type="xs:string" />
			<xs:element minOccurs="1" name="SVLANCODE" type="xs:string" />
			<xs:element minOccurs="1" name="IDRISORSAVC"
