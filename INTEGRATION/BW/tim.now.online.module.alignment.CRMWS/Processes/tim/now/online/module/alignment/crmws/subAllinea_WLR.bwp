            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogAccumulate-input"
                    name="LogAccumulate"
                    tibex:xpdlId="0819fe8e-8cea-4050-a181-36cad6990c98"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="While2ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAzzeraDettaglio"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;www.tim.now.dettaglio.asset.customizzato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'subAllineaServizio01_SHA'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Accumulate1)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While3" tibex:group="while" tibex:xpdlId="5e077af8-5cae-4964-b6e9-5eaecc317411">
                <bpws:targets>
                    <bpws:target linkName="UpdatedAggiuntiviToWhile3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While3ToEmpty4"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence3" tibex:group="while">
                    <bpws:assign name="GroupInit3"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+ca3d6ce1-d8bc-45c5-8d64-3aa3b5ca58cc" version="2.0"> <xsl:template name="Accumulate2" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate2"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while3" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ConteggioAggiuntiviRicevuti&lt;=count($Start/ns0:Aggiuntivi/ns0:Input)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioAggiuntiviRicevuti<=count($Start/ns0:Aggiuntivi/ns0:Input)]]></bpws:condition>
                        <bpws:flow name="flow4">
                            <bpws:links>
                                <bpws:link name="GroupStart3ToFalse" tibex:linkType="SUCCESS"/>
                                <bpws:link name="FalseToWhile4" tibex:linkType="SUCCESS"/>
                                <bpws:link name="While4ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty3ToGroupEnd1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Mapper2ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd11" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd11" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty3ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart3"
                                tibex:group="groupStart" tibex:xpdlId="2caa10f6-b086-421e-95cb-f9b7f13e2084">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart3ToFalse"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate2"
                                    outputVariable="Accumulate2"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="ca3d6ce1-d8bc-45c5-8d64-3aa3b5ca58cc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign1ToGroupEnd11"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>NewAggiuntivi</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="checkUpdatedAggiuntivi"
                                    name="False"
                                    outputVariable="checkUpdatedAggiuntivi"
                                    tibex:xpdlId="b29ba7c6-cc27-4201-b573-37622f14d2bb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart3ToFalse"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="FalseToWhile4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="'FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="checkUpdatedAggiuntivi" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="While4"
                                tibex:group="while" tibex:xpdlId="72fa0773-f068-4b71-90f9-20f5afe63c0d">
                                <bpws:targets>
                                    <bpws:target linkName="FalseToWhile4"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While4ToGroupEnd1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence4" tibex:group="while">
                                    <bpws:empty name="GroupInit4" tibex:group="groupInit"/>
                                    <bpws:while name="while4" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ConteggioDettAggiuntivi&lt;=count($Updated_Aggiuntivi/ns8:DettaglioAsset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioDettAggiuntivi<=count($Updated_Aggiuntivi/ns8:DettaglioAsset)]]></bpws:condition>
                                    <bpws:flow name="flow5">
