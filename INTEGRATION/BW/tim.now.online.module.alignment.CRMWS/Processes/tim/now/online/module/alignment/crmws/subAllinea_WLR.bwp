                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.dettaglio.asset.customizzato&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;checkUpdatedAggiuntivi&quot;/>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;Updated_Aggiuntivi&quot;/>&lt;xsl:param name=&quot;ConteggioDettAggiuntivi&quot;/>&lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$checkUpdatedAggiuntivi='UPDATE'&quot;>&lt;tns:DettaglioAsset_Customizzato>&lt;tns:LavorazioneDettaglio>&lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&lt;/tns:LavorazioneDettaglio>&lt;tns:IDAsset>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDAsset&quot;/>&lt;/tns:IDAsset>&lt;xsl:if test=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDDettaglioAssetParent&quot;>&lt;tns:IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDDettaglioAssetParent&quot;/>&lt;/tns:IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;>&lt;tns:IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;/>&lt;/tns:IDDettaglioAssetRoot>&lt;/xsl:if>&lt;tns:IntegrationID>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/integrationID&quot;/>&lt;/tns:IntegrationID>&lt;tns:created>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/created&quot;/>&lt;/tns:created>&lt;xsl:if test=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/lastUpdate&quot;>&lt;tns:lastUpdate>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/lastUpdate&quot;/>&lt;/tns:lastUpdate>&lt;/xsl:if>&lt;tns:operatore>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/operatore&quot;/>&lt;/tns:operatore>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDRisorsa&quot;/>&lt;/tns:IDRisorsa>&lt;tns:nomeComponente>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/nomeComponente&quot;/>&lt;/tns:nomeComponente>&lt;xsl:for-each select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/attributidettaglioasset&quot;>&lt;tns:attributidettaglioasset>&lt;tns:IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/tns:IDAsset>&lt;tns:created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/tns:created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;tns:lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/tns:lastUpdate>&lt;/xsl:if>&lt;tns:operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/tns:operatore>&lt;tns:nomeAttributo>&lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&lt;/tns:nomeAttributo>&lt;tns:valoreAttributo>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:valoreAttributo>&lt;tns:tipologiaDato>&lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&lt;/tns:tipologiaDato>&lt;tns:IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/tns:IDDettaglioAsset>&lt;/tns:attributidettaglioasset>&lt;/xsl:for-each>&lt;tns:IDRisorsaNOW>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDRisorsaNOW&quot;/>&lt;/tns:IDRisorsaNOW>&lt;tns:IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/IDDettaglioAsset&quot;/>&lt;/tns:IDDettaglioAsset>&lt;tns:statoDettaglioAsset>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/statoDettaglioAsset&quot;/>&lt;/tns:statoDettaglioAsset>&lt;tns:progressivo>&lt;xsl:value-of select=&quot;$Updated_Aggiuntivi/ns:DettaglioAsset[1]/progressivo&quot;/>&lt;