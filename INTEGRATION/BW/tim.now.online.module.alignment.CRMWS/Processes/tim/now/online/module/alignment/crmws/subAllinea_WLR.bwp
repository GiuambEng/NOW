            </bpws:extensionActivity>
            <bpws:scope name="While2" tibex:group="while" tibex:xpdlId="8560471a-d15f-4536-b9fc-285fcb838ad7">
                <bpws:targets>
                    <bpws:target linkName="AggiuntiviToWhile2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While2ToCallProcess"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index1"
                        sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="while">
                    <bpws:assign name="GroupInit2"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+4096407e-408c-4dfd-9b55-1c90a3bb227a" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate1"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while2" tibex:counterName="index1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ConteggioDettAggiuntivi&lt;=count($Aggiuntivi/ns7:DettaglioAsset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioDettAggiuntivi<=count($Aggiuntivi/ns7:DettaglioAsset)]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link name="GroupStart2ToWhile1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="While1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Mapper1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign2ToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="b45c1787-dd4c-4288-a423-4de096f9c9f5">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToWhile1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="4096407e-408c-4dfd-9b55-1c90a3bb227a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToGroupEnd1"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper1</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="While1"
                                tibex:group="while" tibex:xpdlId="d17a55fa-1a8c-403d-86ae-21aaf70f05fd">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToWhile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While1ToGroupEnd1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence1" tibex:group="while">
                                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                                    <bpws:while name="while1" tibex:counterName="index">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ConteggioAggiuntiviRicevuti&lt;=count($Start/ns0:Aggiuntivi/ns0:Input)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioAggiuntiviRicevuti<=count($Start/ns0:Aggiuntivi/ns0:Input)]]></bpws:condition>
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="AssignToUpdated_Aggiuntivi" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1Toupdated" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Updated_AggiuntiviToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Empty1Toindex" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart1"
                                    tibex:group="groupStart" tibex:xpdlId="05a9d306-7c09-4025-b935-fba915a4fcfa">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1Toupdated">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$Aggiuntivi/ns7:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo=$Start/ns0:Aggiuntivi/ns0:Input[number($ConteggioAggiuntiviRicevuti)]/ns0:Numero" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Aggiuntivi/ns7:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo=$Start/ns0:Aggiuntivi/ns0:Input[number($ConteggioAggiuntiviRicevuti)]/ns0:Numero]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToEmpty1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="acb8b2b6-6821-4844-9a18-766552eb5ada">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Updated_Aggiuntivi"
                                    name="Updated_Aggiuntivi"
                                    outputVariable="Updated_Aggiuntivi"
                                    tibex:xpdlId="f3caf5f9-e314-49e5-9647-aa6068b086ce" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToUpdated_Aggiuntivi"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Updated_AggiuntiviToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:ns2=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Aggiuntivi&quot;/>&lt;xsl:param name=&quot;ConteggioDettAggiuntivi&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ConteggioAggiuntiviRicevuti&quot;/>&lt;xsl:template name=&quot;Updated_Aggiuntivi&quot; match=&quot;/&quot;>&lt;ns1:Input_DettaglioAsset>&lt;ns1:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/nomeComponente&quot;/>&lt;/nomeComponente>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/created))>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/created&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'NUMEROTELEFONICO'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns2:Aggiuntivi/ns2:Input[number($ConteggioAggiuntiviRicevuti)]/ns2:Numero&quot;/>&lt;/valoreAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/tipologiaDato)>0&quot;>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/created))>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/created&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'NUMEROTELEFONICOPRINCIPALE'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDRisorsa&quot;/>&lt;/valoreAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/tipologiaDato)>0&quot;>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='NUMEROTELEFONICOPRINCIPALE']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='STATO']/created))>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='STATO']/created&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'STATO'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'ATTIVO'&quot;/>&lt;/valoreAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='STATO']/tipologiaDato)>0&quot;>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='STATO']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/valoreAttributo)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/created))>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/created&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/tipologiaDato)>0&quot;>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='RADICALE']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(xsd:string($Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/created))>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/created&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggiuntivi)]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$Aggiuntivi/ns:DettaglioAsset[number($ConteggioDettAggi