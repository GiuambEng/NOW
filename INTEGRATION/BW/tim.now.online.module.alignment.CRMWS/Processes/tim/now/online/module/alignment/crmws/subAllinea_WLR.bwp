                    inputVariable="UpdatedAggiuntivi-input"
                    name="UpdatedAggiuntivi"
                    outputVariable="UpdatedAggiuntivi"
                    tibex:xpdlId="26cc0a8b-6e7d-4ccc-ba62-963e63ef127a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AzzeraDettaglioToMapper2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdatedAggiuntiviToWhile3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($UpdatedAggiuntivi/ns8:DettaglioAsset[1]/nomeComponente)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($UpdatedAggiuntivi/ns8:DettaglioAsset[1]/nomeComponente)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdatedAggiuntiviToNew_Aggiuntivi">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:ns=&quot;www.tim.now.dettaglio.asset.customizzato&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate1&quot;/>&lt;xsl:template name=&quot;UpdatedAggiuntivi-input&quot; match=&quot;/&quot;>&lt;tns:Input_DettaglioAsset>&lt;xsl:for-each select=&quot;$Accumulate1/ns:DettaglioAsset_Customizzato[ns:LavorazioneDettaglio='Update']&quot;>&lt;tns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;ns:IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;ns:IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;ns:IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;ns:IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;ns:IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;ns:IntegrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;ns:created&quot;/>&lt;/created>&lt;xsl:if test=&quot;ns:lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;ns:lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;ns:operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;ns:IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;ns:nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:for-each select=&quot;ns:attributidettaglioasset&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;ns:IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;ns:created&quot;/>&lt;/created>&lt;xsl:if test=&quot;ns:lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;ns:lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;ns:operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;ns:nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;ns:valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;ns:tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;ns:IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:for-each>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;ns:IDRisorsaNOW&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;ns:IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;ns:statoDettaglioAsset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;ns:progressivo&quot;/>&lt;/progressivo>&lt;/tns:DettaglioAsset>&lt;/xsl:for-each>&lt;/tns:Input_DettaglioAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd="www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
