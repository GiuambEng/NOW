            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="8476334a-8760-4eb9-a31c-5b5d92a4d931">
                <bpws:targets>
                    <bpws:target linkName="Log_StartToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToChoice"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+dddd8770-78c7-4a16-8b60-69f67c11c44d" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter&lt;=count($Start/ns0:DettaglioAsset[nomeComponente='ACCESSOWLR']/attributidettaglioasset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter<=count($Start/ns0:DettaglioAsset[nomeComponente='ACCESSOWLR']/attributidettaglioasset)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="DettAssetULLToLog_DettAssetULL" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Log_DettAssetULLToChoice" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToChoice" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToDettAssetULL" tibex:linkType="SUCCESS"/>
                                <bpws:link name="IndexToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="DettAssetULLToIndex" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="1c47d02a-f1d0-404a-b532-20507d98da3d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToDettAssetULL"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="dddd8770-78c7-4a16-8b60-69f67c11c44d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="IndexToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="AttrDettaglioAssetSHA"
                                    name="Dettaglio"
                                    outputVariable="AttrDettaglioAssetSHA"
                                    tibex:xpdlId="81d4eeae-6e35-4d8c-93ea-1d49eb717425" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToDettAssetULL"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DettAssetULLToLog_DettAssetULL">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($AttrDettaglioAssetSHA/ns0:AttributiDettaglioAsset[1]/valoreAttributo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
