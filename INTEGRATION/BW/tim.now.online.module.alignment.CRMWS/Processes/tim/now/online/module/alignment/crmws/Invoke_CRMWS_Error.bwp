                <bpws:link name="SetExitToRepeat" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="Start"
                operation="Operation_1"
                partnerLink="InvokeCRMWS_SubProcess"
                portType="ns1:InvokeCRMWS_SubProcess"
                tibex:xpdlId="5eebaaeb-e699-497d-94ef-a2aaf923faa0" variable="Operation_1In">
                <bpws:sources>
                    <bpws:source linkName="StartToCallProcess"/>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="End" operation="Operation_1"
                partnerLink="InvokeCRMWS_SubProcess"
                portType="ns1:InvokeCRMWS_SubProcess"
                tibex:xpdlId="7630719d-d04d-4932-a953-9ffa56c26ff4" variable="Operation_1Out-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.now.subInvokeCRMWS" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd2" xmlns:ns1="www.tim.now.allineamentoConsistenze.invokeCRMWSEsito" version="2.0"&gt;&lt;xsl:param name="InvokeCRMWS"/&gt;&lt;xsl:param name="Check_Exit"/&gt;&lt;xsl:template name="Operation_1Out-input" match="/"&gt;&lt;tns:Output&gt;&lt;part1&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Check_Exit='True'"&gt;&lt;ns1:OutputCRMWS&gt;&lt;ns1:TransactionID&gt;&lt;xsl:value-of select="$InvokeCRMWS/RESPONSE/ns:RESPONSE/ns:TRANSACTION_ID"/&gt;&lt;/ns1:TransactionID&gt;&lt;ns1:TransactionDate&gt;&lt;xsl:value-of select="$InvokeCRMWS/RESPONSE/ns:RESPONSE/ns:RESPONSE_DATE"/&gt;&lt;/ns1:TransactionDate&gt;&lt;ns1:Return_Code&gt;&lt;xsl:value-of select="$InvokeCRMWS/RESPONSE/ns:RESPONSE/ns:RETURN_CODE"/&gt;&lt;/ns1:Return_Code&gt;&lt;xsl:if test="$InvokeCRMWS/RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"&gt;&lt;ns1:DescrizioneErrore&gt;&lt;xsl:value-of select="$InvokeCRMWS/RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_ERRORE"/&gt;&lt;/ns1:DescrizioneErrore&gt;&lt;/xsl:if&gt;&lt;/ns1:OutputCRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns1:OutputCRMWS&gt;&lt;ns1:TransactionID&gt;&lt;xsl:value-of select="'Null'"/&gt;&lt;/ns1:TransactionID&gt;&lt;/ns1:OutputCRMWS&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/part1&gt;&lt;/tns:Output&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.now.subInvokeCRMWS&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd2&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeCRMWS.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Check_Exit&quot;/>&#xa;    &lt;xsl:template name=&quot;Operation_1Out-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Check_Exit='True'&quot;>&#xa;                &lt;ns1:OutputCRMWS>&#xa;                    &lt;ns1:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMWS.RESPONSE/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns1:TransactionID>&#xa;                    &lt;ns1:TransactionDate>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMWS.RESPONSE/ns:RESPONSE_DATE&quot;/>&#xa;                    &lt;/ns1:TransactionDate>&#xa;                    &lt;ns1:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMWS.RESPONSE/ns:RETURN_CODE&quot;/>&#xa;                    &lt;/ns1:Return_Code>&#xa;                    &lt;xsl:if test=&quot;$InvokeCRMWS.RESPONSE/ns:DESCRIZIONE_ERRORE&quot;>&#xa;                        &lt;ns1:DescrizioneErrore>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeCRMWS.RESPONSE/ns:DESCRIZIONE_ERRORE&quot;/>&#xa;                        &lt;/ns1:DescrizioneErrore>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:OutputCRMWS>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:OutputCRMWS>&#xa;                    &lt;ns1:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                    &lt;/ns1:TransactionID>&#xa;                &lt;/ns1:OutputCRMWS>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="RepeatToEnd"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Operation_1In&quot;/>&lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Operation_1In/part1/ns:InputSubProcessCRMWS, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStart-input" name="LogStart"
                    tibex:xpdlId="8ab838ae-9e3b-42e3-be44-a642d8db58cd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToInvokeCRMWS"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Operation_1In.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Operation_1In.part1, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension expression="'False'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Check_Exit" name="SetExit"
                    outputVariable="Check_Exit"
                    tibex:xpdlId="c1c016c7-5ffd-4fa6-90cc-cbde1f15e921" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToInvokeCRMWS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetExitToRepeat"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Check_Exit" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="c8cbd8cb-35f2-4e3e-9e67-f0882ba6e25a">
                <bpws:targets>
                    <bpws:target linkName="SetExitToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index=$Tentativi or $Check_Exit='True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="InvokeCRMWSToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeCRMWSToSleep" tibex:linkType="ERROR"/>
                                <bpws:link name="SleepToRetry" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToLogEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToInvokeCRMWS" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RetryToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogEndToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="fa42ab8e-c9b4-451c-b867-aceae16f835d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvokeCRMWS"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="4921d41e-e991-4851-b410-578942630810">
                                <bpws:targets>
                                    <bpws:target linkName="RetryToGroupEnd"/>
                                    <bpws:target linkName="LogEndToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke
                                inputVariable="InvokeCRMWS-input"
                                name="InvokeCRMWS"
                                operation="CRMWSGetRiscontroConsistenza"
                                outputVariable="InvokeCRMWS"
                                partnerLink="PortType"
                                portType="ns2:PortType"
                                tibex:timeout="TimeoutInvoke" tibex:xpdlId="79098b78-b8c2-4c63-9e88-5342d4d75912">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="www.tim.now.allineamentoConsistenze.invokeCRMWSEsito" xmlns:tns="http://xmlns.example.com/1460623443671" xmlns:ns1="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd" version="2.0"&gt;&lt;xsl:param name="Operation_1In"/&gt;&lt;xsl:template name="InvokeCRMWS-input" match="/"&gt;&lt;tns:Request&gt;&lt;REQUEST&gt;&lt;ns1:REQUEST&gt;&lt;ns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Operation_1In/part1/ns:InputSubProcessCRMWS/ns:TransactionID"/&gt;&lt;/ns1:TRANSACTION_ID&gt;&lt;ns1:TRANSACTION_DATE&gt;&lt;xsl:value-of select="$Operation_1In/part1/ns:InputSubProcessCRMWS/ns:TransactionDate"/&gt;&lt;/ns1:TRANSACTION_DATE&gt;&lt;ns1:RETURN_CODE&gt;&lt;xsl:value-of select="$Operation_1In/part1/ns:InputSubProcessCRMWS/ns:Return_Code"/&gt;&lt;/ns1:RETURN_CODE&gt;&lt;xsl:if test="$Operation_1In/part1/ns:InputSubProcessCRMWS/ns:DescrizioneErrore"&gt;&lt;ns1:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$Operation_1In/part1/ns:InputSubProcessCRMWS/ns:DescrizioneErrore"/&gt;&lt;/ns1:DESCRIZIONE_ERRORE&gt;&lt;/xsl:if&gt;&lt;/ns1:REQUEST&gt;&lt;/REQUEST&gt;&lt;/tns:Request&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:tns=&quot;http://xmlns.example.com/1460623443671&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Operation_1In.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeCRMWS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:REQUEST>&#xa;            &lt;ns1:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns:TransactionID&quot;/>&#xa;            &lt;/ns1:TRANSACTION_ID>&#xa;            &lt;ns1:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns:TransactionDate&quot;/>&#xa;            &lt;/ns1:TRANSACTION_DATE>&#xa;            &lt;ns1:RETURN_CODE>&#xa;                &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns:Return_Code&quot;/>&#xa;            &lt;/ns1:RETURN_CODE>&#xa;            &lt;xsl:if test=&quot;$Operation_1In.part1/ns:DescrizioneErrore&quot;>&#xa;                &lt;ns1:DESCRIZIONE_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns:DescrizioneErrore&quot;/>&#xa;                &lt;/ns1:DESCRIZIONE_ERRORE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns1:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvokeCRMWS"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeCRMWSToCallProcess"/>
                                    <bpws:source
                                    linkName="InvokeCRMWSToSleep"
                                    tibex:faultDetailsVar="InvokeCRMWS" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;InvokeCRMWS&quot;/>&lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvokeCRMWS_SubProcess'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($InvokeCRMWS/RESPONSE/ns1:RESPONSE, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogEnd-input"
                                    name="LogEnd"
                                    tibex:xpdlId="a3cf1e4a-fc22-4718-91a0-af66c47f198a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToLogEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogEndToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetRiscontroConsistenza/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeCRMWS.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEnd-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'InvokeCRMWS_SubProcess'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeCRMWS.RESPONSE, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Sleep&quot;/>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;$Sleep&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Sleep-input"
                                    name="Sleep"
                                    tibex:xpdlId="75c26305-b085-4b16-936e-dca067918997" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeCRMWSToSleep"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SleepToRetry"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sleep/xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Sleep&quot;/>&lt;xsl:template name=&quot;Sleep-input&quot; match=&quot;/&quot;>&lt;tns:SleepInputSchema>&lt;IntervalInMillisec>&lt;xsl:value-of select=&quot;$Sleep&quot;/>&lt;/IntervalInMillisec>&lt;/tns:SleepInputSchema>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.sleep"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Sleep"/>
                                    <value xsi:type="generalactivities:Sleep"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="'True'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Check_Exit"
                                    name="Up_Exit"
                                    outputVariable="Check_Exit"
                                    tibex:xpdlId="2ac974ab-4821-4497-b8c7-6a4f0e3dce3a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeCRMWSToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToLogEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="'True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Check_Exit" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Tentativi&quot;/>&lt;xsl:template name=&quot;Retry-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvokeCRMWS_SubProcess'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**NumeroTentativi: ',xsd:string($Tentativi),'**Retry numero: ',string($index))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Retry-input"
                                    name="Retry"
                                    tibex:xpdlId="9d3ee174-344a-4744-9439-bc660f02a23a"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SleepToRetry"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RetryToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Tentativi&quot;/>&lt;xsl:template name=&quot;Retry-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'InvokeCRMWS_SubProcess'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('**NumeroTentativi: ',xsd:string($Tentativi),'**Retry numero: ',string($index))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index=$Tentativi or $Check_Exit='True']]></bpws:condition>
                    </bpws:repeatUntil>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
