            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOWSendIDULLCOoloIn&quot;/>&lt;xsl:param name=&quot;ProcessIstance&quot;/>&lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;insStagIDullco-input&quot; match=&quot;/&quot;>&lt;ns2:INPUT>&lt;ns2:Insert>&lt;ns2:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request)&quot;/>&lt;/ns2:CONTENUTO_REQUEST>&lt;ns2:OLO>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:OPERATORE&quot;/>&lt;/ns2:OLO>&lt;ns2:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE,'.'))&quot;/>&lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&lt;ns2:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:Transaction_id&quot;/>&lt;/ns2:ID_RICH_CLC_IDULLCO>&lt;ns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&lt;/ns2:ID_STATO_ELAB_STAG>&lt;ns2:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns2:TIMSTP_RICH>&lt;ns2:IDULLCO>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:IDULLCO&quot;/>&lt;/ns2:IDULLCO>&lt;ns2:CLLI>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:CLLI&quot;/>&lt;/ns2:CLLI>&lt;ns2:DATA_CONSEGNA_OLO>&lt;xsl:value-of select=&quot;format-date($NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:DATA_CONSEGNA_OLO, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns2:DATA_CONSEGNA_OLO>&lt;ns2:DATA_FINE_VALIDITA>&lt;xsl:value-of select=&quot;format-date($NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:DATA_FINE_VALIDITA, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns2:DATA_FINE_VALIDITA>&lt;ns2:DATA_INVIO>&lt;xsl:value-of select=&quot;format-date($NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:DATA_INVIO, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns2:DATA_INVIO>&lt;ns2:NOME>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:Nome&quot;/>&lt;/ns2:NOME>&lt;xsl:if test=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:DRCP&quot;>&lt;ns2:DRCP>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:DRCP&quot;/>&lt;/ns2:DRCP>&lt;/xsl:if>&lt;ns2:COD_GAT>&lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn/part1/tns1:Now_SendIdullco_Request/tns1:Codice_GAT&quot;/>&lt;/ns2:COD_GAT>&lt;ns2:PID>&lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&lt;/ns2:PID>&lt;/ns2:Insert>&lt;/ns2:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
