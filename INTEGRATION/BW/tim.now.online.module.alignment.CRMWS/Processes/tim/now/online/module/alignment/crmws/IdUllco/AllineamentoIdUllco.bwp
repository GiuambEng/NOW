                portType="ns5:ProcessLog" tibex:xpdlId="f3c4eb88-c266-447c-a3c6-49d91cde87bf">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;
    &lt;xsl:param name="IdProcsoNoFIle"/&gt;
    &lt;xsl:template name="ProcessIstance-input" match="/"&gt;
        &lt;tns:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:ProcFile/&gt;
                    &lt;ns:FileProcessato/&gt;
                    &lt;ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:CorrelationID&gt;
                            &lt;ns:Mode&gt;
                                &lt;xsl:value-of select="&amp;quot;CREATE&amp;quot;"/&gt;
                            &lt;/ns:Mode&gt;
                        &lt;/ns:CorrelationID&gt;
                        &lt;ns:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFIle"/&gt;
                        &lt;/ns:ID_PROCSO_NO_FILE&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns:EsecuzioneNOFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFIle&quot;/>&#xa;    &lt;xsl:template name=&quot;ProcessIstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile/>&#xa;            &lt;ns:FileProcessato/>&#xa;            &lt;ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;ns:Mode>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CREATE&amp;quot;&quot;/>&#xa;                    &lt;/ns:Mode>&#xa;                &lt;/ns:CorrelationID>&#xa;                &lt;ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFIle&quot;/>&#xa;                &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneNOFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
