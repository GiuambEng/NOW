                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns2=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWSendIDULLCOoloIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessIstance.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RicevutaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;insStagIDullco-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:INPUT>&#xa;            &lt;ns2:Insert>&#xa;                &lt;ns2:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($NOWSendIDULLCOoloIn.part1)&quot;/>&#xa;                &lt;/ns2:CONTENUTO_REQUEST>&#xa;                &lt;ns2:OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn.part1/tns1:OPERATORE&quot;/>&#xa;                &lt;/ns2:OLO>&#xa;                &lt;ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($ProcessIstance.part1/ns:Esito/ns:ID_ESEC_PROCSO_NOFILE,'.'))&quot;/>&#xa;                &lt;/ns2:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns2:ID_RICH_CLC_IDULLCO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWSendIDULLCOoloIn.part1/tns1:Transaction_id&quot;/>&#xa;                &lt;/ns2:ID_RICH_CLC_IDULLCO>&#xa;                &lt;ns2:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$RicevutaRichiesta&quot;/>&#xa;                &lt;/ns2:ID_STATO_ELAB_STAG>&#xa;                &lt;ns2:TIMSTP_RICH>&#xa;                    &