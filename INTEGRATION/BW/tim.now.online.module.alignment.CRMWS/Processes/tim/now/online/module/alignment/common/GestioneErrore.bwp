                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToErrorIdullCo_ASync">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InvokeIn/part1/ns3:Input/ns3:ActivityName='AllineamentoIdUllco_Async'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InvokeIn.part1/ns3:ActivityName='AllineamentoIdUllco_Async']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (contains($ProcessID.part1/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE, '.')) then xsd:integer(substring-before($ProcessID.part1/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE,'.')) else $ProcessID.part1/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
