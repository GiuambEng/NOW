                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InvokeIn.part1/ns3:ActivityName='In_All_Asset']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SetIDFromProcessIDToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
