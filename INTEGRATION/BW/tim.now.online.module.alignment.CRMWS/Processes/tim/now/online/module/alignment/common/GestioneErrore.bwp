            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (contains($ProcessID/part1/ns4:Output/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE, '.')) then xsd:integer(substring-before($ProcessID/part1/ns4:Output/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE,'.')) else $ProcessID/part1/ns4:Output/ns4:Esito/ns4:ID_ESEC_PROCSO_NOFILE"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="ID_ESEC_FromProcessID"
                    name="SetIDFromProcessID"
                    outputVariable="ID_ESEC_FromProcessID"
                    tibex:xpdlId="4174dedb-fff9-40b1-b1a7-59a2483f4b99" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetIDFromStartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SetIDFromProcessIDToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
