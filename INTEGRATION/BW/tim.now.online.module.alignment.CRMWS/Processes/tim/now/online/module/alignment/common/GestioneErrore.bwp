                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Error" tibex:xpdlId="ded41ca5-6dc3-49d8-96e3-a7857e58428b">
                <bpws:targets>
                    <bpws:target linkName="ProcessIDToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ErrorToGenericLog"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;GenericLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;concat('GestioneErrore:' ,$InvokeIn/part1/ns:Input/ns:ActivityName)&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:PID&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:PID&quot;/>&lt;/tns:MsgCode>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($_error, true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="GenericLog-input" name="GenericLog"
                    tibex:xpdlId="c02b2c84-3b69-4c6f-a264-d0dd02428db1"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ErrorToGenericLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;concat('GestioneErrore:' ,$InvokeIn.part1/ns:ActivityName)&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.part1/ns:PID&quot;>&#xa;                    &lt;tns:MsgCode>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.part1/ns:PID&quot;/>&#xa;                    &lt;/tns:MsgCode>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($_error, true(),true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeIn&quot;/>&lt;xsl:param name=&quot;ID_ESEC_start&quot;/>&lt;xsl:param name=&quot;ID_ESEC_FromProcessID&quot;/>&lt;xsl:template name=&quot;Input_AllAsset-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;>&lt;ns:ActivityName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ActivityName&quot;/>&lt;/ns:ActivityName>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$InvokeIn/part1/ns:Input/ns:Error&quot;/>&lt;ns:ID_Esec_Proc>&lt;xsl:value-of select=&quot;$ID_ESEC_start&quot;/>&lt;/ns:ID_Esec_Proc>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;>&lt;ns:ProcessName>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ProcessName&quot;/>&lt;/ns:ProcessName>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;>&lt;ns:CorrelationID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:CorrelationID&quot;/>&lt;/ns:CorrelationID>&lt;/xsl:if>&lt;ns:ID_Esec_FromProcessID>&lt;xsl:value-of select=&quot;$ID_ESEC_FromProcessID&quot;/>&lt;/ns:ID_Esec_FromProcessID>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:ID_PROCSO_NOFILE&quot;>&lt;ns:ID_PROCSO_NOFILE>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:ID_PROCSO_NOFILE&quot;/>&lt;/ns:ID_PROCSO_NOFILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$InvokeIn/part1/ns:Input/ns:PID&quot;>&lt;ns:PID>&lt;xsl:value-of select=&quot;$InvokeIn/part1/ns:Input/ns:PID&quot;/>&lt;/ns:PID>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Input_AllAsset-input"
                    name="Input_AllAsset"
                    tibex:xpdlId="0ff70b43-ff19-4b7e-9199-0df88f7914ea"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SetIDFromProcessIDToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
