        <bpws:variable element="ns12:resultSet" name="JDBC_NORecord" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:NOW_CheckLavorabilita_Numero_Out"
            name="Response-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:NOW_CheckLavorabilita_Numero_Out"
            name="Response" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:jdbcQueryActivityInput"
            name="JDBC_NoLavorazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns15:resultSet"
            name="JDBC_NoLavorazione" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Now_CheckLavorabilitaNumero_Input"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:NOW_CheckLavorabilita_Numero_Out" name="Var_Response"/>
        <bpws:variable element="ns0:NOW_CheckLavorabilita_Numero_Out"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="Log_NoLavorazione_1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="Log_JDBC_NORecord-input" sca-bpel:internal="true"/>
        <bpws:variable name="CountNoRecord" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="CountNOLav" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Jdbc/Timeout" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToStartLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="ForEach1ToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="While1ToWhile2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="While2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToWhile1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProc_CheckLavorabilitaNumero'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$Start/tns1:PID&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$Start/tns1:PID&quot;/>&lt;/tns:MsgCode>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('StartSubProcessCheckNumero' , tib:render-xml(($Start), true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartLog-input" name="StartLog"
                    tibex:xpdlId="dbb5130f-4e09-4671-a06b-22515533df26"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToStartLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToWhile1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProc_CheckLavorabilitaNumero'&quot;/>&lt;/tns:Process>&lt;xsl:if test=&quot;$Start/tns1:PID&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$Start/tns1:PID&quot;/>&lt;/tns:MsgCode>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('StartSubProcessCheckNumero' , tib:render-xml(($Start), true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="f189e158-6f24-43a2-9559-d52a53f1ca5e"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToStartLog"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Numero_Out>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Var_Response/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Var_Response/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Var_Response/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Var_Response/tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Var_Response/tns:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:NOW_CheckLavorabilita_Numero_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="d19c73bd-bfac-46f0-a115-accd15a98d60" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ForEach1ToEnd"/>
                        <bpws:target linkName="While2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Numero_Out>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Var_Response/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Var_Response/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Var_Response/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Var_Response/tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Var_Response/tns:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:NOW_CheckLavorabilita_Numero_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="3c5dd4cf-3ae7-4f52-8860-718ca670952f">
                <bpws:targets>
                    <bpws:target linkName="StartLogToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ForEach1ToEnd">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="While1ToWhile2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($JDBC_NoLavorazione/Record) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($JDBC_NoLavorazione/Record) = 0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence2" tibex:group="while">
                    <bpws:empty name="GroupInit2" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index = $CountNOLav" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index = $CountNOLav]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="JDBCQuery1ToLog_NoLavorazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign2ToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="NoLavorazioneToResponse" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToJDBC_NoLavorazione" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ResponseToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBC_NoLavorazioneToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="CallProcessToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Count_1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Log_NoLavorazioneToAssign2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="af334a09-9273-41dc-9167-94604337e4d4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBC_NoLavorazione"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="bdf2f265-c25a-4702-935c-92f2f07ccd7f">
                                <bpws:targets>
                                    <bpws:target linkName="ResponseToGroupEnd"/>
                                    <bpws:target linkName="Count_1ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_Response&quot;/>&lt;xsl:template name=&quot;Response-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Numero_Out>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Var_Response/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Var_Response/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Var_Response/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Var_Response/tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Var_Response/tns:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:NOW_CheckLavorabilita_Numero_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Response-input"
                                    name="Response"
                                    outputVariable="Response"
                                    tibex:xpdlId="e429d002-a377-4100-80d5-1b172eb8de05" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="NoLavorazioneToResponse"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ResponseToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_Response&quot;/>&lt;xsl:template name=&quot;Response-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Numero_Out>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Var_Response/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Var_Response/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Var_Response/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Var_Response/tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Var_Response/tns:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Var_Response/tns:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:NOW_CheckLavorabilita_Numero_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Sub_VerificaLavorabilita_Numero="http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Sub_VerificaLavorabilita_Numero:NOW_CheckLavorabilita_Numero_Out" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5a6a0f4b-10c8-42f6-ac62-1219309d4bb6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_Numero/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_NoLavorazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns1:LINEE[number($index)]/tns1:DN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:LINEE[number($index)]/tns1:DN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBC_NoLavorazione-input"
                                    name="JDBC_NoLavorazione"
                                    outputVariable="JDBC_NoLavorazione"
                                    tibex:xpdlId="5a6a0f4b-10c8-42f6-ac62-1219309d4bb6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBC_NoLavorazione"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToLog_NoLavorazione">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBC_NoLavorazione/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($JDBC_NoLavorazione/Record)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBC_NoLavorazioneToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
