                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns:EsecuzioneNOFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
