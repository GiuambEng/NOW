                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/VerificaLavorabilita_ID_RISORSA/&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsProcess.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWCheckLavorabilitaIDRISORSA.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;KOElabStaging&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:Insert>&#xa;                &lt;ns:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:CODICE_OLO&quot;/>&#xa;                &lt;/ns:COD_OLO>&#xa;                &lt;ns:COD_OLO_CRMWS>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:CODICE_OLO_CRMWS&quot;/>&#xa;                &lt;/ns:COD_OLO_CRMWS>&#xa;                &lt;ns:SRVZ>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:SERVIZIO&quot;/>&#xa;                &lt;/ns:SRVZ>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($NOWCheckLavorabilitaIDRISORSA.parameters)&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;ns:DATA_ATTIVAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:Transaction_date&quot;/>&#xa;                &lt;/ns:DATA_ATTIVAZIONE>&#xa;                &lt;ns:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:ID_RISORSA&quot;/>&#xa;                &lt;/ns:ID_RISORSA>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($InsProcess.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($InsProcess.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;                &lt;/ns:ID_RICH>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$KOElabStaging&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;ns:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$NOWCheckLavorabilitaIDRISORSA.parameters/tns:Transaction_id&quot;/>&#xa;                &lt;/ns:TRANSACTION_ID>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
