                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GestioneErrore"
                            portType="ns13:GenericError" tibex:xpdlId="a45b8836-d802-40cb-8fa4-e02136149690">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="InsProcess"/&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:param name="InsProcess_Numero"/&gt;&lt;xsl:param name="Id_Procso_NOFile"/&gt;&lt;xsl:param name="Id_Procso_NOFileLav"/&gt;&lt;xsl:param name="Operation_1"/&gt;&lt;xsl:param name="TransactionID_1"/&gt;&lt;xsl:param name="TransactionID_2"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:template name="Error-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Operation_1)&gt;0 or $FaultDetails/ActivityName='NOWCheckLavorabilitaIDRISORSA'"&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'CheckLavorabilita'"/&gt;&lt;/ns:ActivityName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="'CheckLavorabilita_Numero'"/&gt;&lt;/ns:ActivityName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($InsProcess/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$InsProcess/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$InsProcess/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($InsProcess_Numero/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) &gt; 0"&gt;&lt;xsl:if test="$InsProcess_Numero/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$InsProcess_Numero/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($TransactionID_1)&gt;0"&gt;&lt;ns:CRMTransactionID_CheckLav&gt;&lt;xsl:value-of select="$TransactionID_1"/&gt;&lt;/ns:CRMTransactionID_CheckLav&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($TransactionID_2)&gt;0"&gt;&lt;ns:CRMTransactionID_CheckLav&gt;&lt;xsl:value-of select="$TransactionID_2"/&gt;&lt;/ns:CRMTransactionID_CheckLav&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:CRMTransactionID_CheckLav&gt;&lt;xsl:value-of select="'NULL'"/&gt;&lt;/ns:CRMTransactionID_CheckLav&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Operation_1)&gt;0 or $FaultDetails/ActivityName='CheckLavorabilita'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$Id_Procso_NOFileLav"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$Id_Procso_NOFile"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:PID&gt;&lt;xsl:value-of select="concat ( 'PID = ', $_processContext/ProcessInstanceId)"/&gt;&lt;/ns:PID&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsProcess.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;InsProcess_Numero.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;Id_Procso_NOFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Id_Procso_NOFileLav&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_1&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID_1&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID_2&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Operation_1)>0 or $FaultDetails/ActivityName='NOWCheckLavorabilitaIDRISORSA'&quot;>&#xa;                    &lt;ns:ActivityName>&#xa;                        &lt;xsl:value-of select=&quot;'CheckLavorabilita'&quot;/>&#xa;                    &lt;/ns:ActivityName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ActivityName>&#xa;                        &lt;xsl:value-of select=&quot;'CheckLavorabilita_Numero'&quot;/>&#xa;                    &lt;/ns:ActivityName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InsProcess.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsProcess.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$InsProcess.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($InsProcess_Numero.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$InsProcess_Numero.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$InsProcess_Numero.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($TransactionID_1)>0&quot;>&#xa;                    &lt;ns:CRMTransactionID_CheckLav>&#xa;                        &lt;xsl:value-of select=&quot;$TransactionID_1&quot;/>&#xa;                    &lt;/ns:CRMTransactionID_CheckLav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($TransactionID_2)>0&quot;>&#xa;                    &lt;ns:CRMTransactionID_CheckLav>&#xa;                        &lt;xsl:value-of select=&quot;$TransactionID_2&quot;/>&#xa;                    &lt;/ns:CRMTransactionID_CheckLav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CRMTransactionID_CheckLav>&#xa;                        &lt;xsl:value-of select=&quot;'NULL'&quot;/>&#xa;                    &lt;/ns:CRMTransactionID_CheckLav>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Operation_1)>0 or $FaultDetails/ActivityName='CheckLavorabilita'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$Id_Procso_NOFileLav&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$Id_Procso_NOFile&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:PID>&#xa;                &lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/ns:PID>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorLogToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToFaulLog"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ErrorToEmpty"/>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;FaulLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Check_Lavorabilita'&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('---ERRORE ID--',tib:render-xml($_error, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="FaulLog-input"
                                name="FaulLog"
                                tibex:xpdlId="cc8747c7-494b-4ffc-9467-8c274d295766"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="ErrorToFaulLog"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="FaulLogToEmpty"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;FaulLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'Check_Lavorabilita'&quot;/>&lt;/tns:Process>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat ( 'PID = ', $_processContext/ProcessInstanceId)&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('---ERRORE ID--',tib:render-xml($_error, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:empty name="Empty" tibex:xpdlId="b57ce1df-993b-4940-82cc-1bfc449ba39d">
                            <bpws:targets>
                                <bpws:target linkName="ErrorToEmpty"/>
                                <bpws:target linkName="FaulLogToEmpty"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="EmptyToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Operation_1='NOWCheckLavorabilitaIDRISORSA' or $FaultDetails/ActivityName='NOWCheckLavorabilitaIDRISORSA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation_1='NOWCheckLavorabilitaIDRISORSA' or $FaultDetails/ActivityName='NOWCheckLavorabilitaIDRISORSA']]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="EmptyToMapper1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Operation_2='NOWCheckLavorabilitaNumero' or $FaultDetails/ActivityName='NOWCheckLavorabilitaNumero'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation_2='NOWCheckLavorabilitaNumero' or $FaultDetails/ActivityName='NOWCheckLavorabilitaNumero']]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
