        </edges>
    </notation:Diagram>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.genereciErrorGestioneSegnalazione"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.stagingSendIdullco"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="CheckID-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="CheckID" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:INPUT" name="InsStaging-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:INPUT" name="Up_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable name="InviatoKOPresaInCarico"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/InviatoKOPresaInCarico" type="xsd:int"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Jdbc/Timeout" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToInsStaging" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToCheckID" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckIDToInsStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckIDToUp_Staging" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Up_StagingToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsStagingToUp_Staging" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="f6df863b-a0b4-4fa7-941a-85663bd7f86f"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="b6f33ede-cab5-43ee-9c7b-8aa80c0430e9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Up_StagingToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="50fc9d06-f289-475f-8bc3-7a5f07f0de61">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToInsStaging">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCheckID">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Start/ns0:ID_Esec_Proc)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($Start/ns0:ID_Esec_Proc)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2d31ecd1-eda4-4dfe-852c-9cec1d2d0e22+input&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CheckID-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/ns:ID_Esec_FromProcessID)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CheckID-input" name="CheckID"
                    outputVariable="CheckID"
                    tibex:xpdlId="2d31ecd1-eda4-4dfe-852c-9cec1d2d0e22" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCheckID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckIDToInsStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckID/Record[1]/COUNT=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckID/Record[1]/COUNT=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckIDToUp_Staging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2d31ecd1-eda4-4dfe-852c-9cec1d2d0e22+input&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CheckID-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/ns:ID_Esec_FromProcessID)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xd;&#xa;  FROM STAG_CLC_IDULLCO_NOFIN&#xd;&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InviatoKOPresaInCarico&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;ns1:INPUT>&lt;ns1:Insert>&lt;ns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'ERRORE NELL INTERFACCIA'&quot;/>&lt;/ns1:CONTENUTO_REQUEST>&lt;ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns:ID_Esec_FromProcessID)&quot;/>&lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:CRMTransactionID_Idullco)>0&quot;>&lt;ns1:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;$Start/ns:CRMTransactionID_Idullco&quot;/>&lt;/ns1:ID_RICH_CLC_IDULLCO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;'ERRORE INTERFACCIA'&quot;/>&lt;/ns1:ID_RICH_CLC_IDULLCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoKOPresaInCarico&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;ns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns1:TIMSTP_RICH>&lt;xsl:if test=&quot;$Start/ns:PID&quot;>&lt;ns1:PID>&lt;xsl:value-of select=&quot;$Start/ns:PID&quot;/>&lt;/ns1:PID>&lt;/xsl:if>&lt;ns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns:Error)&quot;/>&lt;/ns1:DESCR_ERRORE>&lt;/ns1:Insert>&lt;/ns1:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InsStaging-input" name="InsStaging"
                    tibex:xpdlId="a05a4fc9-d5ae-484e-a5bf-b44ab99513ba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToInsStaging"/>
                        <bpws:target linkName="CheckIDToInsStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsStagingToUp_Staging"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InviatoKOPresaInCarico&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;ns1:INPUT>&lt;ns1:Insert>&lt;ns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'ERRORE NELL INTERFACCIA'&quot;/>&lt;/ns1:CONTENUTO_REQUEST>&lt;ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns:ID_Esec_FromProcessID)&quot;/>&lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:CRMTransactionID_Idullco)>0&quot;>&lt;ns1:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;$Start/ns:CRMTransactionID_Idullco&quot;/>&lt;/ns1:ID_RICH_CLC_IDULLCO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:ID_RICH_CLC_IDULLCO>&lt;xsl:value-of select=&quot;'ERRORE INTERFACCIA'&quot;/>&lt;/ns1:ID_RICH_CLC_IDULLCO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoKOPresaInCarico&quot;/>&lt;/ns1:ID_STATO_ELAB_STAG>&lt;ns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns1:TIMSTP_RICH>&lt;xsl:if test=&quot;$Start/ns:PID&quot;>&lt;ns1:PID>&lt;xsl:value-of select=&quot;$Start/ns:PID&quot;/>&lt;/ns1:PID>&lt;/xsl:if>&lt;ns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns:Error)&quot;/>&lt;/ns1:DESCR_ERRORE>&lt;/ns1:Insert>&lt;/ns1:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.crmws.IdUllco.sub_StagingIdullco" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InviatoKOPresaInCarico&quot;/>&lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns1:Error)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoKOPresaInCarico&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID>&lt;/xsl:if>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Up_Staging-input" name="Up_Staging"
                    tibex:xpdlId="eb24c12d-d586-4e7e-85a2-f131fe7891af"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckIDToUp_Staging"/>
                        <bpws:target linkName="InsStagingToUp_Staging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Up_StagingToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingSendIdullco&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InviatoKOPresaInCarico&quot;/>&lt;xsl:template name=&quot;Up_Staging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns1:Error)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InviatoKOPresaInCarico&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID>&lt;/xsl:if>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
