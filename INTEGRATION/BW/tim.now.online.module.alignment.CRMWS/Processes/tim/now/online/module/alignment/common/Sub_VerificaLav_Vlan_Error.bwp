        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:INPUT" name="InsStaging-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:INPUT" name="UpStaging-input" sca-bpel:internal="true"/>
        <bpws:variable name="KO_ELAB_STAG" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/KOElabStaging" type="xsd:int"/>
        <bpws:variable name="Error" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/Error" type="xsd:int"/>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Jdbc/Timeout" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckIdToInsStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckIdToUpStaging" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="InsStagingToUpStaging" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpStagingToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="1fcb5ea7-aa51-4826-a55f-99fc886584c2"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="b8209934-da20-458d-bc5c-a7923ce6874e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpStagingToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Check" tibex:xpdlId="efb6b7b0-5ddc-4ffa-bcb6-24e21ff0d13e">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Start/ns0:ID_Esec_Proc)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($Start/ns0:ID_Esec_Proc)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d030654e-0dd6-42ed-8141-a403ec236764+input&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CheckId-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/ns:ID_Esec_Proc)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CheckId-input" name="CheckId"
                    outputVariable="CheckId"
                    tibex:xpdlId="d030654e-0dd6-42ed-8141-a403ec236764" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckIdToInsStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckId/Record[1]/COUNT=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckId/Record[1]/COUNT=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckIdToUpStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d030654e-0dd6-42ed-8141-a403ec236764+input&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CheckId-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Start/ns:ID_Esec_Proc)&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xa;  FROM STAG_LAVORB_RISORSA_NOFIN&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Error&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_RICH>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$Error&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:TRANSACTION_ID>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID_forLog>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID_forLog>&lt;/xsl:if>&lt;/ns:Insert>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InsStaging-input" name="InsStaging"
                    tibex:xpdlId="710ce250-b63a-48fe-a2f5-c7c23cc7e659"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckToCallProcess"/>
                        <bpws:target linkName="CheckIdToInsStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsStagingToUpStaging"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Error&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_RICH>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$Error&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:TRANSACTION_ID>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID_forLog>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID_forLog>&lt;/xsl:if>&lt;/ns:Insert>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.checklavorabilita.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Error&quot;/>&lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns1:Error)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$Error&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID_forLog>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID_forLog>&lt;/xsl:if>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="UpStaging-input" name="UpStaging"
                    tibex:xpdlId="db34d7f8-02eb-453d-b4f8-489f0945796d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckIdToUpStaging"/>
                        <bpws:target linkName="InsStagingToUpStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpStagingToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Error&quot;/>&lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:UpdateOnError>&lt;ns:DESCR_ERRORE>&lt;xsl:value-of select=&quot;tib:render-xml($Start/ns1:Error)&quot;/>&lt;/ns:DESCR_ERRORE>&lt;ns:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RISPOSTA>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$Error&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:if test=&quot;$Start/ns1:PID&quot;>&lt;ns:PID_forLog>&lt;xsl:value-of select=&quot;$Start/ns1:PID&quot;/>&lt;/ns:PID_forLog>&lt;/xsl:if>&lt;/ns:UpdateOnError>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.checklavorabilita.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
