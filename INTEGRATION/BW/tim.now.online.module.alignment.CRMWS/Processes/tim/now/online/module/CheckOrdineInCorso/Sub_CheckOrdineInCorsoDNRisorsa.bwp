                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ordine.TIPOLOGIALAVORAZIONE, ordine.CODICEORDINEOLO, ordine.OFFERTA &#xa;from BDS_1_CASEDATA_ORDINE ordine, BDS_1_CASEDATA_ATTRIBTDTTGLRDN attributo, BDS_1_CASEDATA_RICHIESTA richiesta &#xa;where &#xa;ordine.IDRICHIESTAOLO=richiesta.IDRICHIESTAOLO&#xa;and&#xa;richiesta.STATORICHIESTANOW not in ('SCARTATO', 'ANNULLATO', 'ESPLETAMENTOTECNICOKO', 'INVIATOAFATTURAZIONE', 'FATTURAZIONEKO', 'CHIUSO','ESPLETATOOKCONSUNTIVO')&#xa;and&#xa;attributo.IDRICHIESTAOLO=ordine.IDRICHIESTAOLO&#xa;and &#xa;attributo.VALOREATTRIBUTO=?&#xa;and&#xa;attributo.NOMEATTRIBUTO='NUMEROTELEFONICO'"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIALAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
