                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Ouput"
                                    name="SetInCorso"
                                    outputVariable="Ouput"
                                    tibex:xpdlId="b8ac9abf-eee9-4a23-99a0-dbc630889561" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToSetInCorso"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SetInCorsoToLogCessato"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.NowCheckOrdineInCorsoDNRisorsa&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FindStatoRichiesta&quot;/>&lt;xsl:param name=&quot;MapLavorazioni&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Ouput&quot; match=&quot;/&quot;>&lt;tns:NowCheckOrdineInCorsoDNRisorsa_Response>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapLavorazioni/tns:Transaction_id&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;$MapLavorazioni/tns:CODICE_ORDINE_OLO&quot;/>&lt;/tns:CODICE_ORDINE_OLO>&lt;tns:RISORSE>&lt;xsl:if test=&quot;$MapLavorazioni/tns:RISORSE[number($index)]/tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$MapLavorazioni/tns:RISORSE[number($index)]/tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapLavorazioni/tns:RISORSE[number($index)]/tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$MapLavorazioni/tns:RISORSE[number($index)]/tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='VARIAZIONE'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;05&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='ATTIVAZIONE' and $FindStatoRichiesta/Record[1]/OFFERTA='NP'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'01'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='MIGRAZIONE'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'02'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='CESSAZIONE'&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;&amp;quot;99&amp;quot;&quot;/>&lt;/tns:Return_Code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='ATTIVAZIONE' and $FindStatoRichiesta/Record[1]/OFFERTA='NP'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;&amp;quot;NP in corso&amp;quot;&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='MIGRAZIONE'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;&amp;quot;Migrazione in corso&amp;quot;&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='CESSAZIONE'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;&amp;quot;Cessazione in corso&amp;quot;&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;$FindStatoRichiesta/Record[1]/TIPOLOGIALAVORAZIONE='VARIAZIONE'&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;&amp;quot;Variazione in corso&amp;quot;&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$FindStatoRichiesta/Record[1]/CODICEORDINEOLO&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$FindStatoRichiesta/Record[1]/CODICEORDINEOLO&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:RISORSE>&lt;/tns:NowCheckOrdineInCorsoDNRisorsa_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Ouput" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
