                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingAllineamentoConsistenza&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Operation_1In&quot;/>&lt;xsl:param name=&quot;Input&quot;/>&lt;xsl:param name=&quot;InvioEsitoAggiornamentoToCRMWS&quot;/>&lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;xsl:if test=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:COD_OLO&quot;>&lt;ns:COD_OLO>&lt;xsl:value-of select=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:COD_OLO&quot;/>&lt;/ns:COD_OLO>&lt;/xsl:if>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($Input,true(), true())&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;xsl:if test=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:DATA_ATTIVAZIONE&quot;>&lt;ns:DATA_ATTIVAZIONE>&lt;xsl:value-of select=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:DATA_ATTIVAZIONE&quot;/>&lt;/ns:DATA_ATTIVAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:ID_RISORSA&quot;>&lt;ns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:ID_RISORSA&quot;/>&lt;/ns:ID_RISORSA>&lt;/xsl:if>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Operation_1In/part1/ns1:InputCRMWS/ns1:Id_Esec_Proc_NoFile)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH>&lt;xsl:value-of select=&quot;$Operation_1In/part1/ns1:InputCRMWS/ns1:ID_RICH&quot;/>&lt;/ns:ID_RICH>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InvioEsitoAggiornamentoToCRMWS&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>