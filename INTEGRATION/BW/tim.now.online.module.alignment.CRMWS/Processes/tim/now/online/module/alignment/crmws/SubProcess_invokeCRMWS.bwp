                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingAllineamentoConsistenza&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Operation_1In.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitoAggiornamentoToCRMWS&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:Insert>&#xa;                &lt;xsl:if test=&quot;$Operation_1In.part1/ns1:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns1:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Input,true(), true())&quot;/>&#xa;                &lt;/ns:CONTENUTO_REQUEST>&#xa;                &lt;xsl:if test=&quot;$Operation_1In.part1/ns1:DATA_ATTIVAZIONE&quot;>&#xa;                    &lt;ns:DATA_ATTIVAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns1:DATA_ATTIVAZIONE&quot;/>&#xa;                    &lt;/ns:DATA_ATTIVAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Operation_1In.part1/ns1:ID_RISORSA&quot;>&#xa;                    &lt;ns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns1:ID_RISORSA&quot;/>&#xa;                    &lt;/ns:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Operation_1In.part1/ns1:Id_Esec_Proc_NoFile)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;ns:ID_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns1:ID_RICH&quot;/>&#xa;                &lt;/ns:ID_RICH>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitoAggiornamentoToCRMWS&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RICH>&#xa;                &lt;ns:TRANSACTION_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Operation_1In.part1/ns1:TransactionID&quot;/>&#xa;                &lt;/ns:TRANSACTION_ID>&#xa;                &lt;ns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/ns:OPERATORE>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
