                                    <bpws:targets>
                                    <bpws:target linkName="ConditionCicleToGroupEnd"/>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="af180a18-262c-4564-a06b-dd5980826228" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="StartLogToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToqueryLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af180a18-262c-4564-a06b-dd5980826228+input&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.NowCheckRaccoltaVLAN&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CODICI_VLAN[number($index)]/tns1:ID_RISORSA)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CODICI_VLAN[number($index)]/tns1:ID_RISORSA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;CVLANID>&lt;xsl:value-of select=&quot;string($Start/tns1:CODICI_VLAN[number($index)]/tns1:CVLAN_ID)&amp;#xD;&amp;#xA;&amp;#x9;&quot;/>&lt;/CVLANID>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="maxRows" processProperty="MaximumRows"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT 1&#xd;&#xa;  FROM BDS_1_CASEDATA_ASSET  ASSET&#xd;&#xa;       JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET DETT&#xd;&#xa;         ON     DETT.ASSET_DETTAGLIOASSET_BDSID = ASSET.BDS_ID&#xd;&#xa;            AND DETT.NOMECOMPONENTE = ANY ('USERVLAN', 'GBEVC')&#xd;&#xa;            AND ASSET.STATOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xd;&#xa;            AND DETT.STATODETTAGLIOASSET = 'ATTIVO'  &#xd;&#xa;       JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST SVLAN&#xd;&#xa;         ON     SVLAN.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID&#xd;&#xa;            AND SVLAN.NOMEATTRIBUTO = 'SVLANCODE'&#xd;&#xa;            AND SVLAN.VALOREATTRIBUTO =?&#xd;&#xa;       JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST CVLAN&#xd;&#xa;         ON     CVLAN.DTTGLSST_TTRBTIDTTGLISST_BDSID = DETT.BDS_ID&#xd;&#xa;            AND CVLAN.NOMEATTRIBUTO = 'CVLANID'&#xd;&#xa;            AND CVLAN.VALOREATTRIBUTO =?&#xd;&#xa;WHERE ROWNUM &lt;= 1&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CVLANID"/>

                                    <columnMetadata
                                    columnName="1"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="ConditionCicle"
                                    name="ConditionCicleOK"
                                    outputVariable="ConditionCicle"
                                    tibex:xpdlId="b6e2ace8-08b7-49e7-b3e8-f1fe711c238e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log_OKToConditionCicleOK"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ConditionCicleToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
