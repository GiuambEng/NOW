                        <bpws:variables>
                            <bpws:variable name="index"
                                sca-bpel:internal="true" type="xsd:int">
                                <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                </bpws:from>
                            </bpws:variable>
                            <bpws:variable name="ConditionCicle" type="xsd:boolean">
                                <bpws:from>
                                    <bpws:literal>true</bpws:literal>
                                </bpws:from>
                            </bpws:variable>
                        </bpws:variables>
                        <bpws:sequence name="sequence" tibex:group="while">
                            <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                            <bpws:while name="while1" tibex:counterName="index">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ConditionCicle=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConditionCicle=true()]]></bpws:condition>
                                <bpws:flow name="flow1">
                                    <bpws:links>
                                    <bpws:link
                                    name="CallProcessToSetKO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="CallProcessToSetOK" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link name="SetOKToLog_OK" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log_KOToConditionCicleKO" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="SetKOToLog_KO" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ConditionCicleToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Log_OKToConditionCicleOK" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToStartLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="StartLogToJDBCQuery" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="JDBCQueryToqueryLog" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToConditionCicleKO_ultimogiro"
                                    tibex:label="ultimo giro" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    </bpws:links>
                                    <bpws:empty name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="a4c8ce91-9b1f-4d35-93e5-688dfbd74447">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToStartLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToConditionCicleKO_ultimogiro">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index>count($Start/ns0:CODICI_VLAN)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index>count($Start/ns0:CODICI_VLAN)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
