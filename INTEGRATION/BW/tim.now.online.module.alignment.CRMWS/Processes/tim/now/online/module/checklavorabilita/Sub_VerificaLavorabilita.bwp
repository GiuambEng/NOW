                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty2"
                                    sqlStatement="SELECT COUNT(1) AS COUNT1&#xa;FROM BDS_1_CASEDATA_ASSET Asset JOIN BDS_1_CASEDATA_DETTAGLIOASSET dett ON dett.asset_dettaglioasset_bdsid = asset.bds_id &#xa;  JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST svlan ON svlan.DTTGLSST_TTRBTIDTTGLISST_BDSID = dett.BDS_ID&#xa;  AND SVLAN.NOMEATTRIBUTO= 'SVLANCODE'&#xa;WHERE ASSET.STATOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xa;&#x9;  AND dett.NOMECOMPONENTE='USERVLAN'&#xa;&#x9;  AND dett.STATODETTAGLIOASSET='ATTIVO'&#xa;      AND SVLAN.VALOREATTRIBUTO  = ?&#xa;      AND ROWNUM &lt;= 1" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="COUNT1"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension inputVariable="ESITO"
