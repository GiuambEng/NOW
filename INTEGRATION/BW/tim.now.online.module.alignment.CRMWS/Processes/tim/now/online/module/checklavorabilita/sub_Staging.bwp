    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToStartLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToUpOnErrorStaging" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartLogToInsertStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartLogToUpdateStaging" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="UpdateStagingToEndLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertStagingToEndLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="EndLogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpOnErrorStagingToFaultLog" tibex:linkType="ERROR"/>
                <bpws:link name="FaultLogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpOnErrorStagingToEndLog" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
