et>&lt;/ns:AttributiDettaglioAsset>&lt;/ns:Input_AttributoAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
