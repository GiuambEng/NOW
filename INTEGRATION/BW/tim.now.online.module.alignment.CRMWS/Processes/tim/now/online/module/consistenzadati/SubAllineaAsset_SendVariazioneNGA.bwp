                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+323e7e00-0053-4374-b9cb-354ddb986caa+input&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Counter_Comp2_Dettaglio&quot;/>&lt;xsl:param name=&quot;UserVlan&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;PROFILO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UserVlan/ns:UserVulan[number($Counter_Comp2_Dettaglio)]/ns:PROFILOBMD)&quot;>&lt;xsl:value-of select=&quot;$UserVlan/ns:UserVulan[number($Counter_Comp2_Dettaglio)]/ns:PROFILOBMD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO>&lt;ID_OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:IdOfferta)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:IdOfferta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OFFERTA>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($UserVlan/ns:UserVulan[number($Counter_Comp2_Dettaglio)]/ns:SVLANCODE)&quot;>&lt;xsl:value-of select=&quot;$UserVlan/ns:UserVulan[number($Counter_Comp2_Dettaglio)]/ns:SVLANCODE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery1-input"
