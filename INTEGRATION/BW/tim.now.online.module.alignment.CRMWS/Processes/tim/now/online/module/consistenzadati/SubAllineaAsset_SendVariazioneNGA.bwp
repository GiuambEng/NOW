                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:ns1=&quot;www.tim.now.allileamentoconsistenze.NomeComponenteChoose&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;www.tim.now.maxNumber&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Componente&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CodiceVlan&quot;/>&lt;xsl:template name=&quot;FlagNuovoModello&quot; match=&quot;/&quot;>&lt;ns:Input_AttributoAsset>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[1]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:DettaglioAsset[($Componente/ns1:NomeComponente1='ACCESSOVULAFTTCAB' or $Componente/ns1:NomeComponente1='ACCESSOVULAFTTH')]/attributidettaglioasset[nomeAttributo='FLAGNUOVOMODELLO']/valoreAttributo)>0&quot;>&lt;created>&lt;xsl:value-of select=&quot;xsd:dateTime($Start/ns:DettaglioAsset[($Componente/ns1:NomeComponente1='ACCESSOVULAFTTCAB' or $Componente/ns1:NomeComponente1='ACCESSOVULAFTTH')]/attributidettaglioasset[nomeAttributo='FLAGNUOVOMODELLO']/valoreAttributo)&quot;/>&lt;/created>&lt;/xsl:when>&lt;xsl:otherwise>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'FLAGNUOVOMODELLO'&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Start/ns:UserVulan)=1 or (count($Start/ns:UserVulan)>1 and count($CodiceVlan/tns:CodiceVlan)=1)&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[($Componente/ns1:NomeComponente1='ACCESSOVULAFTTCAB' or $Componente/ns1:NomeComponente1='ACCESSOVULAFTTH')]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/ns:Input_AttributoAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="FlagNuovoModello" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
