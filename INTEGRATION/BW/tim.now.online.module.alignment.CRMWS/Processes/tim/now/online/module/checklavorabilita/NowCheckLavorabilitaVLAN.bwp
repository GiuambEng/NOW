    &lt;xsl:value-of select=&quot;bw:getHostName()&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;'ID147'&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('CheckLavorabilita_',$NowCheckLavorabilitaVLAN.parameters/tns2:Transaction_ID)&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;tns1:TIPO_OPERAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'LOGIN'&quot;/>&#xa;                &lt;/tns1:TIPO_OPERAZIONE>&#xa;                &lt;tns1:SISTEMA_CHIAMANTE>&#xa;                    &lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&#xa;                &lt;/tns1:SISTEMA_CHIAMANTE>&#xa;                &lt;xsl:if test=&quot;$InsProcNOFILE.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                    &lt;tns1:ID_ESE_PROC_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsProcNOFILE.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                    &lt;/tns1:ID_ESE_PROC_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:NOME_TAB_STAGING>&#xa;                    &lt;xsl:value-of select=&quot;'STAG_LAVORB_RISORSA_NOFIN'&quot;/>&#xa;                &lt;/tns1:NOME_TAB_STAGING>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
