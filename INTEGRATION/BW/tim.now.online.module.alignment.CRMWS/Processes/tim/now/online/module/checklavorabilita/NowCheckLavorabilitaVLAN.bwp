                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOWCheckLavorabilitaRaccolta/" xmlns:tns1="http://www.example.org/tim.now.xsd.NowCheckLAvorabilitaVLAN" version="2.0"&gt;&lt;xsl:param name="ErrorResponse"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:NowCheckLavorabilitaVLANResponse&gt;&lt;parameters&gt;&lt;tns1:NowCheckLAvorabilitaVLAN_Response&gt;&lt;tns1:Transaction_ID&gt;&lt;xsl:value-of select="$ErrorResponse/tns1:Transaction_ID"/&gt;&lt;/tns1:Transaction_ID&gt;&lt;tns1:Response_date&gt;&lt;xsl:value-of select="$ErrorResponse/tns1:Response_date"/&gt;&lt;/tns1:Response_date&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="$ErrorResponse/tns1:Esito"/&gt;&lt;/tns1:Esito&gt;&lt;tns1:CodiceCausale&gt;&lt;xsl:value-of select="$ErrorResponse/tns1:CodiceCausale"/&gt;&lt;/tns1:CodiceCausale&gt;&lt;xsl:if test="$ErrorResponse/tns1:DescrizioneCausale"&gt;&lt;tns1:DescrizioneCausale&gt;&lt;xsl:value-of select="$ErrorResponse/tns1:DescrizioneCausale"/&gt;&lt;/tns1:DescrizioneCausale&gt;&lt;/xsl:if&gt;&lt;/tns1:NowCheckLAvorabilitaVLAN_Response&gt;&lt;/parameters&gt;&lt;/tns:NowCheckLavorabilitaVLANResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
