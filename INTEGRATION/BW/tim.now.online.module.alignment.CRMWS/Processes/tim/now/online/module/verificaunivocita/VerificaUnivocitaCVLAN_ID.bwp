                        <element maxOccurs="1" minOccurs="1"
                            name="TIME_RISP" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ESEC" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="0"
