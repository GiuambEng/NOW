                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="AttrDettAssetULLToLogAtt_1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToAttrDettAssetULL" tibex:linkType="SUCCESS"/>
