            <bendpoints points="[0, -24, 0, 92]$[0, -91, 0, 25]" xsi:type="notation:RelativeBendpoints"/>
        </edges>
    </notation:Diagram>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.genereciErrorGestioneSegnalazione"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.stagingVerificaCheckLavorabilita"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="Check-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="Check" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns4:INPUT" name="Ins_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable name="InvioEsitoKO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/InviatoEsitoKO" type="xsd:int"/>
        <bpws:variable element="ns4:INPUT" name="UpStaging-input" sca-bpel:internal="true"/>
        <bpws:variable name="TimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Jdbc/Timeout" type="xsd:int"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="UpStagingToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckToCallProcess2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckToUpStaging" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Ins_StagingToUpStaging" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="0b3fd45a-3689-4065-af49-de71be19d2ca"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="8f2dcd74-1b34-4853-9358-1a09fcabd968" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpStagingToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="0ad50814-e2ed-4e28-8efe-d3f6459ed206">
                <bpws:targets>
                    <bpws:target linkName="StartToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToCallProcess1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Start/ns0:ID_Esec_Proc)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($Start/ns0:ID_Esec_Proc)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Check-input"
                    name="Check" outputVariable="Check"
                    tibex:xpdlId="11894596-e459-4dab-b609-ebbf199a0d9c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckToCallProcess2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Check/Record[1]/COUNT=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Check/Record[1]/COUNT=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckToUpStaging">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+11894596-e459-4dab-b609-ebbf199a0d9c+input&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Check-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:ID_Esec_Proc)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:ID_Esec_Proc&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xa;  FROM APPUSER.STAG_LAVORB_RISORSA_NOFIN&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Ins_Staging-input"
                    name="Ins_Staging"
                    tibex:xpdlId="891648f6-47cf-4a69-8458-e58cb527d3ec"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToCallProcess1"/>
                        <bpws:target linkName="CheckToCallProcess2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Ins_StagingToUpStaging"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;InvioEsitoKO&quot;/>&lt;xsl:template name=&quot;Ins_Staging-input&quot; match=&quot;/&quot;>&lt;ns:INPUT>&lt;ns:Insert>&lt;ns:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:CONTENUTO_REQUEST>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_RICH>&lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&lt;/ns:ID_RICH>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$InvioEsitoKO&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_RICH>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($Start/ns1:CRMTransactionID_CheckLav))&quot;>&lt;xsl:if test=&quot;$Start/ns1:CRMTransactionID_CheckLav&quot;>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Start/ns1:CRMTransactionID_CheckLav&quot;/>&lt;/ns:TRANSACTION_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;'NULL'&quot;/>&lt;/ns:TRANSACTION_ID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:Insert>&lt;/ns:INPUT>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.checkIdRisorsa.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="UpStaging-input"
                    name="UpStaging"
                    tibex:xpdlId="4d497dd9-a4d5-4e73-a801-e5bbbd8e1c82"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Ins_StagingToUpStaging"/>
                        <bpws:target linkName="CheckToUpStaging"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpStagingToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingVerificaCheckLavorabilita&quot; xmlns:ns1=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;InvioEsitoKO&quot;/>&#xa;    &lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:UpdateOnError>&#xa;                &lt;ns:DESCR_ERRORE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Start/ns1:Error)&quot;/>&#xa;                &lt;/ns:DESCR_ERRORE>&#xa;                &lt;ns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RISPOSTA>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$InvioEsitoKO&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:ID_Esec_FromProcessID)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;            &lt;/ns:UpdateOnError>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.online.module.alignment.checkIdRisorsa.sub_Staging" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
