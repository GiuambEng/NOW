                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b8c0d915-4d67-489e-a38a-893043e65dac+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaLavorabilita_ID_RISORSA/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery_new-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RISORSA>&lt;xsl:value-of select=&quot;$Start/tns2:ID_RISORSA&quot;/>&lt;/ID_RISORSA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
