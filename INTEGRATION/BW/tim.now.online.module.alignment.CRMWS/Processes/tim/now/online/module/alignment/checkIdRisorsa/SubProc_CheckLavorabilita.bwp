                                activityTypeID="bw.jdbc.JDBCQuery"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeOut"/>
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="SELECT CODICEORDINETI&#xa;  FROM BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE IDRISORSA = ?&#xa;    AND STATORICHIESTANOW NOT IN ('SCARTATO', 'ANNULLATO', 'ESPLETAMENTO TECNICO KO',&#xa;  'INVIATO A FATTURAZIONE', 'FATTURAZIONE KO', 'CHIUSO')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata
                                    columnName="CODICEORDINETI"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:extActivity inputVariable="StartLog-input"
                        name="StartLog"
                        tibex:xpdlId="42722e93-4d7d-46a7-a6e6-e844b2ab7df1"
                        type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="GroupStartToStartLog"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="StartLogToJDBCQuery_new"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding coercion=""
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProc_Checklavorabilita'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('StartSubProcessCheckLavorabilita con ID_RISORSA= ',$Start/tns1:ID_RISORSA)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:CallProcess
                            moduleRef="tim.now.shared_library"
                            spawn="true"
                            subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:extActivity>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:extActivity inputVariable="EndLog-input"
                        name="EndLog"
                        tibex:xpdlId="c8e1a88b-bfb0-4a8c-832c-564f6998ed55"
                        type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="ResponseToEndLog"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="EndLogToGroupEnd"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding coercion=""
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProc_Checklavorabilita'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('EndSubProcessCheckLavorabilita ', tib:render-xml($Response, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:CallProcess
                            moduleRef="tim.now.shared_library"
                            spawn="true"
                            subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:extActivity>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:extActivity inputVariable="Check-input"
                        name="Check"
                        tibex:xpdlId="c85727c5-cb36-4a7c-91fb-1910436983c0"
                        type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="JDBCQuery_newToCheck"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="CheckToResult_new">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                            </bpws:source>
                            <bpws:source linkName="CheckToJDBCQuery">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($Check_1/Record[1]/STATOASSET) = &quot;INLAVORAZIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:transitionCondition><![CDATA[upper-case($Check_1/Record[1]/STATOASSET) = "INLAVORAZIONE"]]></bpws:transitionCondition>
                            </bpws:source>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding coercion=""
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Check_1&quot;/>&lt;xsl:template name=&quot;Check-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'SubProc_Checklavorabilita'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Chek_1: ',tib:render-xml($Check_1, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:CallProcess
                            moduleRef="tim.now.shared_library"
                            spawn="true"
                            subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:extActivity>
                </bpws:extensionActivity>
                <bpws:extensionActivity>
                    <tibex:activityExtension
                        inputVariable="Response-input" name="Response"
                        outputVariable="Response"
                        tibex:xpdlId="2fb931f3-2bdf-4cc2-ba07-cc340a576a84" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
                            <bpws:target linkName="CheckToResult_new"/>
                            <bpws:target linkName="JDBCQueryToMapper"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="ResponseToEndLog"/>
                        </bpws:sources>
                        <tibex:inputBindings>
                            <tibex:inputBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Check_1&quot;/>&lt;xsl:param name=&quot;Check_2&quot;/>&lt;xsl:template name=&quot;Response-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Idrisorsa_Out>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Check_1/Record[1]/STATOASSET) = 0 or not(exists($Check_1/Record[1]/STATOASSET))&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'03'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;INLAVORAZIONE&amp;quot;&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'01'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;ATTIVO&amp;quot;&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'00'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;CESSATO&amp;quot;&quot;>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'02'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;'04'&quot;/>&lt;/tns:Return_Code>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Check_1/Record[1]/STATOASSET) = 0 or not(exists($Check_1/Record[1]/STATOASSET))&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;&amp;quot;RISORSA NON PRESENTE&amp;quot;&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;INLAVORAZIONE&amp;quot;&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'ORDINE IN CORSO'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;ATTIVO&amp;quot;&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'RISORSA LAVORABILE'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;CESSATO&amp;quot;&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'RISORSA CESSATA'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Check_1/Record[1]/STATOASSET) = &amp;quot;INLAVORAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Check_2/Record[string-length(CODICEORDINETI)>0]/CODICEORDINETI)&quot;>&lt;xsl:if test=&quot;$Check_2/Record[string-length(CODICEORDINETI)>0]/CODICEORDINETI&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Check_2/Record[string-length(CODICEORDINETI)>0]/CODICEORDINETI&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:NOW_CheckLavorabilita_Idrisorsa_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                        </tibex:inputBindings>
                        <tibex:config>
                            <bwext:BWActivity
                                activityTypeID="bw.generalactivities.mapper"
                                version="6.0.0.001"
                                xmlns:Sub_VerificaLavorabilita_ID_RISORSA="http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/"
                                xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Sub_VerificaLavorabilita_ID_RISORSA:NOW_CheckLavorabilita_Idrisorsa_Out" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
                        </tibex:config>
                    </tibex:activityExtension>
                </bpws:extensionActivity>
            </bpws:flow>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="bbb2e908-0147-4692-852b-0f7193ca3952"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLocalTransaction"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="e4c5c636-0c1a-4cc6-8fc1-31c2ba59f313" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LocalTransactionToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Sub_VerificaLavorabilita_ID_RISORSA/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:NOW_CheckLavorabilita_Idrisorsa_Out>&lt;tns:Return_Code>&lt;xsl:value-of select=&quot;$Response/tns:Return_Code&quot;/>&lt;/tns:Return_Code>&lt;xsl:if test=&quot;$Response/tns:Descrizione_errore&quot;>&lt;tns:Descrizione_errore>&lt;xsl:value-of select=&quot;$Response/tns:Descrizione_errore&quot;/>&lt;/tns:Descrizione_errore>&lt;/xsl:if>&lt;xsl:if test=&quot;$Response/tns:ID_ORDINE&quot;>&lt;tns:ID_ORDINE>&lt;xsl:value-of select=&quot;$Response/tns:ID_ORDINE&quot;/>&lt;/tns:ID_ORDINE>&lt;/xsl:if>&lt;/tns:NOW_CheckLavorabilita_Idrisorsa_Out>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
