                                    sqlStatement="SELECT STATOASSET, CODICEORDINEOLO&#xa;  FROM BDS_1_CASEDATA_ASSET&#xa;  WHERE IDRISORSA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
