>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:CVlanId)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'CVLANID'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:CVlanId&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int($IDDettaglio)&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:DataEspletamentoVC)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'DATAESPLETAMENTOVC'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:DataEspletamentoVC&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&q