            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Componente"
                    name="Componente" outputVariable="Componente"
                    tibex:xpdlId="a5cce597-2802-48ed-9a3c-66ab9a7a6ab3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ComponenteToCallProcess">
                            <tibex:DesignExpression>
