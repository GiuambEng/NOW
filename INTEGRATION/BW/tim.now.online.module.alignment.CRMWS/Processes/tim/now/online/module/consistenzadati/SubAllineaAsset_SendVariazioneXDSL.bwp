                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;www.tim.now.checkXDSLATMVC&quot; xmlns:ns2=&quot;www.tim.now.dettaglio.asset.customizzato&quot; xmlns:ns3=&quot;www.tim.now.allileamentoconsistenze.NomeComponenteChoose&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IDDettaglio&quot;/>&lt;xsl:param name=&quot;IDDettaglio_GBE&quot;/>&lt;xsl:param name=&quot;ConteggioAttributoGBE&quot;/>&lt;xsl:param name=&quot;New_GBE&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:param name=&quot;ConteggioDettaglioGBE&quot;/>&lt;xsl:param name=&quot;Componente&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;DettComp2&quot; match=&quot;/&quot;>&lt;ns:Input_DettaglioAsset>&lt;ns:DettaglioAsset>&lt;xsl:variable name=&quot;progressivo_da&quot; select=&quot;count($Accumulate2/ns2:DettaglioAsset_Customizzato)&quot;/>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;concat(xsd:string($Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset),xsd:string($IDDettaglio_GBE))&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;'GBEVC'&quot;/>&lt;/nomeComponente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:VPI)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'VPI'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:VPI&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int($IDDettaglio)&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:VCI)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'VCI'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:VCI&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int($IDDettaglio)&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:IDRISORSAVC)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns3:NomeComponente1]/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'IDRISORSAVC'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:IDRISORSAVC&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int($IDDettaglio)&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:SVLANCODE)>0&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$Start/ns:Dettag