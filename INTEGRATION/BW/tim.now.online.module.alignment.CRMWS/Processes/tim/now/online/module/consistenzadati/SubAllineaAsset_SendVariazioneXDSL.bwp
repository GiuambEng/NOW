                                    inputVariable="JDBCQuery1-input"
                                    name="JDBCQuery1"
                                    outputVariable="JDBCQuery1"
                                    tibex:xpdlId="c993d62c-7a26-4da8-ba86-6a753aca7968" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart11ToCounterFinale"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToCounterFinale"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c993d62c-7a26-4da8-ba86-6a753aca7968+input&quot; xmlns:ns1=&quot;www.tim.now.checkXDSLATMVC&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ConteggioAttributoGBE&quot;/>&lt;xsl:param name=&quot;New_GBE&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;PROFILO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:Profilo_BMD)&quot;>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:Profilo_BMD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO>&lt;ID_OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:Id_Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/ns:Id_Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OFFERTA>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:SVLANCODE)&quot;>&lt;xsl:value-of select=&quot;$New_GBE/ns1:Input[number($ConteggioAttributoGBE)]/ns1:SVLANCODE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PROFILO_BMD&#xa;  FROM APPUSER.PROFILO_VLAN_BMD BMD&#xa;  WHERE PROFILO = ?&#xa;    AND ID_SOTTOFAMIG_OFFERTA = (SELECT APPUSER.OFFERTA.ID_SOTTOFAMIG_OFFERTA&#xa;                           FROM APPUSER.OFFERTA&#xa;                           WHERE ID_OFFERTA = ?)&#xa;    AND IDTPLG_VLAN = (SELECT TP.IDTPLG_VLAN&#xa;                 FROM APPUSER.ANAG_VLAN AV JOIN APPUSER.TIPOLG_VLAN TP ON TP.DESCR = AV.TIPOLG&#xa;                 WHERE AV.COD_VLAN = ?)&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_OFFERTA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_VLAN"/>
                                    <columnMetadata
                                    columnName="ID_PROFILO_BMD"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Log_2-input"
                    name="Log_2"
                    tibex:xpdlId="227a2f8c-1da6-448a-8cfa-596eb953626d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
