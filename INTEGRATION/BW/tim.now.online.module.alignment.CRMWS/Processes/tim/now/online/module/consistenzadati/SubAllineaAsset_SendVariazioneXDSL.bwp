                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.dettaglio.asset.customizzato&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettComp2ToModify&quot;/>&lt;xsl:param name=&quot;ConteggioDettaglioGBE&quot;/>&lt;xsl:param name=&quot;CheckRisorsa_GBE&quot;/>&lt;xsl:param name=&quot;Mapper2&quot;/>&lt;xsl:template name=&quot;Mapper4-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckRisorsa_GBE='UPDATE'&quot;>&lt;ns:DettaglioAsset_Customizzato>&lt;ns:LavorazioneDettaglio>&lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&lt;/ns:LavorazioneDettaglio>&lt;ns:IDAsset>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/IDAsset&quot;/>&lt;/ns:IDAsset>&lt;xsl:if test=&quot;$Mapper2/ns1:DettaglioAsset[1]/IDDettaglioAssetParent&quot;>&lt;ns:IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/IDDettaglioAssetParent&quot;/>&lt;/ns:IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper2/ns1:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;>&lt;ns:IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;/>&lt;/ns:IDDettaglioAssetRoot>&lt;/xsl:if>&lt;ns:IntegrationID>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/integrationID&quot;/>&lt;/ns:IntegrationID>&lt;ns:created>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/created&quot;/>&lt;/ns:created>&lt;xsl:if test=&quot;$Mapper2/ns1:DettaglioAsset[1]/lastUpdate&quot;>&lt;ns:lastUpdate>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/lastUpdate&quot;/>&lt;/ns:lastUpdate>&lt;/xsl:if>&lt;ns:operatore>&lt;xsl:value-of select=&quot;$Mapper2/ns1:DettaglioAsset[1]/operatore&quot;/>&lt;/ns:operatore>&lt;