            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="aaab19a5-a3e2-4c4e-94a8-d96444fc7480">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToMapper9"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence5" tibex:group="while">
                    <bpws:assign name="GroupInit5"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+c919bf91-67e0-494f-98ea-4b4ba3f4887c" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ConteggioComponente2&lt;=count($DettComp2ToModify/ns0:DettaglioAsset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioComponente2<=count($DettComp2ToModify/ns0:DettaglioAsset)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToIterate2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="While2ToMapper5" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign3ToLog_11" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AssignToConteggioDettaglio" tibex:linkType="SUCCESS"/>
