            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a6d5c1a1-12d6-41b8-aeaa-20cabf9d0619">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEmpty2">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+254b32eb-a897-4f9d-b288-0176c5dbdf86" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate1"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ConteggioComponente1&lt;=count($DettAssetToModify/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente1]/attributidettaglioasset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ConteggioComponente1<=count($DettAssetToModify/ns0:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente1]/attributidettaglioasset)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="CallProcessToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CounterToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MapperToLog_5" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log_5ToCounter" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToEmpty17" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="NoAttrToCounter" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f6613cc3-9421-4017-a0a5-a0149f71f600">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate1"
                                    outputVariable="Accumulate1"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="254b32eb-a897-4f9d-b288-0176c5dbdf86" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CounterToAccumulate1"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ConteggioComponente1"
                                    name="Counter"
                                    outputVariable="ConteggioComponente1"
                                    tibex:xpdlId="591dfe30-672b-44da-9acd-e487ff320f8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Log_5ToCounter"/>
                                    <bpws:target linkName="NoAttrToCounter"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CounterToAccumulate1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$ConteggioComponente1+1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ConteggioComponente1" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="AttrAssetComp1"
                                    name="Assign1"
                                    outputVariable="AttrAssetComp1"
                                    tibex:xpdlId="3a2000ff-7af4-41d2-b0c8-6429a4125ea5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($AttrAssetComp1/ns0:AttributiDettaglioAsset[1]/valoreAttributo)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($AttrAssetComp1/ns0:AttributiDettaglioAsset[1]/valoreAttributo)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Assign1ToEmpty17">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DettAssetToModify&quot;/>&lt;xsl:param name=&quot;ConteggioComponente1&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AttrAssetComp1&quot; match=&quot;/&quot;>&lt;ns:Input_AttributoAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='TIPOLINEA'&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns:AssetCRM/ns:TipoLinea&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='MODULAZIONE'&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns:AssetCRM/ns:Modulazione&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='MODULAZIONE']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='PROFILOTECNICOLINEA'&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns:AssetCRM/ns:ProfiloTecnicoLinea&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='PROFILOTECNICOLINEA']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='IMPRESA' and string-length($DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/valoreAttributo)>0&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IMPRESA']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='CODEDR' and string-length($DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/valoreAttributo)>0&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='CODEDR']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;xsl:when test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[number($ConteggioComponente1)]/nomeAttributo='AGGUP' and string-length($DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/valoreAttributo)>0&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettAssetToModify/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='AGGUP']/nomeAttributo&quot;/>&