                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:ns1=&quot;www.tim.now.allileamentoconsistenze.NomeComponenteChoose&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Componente&quot;/>&lt;xsl:template name=&quot;DettAssetToModify&quot; match=&quot;/&quot;>&lt;ns:Input_DettaglioAsset>&lt;xsl:for-each select=&quot;$Start/ns:DettaglioAsset[nomeComponente=$Componente/ns1:NomeComponente1]&quot;>&lt;ns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo!='TECNOLOGIA']&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/