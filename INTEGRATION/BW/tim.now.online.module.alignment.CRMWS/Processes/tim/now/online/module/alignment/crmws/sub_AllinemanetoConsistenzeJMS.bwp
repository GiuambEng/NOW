                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1472556061373" xmlns:ns="www.tim.now.allineamentoConsistenze.invokeCRMWSEsito" xmlns:tns1="http://www.tim.com/NOW/xsd/AllineamentoConsistenza_JMS/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Operation_1"/&gt;&lt;xsl:param name="Input_1"/&gt;&lt;xsl:param name="Start_SubULL"/&gt;&lt;xsl:param name="Operation_2"/&gt;&lt;xsl:param name="Operation_3"/&gt;&lt;xsl:param name="Start_SubCessULL"/&gt;&lt;xsl:param name="Input_2"/&gt;&lt;xsl:param name="Start_SubCessSLU"/&gt;&lt;xsl:param name="Input_3"/&gt;&lt;xsl:param name="AggConsistenzaNOWFallita"/&gt;&lt;xsl:param name="Operation_4"/&gt;&lt;xsl:param name="Input_4"/&gt;&lt;xsl:param name="Start_SubCessNP"/&gt;&lt;xsl:template name="Invoke_CRMWS-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Operation_4)&gt;0"&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$Input_4/tns1:Transaction_id"/&gt;&lt;/ns:TransactionID&gt;&lt;ns:TransactionDate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TransactionDate&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'02'"/&gt;&lt;/ns:Return_Code&gt;&lt;ns:DescrizioneErrore&gt;&lt;xsl:value-of select="'Errore Generico'"/&gt;&lt;/ns:DescrizioneErrore&gt;&lt;xsl:if test="$Start_SubCessNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:Id_Esec_Proc_NoFile&gt;&lt;xsl:value-of select="$Start_SubCessNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:Id_Esec_Proc_NoFile&gt;&lt;/xsl:if&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_4/tns1:SERVIZIO/tns1:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;xsl:if test="$Input_4/tns1:SERVIZIO/tns1:NPG/tns1:CESSAZIONE/tns1:RISORSA"&gt;&lt;ns:ID_RISORSA&gt;&lt;xsl:value-of select="$Input_4/tns1:SERVIZIO/tns1:NPG/tns1:CESSAZIONE/tns1:RISORSA"/&gt;&lt;/ns:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;ns:ID_RICH&gt;&lt;xsl:value-of select="xsd:integer(substring-before($Start_SubCessNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE,'.'))"/&gt;&lt;/ns:ID_RICH&gt;&lt;ns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="$AggConsistenzaNOWFallita"/&gt;&lt;/ns:ID_STATO_ELAB_STAG&gt;&lt;ns:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_RICH&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Input_4/tns1:Transaction_id"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:OPERATORE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/ns:OPERATORE&gt;&lt;/ns:InputCRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($Operation_1)&gt;0"&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$Input_1/tns1:Transaction_id"/&gt;&lt;/ns:TransactionID&gt;&lt;ns:TransactionDate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TransactionDate&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'02'"/&gt;&lt;/ns:Return_Code&gt;&lt;ns:DescrizioneErrore&gt;&lt;xsl:value-of select="'Errore Generico'"/&gt;&lt;/ns:DescrizioneErrore&gt;&lt;xsl:if test="$Start_SubULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:Id_Esec_Proc_NoFile&gt;&lt;xsl:value-of select="$Start_SubULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:Id_Esec_Proc_NoFile&gt;&lt;/xsl:if&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_1/tns1:SERVIZIO/tns1:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;ns:ID_RISORSA&gt;&lt;xsl:value-of select="$Input_1/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:Risorsa"/&gt;&lt;/ns:ID_RISORSA&gt;&lt;ns:ID_RICH&gt;&lt;xsl:value-of select="xsd:integer(substring-before($Start_SubULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE,'.'))"/&gt;&lt;/ns:ID_RICH&gt;&lt;ns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="$AggConsistenzaNOWFallita"/&gt;&lt;/ns:ID_STATO_ELAB_STAG&gt;&lt;ns:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_RICH&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Input_1/tns1:Transaction_id"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:OPERATORE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/ns:OPERATORE&gt;&lt;/ns:InputCRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($Operation_2)&gt;0"&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$Input_2/tns1:Transaction_id"/&gt;&lt;/ns:TransactionID&gt;&lt;ns:TransactionDate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TransactionDate&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'02'"/&gt;&lt;/ns:Return_Code&gt;&lt;ns:DescrizioneErrore&gt;&lt;xsl:value-of select="'Errore Generico'"/&gt;&lt;/ns:DescrizioneErrore&gt;&lt;xsl:if test="$Start_SubCessULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:Id_Esec_Proc_NoFile&gt;&lt;xsl:value-of select="$Start_SubCessULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:Id_Esec_Proc_NoFile&gt;&lt;/xsl:if&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_2/tns1:SERVIZIO/tns1:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;ns:ID_RISORSA&gt;&lt;xsl:value-of select="$Input_2/tns1:SERVIZIO/tns1:ULLLNA/tns1:CESSAZIONE/tns1:RISORSA"/&gt;&lt;/ns:ID_RISORSA&gt;&lt;ns:ID_RICH&gt;&lt;xsl:value-of select="xsd:integer(substring-before($Start_SubCessULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE, '.'))"/&gt;&lt;/ns:ID_RICH&gt;&lt;ns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="$AggConsistenzaNOWFallita"/&gt;&lt;/ns:ID_STATO_ELAB_STAG&gt;&lt;ns:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_RICH&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Input_2/tns1:Transaction_id"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:OPERATORE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/ns:OPERATORE&gt;&lt;/ns:InputCRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($Operation_3)&gt;0"&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$Input_3/tns1:Transaction_id"/&