&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="hhttp://www.tim.com/NOW/xsd/CRMWStoNOW_GetRiscontroConsistenza_output/" xmlns:tns1="http://xmlns.example.com/1472556061373" xmlns:ns="www.tim.now.allineamentoConsistenze.invokeCRMWSEsito" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/AllineamentoConsistenza_JMS/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="RequestCessNP"/&gt;&lt;xsl:param name="SendCessazioneNP"/&gt;&lt;xsl:param name="Start_SubCessNP"/&gt;&lt;xsl:param name="AggConsistenzaNOWAvvenutoConSuccesso"/&gt;&lt;xsl:param name="AggConsistenzaNOWFallita"/&gt;&lt;xsl:template name="InvokeCRMWS_3-input" match="/"&gt;&lt;tns1:Input&gt;&lt;part1&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$RequestCessNP/tns:Transaction_ID"/&gt;&lt;/ns:TransactionID&gt;&lt;ns:TransactionDate&gt;&lt;xsl:value-of select="$RequestCessNP/tns:Transaction_Date"/&gt;&lt;/ns:TransactionDate&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="$RequestCessNP/tns:Return_Code"/&gt;&lt;/ns:Return_Code&gt;&lt;xsl:if test="$RequestCessNP/tns:Descrizione_Errore"&gt;&lt;ns:DescrizioneErrore&gt;&lt;xsl:value-of select="$RequestCessNP/tns:Descrizione_Errore"/&gt;&lt;/ns:DescrizioneErrore&gt;&lt;/xsl:if&gt;&lt;ns:Id_Esec_Proc_NoFile&gt;&lt;xsl:value-of select="substring-before($Start_SubCessNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.')"/&gt;&lt;/ns:Id_Esec_Proc_NoFile&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$SendCessazioneNP/part1/tns2:Send_Cessazione_NP_Request/tns2:SERVIZIO/tns2:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;xsl:if test="$SendCessazioneNP/part1/tns2:Send_Cessazione_NP_Request/tns2:SERVIZIO/tns2:NPG/tns2:CESSAZIONE/tns2:RISORSA"&gt;&lt;ns:ID_RISORSA&gt;&lt;xsl:value-of select="$SendCessazioneNP/part1/tns2:Send_Cessazione_NP_Request/tns2:SERVIZIO/tns2:NPG/tns2:CESSAZIONE/tns2:RISORSA"/&gt;&lt;/ns:ID_RISORSA&gt;&lt;/xsl:if&