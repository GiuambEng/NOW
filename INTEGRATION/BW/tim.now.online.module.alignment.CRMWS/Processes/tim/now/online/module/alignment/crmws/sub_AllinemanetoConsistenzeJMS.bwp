                                    <bpws:transitionCondition><![CDATA[$Find_CaseData.part1/tns1:Find/tns1:Asset/codificaOLOAGCOM = $SendCessazioneSLU.part1/tns:SERVIZIO/tns:CodiceOlo and string($Find_CaseData.part1/tns1:Find[1]/tns1:Asset/IDContratto) = $SendCessazioneSLU.part1/tns:SERVIZIO/tns:SLU/tns:CESSAZIONE/tns:CONTRATTO and $Find_CaseData.part1/tns1:Find/tns1:Asset/IDAsset = $SendCessazioneSLU.part1/tns:SERVIZIO/tns:SLU/tns:CESSAZIONE/tns:ID_NOW and $Find_CaseData.part1/tns1:Find/tns1:Asset/offerta = $Select_Offerta/Record[1]/NOME_OFFERTA_ESTERNA]]></bpws:transitionCondition>
