                  &lt;/ns:Id_Esec_Proc_NoFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns1:SERVIZIO/tns1:CodiceOlo&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                    &lt;ns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns1:SERVIZIO/tns1:ULLLNA/tns1:CESSAZIONE/tns1:RISORSA&quot;/>&#xa;                    &lt;/ns:ID_RISORSA>&#xa;                    &lt;ns:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Start_SubCessULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE, '.'))&quot;/>&#xa;                    &lt;/ns:ID_RICH>&#xa;                    &lt;ns:ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$AggConsistenzaNOWFallita&quot;/>&#xa;                    &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;ns:TIMSTP_RICH>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_RICH>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns1:Transaction_id&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/ns:OPERATORE>&#xa;                &lt;/ns:InputCRMWS>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($Operation_3)>0&quot;>&#xa;                &lt;ns:InputCRMWS>&#xa;                    &lt;ns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_3/tns1:Transaction_id&quot;/>&#xa;                    &lt;/ns:TransactionID>&#xa;                    &lt;ns:TransactionDate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:Transactio