DContratto>&#xa;                            &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CESSATO&amp;quot;&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$Find_CaseData.part1/tns:Find/tns:Asset/IDAssetDa&quot;/>&#xa;                           