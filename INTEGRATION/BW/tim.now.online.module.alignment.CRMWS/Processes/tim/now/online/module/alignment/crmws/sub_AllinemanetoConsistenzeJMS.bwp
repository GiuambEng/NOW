                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;hhttp://www.tim.com/NOW/xsd/CRMWStoNOW_GetRiscontroConsistenza_output/&quot; xmlns:tns1=&quot;http://xmlns.example.com/1472556061373&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza_JMS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendCessazioneNP.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start_SubCessNP.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;RequestCessNP&quot;/>&#xa;    &lt;xsl:param name=&quot;AggConsistenzaNOWAvvenutoConSuccesso&quot;/>&#xa;    &lt;xsl:param name=&quot;AggConsistenzaNOWFallita&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeCRMWS_3-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputCRMWS>&#xa;            &lt;ns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessNP/tns:Transaction_ID&quot;/>&#xa;            &lt;/ns:TransactionID>&#xa;            &lt;ns:TransactionDate>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessNP/tns:Transaction_Date&quot;/>&#xa;            &lt;/ns:TransactionDate>&#xa;            &lt;ns:Return_Code>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessNP/tns:Return_Code&quot;/>&#xa;            &lt;/ns:Return_Code>&#xa;            &lt;xsl:if test=&quot;$RequestCessNP/tns:Descrizione_Errore&quot;>&#xa;                &lt;ns:DescrizioneErrore>&#xa;                    &lt;xsl:value-of select=&quot;$RequestCessNP/tns:Descrizione_Errore&quot;/>&#xa;                &lt;/ns:DescrizioneErrore>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:Id_Esec_Proc_NoFile>&#xa;                &lt;xsl:value-of select=&quot;substring-before($Start_SubCessNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.')&quot;/>&#xa;            &lt;/ns:Id_Esec_Proc_NoFile>&#xa;            &lt;ns:COD_OLO>&#xa;                &lt;xsl:value-of select=&quot;$SendCessazioneNP.part1/tns2:SERVIZIO/tns2:CodiceOlo&quot;/>&#xa;            &lt;/ns:COD_OLO>&#xa;            &lt;xsl:if test=&quot;$SendCessazioneNP.part1/tns2:SERVIZIO/tns2:NPG/tns2:CESSAZIONE/tns2:RISORSA&quot;>&#xa;                &lt;ns:ID_RISORSA>&#xa;                    &lt;xsl:value-of select=&quot;$SendCessazioneNP.part1/tns2:SERVIZIO/tns2:NPG/tns2:CESSAZIONE/tns2:RISORSA&quot;/>&#xa;                &lt;/ns:ID_RISORSA>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_RICH>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Start_SubCessNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE, '.'))&quot;/>&#xa;            &lt;/ns:ID_RICH>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RequestCessNP/tns:Return_Code='00'&quot;>&#xa;                    &lt;ns:ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$AggConsistenzaNOWAvvenutoConSuccesso&quot;/>&#xa;                    &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$AggConsistenzaNOWFallita&quot;/>&#xa;                    &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:TIMSTP_RICH>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/ns:TIMSTP_RICH>&#xa;            &lt;ns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessNP/tns:Transaction_ID&quot;/>&#xa;            &lt;/ns:TRANSACTION_ID>&#xa;            &lt;ns:OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;       