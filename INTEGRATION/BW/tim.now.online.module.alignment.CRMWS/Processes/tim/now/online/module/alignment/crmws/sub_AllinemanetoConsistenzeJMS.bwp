                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/AllineamentoConsistenza_JMS/" version="2.0"&gt;&lt;xsl:param name="FaultDetails5"/&gt;&lt;xsl:param name="Operation_1"/&gt;&lt;xsl:param name="ID_PROCSO_ULL"/&gt;&lt;xsl:param name="Operation_2"/&gt;&lt;xsl:param name="ID_PROCSO_CESSULL"/&gt;&lt;xsl:param name="ID_PROCSO_CESSSLU"/&gt;&lt;xsl:param name="Operation_3"/&gt;&lt;xsl:param name="Start_SubCessSLU"/&gt;&lt;xsl:param name="Start_SubCessULL"/&gt;&lt;xsl:param name="Start_SubULL"/&gt;&lt;xsl:param name="Input_1"/&gt;&lt;xsl:param name="Input_2"/&gt;&lt;xsl:param name="Input_3"/&gt;&lt;xsl:param name="Operation_4"/&gt;&lt;xsl:param name="ID_PROCSO_CESSNP"/&gt;&lt;xsl:param name="Input_4"/&gt;&lt;xsl:param name="Start_SubCessNP"/&gt;&lt;xsl:template name="ManageError-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="&amp;quot;Out_All_Asset&amp;quot;"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails5/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails5/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails5/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails5/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails5/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Operation_4='SendCessazioneNP' or $FaultDetails5/ActivityName='SendCessazioneNP'"&gt;&lt;xsl:if test="$Start_SubCessNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$Start_SubCessNP/part1/ns1:Output/ns1:Esi