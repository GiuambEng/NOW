                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza_JMS/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start_SubULL.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start_SubCessNP.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start_SubCessULL.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start_SubCessSLU.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails5&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_ULL&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_2&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSULL&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSSLU&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_3&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_2&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_3&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_4&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSNP&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_4&quot;/>&#xa;    &lt;xsl:template name=&quot;ManageError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Out_All_Asset&amp;quot;&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails5/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails5/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails5/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails5/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails5/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Operation_4='SendCessazioneNP' or $FaultDetails5/ActivityName='SendCessazioneNP'&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start_SubCessNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Start_SubCessNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_1='SendVariazioneULLNA' or $FaultDetails5/ActivityName='SendVariazioneULLNA'&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start_SubULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Start_SubULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_2='SendCessazioneULLNA' or $FaultDetails5/ActivityName='SendCessazioneULLNA'&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start_SubCessULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt