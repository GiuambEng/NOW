sset/CAP"/&gt;&lt;/CAP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceISTATComune"&gt;&lt;codiceISTATComune&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceISTATComune"/&gt;&lt;/codiceISTATComune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceISTATProvincia"&gt;&lt;codiceISTATProvincia&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceISTATProvincia"/&gt;&lt;/codiceISTATProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica"&gt;&lt;codiceToponomastica&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/codiceToponomastica"/&gt;&lt;/codiceToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/comune"&gt;&lt;comune&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/comune"/&gt;&lt;/comune&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/descrPartToponomastica"&gt;&lt;descrPartToponomastica&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/descrPartToponomastica"/&gt;&lt;/descrPartToponomastica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/descrizioneVia"&gt;&lt;descrizioneVia&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/descrizioneVia"/&gt;&lt;/descrizioneVia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/localita"&gt;&lt;localita&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/localita"/&gt;&lt;/localita&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/numeroCivico"&gt;&lt;numeroCivico&gt;&lt;xsl:value-of select="$FindCase_1/part1/tns:Output/tns:Find/tns:Asset/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FindCase_1/part1/tns: