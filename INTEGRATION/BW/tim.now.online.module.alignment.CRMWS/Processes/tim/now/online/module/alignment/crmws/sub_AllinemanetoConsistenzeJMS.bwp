                     &lt;/descrizioneVia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Civico&quot;>&#xa;                                    &lt;numeroCivico>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Civico&quot;/>&#xa;                                    &lt;/numeroCivico>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIO