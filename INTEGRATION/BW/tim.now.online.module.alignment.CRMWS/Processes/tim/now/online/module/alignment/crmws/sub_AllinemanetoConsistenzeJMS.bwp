xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico,2,3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLLI_della_centrale&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLLI_della_centrale&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:if test=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/codiceSLAAssurance&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/codiceSLAAssurance&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/IDRisorsaNOW&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/IDOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;xsl:if test=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/indirizzoEstesoNonCert&quot;>&#xa;                            &lt;indirizzoEstesoNonCert>&#xa;                                &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/indirizzoEstesoNonCert&quot;/>&#xa;                            &lt;/indirizzoEstesoNonCert>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/numeroFittizio&quot;>&#xa;                            &lt;numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/numeroFittizio&quot;/>&#xa;                            &lt;/numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Asset>&#xa;                &lt;/tns2:Input>&#xa;            &lt;/tns2:Update>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
