_2/tns1:CorrelationID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$Input_2/tns1:CorrelationID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($Input_3/tns1:CorrelationID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Input_3/tns1:CorrelationID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$Input_3/tns1:CorrelationID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Operation_4='SendCessazioneNP' or $FaultDetails5/ActivityName='SendCessazioneNP'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSNP&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_1='SendVariazioneULLNA' or $FaultDetails5/ActivityName='SendVariazioneULLNA'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_ULL&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_2='SendCessazioneULLNA' or $FaultDetails5/ActivityName='SendCessazioneULLNA'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSULL&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_3='SendCessazioneSLU'