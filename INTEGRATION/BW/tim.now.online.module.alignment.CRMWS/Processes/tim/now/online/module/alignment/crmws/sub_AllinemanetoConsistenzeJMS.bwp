                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindCase_1.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCase_1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDContratto&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;>&#xa;                            &lt;IDAssetCRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAssetCRMWS&quot;/>&#xa;                            &lt;/IDAssetCRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$FindCase_1.part1/tns:Find/tns:Asset/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;     