part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:Servizio='01'&quot;>&#xa;                                &lt;dettaglioasset>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_01/ns:DettaglioAsset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_01/ns:DettaglioAsset/@*&quot;/>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_01/ns:DettaglioAsset/node()&quot;/>&#xa;                                &lt;/dettaglioasset>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;dettaglioasset>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_02/ns:DettaglioAsset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_02/ns:DettaglioAsset/@*&quot;/>&#xa;                                    &lt;xsl:copy-of select=&quot;$TipServizio_02/ns:DettaglioAsset/node()&quot;/>&#xa;                                &lt;/dettaglioasset>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindCaseData.part1/tns2:Find/tns2:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Cap&quot;>&#xa;                                    &lt;CAP>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:Cap&quot;/>&#xa;                                    &lt;/CAP>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:CodiceComune&quot;>&#xa;                                    &lt;codiceISTATComune>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:CodiceComune&quot;/>&#xa;                                    &lt;/codiceISTATComune>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=0 or not(exists($QueryNumeCivico/Record))&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:istatProv&quot;>&#xa;                                    &lt;codiceISTATProvincia>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:istatProv&quot;/>&#xa;                                    &lt;/codiceISTATProvincia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$QueryNumeCivico/Record[1]/COUNT=1&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:SEDE/tns:CodiceIndirizzo&quot;>&#xa;                                    &lt;codiceToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneULLNA.part1/tns:SERVIZIO/tns:ULLLNA/tns