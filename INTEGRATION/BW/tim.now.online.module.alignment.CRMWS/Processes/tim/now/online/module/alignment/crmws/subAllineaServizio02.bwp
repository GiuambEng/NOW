            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;DettaglioAssetNoULL&quot;/>&lt;xsl:param name=&quot;DettaglioAssetULL&quot;/>&lt;xsl:param name=&quot;Permutaore2&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IndicatorediAssurance&quot;/>&lt;xsl:param name=&quot;Idarlti&quot;/>&lt;xsl:param name=&quot;DataPermutaArmadio&quot;/>&lt;xsl:param name=&quot;PermutaArmadio&quot;/>&lt;xsl:param name=&quot;BitRate&quot;/>&lt;xsl:param name=&quot;CodeCentraleAclrr&quot;/>&lt;xsl:param name=&quot;IdUllco&quot;/>&lt;xsl:param name=&quot;Permutatore1&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Input_DettaglioAsset>&lt;xsl:copy-of select=&quot;$DettaglioAssetNoULL/tns:DettaglioAsset&quot;/>&lt;tns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$DettaglioAssetULL/tns:DettaglioAsset[1]/lastUpdate