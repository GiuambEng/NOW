                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="f8ab59fa-a5ac-4250-9b23-33e0c8c9d69e">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEmpty"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+d91e8f9b-b8ef-4312-a11a-2f8b534908b9" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Counter&lt;=count($DettaglioAssetULL/ns0:DettaglioAsset[1]/attributidettaglioasset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Counter<=count($DettaglioAssetULL/ns0:DettaglioAsset[1]/attributidettaglioasset)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToDettAssetULLD" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MapperToLog_Attr" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="AttrDettAssetDToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AttrDettAssetULLDToLog_Attr_1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log_Attr_1ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log_Attr_2ToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log_AttrToContatore" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="cd87dd4d-6c9d-4a5a-a245-3923dd82e2a4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToDettAssetULLD">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/ns0:AssetCRM/ns0:TipologiaVariazione='02' or $Start/ns0:AssetCRM/ns0:TipologiaVariazione='03'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Start/ns0:AssetCRM/ns0:TipologiaVariazione='02' or $Start/ns0:AssetCRM/ns0:TipologiaVariazione='03']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/ns0:AssetCRM/ns0:TipologiaVariazione='01'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Start/ns0:AssetCRM/ns0:TipologiaVariazione='01']]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="d91e8f9b-b8ef-4312-a11a-2f8b534908b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Counter&quot;/>&lt;xsl:param name=&quot;DettaglioAssetULL&quot;/>&lt;xsl:template name=&quot;AttrDettaglioAssetULL&quot; match=&quot;/&quot;>&lt;ns:Input_AttributoAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[number($Counter)]/nomeAttributo='IDULLCO'&quot;>&lt;ns:AttributiDettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns:AssetCRM/ns:IDULLCO&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;$DettaglioAssetULL/ns:DettaglioAsset[1]/attributidettaglioasset[nomeAttributo='IDULLCO']/IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/ns:AttributiDettaglioAsset>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choos