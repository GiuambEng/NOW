                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DettaglioAssetNoULL&quot; match=&quot;/&quot;>&lt;ns:Input_DettaglioAsset>&lt;xsl:for-each select=&quot;$Start/ns:DettaglioAsset[nomeComponente!=&amp;quot;ACCESSOULLDATI&amp;quot;]&quot;>&lt;ns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:copy-of select=&quot;attributidettaglioasset&quot;/>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;progressivo&quot;/>&lt;/progressivo>&lt;/ns:DettaglioAsset>&lt;/xsl:for-each>&lt;/ns:Input_DettaglioAsset>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DettaglioAssetNoULL"
                    name="DettAssetNoULLD"
                    outputVariable="DettaglioAssetNoULL"
                    tibex:xpdlId="60953707-ba4e-402c-a8c9-bde7f529e208" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToDettAssetNoULLD"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DettAssetNoULLDToLog_DettNoULLD"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsisstenze.DettaglioAsset.xsd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;DettaglioAssetNoULL&quot; match=&quot;/&quot;>&lt;ns:Input_DettaglioAsset>&lt;xsl:for-each select=&quot;$Start/ns:DettaglioAsset[nomeComponente!=&amp;quot;ACCESSOULLDATI&amp;quot;]&quot;>&lt;ns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:copy-of select=&quot;attributidettaglioasset&quot;/>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;progressivo&quot;/>&lt;/progressivo>&lt;/ns:DettaglioAsset>&lt;/xsl:for-each>&lt;/ns:Input_Dettag