&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns1="http://www.example.org/ServicesSecurityData" xmlns:ns="www.tim.now.HeaderConnection" xmlns:tns2="http://www.example.org/tim.now.xsd.NowCheckOrdineInCorsoDNRisorsa" xmlns:tns3="http://www.example.com/namespaces/tns/1564740682912" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" version="2.0"&gt;&lt;xsl:param name="LoggerName"/&gt;&lt;xsl:param name="LoggerLevel"/&gt;&lt;xsl:param name="GetContext"/&gt;&lt;xsl:param name="NOWCheckOrdineInCorsoDNRisorsa"/&gt;&lt;xsl:param name="GetLocalIP"/&gt;&lt;xsl:param name="InsProcNOFILE"/&gt;&lt;xsl:template name="SecurityLogger-input" match="/"&gt;&lt;tns:NewOperationRequest&gt;&lt;parameters&gt;&lt;tns1:LoggerSecurityInput&gt;&lt;tns1:LogInfo&gt;&lt;tns1:LoggerName&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:LoggerName&gt;&lt;tns1:Application&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:Application&gt;&lt;tns1:LogLevel&gt;&lt;xsl:value-of select="$LoggerLevel"/&gt;&lt;/tns1:LogLevel&gt;&lt;tns1:ServiceName&gt;&lt;xsl:value-of select="'NOWCheckOrdineInCorso'"/&gt;&lt;/tns1:ServiceName&gt;&lt;tns1:Operation&gt;&lt;xsl:value-of select="'NOWCheckOrdineInCorsoDNRisorsa'"/&gt;&lt;/tns1:Operation&gt;&lt;tns1:JMS&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:JMS&gt;&lt;/tns1:LogInfo&gt;&lt;tns1:InputDataUserLog&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="'CHECK ORDINE IN CORSO DA CRMWS'"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;tns1:COD_FUNZIONE&gt;&lt;xsl:value-of select="'Monitoraggio Accessi M2M'"/&gt;&lt;/tns1:COD_FUNZIONE&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="'M2M'"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:HOSTNAME_CLIENT&