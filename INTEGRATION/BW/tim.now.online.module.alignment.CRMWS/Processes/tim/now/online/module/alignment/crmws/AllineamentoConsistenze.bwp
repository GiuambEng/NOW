&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="CessazionULL"/&gt;&lt;xsl:param name="CessazioneSLU"/&gt;&lt;xsl:param name="FaultDetails3"/&gt;&lt;xsl:param name="Operation_1"/&gt;&lt;xsl:param name="ID_PROCSO_ULL"/&gt;&lt;xsl:param name="Operation_2"/&gt;&lt;xsl:param name="ID_PROCSO_CESSULL"/&gt;&lt;xsl:param name="ID_PROCSO_CESSSLU"/&gt;&lt;xsl:param name="ProcessULLNA"/&gt;&lt;xsl:param name="Operation_4"/&gt;&lt;xsl:param name="CessazionNP"/&gt;&lt;xsl:param name="ID_PROCSO_CESSNP"/&gt;&lt;xsl:template name="ManageError-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="&amp;quot;In_All_Asset&amp;quot;"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails3/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails3/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails3/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails3/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails3/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($CessazionNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$CessazionNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$CessazionNP/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($CessazionULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) &gt; 0"&gt;&lt;xsl:if test="$CessazionULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$CessazionULL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(string($CessazionNP/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID))&gt;0"&gt;&lt;xsl:if test="$CessazionNP/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$CessazionNP/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length(string($ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID))&gt;0"&gt;&lt;xsl:if test="$ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$ProcessULLNA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length(string($CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID))&gt;0"&gt;&lt;xsl:if test="$CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$CessazioneSLU/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length(string($CessazionULL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID)) &gt; 0"&gt;&lt;xsl:if test="$CessazionULL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$CessazionULL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Operation_4='CessazioneNP' or $FaultDetails3/ActivityName='SendCessazioneNP'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_CESSNP"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Operation_1='SendVariazioneULL' or $FaultDetails3/ActivityName='SendVariazioneULLNA'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_ULL"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Operation_2='CessazioneULL' or $FaultDetails3/ActivityName='SendCessazioneULLNA'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_CESSULL"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_CESSSLU"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessULLNA.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazionNP.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazionULL.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazioneSLU.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails3&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_1&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_ULL&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_2&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSULL&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSSLU&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_4&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSNP&quot;/>&#xa;    &lt;xsl:template name=&quot;ManageError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;In_All_Asset&amp;quot;&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CessazionNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazionNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$CessazionNP.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessULLNA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessULLNA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessULLNA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CessazionULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazionULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$CessazionULL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CessazioneSLU.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazioneSLU.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$CessazioneSLU.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CessazionNP.part1/ns1:Esito/ns1:CORRELATION_ID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazionNP.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$CessazionNP.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($ProcessULLNA.part1/ns1:Esito/ns1:CORRELATION_ID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessULLNA.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessULLNA.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($CessazioneSLU.part1/ns1:Esito/ns1:CORRELATION_ID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazioneSLU.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$CessazioneSLU.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($CessazionULL.part1/ns1:Esito/ns1:CORRELATION_ID)) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CessazionULL.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$CessazionULL.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Operation_4='CessazioneNP' or $FaultDetails3/ActivityName='SendCessazioneNP'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSNP&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_1='SendVariazioneULL' or $FaultDetails3/ActivityName='SendVariazioneULLNA'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_ULL&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation_2='CessazioneULL' or $FaultDetails3/ActivityName='SendCessazioneULLNA'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSULL&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSSLU&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorLogToManageError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source
                                    linkName="ManageErrorToEmpty"
                                    tibex:faultDetailsVar="ManageError" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ManageErrorToCallProcess"/>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails3&quot;/>&lt;xsl:template name=&quot;ErrorLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoConsistenze'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails3)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="ErrorLog-input"
                                name="ErrorLog"
                                tibex:xpdlId="792c972f-4635-4870-b4b1-59483ff4b7c4"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="ErrorLogToManageError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails3&quot;/>&lt;xsl:template name=&quot;ErrorLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoConsistenze'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails3)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:empty name="Choice" tibex:xpdlId="21eb6faf-7e4d-4f23-b710-2f19ce793c8c">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToChoice"/>
                                <bpws:target linkName="CallProcessToChoice1"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ChoiceToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Operation_2='CessazioneULL' or $FaultDetails3/ActivityName='SendCessazioneULLNA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation_2='CessazioneULL' or $FaultDetails3/ActivityName='SendCessazioneULLNA']]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ChoiceToMapper1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Operation_1='SendVariazioneULL' or $FaultDetails3/ActivityName='SendVariazioneULLLNA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation_1='SendVariazioneULL' or $FaultDetails3/ActivityName='SendVariazioneULLLNA']]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ChoiceToMapper2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ChoiceToMapper3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Operation_4='CessazioneNP' or $FaultDetails3/ActivityName='SendCessazioneNP'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation_4='CessazioneNP' or $FaultDetails3/ActivityName='SendCessazioneNP']]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
