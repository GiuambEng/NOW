                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendVariazioneULLLNA&quot;/>&lt;xsl:template name=&quot;SendVariazioneULLLNA_Input-input&quot; match=&quot;/&quot;>&lt;tns:Send_Variazione_Ullna_Request>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;tns:SERVIZIO>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;tns:DescOLO>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:DescOLO&quot;/>&lt;/tns:DescOLO>&lt;tns:ULLLNA>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:Servizio&quot;/>&lt;/tns:Servizio>&lt;tns:VARIAZIONE>&lt;tns:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CodiceOrdineOlo&quot;/>&lt;/tns:CodiceOrdineOlo>&lt;tns:CodiceOrdineTI>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CodiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineTI>&lt;tns:Contratto>&lt;xsl:value-of select=&quot;$SendVariazioneULLLNA/part1/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Contratto&quot;/>&lt;/tns:Contratto>&lt;tns:Risorsa>&lt;xsl:value-of select=&quot;$SendVar