                                    <bpws:sources>
                                    <bpws:source linkName="LogFindCaseXDSLToAssign">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$finde_Case/part1/tns1:Output/tns1:Find/tns1:Asset/codificaOLOAGCOM = $SendVariazioneXDSL/part1/tns2:Now_SendVariazioneXDSL_Request/tns2:SERVIZIO/tns2:CodiceOlo and string($finde_Case/part1/tns1:Output/tns1:Find[1]/tns1:Asset/IDContratto)=$SendVariazioneXDSL/part1/tns2:Now_SendVariazioneXDSL_Request/tns2:SERVIZIO/tns2:VARIAZIONE/tns2:Contratto and $finde_Case/part1/tns1:Output/tns1:Find/tns1:Asset/IDAsset=$SendVariazioneXDSL/part1/tns2:Now_SendVariazioneXDSL_Request/tns2:SERVIZIO/tns2:VARIAZIONE/tns2:ID_NOW and $finde_Case/part1/tns1:Output/tns1:Find/tns1:Asset/offerta=$Offerta/Record[1]/NOME_OFFERTA_ESTERNA and $finde_Case/part1/tns1:Output/tns1:Find/tns1:Response/tns1:Esito='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
