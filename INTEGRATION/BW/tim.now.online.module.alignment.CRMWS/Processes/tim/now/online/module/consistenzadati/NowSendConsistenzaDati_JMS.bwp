>&lt;ns:VPI>&lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&lt;/ns:VPI>&lt;ns:VCI>&lt;xsl:value-of select=&quot;tns1:VCI&quot;/>&lt;/ns:VCI>&lt;ns:SVLANCODE>&lt;xsl:value-of select=&quot;tns1:CODICE_VLAN&quot;/>&lt;/ns:SVLANCODE>&lt;ns:IDRISORSAVC>&lt;xsl:value-of select=&quot;tns1:ID_RISORSA_USERVLAN&quot;/>&lt;/ns:IDRISORSAVC>&lt;xsl:if test=&quot;tns1:PROTOCOLLO_PILA_IPOA/tns1:IP_KIT&quot;>&lt;ns:IP_KIT>&lt;xsl:value-of select=&quot;tns1:PROTOCOLLO_PILA_IPOA/tns1:IP_KIT&quot;/>&lt;/ns:IP_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:PROTOCOLLO_PILA_IPOA/tns1:IP_DSLAM&quot;>&lt;ns:IP_DSLAM>&lt;xsl:value-of select=&quot;tns1:PROTOCOLLO_PILA_IPOA/tns1:IP_DSLAM&quot;/>&lt;/ns:IP_DSLAM>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CVlanCode&quot;>&lt;ns:CVlanId>&lt;xsl:value-of select=&quot;tns1:CVlanCode&quot;/>&lt;/ns:CVlanId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:ProtocolloPila&quot;>&lt;ns:Protocollo_Pila>&lt;xsl:value-of select=&quot;tns1:ProtocolloPila&quot;/>&lt;/ns:Protocollo_Pila>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Profilo_BMD&quot;>&lt;ns:Profilo_BMD>&lt;xsl:value-of select=&quot;tns1:Profilo_BMD&quot;/>&lt;/ns:Profilo_BMD>&lt;/xsl:if>&lt;/ns:GBEVC>&lt;/xsl:for-each>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
