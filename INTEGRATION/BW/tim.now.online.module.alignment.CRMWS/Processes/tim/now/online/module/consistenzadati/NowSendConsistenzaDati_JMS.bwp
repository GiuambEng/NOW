/tns:Asset/numeroCivico"/&gt;&lt;/numeroCivico&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$finde_Case/part1/tns:Output/tns:Find/tns:Asset/provincia"&gt;&lt;provincia&gt;&lt;xsl:value-of select="$finde_Case/part1/tns:Output/tns:Find/tns:Asset/provincia"/&gt;&lt;/provincia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$finde_Case/part1/tns:Output/tns:Find/tns:Asset/siglaProvincia"&gt;&lt;siglaProvincia&gt;&lt;xsl:value-of select="$finde_Case/part1/tns:Output/tns:Find/tns:Asset/siglaProvincia"/&gt;&lt;/siglaProvincia&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=2"&gt;&lt;distretto&gt;&lt;xsl:value-of select="tib:pad-front($SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto, 3,'0')"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=3"&gt;&lt;distretto&gt;&lt;xsl:value-of select="$SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=4"&gt;&lt;distretto&gt;&lt;xsl:value-of select="substring($SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto, 2, 3)"/&gt;&lt;/distretto&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;CLLI&gt;&lt;xsl:value-of select="$SendVariazioneXDSL/part1/tns1:Now_SendVariazioneXDSL_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:CLLI"/&gt;&lt;/CLLI&gt;&lt;CRMOrigine&gt;&lt;xsl:value-of select="$finde_Case/part1/tns:Output/tns:Find/tns:Asset/CRMOr