RE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/ns:OPERATORE&gt;&lt;/ns:InputCRMWS&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:InputCRMWS&gt;&lt;ns:TransactionID&gt;&lt;xsl:value-of select="$Input_3/tns4:REQUEST/tns4:Transaction_id"/&gt;&lt;/ns:TransactionID&gt;&lt;ns:TransactionDate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TransactionDate&gt;&lt;ns:Return_Code&gt;&lt;xsl:value-of select="'02'"/&gt;&lt;/ns:Return_Code&gt;&lt;ns:DescrizioneErrore&gt;&lt;xsl:value-of select="'Errore Generico'"/&gt;&lt;/ns:DescrizioneErrore&gt;&lt;xsl:if test="$ManageError_3/part1/ns2:Output/ns2:IdEsecProcsoNoFile"&gt;&lt;ns:Id_Esec_Proc_NoFile&gt;&lt;xsl:value-of select="$ManageError_3/part1/ns2:Output/ns2:IdEsecProcsoNoFile"/&gt;&lt;/ns:Id_Esec_Proc_NoFile&gt;&lt;/xsl:if&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Input_3/tns4:SERVIZIO/tns4:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;ns:ID_RISORSA&gt;&lt;xsl:value-of select="$Input_3/tns4:SERVIZIO/tns4:CESSAZIONE/tns4:Risorsa"/&gt;&lt;/ns:ID_RISORSA&gt;&lt;ns:ID_RICH&gt;&lt;xsl:value-of select="xsd:integer($ManageError_3/part1/ns2:Output/ns2:IdEsecProcsoNoFile)"/&gt;&lt;/ns:ID_RICH&gt;&lt;ns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="$AggConsistenzaNOWFallita"/&gt;&lt;/ns:ID_STATO_ELAB_STAG&gt;&lt;ns:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_RICH&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Input_3/tns4:REQUEST/tns4:Transaction_id"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:OPERATORE&gt;&lt;xsl:value-of select="'AUTOMATICO'"/&gt;&lt;/ns:OPERATORE&gt;&lt;/ns:InputCRMWS&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1472556061373&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.example.org/tim.now.xsd.SendCessazioneDati_JMS&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendVariazioneNGA_JMS&quot; xmlns:ns2=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.SendVariazioneXDSL_JMS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ManageError_3.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_3&quot;/>&#xa;    &lt;xsl:param name=&quot;AggConsistenzaNOWFallita&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_1&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails2&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation_2&quot;/>&#xa;    &lt;xsl:param name=&quot;Input_2&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_CRMWS3-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Operation_1='SendVariazioneNGA' or $FaultDetails2/ActivityName='SendVariazioneNGA'&quot;>&#xa;                &lt;ns:InputCRMWS>&#xa;                    &lt;ns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_1/tns1:REQUEST/tns1:Transaction_id&quot;/>&#xa;                    &lt;/ns:TransactionID>&#xa;                    &lt;ns:TransactionDate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TransactionDate>&#xa;                    &lt;ns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;'02'&quot;/>&#xa;                    &lt;/ns:Return_Code>&#xa;                    