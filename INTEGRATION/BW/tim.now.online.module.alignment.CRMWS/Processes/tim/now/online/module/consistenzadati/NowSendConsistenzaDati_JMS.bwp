                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$findCase.part1/tns1:Find/tns1:Asset/codificaOLOAGCOM = $SendVariazioneNGA.part1/tns:SERVIZIO/tns:CodiceOlo and string($findCase.part1/tns1:Find[1]/tns1:Asset/IDContratto)=$SendVariazioneNGA.part1/tns:SERVIZIO/tns:VARIAZIONE/tns:Contratto and $findCase.part1/tns1:Find/tns1:Asset/IDAsset=$SendVariazioneNGA.part1/tns:SERVIZIO/tns:VARIAZIONE/tns:ID_NOW and $findCase.part1/tns1:Find/tns1:Asset/offerta=$SelectOfferta/Record[1]/NOME_OFFERTA_ESTERNA and $findCase.part1/tns1:Find/tns1:Response/tns1:Esito='OK']]></bpws:transitionCondition>
