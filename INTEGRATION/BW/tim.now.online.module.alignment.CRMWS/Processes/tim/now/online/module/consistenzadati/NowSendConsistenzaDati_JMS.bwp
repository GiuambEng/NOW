                                    expression="$find_CaseData/part1/tns1:Output/tns1:Find/tns1:Asset/codificaOLOAGCOM = $SendCessazioneDati/part1/tns3:Now_SendCessazioneDati_Request/tns3:SERVIZIO/tns3:CodiceOlo and string($find_CaseData/part1/tns1:Output/tns1:Find[1]/tns1:Asset/IDContratto)=$SendCessazioneDati/part1/tns3:Now_SendCessazioneDati_Request/tns3:SERVIZIO/tns3:CESSAZIONE/tns3:Contratto and $find_CaseData/part1/tns1:Output/tns1:Find/tns1:Asset/IDAsset=$SendCessazioneDati/part1/tns3:Now_SendCessazioneDati_Request/tns3:SERVIZIO/tns3:CESSAZIONE/tns3:ID_NOW and $find_CaseData/part1/tns1:Output/tns1:Find/tns1:Asset/offerta=$Select_Offerta/Record[1]/NOME_OFFERTA_ESTERNA and $find_CaseData/part1/tns1:Output/tns1:Find/tns1:Response/tns1:Esito='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
