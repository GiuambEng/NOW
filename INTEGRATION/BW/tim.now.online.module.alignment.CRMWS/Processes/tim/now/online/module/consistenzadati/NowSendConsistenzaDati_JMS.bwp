                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns1=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendVariazioneNGA_JMS&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendVariazioneNGA.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;findCase.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Sub_AllineamentoNGA&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateCase-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:Update>&#xa;                &lt;tns:Input>&#xa;                    &lt;tns:CaseReference>&#xa;                        &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:CaseReference&quot;/>&#xa;                    &lt;/tns:CaseReference>&#xa;                    &lt;tns:Asset>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/IDAsset&quot;>&#xa;                            &lt;IDAsset>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/IDAsset&quot;/>&#xa;                            &lt;/IDAsset>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:CodiceOrdineOlo&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Codice_ordine_TI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/invariante&quot;>&#xa;                            &lt;invariante>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/invariante&quot;/>&#xa;                            &lt;/invariante>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;>&#xa;                            &lt;IDPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/IDPrimoOrdine&quot;/>&#xa;                            &lt;/IDPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDContratto>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Contratto)&quot;/>&#xa;                        &lt;/IDContratto>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;statoAsset>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/statoAsset&quot;/>&#xa;                        &lt;/statoAsset>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Risorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/numeroTelefonico&quot;>&#xa;                            &lt;numeroTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/numeroTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDAssetCRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:ID_CRMWS&quot;/>&#xa;                        &lt;/IDAssetCRMWS>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/IDAssetDa&quot;>&#xa;                            &lt;IDAssetDa>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/IDAssetDa&quot;/>&#xa;                            &lt;/IDAssetDa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Dec&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;dettaglioasset>&#xa;                            &lt;xsl:copy-of select=&quot;$Sub_AllineamentoNGA/ns1:DettaglioAsset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$Sub_AllineamentoNGA/ns1:DettaglioAsset/@*&quot;/>&#xa;                            &lt;xsl:copy-of select=&quot;$Sub_AllineamentoNGA/ns1:DettaglioAsset/node()&quot;/>&#xa;                        &lt;/dettaglioasset>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/codiceToponomastica&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/descrPartToponomastica&quot;>&#xa;                            &lt;descrPartToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/descrPartToponomastica&quot;/>&#xa;                            &lt;/descrPartToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/descrizioneVia&quot;>&#xa;                            &lt;descrizioneVia>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/descrizioneVia&quot;/>&#xa;                            &lt;/descrizioneVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/localita&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/localita&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/numeroCivico&quot;>&#xa;                            &lt;numeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/numeroCivico&quot;/>&#xa;                            &lt;/numeroCivico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/provincia&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/provincia&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/siglaProvincia&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/siglaProvincia&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto)=2&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tib:pad-front($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto, 3, '0')&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto)=3&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto&quot;>&#xa;                                    &lt;distretto>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto&quot;/>&#xa;                                    &lt;/distretto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Distretto, 2, 3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:CLLI&quot;/>&#xa;                        &lt;/CLLI>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Tipologia_variazione='10' or $SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Tipologia_variazione='11' &quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:SLA/tns1:SlaAssurance)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:SLA/tns1:SlaAssurance&quot;>&#xa;                                            &lt;codiceSLAAssurance>&#xa;                                                &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:SLA/tns1:SlaAssurance&quot;/>&#xa;                                            &lt;/codiceSLAAssurance>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;>&#xa;                                            &lt;codiceSLAAssurance>&#xa;                                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;/>&#xa;                                            &lt;/codiceSLAAssurance>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Tipologia_variazione='12'&quot;>&#xa;                                &lt;xsl:if test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:SLA/tns1:SlaAssurance&quot;>&#xa;                                    &lt;codiceSLAAssurance>&#xa;                                        &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:SLA/tns1:SlaAssurance&quot;/>&#xa;                                    &lt;/codiceSLAAssurance>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:ID_NOW&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDOfferta>&#xa;                            &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/IDOfferta&quot;/>&#xa;                        &lt;/IDOfferta>&#xa;                        &lt;xsl:if test=&quot;$findCase.part1/tns:Find/tns:Asset/indirizzoEstesoNonCert&quot;>&#xa;                            &lt;indirizzoEstesoNonCert>&#xa;                                &lt;xsl:value-of select=&quot;$findCase.part1/tns:Find/tns:Asset/indirizzoEstesoNonCert&quot;/>&#xa;                            &lt;/indirizzoEstesoNonCert>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Aggiuntivo&quot;>&#xa;                            &lt;numeroFittizio>&#xa;                                &lt;xsl:value-of select=&quot;$SendVariazioneNGA.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Aggiuntivo&quot;/>&#xa;                            &lt;/numeroFittizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:Asset>&#xa;                &lt;/tns:Input>&#xa;            &lt;/tns:Update>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
