t1/tns:Find/tns:Asset/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:copy-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/dettaglioasset&quot;/>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceISTATProvincia&quot;/>&#xa;                            &lt;/codiceISTATProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceToponomastica&quot;>&#xa;                            &lt;codiceToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceToponomastica&quot;/>&#xa;                            &lt;/codiceToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/comune&quot;>&#xa;                            &lt;comune>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/comune&quot;/>&#xa;                            &lt;/comune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/descrPartToponomastica&quot;>&#xa;                            &lt;descrPartToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/descrPartToponomastica&quot;/>&#xa;                            &lt;/descrPartToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/descrizioneVia&quot;>&#xa;                            &lt;descrizioneVia>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/descrizioneVia&quot;/>&#xa;                            &lt;/descrizioneVia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/localita&quot;>&#xa;                            &lt;localita>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/localita&quot;/>&#xa;                            &lt;/localita>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/numeroCivico&quot;>&#xa;                            &lt;numeroCivico>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/numeroCivico&quot;/>&#xa;                            &lt;/numeroCivico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/provincia&quot;>&#xa;                            &lt;provincia>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/provincia&quot;/>&#xa;                            &lt;/provincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/siglaProvincia&quot;>&#xa;                            &lt;siglaProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/siglaProvincia&quot;/>&#xa;                            &lt;/siglaProvincia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=2&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tib:pad-front($SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto, 3,'0')&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=3&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;$SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto)=4&quot;>&#xa;                                &lt;distretto>&#xa;                                    &lt;xsl:value-of select=&quot;substring($SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Distretto, 2, 3)&quot;/>&#xa;                                &lt;/distretto>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:CLLI&quot;/>&#xa;                        &lt;/CLLI>&#xa;                        &lt;CRMOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/CRMOrigine&quot;/>&#xa;                        &lt;/CRMOrigine>&#xa;                        &lt;xsl:if test=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;>&#xa;                            &lt;codiceSLAAssurance>&#xa;                                &lt;xsl:value-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/codiceSLAAssurance&quot;/>&#xa;                            &lt;/codiceSLAAssurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of se