$FaultDetails2/ActivityName='SendVariazioneXDSL'&quot;>&#xa;                &lt;ns:InputCRMWS>&#xa;                    &lt;ns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns2:REQUEST/tns2:Transaction_id&quot;/>&#xa;                    &lt;/ns:TransactionID>&#xa;                    &lt;ns:TransactionDate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TransactionDate>&#xa;                    &lt;ns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;'02'&quot;/>&#xa;                    &lt;/ns:Return_Code>&#xa;                    &lt;ns:DescrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;'Errore Generico'&quot;/>&#xa;                    &lt;/ns:DescrizioneErrore>&#xa;                    &lt;xsl:if test=&quot;$ManageError_3.part1/ns2:IdEsecProcsoNoFile&quot;>&#xa;                        &lt;ns:Id_Esec_Proc_NoFile>&#xa;                            &lt;xsl:value-of select=&quot;$ManageError_3.part1/ns2:IdEsecProcsoNoFile&quot;/>&#xa;                        &lt;/ns:Id_Esec_Proc_NoFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns2:SERVIZIO/tns2:CodiceOlo&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                    &lt;ns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns2:SERVIZIO/tns2:VARIAZIONE/tns2:Risorsa&quot;/>&#xa;                    &lt;/ns:ID_RISORSA>&#xa;                    &lt;ns:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($ManageError_3.part1/ns2:IdEsecProcsoNoFile)&quot;/>&#xa;                    &lt;/ns:ID_RICH>&#xa;                    &lt;ns:ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$AggConsistenzaNOWFallita&quot;/>&#xa;                    &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;ns:TIMSTP_RICH>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_RICH>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_2/tns2:REQUEST/tns2:Transaction_id&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/ns:OPERATORE>&#xa;                &lt;/ns:InputCRMWS>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:InputCRMWS>&#xa;                    &lt;ns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_3/tns4:REQUEST/tns4:Transaction_id&quot;/>&#xa;                    &lt;/ns:TransactionID>&#xa;                    &lt;ns:TransactionDate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TransactionDate>&#xa;                    &lt;ns:Return_Code>&#xa;                        &lt;xsl:value-of select=&quot;'02'&quot;/>&#xa;                    &lt;/ns:Return_Code>&#xa;                    &lt;ns:DescrizioneErrore>&#xa;                        &lt;xsl:value-of select=&quot;'Errore Generico'&quot;/>&#xa;                    &lt;/ns:DescrizioneErrore>&#xa;                    &lt;xsl:if test=&quot;$ManageError_3.part1/ns2:IdEsecProcsoNoFile&quot;>&#xa;                        &lt;ns:Id_Esec_Proc_NoFile>&#xa;                            &lt;xsl:value-of select=&quot;$ManageError_3.part1/ns2:IdEsecProcsoNoFile&quot;/>&#xa;                        &lt;/ns:Id_Esec_Proc_NoFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Input_3/tns4:SERVIZIO/tns4:CodiceOlo&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                    &lt;ns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$Input_3/tns4:SERVIZIO/tns4:CESSAZIONE/tns4:Risorsa&quot;/>&#xa;                    &lt;/ns:ID_RISORSA>&#xa;                    &lt;ns:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($ManageError_3.part1/ns2:IdEsecProcsoNoFile)&quot;/>&#xa;                    &lt;/ns:ID_RICH>&#xa;                    &lt;ns:ID_STATO_ELAB_STAG>&#xa;                        &lt;xsl:value-of select=&quot;$AggConsistenzaNOWFallita&quot;/>&#xa;                    &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;ns:TIMSTP_RICH>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_RICH>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Input_3/tns4:REQUEST/tns4:Transaction_id&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/ns:OPERATORE>&#xa;                &lt;/ns:InputCRMWS>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
