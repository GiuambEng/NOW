                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xmlns.example.com/1472556061373&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.invokeCRMWSEsito&quot; xmlns:tns2=&quot;hhttp://www.tim.com/NOW/xsd/CRMWStoNOW_GetRiscontroConsistenza_output/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.example.org/tim.now.xsd.SendCessazioneDati_JMS&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendCessazioneDati.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start_SubProcCess.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Request&quot;/>&#xa;    &lt;xsl:param name=&quot;AggConsistenzaNOWFallita&quot;/>&#xa;    &lt;xsl:param name=&quot;AggConsistenzaNOWAvvenutoConSuccesso&quot;/>&#xa;    &lt;xsl:param name=&quot;RequestCessazione&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_3-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:InputCRMWS>&#xa;            &lt;ns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessazione/tns2:Transaction_ID&quot;/>&#xa;            &lt;/ns:TransactionID>&#xa;            &lt;ns:TransactionDate>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessazione/tns2:Transaction_Date&quot;/>&#xa;            &lt;/ns:TransactionDate>&#xa;            &lt;ns:Return_Code>&#xa;                &lt;xsl:value-of select=&quot;$RequestCessazione/tns2:Return_Code&quot;/>&#xa;            &lt;/ns:Return_Code>&#xa;            &lt;xsl:if test=&quot;$RequestCessazione/tns2:Descrizione_Errore&quot;>&#xa;                &lt;ns:DescrizioneErrore>&#xa;                    &lt;xsl:value-of select=&quot;$RequestCessazione/tns2:Descrizione_Errore&quot;/>&#xa;                &lt;/ns:DescrizioneErrore>&#xa;            &lt;/xsl:if>&#xa;           