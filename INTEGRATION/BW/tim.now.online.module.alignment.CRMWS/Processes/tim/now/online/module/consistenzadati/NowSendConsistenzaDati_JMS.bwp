                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneXDSL.xsd&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendVariazioneXDSL_JMS&quot; xmlns:tns2=&quot;www.tim.now.maxNumber&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;finde_Case.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;SendVariazioneXDSL.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;IdDettaglioXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;sub_AllineamentoXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:DettaglioAsset>&#xa;                &lt;xsl:copy-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/dettaglioasset/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/dettaglioasset/@*&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$finde_Case.part1/tns:Find/tns:Asset/dettaglioasset/node()&quot;/>&#xa;            &lt;/ns:DettaglioAsset>&#xa;            &lt;ns:AssetCRM>&#xa;                &lt;ns:Servizio>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Servizio&quot;/>&#xa;                &lt;/ns:Servizio>&#xa;                &lt;ns:TipoLinea>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:TipoLinea&quot;/>&#xa;                &lt;/ns:TipoLinea>&#xa;                &lt;ns:Modulazione>&#xa;                    &lt;xsl:value-of select=&quot;$SendVariazioneXDSL.part1/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:BTS_ATM_GBE_EASYIP/tns1:Modulazione&quot;/>&#xa;                &lt;/ns:Modulazione>&#xa;                &lt;ns:Profil