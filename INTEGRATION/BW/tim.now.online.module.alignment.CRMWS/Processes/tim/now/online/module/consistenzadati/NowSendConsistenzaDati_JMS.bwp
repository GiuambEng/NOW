                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.allineamentoConsistenze.DettaglioAssetSendVariazioneNGA.xsd&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendVariazioneNGA_JMS&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns=&quot;www.tim.now.maxNumber&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendVariazioneNGA&quot;/>&lt;xsl:param name=&quot;IdDettaglio&quot;/>&lt;xsl:param name=&quot;findCase&quot;/>&lt;xsl:template name=&quot;Sub_AllineamentoNGA-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;xsl:for-each select=&quot;$findCase/part1/tns2:Output/tns2:Find/tns2:Asset/dettaglioasset&quot;>&lt;ns:DettaglioAsset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&lt;IDDettaglioAssetParent>&lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&lt;/IDDettaglioAssetParent>&lt;/xsl:if>&lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&lt;IDDettaglioAssetRoot>&lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&lt;/IDDettaglioAssetRoot>&lt;/xsl:if>&lt;integrationID>&lt;xsl:value-of select=&quot;integrationID&quot;/>&lt;/integrationID>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;nomeComponente>&lt;xsl:value-of select=&quot;nomeComponente&quot;/>&lt;/nomeComponente>&lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&lt;attributidettaglioasset>&lt;IDAsset>&lt;xsl:value-of select=&quot;IDAsset&quot;/>&lt;/IDAsset>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;xsl:if test=&quot;lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&lt;/tipologiaDato>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;/attributidettaglioasset>&lt;/xsl:for-each>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&lt;/IDRisorsaNOW>&lt;IDDettaglioAsset>&lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&lt;/IDDettaglioAsset>&lt;statoDettaglioAsset>&lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&lt;/statoDettaglioAsset>&lt;progressivo>&lt;xsl:value-of select=&quot;progressivo&quot;/>&lt;/progressivo>&lt;/ns:DettaglioAsset>&lt;/xsl:for-each>&lt;ns:AssetCRM>&lt;ns:TipologiaVariazione>&lt;xsl:value-of select=&quot;$SendVariazioneNGA/part1/tns1:Now_SendVariazioneNGA_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Tipologia_variazione&quot;/>&lt;/ns:TipologiaVariazione>&lt;ns:Servizio>&lt;xsl:value-of select=&quot;$SendVariazioneNGA/part1/tns1:Now_SendVariazioneNGA_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:Servizio&quot;/>&lt;/ns:Servizio>&lt;ns:TipoLinea>&lt;xsl:value-of select=&quot;$SendVariazioneNGA/part1/tns1:Now_SendVariazioneNGA_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:TipoLinea&quot;/>&lt;/ns:TipoLinea>&lt;ns:Tecnologia>&lt;xsl:value-of select=&quot;$SendVariazioneNGA/part1/tns1:Now_SendVariazioneNGA_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1:Tecnologia&quot;/>&lt;/ns:Tecnologia>&lt;ns:Encapsulation>&lt;xsl:value-of select=&quot;$SendVariazioneNGA/part1/tns1:Now_SendVariazioneNGA_Request/tns1:SERVIZIO/tns1:VARIAZIONE/tns1:VULA_NGA/tns1: