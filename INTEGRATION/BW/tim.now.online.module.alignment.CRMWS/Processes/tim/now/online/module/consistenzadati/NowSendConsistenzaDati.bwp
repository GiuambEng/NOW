OSTNAME_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetContext/ns:remoteaddress"&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="$GetContext/ns:remoteaddress"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$GetLocalIP1/tns2:IPAddress"&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="$GetLocalIP1/tns2:IPAddress"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;/xsl:if&gt;&lt;tns1:OS_USER&gt;&lt;xsl:value-of select="bw:getSystemProperty(&amp;quot;os.name&amp;quot;)"/&gt;&lt;/tns1:OS_USER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="bw:getHostName()"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="'ID153'"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="concat('CheckLavorabilita_',$SendVariazioneNGA/parameters/tns3:Now_SendVariazioneNGA_Request/tns3:REQUEST/tns3:Transaction_id)"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="'LOGIN'"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:value-of select="'CRMWS'"/&gt;&lt;/tns1:SISTEMA_CHIAMANTE&gt;&lt;xsl:if test="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;tns1:ID_ESE_PROC_NO_FILE&gt;&lt;xsl:value-of select="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/tns1:ID_ESE_PROC_NO_FILE&gt;&lt;/xsl:if&gt;&lt;tns1:NOME_TAB_STAGING&gt;&lt;xsl:value-of select="'STAG_ALMTO_COSTZ_NOFIN'"/&gt;&lt;/tns1:NOME_TAB_STAGING&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
