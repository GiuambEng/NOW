                        <bpws:invoke inputVariable="ManageError-input"
                            name="ManageError" operation="Invoke"
                            outputVariable="ManageError"
                            partnerLink="GestioneErrore"
                            portType="ns18:GenericError" tibex:xpdlId="acd72fa2-9711-402f-8690-facbc43dd9cd">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" version="2.0"&gt;&lt;xsl:param name="FaultDetails3"/&gt;&lt;xsl:param name="ProcessXDSL"/&gt;&lt;xsl:param name="ProcessNGA"/&gt;&lt;xsl:param name="ProcessCessazione"/&gt;&lt;xsl:param name="ID_PROCSO_NGA"/&gt;&lt;xsl:param name="ID_PROCSO_XDSL"/&gt;&lt;xsl:param name="ID_PROCSO_CESSAZIONE"/&gt;&lt;xsl:param name="Operation1"/&gt;&lt;xsl:param name="Operation2"/&gt;&lt;xsl:template name="ManageError-input" match="/"&gt;&lt;tns:Input&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="&amp;quot;In_All_Asset&amp;quot;"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Error&gt;&lt;ns:ActivityName&gt;&lt;xsl:value-of select="$FaultDetails3/ActivityName"/&gt;&lt;/ns:ActivityName&gt;&lt;ns:Msg&gt;&lt;xsl:value-of select="$FaultDetails3/Msg"/&gt;&lt;/ns:Msg&gt;&lt;ns:MsgCode&gt;&lt;xsl:value-of select="$FaultDetails3/MsgCode"/&gt;&lt;/ns:MsgCode&gt;&lt;ns:ProcessStack&gt;&lt;xsl:value-of select="$FaultDetails3/ProcessStack"/&gt;&lt;/ns:ProcessStack&gt;&lt;ns:StackTrace&gt;&lt;xsl:value-of select="$FaultDetails3/StackTrace"/&gt;&lt;/ns:StackTrace&gt;&lt;/ns:Error&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) &gt; 0"&gt;&lt;xsl:if test="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length($ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;&lt;xsl:if test="$ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;&lt;ns:ID_Esec_Proc&gt;&lt;xsl:value-of select="$ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;&lt;/ns:ID_Esec_Proc&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(string($ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID))&gt;0"&gt;&lt;xsl:if test="$ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$ProcessXDSL/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length(string($ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID))&gt;0"&gt;&lt;xsl:if test="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$ProcessNGA/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="string-length(string($ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID)) &gt; 0"&gt;&lt;xsl:if test="$ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"&gt;&lt;ns:CorrelationID&gt;&lt;xsl:value-of select="$ProcessCessazione/part1/ns1:Output/ns1:Esito/ns1:CORRELATION_ID"/&gt;&lt;/ns:CorrelationID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Operation1='SendVariazioneNGA' or $FaultDetails3/ActivityName='SendVariazioneNGA'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_NGA"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Operation2='SendVariazioneXDSL' or $FaultDetails3/ActivityName='SendVariazioneXDSL'"&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_XDSL"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_NOFILE&gt;&lt;xsl:value-of select="$ID_PROCSO_CESSAZIONE"/&gt;&lt;/ns:ID_PROCSO_NOFILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:Input&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ProcessXDSL.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessNGA.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessCessazione.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails3&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_NGA&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_XDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_PROCSO_CESSAZIONE&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation1&quot;/>&#xa;    &lt;xsl:param name=&quot;Operation2&quot;/>&#xa;    &lt;xsl:template name=&quot;ManageError-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;In_All_Asset&amp;quot;&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails3/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessXDSL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessXDSL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessXDSL.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessNGA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessNGA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessNGA.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ProcessCessazione.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessCessazione.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessCessazione.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($ProcessXDSL.part1/ns1:Esito/ns1:CORRELATION_ID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessXDSL.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessXDSL.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($ProcessNGA.part1/ns1:Esito/ns1:CORRELATION_ID))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessNGA.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessNGA.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($ProcessCessazione.part1/ns1:Esito/ns1:CORRELATION_ID)) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ProcessCessazione.part1/ns1:Esito/ns1:CORRELATION_ID&quot;>&#xa;                        &lt;ns:CorrelationID>&#xa;                            &lt;xsl:value-of select=&quot;$ProcessCessazione.part1/ns1:Esito/ns1:CORRELATION_ID&quot;/>&#xa;                        &lt;/ns:CorrelationID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Operation1='SendVariazioneNGA' or $FaultDetails3/ActivityName='SendVariazioneNGA'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_NGA&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Operation2='SendVariazioneXDSL' or $FaultDetails3/ActivityName='SendVariazioneXDSL'&quot;>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_XDSL&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:ID_PROCSO_NOFILE>&#xa;                        &lt;xsl:value-of select=&quot;$ID_PROCSO_CESSAZIONE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NOFILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="ErrorLogToManageError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source
                                    linkName="ManageErrorToEmpty1"
                                    tibex:faultDetailsVar="ManageError" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
