                                    expression="$Operation1='SendVariazioneXDSL' or $FaultDetails3/ActivityName='SendVariazioneXDSL'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation1='SendVariazioneXDSL' or $FaultDetails3/ActivityName='SendVariazioneXDSL']]></bpws:transitionCondition>
                                </bpws:source>
