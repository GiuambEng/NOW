                                    expression="$Operation1='SendVariazioneNGA' or $FaultDetails3/ActivityName='SendVariazioneNGA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Operation1='SendVariazioneNGA' or $FaultDetails3/ActivityName='SendVariazioneNGA']]></bpws:transitionCondition>
                                </bpws:source>
