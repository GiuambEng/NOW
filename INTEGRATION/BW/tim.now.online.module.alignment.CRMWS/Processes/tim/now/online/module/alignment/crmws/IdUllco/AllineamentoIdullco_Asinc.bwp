                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/1459518768970" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/Common/Schema.xsd3" xmlns:tns="www.tim.now.invokeCRMWSAllinementoIDULLCO" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="ErrorResponse"/&gt;
    &lt;xsl:template name="Invoke_Crm_error-input" match="/"&gt;
        &lt;tns2:RequestMessage&gt;
            &lt;REQUEST&gt;
                &lt;ns:TRANSACTION_ID&gt;
                    &lt;xsl:value-of select="$ErrorResponse/tns:TransactionID"/&gt;
                &lt;/ns:TRANSACTION_ID&gt;
                &lt;ns:TRANSACTION_DATE&gt;
                    &lt;xsl:value-of select="xsd:dateTime($ErrorResponse/tns:TransactionDate)"/&gt;
                &lt;/ns:TRANSACTION_DATE&gt;
                &lt;ns:RETURN_CODE&gt;
                    &lt;xsl:value-of select="$ErrorResponse/tns:ReturnCode"/&gt;
                &lt;/ns:RETURN_CODE&gt;
                &lt;xsl:if test="$ErrorResponse/tns:DescrizioneErrore"&gt;
                    &lt;ns:DESCRIZIONE_ERRORE&gt;
                        &lt;xsl:value-of select="$ErrorResponse/tns:DescrizioneErrore"/&gt;
                    &lt;/ns:DESCRIZIONE_ERRORE&gt;
                &lt;/xsl:if&gt;
            &lt;/REQUEST&gt;
        &lt;/tns2:RequestMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
