            name="Input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns2:InputMessage"
            name="Process_ID-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns2:OutputMessage" name="Process_ID" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:inputs"
            name="AllineamentoIdUllco-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:resultSet"
            name="AllineamentoIdUllco" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Jdbc/Timeout" type="xsd:int"/>
        <bpws:variable element="ns7:Request" name="Request-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Request" name="Request" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="Log_Request-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:INPUT" name="Ins_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable name="InvioEsitoAllineamentoIDULLCO"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/InvioEsitoAllineamentoIDULLCO" type="xsd:int"/>
        <bpws:variable messageType="ns9:RequestMessage"
            name="callCRMWS-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns9:ResponseMessage"
            name="callCRMWS" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:INPUT" name="Up_Staging-input" sca-bpel:internal="true"/>
        <bpws:variable
            name="AvvenutaComunicazioneEsitoOKAllineamentoIDULLCO"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/AvvenutaComunicazioneEsitoOKAllineamentoIDULLCO" type="xsd:int"/>
        <bpws:variable
            name="AvvenutaComunicazioneEsitoKOAllineamentoIDULLCO"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/AvvenutaComunicazioneEsitoKOAllineamentoIDULLCO" type="xsd:int"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="Log_Response-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:FaultDetail" name="FaultDetails" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="Error_Log-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns13:ErrorLinkHandlerFaultData"
            name="_error_JMSSendMessage" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns12:Input" name="Error-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns12:Output" name="Error" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Request" name="ErrorResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Request" name="ErrorResponse" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogRequest-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE" name="Fault-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:INPUT" name="InsStaging-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns9:RequestMessage"
            name="Invoke_Crm_error-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:INPUT" name="UpStaging-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns9:ResponseMessage"
            name="Invoke_Crm_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE" name="Fault_2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:INPUT" name="UpStagingError-input" sca-bpel:internal="true"/>
        <bpws:variable
            name="MancataComunicazioneEsitoAllineamentoIDULLCO"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/StatoStaging/MancataComunicazioneEsitoAllineamentoIDULLCO" type="xsd:int"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE" name="Fault3-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="9217434e-d182-40da-901e-687a705e7bdb">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="Error_LogToError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorResponseToLogRequest" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorToEmpty1" tibex:linkType="ERROR"/>
                            <bpws:link name="Empty1ToCallProcess" tibex:linkType="SUCCESS"/>
                            <bpws:link name="CallProcessToErrorResponse" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ErrorToErrorResponse" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LogRequestToLocalTransaction" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LocalTransactionToLogResponse" tibex:linkType="SUCCESS"/>
                            <bpws:link name="LogResponseToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LocalTransactionToCallProcess" tibex:linkType="ERROR"/>
                            <bpws:link name="Fault_2ToUpStagingError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="UpStagingErrorToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="UpStagingErrorToCallProcess" tibex:linkType="ERROR"/>
                            <bpws:link name="CallProcessToExit1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Confirm1ToError" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ErroreRiscontroAsincronoAllIdullco'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;xsl:if test=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID&quot;>&#xa;                    &lt;tns2:MsgCode>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID&quot;/>&#xa;                    &lt;/tns2:MsgCode>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="Error_Log-input"
                                name="Error_Log"
                                tibex:xpdlId="2015cc13-2450-4628-98dc-44701648ee65"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="Error_LogToError"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorLoggerLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;Error_Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'ErroreRiscontroAsincronoAllIdullco'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.part1/tns1:PID&quot;>&#xa;                    &lt;tns2:MsgCode>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.part1/tns1:PID&quot;/>&#xa;                    &lt;/tns2:MsgCode>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorLoggerLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:invoke inputVariable="Error-input"
                            name="Error" operation="Invoke"
                            outputVariable="Error"
                            partnerLink="GestioneErrore"
                            portType="ns12:GenericError" tibex:xpdlId="f616330c-73da-442b-abfa-365fec84cc36">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/1469551322714" xmlns:ns="www.tim.now.genereciErrorGestioneSegnalazione" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:param name="Process_ID"/&gt;
    &lt;xsl:param name="ID_Procso_NoFile"/&gt;
    &lt;xsl:param name="InvokeIn"/&gt;
    &lt;xsl:template name="Error-input" match="/"&gt;
        &lt;tns2:Input&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:ActivityName&gt;
                        &lt;xsl:value-of select="'AllineamentoIdUllco_Async'"/&gt;
                    &lt;/ns:ActivityName&gt;
                    &lt;ns:Error&gt;
                        &lt;ns:ActivityName&gt;
                            &lt;xsl:value-of select="$FaultDetails/ActivityName"/&gt;
                        &lt;/ns:ActivityName&gt;
                        &lt;ns:Msg&gt;
                            &lt;xsl:value-of select="$FaultDetails/Msg"/&gt;
                        &lt;/ns:Msg&gt;
                        &lt;ns:MsgCode&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/ns:MsgCode&gt;
                        &lt;ns:ProcessStack&gt;
                            &lt;xsl:value-of select="$FaultDetails/ProcessStack"/&gt;
                        &lt;/ns:ProcessStack&gt;
                        &lt;ns:StackTrace&gt;
                            &lt;xsl:value-of select="$FaultDetails/StackTrace"/&gt;
                        &lt;/ns:StackTrace&gt;
                    &lt;/ns:Error&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($Process_ID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)&gt;0"&gt;
                            &lt;xsl:if test="$Process_ID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"&gt;
                                &lt;ns:ID_Esec_Proc&gt;
                                    &lt;xsl:value-of select="$Process_ID/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE"/&gt;
                                &lt;/ns:ID_Esec_Proc&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:CorrelationID"&gt;
                        &lt;ns:CorrelationID&gt;
                            &lt;xsl:value-of select="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:CorrelationID"/&gt;
                        &lt;/ns:CorrelationID&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Transaction_id"&gt;
                        &lt;ns:CRMTransactionID_Idullco&gt;
                            &lt;xsl:value-of select="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Transaction_id"/&gt;
                        &lt;/ns:CRMTransactionID_Idullco&gt;
                    &lt;/xsl:if&gt;
                    &lt;ns:ID_PROCSO_NOFILE&gt;
                        &lt;xsl:value-of select="$ID_Procso_NoFile"/&gt;
                    &lt;/ns:ID_PROCSO_NOFILE&gt;
                    &lt;xsl:if test="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID"&gt;
                        &lt;ns:PID&gt;
                            &lt;xsl:value-of select="$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID"/&gt;
                        &lt;/ns:PID&gt;
                    &lt;/xsl:if&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns2:Input&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/1469551322714&quot; xmlns:ns=&quot;www.tim.now.genereciErrorGestioneSegnalazione&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Process_ID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_Procso_NoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:ActivityName>&#xa;                &lt;xsl:value-of select=&quot;'AllineamentoIdUllco_Async'&quot;/>&#xa;            &lt;/ns:ActivityName>&#xa;            &lt;ns:Error>&#xa;                &lt;ns:ActivityName>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ActivityName&quot;/>&#xa;                &lt;/ns:ActivityName>&#xa;                &lt;ns:Msg>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                &lt;/ns:Msg>&#xa;                &lt;ns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/ns:MsgCode>&#xa;                &lt;ns:ProcessStack>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                &lt;/ns:ProcessStack>&#xa;                &lt;ns:StackTrace>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                &lt;/ns:StackTrace>&#xa;            &lt;/ns:Error>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Process_ID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Process_ID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;>&#xa;                        &lt;ns:ID_Esec_Proc>&#xa;                            &lt;xsl:value-of select=&quot;$Process_ID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE&quot;/>&#xa;                        &lt;/ns:ID_Esec_Proc>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/tns1:CorrelationID&quot;>&#xa;                &lt;ns:CorrelationID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/tns1:CorrelationID&quot;/>&#xa;                &lt;/ns:CorrelationID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/tns1:Transaction_id&quot;>&#xa;                &lt;ns:CRMTransactionID_Idullco>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/tns1:Transaction_id&quot;/>&#xa;                &lt;/ns:CRMTransactionID_Idullco>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_PROCSO_NOFILE>&#xa;                &lt;xsl:value-of select=&quot;$ID_Procso_NoFile&quot;/>&#xa;            &lt;/ns:ID_PROCSO_NOFILE>&#xa;            &lt;xsl:if test=&quot;$InvokeIn.part1/tns1:PID&quot;>&#xa;                &lt;ns:PID>&#xa;                    &lt;xsl:value-of select=&quot;$InvokeIn.part1/tns1:PID&quot;/>&#xa;                &lt;/ns:PID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="Confirm1ToError"/>
                            </bpws:targets>
                            <bpws:sources>
                                <bpws:source linkName="ErrorToEmpty1"
                                    tibex:faultDetailsVar="Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="ErrorToErrorResponse">
                                    <tibex:DesignExpression/>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:invoke>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;www.tim.now.invokeCRMWSAllinementoIDULLCO&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Transaction_id)>0&quot;>&#xa;                    &lt;tns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Transaction_id&quot;/>&#xa;                    &lt;/tns:TransactionID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:TransactionID>&#xa;                        &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                    &lt;/tns:TransactionID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:TransactionDate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:TransactionDate>&#xa;            &lt;tns:ReturnCode>&#xa;                &lt;xsl:value-of select=&quot;'06'&quot;/>&#xa;            &lt;/tns:ReturnCode>&#xa;            &lt;tns:DescrizioneErrore>&#xa;                &lt;xsl:value-of select=&quot;'KO Generico'&quot;/>&#xa;            &lt;/tns:DescrizioneErrore>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
