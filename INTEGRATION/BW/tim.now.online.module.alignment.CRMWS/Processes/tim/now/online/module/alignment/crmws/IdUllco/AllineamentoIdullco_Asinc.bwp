 &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:DATA_INVIO>&#xa;                &lt;ns:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/ns:OPERATORE>&#xa;                &lt;xsl:if test=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Azione&quot;>&#xa;                    &lt;ns:TIPOLOGIA_OPERAZIONE>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:Azione&quot;/>&#xa;                    &lt;/ns:TIPOLOGIA_OPERAZIONE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID&quot;>&#xa;                    &lt;ns:PID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn/part1/tns1:Now_SendIdullco_Request/tns1:PID&quot;/>&#xa;                    &lt;/ns:PID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Insert>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
