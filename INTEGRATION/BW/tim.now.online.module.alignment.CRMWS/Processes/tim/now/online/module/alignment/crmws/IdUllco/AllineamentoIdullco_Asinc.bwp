    &lt;xsl:param name="Request"/&gt;
    &lt;xsl:template name="callCRMWS-input" match="/"&gt;
        &lt;tns2:RequestMessage&gt;
            &lt;REQUEST&gt;
                &lt;ns:TRANSACTION_ID&gt;
                    &lt;xsl:value-of select="$Request/tns:TransactionID"/&gt;
                &lt;/ns:TRANSACTION_ID&gt;
