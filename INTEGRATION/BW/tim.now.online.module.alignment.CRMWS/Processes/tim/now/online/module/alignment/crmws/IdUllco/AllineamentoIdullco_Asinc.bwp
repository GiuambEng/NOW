                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;www.tim.now.stagingSendAsincIdullco&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO_JMS/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeIn.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_Crm_error.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Process_ID.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;AvvenutaComunicazioneEsitoKOAllineamentoIDULLCO&quot;/>&#xa;    &lt;xsl:template name=&quot;UpStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:INPUT>&#xa;            &lt;ns:Update>&#xa;                &lt;ns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Invoke_Crm_error.RESPONSE)&quot;/>&#xa;                &lt;/ns:CONTENUTO_RESPONSE>&#xa;                &lt;ns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_RISPOSTA>&#xa;                &lt;ns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$AvvenutaComunicazioneEsitoKOAllineamentoIDULLCO&quot;/>&#xa;                &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer(substring-before($Process_ID.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_NOFILE,'.'))&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$InvokeIn.part1/tns1:PID&quot;>&#xa;                    &lt;ns:PID>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeIn.part1/tns1:PID&quot;/>&#xa;                    &lt;/ns:PID>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:Update>&#xa;        &lt;/ns:INPUT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
