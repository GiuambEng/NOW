<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:AnagraficaGestori="http://www.tim.com/NOW/xsd/Anagrafica_Gestori_CheckSingoloRecord" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/Anagrafica_Gestori_CheckSingoloRecord">
	<element name="AnagraficaGestori_Noval">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0" ref="AnagraficaGestori:AnagraficaGestoriDettaglio"/>
			</sequence>
		</complexType>
	</element>
	<element name="AnagraficaGestoriDettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1"
					name="CODE_GESTORE" type="string">
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="DESC_GESTORE">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="DATA_INIZ_VALI" type="string">
				</element>
				<element maxOccurs="1" minOccurs="1"
					name="DATA_FINE_VALI" type="string">
				</element>
				<element maxOccurs="1" minOccurs="0" name="Timestamp" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
				<element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
			</sequence>
		</complexType>
	</element>
</schema>