<?xml version="1.0" encoding="UTF-8"?>

<schema xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://www.tim.com/NOW/xsd/Anagrafica_Gestori"
  targetNamespace="http://www.tim.com/NOW/xsd/Anagrafica_Gestori"
  elementFormDefault="qualified" attributeFormDefault="unqualified">

    

    <element name="AnagraficaGestori">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:AnagraficaGestoriDettaglio">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="AnagraficaGestoriDettaglio">
    	<complexType>
    	<sequence>
    	<element name="CODE_GESTORE" maxOccurs="1"
    				minOccurs="0" type="string">
    			</element>
    			<element name="DESC_GESTORE" maxOccurs="1"
    				minOccurs="0" type="string">
    			</element>
    			<element name="DATA_INIZ_VALI" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="DATA_FINE_VALI" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
    			</sequence>
    	
    	</complexType>
    </element>

</schema>