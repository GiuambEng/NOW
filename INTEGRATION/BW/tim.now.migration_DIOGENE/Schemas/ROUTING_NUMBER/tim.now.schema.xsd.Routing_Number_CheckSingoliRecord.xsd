<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RoutingNumber_CheckSingoliRecord" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RoutingNumber_CheckSingoliRecord">

    <element name="RotungNumber_Noval">
    	<complexType>
    		<sequence>
    			<element ref="tns:RoutingNumberDettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RoutingNumberDettaglio">
    	<complexType>
    		<sequence>
    			<element name="TipoRecord" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="2"></maxLength>
    						<minLength value="1"></minLength>
    						<enumeration value="00"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Distretto" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="4"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Arco" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="6"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Distretto_reale" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="4"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Codice_OLO_Diogene" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Codice_OLO_MTPN" maxOccurs="1"
    				minOccurs="0">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="NumeroRecord" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			
    		</sequence>
    	</complexType>
    </element>
</schema>