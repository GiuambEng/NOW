<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RoutingNumber_Staging" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/RoutingNumber_Staging">

    <element name="RoutingNumber_input">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="ARCO"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="COD_OLO_DIOGENE" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="CODFC_OLO_AGCOM" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="CONTENUTO_RECD" type="string" />
    			<element name="DESCR_ERRORE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element maxOccurs="1" minOccurs="0" name="DISTR"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="DISTR_REALE"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="ID_FILE_PROCSTO_INPUT" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="ID_STATO_ELAB_STAG" type="string" />
    			<element maxOccurs="1" minOccurs="0" name="NUMERO_RECD"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="TIPO_RECD"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="TMSP_INSMTO"
    				type="string" />
    		</sequence>
    	</complexType>
    </element>

    <element name="RoutingNumber_Root">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:RoutingNumber_input"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
