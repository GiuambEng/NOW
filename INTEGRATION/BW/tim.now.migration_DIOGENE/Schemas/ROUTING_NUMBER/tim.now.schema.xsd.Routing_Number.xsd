<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RoutingNumber" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RoutingNumber">

    <element name="RoutingNumber">
    	<complexType>
    		<sequence>
    			<element ref="tns:RoutingNumber_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RoutingNumber_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Distretto" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Arco" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Distretto_reale" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Codice_OLO_Diogene" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Codice_OLO_MTPN" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>