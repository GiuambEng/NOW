<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RoutingNumber_subProcess" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/RoutingNumber_subProcess">

    <element name="RoutingNumber_Dettaglio">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Tipo_record" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Distretto" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Arco" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Distretto_reale" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="Codice_OLO_Diogene" type="string"/>
                <element maxOccurs="1" minOccurs="0" name="Codice_OLO_MTPN" type="string"/>
                <element maxOccurs="1" minOccurs="0" name="FlagValidita" type="string"/>
                <element maxOccurs="1" minOccurs="0" name="Numero_record" type="string"/>
                <element maxOccurs="1" minOccurs="0" name="ID_FILE" type="string"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="RoutingNumber_Dettaglio_Output">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="0" name="Esito" type="string"/>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="RoutingNumber_subProcess">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" ref="tns:RoutingNumber_Dettaglio"/>
    		</sequence>
    	</complexType>
    </element>
</schema>
