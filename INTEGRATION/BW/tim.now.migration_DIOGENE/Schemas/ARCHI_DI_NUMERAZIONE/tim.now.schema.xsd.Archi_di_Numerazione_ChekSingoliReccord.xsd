<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Archi_di_Numerazione_ChekSingoliReccord" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Archi_di_Numerazione_ChekSingoliReccord">

    <element name="ArchidiNumerazione_Noval">
    	<complexType>
    		<sequence>
    			<element ref="tns:ArchidiNumerazione_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="ArchidiNumerazione_Dettaglio">
    	<complexType>
    	<sequence>
    			<element name="CODI_DIST" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODI_SETT" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ARCO_NUME_DA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="ARCO_NUME_A" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CIFR_SIGN" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="5"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODE_GESTORE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="3"></maxLength>
    						<minLength value="1"></minLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DATA_INIZ_VALI" maxOccurs="1"
    				minOccurs="1" type="date">
    			</element>
    			<element name="DATA_FINE_VALI" maxOccurs="1"
    				minOccurs="1" type="date">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="NumeroRecord" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>