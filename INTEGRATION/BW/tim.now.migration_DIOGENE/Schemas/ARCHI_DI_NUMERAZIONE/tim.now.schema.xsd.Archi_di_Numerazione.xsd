<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Archi_di_Numerazione" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Archi_di_Numerazione">

    <element name="Archi_Di_Numerazione">
    	<complexType>
    		<sequence>
    			<element ref="tns:Archi_Di_Numerazione_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Archi_Di_Numerazione_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="CODI_DIST" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CODI_SETT" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ARCO_NUME_DA" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ARCO_NUME_A" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CIFR_SIGN" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CODE_GESTORE" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="DATA_INIZ_VALI" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="DATA_FINE_VALI" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="FlagValidita" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <attribute name="NewAttribute" type="string"></attribute>

</schema>