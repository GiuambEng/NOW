                                <bpws:sources>
                                    <bpws:source linkName="Empty2ToInput_Staging">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty2ToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index = (($JMSReceiveMessage/Body/ns15:queueResponse/ns15:NumeroRecord)) div $Passo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaGestoriDettaglio)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index = (($JMSReceiveMessage/Body/ns15:queueResponse/ns15:NumeroRecord)) div $Passo +1)) and (count($Noval_Detail_Last/Rows/tns1:AnagraficaGestoriDettaglio)=0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
