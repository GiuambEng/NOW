sl:if test=&quot;tns3:CODI_DIST&quot;>&lt;tns2:COD_DISTR>&lt;xsl:value-of select=&quot;tns3:CODI_DIST&quot;/>&lt;/tns2:COD_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CODE_GESTORE&quot;>&lt;tns2:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns3:CODE_GESTORE&quot;/>&lt;/tns2:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;tns2:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/tns2:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DATA_FINE_VALI&quot;>&lt;tns2:DATAFI_VALID>&lt;xsl:value-of select=&quot;tns3:DATA_FINE_VALI&quot;/>&lt;/tns2:DATAFI_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DATA_INIZ_VALI&quot;>&lt;tns2:DATAINZ_VALID>&lt;xsl:value-of select=&quot;tns3:DATA_INIZ_VALI&quot;/>&lt;/tns2:DATAINZ_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&lt;tns2:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&lt;/tns2:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;tns2:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns2:NUMERO_RECD>&lt;tns2:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TMSP_INSMTO>&lt;/tns2:ArchidiNumerazione_Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns3:Archi_Di_Numerazione_Dettaglio&quot;>&lt;tns2:ArchidiNumerazione_Input>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ( $index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns3:ARCO_NUME_A&quot;>&lt;tns2:ARCO_NUMRZNE_A>&lt;xsl:value-of select=&quot;tns3:ARCO_NUME_A&quot;/>&lt;/tns2:ARCO_NUMRZNE_A>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CIFR_SIGN&quot;>&lt;tns2:ARCO_NUMRZNE_CONFIGURATA>&lt;xsl:value-of select=&quot;tns3:CIFR_SIGN&quot;/>&lt;/tns2:ARCO_NUMRZNE_CONFIGURATA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:ARCO_NUME_DA&quot;>&lt;tns2:ARCO_NUMRZNE_DA>&lt;xsl:value-of select=&quot;tns3:ARCO_NUME_DA&quot;/>&lt;/tns2:ARCO_NUMRZNE_DA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CODI_SETT&quot;>&lt;tns2:AREA_LOCALE_NEL_DISTR>&lt;xsl:value-of select=&quot;tns3:CODI_SETT&quot;/>&lt;/tns2:AREA_LOCALE_NEL_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CODI_DIST&quot;>&lt;tns2:COD_DISTR>&lt;xsl:value-of select=&quot;tns3:CODI_DIST&quot;/>&lt;/tns2:COD_DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:CODE_GESTORE&quot;>&lt;tns2:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns3:CODE_GESTORE&quot;/>&lt;/tns2:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&lt;tns2:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$ContenutoRecord/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&lt;/tns2:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DATA_FINE_VALI&quot;>&lt;tns2:DATAFI_VALID>&lt;xsl:value-of select=&quot;tns3:DATA_FINE_VALI&quot;/>&lt;/tns2:DATAFI_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;tns3:DATA_INIZ_VALI&quot;>&lt;tns2:DATAINZ_VALID>&lt;xsl:value-of select=&quot;tns3:DATA_INIZ_VALI&quot;/>&lt;/tns2:DATAINZ_VALID>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&lt;tns2:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&lt;/tns2:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns2:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/tns2:ID_STATO_ELAB_STAG>&lt;tns2:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns2:NUMERO_RECD>&lt;tns2:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TMSP_INSMTO>&lt;/tns2:ArchidiNumerazione_Input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:ArchidiNumerazione_Root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
