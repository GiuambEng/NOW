                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;Var_InputStaging&quot;/>&lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.migration_DIOGENE.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'AllineamentoRoutingNumber'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Var_InputStaging,true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="JDBCUpdate-input"
                                    name="JDBCUpdate"
                                    outputVariable="JDBCUpdate"
                                    tibex:xpdlId="4c4af7a2-e20a-47fa-b3e6-b0809fbfe519" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess3ToJDBCUpdate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToSubprocess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4c4af7a2-e20a-47fa-b3e6-b0809fbfe519+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RoutingNumber_Staging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_InputStaging&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Var_InputStaging/tns1:RoutingNumber_input&quot;>&lt;Record>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:ARCO)>0&quot;>&lt;ARCO>&lt;xsl:value-of select=&quot;tib:trim(tns1:ARCO)&quot;/>&lt;/ARCO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ARCO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:COD_OLO_DIOGENE)>0&quot;>&lt;COD_OLO_DIOGENE>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_OLO_DIOGENE)&quot;/>&lt;/COD_OLO_DIOGENE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_OLO_DIOGENE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:CODFC_OLO_AGCOM)>0&quot;>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODFC_OLO_AGCOM)&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODFC_OLO_AGCOM xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;tns1:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns1:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:DISTR)>0&quot;>&lt;DISTR>&lt;xsl:value-of select=&quot;tib:trim(tns1:DISTR)&quot;/>&lt;/DISTR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DISTR xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:DISTR_REALE)>0&quot;>&lt;DISTR_REALE>&lt;xsl:value-of select=&quot;tib:trim(tns1:DISTR_REALE)&quot;/>&lt;/DISTR_REALE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DISTR_REALE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:ID_STATO_ELAB_STAG)&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(tns1:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:TIPO_RECD)>0&quot;>&lt;TIPO_RECD>&lt;xsl:value-of select=&quot;tib:trim(tns1:TIPO_RECD)&quot;/>&lt;/TIPO_RECD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPO_RECD xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TMSP_INSMTO>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO APPUSER.STAG_ROUTING_NUMBER (ARCO, COD_OLO_DIOGENE,&#xa;  CODFC_OLO_AGCOM, CONTENUTO_RECD, DESCR_ERRORE, DISTR, DISTR_REALE,&#xa;  ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, NUMERO_RECD, TIPO_RECD,&#xa;  TMSP_INSMTO)&#xa;  VALUES (?, ?, ?, RTRIM(?, CHR(10) || CHR(13)), ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ARCO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_DIOGENE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RECD"/>

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTR_REALE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>

                                    <PreparedParameters
                                    DataType="2"
