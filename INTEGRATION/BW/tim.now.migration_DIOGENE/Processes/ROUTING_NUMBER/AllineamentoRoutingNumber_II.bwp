                        <bpws:source linkName="Output_Log_counterToExit1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns32:queueResponse/ns32:NumeroRecord=0) or $JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='OK' and $JMSReceiveMessage/Body/ns32:queueResponse/ns32:NumeroRecord=0) or $JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='KO']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Output_Log_counterToThrow">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$JMSReceiveMessage/Body/ns32:queueResponse/ns32:EsitoConteggio='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
