                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RoutingNumber_Staging&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RoutingNumber&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;www.tim.now.migration.OutputContenutoRecd&quot; xmlns:ns2=&quot;www.tim.now.contarecord_jms.response&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&lt;xsl:param name=&quot;Noval_Details&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD_FILE&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Contenuto&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;Var_InputStaging&quot; match=&quot;/&quot;>&lt;tns:RoutingNumber_Root>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:RoutingNumber_Dettaglio)=0&quot;>&lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:RoutingNumber_Dettaglio&quot;>&lt;tns:RoutingNumber_input>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:Arco&quot;>&lt;tns:ARCO>&lt;xsl:value-of select=&quot;tns1:Arco&quot;/>&lt;/tns:ARCO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Codice_OLO_Diogene&quot;>&lt;tns:COD_OLO_DIOGENE>&lt;xsl:value-of select=&quot;tns1:Codice_OLO_Diogene&quot;/>&lt;/tns:COD_OLO_DIOGENE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Codice_OLO_MTPN&quot;>&lt;tns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns1:Codice_OLO_MTPN&quot;/>&lt;/tns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Contenuto/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$Contenuto/ns1:Output_ContenutoRecord[ns1:Posizione=$var]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto&quot;>&lt;tns:DISTR>&lt;xsl:value-of select=&quot;tns1:Distretto&quot;/>&lt;/tns:DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto_reale&quot;>&lt;tns:DISTR_REALE>&lt;xsl:value-of select=&quot;tns1:Distretto_reale&quot;/>&lt;/tns:DISTR_REALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/tns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:TIPO_RECD>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:TIPO_RECD>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;/tns:RoutingNumber_input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:RoutingNumber_Dettaglio&quot;>&lt;tns:RoutingNumber_input>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns1:Arco&quot;>&lt;tns:ARCO>&lt;xsl:value-of select=&quot;tns1:Arco&quot;/>&lt;/tns:ARCO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Codice_OLO_Diogene&quot;>&lt;tns:COD_OLO_DIOGENE>&lt;xsl:value-of select=&quot;tns1:Codice_OLO_Diogene&quot;/>&lt;/tns:COD_OLO_DIOGENE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Codice_OLO_MTPN&quot;>&lt;tns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;tns1:Codice_OLO_MTPN&quot;/>&lt;/tns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Contenuto/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;>&lt;tns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$Contenuto/ns1:Output_ContenutoRecord[ns1:Posizione=$var1]/ns1:Valore&quot;/>&lt;/tns:CONTENUTO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto&quot;>&lt;tns:DISTR>&lt;xsl:value-of select=&quot;tns1:Distretto&quot;/>&lt;/tns:DISTR>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:Distretto_reale&quot;>&lt;tns:DISTR_REALE>&lt;xsl:value-of select=&quot;tns1:Distretto_reale&quot;/>&lt;/tns:DISTR_REALE>&lt;/xsl:if>&lt;xsl:if test=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;>&lt;tns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body/ns2:queueResponse/ns2:ID_FILE&quot;/>&lt;/tns:ID_FILE_PROCSTO_INPUT>&lt;/xsl:if>&lt;tns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELAB_RECORD_FILE&quot;/>&lt;/tns:ID_STATO_ELAB_STAG>&lt;tns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/tns:NUMERO_RECD>&lt;xsl:if test=&quot;tns1:Tipo_record&quot;>&lt;tns:TIPO_RECD>&lt;xsl:value-of select=&quot;tns1:Tipo_record&quot;/>&lt;/tns:TIPO_RECD>&lt;/xsl:if>&lt;tns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TMSP_INSMTO>&lt;/tns:RoutingNumber_input>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RoutingNumber_Root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
