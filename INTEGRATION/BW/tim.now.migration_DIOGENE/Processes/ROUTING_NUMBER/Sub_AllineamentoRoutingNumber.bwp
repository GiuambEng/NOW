                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RoutingNumber_Staging&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d3c2e61d-bb06-4c31-b9e7-bd8ea16739e9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Accumulate/tns:RoutingNumber_input&quot;>&lt;Record>&lt;DESCR_ERRORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:DESCR_ERRORE)&quot;>&lt;xsl:value-of select=&quot;tns:DESCR_ERRORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_ERRORE>&lt;ID_STATO_ELAB_STAG>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:ID_STATO_ELAB_STAG)&quot;>&lt;xsl:value-of select=&quot;tns:ID_STATO_ELAB_STAG&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_STATO_ELAB_STAG>&lt;ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:decimal(tns:ID_FILE_PROCSTO_INPUT)&quot;/>&lt;/ID_FILE_PROCSTO_INPUT>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(tns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBC_Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_ROUTING_NUMBER&#xa;  SET DESCR_ERRORE = ?, ID_STATO_ELAB_STAG = TO_NUMBER(?, '9')&#xa;  WHERE ID_FILE_PROCSTO_INPUT = ? AND NUMERO_RECD = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERRORE"/>
                                    <PreparedParameters
