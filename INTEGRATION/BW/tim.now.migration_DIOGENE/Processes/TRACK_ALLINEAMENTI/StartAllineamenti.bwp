                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CreateFileID&quot; xmlns:tns1=&quot;http://www.example.org/VerificaLavorabilita&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VerificaLavorabilita&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;GetFLOWDiogene&quot;/>&lt;xsl:template name=&quot;CreateIDFile-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:DataIn>&lt;tns:Insert>&lt;tns:InputFile>&lt;xsl:choose>&lt;xsl:when test=&quot;$GetFLOWDiogene/Record[number($index)]/FLOW = 'Anagrafica Gestori'&quot;>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;'ID027'&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GetFLOWDiogene/Record[number($index)]/FLOW = 'Anagrafica Archi di Numerazione'&quot;>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;'ID016'&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_INTERFACCIA>&lt;xsl:value-of select=&quot;'ID018'&quot;/>&lt;/tns:CODICE_INTERFACCIA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;>&lt;tns:NOME_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:NOME_FILE&quot;/>&lt;/tns:NOME_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;>&lt;tns:DATA_FILE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:DATA_FILE&quot;/>&lt;/tns:DATA_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;>&lt;tns:SIZE>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:FILE_SIZE&quot;/>&lt;/tns:SIZE>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaLavorabilita/tns1:ID_TRACK&quot;>&lt;tns:ID_TRACK>&lt;xsl:value-of select=&quot;$VerificaLavorabilita/tns1:ID_TRAC