                                <tibex:expression
                                    expression="count($GetFLOWDiogene/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetFLOWDiogene/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
