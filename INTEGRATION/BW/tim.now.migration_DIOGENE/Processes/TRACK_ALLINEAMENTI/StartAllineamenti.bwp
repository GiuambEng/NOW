erificaLavorabilita/tns1:ID_TRACK&quot;/>&#xa;                &lt;/ns:ID_TRACK>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:NomeProcesso>&#xa;                &lt;xsl:value-of select=&quot;$varNome&quot;/>&#xa;            &lt;/ns:NomeProcesso>&#xa;        &lt;/ns:contaRecord_Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
