    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/CheckNomeFileDIOGENE"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="tns:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="Flusso" type="xsd:string"/>
        <bpws:variable name="NameLength" type="xsd:string"/>
        <bpws:variable name="DataLength" type="xsd:string"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="tns:ControlDate" name="Date"/>
        <bpws:variable element="tns:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckFlowToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckFlowToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="NameLengthToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="NameLengthToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="DateLengthToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="DateLengthToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DateLengthToAssign1" tibex:linkType="ERROR"/>
                <bpws:link name="AssignErrorToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckDateToAssignError" tibex:linkType="ERROR"/>
                <bpws:link name="CheckDateToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="bd8f606e-fd7d-4051-97ea-b74fa636b11d"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssign"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFileDIOGENE&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:param name=&quot;NameLength&quot;/>&lt;xsl:param name=&quot;DataLength&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$DataLength='ERROR' or $Flusso='ERROR' or $NameLength='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;if($DataLength='ERROR') then 'ERROR_DATA_FILE' else 'ERROR_NOME_FILE'&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="67184279-f219-400c-a31f-dfbd9db245cc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlowToEnd"/>
                        <bpws:target linkName="NameLengthToEnd"/>
                        <bpws:target linkName="DateLengthToEnd"/>
                        <bpws:target linkName="AssignErrorToEnd"/>
                        <bpws:target linkName="CheckDateToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFileDIOGENE&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Flusso&quot;/>&lt;xsl:param name=&quot;NameLength&quot;/>&lt;xsl:param name=&quot;DataLength&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$DataLength='ERROR' or $Flusso='ERROR' or $NameLength='ERROR'&quot;>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;if($DataLength='ERROR') then 'ERROR_DATA_FILE' else 'ERROR_NOME_FILE'&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLUSSO>&lt;xsl:value-of select=&quot;$Flusso&quot;/>&lt;/tns:FLUSSO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(contains($Start/tns:FILE_NAME, 'NPG_TO_NOW')) then 'Anagrafica Archi di Numerazione' else&#xd;&#xa;if(contains($Start/tns:FILE_NAME, 'OLO_TO_NOW')) then 'Anagrafica Gestori' else&#xd;&#xa;if(contains($Start/tns:FILE_NAME, 'RgN_TO_NOW')) then 'Anagrafica Routing Number' &#xd;&#xa;else 'ERROR'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Flusso" name="CheckFlow"
                    outputVariable="Flusso"
                    tibex:xpdlId="fc9366a5-89ae-4a7d-b926-fa26d40c3d0d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckFlowToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckFlowToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Flusso='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Flusso='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(contains($Start/tns:FILE_NAME, 'NPG_TO_NOW')) then 'Anagrafica Archi di Numerazione' else&#xd;&#xa;if(contains($Start/tns:FILE_NAME, 'OLO_TO_NOW')) then 'Anagrafica Gestori' else&#xd;&#xa;if(contains($Start/tns:FILE_NAME, 'RgN_TO_NOW')) then 'Anagrafica Routing Number' &#xd;&#xa;else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Flusso" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(count(tokenize( substring-before($Start/tns:FILE_NAME,&quot;.&quot;   ),&quot;_&quot;) )=4) then 'OK' &#xd;&#xa;      else 'ERROR'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="NameLength" name="NameLength"
                    outputVariable="NameLength"
                    tibex:xpdlId="7676081c-49e9-4d02-beea-5de0ee92fef9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckFlowToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NameLengthToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$NameLength='ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$NameLength='ERROR']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="NameLengthToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(count(tokenize( substring-before($Start/tns:FILE_NAME,&quot;.&quot;   ),&quot;_&quot;) )=4) then 'OK' &#xd;&#xa;      else 'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="NameLength" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[4], &quot;.&quot;)) =8 )then 'OK' else  'ERROR'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="DataLength" name="DateLength"
                    outputVariable="DataLength"
                    tibex:xpdlId="199a8291-517e-484a-ad23-3aa7aecb0065" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NameLengthToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DateLengthToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DateLengthToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$DataLength='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$DataLength='OK']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DateLengthToAssign1"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length(substring-before(tokenize($Start/tns:FILE_NAME, &quot;_&quot;)[4], &quot;.&quot;)) =8 )then 'OK' else  'ERROR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="DataLength" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/CheckNomeFileDIOGENE&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Date&quot; match=&quot;/&quot;>&lt;tns:ControlDate>&lt;tns:Date>&lt;xsl:value-of select=&quot;substring-before(tokenize($Start/tns:FILE_NAME, &amp;quot;_&amp;quot;)[4], &amp;quot;.&amp;quot;)&quot;/>&lt;/tns:Date>&lt;/tns:ControlDate>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Date" name="CheckDate"
                    outputVariable="Date"
                    tibex:xpdlId="09ea0a63-501b-4dae-8653-a6f6f3dbbb08" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DateLengthToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckDateToAssignError"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
