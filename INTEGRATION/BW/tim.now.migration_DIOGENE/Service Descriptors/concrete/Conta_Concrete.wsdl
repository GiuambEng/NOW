<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:ns="http://www.tibco.com/AllineamentoBatch/ContaRecord_Concrete/" xmlns:ns0="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="Conta" targetNamespace="http://www.tibco.com/AllineamentoBatch/ContaRecord_Concrete/">
  <wsdl:types>
    <xsd:schema xmlns:ns="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/">
      <xsd:complexType name="contaRecordInput_type">
        <xsd:sequence>
          <xsd:element name="in" type="xsd:string"/>
          <xsd:element name="TipoSeparatore">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:enumeration value="ContaRecord_DoppioPipe"/>
                <xsd:enumeration value="ContaRecord_PipeCancelletto"/>
                <xsd:enumeration value="POSIZIONALE"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="contaRecordOutput_type">
        <xsd:sequence>
          <xsd:element minOccurs="0" name="out" type="xsd:string"/>
          <xsd:element minOccurs="0" name="NumeroRecord" type="xsd:integer"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="contaRecord_Input" type="ns:contaRecordInput_type"/>
      <xsd:element name="contaRecord_Output" type="ns:contaRecordOutput_type"/>
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="Conta_Request">
    <wsdl:part element="ns0:contaRecord_Input" name="part1"/>
  </wsdl:message>
  <wsdl:message name="Conta_Response">
    <wsdl:part element="ns0:contaRecord_Output" name="part1"/>
  </wsdl:message>
  <wsdl:portType name="Conta">
    <wsdl:operation name="ContaRecord">
      <wsdl:input message="ns:Conta_Request"/>
      <wsdl:output message="ns:Conta_Response"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="SOAPServiceBinding" type="ns:Conta">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="ContaRecord">
      <soap:operation soapAction="ContaRecord" style="document"/>
      <wsdl:input>
        <soap:body parts="part1" use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body parts="part1" use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="Conta">
    <wsdl:port binding="ns:SOAPServiceBinding" name="ContaSOAP">
      <soap:address location="http://localhost:9756/SOAPServiceBinding/conta/"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
