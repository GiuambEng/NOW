<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/InfasatoreLDAP" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/InfasatoreLDAP">

    <complexType name="t_Result">
    	<sequence>
    		<element name="ResultCode" type="string"/>
    		<element name="ResultMessage" type="string"/>
    	</sequence>
    </complexType>

    <complexType name="t_LDAPUser">
    	<sequence>
            <element ref="tns:UserID"/>
            <element minOccurs="0" name="UserAlias" type="string"/>
    		<element minOccurs="0" name="Nome" type="string"/>
    		<element minOccurs="0" name="Matricola" type="string"/>
    		<element minOccurs="0" name="FunzioneAziendale" type="string">
    		</element>
    		<element minOccurs="0" name="Mail" type="string"/>
    		<element minOccurs="0" name="CodOloAgcom" type="string"/>
    	</sequence>
    </complexType>

    <element name="Result" type="tns:t_Result"/>

    <element name="LDAPUser" type="tns:t_LDAPUser"/>

    <element name="CreateRequest">
    	<complexType>
    		<sequence>
    			<element ref="tns:LDAPUser"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="CreateResponse">
    	<complexType>
    		<sequence>
    			<element ref="tns:Result"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="ReadRequest">
    	<complexType>
    		<sequence>
    			<element ref="tns:UserID"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="UserID" type="string"/>

    <element name="ReadResponse">
    	<complexType>
    		<sequence>
    			<element ref="tns:Result"/>
    			<element ref="tns:LDAPUser"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="UpdateRequest">
    	<complexType>
    		<sequence>
    			<element ref="tns:LDAPUser"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="UpdateResponse">
    	<complexType>
    		<sequence>
    			<element ref="tns:Result"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="DeleteRequest">
    	<complexType>
    		<sequence>
    			<element ref="tns:UserID"/>
    		</sequence>
    	</complexType>
  </element>

    <element name="DeleteResponse">
    	<complexType>
    		<sequence>
    			<element ref="tns:Result"/>
    		</sequence>
    	</complexType>
  </element>
</schema>
