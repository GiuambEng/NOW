                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns18="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" version="2.0"&gt;&lt;xsl:param name="Invoke1_ProcesLogger"/&gt;&lt;xsl:param name="Counter"/&gt;&lt;xsl:template name="ErroreCounter-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns18:contaRecord_Output/ns18:NumeroRecord=0 and $Counter/part1/ns18:contaRecord_Output/ns18:out='OK') "&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;ERRORE NUMERO RECORD&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns18:contaRecord_Output/ns18:NumeroRecord=0 and $Counter/part1/ns18:contaRecord_Output/ns18:out='OK') "&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($Invoke1_ProcesLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($Invoke1_ProcesLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="&amp;quot;INPUT&amp;quot;"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns18:contaRecord_Output/ns18:NumeroRecord=0 and $Counter/part1/ns18:contaRecord_Output/ns18:out='OK') "/&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="2"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="xsd:integer($Invoke1_ProcesLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($Invoke1_ProcesLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns18:contaRecord_Output/ns18:NumeroRecord=0 and $Counter/part1/ns18:contaRecord_Output/ns18:out='OK') "&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns18=&quot;http://www.tim.com/NOW/AllineamentiBatch/contaRecord/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke1_ProcesLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Counter.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;ErroreCounter-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Counter.part1/ns18:NumeroRecord=0 and $Counter.part1/ns18:out='OK') &quot;>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ERRORE NUMERO RECORD&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Counter.part1/ns18:NumeroRecord=0 and $Counter.part1/ns18:out='OK') &quot;>&#xa;                        &lt;ns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/ns:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/ns:ESITO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke1_ProcesLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke1_ProcesLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:FileProcessatoInput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Counter.part1/ns18:NumeroRecord=0 and $Counter.part1/ns18:out='OK') &quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_CAUS_SCARTO>&#xa;                            &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                        &lt;/ns:ID_CAUS_SCARTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_FILE_PROCSTO_INPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke1_ProcesLogger.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE_PROCSTO_INPUT>&#xa;            &lt;/ns:FileProcessatoInput>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($Invoke1_ProcesLogger.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Counter.part1/ns18:NumeroRecord=0 and $Counter.part1/ns18:out='OK') &quot;>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
