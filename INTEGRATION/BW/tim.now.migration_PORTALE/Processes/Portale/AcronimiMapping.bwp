OP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:RAGIONE_OP)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:RAGIONE_OP&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/RAGIONE_OP>&#xa;                    &lt;SISTEMA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:SISTEMA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:SISTEMA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/SISTEMA>&#xa;                    &lt;TMSP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:dateTime(tns3:TMSP_INSMTO)&quot;/>&#xa;                    &lt;/TMSP_INSMTO>&#xa;                    &lt;CONTENUTO_RECD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(tns3:CONTENUTO_RECD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;tns3:CONTENUTO_RECD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CONTENUTO_RECD>&#xa;                &lt;/Record>&#xa;            &lt