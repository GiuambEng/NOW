                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ACRN_OLO_MAPPING (COD_OP, COMPANY_CODE,&#xa;  COMPANY_NAME, DESC_SISTEMA, ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG,&#xa;  NUMERO_RECD, RAGIONE_OP, SISTEMA, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

