    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName1" tibex:xpdlId="ecfbbfa2-dfc1-45cf-b74a-9a94d4829dad">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="AssignToRenameFile1" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="CallProcessToError_RenameFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="RenameFile_ErrorToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="RenameFile_ErrorToOutput_RinameFile" tibex:linkType="ERROR"/>
                            <bpws:link name="Output_RinameFileToExit3" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="JDBCUpdateToError_RenameFile" tibex:linkType="SUCCESS"/>
                            <bpws:link name="JDBCUpdateToEmpty1" tibex:linkType="ERROR"/>
                            <bpws:link name="Empty1ToError_RenameFile" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathFileError, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.ctr' ), $Estensione) else concat($PathFileError, $NomeFileError_AcronimiMapping, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                inputVariable="Var_PathFileError"
                                name="Error_RenameFile"
                                outputVariable="Var_PathFileError"
                                tibex:xpdlId="483dd8b0-d8cd-4a9d-abe9-9d65772ecef7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToError_RenameFile"/>
                                    <bpws:target linkName="Empty1ToError_RenameFile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="AssignToRenameFile1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (string-length($FileRead/fileInfo/fileName)>0) then concat($PathFileError, 'ERROR_', substring-before( $FileRead/fileInfo/fileName,'.ctr' ), $Estensione) else concat($PathFileError, $NomeFileError_AcronimiMapping, format-dateTime(current-dateTime(), &quot;[Y0001][M01][D01]_[H01][m01][s01]&quot;), $Estensione)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_PathFileError" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFileError&quot;/>&lt;xsl:param name=&quot;File&quot;/>&lt;xsl:template name=&quot;RenameFile_Error-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$File/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$File/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$Var_PathFileError&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="RenameFile_Error-input"
                                name="RenameFile_Error"
                                outputVariable="RenameFile_Error"
                                tibex:xpdlId="a7f336e2-c01b-4676-88c5-df84b4ac98bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToRenameFile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="RenameFile_ErrorToExit3"/>
                                    <bpws:source
                                    linkName="RenameFile_ErrorToOutput_RinameFile"
                                    tibex:faultDetailsVar="RenameFile_Error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_PathFileError&quot;/>&lt;xsl:param name=&quot;File&quot;/>&lt;xsl:template name=&quot;RenameFile_Error-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;xsl:if test=&quot;$File/tns1:FullName&quot;>&lt;fromFileName>&lt;xsl:value-of select=&quot;$File/tns1:FullName&quot;/>&lt;/fromFileName>&lt;/xsl:if>&lt;toFileName>&lt;xsl:value-of select=&quot;$Var_PathFileError&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.file.rename"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true" xsi:type="file:RenameFile"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit3" tibex:xpdlId="704a5995-25bc-4567-80c1-1b8151097bbf">
                            <bpws:targets>
                                <bpws:target linkName="RenameFile_ErrorToExit3"/>
                                <bpws:target linkName="Output_RinameFileToExit3"/>
