            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.SelectCountRecord&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeProcLogger&quot;/>&lt;xsl:param name=&quot;CallProcess&quot;/>&lt;xsl:template name=&quot;Input_ProcessLogger&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:FileProcessato>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;ns:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:ESITO>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ns:ID_FILE>&lt;ns:TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_CHIUSURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;&amp;quot;INPUT&amp;quot;&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;ns:QT_RECD_KO>&lt;xsl:value-of select=&quot;xsd:integer($CallProcess/ns1:NumeroRecordKO)&quot;/>&lt;/ns:QT_RECD_KO>&lt;ns:QT_RECD_OK>&lt;xsl:value-of select=&quot;xsd:integer($CallProcess/ns1:NumeroRecordOK)&quot;/>&lt;/ns:QT_RECD_OK>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_FINE_ELAB>&lt;/ns:EsecuzioneFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Input_ProcessLogger"
                    name="UpdatePrLogger"
                    outputVariable="Input_ProcessLogger"
