                portType="ns23:ProcessLog" tibex:xpdlId="a90c55e3-3e62-42b5-9e69-edd2bafc7427">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns24="http://www.tim.com/NOW/AllineamentiBatch/contaRecord/" version="2.0"&gt;&lt;xsl:param name="InvokeProcLogger"/&gt;&lt;xsl:param name="Counter"/&gt;&lt;xsl:template name="ErroreConformita-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:FileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns24:contaRecord_Output/ns24:NumeroRecord=0 and$Counter/part1/ns24:contaRecord_Output/ns24:out='OK')"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;ERRORE NUMERO RECORD&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($Counter/part1/ns24:contaRecord_Output/ns24:NumeroRecord=0 and$Counter/part1/ns24:contaRecord_Output/ns24:out='OK')"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'OK'"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($InvokeProcLogger/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/