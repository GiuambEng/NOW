                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b952eabe-0861-4c93-b435-bc752a1afa4c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/MigrazioneCodiciProgetto_Mapping&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Var_InputLog&quot;/>&lt;xsl:param name=&quot;InvokeProcLogger&quot;/>&lt;xsl:template name=&quot;InsStaging-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$Var_InputLog/tns3:Record&quot;>&lt;Record>&lt;CODE_OPERATORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns3:CODE_OPERATORE)&quot;>&lt;xsl:value-of select=&quot;tns3:CODE_OPERATORE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODE_OPERATORE>&lt;CODPRGT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns3:COD_PRGT)&quot;>&lt;xsl:value-of select=&quot;tns3:COD_PRGT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODPRGT>&lt;DATAFI_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns3:DATFI_PROV)&quot;>&lt;xsl:value-of select=&quot;tns3:DATFI_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_PROV>&lt;DATAINZ_PROV>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns3:DATAINS_PROV)&quot;>&lt;xsl:value-of select=&quot;tns3:DATAINS_PROV&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt