                            expression="if ($Counter.part1/ns24:out='OK' and $Counter.part1/ns24:NumeroRecord=0) then (concat($FILE_PATH_MOVED, $File/ns33:FileName)) else (concat( $PathFileScarto ,$NomeFileScarto_CodiciProgetto,substring-after($File/ns33:FileName, 'NOW_CODICE_PROGETTO_')))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
