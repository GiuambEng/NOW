                                    sqlStatement="INSERT INTO STAG_ANAG_PRGT_FILE (CODE_OPERATORE, CODPRGT,&#xa;  DATAFI_PROV, DATAINZ_PROV, FITTIZIO, ID_FILE_PROCSTO_INPUT,&#xa;  ID_STATO_ELAB_STAG, NUMERO_RECD, REPORT, TMSP_INSMTO, CONTENUTO_RECD)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
