<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified"     attributeFormDefault="unqualified"
	targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneCodiciProgetto" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneCodiciProgetto">




	<element name="Root">
		<complexType>
			<sequence>
				<element name="MigrazioneCodiciProgetto" maxOccurs="unbounded" minOccurs="0">
					<complexType>
						<sequence>


							<element ref="tns:Dettaglio">

							</element>


						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<simpleType name="String100">
		<restriction base="string">
			<maxLength value="100" />
			<minLength value="1"></minLength>
		</restriction>
	</simpleType>

	<simpleType name="String3">
		<restriction base="string">
			<maxLength value="3" />
			<minLength value="1"></minLength>
		</restriction>
	</simpleType>

	<simpleType name="String2">
		<restriction base="string" />
	</simpleType>
	<element name="Dettaglio">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" name="Tipo_record">

					<simpleType>
						<restriction base="string">
							<enumeration value="2"/>
							<maxLength value="1"/>
						</restriction>
					</simpleType>
					</element>
				<element minOccurs="1" maxOccurs="1"
					name="CODICE_PROGETTO" type="tns:String100">
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="CODICE_OPERATORE" type="tns:String3">
				</element>
				<element minOccurs="1" maxOccurs="1"
					name="DATA_INIZIO_PROV">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>

				<element minOccurs="1" maxOccurs="1"
					name="DATA_FINE_PROV">
					<simpleType>
						<restriction base="string">
							<minLength value="1"></minLength>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" maxOccurs="1" name="FITTIZIO">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI"></enumeration>
							<enumeration value="NO"></enumeration>
							<maxLength value="2"></maxLength>
						</restriction>
					</simpleType>
				</element>
				<element minOccurs="1" maxOccurs="1" name="REPORT">
					<simpleType>
						<restriction base="tns:String2">
							<enumeration value="SI"></enumeration>
							<enumeration value="NO"></enumeration>
							<maxLength value="2"></maxLength>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>

	<simpleType name="Newdata">
		<restriction base="string">  <pattern
                                          value="((0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-(1[0-9][0-9][0-9]|2[0][01][0-6]))" /> </restriction>
	</simpleType>
</schema>
