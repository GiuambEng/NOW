<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/UpStag" xmlns:tns="http://www.example.org/UpStag" elementFormDefault="qualified">

    <element name="UpStag">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0"
    				ref="tns:UpStag_input">
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="UpStag_input">
    	<complexType>
    		<sequence>
    			<element name="DESCR_ERRORE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_STATO_ELAB_STAG" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_FILE" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="NUM_RECD" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>