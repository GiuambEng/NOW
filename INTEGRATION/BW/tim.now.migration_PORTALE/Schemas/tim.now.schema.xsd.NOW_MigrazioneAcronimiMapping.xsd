						</restriction>
					</simpleType>
				</element>
				<element maxOccurs="1" minOccurs="1" name="COMPANY_CODE" type="tns:String3">
				</element>
				<element maxOccurs="1" minOccurs="1" name="COMPANY_NAME" type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="CODICE_OP" type="tns:String3">
				</element>
				<element maxOccurs="1" minOccurs="1" name="RAGIONE_OP" type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="SISTEMA" type="tns:String100">
				</element>
				<element maxOccurs="1" minOccurs="1" name="DESC_SISTEMA" type="tns:String100">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
