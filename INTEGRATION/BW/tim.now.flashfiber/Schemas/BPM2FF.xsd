<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/BPM2FF"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/BPM2FF" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<complexType name="BPM2FFRequestType">
		<sequence>
			<element name="TipoRiscontro">
				<simpleType>
					<restriction base="string">
						<enumeration value="ANNULLAMENTO"></enumeration>
						<enumeration value="CAMBIODAI"></enumeration>
						<enumeration value="DESOSPENSIONE"></enumeration>
						<enumeration value="SOSPENSIONE"></enumeration>
						<enumeration value="ESPLETAMENTO"></enumeration>
						<enumeration value="CESSAZIONE"></enumeration>
						<enumeration value="ATTIVAZIONE"></enumeration>
					</restriction>
				</simpleType>
			</element>
			<element ref="pref:RichiestaElement"></element>
			<element name="Codice" type="string" minOccurs="0"></element>
			<element name="Descrizione" type="string" minOccurs="0"></element>
			<element name="CodiceOrdineOperatore" type="string"
				minOccurs="0">
			</element>
			<element name="CausaleEsitoDTU" type="string"
				minOccurs="0">
			</element>
			<element name="EsitoDTU" type="string" minOccurs="0"></element>
			<element name="TipologiaEventoDTU" type="string"
				minOccurs="0">
			</element>
			<element name="OK_KO" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<enumeration value="OK"></enumeration>
						<enumeration value="KO"></enumeration>
					</restriction>
				</simpleType>
			</element>
			<element name="IdRichiestaDTU" type="string" minOccurs="0"></element>
			<element name="NoteDaSistema" type="string" minOccurs="0"></element>
			<element name="AnnullamentoAutomatico" type="boolean" minOccurs="0"></element>
		</sequence>
	</complexType>

    <element name="BPM2FFRequest" type="tns:BPM2FFRequestType"></element>
</schema>