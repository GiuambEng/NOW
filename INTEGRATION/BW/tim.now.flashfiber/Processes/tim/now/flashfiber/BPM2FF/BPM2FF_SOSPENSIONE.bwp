                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Update-input" name="Update"
                operation="Tracciamento" outputVariable="Update"
                partnerLink="TracciamentoWSTIM2"
                portType="ns7:TracciamentoWSTIM2" tibex:xpdlId="3f3c299c-f7eb-497e-b9e6-4baabed2ef1b">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns2="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/EONWStaging" xmlns:nslt2="urn:PegaRULES:SOAP:RiscontriOL:Services" xmlns:tns3="http://www.tim.com/NOW/xsd/EventoOperatoreRete" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Riscontri"/&gt;&lt;xsl:template name="Update-input" match="/"&gt;&lt;tns1:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns2:TracciamentoInput&gt;&lt;tns2:InsertUpdateStaging&gt;&lt;tns:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns:ContenutoResponse&gt;&lt;tns:IdStatoElabStaging&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns:IdStatoElabStaging&gt;&lt;tns:TimstpRisposta&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TimstpRisposta&gt;&lt;tns:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns:CodiceAckNack&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns:IdEventoOrdnNowWhls&gt;&lt;/xsl:if&gt;&lt;tns:Transaction_ID&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/codiceOrdineOperatore"/&gt;&lt;/tns:Transaction_ID&gt;&lt;tns:Azione&gt;&lt;xsl:value-of select="&amp;quot;Update&amp;quot;"/&gt;&lt;/tns:Azione&gt;&lt;tns:NumTentativo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/tns:NumTentativo&gt;&lt;/tns2:InsertUpdateStaging&gt;&lt;tns2:EventoOperatoreRete&gt;&lt;tns3:IdEventoOrdnNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns3:IdEventoOrdnNowWhls&gt;&lt;tns3:IdNotf&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idNotifica"/&gt;&lt;/tns3:IdNotf&gt;&lt;tns3:IdRichOlo&gt;&lt;xsl:value-of select="$Start/ns:RichiestaElement/IDRichiestaOLO"/&gt;&lt;/tns3:IdRichOlo&gt;&lt;tns3:IdMessaggio&gt;&lt;xsl:value-of select="$Mapper/richiesta/testata/idMessaggio"/&gt;&lt;/tns3:IdMessaggio&gt;&lt;tns3:TimstpInsmto&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns3:TimstpInsmto&gt;&lt;tns3:IdEventoOperatoreRete&gt;&lt;xsl:value-of select="2"/&gt;&lt;/tns3:IdEventoOperatoreRete&gt;&lt;tns3:CodCausale&gt;&lt;xsl:value-of select="$Mapper/richiesta/sospensione/codiceCausaleSospensione"/&gt;&lt;/tns3:CodCausale&gt;&lt;tns3:DataSospensione&gt;&lt;xsl:value-of select="tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/sospensione/dataSospensione)"/&gt;&lt;/tns3:DataSospensione&gt;&lt;tns3:DescrCausale&gt;&lt;xsl:value-of select="$Mapper/richiesta/sospensione/descrizioneCausaleSospensione"/&gt;&lt;/tns3:DescrCausale&gt;&lt;xsl:if test="$Mapper/richiesta/sospensione/note"&gt;&lt;tns3:Note&gt;&lt;xsl:value-of select="$Mapper/richiesta/sospensione/note"/&gt;&lt;/tns3:Note&gt;&lt;/xsl:if&gt;&lt;/tns2:EventoOperatoreRete&gt;&lt;tns2:Azione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/tns2:Azione&gt;&lt;tns2:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;&lt;/tns2:StatoEsec&gt;&lt;tns2:ContenutoResponse&gt;&lt;xsl:value-of select="tib:render-xml($Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse)"/&gt;&lt;/tns2:ContenutoResponse&gt;&lt;tns2:CodiceAckNack&gt;&lt;xsl:value-of select="$Riscontri/riscontriOLResponse/nslt2:riscontriOLResponse/risposta/esito/codice"/&gt;&lt;/tns2:CodiceAckNack&gt;&lt;tns2:TransactionId&gt;&lt;xsl:value-of select="concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)"/&gt;&lt;/tns2:TransactionId&gt;&lt;xsl:if test="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"&gt;&lt;tns2:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns2:TracciamentoOutput/tns2:IdEventoOrdineWhls"/&gt;&lt;/tns2:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;/tns2:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns1:TracciamentoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/TracciamentoWSTIM2&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EONWStaging&quot; xmlns:nslt2=&quot;urn:PegaRULES:SOAP:RiscontriOL:Services&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EventoOperatoreRete&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStaging.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Riscontri.riscontriOLResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Update-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TracciamentoInput>&#xa;            &lt;tns2:InsertUpdateStaging>&#xa;                &lt;tns:ContenutoResponse>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.riscontriOLResponse)&quot;/>&#xa;                &lt;/tns:ContenutoResponse>&#xa;                &lt;tns:IdStatoElabStaging>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns:IdStatoElabStaging>&#xa;                &lt;tns:TimstpRisposta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TimstpRisposta>&#xa;                &lt;tns:CodiceAckNack>&#xa;                    &lt;xsl:value-of select=&quot;$Riscontri.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;                &lt;/tns:CodiceAckNack>&#xa;                &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                    &lt;tns:IdEventoOrdnNowWhls>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                    &lt;/tns:IdEventoOrdnNowWhls>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Transaction_ID>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/codiceOrdineOperatore&quot;/>&#xa;                &lt;/tns:Transaction_ID>&#xa;                &lt;tns:Azione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Update&amp;quot;&quot;/>&#xa;                &lt;/tns:Azione>&#xa;                &lt;tns:NumTentativo>&#xa;                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                &lt;/tns:NumTentativo>&#xa;            &lt;/tns2:InsertUpdateStaging>&#xa;            &lt;tns2:EventoOperatoreRete>&#xa;                &lt;tns3:IdEventoOrdnNowWhls>&#xa;                    &lt;xsl:value-of select=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;/>&#xa;                &lt;/tns3:IdEventoOrdnNowWhls>&#xa;                &lt;tns3:IdNotf>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idNotifica&quot;/>&#xa;                &lt;/tns3:IdNotf>&#xa;                &lt;tns3:IdRichOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:IdRichOlo>&#xa;                &lt;tns3:IdMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/testata/idMessaggio&quot;/>&#xa;                &lt;/tns3:IdMessaggio>&#xa;                &lt;tns3:TimstpInsmto>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns3:TimstpInsmto>&#xa;                &lt;tns3:IdEventoOperatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                &lt;/tns3:IdEventoOperatoreRete>&#xa;                &lt;tns3:CodCausale>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/sospensione/codiceCausaleSospensione&quot;/>&#xa;                &lt;/tns3:CodCausale>&#xa;                &lt;tns3:DataSospensione>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,$Mapper/richiesta/sospensione/dataSospensione)&quot;/>&#xa;                &lt;/tns3:DataSospensione>&#xa;                &lt;tns3:DescrCausale>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper/richiesta/sospensione/descrizioneCausaleSospensione&quot;/>&#xa;                &lt;/tns3:DescrCausale>&#xa;                &lt;xsl:if test=&quot;$Mapper/richiesta/sospensione/note&quot;>&#xa;                    &lt;tns3:Note>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/richiesta/sospensione/note&quot;/>&#xa;                    &lt;/tns3:Note>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:EventoOperatoreRete>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:StatoEsec>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/tns2:StatoEsec>&#xa;            &lt;tns2:ContenutoResponse>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Riscontri.riscontriOLResponse)&quot;/>&#xa;            &lt;/tns2:ContenutoResponse>&#xa;            &lt;tns2:CodiceAckNack>&#xa;                &lt;xsl:value-of select=&quot;$Riscontri.riscontriOLResponse/risposta/esito/codice&quot;/>&#xa;            &lt;/tns2:CodiceAckNack>&#xa;            &lt;tns2:TransactionId>&#xa;                &lt;xsl:value-of select=&quot;concat($Mapper/richiesta/testata/idNotifica,&amp;quot;-&amp;quot;,$Mapper/richiesta/testata/idMessaggio)&quot;/>&#xa;            &lt;/tns2:TransactionId>&#xa;            &lt;xsl:if test=&quot;$InsertStaging.parameters/tns2:IdEventoOrdineWhls&quot;>&#xa;                &lt;tns2:IdEventoOrdineNowWhls>&#