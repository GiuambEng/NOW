mp;quot;DTU: &amp;quot;, string(tib:render-xml($descrDTU, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna Causale&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
