tro>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataRiscontro>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery1/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery1/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/lavorazione&quot;/>&lt;/tipoOrdine>&lt;tipoRiscontro>&lt;xsl:value-of select=&quot;&amp;quot;SOSPENSIONE&amp;quot;&quot;/>&lt;/tipoRiscontro>&lt;/testata>&lt;sospensione>&lt;codiceCausaleSospensione>&lt;xsl:value-of select=&quot;$Causali/Record[1]/CAUSALE&quot;/>&lt;/codiceCausaleSospensione>&lt;dataSospensione>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/dataSospensione>&lt;descrizioneCausaleSospensione>&lt;xsl:value-of select=&quot;$Causali/Record[1]/DESCRIZIONE&quot;/>&lt;/descrizioneCausaleSospensione>&lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;/xsl:if>&lt;/sospensione>&lt;/richiesta>&lt;/tns:sospensione>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
