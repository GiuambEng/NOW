                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/TracciamentoWSTIM2/" xmlns:tns1="http://www.tim.com/NOW/xsd/TracciamentoWSTIM2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns3="http://www.tim.com/NOW/xsd/BPM2FF" version="2.0"&gt;&lt;xsl:param name="InsertStaging"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="IdProcsoNoFile"/&gt;&lt;xsl:template name="UpdateTimeout-input" match="/"&gt;&lt;tns:TracciamentoRequest&gt;&lt;parameters&gt;&lt;tns1:TracciamentoInput&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:IdEsecProcsoNoFile&gt;&lt;xsl:value-of select="xsd:int(xsd:decimal($InsertStaging/parameters/tns1:TracciamentoOutput/tns1:IdEsecProcsoNoFile))"/&gt;&lt;/tns1:IdEsecProcsoNoFile&gt;&lt;xsl:if test="$InsertStaging/parameters/tns1:TracciamentoOutput/tns1:CodProcsoNoFile"&gt;&lt;tns1:CodProcsoFIle&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns1:TracciamentoOutput/tns1:CodProcsoNoFile"/&gt;&lt;/tns1:CodProcsoFIle&gt;&lt;/xsl:if&gt;&lt;tns1:StatoEsec&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/tns1:StatoEsec&gt;&lt;tns1:DescrErrore&gt;&lt;xsl:value-of select="'TIMEOUT'"/&gt;&lt;/tns1:DescrErrore&gt;&lt;xsl:if test="$Start/tns3:CodiceOrdineOperatore"&gt;&lt;tns1:TransactionId&gt;&lt;xsl:value-of select="$Start/tns3:CodiceOrdineOperatore"/&gt;&lt;/tns1:TransactionId&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InsertStaging/parameters/tns1:TracciamentoOutput/tns1:IdEventoOrdineWhls"&gt;&lt;tns1:IdEventoOrdineNowWhls&gt;&lt;xsl:value-of select="$InsertStaging/parameters/tns1:TracciamentoOutput/tns1:IdEventoOrdineWhls"/&gt;&lt;/tns1:IdEventoOrdineNowWhls&gt;&lt;/xsl:if&gt;&lt;tns1:IdProcsoNoFile&gt;&lt;xsl:value-of select="$IdProcsoNoFile"/&gt;&lt;/tns1:IdProcsoNoFile&gt;&lt;tns1:NumTentativo&gt;&lt;xsl:value-of select="1"/&gt;&lt;/tns1:NumTentativo&gt;&lt;/tns1:TracciamentoInput&gt;&lt;/parameters&gt;&lt;/tns:Trac