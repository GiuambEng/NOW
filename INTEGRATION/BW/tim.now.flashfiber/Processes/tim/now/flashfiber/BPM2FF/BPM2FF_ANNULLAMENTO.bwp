                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e37576d7-06b7-466c-86d5-a24478751ceb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;descrDTU-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CausEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CausEsito>&lt;Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Esito>&lt;EventoNativoDTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/EventoNativoDTU>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="descrDTU-input" name="descrDTU"
                    outputVariable="descrDTU"
                    tibex:xpdlId="e37576d7-06b7-466c-86d5-a24478751ceb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CausaliToJDBCQuery1_NoCausaliFF"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="descrDTUToLogCausali"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e37576d7-06b7-466c-86d5-a24478751ceb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;descrDTU-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CausEsito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CausEsito>&lt;Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Esito>&lt;EventoNativoDTU>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/EventoNativoDTU>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT dtu.DESCR &#xa;FROM TIPOLG_ESITO_DTU dtu &#xa;WHERE dtu.CAUS_ESITO = ? AND dtu.ESITO = ? &#xa;&#x9;AND dtu.EVENTO_NATIVO_DTU = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CausEsito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="EventoNativoDTU"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ca88c9ac-1576-4d2b-a93c-1107d6465bd0+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelCausalPrec-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;ID_RICH_OLO2>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelCausalePrec-input"
                    name="SelCausalePrec"
                    outputVariable="SelCausalePrec"
                    tibex:xpdlId="ca88c9ac-1576-4d2b-a93c-1107d6465bd0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToSelCausalPrec"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelCausalPrecToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ca88c9ac-1576-4d2b-a93c-1107d6465bd0+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelCausalPrec-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;ID_RICH_OLO2>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_NOW_A IN&#xa;     ('SOSPESO',&#xa;      'ACCODATO',&#xa;      'SOSPESOOPERESPECIALI',&#xa;      'SOSPESOATTESAPERMESSI')&#xa;AND T.ID_EVENTO_ORDN_NOW_WHLS IS NULL&#xa;UNION ALL&#xa;SELECT T.ID_ANAG_CAUS, T.TIMSTP_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC T&#xa;JOIN EVENTO_ORDN_NOW_WHLS EV ON EV.ID_RICH_OLO = TO_NCHAR(T.ID_RICH_OLO)&#xa;  AND EV.ID_EVENTO_ORDN_NOW_WHLS = T.ID_EVENTO_ORDN_NOW_WHLS&#xa;JOIN TIPOLG_EVENTO TE ON TE.IDTPLG_EVENTO = EV.IDTPLG_EVENTO&#xa;  AND (TE.DESCR_EVENTO = 'NI_SOSPENSIONE' OR TE.DESCR_EVENTO = 'NI_ACCODAMENTO' OR TE.DESCR_EVENTO = 'NI_FINE_TENTATIVO_CONTATTO')&#xa;WHERE T.ID_RICH_OLO = ?&#xa;     AND T.STATO_NOW_A IN&#xa;     ('SOSPESO',&#xa;      'ACCODATO',&#xa;      'SOSPESOOPERESPECIALI',&#xa;      'SOSPESOATTESAPERMESSI')&#xa;ORDER BY 2 DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO2"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_TRACC"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;SelCausalePrec&quot;/>&lt;xsl:template name=&quot;LogSelCausalePrec-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio sottoprocesso di invio sospensione. Causali recuperate: &amp;quot;&quot;/>&lt;/tns:Message>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelCausalePrec/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperata id anagrafica causale precedente: &amp;quot;, string(tib:render-xml($SelCausalePrec, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna id anagrafica causale precedente&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogSelCausalePrec-input"
                    name="LogSelCausalePrec"
                    tibex:xpdlId="1eaa9071-e037-4cea-9633-8d797c2d4e11"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelCausalPrecToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToCausali"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;SelCausalePrec&quot;/>&lt;xsl:template name=&quot;LogSelCausalePrec-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio sottoprocesso di invio sospensione. Causali recuperate: &amp;quot;&quot;/>&lt;/tns:Message>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelCausalePrec/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperata id anagrafica causale precedente: &amp;quot;, string(tib:render-xml($SelCausalePrec, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna id anagrafica causale precedente&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
