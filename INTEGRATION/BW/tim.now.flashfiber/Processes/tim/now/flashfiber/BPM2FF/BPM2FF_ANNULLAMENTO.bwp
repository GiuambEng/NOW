                                    expression="count($Causali/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Causali/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CausaliToJDBCQuery1_NoCausaliFF">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bf49cda3-a15f-4508-bf44-4b0dec3214ff+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelCausalePrec&quot;/>&lt;xsl:template name=&quot;Causali-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;CAUS_ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CausaleEsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CausaleEsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CAUS_ESITO>&lt;ESITO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:EsitoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:EsitoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ESITO>&lt;IDTPLG_EVENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:TipologiaEventoDTU)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:TipologiaEventoDTU&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDTPLG_EVENTO>&lt;ID_ANAG_CAUS_PREC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelCausalePrec/Record[1]/ID_ANAG_CAUS)&quot;>&lt;xsl:value-of select=&quot;$SelCausalePrec/Record[1]/ID_ANAG_CAUS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ANAG_CAUS_PREC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:AnnullamentoAutomatico) and $Start/tns1:AnnullamentoAutomatico=true()&quot;>&lt;TIPOLOGIA_TIMEOUT>&lt;xsl:value-of select=&quot;'T'&quot;/>&lt;/TIPOLOGIA_TIMEOUT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPOLOGIA_TIMEOUT>&lt;xsl:value-of select=&quot;'O'&quot;/>&lt;/TIPOLOGIA_TIMEOUT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ff.CAUSALE,ff.DESCRIZIONE &#xa;FROM TRASCODFC_CAUS_FF ff JOIN TIPOLG_ESITO_DTU dtu &#xa;ON (dtu.CAUS_ESITO=ff.CAUS_ESITO AND dtu.ESITO=ff.ESITO AND dtu.IDTPLG_EVENTO=ff.IDTPLG_EVENTO)&#xa;WHERE dtu.CAUS_ESITO=? AND dtu.ESITO=? AND dtu.EVENTO_NATIVO_DTU=? AND dtu.FLAG_ALTRO_OPERATORE = 'Y' AND ff.ID_ANAG_CAUS_PREC=? AND ff.TIPOLOGIA_TIMEOUT=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CAUS_ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ESITO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_EVENTO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ANAG_CAUS_PREC"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLOGIA_TIMEOUT"/>
                                    <columnMetadata
                                    columnName="CAUSALE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Causali&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;descrDTU&quot;/>&lt;xsl:template name=&quot;LogCausali-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio sottoprocesso di invio sospensione. Causali recuperate: &amp;quot;&quot;/>&lt;/tns:Message>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Causali/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;FF: &amp;quot;, string(tib:render-xml($Causali, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;count($descrDTU/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;DTU: &amp;quot;, string(tib:render-xml($descrDTU, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna Causale&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogCausali-input" name="LogCausali"
                    tibex:xpdlId="1cc7f4b6-cc98-4e20-a3b8-ed8f731460fd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToJDBCQuery"/>
                        <bpws:target linkName="descrDTUToLogCausali"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(exists($Causali) and count($Causali/Record) > 0) or (exists($descrDTU) and count($descrDTU/Record) > 0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($Causali) and count($Causali/Record) > 0) or (exists($descrDTU) and count($descrDTU/Record) > 0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogCausaliToExit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Causali&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogInfoLevel&quot;/>&lt;xsl:param name=&quot;descrDTU&quot;/>&lt;xsl:template name=&quot;LogCausali-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;)&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOperatore&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Inizio sottoprocesso di invio sospensione. Causali recuperate: &amp;quot;&quot;/>&lt;/tns:Message>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Causali/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;FF: &amp;quot;, string(tib:render-xml($Causali, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:when test=&quot;count($descrDTU/Record) > 0&quot;>&lt;tns:Payload>&lt;xsl:value-of select=&quot;concat(&amp;quot;DTU: &amp;quot;, string(tib:render-xml($descrDTU, true(), true())))&quot;/>&lt;/tns:Payload>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Payload>&lt;xsl:value-of select=&quot;&amp;quot;Nessuna Causale&amp;quot;&quot;/>&lt;/tns:Payload>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogInfoLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:exit name="Exit" tibex:xpdlId="ac246a6f-fc0a-48c9-b813-b3322f51e168">
