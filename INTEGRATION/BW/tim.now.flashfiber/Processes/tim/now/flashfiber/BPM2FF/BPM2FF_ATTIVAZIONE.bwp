               &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;>&#xa;                                    &lt;codiceComune>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/codiceISTATComune&quot;/>&#xa;                                    &lt;/codiceComune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codiceEgon>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDEGON&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/codiceEgon>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;>&#xa;                                    &lt;complesso>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/complesso&quot;/>&#xa;                                    &lt;/complesso>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot