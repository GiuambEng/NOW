/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTECERT&amp;quot;]/via&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/sede>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;sede>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;>&#xa;                                    &lt;cap>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/CAP&quot;/>&#xa;                                    &lt;/cap>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/civico&quot;/>&#xa;                                    &lt