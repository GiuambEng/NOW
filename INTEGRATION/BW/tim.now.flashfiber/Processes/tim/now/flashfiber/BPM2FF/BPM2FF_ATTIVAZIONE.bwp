                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns1=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:attivazione>&#xa;            &lt;richiesta>&#xa;                &lt;testata>&#xa;                    &lt;codiceOperatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&#xa;                    &lt;/codiceOperatore>&#xa;                    &lt;codiceOrdineOperatore>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&#xa;                    &lt;/codiceOrdineOperatore>&#xa;                    &lt;xsl:if test=&quot;not(ends-with($Start/tns1:CodiceOrdineOperatore, '_1'))&quot;>&#xa;                        &lt;codiceOrdineOperatorePadre>&#xa;                            &lt;xsl:value-of select=&quot;concat(tib:substring-before-last($Start/tns1:CodiceOrdineOperatore, &amp;quot;_&amp;quot;), &amp;quot;_1&amp;quot;)&quot;/>&#xa;                        &lt;/codiceOrdineOperatorePadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/codiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/codiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;dataIdMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdMessaggio>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;idMessaggio>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&#xa;                    &lt;/idMessaggio>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/tipoOrdine>&#xa;                &lt;/testata>&#xa;                &lt;accessoGponLna>&#xa;                    &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;idGpon>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/idGpon>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;progettazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/progettazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;progettazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/progettazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;slaAssurance>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/slaAssurance>&#xa;                    &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;codiceROE>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/codiceROE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;codiceSplitterPrimario>&#xa;                            &lt;xsl:valu