            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM2FF&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns1=&quot;http://ordinicommerciali.service.flashfiber.com/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Invoke&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;ns1:attivazione>&lt;richiesta>&lt;testata>&lt;codiceOperatore>&lt;xsl:value-of select=&quot;&amp;quot;TIM&amp;quot;&quot;/>&lt;/codiceOperatore>&lt;codiceOrdineOperatore>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOperatore&quot;/>&lt;/codiceOrdineOperatore>&lt;xsl:if test=&quot;not(ends-with($Start/tns1:CodiceOrdineOperatore, '_1'))&quot;>&lt;codiceOrdineOperatorePadre>&lt;xsl:value-of select=&quot;concat(tib:substring-before-last($Start/tns1:CodiceOrdineOperatore, &amp;quot;_&amp;quot;), &amp;quot;_1&amp;quot;)&quot;/>&lt;/codiceOrdineOperatorePadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataIdMessaggio>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdMessaggio>&lt;dataIdNotifica>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataIdNotifica>&lt;idMessaggio>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_MESSAGGIO)&quot;/>&lt;/idMessaggio>&lt;idNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTIFICA)&quot;/>&lt;/idNotifica>&lt;tipoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tipoOrdine>&lt;/testata>&lt;accessoGponLna>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;>&lt;idGpon>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo&quot;/>&lt;/idGpon>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:NoteDaSistema&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/tns1:NoteDaSistema&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;IDGPON&amp;quot;]/valoreAttributo)>0&quot;>&lt;progettazione>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/progettazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;progettazione>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/progettazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;slaAssurance>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/slaAssurance>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;>&lt;codiceROE>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ROE&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceROE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;>&lt;codiceSplitterPrimario>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERPRIMARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceSplitterPrimario>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERSECONDARIO&amp;quot;]/valoreAttributo&quot;>&lt;codiceSplitterSecondario>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;CODICESPLITTERSECONDARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/codiceSplitterSecondario>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo)>2&quot;>&lt;posizioneMorsettieraROE>&lt;xsl:value-of select=&quot;tib:right($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo,2)&quot;/>&lt;/posizioneMorsettieraROE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo)>0&quot;>&lt;posizioneMorsettieraROE>&lt;xsl:value-of select=&quot;tib:pad-front($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONEMORSETTIERAROE&amp;quot;]/valoreAttributo, 2, '0')&quot;/>&lt;/posizioneMorsettieraROE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTER&amp;quot;]/valoreAttributo)>2&quot;>&lt;posizioneSplitterSecondario>&lt;xsl:value-of select=&quot;tib:right($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTER&amp;quot;]/valoreAttributo, 2)&quot;/>&lt;/posizioneSplitterSecondario>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTER&amp;quot;]/valoreAttributo)>0&quot;>&lt;posizioneSplitterSecondario>&lt;xsl:value-of select=&quot;tib:pad-front($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUCONFIGURAZIONE&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;POSIZIONESPLITTER&amp;quot;]/valoreAttributo, 2, '0')&quot;/>&lt;/posizioneSplitterSecondario>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;datiCliente>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;>&lt;codiceFiscale>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/CF&quot;/>&lt;/codiceFiscale>&lt;/xsl:if>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;>&lt;partitaIva>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/PIVA&quot;/>&lt