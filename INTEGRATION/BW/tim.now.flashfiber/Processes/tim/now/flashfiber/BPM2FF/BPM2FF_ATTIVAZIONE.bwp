l:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;>&#xa;                                    &lt;particellaToponomastica>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/particellaToponomastica&quot;/>&#xa;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;>&#xa;                                    &lt;piano>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/piano&quot;/>&#xa;                                    &lt;/piano>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;>&#xa;                                    &lt;scala>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/sede[tipologiaSede=&amp;quot;SEDECLIENTE&amp;quot;][1]/scala&quot;/>&#xa;                                    &lt;/scala>&#xa;                                &lt;/xsl:if>&#x