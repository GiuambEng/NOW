                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/invokeSendVariazioneULLLNA.recovery.invoke&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_CRMWS_AllineamentoConsistenze_concrete/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SendVariazioneULLNA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Send_Variazione_Ullna_Request>&#xa;            &lt;tns1:Transaction_id>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:Transaction_id&quot;/>&#xa;            &lt;/tns1:Transaction_id>&#xa;            &lt;tns1:Transaction_date>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:Transaction_date&quot;/>&#xa;            &lt;/tns1:Transaction_date>&#xa;            &lt;tns1:SERVIZIO>&#xa;                &lt;tns1:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:CodiceOlo&quot;/>&#xa;                &lt;/tns1:CodiceOlo>&#xa;                &lt;tns1:DescOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:DescOLO&quot;/>&#xa;                &lt;/tns1:DescOLO>&#xa;                &lt;tns1:ULLLNA>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                    &lt;tns1:VARIAZIONE>&#xa;                        &lt;tns1:CodiceOrdineOlo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CodiceOrdineOlo&quot;/>&#xa;                        &lt;/tns1:CodiceOrdineOlo>&#xa;                        &lt;tns1:CodiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CodiceOrdineTI&quot;/>&#xa;                        &lt;/tns1:CodiceOrdineTI>&#xa;                        &lt;tns1:Contratto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Contratto&quot;/>&#xa;                        &lt;/tns1:Contratto>&#xa;                        &lt;tns1:Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Risorsa&quot;/>&#xa;                        &lt;/tns1:Risorsa>&#xa;                        &lt;tns1:ID_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_NOW>&#xa;                        &lt;tns1:ID_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:ID_CRMWS&quot;/>&#xa;                        &lt;/tns1:ID_CRMWS>&#xa;                        &lt;tns1:DAC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DAC&quot;/>&#xa;                        &lt;/tns1:DAC>&#xa;                        &lt;tns1:Dec>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Dec&quot;/>&#xa;                        &lt;/tns1:Dec>&#xa;                        &lt;tns1:Tipologia_variazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Tipologia_variazione&quot;/>&#xa;                        &lt;/tns1:Tipologia_variazione>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IdUllCo&quot;>&#xa;                            &lt;tns1:IdUllCo>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IdUllCo&quot;/>&#xa;                            &lt;/tns1:IdUllCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PosizionePermutatore1&quot;>&#xa;                            &lt;tns1:PosizionePermutatore1>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PosizionePermutatore1&quot;/>&#xa;                            &lt;/tns1:PosizionePermutatore1>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PosizionePermutatore2&quot;>&#xa;                            &lt;tns1:PosizionePermutatore2>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PosizionePermutatore2&quot;/>&#xa;                            &lt;/tns1:PosizionePermutatore2>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IndicatoreDiAsurance&quot;>&#xa;                            &lt;tns1:IndicatoreDiAsurance>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IndicatoreDiAsurance&quot;/>&#xa;                            &lt;/tns1:IndicatoreDiAsurance>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico&quot;>&#xa;                            &lt;tns1:DistrettoTelefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DistrettoTelefonico&quot;/>&#xa;                            &lt;/tns1:DistrettoTelefonico>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLLI_della_centrale&quot;>&#xa;                            &lt;tns1:CLLI_della_centrale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLLI_della_centrale&quot;/>&#xa;                            &lt;/tns1:CLLI_della_centrale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Civico_EFD&quot;>&#xa;                            &lt;tns1:Civico_EFD>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Civico_EFD&quot;/>&#xa;                            &lt;/tns1:Civico_EFD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IDARLTI&quot;>&#xa;                            &lt;tns1:IDARLTI>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:IDARLTI&quot;/>&#xa;                            &lt;/tns1:IDARLTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Codice_centrale_ACLRR&quot;>&#xa;                            &lt;tns1:Codice_centrale_ACLRR>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:Codice_centrale_ACLRR&quot;/>&#xa;                            &lt;/tns1:Codice_centrale_ACLRR>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DATA_PERMUTA_ARMADIO&quot;>&#xa;                            &lt;tns1:DATA_PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DATA_PERMUTA_ARMADIO&quot;/>&#xa;                            &lt;/tns1:DATA_PERMUTA_ARMADIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PERMUTA_ARMADIO&quot;>&#xa;                            &lt;tns1:PERMUTA_ARMADIO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:PERMUTA_ARMADIO&quot;/>&#xa;                            &lt;/tns1:PERMUTA_ARMADIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:DESTINAZIONEUSO>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:Fonia&quot;>&#xa;                                &lt;tns1:Fonia>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:Fonia&quot;/>&#xa;                                &lt;/tns1:Fonia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:DATI>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:DATI/tns:TipoDati&quot;>&#xa;                                    &lt;tns1:TipoDati>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:DATI/tns:TipoDati&quot;/>&#xa;                                    &lt;/tns1:TipoDati>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:DATI/tns:BitRate&quot;>&#xa;                                    &lt;tns1:BitRate>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:DESTINAZIONEUSO/tns:DATI/tns:BitRate&quot;/>&#xa;                                    &lt;/tns1:BitRate>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:DATI>&#xa;                        &lt;/tns1:DESTINAZIONEUSO>&#xa;                        &lt;tns1:CLIENTE>&#xa;                            &lt;xsl:if test=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLIENTE/tns:CognomeRagioneSociale&quot;>&#xa;                                &lt;tns1:CognomeRagioneSociale>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:CLIENTE/tns:CognomeRagioneSociale&quot;/>&#xa;                                &lt;/tns1:CognomeR