obileReferente"/&gt;&lt;/tns1:TelefonoMobileReferente&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:REFERENTEONFIELD/tns:TelefonoFissoReferente"&gt;&lt;tns1:TelefonoFissoReferente&gt;&lt;xsl:value-of select="$Start/tns:Send_Variazione_Ullna_Request/tns:SERVIZIO/tns:ULLLNA/tns:VARIAZIONE/tns:REFERENTEONFIELD/tns:TelefonoFissoReferente"/&gt;&lt;/tns1:TelefonoFissoReferente&gt;&lt;/xsl:if&gt;&lt;/tns1:REFERENTEONFIELD&gt;&lt;/tns1:VARIAZIONE&gt;&lt;/tns1:ULLLNA&gt;&lt;/tns1:SERVIZIO&gt;&lt;/tns1:Send_Variazione_Ullna_Request&gt;&lt;/part1&gt;&lt;/ns:SendVariazioneULLLNARequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
