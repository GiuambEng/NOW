        &lt;/tns1:VARIAZIONE>&#xa;                &lt;/tns1:ULLLNA>&#xa;            &lt;/tns1:SERVIZIO>&#xa;        &lt;/tns1:Send_Variazione_Ullna_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
