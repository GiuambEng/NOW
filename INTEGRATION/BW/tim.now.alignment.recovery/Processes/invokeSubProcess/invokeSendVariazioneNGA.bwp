                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.SendVariazioneNGA.recovery.invoke&quot; xmlns:ns=&quot;http://www.tibco.com/NOWSendConsistenzaDatiConcrete/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendVariazioneNGA&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SendVariazioneNGA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Now_SendVariazioneNGA_Request>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:Now_SendVariazioneNGA_Request/tns:SERVIZIO&quot;>&#xa;                &lt;tns1:SERVIZIO>&#xa;                    &lt;tns1:CodiceOlo>&#xa;                        &lt;xsl:value-of select=&quot;tns:CodiceOlo&quot;/>&#xa;                    &lt;/tns1:CodiceOlo>&#xa;                    &lt;tns1:DescOlo>&#xa;                        &lt;xsl:value-of select=&quot;tns:DescOlo&quot;/>&#xa;                    &lt;/tns1:DescOlo>&#xa;                    &lt;xsl:for-each select=&quot;tns:VARIAZIONE&quot;>&#xa;                        &lt;tns1:VARIAZIONE>&#xa;                            &lt;tns1:CodiceOrdineOlo>&#xa;                                &lt;xsl:value-of select=&quot;tns:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns1:CodiceOrdineOlo>&#xa;                            &lt;tns1:Codice_ordine_TI>&#xa;                                &lt;xsl:value-of select=&quot;tns:Codice_ordine_TI&quot;/>&#xa;                            &lt;/tns1:Codice_ordine_TI>&#xa;                            &lt;tns1:Contratto>&#xa;                                &lt;xsl:value-of select=&quot;tns:Contratto&quot;/>&#xa;                            &lt;/tns1:Contratto>&#xa;                            &lt;tns1:Risorsa>&#xa;                                &lt;xsl:value-of select=&quot;tns:Risorsa&quot;/>&#xa;                            &lt;/tns1:Risorsa>&#xa;                            &lt;tns1:ID_NOW>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_NOW&quot;/>&#xa;                            &lt;/tns1:ID_NOW>&#xa;                            &lt;tns1:ID_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_CRMWS&quot;/>&#xa;                            &lt;/tns1:ID_CRMWS>&#xa;                            &lt;xsl:if test=&quot;tns:DAC&quot;>&#xa;                                &lt;tns1:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DAC&quot;/>&#xa;                                &lt;/tns1:DAC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Dec>&#xa;                                &lt;xsl:value-of select=&quot;tns:Dec&quot;/>&#xa;                            &lt;/tns1:Dec>&#xa;                            &lt;tns1:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;tns:CLLI&quot;/>&#xa;                            &lt;/tns1:CLLI>&#xa;                            &lt;tns1:Tipologia_variazione>&#xa;                                &lt;xsl:value-of select=&quot;tns:Tipologia_variazione&quot;/>&#xa;                            &lt;/tns1:Tipologia_variazione>&#xa;                            &lt;tns1:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;tns:Servizio&quot;/>&#xa;                            &lt;/tns1:Servizio>&#xa;                            &lt;tns1:VULA_NGA>&#xa;                                &lt;tns1:TipoLinea>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:TipoLinea&quot;/>&#xa;                                &lt;/tns1:TipoLinea>&#xa;                                &lt;tns1:Tecnologia>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:Tecnologia&quot;/>&#xa;                                &lt;/tns1:Tecnologia>&#xa;                                &lt;tns1:ProfiloTecnicoLinea>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:ProfiloTecnicoLinea&quot;/>&#xa;                                &lt;/tns1:ProfiloTecnicoLinea>&#xa;                                &lt;tns1:Encapsulation>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:Encapsulation&quot;/>&#xa;                                &lt;/tns1:Encapsulation>&#xa;                                &lt;tns1:UserVLAN_1_TAGGING>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:UserVLAN_1_TAGGING&quot;/>&#xa;                                &lt;/tns1:UserVLAN_1_TAGGING>&#xa;                                &lt;tns1:Distretto>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:Distretto&quot;/>&#xa;                                &lt;/tns1:Distretto>&#xa;                                &lt;xsl:if test=&quot;tns:VULA_NGA/tns:Aggiuntivo&quot;>&#xa;                                    &lt;tns1:Aggiuntivo>&#xa;                                        &lt;xsl:value-of select=&quot;tns:VULA_NGA/tns:Aggiuntivo&quot;/>&#xa;                                    &lt;/tns1:Aggiuntivo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:for-each select=&quot;tns:VULA_NGA/tns:SLA&quot;>&#xa;                                    &lt;tns1:SLA>&#xa;                                        &lt;xsl:if test=&quot;tns:SlaAssurance&quot;>&#xa;                                            &lt;tns1:SlaAssurance>&#xa;                                                &lt;xsl:value-of select=&quot;tns:SlaAssurance&quot;/>&#xa;                                            &lt;/tns1:SlaAssurance>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:SLA>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;xsl:for-each select=&quot;tns:VULA_NGA/tns:USERVLAN&quot;>&#xa;                                    &lt;tns1:USERVLAN>&#xa;                                        &lt;tns1:ID_RISORSA_USERVLAN>&#xa;                                            &lt;xsl:value-of select=&quot;tns:ID_RISORSA_USERVLAN&quot;/>&#xa;                                        &lt;/tns1:ID_RISORSA_USERVLAN>&#xa;                                        &lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&#xa;                                            &lt;tns1:UserVlan_ID>&#xa;                                                &lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&#xa;                                            &lt;/tns1:UserVlan_ID>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns1:CODICE_VLAN>&#xa;                                            &lt;xsl:value-of select=&quot;tns:CODICE_VLAN&quot;/>&#xa;                                        &lt;/tns1:CODICE_VLAN>&#xa;                                        &lt;xsl:if test=&quot;tns:CVLAN_ID&quot;>&#xa;                                            &lt;tns1:CVLAN_ID>&#xa;                                                &lt;xsl:value-of select=&quot;tns:CVLAN_ID&quot;/>&#xa;                                            &lt;/tns1:CVLAN_ID>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                            &lt;tns1:Profilo_BMD>&#xa;                                                &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                            &lt;/tns1:Profilo_BMD>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                            &lt;tns1:Banda_Picco_UP>&#xa;                                                &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                            &lt;/tns1:Banda_Picco_UP>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;tns:Banda_Picco_Down&quot;>&#xa;                                            &lt;tns1:Banda_Picco_Down>&#xa;                                                &lt;xsl:value-of select=&quot;tns:Banda_Picco_Down&quot;/>&#xa;                                            &lt;/tns1:Banda_Picco_Down>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns1:Stato_user_vlan>&#xa;                                            &lt;xsl:value-of select=&quot;tns:Stato_user_vlan&quot;/>&#xa;                                        &lt;/tns1:Stato_user_vlan>&#xa;                                        &lt;xsl:if test=&quot;tns:Data_espt_uservlan&quot;>&#xa;                                            &lt;tns1:Data_espt_uservlan>&#xa;                                                &lt;xsl:value-of select=&quot;tns:Data_espt_uservlan&quot;/>&#xa;                                            &lt;/tns1:Data_espt_uservlan>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/tns1:USERVLAN>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns1:VULA_NGA>&#xa;                        &lt;/tns1:VARIAZIONE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:SERVIZIO>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Start/tns:Now_SendVariazioneNGA_Request/tns:REQUEST&quot;>&#xa;                &lt;tns1:REQUEST>&#xa;                    &lt;tns1:Transaction_id>&#xa;                        &lt;xsl:value-of select=&quot;tns:Transaction_id&quot;/>&#xa;                    &lt;/tns1:Transaction_id>&#xa;                    &lt;tns1:Transaction_date>&#xa;                        &lt;xsl:value-of select=&quot;tns:Transaction_date&quot;/>&#xa;                    &lt;/tns1:Transaction_date>&#xa;                &lt;/tns1:REQUEST>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:Now_SendVariazioneNGA_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartLogToInvoke"/>
                </bpws:targets>
                <bpws:sources>
