                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.SendCessazioneDati.recovery.invoke&quot; xmlns:ns=&quot;http://www.tibco.com/NOWSendConsistenzaDatiConcrete/&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.xsd.SendCessazioneDati&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SendCessazioneDati-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Now_SendCessazioneDati_Request>&#xa;            &lt;tns1:SERVIZIO>&#xa;                &lt;tns1:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CodiceOlo&quot;/>&#xa;                &lt;/tns1:CodiceOlo>&#xa;                &lt;tns1:DescOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:DescOlo&quot;/>&#xa;                &lt;/tns1:DescOlo>&#xa;                &lt;tns1:CESSAZIONE>&#xa;                    &lt;tns1:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/tns1:CodiceOrdineOlo>&#xa;                    &lt;tns1:Codice_ordine_TI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:Codice_ordine_TI&quot;/>&#xa;                    &lt;/tns1:Codice_ordine_TI>&#xa;                    &lt;tns1:Contratto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:Contratto&quot;/>&#xa;                    &lt;/tns1:Contratto>&#xa;                    &lt;tns1:Risorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:Risorsa&quot;/>&#xa;                    &lt;/tns1:Risorsa>&#xa;                    &lt;tns1:ID_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:ID_NOW&quot;/>&#xa;                    &lt;/tns1:ID_NOW>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:DAC&quot;>&#xa;                        &lt;tns1:DAC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:DAC&quot;/>&#xa;                        &lt;/tns1:DAC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:Dec>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:Dec&quot;/>&#xa;                    &lt;/tns1:Dec>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:SERVIZIO/tns:CESSAZIONE/tns:Servizio&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                &lt;/tns1:CESSAZIONE>&#xa;            &lt;/tns1:SERVIZIO>&#xa;            &lt;tns1:REQUEST>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:REQUEST/tns:Transaction_id&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendCessazioneDati_Request/tns:REQUEST/tns:Transaction_date&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;            &lt;/tns1:REQUEST>&#xa;        &lt;/tns1:Now_SendCessazioneDati_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
