VC/tns:SCRUp"/&gt;&lt;/tns2:SCRUp&gt;&lt;/xsl:if&gt;&lt;/tns2:PROFILO_VC&gt;&lt;/tns2:DATI_VC_ATM&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:DATI_USERVLAN_GBE"&gt;&lt;tns2:DATI_USERVLAN_GBE&gt;&lt;tns2:ID_RISORSA_USERVLAN&gt;&lt;xsl:value-of select="tns:ID_RISORSA_USERVLAN"/&gt;&lt;/tns2:ID_RISORSA_USERVLAN&gt;&lt;tns2:VPI&gt;&lt;xsl:value-of select="tns:VPI"/&gt;&lt;/tns2:VPI&gt;&lt;tns2:VCI&gt;&lt;xsl:value-of select="tns:VCI"/&gt;&lt;/tns2:VCI&gt;&lt;tns2:CODICE_VLAN&gt;&lt;xsl:value-of select="tns:CODICE_VLAN"/&gt;&lt;/tns2:CODICE_VLAN&gt;&lt;tns2:Stato&gt;&lt;xsl:value-of select="tns:Stato"/&gt;&lt;/tns2:Stato&gt;&lt;xsl:if test="tns:CVlanCode"&gt;&lt;tns2:CVlanCode&gt;&lt;xsl:value-of select="tns:CVlanCode"/&gt;&lt;/tns2:CVlanCode&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:ProtocolloPila"&gt;&lt;tns2:ProtocolloPila&gt;&lt;xsl:value-of select="tns:ProtocolloPila"/&gt;&lt;/tns2:ProtocolloPila&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Profilo_BMD"&gt;&lt;tns2:Profilo_BMD&gt;&lt;xsl:value-of select="tns:Profilo_BMD"/&gt;&lt;/tns2:Profilo_BMD&gt;&lt;/xsl:if&gt;&lt;tns2:PROTOCOLLO_PILA_IPOA&gt;&lt;tns2:IP_DSLAM&gt;&lt;xsl:value-of select="tns:PROTOCOLLO_PILA_IPOA/tns:IP_DSLAM"/&gt;&lt;/tns2:IP_DSLAM&gt;&lt;tns2:IP_KIT&gt;&lt;xsl:value-of select="tns:PROTOCOLLO_PILA_IPOA/tns:IP_KIT"/&gt;&lt;/tns2:IP_KIT&gt;&lt;/tns2:PROTOCOLLO_PILA_IPOA&gt;&lt;/tns2:DATI_USERVLAN_GBE&gt;&lt;/xsl:for-each&gt;&lt;/tns2:BTS_ATM_GBE_EASYIP&gt;&lt;/tns2:VARIAZIONE&gt;&lt;/tns2:SERVIZIO&gt;&lt;tns2:REQUEST&gt;&lt;tns2:Transaction_id&gt;&lt;xsl:value-of select="$Start/tns:Now_SendVariazioneXDSL_Request/tns:REQUEST/tns:Transaction_id"/&gt;&lt;/tns2:Transaction_id&gt;&lt;tns2:Transaction_date&gt;&lt;xsl:value-of select="$Start/tns:Now_SendVariazioneXDSL_Request/tns:REQUEST/tns:Transaction_date"/&gt;&lt;/tns2:Transaction_date&gt;&lt;/tns2:REQUEST&gt;&lt;/tns2:Now_SendVariazioneXDSL_Request&gt;&lt;/parameters&gt;&lt;/ns:SendVariazioneXDSLRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/tim.now.xsd.SendVariazioneXDSL_Recovery_invoke&quot; xmlns:ns=&quot;http://www.tibco.com/NOWSendConsistenzaDatiConcrete/&quot; xmlns:tns2=&quot;http://www.example.org/tim.now.xsd.SendVariazioneXDSL&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SendVariazioneXdsl-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Now_SendVariazioneXDSL_Request>&#xa;            &lt;tns2:SERVIZIO>&#xa;                &lt;tns2:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:CodiceOlo&quot;/>&#xa;                &lt;/tns2:CodiceOlo>&#xa;                &lt;tns2:DescOlo>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:DescOlo&quot;/>&#xa;                &lt;/tns2:DescOlo>&#xa;                &lt;tns2:VARIAZIONE>&#xa;                    &lt;tns2:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineOlo>&#xa;                    &lt;tns2:Codice_ordine_TI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Codice_ordine_TI&quot;/>&#xa;                    &lt;/tns2:Codice_ordine_TI>&#xa;                    &lt;tns2:Contratto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Contratto&quot;/>&#xa;                    &lt;/tns2:Contratto>&#xa;                    &lt;tns2:Risorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Risorsa&quot;/>&#xa;                    &lt;/tns2:Risorsa>&#xa;                    &lt;tns2:ID_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:ID_NOW&quot;/>&#xa;                    &lt;/tns2:ID_NOW>&#xa;                    &lt;tns2:ID_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:ID_CRMWS&quot;/>&#xa;                    &lt;/tns2:ID_CRMWS>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:DAC&quot;>&#xa;                        &lt;tns2:DAC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:DAC&quot;/>&#xa;                        &lt;/tns2:DAC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:Dec>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Dec&quot;/>&#xa;                    &lt;/tns2:Dec>&#xa;                    &lt;tns2:CLLI>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:CLLI&quot;/>&#xa;                    &lt;/tns2:CLLI>&#xa;                    &lt;tns2:Tipologia_variazione>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Tipologia_variazione&quot;/>&#xa;                    &lt;/tns2:Tipologia_variazione>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:Servizio&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                    &lt;tns2:BTS_ATM_GBE_EASYIP>&#xa;                        &lt;tns2:TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:TipoLinea&quot;/>&#xa;                        &lt;/tns2:TipoLinea>&#xa;                        &lt;tns2:Modulazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:Modulazione&quot;/>&#xa;                        &lt;/tns2:Modulazione>&#xa;                        &lt;tns2:ProfiloTecnicoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:ProfiloTecnicoLinea&quot;/>&#xa;                        &lt;/tns2:ProfiloTecnicoLinea>&#xa;                        &lt;tns2:Distretto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:Distretto&quot;/>&#xa;                        &lt;/tns2:Distretto>&#xa;                        &lt;tns2:Aggiuntivo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:Aggiuntivo&quot;/>&#xa;                        &lt;/tns2:Aggiuntivo>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:Tecnologia&quot;>&#xa;                            &lt;tns2:Tecnologia>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:Tecnologia&quot;/>&#xa;                            &lt;/tns2:Tecnologia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:DATI_VC_ATM&quot;>&#xa;                            &lt;tns2:DATI_VC_ATM>&#xa;                                &lt;tns2:ID_RISORSA_VC>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_RISORSA_VC&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA_VC>&#xa;                                &lt;tns2:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Stato&quot;/>&#xa;                                &lt;/tns2:Stato>&#xa;                                &lt;xsl:if test=&quot;tns:Data_espletamento&quot;>&#xa;                                    &lt;tns2:Data_espletamento>&#xa;                                        &lt;xsl:value-of select=&quot;tns:Data_espletamento&quot;/>&#xa;                                    &lt;/tns2:Data_espletamento>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:VPI_Rete>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VPI_Rete&quot;/>&#xa;                                &lt;/tns2:VPI_Rete>&#xa;                                &lt;tns2:VCI_Rete>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VCI_Rete&quot;/>&#xa;                                &lt;/tns2:VCI_Rete>&#xa;                                &lt;tns2:VPI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                &lt;/tns2:VPI>&#xa;                                &lt;tns2:VCI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                &lt;/tns2:VCI>&#xa;                                &lt;xsl:if test=&quot;tns:CODICE_TD&quot;>&#xa;                                    &lt;tns2:CODICE_TD>&#xa;                                        &lt;xsl:value-of select=&quot;tns:CODICE_TD&quot;/>&#xa;                                    &lt;/tns2:CODICE_TD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:CODICE_VP&quot;>&#xa;                                    &lt;tns2:CODICE_VP>&#xa;                                        &lt;xsl:value-of select=&quot;tns:CODICE_VP&quot;/>&#xa;                                    &lt;/tns2:CODICE_VP>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:PROFILO_VC>&#xa;                                    &lt;tns2:TIPO_PROFILO_VC>&#xa;                                        &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:TIPO_PROFILO_VC&quot;/>&#xa;                                    &lt;/tns2:TIPO_PROFILO_VC>&#xa;                                    &lt;xsl:if test=&quot;tns:PROFILO_VC/tns:MCRDown&quot;>&#xa;                                        &lt;tns2:MCRDown>&#xa;                                            &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:MCRDown&quot;/>&#xa;                                        &lt;/tns2:MCRDown>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns:PROFILO_VC/tns:MCRUp&quot;>&#xa;                                        &lt;tns2:MCRUp>&#xa;                                            &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:MCRUp&quot;/>&#xa;                                        &lt;/tns2:MCRUp>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns2:PCRDown>&#xa;                                        &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:PCRDown&quot;/>&#xa;                                    &lt;/tns2:PCRDown>&#xa;                                    &lt;tns2:PCRUp>&#xa;                                        &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:PCRUp&quot;/>&#xa;                                    &lt;/tns2:PCRUp>&#xa;                                    &lt;xsl:if test=&quot;tns:PROFILO_VC/tns:SCRDown&quot;>&#xa;                                        &lt;tns2:SCRDown>&#xa;                                            &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:SCRDown&quot;/>&#xa;                                        &lt;/tns2:SCRDown>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;tns:PROFILO_VC/tns:SCRUp&quot;>&#xa;                                        &lt;tns2:SCRUp>&#xa;                                            &lt;xsl:value-of select=&quot;tns:PROFILO_VC/tns:SCRUp&quot;/>&#xa;                                        &lt;/tns2:SCRUp>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns2:PROFILO_VC>&#xa;                            &lt;/tns2:DATI_VC_ATM>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:for-each select=&quot;$Start/tns:Now_SendVariazioneXDSL_Request/tns:SERVIZIO/tns:VARIAZIONE/tns:BTS_ATM_GBE_EASYIP/tns:DATI_USERVLAN_GBE&quot;>&#xa;                            &lt;tns2:DATI_USERVLAN_GBE>&#xa;                                &lt;tns2:ID_RISORSA_USERVLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_RISORSA_USERVLAN&quot;/>&#xa;                                &lt;/tns2:ID_RISORSA_USERVLAN>&#xa;                                &lt;tns2:VPI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                                &lt;/tns2:VPI>&#xa;                                &lt;tns2:VCI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                                &lt;/tns2:VCI>&#xa;                                &lt;tns2:CODICE_VLAN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CODICE_VLAN&quot;/>&#xa;                                &lt;/tns2:CODICE_VLAN>&#xa;                                &lt;tns2:Stato>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Stato&quot;/>&#xa;                                &lt;/tns2:Stato>&#xa;                                &lt;xsl:if test=&quot;tns:CVlanCode&quot;>&#xa;                                    &lt;tns2:CVlanCode>&#xa;                                        &lt;xsl:value-of select=&quot;tns:CVlanCode&quot;/>&#xa;                                    &lt;/tns2:CVlanCode>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:ProtocolloPila&quot;>&#xa;                                    &lt;tns2:ProtocolloPila>&#xa;                                        &lt;xsl:value-of select=&quot;tns:ProtocolloPila&quot;/>&#xa;                                    &lt;/tns2:ProtocolloPila>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                    &lt;tns2:Profilo_BMD>&#xa;                                        &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                    &lt;/tns2:Profilo_BMD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns2:PROTOCOLLO_PILA_IPOA>&#xa;                                    &lt;tns2:IP_DSLAM>&#xa;                                        &lt;xsl:value-of select=&quot;tns:PROTOCOLLO_PILA_IPOA/tns:IP_DSLAM&quot;/>&#xa;                                    &lt;/tns2:IP_DSLAM>&#xa;                                    &lt;tns2:IP_KIT>&#xa;                                        &lt;xsl:value-of select=&quot;tns:PROTOCOLLO_PILA_IPOA/tns:IP_KIT&quot;/>&#xa;                                    &lt;/tns2:IP_KIT>&#xa;                                &lt;/tns2:PROTOCOLLO_PILA_IPOA>&#xa;                            &lt;/tns2:DATI_USERVLAN_GBE>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns2:BTS_ATM_GBE_EASYIP>&#xa;                &lt;/tns2:VARIAZIONE>&#xa;            &lt;/tns2:SERVIZIO>&#xa;         