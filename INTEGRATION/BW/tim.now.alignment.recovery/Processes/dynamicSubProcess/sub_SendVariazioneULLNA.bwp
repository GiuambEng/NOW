                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_REQUEST, ID_ESEC_PROCSO_NO_FILE&#xd;&#xa;  FROM STAG_ALMTO_COSTZ_NOFIN&#xd;&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE IN (    SELECT ID_ESEC_PROC&#xd;&#xa;              FROM RECOVERY&#xd;&#xa;              WHERE NOME_STAGING = 'STAG_ALMTO_COSTZ_NOFIN' AND FLAG_LAVORAZIONE = 'Y'&#xd;&#xa;            AND STATO_ELABORAZIONE = 'DA_LAVORARE')&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
