                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/invokeSendVariazioneULLLNA.recovery.invoke&quot; xmlns:tns1=&quot;http://tim/now/schema/xsd/SendVariazioneULLNA.recovery/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Parse&quot;/>&lt;xsl:param name=&quot;ContaRecordInviati&quot;/>&lt;xsl:template name=&quot;AggiornamentoSendVariazioneULLNA-input&quot; match=&quot;/&quot;>&lt;tns:invoke_Send_Variazione_Ullna_Request>&lt;tns:Send_Variazione_Ullna_Request>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Parse/tns1:Send_Variazione_Ullna_Request[number($ContaRecordInviati)]&quot;/>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;$var/tns1:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;$var/tns1:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO&quot;>&lt;tns:SERVIZIO>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;tns:DescOLO>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:DescOLO&quot;/>&lt;/tns:DescOLO>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA&quot;>&lt;tns:ULLLNA>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:Servizio&quot;/>&lt;/tns:Servizio>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE&quot;>&lt;tns:VARIAZIONE>&lt;tns:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CodiceOrdineOlo&quot;/>&lt;/tns:CodiceOrdineOlo>&lt;tns:CodiceOrdineTI>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CodiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineTI>&lt;tns:Contratto>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:Contratto&q