;tns:Fonia>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:DESTINAZIONEUSO/tns1:Fonia&quot;/>&lt;/tns:Fonia>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:DESTINAZIONEUSO/tns1:DATI&quot;>&lt;tns:DATI/>&lt;/xsl:for-each>&lt;/tns:DESTINAZIONEUSO>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE&quot;>&lt;tns:CLIENTE>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:CognomeRagioneSociale&quot;>&lt;tns:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:Nome&quot;>&lt;tns:Nome>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:Nome&quot;/>&lt;/tns:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:CF&quot;>&lt;tns:CF>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:CF&quot;/>&lt;/tns:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:Piva&quot;>&lt;tns:Piva>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:CLIENTE/tns1:Piva&quot;/>&lt;/tns:Piva>&lt;/xsl:if>&lt;/tns:CLIENTE>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:SEDE&quot;>&lt;tns:SEDE>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:SEDE/tns1:ParticellaToponomastica&quot;>&lt;tns:ParticellaToponomastica>&lt;xsl:value-of select=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/tns1:VARIAZIONE/tns1:SEDE/tns1:ParticellaToponomastica&quot;/>&lt;/tns:ParticellaToponomastica>&lt;/xsl:if>&lt;xsl:if test=&quot;$var/tns1:SERVIZIO/tns1:ULLLNA/t