    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="RepeatToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToRepeat" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="65d6bb90-ed2c-4f0d-b53b-56389c9915fa"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="End"
                    tibex:xpdlId="9857b135-6d85-46ad-a180-16794a0da75e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatToEnd"/>
                    </bpws:targets>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="Repeat" tibex:group="repeatUntil" tibex:xpdlId="d31a1ecb-76b9-4ef1-8183-830779255a84">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToRepeat"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="repeatUntil">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ContenutoRecord/lastSubset=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="JDBCQueryToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateToCallProcess1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToContenutoRecord" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ContaParseToWhile" tibex:linkType="SUCCESS"/>
                                <bpws:link name="WhileToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ContenutoRecordToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="ParseToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="NoParsingToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="b1a3ebe5-f5d4-4c69-9654-3d347651bd79">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToContenutoRecord"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="86cfb188-e6a0-4afd-9a96-2a476190f7af">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToGroupEnd"/>
                                    <bpws:target linkName="NoParsingToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+090e31a8-f901-4edf-8cc9-1174e391e33a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PassoEstrazione&quot;/>&lt;xsl:template name=&quot;ContenutoRecord-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;subsetSize>&lt;xsl:value-of select=&quot;$PassoEstrazione&quot;/>&lt;/subsetSize>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
