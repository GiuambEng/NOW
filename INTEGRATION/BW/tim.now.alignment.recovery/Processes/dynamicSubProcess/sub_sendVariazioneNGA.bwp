    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="www.tim.now.recovery.process.dinamic.schema"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="tim.now.recovery.parse.subprocess.input.schema"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/tim.now.xsd.SendVariazioneNGA.recovery"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/tim.now.xsd.SendVariazioneNGA.recovery.invoke"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:jdbcQueryActivityInput"
            name="ContenutoRecord-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:resultSet" name="ContenutoRecord" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns2:jdbcUpdateActivityInput"
            name="InLavorazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:jdbcUpdateActivityOutput"
            name="InLavorazione" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="StartLog-input" sca-bpel:internal="true"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/Application" type="xsd:string"/>
        <bpws:variable name="LogName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerLevel" type="xsd:string"/>
        <bpws:variable element="ns5:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="jdbcTimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timeout/jdbcTimeOut" type="xsd:int"/>
        <bpws:variable name="PassoEstrazione" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Recovery/passoEstrazione" type="xsd:int"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="RequestLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:CW_BUS_MESSAGE"
            name="ResponseLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:Now_SendVariazioneNGA"
            name="SendVariazioneNGA-input" sca-bpel:internal="true"/>
        <bpws:variable name="ContaRecordInviati" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="ContaRecordParse" type="xsd:integer">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns7:Input" name="Parse-input" sca-bpel:internal="true"/>
