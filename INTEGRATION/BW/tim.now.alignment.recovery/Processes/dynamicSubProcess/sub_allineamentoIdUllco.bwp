                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE RECOVERY&#xa;  SET STATO_ELABORAZIONE = 'LAVORAZIONE_IN_CORSO', TIMESTAMP_LAVORAZIONE = SYSDATE&#xa;  WHERE ID_ESEC_PROC = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

