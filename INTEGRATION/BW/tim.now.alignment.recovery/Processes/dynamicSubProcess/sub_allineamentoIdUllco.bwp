                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0426b6ba-1dfe-46cf-9716-548f4e1f903b+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ContenutoRecord&quot;/>&lt;xsl:template name=&quot;Lavorato-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$ContenutoRecord/Record&quot;>&lt;Record>&lt;ID_ESEC_PROC>&lt;xsl:value-of select=&quot;ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/ID_ESEC_PROC>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
