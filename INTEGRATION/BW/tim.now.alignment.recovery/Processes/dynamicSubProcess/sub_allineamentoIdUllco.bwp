                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    processInSubsets="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_REQUEST,ID_ESEC_PROCSO_NO_FILE&#xa;  FROM STAG_CLC_IDULLCO_NOFIN&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE IN (SELECT ID_ESEC_PROC FROM RECOVERY WHERE NOME_STAGING='STAG_CLC_IDULLCO_NOFIN' AND FLAG_LAVORAZIONE='Y' AND STATO_ELABORAZIONE='DA_LAVORARE')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="CONTENUTO_REQUEST"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_NO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
