                                <bpws:targets>
                                    <bpws:target linkName="ContaParseToWhile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="WhileToJDBCUpdate"/>
                                </bpws:sources>
                                <bpws:variables>
