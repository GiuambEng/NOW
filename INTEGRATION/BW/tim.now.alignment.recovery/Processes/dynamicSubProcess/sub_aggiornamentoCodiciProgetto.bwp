        <bpws:variable
            element="ns7:Now_SendCodiciProgetto_Invoke_Response"
            name="AggiornamentoCodiciProgetto" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="ResponseLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:jdbcUpdateActivityInput"
            name="Lavorato-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="Lavorato" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE" name="EndLog-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
