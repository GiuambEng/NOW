                                    sqlStatement="SELECT CONTENUTO_REQUEST, ID_ESEC_PROCSO_NO_FILE&#xa;  FROM STAG_ANAG_PRGT_NO_FILE&#xa;  WHERE ID_ESEC_PROCSO_NO_FILE IN (    SELECT ID_ESEC_PROC&#xa;              FROM APPUSER.RECOVERY&#xa;              WHERE NOME_STAGING = 'STAG_ANAG_PRGT_NO_FILE' AND FLAG_LAVORAZIONE = 'Y'&#xa;            AND STATO_ELABORAZIONE = 'DA_LAVORARE')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
