NVIO>&lt;xsl:value-of select=&quot;tns1:Now_SendIdullco/tns1:DATA_INVIO&quot;/>&lt;/tns:DATA_INVIO>&lt;tns:Nome>&lt;xsl:value-of select=&quot;tns1:Now_SendIdullco/tns1:Nome&quot;/>&lt;/tns:Nome>&lt;xsl:if test=&quot;tns1:Now_SendIdullco/tns1:DRCP&quot;>&lt;tns:DRCP>&lt;xsl:value-of select=&quot;tns1:Now_SendIdullco/tns1:DRCP&quot;/>&lt;/tns:DRCP>&lt;/xsl:if>&lt;tns:Codice_GAT>&lt;xsl:value-of select=&quot;tns1:Now_SendIdullco/tns1:Codice_GAT&quot;/>&lt;/tns:Codice_GAT>&lt;tns:Tipo_Colocazione>&lt;xsl:value-of select=&quot;tns1:Now_SendIdullco/tns1:Tipo_Colocazione&quot;/>&lt;/tns:Tipo_Colocazione>&lt;/tns:Now_SendIdullco>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Now_SendIdullco_repeating>&lt;/xsl:template>&lt;/xsl:stylesheet>"
