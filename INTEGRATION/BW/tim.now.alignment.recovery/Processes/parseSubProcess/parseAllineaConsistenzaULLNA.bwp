                                    sqlStatement="UPDATE RECOVERY&#xa;  SET DESCR_ERR_LAVORAZIONE = ?&#xa;  WHERE ID_ESEC_PROC = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="DESCR_ERR_LAVORAZIONE"/>

                                    <PreparedParameters
