            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns2:CW_BUS_MESSAGE" name="EndLog-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:Input" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="Application" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/Application" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LoggerLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerLevel" type="xsd:string"/>
        <bpws:variable name="ErrorLoggerLevel"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Log/ErrorLoggerLevel" type="xsd:string"/>
        <bpws:variable name="jdbcTimeOut" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Timeout/jdbcTimeOut" type="xsd:int"/>
        <bpws:variable name="Contatore" type="xsd:integer">
            <bpws:from>
                <bpws:literal>1</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="ConteggioStringhe" type="xsd:integer">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Check" type="xsd:string">
            <bpws:from>
                <bpws:literal>False</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="FaultLog-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:ErrorLinkHandlerFaultData"
            name="_error_ParseXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:Send_Cessazione_Ullna_repeating"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns9:AccumulatedOutput" name="Accumulate" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName1" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:FaultDetail" name="FaultDetails" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="CatchAllLog-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName1" tibex:xpdlId="479e42aa-6fae-49bb-8fe0-bcb718002df1">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="CallProcessToExit" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogCatchAll-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'parseAllineaConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="CatchAllLog-input"
                                name="CatchAllLog"
                                tibex:xpdlId="540be570-dc8a-440c-8458-0f067e5dcabd"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToExit"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogCatchAll-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'parseAllineaConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit" tibex:xpdlId="6048ba5b-d738-495b-a967-9ee1b8c6466d">
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToExit"/>
                            </bpws:targets>
                        </bpws:exit>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CountToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToEndLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="EndLogToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="293cd5d6-3fde-4b00-8f43-e02c2af0c063"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery.accumulate/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Send_Cessazione_Ullna_repeating>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Accumulate/tns1:Send_Cessazione_Ullna_Accumulate)>0&quot;>&lt;xsl:for-each select=&quot;$Accumulate/tns1:Send_Cessazione_Ullna_Accumulate&quot;>&lt;tns:Send_Cessazione>&lt;tns:ID_ESEC_PROC>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:ID_ESEC_PROC&quot;/>&lt;/tns:ID_ESEC_PROC>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transactione_date>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:Transactione_date&quot;/>&lt;/tns:Transactione_date>&lt;xsl:for-each select=&quot;tns1:Send_Cessazione_Ullna/tns1:SERVIZIO&quot;>&lt;tns:SERVIZIO>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;tns1:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;tns:DescOLO>&lt;xsl:value-of select=&quot;tns1:DescOLO&quot;/>&lt;/tns:DescOLO>&lt;xsl:for-each select=&quot;tns1:SLU&quot;>&lt;tns:SLU>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;tns1:Servizio&quot;/>&lt;/tns:Servizio>&lt;xsl:for-each select=&quot;tns1:CESSAZIONE&quot;>&lt;tns:CESSAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tns1:CODICEORDINEOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns1:CODICE_ORDINE_TI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;tns1:CONTRATTO&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;tns1:RISORSA&quot;/>&lt;/tns:RISORSA>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;tns1:ID_NOW&quot;/>&lt;/tns:ID_NOW>&lt;tns:DAC>&lt;xsl:value-of select=&quot;tns1:DAC&quot;/>&lt;/tns:DAC>&lt;tns:DEC>&lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&lt;/tns:DEC>&lt;/tns:CESSAZIONE>&lt;/xsl:for-each>&lt;/tns:SLU>&lt;/xsl:for-each>&lt;/tns:SERVIZIO>&lt;/xsl:for-each>&lt;/tns:Send_Cessazione>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Send_Cessazione_Ullna_repeating>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="e9e24a3b-65fe-4acd-9714-0317e31e50f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EndLogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery.accumulate/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Send_Cessazione_Ullna_repeating>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Accumulate/tns1:Send_Cessazione_Ullna_Accumulate)>0&quot;>&lt;xsl:for-each select=&quot;$Accumulate/tns1:Send_Cessazione_Ullna_Accumulate&quot;>&lt;tns:Send_Cessazione>&lt;tns:ID_ESEC_PROC>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:ID_ESEC_PROC&quot;/>&lt;/tns:ID_ESEC_PROC>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transactione_date>&lt;xsl:value-of select=&quot;tns1:Send_Cessazione_Ullna/tns1:Transactione_date&quot;/>&lt;/tns:Transactione_date>&lt;xsl:for-each select=&quot;tns1:Send_Cessazione_Ullna/tns1:SERVIZIO&quot;>&lt;tns:SERVIZIO>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;tns1:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;tns:DescOLO>&lt;xsl:value-of select=&quot;tns1:DescOLO&quot;/>&lt;/tns:DescOLO>&lt;xsl:for-each select=&quot;tns1:SLU&quot;>&lt;tns:SLU>&lt;tns:Servizio>&lt;xsl:value-of select=&quot;tns1:Servizio&quot;/>&lt;/tns:Servizio>&lt;xsl:for-each select=&quot;tns1:CESSAZIONE&quot;>&lt;tns:CESSAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tns1:CODICEORDINEOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns1:CODICE_ORDINE_TI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;tns1:CONTRATTO&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;tns1:RISORSA&quot;/>&lt;/tns:RISORSA>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;tns1:ID_NOW&quot;/>&lt;/tns:ID_NOW>&lt;tns:DAC>&lt;xsl:value-of select=&quot;tns1:DAC&quot;/>&lt;/tns:DAC>&lt;tns:DEC>&lt;xsl:value-of select=&quot;tns1:DEC&quot;/>&lt;/tns:DEC>&lt;/tns:CESSAZIONE>&lt;/xsl:for-each>&lt;/tns:SLU>&lt;/xsl:for-each>&lt;/tns:SERVIZIO>&lt;/xsl:for-each>&lt;/tns:Send_Cessazione>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Send_Cessazione_Ullna_repeating>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'parseAllineaConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Start)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="StartLog-input" name="StartLog"
                    tibex:xpdlId="8e23d08e-60ed-4ff1-8cb5-de254eb27b76"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Application&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;$Application&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'parseAllineaConsistenza'&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($Start)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="count($Start/ns5:Input_subProcess)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="ConteggioStringhe" name="Count"
                    outputVariable="ConteggioStringhe"
                    tibex:xpdlId="c53c3b36-798f-471e-8c8e-df072d794981" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartLogToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CountToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="count($Start/ns5:Input_subProcess)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ConteggioStringhe" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Application&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;$Application&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'parseAllineaConsistenza'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Start)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="EndLog-input" name="EndLog"
