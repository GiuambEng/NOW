ansaction_id>&lt;xsl:value-of select=&quot;tns1:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transaction_date>&lt;xsl:value-of select=&quot;tns1:Transaction_date&quot;/>&lt;/tns:Transaction_date>&lt;/tns:REQUEST>&lt;/xsl:for-each>&lt;tns:ID_ESEC_PROC>&lt;xsl:value-of select=&quot;tns1:ID_ESEC_PROC&quot;/>&lt;/tns:ID_ESEC_PROC>&lt;/tns:Now_SendCessazioneDati_Input>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Now_SendCessazioneDati_repeating>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
