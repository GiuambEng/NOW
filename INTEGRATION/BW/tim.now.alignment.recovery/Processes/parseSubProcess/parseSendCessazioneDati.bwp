                                <bpws:link name="JDBCUpdateToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToTransformXml" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign2ToGroupEnd" tibex:linkType="SUCCESS"/>
