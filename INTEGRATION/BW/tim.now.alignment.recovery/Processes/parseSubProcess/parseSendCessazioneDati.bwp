            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="7b31236d-db02-449c-8032-53e27804c5de">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess2"/>
