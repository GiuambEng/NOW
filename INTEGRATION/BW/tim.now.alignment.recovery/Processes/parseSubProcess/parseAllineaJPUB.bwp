            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery.accumulate/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REQUEST_Repeating>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate/tns1:AggiornamentoMassivoAnagrafiche_Accumulate)>0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$Accumulate/tns1:AggiornamentoMassivoAnagrafiche_Accumulate&quot;>&#xa;                        &lt;tns:JPUB>&#xa;                            &lt;tns:ID_ESEC_PROC>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:ID_ESEC_PROC&quot;/>&#xa;                            &lt;/tns:ID_ESEC_PROC>&#xa;                            &lt;tns:TIPO_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:TIPO_RICHIESTA&quot;/>&#xa;                            &lt;/tns:TIPO_RICHIESTA>&#xa;                            &lt;tns:Passo>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:Passo&quot;/>&#xa;                            &lt;/tns:Passo>&#xa;                        &lt;/tns:JPUB>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:REQUEST_Repeating>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="62ae5c8e-7a24-48e6-a7ea-f5ce7772ebe7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery.accumulate/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REQUEST_Repeating>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Accumulate/tns1:AggiornamentoMassivoAnagrafiche_Accumulate)>0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$Accumulate/tns1:AggiornamentoMassivoAnagrafiche_Accumulate&quot;>&#xa;                        &lt;tns:JPUB>&#xa;                            &lt;tns:ID_ESEC_PROC>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:ID_ESEC_PROC&quot;/>&#xa;                            &lt;/tns:ID_ESEC_PROC>&#xa;                            &lt;tns:TIPO_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:TIPO_RICHIESTA&quot;/>&#xa;                            &lt;/tns:TIPO_RICHIESTA>&#xa;                            &lt;tns:Passo>&#xa;                                &lt;xsl:value-of select=&quot;tns1:AggiornamentoMassivoAnagrafiche/tns1:Passo&quot;/>&#xa;                            &lt;/tns:Passo>&#xa;                        &lt;/tns:JPUB>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:REQUEST_Repeating>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
