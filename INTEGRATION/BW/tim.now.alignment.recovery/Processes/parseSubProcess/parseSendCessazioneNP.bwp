                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="7a4c26d3-c14b-4886-89e0-ebeb9fea4338" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenzaNP_recovery/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AllineamentoConsistenzaNP.recovery.accumulate/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Send_Cessazione_NP_Repeating>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Accumulate/tns1:Accumulate_Send_Cessazione_NP_Request)>0&quot;>&lt;xsl:for-each select=&quot;$Accumulate/tns1:Accumulate_Send_Cessazione_NP_Request&quot;>&lt;tns:Send_Cessazione_NP_Request_input>&lt;tns:Transaction_id>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:Transaction_id&quot;/>&lt;/tns:Transaction_id>&lt;tns:Transactione_date>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:Transactione_date&quot;/>&lt;/tns:Transactione_date>&lt;tns:SERVIZIO>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:SERVIZIO/tns1:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;tns:DescOLO>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:SERVIZIO/tns1:DescOLO&quot;/>&lt;/tns:DescOLO>&lt;tns:NPG>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:SERVIZIO/tns1:NPG/tns1:CRMWS_SERVICE&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;tns:CESSAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:SERVIZIO/tns1:NPG/tns1:CESSAZIONE/tns1:CODICEORDINEOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns1:Accumulate_Send_Cessazione_NP_Request_Input/tns1:SERVIZIO/tns1:NPG/tns1:CESSAZIONE/tns1:CODICE_ORDINE_TI&quot;/>&lt;/tns:CODICE_ORDINE_T