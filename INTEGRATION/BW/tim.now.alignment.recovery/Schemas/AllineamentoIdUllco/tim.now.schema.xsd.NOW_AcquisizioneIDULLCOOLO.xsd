<?xml version="1.0" encoding="UTF-8"?>

<schema xmlns="http://www.w3.org/2001/XMLSchema"
	 xmlns:tns="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO.recovery/"
	 targetNamespace="http://www.tim.com/NOW/xsd/AcquisizioneIDULCOOLO.recovery/"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<element name="Now_SendIdullco_Request">
		<complexType>
			<sequence>
				<element name="Transaction_id">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Transaction_date" type="dateTime"/>
				<element name="Sistema_origine">
					<simpleType>
						<restriction base="string">
							<maxLength value="50"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Azione">
					<simpleType>
						<restriction base="string">
							<maxLength value="21"/>
						</restriction>
					</simpleType>
				</element>
				<element name="IDULLCO">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="OPERATORE">
					<simpleType>
						<restriction base="string">
							<maxLength value="3"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CLLI">
					<simpleType>
						<restriction base="string">
							<maxLength value="100"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DATA_CONSEGNA_OLO" type="date"/>
				<element name="DATA_FINE_VALIDITA" type="date" minOccurs="0"/>
				<element name="DATA_INVIO" type="date"/>
				<element name="Nome">
					<simpleType>
						<restriction base="string">
							<maxLength value="255"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DRCP" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="30"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Codice_GAT">
					<simpleType>
						<restriction base="string">
							<maxLength value="6"/>
						</restriction>
					</simpleType>
				</element>
				<element name="Tipo_Colocazione">
					<simpleType>
						<restriction base="string">
							<maxLength value="4"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Now_SendIdullco_repeating">
		<complexType>
			<sequence>
				<element name="Now_SendIdullco" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="ID_ESEC_PROC" type="integer" minOccurs="1"/>
							<element name="Transaction_id">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="Transaction_date" type="dateTime"/>
							<element name="Sistema_origine">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="Azione">
								<simpleType>
									<restriction base="string">
										<maxLength value="21"/>
									</restriction>
								</simpleType>
							</element>
							<element name="IDULLCO">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element name="OPERATORE">
								<simpleType>
									<restriction base="string">
										<maxLength value="3"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CLLI">
								<simpleType>
									<restriction base="string">
										<maxLength value="100"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DATA_CONSEGNA_OLO" type="date"/>
							<element name="DATA_FINE_VALIDITA" type="date" minOccurs="0"/>
							<element name="DATA_INVIO" type="date"/>
							<element name="Nome">
								<simpleType>
									<restriction base="string">
										<maxLength value="255"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DRCP" minOccurs="0">
								<simpleType>
									<restriction base="string">
										<maxLength value="30"/>
									</restriction>
								</simpleType>
							</element>
							<element name="Codice_GAT">
								<simpleType>
									<restriction base="string">
										<maxLength value="6"/>
									</restriction>
								</simpleType>
							</element>
							<element name="Tipo_Colocazione">
								<simpleType>
									<restriction base="string">
										<maxLength value="4"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>