<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"  targetNamespace="http://www.example.org/CodiciProgetto.recovery.accumulate"  xmlns:tns="http://www.example.org/CodiciProgetto.recovery.accumulate"  elementFormDefault="qualified" attributeFormDefault="unqualified">
	<element name="Now_SendCodiciProgetto_Accumulate">
		<complexType>
			<sequence>
				<element name="Now_SendCodiciProgetto" minOccurs="0">
					<complexType>
						<sequence>
							<element name="ID_ESEC_PROC" type="integer"/>
							<element name="Transaction_id" type="string" minOccurs="1"/>
							<element name="Transaction_date" type="dateTime"	minOccurs="1"/>
							<element name="CODICE_PROGETTO" type="string"	minOccurs="1"/>
							<element name="CODE_OPERATORE" type="string"	minOccurs="1"/>
							<element name="DATA_INIZIO_PROV" type="date"	minOccurs="1"/>
							<element name="DATA_FINE_PROV" type="date" minOccurs="1"/>
							<element name="FITTIZIO" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="SI"/>
										<enumeration value="NO"/>
									</restriction>
								</simpleType>
							</element>
							<element name="REPORT" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="SI"/>
										<enumeration value="NO"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>