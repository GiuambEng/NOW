<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/CodiciProgetto.recovery.invoke/" 
elementFormDefault="qualified" 
xmlns="http://www.w3.org/2001/XMLSchema" 
xmlns:tns="http://www.tim.com/NOW/xsd/CodiciProgetto.recovery.invoke/"
attributeFormDefault="unqualified">

    <element name="Now_SendCodiciProgetto_Invoke_Request">
    	<complexType>
    		<sequence>
			<element name="Now_SendCodiciProgetto" minOccurs="0">
					<complexType>
						<sequence>
    			<element name="Transaction_id" type="string" minOccurs="1"></element>
    			<element name="Transaction_date" type="dateTime"
    				minOccurs="1">
    			</element>
    			<element name="CODICE_PROGETTO" type="string"
    				minOccurs="1">
    			</element>
    			<element name="CODE_OPERATORE" type="string"
    				minOccurs="1">
    			</element>
    			<element name="DATA_INIZIO_PROV" type="date"
    				minOccurs="1">
    			</element>
    			<element name="DATA_FINE_PROV" type="date" minOccurs="1">
    			</element>
    			<element name="FITTIZIO" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="SI"></enumeration>
    						<enumeration value="NO"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>

    			<element name="REPORT" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="SI"></enumeration>
    						<enumeration value="NO"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
				</sequence>
    	</complexType>
		</element>
				<element name="IdEsecProc" type="integer" minOccurs="1"/>
    		</sequence>
    	</complexType>
    </element>
    

    <element name="Now_SendCodiciProgetto_Invoke_Response">
    	<complexType>
    		<sequence>
    			<element name="Transaction_id" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="Response_date" type="string" maxOccurs="1" minOccurs="1"></element>
    			<element name="Return_code" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="OK"></enumeration>
    						<enumeration value="KO"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Desc_err" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
  </schema>