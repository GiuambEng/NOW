<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoCodiciProgetto.recovery/"  
elementFormDefault="qualified"  
xmlns="http://www.w3.org/2001/XMLSchema"  
xmlns:tns="http://www.tim.com/NOW/xsd/AggiornamentoCodiciProgetto.recovery/" 
attributeFormDefault="unqualified">
	<element name="Input_NowSendCodiciProgetto">
		<complexType>
			<sequence>
				<element name="Transaction_id" type="string" minOccurs="1"/>
				<element name="Transaction_date" type="dateTime"	minOccurs="1"/>
				<element name="CODICE_PROGETTO" type="string"	minOccurs="1"/>
				<element name="CODE_OPERATORE" type="string"	minOccurs="1"/>
				<element name="DATA_INIZIO_PROV" type="date"	minOccurs="1"/>
				<element name="DATA_FINE_PROV" type="date" minOccurs="1"/>
				<element name="FITTIZIO" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="SI"/>
							<enumeration value="NO"/>
						</restriction>
					</simpleType>
				</element>
				<element name="REPORT" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="SI"/>
							<enumeration value="NO"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Now_CodiciProgetto_repeating">
		<complexType>
			<sequence>
				<element name="Input_NowSendCodiciProgetto" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="ID_ESEC_PROC" type="integer" minOccurs="1"/>
							<element name="Transaction_id" type="string" minOccurs="1"/>
							<element name="Transaction_date" type="dateTime"	minOccurs="1"/>
							<element name="CODICE_PROGETTO" type="string"	minOccurs="1"/>
							<element name="CODE_OPERATORE" type="string"	minOccurs="1"/>
							<element name="DATA_INIZIO_PROV" type="date"	minOccurs="1"/>
							<element name="DATA_FINE_PROV" type="date" minOccurs="1"/>
							<element name="FITTIZIO" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="SI"/>
										<enumeration value="NO"/>
									</restriction>
								</simpleType>
							</element>
							<element name="REPORT" minOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="SI"/>
										<enumeration value="NO"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>