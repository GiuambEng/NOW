<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery/"
 elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AggiornamentoMassiveAnagrafiche.recovery/">

    <element name="REQUEST">
    	<complexType>
    		<sequence>
    			<element name="TIPO_RICHIESTA" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="int">
							<totalDigits value="2">
    					</totalDigits>
							<enumeration value="0">
    					</enumeration>
							<enumeration value="1">
    					</enumeration>
							<enumeration value="2">
    					</enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="Passo" type="integer" minOccurs="1"/>
    		</sequence>    		
    	</complexType>
    	</element>

    <element name="REQUEST_Repeating">
    	<complexType>
    		<sequence>
    			<element name="JPUB" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="ID_ESEC_PROC" type="integer" maxOccurs="1" minOccurs="1"></element>
    						<element name="TIPO_RICHIESTA" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="int">
    									<totalDigits value="2">
    									</totalDigits>
    									<enumeration value="0">
    									</enumeration>
    									<enumeration value="1">
    									</enumeration>
    									<enumeration value="2">
    									</enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Passo" type="integer"
    							minOccurs="1" />    						
    					</sequence>
    				</complexType></element>
    		</sequence>
    	</complexType></element>


</schema>