<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:tns="http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AllineamentoConsistenza.recovery/">
	<xsd:element name="Send_Cessazione_Ullna_Request">

		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Transaction_id">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:maxLength value="50"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Transaction_date" type="xsd:dateTime"/>
				<xsd:element name="SERVIZIO">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CodiceOlo">
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="3"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="DescOlo">
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="3"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="ULLLNA">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="Servizio">
											<xsd:simpleType>
												<xsd:restriction base="xsd:string">
													<xsd:maxLength value="2"/>
													<xsd:enumeration value="01"/>
													<xsd:enumeration value="02"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="CESSAZIONE">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="CODICEORDINEOLO">
														<xsd:simpleType>
															<xsd:restriction base="xsd:string">
																<xsd:maxLength value="11"/>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
													<xsd:element name="CODICE_ORDINE_TI">
														<xsd:simpleType>
															<xsd:restriction base="xsd:string">
																<xsd:maxLength value="31"/>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
													<xsd:element name="CONTRATTO">
														<xsd:simpleType>
															<xsd:restriction base="xsd:string">
																<xsd:maxLength value="15"/>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
													<xsd:element name="RISORSA">
														<xsd:simpleType>
															<xsd:restriction base="xsd:string">
																<xsd:maxLength value="10"/>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
													<xsd:element name="ID_NOW" type="xsd:int"/>
													<xsd:element name="DAC" type="xsd:date"/>
													<xsd:element name="DEC" type="xsd:date"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="Send_Cessazione_Ullna_repeating">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element maxOccurs="unbounded" minOccurs="0" name="Send_Cessazione">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element maxOccurs="1" minOccurs="1" name="ID_ESEC_PROC" type="xsd:integer">
							</xsd:element>
							<xsd:element name="Transaction_id">
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="50"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="Transactione_date" type="xsd:dateTime"/>
							<xsd:element name="SERVIZIO">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="CodiceOlo">
											<xsd:simpleType>
												<xsd:restriction base="xsd:string">
													<xsd:maxLength value="3"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="DescOLO">
											<xsd:simpleType>
												<xsd:restriction base="xsd:string">
													<xsd:maxLength value="3"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="SLU">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="Servizio">
														<xsd:simpleType>
															<xsd:restriction base="xsd:string">
																<xsd:maxLength value="2"/>
																<xsd:enumeration value="01"/>
																<xsd:enumeration value="02">
																</xsd:enumeration>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
													<xsd:element name="CESSAZIONE">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="CODICEORDINEOLO">
																	<xsd:simpleType>
																		<xsd:restriction base="xsd:string">
																			<xsd:maxLength value="11"/>
																		</xsd:restriction>
																	</xsd:simpleType>
																</xsd:element>
																<xsd:element name="CODICE_ORDINE_TI">
																	<xsd:simpleType>
																		<xsd:restriction base="xsd:string">
																			<xsd:maxLength value="31"/>
																		</xsd:restriction>
																	</xsd:simpleType>
																</xsd:element>
																<xsd:element name="CONTRATTO">
																	<xsd:simpleType>
																		<xsd:restriction base="xsd:string">
																			<xsd:maxLength value="15"/>
																		</xsd:restriction>
																	</xsd:simpleType>
																</xsd:element>
																<xsd:element name="RISORSA">
																	<xsd:simpleType>
																		<xsd:restriction base="xsd:string">
																			<xsd:maxLength value="10"/>
																		</xsd:restriction>
																	</xsd:simpleType>
																</xsd:element>
																<xsd:element name="ID_NOW" type="xsd:int"/>
																<xsd:element name="DAC" type="xsd:date"/>
																<xsd:element name="DEC" type="xsd:date"/>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
