<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AcquisizioneIdsluco.recovery.invoke/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AcquisizioneIdsluco.recovery.invoke/">

    <element name="Now_SendIdsluco_Invoke_Request">
    	<complexType>
    		<sequence>
    			<element name="NowSendIdsluco" maxOccurs="1"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Transaction_id" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Transaction_date"
    							maxOccurs="1" minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Sistema_origine"
    							maxOccurs="1" minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="PATROCLO"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Azione" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="I"></enumeration>
    									<enumeration value="V"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="IDSLUCO" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="OPERATORE" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="CLLI" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="DATA_CONSEGNA_OLO"
    							maxOccurs="1" minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="ID_RICHIESTA" type="int"
    							maxOccurs="1" minOccurs="1">
    						</element>
    						<element name="COPPIA_DA" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="COPPIA_A" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="DATA_INVIO" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="TESTARMADIO" maxOccurs="1"
    							minOccurs="1">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="10"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="PROGRESSIVO" type="int"
    							maxOccurs="1" minOccurs="1">
    						</element>
    					</sequence>
    				</complexType>

    			</element>


    			 <element name="id_esec_proc" type="integer" maxOccurs="1" minOccurs="1"/>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Now_SendIdsluco_Invoke_Response">
    	<complexType>
    		<sequence>
    			<element name="Transaction_ID" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="50"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Response_date" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<pattern
    							value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    						</pattern>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Return_Code" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="01"></enumeration>
    						<enumeration value="02"></enumeration>
    						<enumeration value="03"></enumeration>
    						<enumeration value="04"></enumeration>
    						<enumeration value="05"></enumeration>
    						<enumeration value="06"></enumeration>
    						<enumeration value="07"></enumeration>
    						<enumeration value="08"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="Descrizione_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

</schema>