<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/AccumulateAllineamentoIdsluco" xmlns:tns="http://www.example.org/AccumulateAllineamentoIdsluco" elementFormDefault="qualified">

    <element name="Now_SendIdsluco_Accumulate">
    	<complexType>
    		<sequence>
    			<element name="Now_SendIdsluco" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Transaction_id">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Transaction_date">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Sistema_origine">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="PATROCLO"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="Azione">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="I"></enumeration>
    									<enumeration value="V"></enumeration>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="IDSLUCO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="OPERATORE">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="CLLI">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="DATA_CONSEGNA_OLO">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="ID_RICHIESTA" type="int">
    						</element>
    						<element name="COPPIA_DA">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="COPPIA_A">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="DATA_INVIO">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="TESTARMADIO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="10"></maxLength>
    								</restriction>
    							</simpleType>
    						</element>
    						<element name="PROGRESSIVO" type="int"></element>
                            <element name="id_esec_proc" type="integer"/>
                        </sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>