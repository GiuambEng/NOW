<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AcquisizioneIdsluco.recovery/" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AcquisizioneIdsluco.recovery/">

    <element name="NOWSendIDSLUCOolo_input">
    	<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="1" name="Transaction_id">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="Transaction_date">
    							<simpleType>
    								<restriction base="string">
    									<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="Sistema_origine">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="PATROCLO"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="Azione">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="I"/>
    									<enumeration value="V"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="IDSLUCO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="OPERATORE">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="CLLI">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="DATA_CONSEGNA_OLO">
    							<simpleType>
    								<restriction base="string">
    									<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="ID_RICHIESTA" type="int">
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="COPPIA_DA">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="COPPIA_A">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="DATA_INVIO">
    							<simpleType>
    								<restriction base="string">
    									<pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="TESTARMADIO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="10"/>
    								</restriction>
    							</simpleType>
    						</element>
    						<element maxOccurs="1" minOccurs="1" name="PROGRESSIVO" type="int"/>
    					</sequence>
    				</complexType>
    </element>



    <element name="Now_SendIdullco_repeating">
    	<complexType>
    		<sequence>
    			<element name="Now_SendIdsluco" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element 
    							name="Transaction_id">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="50" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="Transaction_date">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="Sistema_origine">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="PATROCLO" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="Azione">
    							<simpleType>
    								<restriction base="string">
    									<enumeration value="I" />
    									<enumeration value="V" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="IDSLUCO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="OPERATORE">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="CLLI">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="100" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="DATA_CONSEGNA_OLO">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="ID_RICHIESTA" type="int">
    						</element>
    						<element 
    							name="COPPIA_DA">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="COPPIA_A">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="3" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="DATA_INVIO">
    							<simpleType>
    								<restriction base="string">
    									<pattern
    										value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d">
    									</pattern>
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="TESTARMADIO">
    							<simpleType>
    								<restriction base="string">
    									<maxLength value="10" />
    								</restriction>
    							</simpleType>
    						</element>
    						<element 
    							name="PROGRESSIVO" type="int" />
    						<element name="id_esec_proc" type="integer"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>
