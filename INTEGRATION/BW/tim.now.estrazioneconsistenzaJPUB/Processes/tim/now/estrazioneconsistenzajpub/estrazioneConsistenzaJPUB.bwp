                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/estrazioneConsistenzaJPUB&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;scrivi_PathFileLocale&quot;/>&lt;xsl:param name=&quot;ReadLocalFile&quot;/>&lt;xsl:param name=&quot;creaStringaFile&quot;/>&lt;xsl:template name=&quot;WriteFileLocal-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;concat($scrivi_PathFileLocale, concat(&amp;quot;NOW&amp;quot;, substring-after($ReadLocalFile/fileInfo/fileName, &amp;quot;JPUB&amp;quot;)))&quot;/>&lt;/fileName>&lt;textContent>&lt;xsl:value-of select=&quot;$creaStringaFile/tns2:recordFile&quot;/>&lt;/textContent>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
