            <bpws:empty name="Check_Correttezza" tibex:xpdlId="f4339d55-8e67-4098-b7ca-cd8cb1167e59">
                <bpws:targets>
                    <bpws:target linkName="Log_DirectoryToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToLog_NoFileCSV">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Check_CorrettezzaToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case(substring-after($Leggi_Directory/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[1], &quot;.&quot;)) = &quot;CSV&quot; and tib:validate-dateTime(&quot;YYYYMMdd&quot;, tib:substring-after-last(substring-before($Leggi_Directory/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[1], &quot;.&quot;), &quot;_&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case(substring-after($Leggi_Directory.SftpDirOutput/tns:File[1], ".")) = "CSV" and tib:validate-dateTime("YYYYMMdd", tib:substring-after-last(substring-before($Leggi_Directory.SftpDirOutput/tns:File[1], "."), "_"))]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:invoke inputVariable="GetFile-input" name="GetFile"
                operation="SftGetJavaCodeOperation"
                outputVariable="GetFile" partnerLink="SFTP_Get"
                portType="ns8:SFTPGetJavaCode" tibex:xpdlId="32af0b9f-3031-4959-b6b8-9eeb60c3d48f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/SFTP_DirJavaCode" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/" xmlns:tns2="http://www.tim.com/NOW/xsd/SFTP_GetJavaCode" version="2.0"&gt;
    &lt;xsl:param name="Leggi_Directory"/&gt;
    &lt;xsl:param name="HOST"/&gt;
    &lt;xsl:param name="USERNAME"/&gt;
    &lt;xsl:param name="PASSWORD"/&gt;
    &lt;xsl:param name="PORT"/&gt;
    &lt;xsl:param name="SOURCEDIRECTORY"/&gt;
    &lt;xsl:param name="deposito_pathFileLocal"/&gt;
    &lt;xsl:template name="GetFile-input" match="/"&gt;
        &lt;tns1:SftGetJavaCodeOperationRequest&gt;
            &lt;SftpGetInput&gt;
                &lt;tns2:SFTP_GetJavaCodeInput&gt;
                    &lt;tns2:RemoteFile&gt;
                        &lt;xsl:value-of select="concat($SOURCEDIRECTORY, $Leggi_Directory/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[1])"/&gt;
                    &lt;/tns2:RemoteFile&gt;
                    &lt;tns2:LocalFile&gt;
                        &lt;xsl:value-of select="concat($deposito_pathFileLocal, $Leggi_Directory/SftpDirOutput/tns:SFTP_DirJavaCodeOutput/tns:File[1])"/&gt;
                    &lt;/tns2:LocalFile&gt;
                    &lt;tns2:credenziali&gt;
                        &lt;tns2:Host&gt;
                            &lt;xsl:value-of select="$HOST"/&gt;
                        &lt;/tns2:Host&gt;
                        &lt;tns2:Port&gt;
                            &lt;xsl:value-of select="$PORT"/&gt;
                        &lt;/tns2:Port&gt;
                        &lt;tns2:Password&gt;
                            &lt;xsl:value-of select="$PASSWORD"/&gt;
                        &lt;/tns2:Password&gt;
                        &lt;tns2:User&gt;
                            &lt;xsl:value-of select="$USERNAME"/&gt;
                        &lt;/tns2:User&gt;
                    &lt;/tns2:credenziali&gt;
                &lt;/tns2:SFTP_GetJavaCodeInput&gt;
            &lt;/SftpGetInput&gt;
        &lt;/tns1:SftGetJavaCodeOperationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPGetJavaCode/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_GetJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Leggi_Directory.SftpDirOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;HOST&quot;/>&#xa;    &lt;xsl:param name=&quot;USERNAME&quot;/>&#xa;    &lt;xsl:param name=&quot;PASSWORD&quot;/>&#xa;    &lt;xsl:param name=&quot;PORT&quot;/>&#xa;    &lt;xsl:param name=&quot;SOURCEDIRECTORY&quot;/>&#xa;    &lt;xsl:param name=&quot;deposito_pathFileLocal&quot;/>&#xa;    &lt;xsl:template name=&quot;GetFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:SFTP_GetJavaCodeInput>&#xa;            &lt;tns2:RemoteFile>&#xa;                &lt;xsl:value-of select=&quot;concat($SOURCEDIRECTORY, $Leggi_Directory.SftpDirOutput/tns:File[1])&quot;/>&#xa;            &lt;/tns2:RemoteFile>&#xa;            &lt;tns2:LocalFile>&#xa;                &lt;xsl:value-of select=&quot;concat($deposito_pathFileLocal, $Leggi_Directory.SftpDirOutput/tns:File[1])&quot;/>&#xa;            &lt;/tns2:LocalFile>&#xa;            &lt;tns2:credenziali>&#xa;                &lt;tns2:Host>&#xa;                    &lt;xsl:value-of select=&quot;$HOST&quot;/>&#xa;                &lt;/tns2:Host>&#xa;                &lt;tns2:Port>&#xa;                    &lt;xsl:value-of select=&quot;$PORT&quot;/>&#xa;                &lt;/tns2:Port>&#xa;                &lt;tns2:Password>&#xa;                    &lt;xsl:value-of select=&quot;$PASSWORD&quot;/>&#xa;                &lt;/tns2:Password>&#xa;                &lt;tns2:User>&#xa;                    &lt;xsl:value-of select=&quot;$USERNAME&quot;/>&#xa;                &lt;/tns2:User>&#xa;            &lt;/tns2:credenziali>&#xa;        &lt;/tns2:SFTP_GetJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
