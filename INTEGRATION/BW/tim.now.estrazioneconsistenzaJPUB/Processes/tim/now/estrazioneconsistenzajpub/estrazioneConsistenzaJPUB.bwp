                                    sqlStatement="SELECT ID_COD_CONTRATTO_PADRE, COD_CONTRATTO, CODFC_OLO_AGCOM&#xd;&#xa;&#x9;FROM CONTRATTO&#xd;&#xa;&#x9;WHERE ID_CONTRATTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

