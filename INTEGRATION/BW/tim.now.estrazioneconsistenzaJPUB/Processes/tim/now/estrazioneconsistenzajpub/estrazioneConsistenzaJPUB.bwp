                portType="ns10:SFTPDirJavaCode" tibex:xpdlId="3e9e18a1-5606-4c98-94ba-e596e0cb5fe3">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SFTPDirJavaCode/" xmlns:tns1="http://www.tim.com/NOW/xsd/SFTP_DirJavaCode" version="2.0"&gt;
    &lt;xsl:param name="HOST"/&gt;
    &lt;xsl:param name="USERNAME"/&gt;
    &lt;xsl:param name="PASSWORD"/&gt;
    &lt;xsl:param name="PORT"/&gt;
    &lt;xsl:param name="SOURCEDIRECTORY"/&gt;
    &lt;xsl:template name="LeggiDirectory-input" match="/"&gt;
        &lt;tns:SftDirJavaCodeOperationRequest&gt;
            &lt;SftpDirInput&gt;
                &lt;tns1:SFTP_DirJavaCodeInput&gt;
                    &lt;tns1:path&gt;
                        &lt;xsl:value-of select="$SOURCEDIRECTORY"/&gt;
                    &lt;/tns1:path&gt;
                    &lt;tns1:credenziali&gt;
                        &lt;tns1:Host&gt;
                            &lt;xsl:value-of select="$HOST"/&gt;
                        &lt;/tns1:Host&gt;
                        &lt;tns1:Port&gt;
                            &lt;xsl:value-of select="$PORT"/&gt;
                        &lt;/tns1:Port&gt;
                        &lt;tns1:Password&gt;
                            &lt;xsl:value-of select="$PASSWORD"/&gt;
                        &lt;/tns1:Password&gt;
                        &lt;tns1:User&gt;
                            &lt;xsl:value-of select="$USERNAME"/&gt;
                        &lt;/tns1:User&gt;
                    &lt;/tns1:credenziali&gt;
                &lt;/tns1:SFTP_DirJavaCodeInput&gt;
            &lt;/SftpDirInput&gt;
        &lt;/tns:SftDirJavaCodeOperationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SFTPDirJavaCode/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;HOST&quot;/>&#xa;    &lt;xsl:param name=&quot;USERNAME&quot;/>&#xa;    &lt;xsl:param name=&quot;PASSWORD&quot;/>&#xa;    &lt;xsl:param name=&quot;PORT&quot;/>&#xa;    &lt;xsl:param name=&quot;SOURCEDIRECTORY&quot;/>&#xa;    &lt;xsl:template name=&quot;LeggiDirectory-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SFTP_DirJavaCodeInput>&#xa;            &lt;tns1:path>&#xa;                &lt;xsl:value-of select=&quot;$SOURCEDIRECTORY&quot;/>&#xa;            &lt;/tns1:path>&#xa;            &lt;tns1:credenziali>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;$PORT&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:Password>&#xa;                    &lt;xsl:value-of select=&quot;$PASSWORD&quot;/>&#xa;                &lt;/tns1:Password>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$USERNAME&quot;/>&#xa;                &lt;/tns1:User>&#xa;            &lt;/tns1:credenziali>&#xa;        &lt;/tns1:SFTP_DirJavaCodeInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
