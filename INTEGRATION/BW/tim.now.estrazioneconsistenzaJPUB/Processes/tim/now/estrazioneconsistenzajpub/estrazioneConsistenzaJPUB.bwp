                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Leggi_Directory.SftpDirOutput/tns:File)]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SFTP_DirJavaCode&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;loggerName&quot;/>&lt;xsl:param name=&quot;logLevel&quot;/>&lt;xsl:param name=&quot;Leggi_Directory&quot;/>&lt;xsl:template name=&quot;Log_Directory-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.estrazioneconsistenzaJPUB.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;estrazioneConsistenza&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Files presenti nella directory: &amp;quot;, string(count($Leggi_Directory/SftpDirOutput/tns1:SFTP_DirJavaCodeOutput/tns1:File)))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$loggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$logLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_Directory-input"
                    name="Log_Directory"
                    tibex:xpdlId="ae4bce98-2333-428b-a9a2-8279aa37f309"
