<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/estrazioneConsistenzaJPUB" 
	xmlns:tns="http://www.tim.com/estrazioneConsistenzaJPUB" elementFormDefault="qualified">
	<element name="WLRHostingInput">
		<complexType>
			<sequence>
				<element name="InputFile" type="tns:Input_Type" minOccurs="1" maxOccurs="unbounded" />
			</sequence>
		</complexType>
	</element>
	<element name="WLRHostingOutput">
		<complexType>
			<sequence>
				<element name="OutputFile" type="tns:Output_Type" minOccurs="0" maxOccurs="1" />
			</sequence>
		</complexType>
	</element>
	<element name="StringaPerFileOutput">
		<complexType>
			<sequence>
				<element minOccurs="1" maxOccurs="1" type="string" name="recordFile" />
			</sequence>
		</complexType>
	</element>
	
	<complexType name="Input_Type">
		<sequence>
			<element minOccurs="1" maxOccurs="1" name="IdRis" >
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="IdOrdCrmws" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeContrOspitante" >
				<simpleType>
					<restriction base="string">
						<maxLength value="6"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="DataDro" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="DataDes" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodiceOrdineIsp" >
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeGestOspitante">
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>
	
	<complexType name="Output_Type">
		<sequence>
			<element minOccurs="1" maxOccurs="1" name="IdRis" >
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="IdOrdCrmws" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeContrOspitante" >
				<simpleType>
					<restriction base="string">
						<maxLength value="6"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="DataDro" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="DataDes" >
				<simpleType>
					<restriction base="string">
						<maxLength value="20"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodiceOrdineIsp" >
				<simpleType>
					<restriction base="string">
						<maxLength value="30"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeGestOspitante">
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeContrOspitato" >
				<simpleType>
					<restriction base="string">
						<maxLength value="6"/>
					</restriction>
				</simpleType>
			</element>
			<element minOccurs="1" maxOccurs="1" name="CodeGestOspitato" >
				<simpleType>
					<restriction base="string">
						<maxLength value="3"/>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>	
</schema>