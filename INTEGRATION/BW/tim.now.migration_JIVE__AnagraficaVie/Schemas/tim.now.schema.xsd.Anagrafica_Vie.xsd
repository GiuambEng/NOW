<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Anagrafica_Vie" elementFormDefault="qualified"    attributeFormDefault="unqualified"  xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Anagrafica_Vie">


    <element name="AnagraficaVie_Dettaglio">
    	<complexType>
    		<sequence>
    			<element name="CODICE_STRADA" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_COMUNE" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="11"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
                <element name="ISTAT_COMUNE" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="int"><totalDigits value="6"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
                <element name="ISTAT_PROVINCIA" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="int"><totalDigits value="3"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
                <element name="COD_VIA" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="int"><totalDigits value="9"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
                <element name="DESC_VIA" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="80"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COD_PART_TOP" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="int"><totalDigits value="5"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_MULTICAP" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="Y"></enumeration>
    						<enumeration value="N"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CAP" maxOccurs="1" minOccurs="1">
    			<simpleType>
    				<restriction base="int"><totalDigits value="13"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
    			<element name="FLAG_UFF" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="Y"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="CODICE_DISTRETTO" maxOccurs="1" minOccurs="0">
    			<simpleType>
    				<restriction base="int"><totalDigits value="10"></totalDigits>
    				</restriction>
    				</simpleType>
    			</element>
                <element name="FLAG_OPERAZIONE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="1"></maxLength>
    						<enumeration value="I"></enumeration>
    						<enumeration value="U"></enumeration>
    						<enumeration value="Z"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
            </sequence>
    	</complexType></element>

    <element name="AnagraficaVie">
    	<complexType>
    		<sequence>
    			<element ref="tns:AnagraficaVie_Dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>