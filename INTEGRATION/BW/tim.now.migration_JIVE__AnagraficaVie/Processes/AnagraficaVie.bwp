                            <bpws:sources>
                                <bpws:source linkName="EmptyToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(($index = (($Invoke_Counter/part1/ns20:contaRecord_Output/ns20:NumeroRecord)) div $PassoCiclo +1)) and (count($Noval_Detail_Last/Rows/tns2:AnagraficaVie_Dettaglio_Noval)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($index = (($Invoke_Counter.part1/ns20:NumeroRecord)) div $PassoCiclo +1)) and (count($Noval_Detail_Last/Rows/tns2:AnagraficaVie_Dettaglio_Noval)=0)]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="EmptyToIns">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneJiveVie&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.Anagrafica_Vie_Noval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;PassoCiclo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Invoke_ProcessLogger&quot;/>&lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&lt;xsl:param name=&quot;Noval_Details&quot;/>&lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:InfoFile>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$ReadFile/tns:FullName&quot;/>&lt;/ns:NomeFile>&lt;ns:StartRecord>&lt;xsl:value-of select=&quot;($index - 1) * $PassoCiclo + 2&quot;/>&lt;/ns:StartRecord>&lt;ns:Passo>&lt;xsl:value-of select=&quot;$PassoCiclo&quot;/>&lt;/ns:Passo>&lt;/ns:InfoFile>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&lt;ns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&lt;/ns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE))&quot;/>&lt;/ns:ID_FILE>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaVie_Dettaglio_Noval)=0&quot;>&lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaVie_Dettaglio_Noval&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($PassoCiclo * ($index -1)) + position())&quot;/>&lt;ns:CODICE_STRADA>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&lt;/ns:CODICE_STRADA>&lt;ns:COD_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&lt;/ns:COD_COMUNE>&lt;ns:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&lt;/ns:ISTAT_COMUNE>&lt;ns:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&lt;/ns:ISTAT_PROVINCIA>&lt;ns:COD_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&lt;/ns:COD_VIA>&lt;ns:DESC_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&lt;/ns:DESC_VIA>&lt;ns:COD_PART_TOP>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&lt;/ns:COD_PART_TOP>&lt;ns:FLAG_MULTICAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&lt;/ns:FLAG_MULTICAP>&lt;ns:CAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&lt;/ns:CAP>&lt;ns:FLAG_UFF>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&lt;/ns:FLAG_UFF>&lt;ns:CODICE_DISTRETTO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&lt;/ns:CODICE_DISTRETTO>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_STRADA, tns1:COD_COMUNE,tns1:ISTAT_COMUNE,tns1:ISTAT_PROVINCIA,tns1:COD_VIA,tns1:DESC_VIA,tns1:COD_PART_TOP,tns1:FLAG_MULTICAP,tns1:CAP,tns1:FLAG_UFF,tns1:CODICE_DISTRETTO,tns1:FLAG_OPERAZIONE )&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AnagraficaVie_Dettaglio_Noval&quot;>&lt;ns:Record>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($PassoCiclo * ($index -1)) + position())&quot;/>&lt;ns:CODICE_STRADA>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&lt;/ns:CODICE_STRADA>&lt;ns:COD_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&lt;/ns:COD_COMUNE>&lt;ns:ISTAT_COMUNE>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&lt;/ns:ISTAT_COMUNE>&lt;ns:ISTAT_PROVINCIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&lt;/ns:ISTAT_PROVINCIA>&lt;ns:COD_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&lt;/ns:COD_VIA>&lt;ns:DESC_VIA>&lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&lt;/ns:DESC_VIA>&lt;ns:COD_PART_TOP>&lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&lt;/ns:COD_PART_TOP>&lt;ns:FLAG_MULTICAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&lt;/ns:FLAG_MULTICAP>&lt;ns:CAP>&lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&lt;/ns:CAP>&lt;ns:FLAG_UFF>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&lt;/ns:FLAG_UFF>&lt;ns:CODICE_DISTRETTO>&lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&lt;/ns:CODICE_DISTRETTO>&lt;ns:FLAG_OPERAZIONE>&lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&lt;/ns:FLAG_OPERAZIONE>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;xsl:if test=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;$Invoke_ProcessLogger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE&quot;/>&lt;/ns:ID_FILE>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;concat(tns1:CODICE_STRADA, tns1:COD_COMUNE,tns1:ISTAT_COMUNE,tns1:ISTAT_PROVINCIA,tns1:COD_VIA,tns1:DESC_VIA,tns1:COD_PART_TOP,tns1:FLAG_MULTICAP,tns1:CAP,tns1:FLAG_UFF,tns1:CODICE_DISTRETTO,tns1:FLAG_OPERAZIONE )&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/ns:Record>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="Ins-input" name="Ins"
                                tibex:xpdlId="0d38514d-6d1b-453d-89c9-6aca2bb23edb"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="EmptyToIns"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; xmlns:ns=&quot;www.tim.now.subProcessMigrzioneJiveVie&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.org/tim.now.schema.xsd.Anagrafica_Vie_Noval&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke_ProcessLogger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:param name=&quot;PassoCiclo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Detail_Last&quot;/>&#xa;    &lt;xsl:param name=&quot;Noval_Details&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELAB_RECORD&quot;/>&#xa;    &lt;xsl:template name=&quot;Ins-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:InfoFile>&#xa;                &lt;ns:NomeFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFile/tns:FullName&quot;/>&#xa;                &lt;/ns:NomeFile>&#xa;                &lt;ns:StartRecord>&#xa;                    &lt;xsl:value-of select=&quot;($index - 1) * $PassoCiclo + 2&quot;/>&#xa;                &lt;/ns:StartRecord>&#xa;                &lt;ns:Passo>&#xa;                    &lt;xsl:value-of select=&quot;$PassoCiclo&quot;/>&#xa;                &lt;/ns:Passo>&#xa;            &lt;/ns:InfoFile>&#xa;            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;>&#xa;                &lt;ns:COD_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:COD_PROCSO_FILE&quot;/>&#xa;                &lt;/ns:COD_PROCSO_FILE>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE))&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_ESEC_PROCSO_FILE))&quot;/>&#xa;            &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Noval_Detail_Last/Rows/tns1:AnagraficaVie_Dettaglio_Noval)=0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Details/Rows/tns1:AnagraficaVie_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:Record>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($PassoCiclo * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:CODICE_STRADA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&#xa;                            &lt;/ns:CODICE_STRADA>&#xa;                            &lt;ns:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&#xa;                            &lt;/ns:COD_COMUNE>&#xa;                            &lt;ns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/ns:ISTAT_COMUNE>&#xa;                            &lt;ns:ISTAT_PROVINCIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROVINCIA>&#xa;                            &lt;ns:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&#xa;                            &lt;/ns:COD_VIA>&#xa;                            &lt;ns:DESC_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&#xa;                            &lt;/ns:DESC_VIA>&#xa;                            &lt;ns:COD_PART_TOP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&#xa;                            &lt;/ns:COD_PART_TOP>&#xa;                            &lt;ns:FLAG_MULTICAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&#xa;                            &lt;/ns:FLAG_MULTICAP>&#xa;                            &lt;ns:CAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&#xa;                            &lt;/ns:CAP>&#xa;                            &lt;ns:FLAG_UFF>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&#xa;                            &lt;/ns:FLAG_UFF>&#xa;                            &lt;ns:CODICE_DISTRETTO>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:CODICE_DISTRETTO>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:CODICE_STRADA, tns1:COD_COMUNE,tns1:ISTAT_COMUNE,tns1:ISTAT_PROVINCIA,tns1:COD_VIA,tns1:DESC_VIA,tns1:COD_PART_TOP,tns1:FLAG_MULTICAP,tns1:CAP,tns1:FLAG_UFF,tns1:CODICE_DISTRETTO,tns1:FLAG_OPERAZIONE )&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                        &lt;/ns:Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$Noval_Detail_Last/Rows/tns1:AnagraficaVie_Dettaglio_Noval&quot;>&#xa;                        &lt;ns:Record>&#xa;                            &lt;xsl:variable name=&quot;var1&quot; select=&quot;(($PassoCiclo * ($index -1)) + position())&quot;/>&#xa;                            &lt;ns:CODICE_STRADA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_STRADA)&quot;/>&#xa;                            &lt;/ns:CODICE_STRADA>&#xa;                            &lt;ns:COD_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_COMUNE)&quot;/>&#xa;                            &lt;/ns:COD_COMUNE>&#xa;                            &lt;ns:ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_COMUNE)&quot;/>&#xa;                            &lt;/ns:ISTAT_COMUNE>&#xa;                            &lt;ns:ISTAT_PROVINCIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:ISTAT_PROVINCIA)&quot;/>&#xa;                            &lt;/ns:ISTAT_PROVINCIA>&#xa;                            &lt;ns:COD_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_VIA)&quot;/>&#xa;                            &lt;/ns:COD_VIA>&#xa;                            &lt;ns:DESC_VIA>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:DESC_VIA)&quot;/>&#xa;                            &lt;/ns:DESC_VIA>&#xa;                            &lt;ns:COD_PART_TOP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:COD_PART_TOP)&quot;/>&#xa;                            &lt;/ns:COD_PART_TOP>&#xa;                            &lt;ns:FLAG_MULTICAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_MULTICAP)&quot;/>&#xa;                            &lt;/ns:FLAG_MULTICAP>&#xa;                            &lt;ns:CAP>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CAP)&quot;/>&#xa;                            &lt;/ns:CAP>&#xa;                            &lt;ns:FLAG_UFF>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_UFF)&quot;/>&#xa;                            &lt;/ns:FLAG_UFF>&#xa;                            &lt;ns:CODICE_DISTRETTO>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:CODICE_DISTRETTO)&quot;/>&#xa;                            &lt;/ns:CODICE_DISTRETTO>&#xa;                            &lt;ns:FLAG_OPERAZIONE>&#xa;                                &lt;xsl:value-of select=&quot;tib:trim(tns1:FLAG_OPERAZIONE)&quot;/>&#xa;                            &lt;/ns:FLAG_OPERAZIONE>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var1&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;>&#xa;                                &lt;ns:ID_FILE>&#xa;                                    &lt;xsl:value-of select=&quot;$Invoke_ProcessLogger.part1/ns1:Esito/ns1:ID_FILE&quot;/>&#xa;                                &lt;/ns:ID_FILE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($OK_ELAB_RECORD))&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;ns:CONTENUTO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;concat(tns1:CODICE_STRADA, tns1:COD_COMUNE,tns1:ISTAT_COMUNE,tns1:ISTAT_PROVINCIA,tns1:COD_VIA,tns1:DESC_VIA,tns1:COD_PART_TOP,tns1:FLAG_MULTICAP,tns1:CAP,tns1:FLAG_UFF,tns1:CODICE_DISTRETTO,tns1:FLAG_OPERAZIONE )&quot;/>&#xa;                            &lt;/ns:CONTENUTO_RECD>&#xa;                        &lt;/ns:Record>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess spawn="true"
