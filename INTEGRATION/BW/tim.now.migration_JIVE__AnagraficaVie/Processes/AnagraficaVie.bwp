            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($PathFileScarto, $NomeFileScarto_AnagraficaVie,format-date(current-date(), &quot;[Y0001][M01][D01]&quot;), $Estensione)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Var_PathFileScarto"
                    name="RenameAnagraficaVie"
                    outputVariable="Var_PathFileScarto"
                    tibex:xpdlId="fa4c78be-eb5f-4111-b254-1443973bcc71" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToRenameAnagraficaVie"/>
                    </bpws:targets>
                    <bpws:sources>
