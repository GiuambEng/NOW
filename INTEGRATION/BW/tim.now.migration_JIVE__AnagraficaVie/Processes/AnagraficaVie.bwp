                        <bpws:empty name="Empty" tibex:xpdlId="3e67c328-8a38-49f4-866b-2b38abadabb5">
                            <bpws:targets>
                                <bpws:target linkName="Noval_DetailsToInvoke"/>
                                <bpws:target linkName="Noval_Detail_LastToEmpty"/>
