                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+64f52050-1a7a-474d-8cda-a695a2bdbe1c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;www.tim.now.schema.InsertTargetUtentiOLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Insert&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;xsl:for-each select=&quot;$Insert&quot;>&lt;tns1:jdbcUpdateActivityInput>&lt;COD_PROFILO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COD_PROFILO)&quot;>&lt;xsl:value-of select=&quot;ns:COD_PROFILO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_PROFILO>&lt;COGNOME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:COGNOME)&quot;>&lt;xsl:value-of select=&quot;ns:COGNOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COGNOME>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;xsd:date(ns:DATAFI_VALID)&quot;/>&lt;/DATAFI_VALID>&lt;DATAINZ_VALID>&lt;xsl:value-of select=&quot;xsd:date(ns:DATAINZ_VALID)&quot;/>&lt;/DATAINZ_VALID>&lt;FLAG_DISABL>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:FLAG_DISABL)&quot;>&lt;xsl:value-of select=&quot;ns:FLAG_DISABL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/FLAG_DISABL>&lt;TIPO_UTENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:IDTPLG_UTENTE)&quot;>&lt;xsl:value-of select=&quot;ns:IDTPLG_UTENTE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPO_UTENTE>&lt;INDIRIZZO_EMAIL xsi:nil=&quot;true&quot;/>&lt;MATRICOLA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:MATRICOLA)&quot;>&lt;xsl:value-of select=&quot;ns:MATRICOLA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/MATRICOLA>&lt;NOME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:NOME)&quot;>&lt;xsl:value-of select=&quot;ns:NOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME>&lt;TIMSTP_ULTIMO_ACCS>&lt;xsl:value-of select=&quot;xsd:dateTime(ns:TIMSTP_ULTIMO_ACCS)&quot;/>&lt;/TIMSTP_ULTIMO_ACCS>&lt;USER_ALIAS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:USER_ALIAS)&quot;>&lt;xsl:value-of select=&quot;ns:USER_ALIAS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/USER_ALIAS>&lt;USERID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:USERID)&quot;>&lt;xsl:value-of select=&quot;ns:USERID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/USERID>&lt;/tns1:jdbcUpdateActivityInput>&lt;/xsl:for-each>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO UTENTE (COD_PROFILO, COGNOME, DATAFI_VALID,&#xa;  DATAINZ_VALID, FLAG_DISABL, IDTPLG_UTENTE,&#xa;  INDIRIZZO_EMAIL, MATRICOLA, NOME, TIMSTP_ULTIMO_ACCS, USER_ALIAS,&#xa;  USERID)&#xa;  VALUES (?, ?, ?, ?, ?, (SELECT IDTPLG_UTENTE FROM TIPOLG_UTENTE WHERE TIPO_UTENTE=?),&#xa;    ?, ?, ?, ?, ?, ?)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROFILO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COGNOME"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_DISABL"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_UTENTE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="INDIRIZZO_EMAIL"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="MATRICOLA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME"/>

                                    <PreparedParameters
                                    DataType="93"
