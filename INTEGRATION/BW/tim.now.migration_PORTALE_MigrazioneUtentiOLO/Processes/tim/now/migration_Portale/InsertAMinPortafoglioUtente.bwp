            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Var_Staging&quot; match=&quot;/&quot;>&lt;Staging>&lt;xsl:for-each select=&quot;$Accumulate/Insert&quot;>&lt;Insert>&lt;xsl:if test=&quot;NUMERO_RECD&quot;>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;NUMERO_RECD&quot;/>&lt;/NUMERO_RECD>&lt;/xsl:if>&lt;xsl:if test=&quot;DESCR_ERRORE&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;DESCR_ERRORE&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;STATO_ELAB&quot;>&lt;STATO_ELAB>&lt;xsl:value-of select=&quot;STATO_ELAB&quot;/>&lt;/STATO_ELAB>&lt;/xsl:if>&lt;xsl:if test=&quot;ID_FILE&quot;>&lt;ID_FILE>&lt;xsl:value-of select=&quot;ID_FILE&quot;/>&lt;/ID_FILE>&lt;/xsl:if>&lt;xsl:if test=&quot;Tipolog_Operazione&quot;>&lt;Tipolog_Operazione>&lt;xsl:value-of select=&quot;Tipolog_Operazione&quot;/>&lt;/Tipolog_Operazione>&lt;/xsl:if>&lt;/Insert>&lt;/xsl:for-each>&lt;/Staging>&lt;/xsl:template>&lt;/xsl:stylesheet>"
