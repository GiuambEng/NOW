                                    DataTypeDisplayValue="VARCHAR" ParameterName="USER_ALIAS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USERID"/>
                                    </value>
                                    </properties>
                                </activityConfig>
                            </bwext:BWActivity>
