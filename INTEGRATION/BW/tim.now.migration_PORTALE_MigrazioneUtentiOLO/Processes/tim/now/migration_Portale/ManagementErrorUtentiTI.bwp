                                    sqlStatement="INSERT INTO UTENTE (COD_PROFILO, COGNOME, DATAFI_VALID,&#xa;  DATAINZ_VALID, FLAG_DISABL, FUNZIONE_AZIENDALE, IDTPLG_UTENTE,&#xa;  INDIRIZZO_EMAIL,  NOME, TIMSTP_ULTIMO_ACCS, USER_ALIAS,&#xa;  USERID)&#xa;  VALUES (?, ?, ?, ?, ?, ?, (SELECT IDTPLG_UTENTE FROM TIPOLG_UTENTE WHERE TIPO_UTENTE=?),?, ?, ?, ?, ?)"
