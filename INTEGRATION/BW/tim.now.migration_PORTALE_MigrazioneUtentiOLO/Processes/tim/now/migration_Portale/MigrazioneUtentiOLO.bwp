                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MigrazioneUtentiOLO_Noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Dettaglio_Noval_Ultimi&quot;/>&lt;xsl:param name=&quot;Dettaglio_Noval&quot;/>&lt;xsl:param name=&quot;Passo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;OK_ELABORAZIONE_FILE&quot;/>&lt;xsl:param name=&quot;Logger&quot;/>&lt;xsl:param name=&quot;Contenuto&quot;/>&lt;xsl:template name=&quot;Var_Insert_Staging2&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Dettaglio_Noval_Ultimi/Rows/tns:MigrazioneUtentiOLO_dettaglio)=0&quot;>&lt;ns:root>&lt;xsl:for-each select=&quot;$Dettaglio_Noval/Rows/tns:MigrazioneUtentiOLO_dettaglio&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:tipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:tipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COGNOME&quot;>&lt;ns:COGNOME>&lt;xsl:value-of select=&quot;tns:COGNOME&quot;/>&lt;/ns:COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:COMPANY_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DISABILITATO&quot;>&lt;ns:DISABL>&lt;xsl:value-of select=&quot;tns:DISABILITATO&quot;/>&lt;/ns:DISABL>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELABORAZIONE_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;tns:MATRICOLA&quot;>&lt;ns:MATRICOLA>&lt;xsl:value-of select=&quot;tns:MATRICOLA&quot;/>&lt;/ns:MATRICOLA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;tns:NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var&quot;/>&lt;/ns:NUMERO_RECD>&lt;xsl:if test=&quot;tns:PROFILO_UTENTI_TI&quot;>&lt;ns:PROFILO_UTENTI_TI>&lt;xsl:value-of select=&quot;tns:PROFILO_UTENTI_TI&quot;/>&lt;/ns:PROFILO_UTENTI_TI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO152&quot;>&lt;ns:PROFILO152>&lt;xsl:value-of select=&quot;tns:PROFILO152&quot;/>&lt;/ns:PROFILO152>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns:USER_ALIAS&quot;>&lt;ns:USER_ALIAS>&lt;xsl:value-of select=&quot;tns:USER_ALIAS&quot;/>&lt;/ns:USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ID_UNICO&quot;>&lt;ns:USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:USER_ID_UNICO&quot;/>&lt;/ns:USER_ID_UNICO>&lt;/xsl:if>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Logger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE)&quot;/>&lt;/ns:ID_FILE>&lt;xsl:if test=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/ns:root>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:root>&lt;xsl:for-each select=&quot;$Dettaglio_Noval_Ultimi/Rows/tns:MigrazioneUtentiOLO_dettaglio&quot;>&lt;ns:Input>&lt;xsl:variable name=&quot;var1&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&lt;xsl:if test=&quot;tns:Tipo_record&quot;>&lt;ns:tipoRecord>&lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&lt;/ns:tipoRecord>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COGNOME&quot;>&lt;ns:COGNOME>&lt;xsl:value-of select=&quot;tns:COGNOME&quot;/>&lt;/ns:COGNOME>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&lt;ns:COMPANY_CODE>&lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&lt;/ns:COMPANY_CODE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DISABILITATO&quot;>&lt;ns:DISABL>&lt;xsl:value-of select=&quot;tns:DISABILITATO&quot;/>&lt;/ns:DISABL>&lt;/xsl:if>&lt;ns:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;$OK_ELABORAZIONE_FILE&quot;/>&lt;/ns:ID_STATO_ELAB_STAG>&lt;xsl:if test=&quot;tns:MATRICOLA&quot;>&lt;ns:MATRICOLA>&lt;xsl:value-of select=&quot;tns:MATRICOLA&quot;/>&lt;/ns:MATRICOLA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:NOME&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;tns:NOME&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;ns:NUMERO_RECD>&lt;xsl:value-of select=&quot;$var1&quot;/>&lt;/ns:NUMERO_RECD>&lt;xsl:if test=&quot;tns:PROFILO_UTENTI_TI&quot;>&lt;ns:PROFILO_UTENTI_TI>&lt;xsl:value-of select=&quot;tns:PROFILO_UTENTI_TI&quot;/>&lt;/ns:PROFILO_UTENTI_TI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PROFILO152&quot;>&lt;ns:PROFILO152>&lt;xsl:value-of select=&quot;tns:PROFILO152&quot;/>&lt;/ns:PROFILO152>&lt;/xsl:if>&lt;ns:TMSP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INSMTO>&lt;xsl:if test=&quot;tns:USER_ALIAS&quot;>&lt;ns:USER_ALIAS>&lt;xsl:value-of select=&quot;tns:USER_ALIAS&quot;/>&lt;/ns:USER_ALIAS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:USER_ID_UNICO&quot;>&lt;ns:USER_ID_UNICO>&lt;xsl:value-of select=&quot;tns:USER_ID_UNICO&quot;/>&lt;/ns:USER_ID_UNICO>&lt;/xsl:if>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:decimal($Logger/part1/ns1:Output/ns1:Esito/ns1:ID_FILE)&quot;/>&lt;/ns:ID_FILE>&lt;xsl:if test=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;>&lt;ns:CONTENUTO_RECD>&lt;xsl:value-of select=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var1]/ns2:Valore&quot;/>&lt;/ns:CONTENUTO_RECD>&lt;/xsl:if>&lt;/ns:Input>&lt;/xsl:for-each>&lt;/ns:root>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
