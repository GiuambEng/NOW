                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.SelectCountRecord&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger&quot;/>&lt;xsl:param name=&quot;SelectCount&quot;/>&lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&lt;xsl:template name=&quot;Var_InsertProc&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:FileProcessato>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;ns:ESITO>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/ns:ESITO>&lt;ns:ID_ESEC_PROCSO_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&lt;/ns:ID_ESEC_PROCSO_FILE>&lt;ns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ns:ID_FILE>&lt;ns:TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_CHIUSURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;&amp;quot;INPUT&amp;quot;&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;ns:ID_FILE_PROCSTO_INPUT>&lt;xsl:value-of select=&quot;xsd:integer($Logger/part1/ns:Output/ns:Esito/ns:ID_FILE)&quot;/>&lt;/ns:ID_FILE_PROCSTO_INPUT>&lt;ns:QT_RECD_KO>&lt;xsl:value-of select=&quot;xsd:integer($SelectCount/ns1:NumeroRecordKO)&quot;/>&lt;/ns:QT