D_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE"&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO"&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:Esecu