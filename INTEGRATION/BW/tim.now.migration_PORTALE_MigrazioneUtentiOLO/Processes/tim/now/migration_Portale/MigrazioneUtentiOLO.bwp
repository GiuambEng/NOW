                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/log/InsertInizialeStaging/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MigrazioneUtentiOLO_Noval&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns2=&quot;www.tim.now.migration.OutputContenutoRecd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Logger.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio_Noval_Ultimi&quot;/>&#xa;    &lt;xsl:param name=&quot;Dettaglio_Noval&quot;/>&#xa;    &lt;xsl:param name=&quot;Passo&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OK_ELABORAZIONE_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Contenuto&quot;/>&#xa;    &lt;xsl:template name=&quot;Var_Insert_Staging2&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($Dettaglio_Noval_Ultimi/Rows/tns:MigrazioneUtentiOLO_dettaglio)=0&quot;>&#xa;                &lt;ns:root>&#xa;                    &lt;xsl:for-each select=&quot;$Dettaglio_Noval/Rows/tns:MigrazioneUtentiOLO_dettaglio&quot;>&#xa;                        &lt;ns:Input>&#xa;                            &lt;xsl:variable name=&quot;var&quot; select=&quot;(($Passo * ($index -1)) + position())&quot;/>&#xa;                            &lt;xsl:if test=&quot;tns:Tipo_record&quot;>&#xa;                                &lt;ns:tipoRecord>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Tipo_record&quot;/>&#xa;                                &lt;/ns:tipoRecord>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:COGNOME&quot;>&#xa;                                &lt;ns:COGNOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns:COGNOME&quot;/>&#xa;                                &lt;/ns:COGNOME>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:COMPANY_CODE&quot;>&#xa;                                &lt;ns:COMPANY_CODE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:COMPANY_CODE&quot;/>&#xa;                                &lt;/ns:COMPANY_CODE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DISABILITATO&quot;>&#xa;                                &lt;ns:DISABL>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DISABILITATO&quot;/>&#xa;                                &lt;/ns:DISABL>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_STATO_ELAB_STAG>&#xa;                                &lt;xsl:value-of select=&quot;$OK_ELABORAZIONE_FILE&quot;/>&#xa;                            &lt;/ns:ID_STATO_ELAB_STAG>&#xa;                            &lt;xsl:if test=&quot;tns:MATRICOLA&quot;>&#xa;                                &lt;ns:MATRICOLA>&#xa;                                    &lt;xsl:value-of select=&quot;tns:MATRICOLA&quot;/>&#xa;                                &lt;/ns:MATRICOLA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:NOME&quot;>&#xa;                                &lt;ns:NOME>&#xa;                                    &lt;xsl:value-of select=&quot;tns:NOME&quot;/>&#xa;                                &lt;/ns:NOME>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:NUMERO_RECD>&#xa;                                &lt;xsl:value-of select=&quot;$var&quot;/>&#xa;                            &lt;/ns:NUMERO_RECD>&#xa;                            &lt;xsl:if test=&quot;tns:PROFILO_UTENTI_TI&quot;>&#xa;                                &lt;ns:PROFILO_UTENTI_TI>&#xa;                                    &lt;xsl:value-of select=&quot;tns:PROFILO_UTENTI_TI&quot;/>&#xa;                                &lt;/ns:PROFILO_UTENTI_TI>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:PROFILO152&quot;>&#xa;                                &lt;ns:PROFILO152>&#xa;                                    &lt;xsl:value-of select=&quot;tns:PROFILO152&quot;/>&#xa;                                &lt;/ns:PROFILO152>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:TMSP_INSMTO>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/ns:TMSP_INSMTO>&#xa;                            &lt;xsl:if test=&quot;tns:USER_ALIAS&quot;>&#xa;                                &lt;ns:USER_ALIAS>&#xa;                                    &lt;xsl:value-of select=&quot;tns:USER_ALIAS&quot;/>&#xa;                                &lt;/ns:USER_ALIAS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:USER_ID_UNICO&quot;>&#xa;                                &lt;ns:USER_ID_UNICO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:USER_ID_UNICO&quot;/>&#xa;                                &lt;/ns:USER_ID_UNICO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;ns:ID_FILE>&#xa;                                &lt;xsl:value-of select=&quot;xsd:decimal($Logger.part1/ns1:Esito/ns1:ID_FILE)&quot;/>&#xa;                            &lt;/ns:ID_FILE>&#xa;                            &lt;xsl:if test=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;>&#xa;                                &lt;ns:CONTENUTO_RECD>&#xa;                                    &lt;xsl:value-of select=&quot;$Contenuto/ns2:Output_ContenutoRecord[ns2:Posizione=$var]/ns2:Valore&quot;/>&#xa;                                &l