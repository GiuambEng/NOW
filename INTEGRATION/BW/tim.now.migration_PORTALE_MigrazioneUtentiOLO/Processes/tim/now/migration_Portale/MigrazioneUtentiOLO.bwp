>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:MATRICOLA)&quot;>&lt;xsl:value-of select=&quot;ns:MATRICOLA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/MATRICOLA>&lt;NOME>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:NOME)&quot;>&lt;xsl:value-of select=&quot;ns:NOME&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME>&lt;NUMERO_RECD>&lt;xsl:value-of select=&quot;xsd:decimal(ns:NUMERO_RECD)&quot;/>&lt;/NUMERO_RECD>&lt;PROFILO_UTENTI_TI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:PROFILO_UTENTI_TI)&quot;>&lt;xsl:value-of select=&quot;ns:PROFILO_UTENTI_TI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO_UTENTI_TI>&lt;PROFILO152>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:PROFILO152)&quot;>&lt;xsl:value-of select=&quot;ns:PROFILO152&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO152>&lt;TMSP_INSMTO>&lt;xsl:value-of select=&quot;xsd:dateTime(ns:TMSP_INSMTO)&quot;/>&lt;/TMSP_INSMTO>&lt;USER_ALIAS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:USER_ALIAS)&quot;>&lt;xsl:value-of select=&quot;ns:USER_ALIAS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/USER_ALIAS>&lt;USER_ID_UNICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:USER_ID_UNICO)&quot;>&lt;xsl:value-of select=&quot;ns:USER_ID_UNICO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/USER_ID_UNICO>&lt;CONTENUTO_RECD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:CONTENUTO_RECD)&quot;>&lt;xsl:value-of select=&quot;ns:CONTENUTO_RECD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CONTENUTO_RECD>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO STAG_ANAG_UTENTE (COGNOME, COMPANY_CODE, DISABL,&#xa;  ID_FILE_PROCSTO_INPUT, ID_STATO_ELAB_STAG, MATRICOLA, NOME,&#xa;  NUMERO_RECD, PROFILO_UTENTI_TI, PROFILO152, TMSP_INSMTO, USER_ALIAS,&#xa;  USER_ID_UNICO, CONTENUTO_RECD, TIPOLG_OPERAZIONE)&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, RTRIM(?, CHR(10) || CHR(13)),&#xa;    'I')"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COGNOME"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COMPANY_CODE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISABL"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="MATRICOLA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="NUMERO_RECD"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO_UTENTI_TI"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROFILO152"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TMSP_INSMTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USER_ALIAS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USER_ID_UNICO"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_RECD"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
