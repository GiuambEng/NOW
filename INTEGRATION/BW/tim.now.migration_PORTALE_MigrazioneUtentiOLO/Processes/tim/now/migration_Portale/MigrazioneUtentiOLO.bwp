                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/FileTappo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Id_interfeccia&quot;/>&lt;xsl:param name=&quot;Id_tipolog_file&quot;/>&lt;xsl:param name=&quot;ID_PROCSO_FILE&quot;/>&lt;xsl:param name=&quot;FindFile&quot;/>&lt;xsl:template name=&quot;Var_InsertProc&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:ProcFile>&lt;ns:ID_PROCSO_FILE>&lt;xsl:value-of select=&quot;$ID_PROCSO_FILE&quot;/>&lt;/ns:ID_PROCSO_FILE>&lt;/ns:ProcFile>&lt;ns:FileProcessato>&lt;xsl:if test=&quot;$FindFile/tns:LastModified&quot;>&lt;ns:DATA_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:LastModified&quot;/>&lt;/ns:DATA_FILE>&lt;/xsl:if>&lt;ns:DESCR_STATO_FILE>&lt;xsl:value-of select=&quot;&amp;quot;APERTO&amp;quot;&quot;/>&lt;/ns:DESCR_STATO_FILE>&lt;ns:ID_INTRFC>&lt;xsl:value-of select=&quot;xsd:integer($Id_interfeccia)&quot;/>&lt;/ns:ID_INTRFC>&lt;ns:IDTPLG_FILE>&lt;xsl:value-of select=&quot;xsd:integer($Id_tipolog_file)&quot;/>&lt;/ns:IDTPLG_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FileName&quot;>&lt;ns:NOME_FILE>&lt;xsl:value-of select=&quot;$FindFile/tns:FileName&quot;/>&lt;/ns:NOME_FILE>&lt;/xsl:if>&lt;ns:TIMSTP_APERTURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_APERTURA_FILE>&lt;ns:VERSO_DEL_FILE>&lt;xsl:value-of select=&quot;&amp;quot;INPUT&amp;quot;&quot;/>&lt;/ns:VERSO_DEL_FILE>&lt;/ns:FileProcessato>&lt;ns:FileProcessatoInput>&lt;ns:DATA_ARRIVO>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/ns:DATA_ARRIVO>&lt;ns:DIMENSIONE_FILE>&lt;xsl:value-of select=&quot;xsd:integer($FindFile/tns:Size)&quot;/>&lt;/ns:DIMENSIONE_FILE>&lt;/ns:FileProcessatoInput>&lt;ns:EsecuzioneFile>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/ns:EsecuzioneFile>&lt;ns:ContenutoFile>&lt;ns:ID_CONTENUTO_FILE>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/ns:ID_CONTENUTO_FILE>&lt;xsl:if test=&quot;$FindFile/tns:FullName&quot;>&lt;ns:FullName>&lt;xsl:value-of select=&quot;$FindFile/tns:FullName&quot;/>&lt;/ns:FullName>&lt;/xsl:if>&lt;/ns:ContenutoFile>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Var_InsertProc" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="Logger-input" name="Logger"
                operation="Insert" outputVariable="Logger"
                partnerLink="Logger" portType="ns24:ProcessLog" tibex:xpdlId="73adbf6c-b859-469c-91c5-8ce7c7e0c953">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" version="2.0"&gt;&lt;xsl:param name="Var_InsertProc"/&gt;&lt;xsl:template name="Logger-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:TipologiaProcesso"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:TipologiaOperazione"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:COD_OLO"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:COD_OLO"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE"&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE"/&gt;&lt;/ns:DATA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ESITO"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ESITO"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:IDTPLG_FILE"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE"&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:NOME_FILE"/&gt;&lt;/ns:NOME_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_APERTURA_FILE"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:TIMSTP_CHIUSURA_FILE"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE"&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessato/ns:VERSO_DEL_FILE"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessato&gt;&lt;ns:FileProcessatoInput&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO"&gt;&lt;ns:DATA_ARRIVO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:DATA_ARRIVO"/&gt;&lt;/ns:DATA_ARRIVO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:DIMENSIONE_FILE"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"&gt;&lt;ns:ID_CAUS_SCARTO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_CAUS_SCARTO"/&gt;&lt;/ns:ID_CAUS_SCARTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"&gt;&lt;ns:ID_FILE_PROCSTO_INPUT&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:ID_FILE_PROCSTO_INPUT"/&gt;&lt;/ns:ID_FILE_PROCSTO_INPUT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"&gt;&lt;ns:QT_RECD_KO&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_KO"/&gt;&lt;/ns:QT_RECD_KO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"&gt;&lt;ns:QT_RECD_OK&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_OK"/&gt;&lt;/ns:QT_RECD_OK&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:FileProcessatoInput/ns:QT_RECD_TOTALI"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;/xsl:if&gt;&lt;/ns:FileProcessatoInput&gt;&lt;ns:EsecuzioneFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_ESEC_PROCSO_FILE"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:ID_PROCSO_FILE"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:STATO_ESEC"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_FINE_ELAB"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:EsecuzioneFile/ns:TMSP_INIZIO_ELAB"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/xsl:if&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:ContenutoFile&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"&gt;&lt;ns:ID_CONTENUTO_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:ID_CONTENUTO_FILE"/&gt;&lt;/ns:ID_CONTENUTO_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE"&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:ID_FILE"/&gt;&lt;/ns:ID_FILE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Var_InsertProc/ns:ContenutoFile/ns:FullName"&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$Var_InsertProc/ns:ContenutoFile/ns:FullName"/&gt;&lt;/ns:FullName&gt;&lt;/xsl:if&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Var_InsertProc&quot;/>&#xa;    &lt;xsl:template name=&quot;Logger-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:TipologiaProcesso&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:TipologiaOperazione&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:ProcFile/ns:ID_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:COD_OLO&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:COD_OLO&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE&quot;>&#xa;                    &lt;ns:DATA_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:DATA_FILE&quot;/>&#xa;                    &lt;/ns:DATA_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;>&#xa;                    &lt;ns:DESCR_STATO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:DESCR_STATO_FILE&quot;/>&#xa;                    &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ESITO&quot;>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ESITO&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;>&#xa;                    &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_FILE&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_FILE&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC&quot;>&#xa;                    &lt;ns:ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$Var_InsertProc/ns:FileProcessato/ns:ID_INTRFC&quot;/>&#xa;                    &lt;/ns:ID_INTRFC>&#xa;                &lt;/xsl:if>&#xa;       