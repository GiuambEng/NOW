<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.tim.com/NOW/xsd/MigrazioneUtentiTI" xmlns:tns="http://www.tim.com/NOW/xsd/MigrazioneUtentiTI" elementFormDefault="qualified">





    <element name="MigrazioneUtentiTI">
    	<complexType>
    		<sequence>
    			<element ref="tns:MigrazioneUtentiTI_dettaglio" maxOccurs="unbounded" minOccurs="0"></element>
    		</sequence>
    	</complexType></element>
    <element name="MigrazioneUtentiTI_dettaglio">
    	<complexType>
    		<sequence>
    			<element name="Tipo_record" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<enumeration value="2"></enumeration>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="USER_ID_UNICO" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NOME" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="COGNOME" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="USER_ALIAS" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="DIS_FLAG" maxOccurs="1" minOccurs="1">
    			<simpleType>
						<restriction base="int">
							<totalDigits value="1" />
							<enumeration value="0"></enumeration>
							<enumeration value="1"></enumeration>
						</restriction>
					</simpleType>  			
    			</element>
    			<element name="FUNZIONE" maxOccurs="1" minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="PROFILO152" maxOccurs="1"
    				minOccurs="1">
    				<simpleType>
    					<restriction base="string">
    						<maxLength value="100"></maxLength>
    					</restriction>
    				</simpleType>
    			</element>
    		</sequence>
    	</complexType></element>
</schema>