<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/getTokenNGOP" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/getTokenNGOP">
	<element name="Response" type="tns:Response_type"/>
	<complexType name="Response_type">
		<sequence>
			<element name="access_token" type="string" minOccurs="0" nillable="true"/>
			<element name="token_type" type="string" minOccurs="0" nillable="true"/>
			<element name="expires_in" type="string" minOccurs="0" nillable="true"/>
			<element name="errors" type="tns:errors_type" minOccurs="0" nillable="true"/>
		</sequence>
	</complexType>
	<complexType name="errors_type">
		<sequence>
			<element name="ID" type="string" minOccurs="0" nillable="true"/>
			<element name="message" type="string" minOccurs="0" nillable="true"/>
		</sequence>
	</complexType>
</schema>