            xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/restinvoke+021647fd-04f2-4aa3-b329-fff9c202e4ba+RestInvokeInput" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
