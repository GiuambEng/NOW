<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:jms="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/" xmlns:ns0="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:ns01="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="NotificaDTUPortType" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/">
  <wsdl:import location="../../Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd" namespace="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/"/>
  <wsdl:import location="../../../tim.now.shared_library/Schemas/CommonSchema/SOAPHeader_v1.1.xsd" namespace="http://telecomitalia.it/SOA/SOAP/SOAPHeader"/>
  <wsdl:message name="NotificaInput">
    <wsdl:part element="ns0:EVENTO_NOTIFICA" name="NotificaInput"/>
    <wsdl:part element="ns01:Header" name="header"/>
  </wsdl:message>
  <wsdl:message name="AckInput">
    <wsdl:part element="ns0:ACK_COMUNICAZIONE" name="AckInput"/>
    <wsdl:part element="ns01:Header" name="header"/>
  </wsdl:message>
  <wsdl:portType name="NotificaDTUPortType">
    <wsdl:operation name="InvioNotifica">
      <wsdl:input message="ns:NotificaInput" name="NotificaInput"/>
    </wsdl:operation>
    <wsdl:operation name="InvioAck">
      <wsdl:input message="ns:AckInput" name="AckInput"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="DTUNotification_SOAPService" type="ns:NotificaDTUPortType">
    <soap:binding style="document" transport="http://www.tibco.com/namespaces/ws/2004/soap/binding/JMS"/>
    <jms:binding messageFormat="text"/>
    <wsdl:operation name="InvioNotifica">
      <soap:operation soapAction="InvioNotifica" style="document"/>
      <wsdl:input>
        <soap:body parts="NotificaInput" use="literal"/>
        <soap:header message="ns:NotificaInput" part="header" use="literal"/>
      </wsdl:input>
    </wsdl:operation>
    <wsdl:operation name="InvioAck">
      <soap:operation soapAction="InvioAck" style="document"/>
      <wsdl:input>
        <soap:body parts="AckInput" use="literal"/>
        <soap:header message="ns:AckInput" part="header" use="literal"/>
      </wsdl:input>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="NotificaDTUPortType">
    <wsdl:port binding="ns:DTUNotification_SOAPService" name="NotificaDTUPortTypeSOAP">     
	<soap:address location="jms:jndi:TIM.OP.DEV.NOW.NTF_DTU?targetService=NotificaDTUPortType"/>
      <jms:connectionFactory>SSLQueueConnectionFactory</jms:connectionFactory>
      <jms:targetAddress destination="queue">TIM.OP.SVIL.NOW.NTF_DTU</jms:targetAddress>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>