                                    <bpws:source linkName="AssignResponceVCNumToLogGestVCNumOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd2&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSGestVCNum.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;SearchFileNameVCNum&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlVCNum&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseGestVCNum&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($SearchFileNameVCNum/Record) > 0&quot;>&#xa;                &lt;ns:RESPONSE>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGestVCNum.REQUEST/ns1:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:RESPONSE_DATE>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:RESPONSE_DATE>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXmlVCNum/ns:ESITO&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                    &lt;ns:CODICE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXmlVCNum/ns:CODICE_CAUSALE&quot;/>&#xa;                    &lt;/ns:CODICE_CAUSALE>&#xa;                    &lt;xsl:if test=&quot;$ParseXmlVCNum/ns:DESCRIZIONE_CAUSALE&quot;>&#xa;                        &lt;ns:DESCRIZIONE_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXmlVCNum/ns:DESCRIZIONE_CAUSALE&quot;/>&#xa;                        &lt;/ns:DESCRIZIONE_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXmlVCNum/ns:ESITO_VP_KIT&quot;/>&#xa;                &lt;/ns:RESPONSE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:RESPONSE>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:RESPONSE_DATE>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:RESPONSE_DATE>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                    &lt;ns:CODICE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                    &lt;/ns:CODICE_CAUSALE>&#xa;                    &lt;ns:DESCRIZIONE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;'MANCATA CONFIGURAZIONE STUB CRMWS'&quot;/>&#xa;                    &lt;/ns:DESCRIZIONE_CAUSALE>&#xa;                &lt;/ns:RESPONSE>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ResponseGestVCNum" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
