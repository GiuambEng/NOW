                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="FLAG_NP" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="RETURN_CODE"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="DESCRIZIONE_ERRORE"
                                    nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <xs:schema elementFormDefault="qualified"
