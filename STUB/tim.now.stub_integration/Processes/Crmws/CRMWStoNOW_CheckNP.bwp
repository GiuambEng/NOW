                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+95427933-a460-4b5d-a587-7796f901c04a+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+95427933-a460-4b5d-a587-7796f901c04a+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="DN" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="STATO_RISORSA"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
