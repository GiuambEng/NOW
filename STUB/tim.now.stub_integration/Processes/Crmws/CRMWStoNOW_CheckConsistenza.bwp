                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1460641967114" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2" xmlns:ns1="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="CRMWSCheckConsistenzaIn"/&gt;&lt;xsl:param name="JDBCQueryNew"/&gt;&lt;xsl:template name="CRMWSCheckConsistenzaOutNEW-input" match="/"&gt;&lt;tns:Response&gt;&lt;RESPONSE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($JDBCQueryNew/Record) &gt; 0"&gt;&lt;ns:HEADER&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:TRANSACTION_ID"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:TRANSACTION_DATE&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:TRANSACTION_DATE"/&gt;&lt;/ns:TRANSACTION_DATE&gt;&lt;ns:SISTEMA_ORIGINE&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:SISTEMA_ORIGINE"/&gt;&lt;/ns:SISTEMA_ORIGINE&gt;&lt;ns:RESPONSE&gt;&lt;xsl:if test="$JDBCQueryNew/Record[1]/STATO_RISORSA"&gt;&lt;ns:STATO_RISORSA&gt;&lt;xsl:value-of select="$JDBCQueryNew/Record[1]/STATO_RISORSA"/&gt;&lt;/ns:STATO_RISORSA&gt;&lt;/xsl:if&gt;&lt;ns:DATA_ATTIVAZZIONE&gt;&lt;xsl:value-of select="tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_ATTIVAZIONE) "/&gt;&lt;/ns:DATA_ATTIVAZZIONE&gt;&lt;ns:DATA_CESSAZIONE&gt;&lt;xsl:value-of select="tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_CESSAZIONE)"/&gt;&lt;/ns:DATA_CESSAZIONE&gt;&lt;ns:DATA_VARIAZIONE&gt;&lt;xsl:value-of select="tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_VARIAZIONE)"/&gt;&lt;/ns:DATA_VARIAZIONE&gt;&lt;xsl:if test="$JDBCQueryNew/Record[1]/CODICE_OLO_RIS"&gt;&lt;ns:CODICE_OLO_RIS&gt;&lt;xsl:value-of select="$JDBCQueryNew/Record[1]/CODICE_OLO_RIS"/&gt;&lt;/ns:CODICE_OLO_RIS&gt;&lt;/xsl:if&gt;&lt;ns:RETURN_CODE&gt;&lt;xsl:value-of select="$JDBCQueryNew/Record[1]/RETURN_CODE"/&gt;&lt;/ns:RETURN_CODE&gt;&lt;xsl:if test="$JDBCQueryNew/Record[1]/DESCRIZIONE_ERRORE"&gt;&lt;ns:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$JDBCQueryNew/Record[1]/DESCRIZIONE_ERRORE"/&gt;&lt;/ns:DESCRIZIONE_ERRORE&gt;&lt;/xsl:if&gt;&lt;/ns:RESPONSE&gt;&lt;/ns:HEADER&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:HEADER&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:TRANSACTION_ID"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;ns:TRANSACTION_DATE&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:TRANSACTION_DATE"/&gt;&lt;/ns:TRANSACTION_DATE&gt;&lt;ns:SISTEMA_ORIGINE&gt;&lt;xsl:value-of select="$CRMWSCheckConsistenzaIn/REQUEST/ns1:HEADER/ns1:SISTEMA_ORIGINE"/&gt;&lt;/ns:SISTEMA_ORIGINE&gt;&lt;ns:RESPONSE&gt;&lt;ns:RETURN_CODE&gt;&lt;xsl:value-of select="'99'"/&gt;&lt;/ns:RETURN_CODE&gt;&lt;ns:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="'Errore'"/&gt;&lt;/ns:DESCRIZIONE_ERRORE&gt;&lt;/ns:RESPONSE&gt;&lt;/ns:HEADER&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/RESPONSE&gt;&lt;/tns:Response&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1460641967114&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd2&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenza/Schema.xsd&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckConsistenzaIn.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryNew&quot;/>&#xa;    &lt;xsl:template name=&quot;CRMWSCheckConsistenzaOutNEW-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCQueryNew/Record) > 0&quot;>&#xa;                &lt;ns:HEADER>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:TRANSACTION_DATE>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:TRANSACTION_DATE&quot;/>&#xa;                    &lt;/ns:TRANSACTION_DATE>&#xa;                    &lt;ns:SISTEMA_ORIGINE>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:SISTEMA_ORIGINE&quot;/>&#xa;                    &lt;/ns:SISTEMA_ORIGINE>&#xa;                    &lt;ns:RESPONSE>&#xa;                        &lt;xsl:if test=&quot;$JDBCQueryNew/Record[1]/STATO_RISORSA&quot;>&#xa;                            &lt;ns:STATO_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryNew/Record[1]/STATO_RISORSA&quot;/>&#xa;                            &lt;/ns:STATO_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns:DATA_ATTIVAZZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_ATTIVAZIONE) &quot;/>&#xa;                        &lt;/ns:DATA_ATTIVAZZIONE>&#xa;                        &lt;ns:DATA_CESSAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_CESSAZIONE)&quot;/>&#xa;                        &lt;/ns:DATA_CESSAZIONE>&#xa;                        &lt;ns:DATA_VARIAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-dateTime('yyyy-MM-dd HH:mm:ss', $JDBCQueryNew/Record[1]/DATA_VARIAZIONE)&quot;/>&#xa;                        &lt;/ns:DATA_VARIAZIONE>&#xa;                        &lt;xsl:if test=&quot;$JDBCQueryNew/Record[1]/CODICE_OLO_RIS&quot;>&#xa;                            &lt;ns:CODICE_OLO_RIS>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryNew/Record[1]/CODICE_OLO_RIS&quot;/>&#xa;                            &lt;/ns:CODICE_OLO_RIS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQueryNew/Record[1]/RETURN_CODE&quot;/>&#xa;                        &lt;/ns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$JDBCQueryNew/Record[1]/DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;ns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQueryNew/Record[1]/DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns:RESPONSE>&#xa;                &lt;/ns:HEADER>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:HEADER>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:TRANSACTION_DATE>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:TRANSACTION_DATE&quot;/>&#xa;                    &lt;/ns:TRANSACTION_DATE>&#xa;                    &lt;ns:SISTEMA_ORIGINE>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckConsistenzaIn.REQUEST/ns1:SISTEMA_ORIGINE&quot;/>&#xa;                    &lt;/ns:SISTEMA_ORIGINE>&#xa;                    &lt;ns:RESPONSE>&#xa;                        &lt;ns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                        &lt;/ns:RETURN_CODE>&#xa;                        &lt;ns:DESCRIZIONE_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;'Errore'&quot;/>&#xa;                        &lt;/ns:DESCRIZIONE_ERRORE>&#xa;                    &lt;/ns:RESPONSE>&#xa;                &lt;/ns:HEADER>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
