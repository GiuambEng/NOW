                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckRaccoltaVLANIn.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;SearchFileName&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:template name=&quot;ResponseCheckRaccoltaVLAN&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($SearchFileName/Record) > 0&quot;>&#xa;                &lt;ns:RESPONSE>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLANIn.REQUEST/ns1:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:RESPONSE_DATE>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:RESPONSE_DATE>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns:ESITO&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/ns:CODICE_CAUSALE&quot;>&#xa;                        &lt;ns:CODICE_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/ns:CODICE_CAUSALE&quot;/>&#xa;                        &lt;/ns:CODICE_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ParseXml/ns:DESCRIZIONE_CAUSALE&quot;>&#xa;                        &lt;ns:DESCRIZIONE_CAUSALE>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/ns:DESCRIZIONE_CAUSALE&quot;/>&#xa;                        &lt;/ns:DESCRIZIONE_CAUSALE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/ns:INFO_VLAN&quot;/>&#xa;                &lt;/ns:RESPONSE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:RESPONSE>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLANIn.REQUEST/ns1:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                    &lt;ns:RESPONSE_DATE>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:RESPONSE_DATE>&#xa;                    &lt;ns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/ns:ESITO>&#xa;                    &lt;ns:CODICE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;'99'&quot;/>&#xa;                    &lt;/ns:CODICE_CAUSALE>&#xa;                    &lt;ns:DESCRIZIONE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;'MANCATA CONFIGURAZIONE STUB CRMWS'&quot;/>&#xa;                    &lt;/ns:DESCRIZIONE_CAUSALE>&#xa;                &lt;/ns:RESPONSE>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ResponseCheckRaccoltaVLAN" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
