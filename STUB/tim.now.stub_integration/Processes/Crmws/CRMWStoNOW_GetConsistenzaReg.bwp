                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CRMWS_SERVICE"/>
                                    <columnMetadata
                                    columnName="RISORSA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEOLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CRMWS_SERVICE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
