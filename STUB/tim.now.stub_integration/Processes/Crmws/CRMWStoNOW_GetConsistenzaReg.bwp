                            <bpws:reply name="CessazioneULLLNAOut"
                                operation="CessazioneULLLNA"
                                partnerLink="CRMWSGetConsistenzaReg"
                                portType="ns12:PortType"
                                tibex:xpdlId="f5774002-eec6-4b17-95d1-36d1e1484bba" variable="CessazioneULLLNAOut-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetConsistenzaREG/Schema.xsd" xmlns:tns="http://xmlns.example.com/1460476602492" xmlns:ns1="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetConsistenzaREG/Schema.xsd2" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="CessazioneULLLNA"/&gt;
    &lt;xsl:param name="JDBCCessULL"/&gt;
    &lt;xsl:template name="CessazioneULLLNAOutNEW-input" match="/"&gt;
        &lt;tns:Response&gt;
            &lt;RESPONSE&gt;
                &lt;ns1:RESPONSE&gt;
                    &lt;ns1:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="$CessazioneULLLNA/REQUEST/ns:REQUEST_CESSAZIONE_ULLLNA/ns:TRANSACTION_ID"/&gt;
                    &lt;/ns1:TRANSACTION_ID&gt;
                    &lt;ns1:RESPONSE_DATE&gt;
                        &lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, $JDBCCessULL/Record[1]/RESPONSE_DATE)"/&gt;
                    &lt;/ns1:RESPONSE_DATE&gt;
                    &lt;ns1:RETURN_CODE&gt;
                        &lt;xsl:value-of select="$JDBCCessULL/Record[1]/RETURN_CODE"/&gt;
                    &lt;/ns1:RETURN_CODE&gt;
                    &lt;xsl:if test="$JDBCCessULL/Record[1]/DESCRIZIONE_ERRORE"&gt;
