                                    <bpws:source linkName="JDBCAttULLNewToLog">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBCAttULL/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
