                        &lt;/ns1:DESCRIZIONE_ERRORE&gt;
                    &lt;/xsl:if&gt;
                &lt;/ns1:RESPONSE&gt;
            &lt;/RESPONSE&gt;
        &lt;/tns:Response&gt;
    &lt;/xsl:template&gt;
