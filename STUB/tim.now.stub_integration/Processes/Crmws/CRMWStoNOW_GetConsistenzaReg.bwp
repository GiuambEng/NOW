                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RISORSA,CODICEOLO,CRMWS_SERVICE,RESPONSE_DATE,RETURN_CODE,DESCRIZIONE_ERRORE &#xa;FROM STUB_GETCONSISTENZAREG_L2 &#xa;WHERE CODICEOLO = ? AND CRMWS_SERVICE = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

