                    &lt;ns1:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="$AttivazioneULLLNA/REQUEST/ns:REQUEST_ATTIVAZIONE_ULLLNA/ns:TRANSACTION_ID"/&gt;
                    &lt;/ns1:TRANSACTION_ID&gt;
                    &lt;ns1:RESPONSE_DATE&gt;
                        &lt;xsl:value-of select="tib:parse-dateTime(&amp;quot;yyyy-MM-dd HH:mm:ss&amp;quot;, $JDBCAttULL/Record[1]/RESPONSE_DATE)"/&gt;
                    &lt;/ns1:RESPONSE_DATE&gt;
                    &lt;ns1:RETURN_CODE&gt;
                        &lt;xsl:value-of select="$JDBCAttULL/Record[1]/RETURN_CODE"/&gt;
                    &lt;/ns1:RETURN_CODE&gt;
