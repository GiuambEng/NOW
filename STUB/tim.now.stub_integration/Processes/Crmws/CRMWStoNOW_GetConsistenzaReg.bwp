                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCCessULL-input"
                                    name="JDBCCessULL"
                                    outputVariable="JDBCCessULL"
                                    tibex:xpdlId="3157cbd2-20f3-4205-ae5d-af3d1988b116" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogInCessazULLNAToJDBCCessULLNew"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCCessULLNewToLogOutCessazULLNA">
                                    <tibex:DesignExpression>
