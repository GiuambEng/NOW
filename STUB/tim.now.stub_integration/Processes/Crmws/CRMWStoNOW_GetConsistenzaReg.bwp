                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RISORSA,CODICEOLO,CRMWS_SERVICE,RESPONSE_DATE,RETURN_CODE,DESCRIZIONE_ERRORE &#xd;&#xa;FROM STUB_GETCONSISTENZAREG_L2 WHERE CODICEOLO = ? AND CRMWS_SERVICE = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICEOLO"/>

