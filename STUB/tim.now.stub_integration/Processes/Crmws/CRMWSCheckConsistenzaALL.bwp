                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/1480092456756" xmlns:tns1="http://www.example.org/CRMWSCheckConsistenzaALL" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckConsistenzaALL/Schema.xsd2" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="MapRisorsaConsistenza"/&gt;
    &lt;xsl:template name="CRMWSCheckConsistenzaALLOut-input" match="/"&gt;
        &lt;tns:Response&gt;
            &lt;RESPONSE&gt;
                &lt;ns:RESPONSE&gt;
                    &lt;xsl:for-each select="$MapRisorsaConsistenza/tns1:MapRisorsaConsistenza/tns1:Risorsa"&gt;
                        &lt;ns:RISORSE&gt;
                            &lt;ns:RISORSA&gt;
                                &lt;xsl:value-of select="."/&gt;
                            &lt;/ns:RISORSA&gt;
                            &lt;xsl:for-each select="../tns1:Consistenza"&gt;
                                &lt;ns:CONSISTENZA&gt;
                                    &lt;xsl:if test="tns1:CODICE_OLO_RIS"&gt;
                                        &lt;ns:CODICE_OLO_RIS&gt;
                                            &lt;xsl:value-of select="tns1:CODICE_OLO_RIS"/&gt;
                                        &lt;/ns:CODICE_OLO_RIS&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;ns:SERVIZIO&gt;
                                        &lt;xsl:value-of select="tns1:SERVIZIO"/&gt;
                                    &lt;/ns:SERVIZIO&gt;
                                    &lt;xsl:if test="tns1:STATO_RISORSA"&gt;
                                        &lt;ns:STATO_RISORSA&gt;
                                            &lt;xsl:value-of select="tns1:STATO_RISORSA"/&gt;
                                        &lt;/ns:STATO_RISORSA&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(string(tns1:DATA_ATTIVAZIONE))&gt;0"&gt;
                                        &lt;xsl:if test="tns1:DATA_ATTIVAZIONE"&gt;
                                            &lt;ns:DATA_ATTIVAZIONE&gt;
                                                &lt;xsl:value-of select="tns1:DATA_ATTIVAZIONE"/&gt;
                                            &lt;/ns:DATA_ATTIVAZIONE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(string(tns1:DATA_CESSAZIONE))&gt;0"&gt;
                                        &lt;xsl:if test="tns1:DATA_CESSAZIONE"&gt;
                                            &lt;ns:DATA_CESSAZIONE&gt;
                                                &lt;xsl:value-of select="tns1:DATA_CESSAZIONE"/&gt;
                                            &lt;/ns:DATA_CESSAZIONE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;ns:RETURN_CODE&gt;
                                        &lt;xsl:value-of select="&amp;quot;00&amp;quot;"/&gt;
                                    &lt;/ns:RETURN_CODE&gt;
                                &lt;/ns:CONSISTENZA&gt;
                            &lt;/xsl:for-each&gt;
                            &lt;xsl:if test="count(../tns1:Consistenza)=0"&gt;
                                &lt;ns:CONSISTENZA&gt;
                                    &lt;ns:RETURN_CODE&gt;
                                        &lt;xsl:value-of select="&amp;quot;01&amp;quot;"/&gt;
                                    &lt;/ns:RETURN_CODE&gt;
                                    &lt;ns:DESCRIZIONE_ERRORE&gt;
                                        &lt;xsl:value-of select="&amp;quot;Risorsa non trovata.&amp;quot;"/&gt;
                                    &lt;/ns:DESCRIZIONE_ERRORE&gt;
                                &lt;/ns:CONSISTENZA&gt;
                            &lt;/xsl:if&gt;
                        &lt;/ns:RISORSE&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/ns:RESPONSE&gt;
            &lt;/RESPONSE&gt;
        &lt;/tns:Response&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
