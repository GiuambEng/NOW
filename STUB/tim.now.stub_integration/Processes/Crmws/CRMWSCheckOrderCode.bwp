                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c71f90f-4fc7-45fb-8a79-bb778cc6c6f7+input&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckOrderCode/Schema.xsd&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CRMWSCheckOrderCodeIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODICE_OLO>&lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:CODICE_OLO&quot;/>&lt;/CODICE_OLO>&lt;CODICE_OLO_CRMWS>&lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:CODICE_OLO_CRMWS&quot;/>&lt;/CODICE_OLO_CRMWS>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)>0&quot;>&lt;COD_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)&quot;>&lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:COD_ORDINE_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ORDINE_OLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_ORDINE_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:COD_ORDINE_TI)&quot;>&lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn/HEADER/ns:HEADER/ns:REQUEST/ns:COD_ORDINE_TI&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_ORDINE_OLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CRMWSCheckOrderCodeIn/HEADER