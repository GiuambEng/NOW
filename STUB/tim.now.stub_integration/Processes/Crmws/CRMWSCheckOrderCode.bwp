        &lt;xsl:value-of select=&quot;&amp;quot;99&amp;quot;&quot;/>&#xa;                        &lt;/ns1:RETURN_CODE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Select_CRMWSCheckOrderCode/Record)>0 or (count($Select_CRMWSCheckOrderCode/Record)=0 and (string-length($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)=0 or string-length($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI)=0)) &quot;/>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)>0 and string-length($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI)>0 &quot;>&#xa;                                &lt;ns1:DESCRIZIONE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;COD_ORDINE_OLO e COD_ORDINE_TI sono mutuamente esclusivi. Uno dei due deve essere sempre valorizzato&amp;quot;&quot;/>&#xa;                                &lt;/ns1:DESCRIZIONE_ERRORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns1:DESCRIZIONE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Errore generico&amp;quot;&quot;/>&#xa;                                &lt;/ns1:DESCRIZIONE_ERRORE>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns1:RESPONSE>&#xa;        &lt;/ns1:HEADER>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
