                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OLO_CRMWS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDINE_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ORDINE_TI"/>
                                    <columnMetadata
                                    columnName="SERVIZIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DRO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
