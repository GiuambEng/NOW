          &lt;COD_ORDINE_OLO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_ORDINE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)>0&quot;>&#xa;                    &lt;COD_ORDINE_TI>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_OLO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/COD_ORDINE_TI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_ORDINE_TI>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/ns:COD_ORDINE_TI)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSCheckOrderCodeIn.HEADER/ns:REQUEST/n