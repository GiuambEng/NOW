                                    sqlStatement="SELECT DN, RETURN_CODE, DESCRIZIONE_ERRORE,&#xa;  ID_ORDINE&#xa;  FROM STUB_NOWLAVORABILITADN_S5&#xa;  WHERE DN = ?&#xa;&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

