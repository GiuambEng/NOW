                tibex:xpdlId="b7c2ab74-e02a-4043-b2d3-12eebfda0e68" variable="getAddressVerifyRequestOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://telecomitalia.it/SOA/WirelineAddressCertificationQuery" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:sm="http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19" version="2.0"&gt;&lt;xsl:param name="getAddressVerifyRequestIn"/&gt;&lt;xsl:param name="ParseXml"/&gt;&lt;xsl:param name="DatiIndirizzo"/&gt;&lt;xsl:param name="JDBCGetResponseFromJIve"/&gt;&lt;xsl:template name="getAddressVerifyRequestOut-input" match="/"&gt;&lt;tns:getAddressVerifyResponse&gt;&lt;body&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($JDBCGetResponseFromJIve/Record) = 0"&gt;&lt;sm:getAddressVerifyResponse&gt;&lt;sm:ProcessData&gt;&lt;sm:returnCode&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/sm:returnCode&gt;&lt;sm:codeErr&gt;&lt;xsl:value-of select="'C9999'"/&gt;&lt;/sm:codeErr&gt;&lt;sm:descErr&gt;&lt;xsl:value-of select="'ERRORE GENERICO'"/&gt;&lt;/sm:descErr&gt;&lt;/sm:ProcessData&gt;&lt;/sm:getAddressVerifyResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$DatiIndirizzo!='DATI_INDIRIZZO_MANCANTI'"&gt;&lt;xsl:copy-of select="$ParseXml"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;sm:getAddressVerifyResponse&gt;&lt;sm:ProcessData&gt;&lt;sm:returnCode&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/sm:returnCode&gt;&lt;sm:codeErr&gt;&lt;xsl:value-of select="'C0003'"/&gt;&lt;/sm:codeErr&gt;&lt;sm:descErr&gt;&lt;xsl:value-of select="'Campo obbligatorio mancante'"/&gt;&lt;/sm:descErr&gt;&lt;/sm:ProcessData&gt;&lt;/sm:getAddressVerifyResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/body&gt;&lt;Header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'JIVE'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]')"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]')"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$getAddressVerifyRequestIn/Header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$getAddressVerifyRequestIn/Header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$getAddressVerifyRequestIn/Header/h:Header/h:messageID"&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$getAddressVerifyRequestIn/Header/h:Header/h:messageID"/&gt;&lt;/h:messageID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$getAddressVerifyRequestIn/Header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$getAddressVerifyRequestIn/Header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/Header&gt;&lt;/tns:getAddressVerifyResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiIndirizzo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCGetResponseFromJIve&quot;/>&#xa;    &lt;xsl:template name=&quot;getAddressVerifyRequestOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCGetResponseFromJIve/Record) = 0&quot;>&#xa;                &lt;sm:getAddressVerifyResponse>&#xa;                    &lt;sm:ProcessData>&#xa;                        &lt;sm:returnCode>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/sm:returnCode>&#xa;                        &lt;sm:codeErr>&#xa;                            &lt;xsl:value-of select=&quot;'C9999'&quot;/>&#xa;                        &lt;/sm:codeErr>&#xa;                        &lt;sm:descErr>&#xa;                            &lt;xsl:value-of select=&quot;'ERRORE GENERICO'&quot;/>&#xa;                        &lt;/sm:descErr>&#xa;                    &lt;/sm:ProcessData>&#xa;                &lt;/sm:getAddressVerifyResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$DatiIndirizzo!='DATI_INDIRIZZO_MANCANTI'&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXml&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;sm:getAddressVerifyResponse>&#xa;                    &lt;sm:ProcessData>&#xa;                        &lt;sm:returnCode>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/sm:returnCode>&#xa;                        &lt;sm:codeErr>&#xa;                            &lt;xsl:value-of select=&quot;'C0003'&quot;/>&#xa;                        &lt;/sm:codeErr>&#xa;                        &lt;sm:descErr>&#xa;                            &lt;xsl:value-of select=&quot;'Campo obbligatorio mancante'&quot;/>&#xa;                        &lt;/sm:descErr>&#xa;                    &lt;/sm:ProcessData>&#xa;                &lt;/sm:getAddressVerifyResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getAddressVerifyRequestIn.Header&quot;/>&#xa;    &lt;xsl:template name=&quot;getAddressVerifyRequestOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;h:Header>&#xa;            &lt;h:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;'JIVE'&quot;/>&#xa;            &lt;/h:sourceSystem>&#xa;            &lt;h:interactionDate>&#xa;                &lt;h:Date>&#xa;                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]')&quot;/>&#xa;                &lt;/h:Date>&#xa;                &lt;h:Time>&#xa;                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]')&quot;/>&#xa;                &lt;/h:Time>&#xa;            &lt;/h:interactionDate>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequestIn.Header/h:businessID&quot;>&#xa;                &lt;h:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequestIn.Header/h:businessID&quot;/>&#xa;                &lt;/h:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequestIn.Header/h:messageID&quot;>&#xa;                &lt;h:messageID>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequestIn.Header/h:messageID&quot;/>&#xa;                &lt;/h:messageID>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequestIn.Header/h:transactionID&quot;>&#xa;                &lt;h:transactionID>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequestIn.Header/h:transactionID&quot;/>&#xa;                &lt;/h:transactionID>&#xa;            &lt;/xsl:if>&#xa;        &lt;/h:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
