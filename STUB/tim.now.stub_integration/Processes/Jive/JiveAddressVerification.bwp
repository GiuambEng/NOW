                </bpws:sources>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if ($Mapper/ns16:CODICE_TOPONOMASTICO != '') then 'CODICE_TOPONOMASTICA'&#xd;&#xa; else if ($Mapper/ns16:CODICE_TOPONOMASTICO = '' &#xd;&#xa; and ($Mapper/ns16:VIA !='' &#xd;&#xa; and $Mapper/ns16:PARTICELLA_TOPONOMASTICA !='' &#xd;&#xa; and $Mapper/ns16:CIVICO !=''&#xd;&#xa; and $Mapper/ns16:ISTAT_COMUNE !=''&#xd;&#xa; and $Mapper/ns16:LOCALITA != '')) then 'INDIRIZZO'&#xd;&#xa;else if ($Mapper/ns16:CODICE_TOPONOMASTICO = '' &#xd;&#xa; and ($Mapper/ns16:VIA ='' &#xd;&#xa; or $Mapper/ns16:PARTICELLA_TOPONOMASTICA ='' &#xd;&#xa; or $Mapper/ns16:CIVICO =''&#xd;&#xa; or $Mapper/ns16:LOCALITA=''&#xd;&#xa; or $Mapper/ns16:ISTAT_COMUNE='')) then 'DATI_INDIRIZZO_MANCANTI'&#xd;&#xa; else 'err'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="DatiIndirizzo" name="Assign"
                    outputVariable="DatiIndirizzo"
                    tibex:xpdlId="0addbca2-9866-4ab6-ba78-429442c4b725" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$DatiIndirizzo!='DATI_INDIRIZZO_MANCANTI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$DatiIndirizzo!='DATI_INDIRIZZO_MANCANTI']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToLogMsgJiveAddressVerification">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if ($Mapper/ns16:CODICE_TOPONOMASTICO != '') then 'CODICE_TOPONOMASTICA'&#xd;&#xa; else if ($Mapper/ns16:CODICE_TOPONOMASTICO = '' &#xd;&#xa; and ($Mapper/ns16:VIA !='' &#xd;&#xa; and $Mapper/ns16:PARTICELLA_TOPONOMASTICA !='' &#xd;&#xa; and $Mapper/ns16:CIVICO !=''&#xd;&#xa; and $Mapper/ns16:ISTAT_COMUNE !=''&#xd;&#xa; and $Mapper/ns16:LOCALITA != '')) then 'INDIRIZZO'&#xd;&#xa;else if ($Mapper/ns16:CODICE_TOPONOMASTICO = '' &#xd;&#xa; and ($Mapper/ns16:VIA ='' &#xd;&#xa; or $Mapper/ns16:PARTICELLA_TOPONOMASTICA ='' &#xd;&#xa; or $Mapper/ns16:CIVICO =''&#xd;&#xa; or $Mapper/ns16:LOCALITA=''&#xd;&#xa; or $Mapper/ns16:ISTAT_COMUNE='')) then 'DATI_INDIRIZZO_MANCANTI'&#xd;&#xa; else 'err'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
