             &lt;xsl:value-of select=&quot;concat(&amp;quot;Invio Response a NOW: &amp;quot;, $DatiIndirizzo, ' - Se CODICE_TOPONOMASTICO (publicRegStreetTypeCode) assente, devono essere presenti: PARTICELLA_TOPONOMASTICA (streetType), VIA (addressOrLocality), LOCALITA (locality), CAP (postCode), CIVICO (streetNrFirst), PROVINCIA (province), ISTAT_COMUNE (ISTATCityCode)')&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
