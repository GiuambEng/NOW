            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:RiscontriOLType"/>
            </plnk:partnerLinkType>
            <wsdl:import
                location="../../Service%20Descriptors/FlashFiber/FFRiscontriOL.wsdl" namespace="http://ordinicommerciali.service.flashfiber.com/"/>
        </wsdl:definitions>
    </tibex:Types>
