            </plnk:partnerLinkType>
            <wsdl:import
                location="../../Service%20Descriptors/FlashFiber/FFOrdiniCommerciali.wsdl" namespace="http://ordinicommerciali.service.flashfiber.com/"/>
        </wsdl:definitions>
    </tibex:Types>
