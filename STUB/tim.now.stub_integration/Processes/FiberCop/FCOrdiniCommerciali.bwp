                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://ordinicommerciali.service.fibercop.com/&quot; xmlns:nslt3=&quot;temp_namespace&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;variazioneIdrisorsa.variazioneIDRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyVarIdRis-input&quot; match=&quot;/&quot;>&#xa;        &lt;nslt3:variazioneIDRisorsaResponse>&#xa;            &lt;response>&#xa;                &lt;esito>&#xa;                    &lt;codice>&#xa;                        &lt;xsl:value-of select=&quot;'00'&quot;/>&#xa;                    &lt;/codice>&#xa;                    &lt;descrizione>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/descrizione>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/esito>&#xa;                &lt;testata>&#xa;                    &lt;codiceMittente>&#xa;                        &lt;xsl:value-of select=&quot;'TIM'&quot;/>&#xa;                    &lt;/codiceMittente>&#xa;                    &lt;codiceOrdineMittente>&#xa;                        &lt;xsl:value-of select=&quot;$variazioneIdrisorsa.variazioneIDRisorsa/request/testata/codiceOrdineOperatore&quot;/>&#xa;                    &lt;/codiceOrdineMittente>&#xa;                    &lt;dataIdNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$variazioneIdrisorsa.variazioneIDRisorsa/request/testata/dataIdNotifica&quot;/>&#xa;                    &lt;/dataIdNotifica>&#xa;                    &lt;idNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$variazioneIdrisorsa.variazioneIDRisorsa/request/testata/idNotifica&quot;/>&#xa;                    &lt;/idNotifica>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$variazioneIdrisorsa.variazioneIDRisorsa/request/testata/tipoOrdine&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/testata>&#xa;            &lt;/response>&#xa;        &lt;/nslt3:variazioneIDRisorsaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Log4ToReply"/>
                                </bpws:targets>
                            </bpws:reply>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
