                                    <element maxOccurs="1" minOccurs="1"
                                    name="DATA_MSG" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="DATA_DES" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="CODICE_ORDINE_ISP"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="IDORDCRMWS"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="CODICE_PROGETTO"
                                    nillable="false" type="string"/>
