                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns0=&quot;http://crmnow.ordineregolatorio.jpub/types/&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ricezioneIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:REGOLATORIO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ricezioneIn.parameters/tns0:ORDINE/REGOLATORIO/TESTATA)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ricezioneIn.parameters/tns0:ORDINE/REGOLATORIO/TESTATA&quot;>&#xa;                        &lt;ns:TESTATA>&#xa;                            &lt;ID_ORD_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;ID_ORD_CRMWS&quot;/>&#xa;                            &lt;/ID_ORD_CRMWS>&#xa;                            &lt;DATA_DRO>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DRO&quot;/>&#xa;                            &lt;/DATA_DRO>&#xa;                            &lt;DATA_MSG>&#xa;                                &lt;xsl:value-of select=&quot;DATA_MSG&quot;/>&#xa;                            &lt;/DATA_MSG>&#xa;                            &lt;DATA_DES>&#xa;                                &lt;xsl:value-of select=&quot;DATA_DES&quot;/>&#xa;                            &lt;/DATA_DES>&#xa;                            &lt;CODE_CAUS>&#xa;                                &lt;xsl:value-of select=&quot;CODE_CAUS&quot;/>&#xa;                            &lt;/CODE_CAUS>&#xa;                            &lt;CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;CODICE_ORDINE_ISP&quot;/>&#xa;                            &lt;/CODICE_ORDINE_ISP>&#xa;                            &lt;CODICE_PROGETTO>&#xa;                           