                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/concrete/NOW_JPUB_FatturazioneOrdini/&quot; xmlns:tns1=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpub/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioEsitiRegolatorio-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ESITI>&#xa;            &lt;tns1:TESTATA>&#xa;                &lt;xsl:if test=&quot;$Mapper/ns:TESTATA[1]/CODICE_ORDINE_ISP&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODICEORDINEISP&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/ns:TESTATA[1]/CODICE_ORDINE_ISP&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/ns:TESTATA[1]/CODICE_PROGETTO&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODICEPROGETTO&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/ns:TESTATA[1]/CODICE_PROGETTO&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:attribute name=&quot;DATADES&quot;>&#xa;                    &lt;xsl:value-of select=&quot;string($Mapper/ns:TESTATA[1]/DATA_DES)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;DATADRO&quot;>&#xa;                    &lt;xsl:value-of select=&quot;string($Mapper/ns:TESTATA[1]/DATA_DRO)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;DATAMSG&quot;>&#xa;                    &lt;x