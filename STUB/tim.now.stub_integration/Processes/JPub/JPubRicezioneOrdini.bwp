                                    &lt;/CAMPO_SERV_IT>&#xa;                                    &lt;QUANTITA>&#xa;                                        &lt;xsl:value-of select=&quot;QUANTITA&quot;/>&#xa;                                    &lt;/QUANTITA>&#xa;                                    &lt;CODE_DONOR>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONOR&quot;/>&#xa;                                    &lt;/CODE_DONOR>&#xa;                                    &lt;CODE_DONATING>&#xa;                                        &lt;xsl:value-of select=&quot;CODE_DONATING&quot;/>&#xa;                                    &lt;/CODE_DONATING>&#xa;                                    &lt;xsl:if test=&quot;CODE_ID_SLUCO&quot;>&#xa;                                        &lt;CODE_ID_SLUCO>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_ID_SLUCO&quot;/>&#xa;                                        &lt;/CODE_ID_SLUCO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_MANTENIMENTO_STS>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_MANTENIMENTO_STS&quot;/>&#xa;                                    &lt;/FLAG_MANTENIMENTO_STS>&#xa;                                    &lt;xsl:if test=&quot;FLAG_PERMUTA_ARMADIO&quot;>&#xa;                                        &lt;FLAG_PERMUTA_ARMADIO>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_PERMUTA_ARMADIO&quot;/>&#xa;                                        &lt;/FLAG_PERMUTA_ARMADIO>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;TIPO_CESSAZIONE&quot;>&#xa;                                        &lt;TIPO_CESSAZIONE>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_CESSAZIONE&quot;/>&#xa;                                        &lt;/TIPO_CESSAZIONE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;>&#xa;                                        &lt;FLAG_NP_SUCCESSIVA_PURA>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_NP_SUCCESSIVA_PURA&quot;/>&#xa;                                        &lt;/FLAG_NP_SUCCESSIVA_PURA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;FLAG_LA>&#xa;                                        &lt;xsl:value-of select=&quot;FLAG_LA&quot;/>&#xa;                                    &lt;/FLAG_LA>&#xa;                                    &lt;xsl:if test=&quot;TIPO_LINEA_NUM_AGG&quot;>&#xa;                                        &lt;TIPO_LINEA_NUM_AGG>&#xa;                                            &lt;xsl:value-of select=&quot;TIPO_LINEA_NUM_AGG&quot;/>&#xa;                                        &lt;/TIPO_LINEA_NUM_AGG>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;FLAG_4REFERENTE&quot;>&#xa;                                        &lt;FLAG_4REFERENTE>&#xa;                                            &lt;xsl:value-of select=&quot;FLAG_4REFERENTE&quot;/>&#xa;                                        &lt;/FLAG_4REFERENTE>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;CODE_HOSTING&quot;>&#xa;                                        &lt;CODE_HOSTING>&#xa;                                            &lt;xsl:value-of select=&quot;CODE_HOSTING&quot;/>&#xa;                                        &lt;/CODE_HOSTING>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;AGG&quot;>&#xa;                                        &lt;ns:AGG>&#xa;                                            &lt;AGGIUNTIVO>&#xa;                                                &lt;xsl:value-of select=&quot;AGGIUNTIVO&quot;/>&#xa;                                            &lt;/AGGIUNTIVO>&#xa;                                        &lt;/ns:AGG>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;STS&quot;>&#xa;                                        &lt;ns:STS>&#xa;                                            &lt;TIPO_AZIONE>&#xa;                                                &lt;xsl:value-of select=&quot;TIPO_AZIONE&quot;/>&#xa;                                            &lt;/TIPO_AZIONE>&#xa;                                            &lt;FLAG_LINEA_NUM_AGG>&#xa;                                                &lt;xsl:value-of select=&quot;FLAG_LINEA_NUM_AGG&quot;/>&#xa;                                            &lt;/FLAG_LINEA_NUM_AGG>&#xa;                                            &lt;ID_RIS_AGGIUNTIVA>&#xa;                                                &lt;xsl:value-of select=&quot;ID_RIS_AGGIUNTIVA&quot;/>&#xa;                                            &lt;/ID_RIS_AGGIUNTIVA>&#xa;                                            &lt;CODE_STS>&#xa;                                                &lt;xsl:value-of select=&quot;CODE_STS&quot;/>&#xa;                                            &lt;/CODE_STS>&#xa;                                        &lt;/ns:STS>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:ACCESSO>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/ns:TESTATA>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:PREVENTIVO>&#xa;                        &lt;ID_PREVENTIVO>&#xa;                            &lt;xsl:value-of select=&quot;$ricezioneIn.parameters/tns0:ORDINE/REGOLATORIO/PREVENTIVO/ID_PREVENTIVO&quot;/>&#xa;                        &lt;/ID_PREVENTIVO>&#