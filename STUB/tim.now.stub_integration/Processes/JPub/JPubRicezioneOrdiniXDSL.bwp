                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns2="http://www.tim.com/NOW/wsdl/concrete/NOW_JPUB_FatturazioneOrdini/" xmlns:tns2="http://www.openaccess.it/wholesale/manager/billingEsiti/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns="http://xsd.telecomitalia.it/Schema/jpubADSL/" version="2.0"&gt;
    &lt;xsl:param name="JDBCResponseJPubXDSL"/&gt;
    &lt;xsl:param name="Mapper"/&gt;
    &lt;xsl:template name="InvioEsitiXDSL-input" match="/"&gt;
        &lt;ns2:InvioEsitiXDSLRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:ESITI&gt;
                    &lt;tns2:TESTATA&gt;
                        &lt;xsl:if test="$Mapper/TESTATA[1]/CODICE_ORDINE_ISP"&gt;
                            &lt;xsl:attribute name="CODICEORDINEISP"&gt;
                                &lt;xsl:value-of select="$Mapper/TESTATA[1]/CODICE_ORDINE_ISP"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Mapper/TESTATA[1]/CODICE_PROGETTO"&gt;
                            &lt;xsl:attribute name="CODICEPROGETTO"&gt;
                                &lt;xsl:value-of select="$Mapper/TESTATA[1]/CODICE_PROGETTO"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:attribute name="DATADES"&gt;
                            &lt;xsl:value-of select="xsd:string($Mapper/TESTATA[1]/DATA_DES)"/&gt;
                        &lt;/xsl:attribute&gt;
                        &lt;xsl:attribute name="DATADRO"&gt;
                            &lt;xsl:value-of select="xsd:string($Mapper/TESTATA[1]/DATA_DRO)"/&gt;
                        &lt;/xsl:attribute&gt;
                        &lt;xsl:attribute name="DATAMSG"&gt;
                            &lt;xsl:value-of select="xsd:string($Mapper/TESTATA[1]/DATA_MSG)"/&gt;
                        &lt;/xsl:attribute&gt;
                        &lt;xsl:if test="$Mapper/TESTATA[1]/ID_ORD_CRMWS"&gt;
                            &lt;xsl:attribute name="IDORDCRMWS"&gt;
                                &lt;xsl:value-of select="$Mapper/TESTATA[1]/ID_ORD_CRMWS"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:value-of select="''"/&gt;
                    &lt;/tns2:TESTATA&gt;
                    &lt;tns2:NOTIFICA&gt;
                        &lt;xsl:if test="$JDBCResponseJPubXDSL/Record[1]/CODE_DETT_SCARTO"&gt;
                            &lt;xsl:attribute name="CODEDETTSCARTO"&gt;
                                &lt;xsl:value-of select="$JDBCResponseJPubXDSL/Record[1]/CODE_DETT_SCARTO"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JDBCResponseJPubXDSL/Record[1]/CODE_SCARTO"&gt;
                            &lt;xsl:attribute name="CODESCARTO"&gt;
                                &lt;xsl:value-of select="$JDBCResponseJPubXDSL/Record[1]/CODE_SCARTO"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($Mapper/TESTATA[1]/ACCESSO[1])"&gt;
                                &lt;xsl:if test="$Mapper/TESTATA[1]/ACCESSO[1]/ID_RIS"&gt;
                                    &lt;xsl:attribute name="IDRISORSA"&gt;
                                        &lt;xsl:value-of select="$Mapper/TESTATA[1]/ACCESSO[1]/ID_RIS"/&gt;
                                    &lt;/xsl:attribute&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($Mapper/TESTATA[1]/VLAN)"&gt;
                                &lt;xsl:if test="$Mapper/TESTATA[1]/VLAN/ID_RIS"&gt;
                                    &lt;xsl:attribute name="IDRISORSA"&gt;
                                        &lt;xsl:value-of select="$Mapper/TESTATA[1]/VLAN/ID_RIS"/&gt;
                                    &lt;/xsl:attribute&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="$Mapper/TESTATA[1]/VP"&gt;
                                &lt;xsl:if test="$Mapper/TESTATA[1]/VP/ID_RIS"&gt;
                                    &lt;xsl:attribute name="IDRISORSA"&gt;
                                        &lt;xsl:value-of select="$Mapper/TESTATA[1]/VP/ID_RIS"/&gt;
                                    &lt;/xsl:attribute&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="$Mapper/TESTATA[1]/MK4"&gt;
                                &lt;xsl:if test="$Mapper/TESTATA[1]/MK4/ID_RIS"&gt;
                                    &lt;xsl:attribute name="IDRISORSA"&gt;
                                        &lt;xsl:value-of select="$Mapper/TESTATA[1]/MK4/ID_RIS"/&gt;
                                    &lt;/xsl:attribute&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="$Mapper/TESTATA[1]/EVENTI/ID_RIS"&gt;
                                    &lt;xsl:attribute name="IDRISORSA"&gt;
                                        &lt;xsl:value-of select="$Mapper/TESTATA[1]/EVENTI/ID_RIS"/&gt;
                                    &lt;/xsl:attribute&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$JDBCResponseJPubXDSL/Record[1]/NOME_ATTRIB_IN_ERRORE"&gt;
                            &lt;xsl:attribute name="NOMEATTRIBINERRORE"&gt;
                                &lt;xsl:value-of select="$JDBCResponseJPubXDSL/Record[1]/NOME_ATTRIB_IN_ERRORE"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JDBCResponseJPubXDSL/Record[1]/OL_ELAB_OK"&gt;
                            &lt;xsl:attribute name="OLELABOK"&gt;
                                &lt;xsl:value-of select="$JDBCResponseJPubXDSL/Record[1]/OL_ELAB_OK"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$JDBCResponseJPubXDSL/Record[1]/TAG_IN_ERRORE"&gt;
                            &lt;xsl:attribute name="TAGINERRORE"&gt;
                                &lt;xsl:value-of select="$JDBCResponseJPubXDSL/Record[1]/TAG_IN_ERRORE"/&gt;
                            &lt;/xsl:attribute&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:value-of select="''"/&gt;
                    &lt;/tns2:NOTIFICA&gt;
                &lt;/tns2:ESITI&gt;
            &lt;/parameters&gt;
        &lt;/ns2:InvioEsitiXDSLRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/wsdl/concrete/NOW_JPUB_FatturazioneOrdini/&quot; xmlns:tns2=&quot;http://www.openaccess.it/wholesale/manager/billingEsiti/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/Schema/jpubADSL/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCResponseJPubXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InvioEsitiXDSL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ESITI>&#xa;            &lt;tns2:TESTATA>&#xa;                &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/CODICE_ORDINE_ISP&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODICEORDINEISP&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/CODICE_ORDINE_ISP&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/CODICE_PROGETTO&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODICEPROGETTO&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/CODICE_PROGETTO&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:attribute name=&quot;DATADES&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($Mapper/TESTATA[1]/DATA_DES)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;DATADRO&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($Mapper/TESTATA[1]/DATA_DRO)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:attribute name=&quot;DATAMSG&quot;>&#xa;                    &lt;xsl:value-of select=&quot;xsd:string($Mapper/TESTATA[1]/DATA_MSG)&quot;/>&#xa;                &lt;/xsl:attribute>&#xa;                &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/ID_ORD_CRMWS&quot;>&#xa;                    &lt;xsl:attribute name=&quot;IDORDCRMWS&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/ID_ORD_CRMWS&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;            &lt;/tns2:TESTATA>&#xa;            &lt;tns2:NOTIFICA>&#xa;                &lt;xsl:if test=&quot;$JDBCResponseJPubXDSL/Record[1]/CODE_DETT_SCARTO&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODEDETTSCARTO&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCResponseJPubXDSL/Record[1]/CODE_DETT_SCARTO&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JDBCResponseJPubXDSL/Record[1]/CODE_SCARTO&quot;>&#xa;                    &lt;xsl:attribute name=&quot;CODESCARTO&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCResponseJPubXDSL/Record[1]/CODE_SCARTO&quot;/>&#xa;                    &lt;/xsl:attribute>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper/TESTATA[1]/ACCESSO[1])&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/ACCESSO[1]/ID_RIS&quot;>&#xa;                            &lt;xsl:attribute name=&quot;IDRISORSA&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/ACCESSO[1]/ID_RIS&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper/TESTATA[1]/VLAN)&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/VLAN/ID_RIS&quot;>&#xa;                            &lt;xsl:attribute name=&quot;IDRISORSA&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/VLAN/ID_RIS&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Mapper/TESTATA[1]/VP&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/VP/ID_RIS&quot;>&#xa;                            &lt;xsl:attribute name=&quot;IDRISORSA&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/VP/ID_RIS&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Mapper/TESTATA[1]/MK4&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/MK4/ID_RIS&quot;>&#xa;                            &lt;xsl:attribute name=&quot;IDRISORSA&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/MK4/ID_RIS&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper/TESTATA[1]/EVENTI/ID_RIS&quot;>&#xa;                            &lt;xsl:attribute name=&quot;IDRISORSA&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/TESTATA[1]/EVENTI/ID_RIS&quot;/>&#xa;                            &lt;/xsl:attribute>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBCResponseJPubXDSL/Record[1]/NOME_ATTRIB_IN_ERRORE&quot;>&#xa;                    &lt;xsl:attribute name=&quot;NOMEATTRIBINERRORE&quot;>&#xa;                        &lt;xsl:value-of select=