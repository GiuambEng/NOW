        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="calcolaPreventivoInToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBC_EsitoToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToJDBC_Esito" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1TocalcolaPreventivoOut" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes"
                name="calcolaPreventivoIn" operation="calcolaPreventivo"
                partnerLink="PreventivoWS" portType="ns1:PreventivoWS"
                tibex:xpdlId="00ce3cfb-4a85-4670-b7d2-147c78d2d1ab" variable="calcolaPreventivoIn">
                <bpws:sources>
                    <bpws:source linkName="calcolaPreventivoInToLog"/>
