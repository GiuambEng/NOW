            <bpws:reply name="calcolaPreventivoOut"
                operation="calcolaPreventivo" partnerLink="PreventivoWS"
                portType="ns1:PreventivoWS"
                tibex:xpdlId="194858b6-ae8b-4d42-8a09-1eb65719eadb" variable="calcolaPreventivoOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://next.it/operespeciali/preventivo" xmlns:regCRMWS="http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="calcolaPreventivoIn"/&gt;&lt;xsl:param name="JDBC_Esito"/&gt;&lt;xsl:template name="calcolaPreventivoOut-input" match="/"&gt;&lt;tns:OPERESPECIALIResponse&gt;&lt;parameters&gt;&lt;regCRMWS:OPERESPECIALIResponse&gt;&lt;PreventivoResponse&gt;&lt;ID_PREVENTIVO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/ID_PREVENTIVO"/&gt;&lt;/ID_PREVENTIVO&gt;&lt;ID_RICHIESTA_NOW&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/ID_RICHIESTA_NOW"/&gt;&lt;/ID_RICHIESTA_NOW&gt;&lt;ID_OLO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/ID_OLO"/&gt;&lt;/ID_OLO&gt;&lt;CODICE_ORDINE_OLO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/CODICE_ORDINE_OLO"/&gt;&lt;/CODICE_ORDINE_OLO&gt;&lt;ID_RIS&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/ID_RIS"/&gt;&lt;/ID_RIS&gt;&lt;TIPO_SERVIZIO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/TIPO_SERVIZIO"/&gt;&lt;/TIPO_SERVIZIO&gt;&lt;TECNOLOGIA&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/TECNOLOGIA"/&gt;&lt;/TECNOLOGIA&gt;&lt;DATA_DRO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/DATA_DRO"/&gt;&lt;/DATA_DRO&gt;&lt;DATA_RICHIESTA_PREVENTIVO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/DATA_RICHIESTA_PREVENTIVO"/&gt;&lt;/DATA_RICHIESTA_PREVENTIVO&gt;&lt;FLAG_PREVENTIVO&gt;&lt;xsl:value-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/FLAG_PREVENTIVO"/&gt;&lt;/FLAG_PREVENTIVO&gt;&lt;xsl:copy-of select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/DETTAGLIO"/&gt;&lt;DATA_INVIO_PREVENTIVO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/DATA_INVIO_PREVENTIVO&gt;&lt;TOTALE&gt;&lt;xsl:value-of select="1000*sum($calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/DETTAGLIO/QUANTITA)"/&gt;&lt;/TOTALE&gt;&lt;xsl:for-each select="$calcolaPreventivoIn/parameters/regCRMWS:OPERESPECIALI/PREVENTIVO/DETTAGLIO"&gt;&lt;DettaglioResponse&gt;&lt;ID_VOCE&gt;&lt;xsl:value-of select="ID_VOCE"/&gt;&lt;/ID_VOCE&gt;&lt;QUANTITA&gt;&lt;xsl:value-of select="QUANTITA"/&gt;&lt;/QUANTITA&gt;&lt;DESCRIZIONE&gt;&lt;xsl:value-of select="'Dettaglio preventivo'"/&gt;&lt;/DESCRIZIONE&gt;&lt;IMPORTO&gt;&lt;xsl:value-of select="1000*QUANTITA"/&gt;&lt;/IMPORTO&gt;&lt;/DettaglioResponse&gt;&lt;/xsl:for-each&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$JDBC_Esito/Record[1]/ESITO='KO'"&gt;&lt;ERRORE&gt;&lt;TYPE_ERROR&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/TYPE_ERROR&gt;&lt;CODE_ERROR&gt;&lt;xsl:value-of select="'-99'"/&gt;&lt;/CODE_ERROR&gt;&lt;DETTAGLIO&gt;&lt;xsl:value-of select="'IMPOSSIBILE CALCOLARE PREVENTIVO'"/&gt;&lt;/DETTAGLIO&gt;&lt;/ERRORE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ERRORE&gt;&lt;TYPE_ERROR&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/TYPE_ERROR&gt;&lt;CODE_ERROR&gt;&lt;xsl:value-of select="''"/&gt;&lt;/CODE_ERROR&gt;&lt;DETTAGLIO&gt;&lt;xsl:value-of select="''"/&gt;&lt;/DETTAGLIO&gt;&lt;/ERRORE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/PreventivoResponse&gt;&lt;/regCRMWS:OPERESPECIALIResponse&gt;&lt;/parameters&gt;&lt;/tns:OPERESPECIALIResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://next.it/operespeciali/preventivo&quot; xmlns:regCRMWS=&quot;http://xsd.telecomitalia.it/Schema/crmws.entity.classes/3.0&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;calcolaPreventivoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_Esito&quot;/>&#xa;    &lt;xsl:template name=&quot;calcolaPreventivoOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;regCRMWS:OPERESPECIALIResponse>&#xa;            &lt;PreventivoResponse>&#xa;                &lt;ID_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/ID_PREVENTIVO&quot;/>&#xa;                &lt;/ID_PREVENTIVO>&#xa;                &lt;ID_RICHIESTA_NOW>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/ID_RICHIESTA_NOW&quot;/>&#xa;                &lt;/ID_RICHIESTA_NOW>&#xa;                &lt;ID_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/ID_OLO&quot;/>&#xa;                &lt;/ID_OLO>&#xa;                &lt;CODICE_ORDINE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/CODICE_ORDINE_OLO&quot;/>&#xa;                &lt;/CODICE_ORDINE_OLO>&#xa;                &lt;ID_RIS>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/ID_RIS&quot;/>&#xa;                &lt;/ID_RIS>&#xa;                &lt;TIPO_SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/TIPO_SERVIZIO&quot;/>&#xa;                &lt;/TIPO_SERVIZIO>&#xa;                &lt;TECNOLOGIA>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/TECNOLOGIA&quot;/>&#xa;                &lt;/TECNOLOGIA>&#xa;                &lt;DATA_DRO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/DATA_DRO&quot;/>&#xa;                &lt;/DATA_DRO>&#xa;                &lt;DATA_RICHIESTA_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/DATA_RICHIESTA_PREVENTIVO&quot;/>&#xa;                &lt;/DATA_RICHIESTA_PREVENTIVO>&#xa;                &lt;FLAG_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/FLAG_PREVENTIVO&quot;/>&#xa;                &lt;/FLAG_PREVENTIVO>&#xa;                &lt;xsl:copy-of select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/DETTAGLIO&quot;/>&#xa;                &lt;DATA_INVIO_PREVENTIVO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/DATA_INVIO_PREVENTIVO>&#xa;                &lt;TOTALE>&#xa;                    &lt;xsl:value-of select=&quot;1000*sum($calcolaPreventivoIn.parameters/PREVENTIVO/DETTAGLIO/QUANTITA)&quot;/>&#xa;                &lt;/TOTALE>&#xa;                &lt;xsl:for-each select=&quot;$calcolaPreventivoIn.parameters/PREVENTIVO/DETTAGLIO&quot;>&#xa;                    &lt;DettaglioResponse>&#xa;                        &lt;ID_VOCE>&#xa;                            &lt;xsl:value-of select=&quot;ID_VOCE&quot;/>&#xa;                        &lt;/ID_VOCE>&#xa;                        &lt;QUANTITA>&#xa;                            &lt;xsl:value-of select=&quot;QUANTITA&quot;/>&#xa;                        &lt;/QUANTITA>&#xa;                        &lt;DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;'Dettaglio preventivo'&quot;/>&#xa;                        &lt;/DESCRIZIONE>&#xa;                        &lt;IMPORTO>&#xa;                            &lt;xsl:value-of select=&quot;1000*QUANTITA&quot;/>&#xa;                        &lt;/IMPORTO>&#xa;                    &lt;/DettaglioResponse>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JDBC_Esito/Record[1]/ESITO='KO'&quot;>&#xa;                        &lt;ERRORE>&#xa;                            &lt;TYPE_ERROR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/TYPE_ERROR>&#xa;                            &lt;CODE_ERROR>&#xa;                                &lt;xsl:value-of select=&quot;'-99'&quot;/>&#xa;                            &lt;/CODE_ERROR>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;xsl:value-of select=&quot;'IMPOSSIBILE CALCOLARE PREVENTIVO'&quot;/>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/ERRORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ERRORE>&#xa;                            &lt;TYPE_ERROR>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/TYPE_ERROR>&#xa;                            &lt;CODE_ERROR>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/CODE_ERROR>&#xa;                            &lt;DETTAGLIO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/DETTAGLIO>&#xa;                        &lt;/ERRORE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/PreventivoResponse>&#xa;        &lt;/regCRMWS:OPERESPECIALIResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
