    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="FilePollerToLog_ACKCOMUNICAZIONE"
                    tibex:label="ACK_COMUNICAZIONE" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogACKToParseXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="FilePollerToLog_NOTIFICA"
                    tibex:label="NOTIFICA" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogNotificaToParseXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXml_NotificaToSQLDirect" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXml_AckToSeacrhForFlagSI" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="SeacrhForFlagSIToLog_Filetrovatoneldatabase"
                    tibex:label="File trovato nel database" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogCompletedToCompleted" tibex:linkType="SUCCESS"/>
                <bpws:link name="CompletedToRemoveFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="SeacrhForFlagSIToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link
                    name="LogWrongToWriteFile_Filenontrovatoperchnondipertinenzaoerratanomenclatura"
                    tibex:label="File non trovato perché non di pertinenza o errata nomenclatura. " tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="WrongFileToRemoveFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFileToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="CompletedRemovedToSQLDirect" tibex:linkType="SUCCESS"/>
                <bpws:link name="SQLDirectToInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SQLDirectToInvoke1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="FilePoller"
                    tibex:xpdlId="3998c23b-c925-44c7-aeec-6e53a658552e"
                    variable="FilePoller" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="FilePollerToLog_ACKCOMUNICAZIONE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($FilePoller/fileContent/textContent , 'ACK_COMUNICAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains($FilePoller/fileContent/textContent , 'ACK_COMUNICAZIONE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FilePollerToLog_NOTIFICA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.file.poller"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="fileName" processProperty="notificationPathXml"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//FilePoller"/>
                                    <value contentAs="text"
                                    createEvent="true"
                                    includeCurrent="true"
                                    mode="files-and-directories"
                                    modifyEvent="true"
                                    pollInterval="5"
                                    sortby="File Name"
                                    sortorder="descending" xsi:type="file:FilePoller"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogACK-input"
                    name="LogACK"
                    tibex:xpdlId="2145fc1f-1759-4b8f-bd0a-092c6e739ad4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FilePollerToLog_ACKCOMUNICAZIONE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogACKToParseXml"/>
                    </bpws:sources>
