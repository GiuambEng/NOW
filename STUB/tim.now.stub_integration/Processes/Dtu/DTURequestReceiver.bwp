                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="RESPONSE_MESSAGE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRANSACTION_ID"/>

                                    <PreparedParameters
                                    DataType="12"
