                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bdd747e0-3a78-44a7-9cd0-d3c753830332+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta_Evento&quot;/>&lt;xsl:param name=&quot;AckMsg&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;UPDATE_DATE>&lt;xsl:value-of select=&quot;xsd:string(current-date())&quot;/>&lt;/UPDATE_DATE>&lt;RESPONSE_MESSAGE>&lt;xsl:value-of select=&quot;tib:render-xml($AckMsg)&quot;/>&lt;/RESPONSE_MESSAGE>&lt;TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&lt;/TRANSACTION_ID>&lt;ID_ORDINE>&lt;xsl:value-of select=&quot;$Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:CODICE_ORDINE_TI&quot;/>&lt;/ID_ORDINE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
