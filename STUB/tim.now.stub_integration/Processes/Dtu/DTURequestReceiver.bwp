                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta_Evento.richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCausaleACK-NACK&quot;/>&#xa;    &lt;xsl:template name=&quot;AckMsg-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ACK_COMUNICAZIONE>&#xa;            &lt;tns:DATA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns:DATA>&#xa;            &lt;tns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta_Evento.richiesta/tns:TESTATA/tns:TRANSACTION_ID&quot;/>&#xa;            &lt;/tns:TRANSACTION_ID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectCausaleACK-NACK/Record) > 0&quot;>&#xa;                    &lt;tns:CAUSALE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$SelectCausaleACK-NACK/Record[1]/CAUS_ACK_NACK&quot;/>&#xa;                    &lt;/tns:CAUSALE_ESITO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CAUSALE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;000&amp;quot;&quot;/>&#xa;                    &lt;/tns:CAUSALE_ESITO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:TIPO_MESSAGGIO>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta_Evento.richiesta/tns:TESTATA/tns:TIPOLOGIA_EVENTO&quot;/>&#xa;            &lt;/tns:TIPO_MESSAGGIO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelectCausaleACK-NACK/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectCausaleACK-NACK/Record[1]/DESCRIZIONE&quot;>&#xa;                        &lt;tns:DE