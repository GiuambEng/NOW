                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STUB_DTU_TRACE_EVENTS_L2 SET RESPONSE_TYPE ='ACK_COMUNICAZIONE', STATO_OUT = 'INVIATO_ACK_RICHIESTA', &#xa;UPDATE_DATE = ?, RESPONSE_MESSAGE = ? WHERE TRANSACTION_ID = ? AND ID_ORDINE = ?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="UPDATE_DATE"/>

