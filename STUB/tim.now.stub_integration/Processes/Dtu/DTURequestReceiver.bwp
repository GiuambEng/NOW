                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/" xmlns:ns="http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Richiesta_Evento"/&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="GetAckFault-input" match="/"&gt;&lt;tns:AckInput&gt;&lt;AckInput&gt;&lt;ns:ACK_COMUNICAZIONE&gt;&lt;ns:DATA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:DATA&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TRANSACTION_ID) &gt; 0"&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TRANSACTION_ID"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TRANSACTION_ID&gt;&lt;xsl:value-of select="'0'"/&gt;&lt;/ns:TRANSACTION_ID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:CAUSALE_ESITO&gt;&lt;xsl:value-of select="&amp;quot;004&amp;quot;"/&gt;&lt;/ns:CAUSALE_ESITO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TIPOLOGIA_EVENTO)&gt;0"&gt;&lt;ns:TIPO_MESSAGGIO&gt;&lt;xsl:value-of select="$Richiesta_Evento/richiesta/ns:EVENTO_RICHIESTA/ns:TESTATA/ns:TIPOLOGIA_EVENTO"/&gt;&lt;/ns:TIPO_MESSAGGIO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:TIPO_MESSAGGIO&gt;&lt;xsl:value-of select="&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;"/&gt;&lt;/ns:TIPO_MESSAGGIO&gt;
                                                                                                    &lt;!--Default inserito per mancanza valore vuoto nella ENUM--&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="tib:render-xml($FaultDetails)"/&gt;&lt;/ns:DESCRIZIONE_ERRORE&gt;&lt;/ns:ACK_COMUNICAZIONE&gt;&lt;/AckInput&gt;&lt;header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'DTU'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="xsd:string(current-date())"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="xsd:string(current-time())"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:messageID"&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:messageID"/&gt;&lt;/h:messageID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/tns:AckInput&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta_Evento.richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;GetAckFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:ACK_COMUNICAZIONE>&#xa;            &lt;ns:DATA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/ns:DATA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Richiesta_Evento.richiesta/ns:TESTATA/ns:TRANSACTION_ID) > 0&quot;>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta_Evento.richiesta/ns:TESTATA/ns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                    &lt;/ns:TRANSACTION_ID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:CAUSALE_ESITO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;004&amp;quot;&quot;/>&#xa;            &lt;/ns:CAUSALE_ESITO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Richiesta_Evento.richiesta/ns:TESTATA/ns:TIPOLOGIA_EVENTO)>0&quot;>&#xa;                    &lt;ns:TIPO_MESSAGGIO>&#xa;             