                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Richiesta_Evento"/&gt;&lt;xsl:param name="AckMsg"/&gt;&lt;xsl:template name="InvokeAck-input" match="/"&gt;&lt;ns:AckInput&gt;&lt;AckInput&gt;&lt;xsl:copy-of select="$AckMsg"/&gt;&lt;/AckInput&gt;&lt;header&gt;&lt;h:Header&gt;&lt;h:sourceSystem&gt;&lt;xsl:value-of select="'DTU'"/&gt;&lt;/h:sourceSystem&gt;&lt;h:interactionDate&gt;&lt;h:Date&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[Y0001]-[M01]-[D01]'))"/&gt;&lt;/h:Date&gt;&lt;h:Time&gt;&lt;xsl:value-of select="string(format-dateTime(current-dateTime(), '[H01]:[m01]:[s01]'))"/&gt;&lt;/h:Time&gt;&lt;/h:interactionDate&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:businessID"&gt;&lt;h:businessID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:businessID"/&gt;&lt;/h:businessID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:messageID"&gt;&lt;h:messageID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:messageID"/&gt;&lt;/h:messageID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Richiesta_Evento/header/h:Header/h:transactionID"&gt;&lt;h:transactionID&gt;&lt;xsl:value-of select="$Richiesta_Evento/header/h:Header/h:transactionID"/&gt;&lt;/h:transactionID&gt;&lt;/xsl:if&gt;&lt;/h:Header&gt;&lt;/header&gt;&lt;/ns:AckInput&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificaDTU/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AckMsg&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeAck-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:copy-of select=&quot;$AckMsg&quot;/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
