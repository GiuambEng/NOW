            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:B2BDynamicResourceMgmtResponsePortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://telecomitalia.it/SOA/B2BDynamicResourceMgmtResponse"/>
        </wsdl:definitions>
    </tibex:Types>
