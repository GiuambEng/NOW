&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/code_tipo_servizio&gt;&lt;desc_tipo_servizio&gt;&lt;xsl:value-of select="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/tipo_serv"/&gt;&lt;/desc_tipo_servizio&gt;&lt;code_linea_splitter&gt;&lt;xsl:value-of select="'2'"/&gt;&lt;/code_linea_splitter&gt;&lt;desc_linea_splitter&gt;&lt;xsl:value-of select="'AAA'"/&gt;&lt;/desc_linea_splitter&gt;&lt;code_tipo_flag_isdn_gnr&gt;&lt;xsl:value-of select="'3'"/&gt;&lt;/code_tipo_flag_isdn_gnr&gt;&lt;desc_tipo_flag_isdn_gnr&gt;&lt;xsl:value-of select="'S'"/&gt;&lt;/desc_tipo_flag_isdn_gnr&gt;&lt;data_ricezione_ordine&gt;&lt;xsl:value-of select="format-dateTime(current-dateTime(),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)"/&gt;&lt;/data_ricezione_ordine&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/DES"&gt;&lt;data_espletamento&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/DES"/&gt;&lt;/data_espletamento&gt;&lt;/xsl:if&gt;&lt;diffidato&gt;&lt;xsl:value-of select="'SI'"/&gt;&lt;/diffidato&gt;&lt;/easy_ip&gt;&lt;/ns:ResourceResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/tipo_serv='BIT_FTTX'"&gt;&lt;ns:ResourceResponse&gt;&lt;testata&gt;&lt;id_risorsa_crmws&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/ID_RISORSA"/&gt;&lt;/id_risorsa_crmws&gt;&lt;codice_esito&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/CODICE_ESITO"/&gt;&lt;/codice_esito&gt;&lt;desc_esito&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/DESC_ESITO"/&gt;&lt;/desc_esito&gt;&lt;/testata&gt;&lt;bs_ftth_fttcab&gt;&lt;id_risorsa_richiesta&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/ID_RISORSA"/&gt;&lt;/id_risorsa_richiesta&gt;&lt;codice_olo&gt;&lt;xsl:value-of select="'TLC'"/&gt;&lt;/codice_olo&gt;&lt;code_stato&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/CODE_STATO"/&gt;&lt;/code_stato&gt;&lt;desc_stato&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/DESC_ESITO"/&gt;&lt;/desc_stato&gt;&lt;localita&gt;&lt;xsl:value-of select="'ROMA'"/&gt;&lt;/localita&gt;&lt;code_comm_servizio&gt;&lt;xsl:value-of select="'123'"/&gt;&lt;/code_comm_servizio&gt;&lt;desc_comm_servizio&gt;&lt;xsl:value-of select="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/tipo_serv"/&gt;&lt;/desc_comm_servizio&gt;&lt;code_tipo_servizio&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/code_tipo_servizio&gt;&lt;desc_tipo_servizio&gt;&lt;xsl:value-of select="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/tipo_serv"/&gt;&lt;/desc_tipo_servizio&gt;&lt;code_tipo_flag_isdn_gnr&gt;&lt;xsl:value-of select="'2'"/&gt;&lt;/code_tipo_flag_isdn_gnr&gt;&lt;desc_tipo_flag_isdn_gnr&gt;&lt;xsl:value-of select="'S'"/&gt;&lt;/desc_tipo_flag_isdn_gnr&gt;&lt;data_ricezione_ordine&gt;&lt;xsl:value-of select="format-dateTime(current-dateTime(),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)"/&gt;&lt;/data_ricezione_ordine&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/DES"&gt;&lt;data_espletamento&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/DES"/&gt;&lt;/data_espletamento&gt;&lt;/xsl:if&gt;&lt;num_user_vlan&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/num_user_vlan&gt;&lt;user_vlan&gt;&lt;td_kit&gt;&lt;xsl:value-of select="'TD_KIT'"/&gt;&lt;/td_kit&gt;&lt;cos&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/cos&gt;&lt;/user_vlan&gt;&lt;diffidato&gt;&lt;xsl:value-of select="'SI'"/&gt;&lt;/diffidato&gt;&lt;/bs_ftth_fttcab&gt;&lt;/ns:ResourceResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/tipo_serv != ('BIT_FTTX','EASYIP','BIT_ASIM','EASYIPUBB')"&gt;&lt;ns:ResourceResponse&gt;&lt;testata&gt;&lt;id_risorsa_crmws&gt;&lt;xsl:value-of select="$GetResourceNowIn/GetResourceReq/ns:ResourceRequest/resource/id_risorsa"/&gt;&lt;/id_risorsa_crmws&gt;&lt;codice_esito&gt;&lt;xsl:value-of select="'0'"/&gt;&lt;/codice_esito&gt;&lt;desc_esito&gt;&lt;xsl:value-of select="'Servizio  commercializzato esclusivamente da CRMWS'"/&gt;&lt;/desc_esito&gt;&lt;/testata&gt