                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/1481813326693&quot; xmlns:ns=&quot;http://xsd.telecomitalia.it/CRMWS/NOWTTM&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetResourceNowIn.GetResourceReq&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;GetResourceNowOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv='BIT_ASIM'&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;bs_asim_atm_gbe>&#xa;                        &lt;vc>&#xa;                            &lt;id_vc>&#xa;                                &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                            &lt;/id_vc>&#xa;                        &lt;/vc>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;code_stato>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODE_STATO&quot;/>&#xa;                        &lt;/code_stato>&#xa;                        &lt;desc_stato>&#xa;                            &lt;xsl:value-of select=&quot;'DESC_STATO'&quot;/>&#xa;                        &lt;/desc_stato>&#xa;                        &lt;localita>&#xa;                            &lt;xsl:value-of select=&quot;'ROMA'&quot;/>&#xa;                        &lt;/localita>&#xa;                        &lt;code_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'123'&quot;/>&#xa;                        &lt;/code_comm_servizio>&#xa;                        &lt;desc_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'AAA'&quot;/>&#xa;                        &lt;/desc_comm_servizio>&#xa;                        &lt;code_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/code_tipo_servizio>&#xa;                        &lt;desc_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv&quot;/>&#xa;                        &lt;/desc_tipo_servizio>&#xa;                        &lt;code_linea_splitter>&#xa;                            &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                        &lt;/code_linea_splitter>&#xa;                        &lt;desc_linea_splitter>&#xa;                            &lt;xsl:value-of select=&quot;'ABC'&quot;/>&#xa;                        &lt;/desc_linea_splitter>&#xa;                        &lt;code_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                        &lt;/code_tipo_flag_isdn_gnr>&#xa;                        &lt;desc_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                        &lt;/desc_tipo_flag_isdn_gnr>&#xa;                        &lt;data_ricezione_ordine>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                        &lt;/data_ricezione_ordine>&#xa;                        &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DES&quot;>&#xa;                            &lt;data_espletamento>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DES&quot;/>&#xa;                            &lt;/data_espletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;diffidato>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/diffidato>&#xa;                    &lt;/bs_asim_atm_gbe>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;starts-with($GetResourceNowIn.GetResourceReq/resource/tipo_serv, 'EASYIP')&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;easy_ip>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;code_stato>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODE_STATO&quot;/>&#xa;                        &lt;/code_stato>&#xa;                        &lt;desc_stato>&#xa;                            &lt;xsl:value-of select=&quot;'DESC_STATO'&quot;/>&#xa;                        &lt;/desc_stato>&#xa;                        &lt;localita>&#xa;                            &lt;xsl:value-of select=&quot;'ROMA'&quot;/>&#xa;                        &lt;/localita>&#xa;                        &lt;code_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'123'&quot;/>&#xa;                        &lt;/code_comm_servizio>&#xa;                        &lt;desc_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv&quot;/>&#xa;                        &lt;/desc_comm_servizio>&#xa;                        &lt;code_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/code_tipo_servizio>&#xa;                        &lt;desc_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv&quot;/>&#xa;                        &lt;/desc_tipo_servizio>&#xa;                        &lt;code_linea_splitter>&#xa;                            &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                        &lt;/code_linea_splitter>&#xa;                        &lt;desc_linea_splitter>&#xa;                            &lt;xsl:value-of select=&quot;'AAA'&quot;/>&#xa;                        &lt;/desc_linea_splitter>&#xa;                        &lt;code_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                        &lt;/code_tipo_flag_isdn_gnr>&#xa;                        &lt;desc_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                        &lt;/desc_tipo_flag_isdn_gnr>&#xa;                        &lt;data_ricezione_ordine>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                        &lt;/data_ricezione_ordine>&#xa;                        &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DES&quot;>&#xa;                            &lt;data_espletamento>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DES&quot;/>&#xa;                            &lt;/data_espletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;diffidato>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/diffidato>&#xa;                    &lt;/easy_ip>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv='BIT_FTTX'&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICE_ESITO&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                    &lt;bs_ftth_fttcab>&#xa;                        &lt;id_risorsa_richiesta>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RISORSA&quot;/>&#xa;                        &lt;/id_risorsa_richiesta>&#xa;                        &lt;codice_olo>&#xa;                            &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                        &lt;/codice_olo>&#xa;                        &lt;code_stato>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODE_STATO&quot;/>&#xa;                        &lt;/code_stato>&#xa;                        &lt;desc_stato>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESC_ESITO&quot;/>&#xa;                        &lt;/desc_stato>&#xa;                        &lt;localita>&#xa;                            &lt;xsl:value-of select=&quot;'ROMA'&quot;/>&#xa;                        &lt;/localita>&#xa;                        &lt;code_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'123'&quot;/>&#xa;                        &lt;/code_comm_servizio>&#xa;                        &lt;desc_comm_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv&quot;/>&#xa;                        &lt;/desc_comm_servizio>&#xa;                        &lt;code_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/code_tipo_servizio>&#xa;                        &lt;desc_tipo_servizio>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv&quot;/>&#xa;                        &lt;/desc_tipo_servizio>&#xa;                        &lt;code_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                        &lt;/code_tipo_flag_isdn_gnr>&#xa;                        &lt;desc_tipo_flag_isdn_gnr>&#xa;                            &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                        &lt;/desc_tipo_flag_isdn_gnr>&#xa;                        &lt;data_ricezione_ordine>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                        &lt;/data_ricezione_ordine>&#xa;                        &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DES&quot;>&#xa;                            &lt;data_espletamento>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DES&quot;/>&#xa;                            &lt;/data_espletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;num_user_vlan>&#xa;                            &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                        &lt;/num_user_vlan>&#xa;                        &lt;user_vlan>&#xa;                            &lt;td_kit>&#xa;                                &lt;xsl:value-of select=&quot;'TD_KIT'&quot;/>&#xa;                            &lt;/td_kit>&#xa;                            &lt;cos>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/cos>&#xa;                        &lt;/user_vlan>&#xa;                        &lt;diffidato>&#xa;                            &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                        &lt;/diffidato>&#xa;                    &lt;/bs_ftth_fttcab>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$GetResourceNowIn.GetResourceReq/resource/tipo_serv != ('BIT_FTTX','EASYIP','BIT_ASIM','EASYIPUBB')&quot;>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;'Servizio  commercializzato esclusivamente da CRMWS'&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns:ResourceResponse>&#xa;                    &lt;testata>&#xa;                        &lt;id_risorsa_crmws>&#xa;                            &lt;xsl:value-of select=&quot;$GetResourceNowIn.GetResourceReq/resource/id_risorsa&quot;/>&#xa;                        &lt;/id_risorsa_crmws>&#xa;                        &lt;codice_esito>&#xa;                            &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                        &lt;/codice_esito>&#xa;                        &lt;desc_esito>&#xa;                            &lt;xsl:value-of select=&quot;'Risorsa non censita CRMWS'&quot;/>&#xa;                        &lt;/desc_esito>&#xa;                    &lt;/testata>&#xa;                &lt;/ns:ResourceResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
