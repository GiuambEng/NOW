                                    <columnMetadata
                                    columnName="DESCRIZIONE_ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ESITO_TELEFONICO"
