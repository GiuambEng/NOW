                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ESITO, DESCRIZIONE_ESITO, ESITO_TELEFONICO, POSIZIONE_ORDINATIVO, LUNGHEZZA_CODA&#xd;&#xa; FROM STUB_MONITORQUEUEPOS_UNICARA WHERE ID_TELEFONICO = ? AND FLAG_INVIO='SI'"
