<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns:ns1="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN"
	 targetNamespace="http://xsd.telecomitalia.it/Schema/crmws.entity.VisualizzaPosizioneOrdinativoIN"
	 elementFormDefault="unqualified"
	 attributeFormDefault="unqualified">
	<xs:element name="SERVIZIO" type="ns1:SERVIZIO_TYPE"/>
	<xs:complexType name="SERVIZIO_TYPE">
		<xs:sequence>
			<xs:element ref="ns1:Input"/>
		</xs:sequence>
		<xs:attribute name="nome" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="VisualizzaPosizione"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="Input">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ns1:Distretto" minOccurs="0"/>
				<xs:element ref="ns1:IdTelefonico"/>
				<xs:element ref="ns1:CLLI" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="IdTelefonico">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="20"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Distretto">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CLLI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="11"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>