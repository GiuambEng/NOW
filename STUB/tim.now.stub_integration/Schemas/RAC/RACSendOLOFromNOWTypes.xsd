<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns:RAC="http://wsracweb/type-definitions/RACSendOLOFromNOW"
	attributeFormDefault="unqualified" elementFormDefault="qualified"
	targetNamespace="http://wsracweb/type-definitions/RACSendOLOFromNOW">

	<!-- Type for the Request Header -->
	<xsd:element name="TransactionInfo" type="RAC:TransactionInfoType" />

	<xsd:element name="Transaction_id" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Id della transazione</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:minLength value="1" />
				<xsd:maxLength value="50" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="Transaction_date" nillable="false"
		type="xsd:dateTime">
		<xsd:annotation>
			<xsd:documentation>Data della trasazione</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:complexType name="TransactionInfoType">
		<xsd:annotation>
			<xsd:documentation>Header della richiesta RACSendOLOFromNOW
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="RAC:Transaction_id" />
			<xsd:element ref="RAC:Transaction_date" />
		</xsd:sequence>
	</xsd:complexType>

	<!-- Type for the Request Body -->
	<xsd:element name="NOWRequest" type="RAC:NOWRequestType" />

	<xsd:element name="NUMERO_LINEA" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Prefisso e numero telefonico</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:pattern value="[0-9]+" />
				<xsd:maxLength value="16" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="TIPO_SERVIZIO" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Tipologia di servizio associato all’ordine
			</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:enumeration value="NP" />
				<xsd:enumeration value="VULL" />
				<xsd:enumeration value="WLR" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="CODICE_OLO" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Codice numerico</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:minLength value="1" />
				<xsd:maxLength value="3" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="SIGLA_OLO" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Codifica AGCOM</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:minLength value="1" />
				<xsd:maxLength value="3" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="DESCRIZIONE_OLO" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Denominazione dell’OLO</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:minLength value="1" />
				<xsd:maxLength value="255" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="DATA_ESPLETAMENTO" nillable="false"
		type="xsd:date">
		<xsd:annotation>
			<xsd:documentation>Data di espletamento</xsd:documentation>
		</xsd:annotation>
	</xsd:element>

	<xsd:complexType name="NOWRequestType">
		<xsd:annotation>
			<xsd:documentation>Body della richiesta RACSendOLOFromNOW
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="RAC:NUMERO_LINEA" />
			<xsd:element ref="RAC:TIPO_SERVIZIO" />
			<xsd:element ref="RAC:CODICE_OLO" />
			<xsd:element ref="RAC:SIGLA_OLO" />
			<xsd:element ref="RAC:DESCRIZIONE_OLO" />
			<xsd:element ref="RAC:DATA_ESPLETAMENTO" />
		</xsd:sequence>
	</xsd:complexType>

	<!-- Type for the response Message -->
	<xsd:element name="RACResponse" type="RAC:RACResponseType" />

	<xsd:element name="Response_date" nillable="false" type="xsd:dateTime">
		<xsd:annotation>
			<xsd:documentation>Data della risposta</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="Esito" nillable="false">
		<xsd:annotation>
			<xsd:documentation>Esito dell’elaborazione</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="xsd:string">
				<xsd:enumeration value="OK" />
				<xsd:enumeration value="KO" />
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>

	<xsd:complexType name="RACResponseType">
		<xsd:annotation>
			<xsd:documentation>Response RACSendOLOFromNOW</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element ref="RAC:Transaction_id" />
			<xsd:element ref="RAC:Response_date" />
			<xsd:element ref="RAC:Esito" />
		</xsd:sequence>
	</xsd:complexType>

</xsd:schema>