<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckVPKIT/Schema.xsd2"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckVPKIT/Schema.xsd2"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">

	<xs:element name="RESPONSE" type="CRMWSCheckVPKITRESPONSEType"/>
	<xs:complexType name="CRMWSCheckVPKITRESPONSEType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="RESPONSE_DATE"/>
			<xs:element ref="ESITO"/>
			<xs:element ref="CODICE_CAUSALE"/>
			<xs:element ref="DESCRIZIONE_CAUSALE" minOccurs="0"/>
			<xs:element ref="INFO_VP_KIT" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="INFO_VP_KIT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ID_RISORSA"/>
				<xs:element ref="CODICE_CAUSALE"/>
				<xs:element ref="DESCRIZIONE_CAUSALE" minOccurs="0"/>
				<xs:element ref="VP" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="KIT" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="VP">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ID_RISORSA"/>
				<xs:element ref="STATO"/>
				<xs:element ref="MOD_FATT"/>
				<xs:element ref="TIPO"/>
				<xs:element ref="BANDA_MCR"/>
				<xs:element ref="BANDA_PCR"/>
				<xs:element ref="NR_MAX_VC"/>
				<xs:element ref="ADR_CODE"/>
				<xs:element ref="DESC_ADR"/>
				<xs:element ref="TD_KIT"/>
				<xs:element ref="VPI_RETE" minOccurs="0"/>
				<xs:element ref="VPI"/>
				<xs:element ref="OLO_CODING"/>
				<xs:element ref="OLO_CODE"/>
				<xs:element ref="TIPO_TRASPORTO" minOccurs="0"/>
				<xs:element ref="CLLI"/>
				<xs:element ref="NOME_CENTRALE" minOccurs="0"/>
				<xs:element ref="DEC_ATT"/>
				<xs:element ref="DEC"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="KIT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="TD_KIT"/>
				<xs:element ref="STATO"/>
				<xs:element ref="DEC_ATT"/>
				<xs:element ref="DEC"/>
				<xs:element ref="CLLI_SEDE"/>
				<xs:element ref="ADR_CODE"/>
				<xs:element ref="ADR_DESC"/>
				<xs:element ref="OLO_CODING"/>
				<xs:element ref="OLO_CODE"/>
				<xs:element ref="TD_KIT_PRIME_CONTRACTOR" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="STATO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="Active"/>
				<xs:enumeration value="Inactive"/>
				<xs:enumeration value="Temporary"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="MOD_FATT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="Flat"/>
				<xs:enumeration value="Lite"/>
				<xs:enumeration value="HL"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="TIPO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="Standard"/>
				<xs:enumeration value="Special"/>
				<xs:enumeration value="Lite"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="BANDA_MCR">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="BANDA_PCR">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NR_MAX_VC">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ADR_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="DESC_ADR">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="TD_KIT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="VPI_RETE">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
		<xs:element name="VPI">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPO_TRASPORTO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="Assente"/>
				<xs:enumeration value="Presente"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="CLLI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="NOME_CENTRALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="DEC_ATT">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="DEC">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ADR_DESC">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="CLLI_SEDE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>	
	<xs:element name="TD_KIT_PRIME_CONTRACTOR">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="OLO_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ID_RISORSA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="RESPONSE_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ESITO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODICE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DESCRIZIONE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>