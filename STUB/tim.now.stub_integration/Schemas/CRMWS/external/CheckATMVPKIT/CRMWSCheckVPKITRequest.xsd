<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckVPKIT/Schema.xsd"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckVPKIT/Schema.xsd"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="REQUEST" type="CRMWSCheckVPKITREQUESTType"/>
	<xs:complexType name="CRMWSCheckVPKITREQUESTType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="TRANSACTION_DATE"/>
			<xs:element ref="OLO_CODING"/>
			<xs:element ref="OLO_CODE"/>
			<xs:element ref="INFO_VP_KIT" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="INFO_VP_KIT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="NUM_VC"/>
				<xs:element ref="ID_RISORSA"/>
				<xs:element ref="TIPO_CONSEGNA"/>
				<xs:element ref="FLAG_PRESENZA_NOW"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="NUM_VC">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPO_CONSEGNA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="BandaCondivisa"/>
				<xs:enumeration value="BandaDedicata"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ID_RISORSA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FLAG_PRESENZA_NOW">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="1"/>
				<xs:enumeration value="Y"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="OLO_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>