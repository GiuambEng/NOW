<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetEsitoConsistenzaDati/Schema.xsd"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetEsitoConsistenzaDati/Schema.xsd"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="REQUEST" type="NOWSendRiscontroConsistenzaREQUESTType"/>
	<xs:complexType name="NOWSendRiscontroConsistenzaREQUESTType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="TRANSACTION_DATE"/>
			<xs:element ref="RETURN_CODE"/>
			<xs:element ref="DESCRIZIONE_ERRORE" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="RETURN_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
				<xs:enumeration value="00"/>
				<xs:enumeration value="01"/>
				<xs:enumeration value="02"/>
				<xs:enumeration value="03"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DESCRIZIONE_ERRORE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>