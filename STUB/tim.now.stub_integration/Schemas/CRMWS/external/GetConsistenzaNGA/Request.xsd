<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetConsistenzaNGA/Schema.xsd"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetConsistenzaNGA/Schema.xsd"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="REQUEST" type="CRMWSGetConsistenzaNGAREQUESTType"/>
	<xs:complexType name="CRMWSGetConsistenzaNGAREQUESTType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="TRANSACTION_DATE"/>
			<xs:element ref="SERVIZIO"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="SERVIZIO">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="OLO_CODING"/>
				<xs:element ref="OLO_CODE"/>
				<xs:choice>
					<xs:element ref="ATTIVAZIONE"/>
					<xs:element ref="CESSAZIONE"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ATTIVAZIONE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CodiceOrdineOlo"/>
				<xs:element ref="CodiceOrdineTI"/>
				<xs:element ref="Contratto"/>
				<xs:element ref="Risorsa"/>
				<xs:element ref="ID_NOW"/>
				<xs:element ref="DAC" minOccurs="0"/>
				<xs:element ref="DEC"/>
				<xs:element ref="CLLI"/>
				<xs:element ref="DATI_SEDE"/>
				<xs:element ref="CLIENTE"/>
				<xs:element ref="NGAVULA" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DATI_SEDE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="PARTICELLATOPONOMASTICA" minOccurs="0"/>
				<xs:element ref="VIA" minOccurs="0"/>
				<xs:element ref="CIVICO" minOccurs="0"/>
				<xs:element ref="LOCALITA" minOccurs="0"/>
				<xs:element ref="CAP" minOccurs="0"/>
				<xs:element ref="COMPLESSO" minOccurs="0"/>
				<xs:element ref="SCALA" minOccurs="0"/>
				<xs:element ref="PIANO" minOccurs="0"/>
				<xs:element ref="INTERNO" minOccurs="0"/>
				<xs:element ref="CODICEINDIRIZZO" minOccurs="0"/>
				<xs:element ref="CODICECOMUNE" minOccurs="0"/>
				<xs:element ref="CODESTRADA" minOccurs="0"/>
				<xs:element ref="PROVINCIA" minOccurs="0"/>
				<xs:element ref="SIGLAPROVINCIA" minOccurs="0"/>
				<xs:element ref="DR" minOccurs="0"/>
				<xs:element ref="ISTATPROV" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CLIENTE">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="COGNOMERAGIONESOCIALE"/>
				<xs:element ref="NOME" minOccurs="0"/>
				<xs:element ref="CF" minOccurs="0"/>
				<xs:element ref="PIVA" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="NGAVULA">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Servizio">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="2"/>
							<xs:enumeration value="04"/>
							<xs:enumeration value="05"/>
							<xs:enumeration value="06"/>
							<xs:enumeration value="07"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TipoLinea">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
							<xs:enumeration value="LineaNonFonia"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Tecnologia">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="1"/>
							<xs:enumeration value="V"/>
							<xs:enumeration value="Z"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ProfiloTecnicoLinea">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="3"/>
							<xs:enumeration value="V1"/>
							<xs:enumeration value="V2"/>
							<xs:enumeration value="V3"/>
							<xs:enumeration value="V4"/>
							<xs:enumeration value="V5"/>
							<xs:enumeration value="Z1"/>
							<xs:enumeration value="Z2"/>
							<xs:enumeration value="Z3"/>
							<xs:enumeration value="Z4"/>
							<xs:enumeration value="Z5"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Encapsulation">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
							<xs:enumeration value="DOUBLETAG"/>
							<xs:enumeration value="SINGLETAG"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="UserVLAN_1_TAGGING">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
							<xs:enumeration value="Tagged"/>
							<xs:enumeration value="Untagged"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SLAAssurance" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="1"/>
							<xs:enumeration value="0"/>
							<xs:enumeration value="D"/>
							<xs:enumeration value="E"/>
							<xs:enumeration value="F"/>
							<xs:enumeration value="G"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DistrettoTelefonico">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="4"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Aggiuntivo">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="11"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="USERVLAN" maxOccurs="4"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="USERVLAN">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IdRisorsaUserVLAN">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="UserVLANId" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:int"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Codice_VLAN">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CVLAN_ID" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:int"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Profilo_BMD" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:int"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BandaPiccoUP">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="BandaPiccoDown">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CESSAZIONE">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Servizio">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="2"/>
							<xs:enumeration value="04"/>
							<xs:enumeration value="05"/>
							<xs:enumeration value="06"/>
							<xs:enumeration value="07"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="CodiceOrdineOlo"/>
				<xs:element ref="CodiceOrdineTI"/>
				<xs:element ref="Contratto"/>
				<xs:element ref="Risorsa"/>
				<xs:element ref="ID_NOW"/>
				<xs:element ref="DAC" minOccurs="0"/>
				<xs:element ref="DEC"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="COGNOMERAGIONESOCIALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="60"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NOME">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CF">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PIVA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="11"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PARTICELLATOPONOMASTICA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="20"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="VIA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="70"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CIVICO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LOCALITA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="60"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CAP">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="5"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="COMPLESSO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SCALA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PIANO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="INTERNO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODICEINDIRIZZO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODICECOMUNE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODESTRADA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PROVINCIA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SIGLAPROVINCIA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DR">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ISTATPROV">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodiceOrdineOlo">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="11"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodiceOrdineTI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="31"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Contratto">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="15"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Risorsa">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ID_NOW">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DAC">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DEC">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CLLI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="8"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>