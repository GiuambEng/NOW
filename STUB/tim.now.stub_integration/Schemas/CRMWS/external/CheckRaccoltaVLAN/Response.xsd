<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="RESPONSE" type="CRMWSCheckRaccoltaVLANRESPONSEType"/>
	<xs:complexType name="CRMWSCheckRaccoltaVLANRESPONSEType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="RESPONSE_DATE"/>
			<xs:element ref="ESITO"/>
			<xs:element ref="CODICE_CAUSALE"  minOccurs="0"/>
			<xs:element ref="DESCRIZIONE_CAUSALE" minOccurs="0"/>
			<xs:element ref="INFO_VLAN" minOccurs="0" maxOccurs="4"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="INFO_VLAN">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CVLAN_ID"/>
				<xs:element ref="SVLAN_CODE"/>
				<xs:element ref="CODICE_CAUSALE"/>
				<xs:element ref="DESCRIZIONE_CAUSALE" minOccurs="0"/>
				<xs:element ref="VLAN" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="VLAN">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="IDVLAN" />
				<xs:element ref="TIPO_BANDA" />
				<xs:element ref="TIPO_COS" />
				<xs:element ref="OLO_CODING" />
				<xs:element ref="OLO_CODE" />
				<xs:element ref="OLO_CODING_SUB" minOccurs="0" />
				<xs:element ref="OLO_CODE_SUB" minOccurs="0" />
				<xs:element ref="STATO_SUB" minOccurs="0" />
				<xs:element ref="DATA_ATTIVAZIOE_SUB" minOccurs="0" />
				<xs:element ref="DATA_CESSAZIONE_SUB" minOccurs="0" />
				<xs:element ref="ENCAPSULATION" />
				<xs:element ref="TIPOLOGIA" />
				<xs:element ref="STATO" />
				<xs:element ref="NOME" />
				<xs:element ref="CLLI" />
				<xs:element ref="NOME_CENTRALE" />
				<xs:element ref="TD_KIT" />
				<xs:element ref="DEC_ATT" />
				<xs:element ref="DEC" />
				<xs:element ref="ADR_CODE" />
				<xs:element ref="ADR_DESC" />
				<xs:element ref="MACRO_AREA_CODE" />
				<xs:element ref="MACRO_AREA_DESC" />
				<xs:element ref="SUPER_MACRO_AREA_CODE" minOccurs="0" />
				<xs:element ref="SUPER_MACRO_AREA_DESC" minOccurs="0" />
				<xs:element ref="TIPO_TRASPORTO" minOccurs="0" />
				<xs:element ref="IDVLANOLO" minOccurs="0" />
				<xs:element ref="FLAG_VLAN_TRANSLATION" />
				<xs:element ref="DSLAM_TYPE" minOccurs="0" />
				<xs:element ref="CUSTOMER" minOccurs="0" />
				<xs:element ref="BMC_LIGHT" minOccurs="0" />
				<xs:element ref="INTERMEDIATE_AGENT" minOccurs="0" />
				<xs:element ref="TIPOLOGIA_CLUSTER_VLAN" minOccurs="0" />
				<xs:element ref="TIPOLOGIA_CLUSTER_VLAN_OLD" minOccurs="0" />
				<xs:element ref="FLAG_FTTH_ONLY" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="IDVLAN">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPO_BANDA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="MULTICOS"/>
				<xs:enumeration value="MONOCOS"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPO_COS">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="5"/>
				<xs:enumeration value="BMD"/>
				<xs:enumeration value="BMC"/>
				<xs:enumeration value="0"/>
				<xs:enumeration value="1"/>
				<xs:enumeration value="3"/>
				<xs:enumeration value="5"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING_SUB">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODE_SUB">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="STATO_SUB">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="ACTIVE"/>
				<xs:enumeration value="INACTIVE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DATA_ATTIVAZIOE_SUB">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DATA_CESSAZIONE_SUB">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ENCAPSULATION">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="1"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPOLOGIA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="5"/>
				<xs:enumeration value="NGA"/>
				<xs:enumeration value="GBE"/>
				<xs:enumeration value="VULA"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="STATO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:enumeration value="ACTIVE"/>
				<xs:enumeration value="INACTIVE"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NOME">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CLLI">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NOME_CENTRALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TD_KIT">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DEC_ATT">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DEC">
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ADR_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ADR_DESC">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="MACRO_AREA_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="MACRO_AREA_DESC">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SUPER_MACRO_AREA_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SUPER_MACRO_AREA_DESC">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TIPO_TRASPORTO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="5"/>
				<xs:enumeration value="L1"/>
				<xs:enumeration value="L2"/>
				<xs:enumeration value="LD"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="IDVLANOLO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FLAG_VLAN_TRANSLATION">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="1"/>
				<xs:enumeration value="Y"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DSLAM_TYPE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
				<xs:enumeration value="01"/>
				<xs:enumeration value="02"/>
				<xs:enumeration value="03"/>
				<xs:enumeration value="04"/>
				<xs:enumeration value="05"/>
				<xs:enumeration value="06"/>
				<xs:enumeration value="07"/>
				<xs:enumeration value="08"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CVLAN_ID">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SVLAN_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ID_RISORSA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="VERIFICA_SUB_CONTRACTOR">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="1"/>
				<xs:enumeration value="Y"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="RESPONSE_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ESITO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODICE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DESCRIZIONE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>

	<xs:element name="CUSTOMER">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="BMC_LIGHT">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="INTERMEDIATE_AGENT">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="TIPOLOGIA_CLUSTER_VLAN">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="TIPOLOGIA_CLUSTER_VLAN_OLD">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="FLAG_FTTH_ONLY">
		<xs:simpleType>
			<xs:restriction base="xs:string"></xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>