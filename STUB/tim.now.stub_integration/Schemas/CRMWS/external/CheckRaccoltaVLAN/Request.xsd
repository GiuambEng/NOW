<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	 
	<xs:element name="REQUEST" type="CRMWSCheckRaccoltaVLANREQUESTType"/>
	<xs:complexType name="CRMWSCheckRaccoltaVLANREQUESTType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="TRANSACTION_DATE"/>
			<xs:element ref="OLO_CODING"/>
			<xs:element ref="OLO_CODE"/>
			<xs:element ref="INFO_VLAN" minOccurs="1" maxOccurs="4"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="INFO_VLAN">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CVLAN_ID"/>
				<xs:element ref="SVLAN_CODE"/>
				<xs:element ref="ID_RISORSA" minOccurs="0"/>
				<xs:element ref="VERIFICA_SUB_CONTRACTOR"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CVLAN_ID">
		<xs:simpleType>
			<xs:restriction base="xs:int"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SVLAN_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ID_RISORSA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="VERIFICA_SUB_CONTRACTOR">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="1"/>
				<xs:enumeration value="Y"/>
				<xs:enumeration value="N"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="OLO_CODING">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
		<xs:element name="OLO_CODE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>