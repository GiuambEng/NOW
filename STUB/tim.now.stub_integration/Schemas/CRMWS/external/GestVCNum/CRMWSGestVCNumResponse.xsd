<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd2"
	 targetNamespace="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGestVCNum/Schema.xsd2"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="RESPONSE" type="CRMWSGestVCNumRESPONSEType"/>
	<xs:complexType name="CRMWSGestVCNumRESPONSEType">
		<xs:sequence>
			<xs:element ref="TRANSACTION_ID"/>
			<xs:element ref="RESPONSE_DATE"/>
			<xs:element ref="ESITO"/>
			<xs:element ref="CODICE_CAUSALE"/>
			<xs:element ref="DESCRIZIONE_CAUSALE" minOccurs="0"/>
			<xs:element ref="ESITO_VP_KIT" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="ESITO_VP_KIT">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ID_RISORSA"/>
				<xs:element ref="CODICE_CAUSALE"/>
				<xs:element ref="DESCRIZIONE_CAUSALE" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ID_RISORSA">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TRANSACTION_ID">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="RESPONSE_DATE">
		<xs:simpleType>
			<xs:restriction base="xs:dateTime"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ESITO">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CODICE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DESCRIZIONE_CAUSALE">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>